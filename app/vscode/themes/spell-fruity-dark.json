{
  "$schema": "vscode://schemas/color-theme",
  "name": "Spell Fruity Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#f5f5f7",
    "descriptionForeground": "#aeaeb6",
    "focusBorder": "#7c55e6",
    "widget.border": "#ffffff14",
    "selection.background": "#7b56e54d",
    "editor.background": "#191821",
    "editor.foreground": "#efe8f7",
    "editorCursor.foreground": "#d3c2ff",
    "editor.selectionBackground": "#7b56e54d",
    "editor.lineHighlightBackground": "#eeeeff0f",
    "editor.lineHighlightBorder": "#00000000",
    "editorLineNumber.foreground": "#aeaeb6",
    "editorLineNumber.activeForeground": "#d3c2ff",
    "editorBracketMatch.background": "#7c54e740",
    "editorBracketMatch.border": "#7c54e740",
    "editor.findMatchBackground": "#ffa00a66",
    "editor.findMatchHighlightBackground": "#ffa00a66",
    "editorGutter.background": "#191821",
    "editorWidget.background": "#1c1a25",
    "editorWidget.border": "#ffffff14",
    "editorHoverWidget.background": "#1c1a25",
    "editorHoverWidget.border": "#ffffff14",
    "editorSuggestWidget.background": "#1c1a25",
    "editorSuggestWidget.border": "#ffffff14",
    "editorStickyScroll.background": "#191821",
    "editorGroupHeader.tabsBackground": "#15131c",
    "editorGroup.border": "#ffffff14",
    "tab.activeBackground": "#191821",
    "tab.activeForeground": "#f5f5f7",
    "tab.inactiveBackground": "#15131c",
    "tab.inactiveForeground": "#aeaeb6",
    "tab.border": "#ffffff14",
    "tab.activeBorderTop": "#7c55e6",
    "sideBar.background": "#15131c",
    "sideBar.foreground": "#f5f5f7",
    "sideBar.border": "#ffffff14",
    "sideBarSectionHeader.background": "#15131c",
    "sideBarTitle.foreground": "#aeaeb6",
    "activityBar.background": "#15131c",
    "activityBar.foreground": "#f5f5f7",
    "activityBar.inactiveForeground": "#aeaeb6",
    "activityBar.border": "#ffffff14",
    "activityBarBadge.background": "#7c55e6",
    "activityBarBadge.foreground": "#ffffff",
    "titleBar.activeBackground": "#15131c",
    "titleBar.activeForeground": "#f5f5f7",
    "titleBar.inactiveBackground": "#15131c",
    "titleBar.inactiveForeground": "#aeaeb6",
    "titleBar.border": "#ffffff14",
    "statusBar.background": "#15131c",
    "statusBar.foreground": "#aeaeb6",
    "statusBar.border": "#ffffff14",
    "statusBarItem.remoteBackground": "#7c55e6",
    "statusBarItem.remoteForeground": "#ffffff",
    "panel.background": "#15131c",
    "panel.border": "#ffffff14",
    "panelTitle.activeForeground": "#f5f5f7",
    "panelTitle.activeBorder": "#7c55e6",
    "terminal.background": "#15131c",
    "terminal.foreground": "#f5f5f7",
    "button.background": "#7c55e6",
    "button.foreground": "#ffffff",
    "badge.background": "#7c55e6",
    "badge.foreground": "#ffffff",
    "input.background": "#1c1a25",
    "input.foreground": "#f5f5f7",
    "input.border": "#ffffff14",
    "dropdown.background": "#1c1a25",
    "dropdown.border": "#ffffff14",
    "list.activeSelectionBackground": "#7b56e54d",
    "list.activeSelectionForeground": "#f5f5f7",
    "list.inactiveSelectionBackground": "#eeeeff0f",
    "list.hoverBackground": "#eeeeff0f",
    "list.focusOutline": "#7c55e6",
    "textLink.foreground": "#d3c2ff",
    "textLink.activeForeground": "#d3c2ff",
    "editorError.foreground": "#ff453a",
    "editorWarning.foreground": "#ff9f0a",
    "editorInfo.foreground": "#64d2ff"
  },
  "tokenColors": [
    {
      "name": "text",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#efe8f7"
      }
    },
    {
      "name": "heading",
      "scope": [
        "comment.line.number-sign.heading.spell",
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#d3b8ff",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a99bc4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "storage",
        "keyword.control.spell",
        "keyword.operator.word.spell",
        "entity.name.tag.spellx"
      ],
      "settings": {
        "foreground": "#ff8fc8"
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#c8b6ff"
      }
    },
    {
      "name": "library",
      "scope": [
        "support.type.primitive",
        "support.type.builtin",
        "entity.name.type.primitive"
      ],
      "settings": {
        "foreground": "#9fd8ff"
      }
    },
    {
      "name": "name",
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#efe8f7"
      }
    },
    {
      "name": "member",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#8fd0ff"
      }
    },
    {
      "name": "parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#ffc6a8"
      }
    },
    {
      "name": "action",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#b8e4ff"
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character.escape",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ffa3c7"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "string.quoted",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#b9f0c4"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.spell",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#e2a8ff"
      }
    },
    {
      "name": "punctuation",
      "scope": [
        "punctuation",
        "keyword.operator",
        "punctuation.definition.tag",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#b3a6c9"
      }
    },
    {
      "name": "attr",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.spellx"
      ],
      "settings": {
        "foreground": "#8fd0ff"
      }
    },
    {
      "name": "meta",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "#e2a8ff"
      }
    },
    {
      "name": "addition",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#b9f0c4"
      }
    },
    {
      "name": "deletion",
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#ff9aa8"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#ff8fc8",
    "type": "#c8b6ff",
    "type.defaultLibrary": "#9fd8ff",
    "class": "#c8b6ff",
    "variable": "#efe8f7",
    "property": "#8fd0ff",
    "parameter": "#ffc6a8",
    "function": "#b8e4ff",
    "method": "#b8e4ff",
    "enumMember": "#ffa3c7",
    "number": "#ffa3c7",
    "string": "#b9f0c4",
    "comment": {
      "foreground": "#a99bc4",
      "bold": false,
      "italic": true
    },
    "comment.heading1": {
      "foreground": "#d3b8ff",
      "bold": true,
      "italic": true
    },
    "comment.heading2": {
      "foreground": "#d3b8ff",
      "bold": true,
      "italic": true
    },
    "comment.heading3": {
      "foreground": "#d3b8ff",
      "bold": true,
      "italic": true
    },
    "comment.heading4": {
      "foreground": "#d3b8ff",
      "bold": true,
      "italic": true
    }
  }
}
