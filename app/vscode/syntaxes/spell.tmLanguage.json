          "match": "(?<![\\p{L}\\p{M}\\d_-])(de\\s+mas\\s+antiguo\\s+a\\s+mas\\s+reciente|de\\s+más\\s+antiguo\\s+a\\s+más\\s+reciente|de\\s+mas\\s+reciente\\s+a\\s+mas\\s+antiguo|de\\s+más\\s+reciente\\s+a\\s+más\\s+antiguo|is\\s+greater\\s+than\\s+or\\s+equal\\s+to|con\\s+mayusculas\\s+iniciales|con\\s+mayúsculas\\s+iniciales|es\\s+mayor\\s+que\\s+o\\s+igual\\s+que|es\\s+menor\\s+que\\s+o\\s+igual\\s+que|is\\s+less\\s+than\\s+or\\s+equal\\s+to|en\\s+mayusculas\\s+iniciales|en\\s+mayúsculas\\s+iniciales|es\\s+mayor\\s+que\\s+o\\s+igual\\s+a|es\\s+menor\\s+que\\s+o\\s+igual\\s+a|es\\s+mayor\\s+o\\s+igual\\s+que|es\\s+menor\\s+o\\s+igual\\s+que|does\\s+not\\s+start\\s+with|es\\s+mayor\\s+o\\s+igual\\s+a|es\\s+menor\\s+o\\s+igual\\s+a|does\\s+not\\s+end\\s+with|doesnt\\s+start\\s+with|de\\s+mayor\\s+a\\s+menor|de\\s+menor\\s+a\\s+mayor|does\\s+not\\s+contain|does\\s+not\\s+include|en\\s+orden\\s+inverso|no\\s+esta\\s+definida|no\\s+está\\s+definida|no\\s+esta\\s+definido|no\\s+está\\s+definido|como\\s+mayusculas|como\\s+mayúsculas|como\\s+minusculas|como\\s+minúsculas|doesnt\\s+end\\s+with|esta\\s+indefinida|está\\s+indefinida|esta\\s+indefinido|está\\s+indefinido|is\\s+greater\\s+than|no\\s+comienza\\s+con|dividido\\s+entre|does\\s+not\\s+exist|earliest\\s+first|is\\s+not\\s+defined|no\\s+empieza\\s+con|no\\s+termina\\s+con|smallest\\s+first|biggest\\s+first|does\\s+not\\s+have|en\\s+mayusculas|en\\s+mayúsculas|en\\s+minusculas|en\\s+minúsculas|es\\s+indefinida|es\\s+indefinido|esta\\s+definida|está\\s+definida|esta\\s+definido|está\\s+definido|highest\\s+first|largest\\s+first|ordenadas\\s+por|ordenados\\s+por|comienza\\s+con|dividido\\s+por|doesnt\\s+exist|es\\s+mayor\\s+que|es\\s+menor\\s+que|fewest\\s+first|is\\s+less\\s+than|is\\s+undefined|isnt\\s+defined|latest\\s+first|lowest\\s+first|newest\\s+first|no\\s+acaba\\s+con|oldest\\s+first|ordenada\\s+por|ordenado\\s+por|doesnt\\s+have|empieza\\s+con|least\\s+first|no\\s+contiene|no\\s+son\\s+unas|no\\s+son\\s+uno