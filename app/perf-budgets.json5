// The bundles' size budgets (epic `solid-2-final` P1, Q14):  brotli on the wire, KB (1024 bytes).
// - `spell perf budget` sizes each, and exits 1 when one grew past its CEILING:  its size the day it was set, plus 2%.
// - `budget`:  what it should weigh, the web performance page's table;  most are over it today.
//   Once a bundle has met its budget, its ceiling is the budget:  it can only get smaller.
// - A phase that shrinks a bundle lowers its ceiling in the same change:  `spell perf budget --tighten`.
// - How each is sized:  `build` (the app's, into a temporary folder) or `folder` (from the kit's root), its first
//   load from `entries` (an `.html` file stands for what it loads);  or `run`, a number the last `spell perf run`
//   measured in a browser.  The shape:  `BudgetEntry`, in `app/src/cli/perf/perf.types.ts`.
{
  budgets: [
    {
      id: "editor-first-js",
      name: "The editor's first screen, JavaScript",
      budget: 400,
      // Smaller Built Code (epic solid-2-final P11):  854 => 741 KB, Spanish, the dialogs and the pages on first use
      // Editor Page Without Its Own Language (P20):  720 => 527 KB, spell's grammar and the language service on first use
      ceiling: 538,
      build: "editor",
      entries: ["index.html"],
      only: "\\.js$"
    },
    {
      id: "editor-first-all",
      name: "The editor's first screen, everything",
      budget: 500,
      // P11:  872 => 754 KB;  P20:  734 => 541 KB
      ceiling: 552,
      build: "editor",
      entries: ["index.html"]
    },
    {
      id: "editor-project-open",
      name: "The editor, a project open",
      budget: 700,
      ceiling: 2103,
      run: "load editor/desktop brotliLoaded"
    },
    {
      id: "cloud-app",
      name: "A cloud app:  <spell-viewer> and its runtime",
      budget: 150,
      // P11:  309 => 307 KB (lodash-es)
      ceiling: 313,
      build: "element",
      entries: ["spell-viewer.js", "spell-solid.js", "spell-runtime.js"],
      only: "\\.js$"
    },
    {
      id: "run-page-first",
      name: "The run page's first load, a project running alone",
      budget: 150,
      ceiling: 176,
      build: "editor",
      entries: ["run.html"]
    },
    {
      id: "docs-page-js",
      name: "A docs or epic page, JavaScript (the docs bundle)",
      budget: 250,
      // Lighter Docs Pages (epic solid-2-final P7):  974 KB => 357 KB, every family a lazy chunk
      ceiling: 365,
      folder: "epic/src/tools/_assets",
      // the classic loader a page names, the ES module it imports and what that imports at once (epic `solid-2-final`
      // P7):  every family, engine and theme is a lazy chunk;  the page runtime is in the module
      entries: ["spell-ui.js", "spell-ui/main.js"],
      only: "\\.js$"
    },
    {
      id: "ui-site-page",
      name: "A Spell UI site page",
      budget: 200,
      ceiling: 191,
      folder: "ui/site/_assets",
      entries: ["site.js", "site.css"]
    },
    {
      id: "editor-lazy-piece",
      name: "Any lazy piece of the editor",
      budget: 150,
      ceiling: 351,
      build: "editor",
      entries: ["index.html"],
      only: "\\.js$",
      measure: "lazy"
    },
    {
      id: "docs-lazy-piece",
      name: "Any lazy piece of a docs page",
      budget: 150,
      // P7:  Mermaid's ELK, 344 KB, the biggest lazy piece now (the whole Mermaid script, 1,186 KB, before)
      ceiling: 351,
      folder: "epic/src/tools/_assets",
      entries: ["spell-ui.js", "spell-ui/main.js"],
      only: "\\.js$",
      measure: "lazy"
    },
    {
      id: "language-worker",
      name: "The editor's language worker",
      // Review Chunking (epic solid-2-final P19):  410 KB, the worker's own copy of the grammar, the parser and the
      // language service.  Its budget is the lazy pieces' ceiling it breaks;  that ceiling still counts it too.
      // P19 layout B:  386.9 => 372.8 KB, the TypeScript and Python writers loading on first use
      // P20:  372.8 => 368.8 KB, and counted whole (`lazy whole`), with any chunk it imports up front
      budget: 351,
      ceiling: 376,
      build: "editor",
      entries: ["index.html"],
      only: "languageWorker-[^/]*\\.js$",
      measure: "lazy whole"
    },
    {
      id: "site-page",
      name: "A built site on the run page (the Spell UI site)",
      // P19:  1,292 KB, everything a first visit fetches;  its budget is today's size until a layout is picked
      budget: 1292,
      ceiling: 1319,
      run: "load site/desktop brotliLoaded"
    },
    {
      id: "cloud-page",
      name: "A plain page with one program (a cloud app)",
      // P19:  596 KB, everything a first visit fetches, where the cloud-app entry counts the viewer's first files only
      budget: 596,
      ceiling: 608,
      run: "load cloud/desktop brotliLoaded"
    },
    {
      id: "programs-page",
      name: "A plain page with several programs",
      // P19:  899 KB for three viewers, each running its own copy of the engine (Q24)
      budget: 899,
      ceiling: 917,
      run: "load programs/desktop brotliLoaded"
    },
    {
      id: "warm-visit",
      name: "A warm visit to the editor",
      budget: 10,
      // Compress And Cache (epic solid-2-final P2):  2,115 KB => 98 KB, the hashed chunks kept a year
      ceiling: 100,
      run: "load editor/desktop warmBrotli"
    }
  ]
}
