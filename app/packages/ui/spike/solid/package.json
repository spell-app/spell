{
  "name": "@spell/ui-spike-solid",
  "version": "0.0.0",
  "private": true,
  "description": "Spike:  @spell/ui elements on Solid 2.0 RC via @spell/solid-element (our fork of @solidjs/element), Solid as a shared peer dependency",
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/components/*/index.ts",
    "./dist/index.js",
    "./dist/button.js",
    "./dist/dropdown.js",
    "./dist/icon.js",
    "./dist/label.js",
    "./dist/parts.js",
    "./dist/divider.js",
    "./dist/segment.js",
    "./dist/container.js",
    "./demo/**",
    "**/*.css",
    "./src/identity.ts"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./index": "./dist/index.js",
    "./core": "./dist/core.js",
    "./forms": "./dist/forms.js",
    "./button": "./dist/button.js",
    "./dropdown": "./dist/dropdown.js",
    "./icon": "./dist/icon.js",
    "./label": "./dist/label.js",
    "./parts": "./dist/parts.js",
    "./divider": "./dist/divider.js",
    "./segment": "./dist/segment.js",
    "./container": "./dist/container.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --project ssr && vitest run --project browser",
    "tsc": "tsc",
    "vendor": "tsx spike.ts vendor",
    "measure": "tsx spike.ts measure",
    "smoke": "vite build --logLevel warn && tsx spike.ts smoke",
    "serve": "tsx spike.ts serve",
    "report": "tsx spike.ts report",
    "screenshots": "node --experimental-strip-types --no-warnings demo/screenshots.ts",
    "oxlint": "../../node_modules/.bin/oxlint -c .oxlintrc.json --report-unused-disable-directives --max-warnings 0 src demo *.ts",
    "oxfmt": "../../node_modules/.bin/oxfmt -c ../../.oxfmtrc.json",
    "lint": "../../node_modules/.bin/oxlint -c .oxlintrc.json --report-unused-disable-directives --max-warnings 0 src demo *.ts",
    "format": "../../node_modules/.bin/oxfmt -c ../../.oxfmtrc.json .",
    "format:check": "../../node_modules/.bin/oxfmt -c ../../.oxfmtrc.json --check ."
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.46",
    "@solidjs/web": "2.0.0-rc.11",
    "@spell/solid-element": "link:../solid-element",
    "@types/node": "22.20.4",
    "@vitest/browser-playwright": "5.0.2",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "lightningcss": "1.33.0",
    "playwright": "1.63.0",
    "solid-js": "2.0.0-rc.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "peerDependencies": {
    "@solidjs/web": "2.0.0-rc.11",
    "@spell/solid-element": "*",
    "solid-js": "2.0.0-rc.11"
  },
  "packageManager": "yarn@4.18.0"
}
