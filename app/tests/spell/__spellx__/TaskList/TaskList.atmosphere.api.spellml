## Kept in your atmosphere account
// The tasks are records in your own atmosphere account, Bluesky's AT Protocol, as Statusphere's statuses are:
// sign in, and they go with you to any app that reads them.
// Records there are public:  anyone can read them, so keep nothing private in a task.
<spell>
	task sky is a personal atmosphere account:
		- sky tasks live at "spaces.spell.examples.tasklist.task"
</spell>

<spell-view "sky task" template="task">
	<spell>
		- it lives in task sky
	</spell>
	<action "throw it away">
		remove it from the sky tasks
	</action>
</spell-view>

// whose it is:  the account it's in, which a record can't claim
<spell>
	a sky task has an owner as text
</spell>

<spell-thing "sky keeper" template="task keeper">
	<property "kept tasks" description="only your own:  everyone's tasks are in their own accounts">every sky task where its owner is their id</>
	<action "keep a new task titled (title as text)">
		set task to a new sky task with title = title
		add task to the sky tasks
		return task
	</action>
</spell-thing>
