  /*! SPELL: DECLARES {
    property: "color", of: "Pile",
    defined: "/Pile.spell:505-582",
  } */
  get color() {
    if (this.isEmpty) return "none"
    return this.lastItem.color
  }

  /*! SPELL: DECLARES {
    property: "value", of: "Pile", datatype: "number",
    defined: "/Pile.spell:584-656",
  } */
  get value() {
    if (this.isEmpty) return 0
    return this.lastItem.value
  }

  /** Its id, then its cards' short names:  stock: Q♠↑ 7♥↓ */
  /*! SPELL: DECLARES {
    property: "short_name", asWritten: "short name", of: "Pile", datatype: "text",
    defined: "/Pile.spell:658-866",
  } */
  get shortName() {
    let summary = \`\${this.id}:\`
    this.forEach((card) => (summary = \`\${summary} \${card.shortName}\`))
    return summary
  }

  whenCardDroppedOn(card) {
    card.moveToPile(this)
  }

  static droppable = true

  static exclusive = true
}

/** The card, and every card on it, onto the pile, if the piles' rules let it go and take it */
/*! SPELL: DECLARES {
  syntax: "move {thisArg:expression} to {callArgs:expression}", output: "move_to_$pile",
  rule: "method_call", of: "Card", alias: ["statement", "expression"], kind: "method",
  name: "move a card to a pile", params: [{ name: "pile", datatype: "Pile" }], returns: "choice",
  defined: "/Pile.spell:922-1335",
} */
Card.prototype.moveToPile = function (pile) {
  // - refused, nothing moves, and there's nothing to undo
  // - a game adds its own steps after it:  \`after moving a card to a pile\`
  if (!core.canGiveUp(this.pile, this) || !core.canTake(pile, this)) core.cancel()
  core.map(core.rangeStartingAt(this.pile, position(spellPosition(positionOf(this.pile, this)))), (card) => pile.append(card))
}
core.describeAction(Card, "moveToPile", { title: "Move Card to Pile", cancels: true, undoneAs: "Move Card to Pile" })

/*! SPELL: DECLARES {
  syntax: "test piles", output: "test_piles", rule: "method_call", alias: "statement",
  kind: "function", name: "piles",
  defined: "/Pile.spell:1338-2026",
