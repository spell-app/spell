  // <column "C7"/>
  static { this.declareProp("C7", { init: () => new Column({ id: "C7" }), early: true }) }
  get C7() { return this.getProp("C7") }
  set C7(value) { this.setProp("C7", value) }

  /*! SPELL: DECLARES {
    syntax: "restart the game (of {thisArg:expression})?", output: "restart_the_game",
    rule: "method_call", of: "Solitaire", alias: ["statement", "expression"], group: "Dealing",
    kind: "method", name: "restart the game", waits: true, title: "Restart",
    defined: "/Solitaire.spell:1627-1718",
  } */
  async restartTheGame() {
    this.score = 0
    await this.dealTheCards()
  }

  /** Gather every card into the stock, shuffle it, and deal the columns */
  /*! SPELL: DECLARES {
    syntax: "deal the cards (of {thisArg:expression})?", output: "deal_the_cards",
    rule: "method_call", of: "Solitaire", alias: ["statement", "expression"], group: "Dealing",
    kind: "method", name: "deal the cards", waits: true,
    defined: "/Solitaire.spell:1722-2328",
  } */
  async dealTheCards() {
    for (const card of this.deck) {
      const startPile = card.pile
      card.turnFaceDown()
      if (startPile !== this.stock) {
        this.stock.append(card)
        await core.pauseFor(50, "msec")
      }
    }
    this.stock.randomize()
    // each row's first card lands face down, then turns up where it lies
    for (const row of core.getRange(1, 7)) {
      for (const column of core.getRange(row, 7)) {
        core.getItemAt(core.everyThing(Column), position(column))?.append(this.stock.lastItem)
        if (column === row) core.getItemAt(core.everyThing(Column), position(column))?.lastItem?.turnFaceUp()
        await core.pauseFor(50, "msec")
      }
    }
    await this.playFromTheStock()
  }

  /** Turn the stock's next card over, onto the discards:  the discards back into the stock when it's empty */
  /*! SPELL: DECLARES {
    syntax: "play from the stock (of {thisArg:expression})?", output: "play_from_the_stock",
    rule: "method_call", of: "Solitaire", alias: ["statement", "expression"], group: "Dealing",
    kind: "method", name: "play from the stock", returns: "nothing", waits: true,
    defined: "/Solitaire.spell:2331-2799",
  } */
  async playFromTheStock() {
    // - a click on the stock, one step to undo;  the deal's own turn none, as it starts the game
    if (this.stock.isEmpty) this.resetTheStock()
    const it = this.stock.lastItem
    it?.turnFaceUp()
    // as long as its flip takes (styles.css), so it turns over before it moves
    await core.pauseFor(300, "msec")
    this.discards.append(it)
  }

  /** The discards, turned over, back into the stock */
  /*! SPELL: DECLARES {
    syntax: "reset the stock (of {thisArg:expression})?", output: "reset_the_stock",
    rule: "method_call", of: "Solitaire", alias: ["statement", "expression"], group: "Dealing",
    kind: "method", name: "reset the stock", returns: "nothing",
    defined: "/Solitaire.spell:2803-3030",
  } */
  resetTheStock() {
    const cards = this.discards.clone()
    cards.reverse()
    cards.forEach((card) => this.stock.append(card))
    this.stock.forEach((card) => card.turnFaceDown())
  }

  /** Play every card that can go somewhere, until none can */
  /*! SPELL: DECLARES {
    syntax: "auto play (of {thisArg:expression})?", output: "auto_play", rule: "method_call",
    of: "Solitaire", alias: ["statement", "expression"], group: "Game Play", kind: "method",
    name: "auto play", returns: "nothing", waits: true,
    defined: "/Solitaire.spell:4022-5099",
  } */
  async autoPlay() {
    let anythingChanged = false
    if (!this.discards.isEmpty) {
      const testCard = this.discards.lastItem
      if (await testCard?.play()) {
        anythingChanged = true
        await core.pauseFor(500, "msec")
      }
    }
    // each column's last card onto its foundation
    await core.forEachSequential(core.everyThing(Column), async (pile) => {
      if (pile.isEmpty) return
      const testCard = pile.lastItem
      const foundation = core.filter(core.everyThing(Foundation), (pile) => pile.suit === testCard.suit).firstItem
      if (core.canTake(foundation, testCard)) {
        anythingChanged = true
        await testCard.play()
        await core.pauseFor(100, "msec")
      }
    })
    // each column's face-up cards, all together, onto another column
    await core.forEachSequential(core.everyThing(Column), async (pile) => {
      const faceUpCards = pile.filter((card) => card.isFaceDirection("up"))
      if (faceUpCards.isEmpty) return
      const testCard = faceUpCards.firstItem
      if (testCard.rank === "king" && testCard === pile.firstItem) return
      if (await testCard.play()) {
        anythingChanged = true
        await core.pauseFor(500, "msec")
      }
    })
    if (anythingChanged) await this.autoPlay()
  }

  /** Turn up a face-down card from a column, at random, onto the discards */
  /*! SPELL: DECLARES {
    syntax: "cheat {thisArg:expression}?", output: "cheat", rule: "method_call", of: "Solitaire",
    alias: ["statement", "expression"], group: "Game Play", kind: "method", name: "cheat",
    returns: "nothing", waits: true,
    defined: "/Solitaire.spell:5103-5709",
  } */
  async cheat() {
    const remainingPiles = core.filter(core.everyThing(Column), (pile) => !pile.isEmpty && pile.firstItem?.isFaceDirection("down"))
    if (core.isEmpty(remainingPiles)) return
    const pile = core.randomItemOf(remainingPiles)
    const card = pile?.filter((card) => card.isFaceDirection("down"))?.randomItem()
    // over every card around it, then turned face up as it moves onto the discards
    card.lifted = true
    card?.turnFaceUp()
    this.discards.append(card)
    await core.pauseFor(300, "msec")
    card.lifted = false
  }

  async onScoreChange(event) {
    let home = this.clubs.length + this.diamonds.length
    home = home + this.hearts.length + this.spades.length
    if (home === 52) {
      await core.alert("You won!", "New game")
      await this.restartTheGame()
    }
  }
}
export const solitaire = new Solitaire()
core.describeAction(Solitaire, "restartTheGame", { title: "Restart", shortcuts: ["R"], undoneAs: "Restart" })
core.describeAction(Solitaire, "dealTheCards", { title: "Deal The Cards", undoneAs: "Deal The Cards" })
core.describeAction(Solitaire, "playFromTheStock", { title: "Play From The Stock", undoneAs: "Turn Card" })
core.describeAction(Solitaire, "resetTheStock", { title: "Reset The Stock", undoneAs: "Reset The Stock" })
core.describeAction(Solitaire, "autoPlay", { title: "Auto Play", shortcuts: ["A"], undoneAs: "Auto Play" })
core.describeAction(Solitaire, "cheat", { title: "Cheat", shortcuts: ["C"], undoneAs: "Cheat" })

/*! SPELL: DECLARES {
  syntax: "play {thisArg:expression}", output: "play", rule: "method_call", of: "Card",
  alias: ["statement", "expression"], group: "Game Play", kind: "method", name: "play a card",
  waits: true,
  defined: "/Solitaire.spell:3054-3310",
} */
Card.prototype.play = async function () {
  if (solitaire.stock.includes(this)) await solitaire.playFromTheStock()
  else {
    const endPile = core.filter(core.everyThing(Pile), (pile) => core.canTake(pile, this)).firstItem
    if (endPile === undefined) return false
    return await this.putOnPile(endPile)
  }
}
core.describeAction(Card, "play", { title: "Play A Card", undoneAs: "Play Card" })

/** the card, and every card on it, onto the pile, if the piles' rules let it go and take it;  it says whether it moved */
/*! SPELL: DECLARES {
  syntax: "put {thisArg:expression} on {callArgs:expression}", output: "put_on_$pile",
  rule: "method_call", of: "Card", alias: ["statement", "expression"], group: "Game Play",
  kind: "method", name: "put a card on a pile", params: [{ name: "pile", datatype: "Pile" }],
  returns: "choice", waits: true,
  defined: "/Solitaire.spell:3313-4019",
} */
Card.prototype.putOnPile = async function (pile) {
  /** - the pile it left turns its new last card up;  the move counts, and scores */
  const startPile = this.pile
  if (!core.canGiveUp(startPile, this)) return false
  if (!core.canTake(pile, this)) return false
  const points = this.countThePointsForCardOnPile(pile)
  startPile.startingWith(this).forEach((card) => core.move(card, pile))
  if (startPile instanceof Column && !startPile.isEmpty) {
    await core.pauseFor(200, "msec")
    startPile.lastItem?.turnFaceUp()
  }
  solitaire.score = solitaire.score + points
  return true
}
core.describeAction(Card, "putOnPile", { title: "Put A Card On A Pile", undoneAs: "Move Card" })

/** what the move scores:  10 on a foundation, 5 from the discards, else nothing */
/*! SPELL: DECLARES {
  syntax: "count the points for {thisArg:expression} on {callArgs:expression}",
  output: "count_the_points_for_card_on_$pile", rule: "method_call", of: "Card",
  alias: ["statement", "expression"], group: "Game Play", kind: "method",
  name: "count the points for a card on a pile", params: [{ name: "pile", datatype: "Pile" }],
  returns: "number",
  defined: "/Solitaire.spell:5712-5923",
} */
Card.prototype.countThePointsForCardOnPile = function (pile) {
  if (pile instanceof Foundation) return 10
  if (solitaire.discards.includes(this)) return 5
  return 0
}
core.describeAction(Card, "countThePointsForCardOnPile", { title: "Count The Points For A Card On A Pile", undoneAs: "Count The Points For A Card On A Pile" })

// play the card on click if it is a legal move
Card.prototype.onClick = async function (event) {
  if (this.isFaceDirection("up") || this.pile === solitaire.stock) await this.play()
}

// drop the card on the pile if it is a legal move
Pile.prototype.whenCardDroppedOn = async function (card) {
  await card.putOnPile(this)
}

core.heading("The piles")
///////////////
// ## The piles
///////////////
// Each kind of pile, what it may take or give up, and how it lies.
// While one's empty, it shows its placeholder, if it has one.

/*! SPELL: DECLARES {
  syntax: "test the moves", output: "test_the_moves", rule: "method_call", alias: "statement",
  kind: "function", name: "the moves",
  defined: "/Solitaire.spell:7870-9325",
} */
export function testTheMoves() {
  return core.test("test the moves", function testTheMoves() {
    core.echoTestAction(\`set the column to a new column with id "T1"\`)
    let column = new Column({ id: "T1" })
    core.echoTestAction(\`set the king to a new card whose rank is king, suit is spades and direction is up\`)
    const king = new Card({
      rank: "king",
      suit: "spades",
      direction: "up"
    })
    core.echoTestAction(\`set the queen to a new card whose rank is queen, suit is hearts and direction is up\`)
    const queen = new Card({
      rank: "queen",
      suit: "hearts",
      direction: "up"
    })
    core.echoTestAction(\`set the jack to a new card whose rank is jack, suit is clubs and direction is up\`)
    const jack = new Card({
      rank: "jack",
      suit: "clubs",
      direction: "up"
    })

    // an empty column takes only a king, then one lower in the other color
    core.expect(core.canTake(column, queen), \`the column can take the queen\`, false, \`no\`)
    core.expect(core.canTake(column, king), \`the column can take the king\`, true, \`yes\`)
    core.echoTestAction(\`add the king to the column\`)
    column.append(king)
    core.expect(core.canTake(column, jack), \`the column can take the jack\`, false, \`no\`)
    core.expect(core.canTake(column, queen), \`the column can take the queen\`, true, \`yes\`)
    core.echoTestAction(\`add the queen to the column\`)
    column.append(queen)
    core.expect(column.shortName, \`the short name of the column\`, "T1: K♠↑ Q♥↑", \`"T1: K♠↑ Q♥↑"\`)
    core.expect(core.canGiveUp(column, queen), \`the column can give up the queen\`, true, \`yes\`)
    core.echoTestAction(\`turn the queen face down\`)
    queen.turnFaceDown()
    core.expect(core.canGiveUp(column, queen), \`the column can give up the queen\`, false, \`no\`)

    /** a foundation takes its suit, ace first, then one higher:  each the last card of its pile */
    const foundation = new Foundation({ suit: "hearts" })
    core.echoTestAction(\`set the two to a new card whose rank is 2, suit is hearts and direction is up\`)
    const two = new Card({
      rank: 2,
      suit: "hearts",
      direction: "up"
    })
    core.echoTestAction(\`set the ace to a new card whose rank is ace, suit is hearts and direction is up\`)
    const ace = new Card({
      rank: "ace",
      suit: "hearts",
      direction: "up"
    })
    core.echoTestAction(\`set the column to a new column with id "T2"\`)
    column = new Column({ id: "T2" })
    core.echoTestAction(\`add the two to the column\`)
    column.append(two)
    core.echoTestAction(\`add the ace to the column\`)
    column.append(ace)
    core.expect(core.canTake(foundation, two), \`the foundation can take the two\`, false, \`no\`)
    core.expect(core.canTake(foundation, ace), \`the foundation can take the ace\`, true, \`yes\`)
    core.echoTestAction(\`move the ace to the foundation\`)
    core.move(ace, foundation)
    core.expect(core.canTake(foundation, two), \`the foundation can take the two\`, true, \`yes\`)
    core.echoTestAction(\`add the queen to the column\`)
    column.append(queen)
    core.expect(core.canTake(foundation, queen), \`the foundation can take the queen\`, false, \`no\`)
  })
}",
    "errors": [],
    "path": "/Solitaire.spell",
    "warnings": [],
  },
]
