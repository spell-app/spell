////////////
// ## A deck
////////////
// The 52 cards of a standard deck, ace of clubs first.

/*! SPELL: DECLARES {
  type: "Deck", superType: "List", itemType: "Card",
  defined: "/Deck.spell:66-865",
} */
export class Deck extends List {
  static instanceType = Card

  /** One of each card, ace of clubs first:  each starts face down, as every two sided view does */
  /*! SPELL: DECLARES {
    kind: "method", name: "creating a deck", returns: "nothing",
    defined: "/Deck.spell:95-331",
  } */
  create() {
    core.map(Card.Ranks, (rank) => core.map(Card.Suits, (suit) => this.append(new Card({ rank: rank, suit: suit }))))
  }

  /** Its cards' short names, top to bottom */
  /*! SPELL: DECLARES {
    property: "short_name", asWritten: "short name", of: "Deck", datatype: "text",
    defined: "/Deck.spell:333-536",
  } */
  get shortName() {
    const cardNames = new List({ instanceType: "text" })
    this.forEach((card) => cardNames.append(card.shortName))
    return \`deck: \${cardNames}\`
  }
}

/*! SPELL: DECLARES {
  syntax: "test a new deck", output: "test_a_new_deck", rule: "method_call", alias: "statement",
  kind: "function", name: "a new deck",
  defined: "/Deck.spell:539-865",
} */
export function testANewDeck() {
  return core.test("test a new deck", function testANewDeck() {
    const it = new Deck()
    core.echoTestAction(\`the deck is a new deck\`)
    const deck = new Deck()
    core.expect(deck.length, \`the number of cards in the deck\`, 52, \`52\`)
    core.expect(deck.filter((card) => card.rank === "queen").length, \`the number of (cards in the deck where it is a queen)\`, 4, \`4\`)
    core.expect(deck.firstItem?.shortName, \`deck's first card's short name\`, "A♣↓", \`"A♣↓"\`)
    core.expect(deck.lastItem?.name, \`deck's last card's name\`, "king of spades", \`"king of spades"\`)
    core.echoTestAction(\`shuffle the deck\`)
    deck.randomize()
    core.expect(deck.length, \`the number of cards in the deck\`, 52, \`52\`)
  })
}",
