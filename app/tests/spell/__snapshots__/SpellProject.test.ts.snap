    group: "Dealing & the Stock Pile", kind: "method", name: "reset the stock", returns: "nothing",
    defined: "/Solitaire.spell:2430-2667",
  } */
  resetTheStock() {
    const cards = this.discardPile.clone()
    cards.reverse()
    cards.forEach((card) => this.stock.append(card))
    this.stock.forEach((card) => card.turnFaceDown())
