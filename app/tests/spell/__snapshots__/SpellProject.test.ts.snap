    if (this.suit === "clubs") return "♣"
    if (this.suit === "diamonds") return "♦"
    if (this.suit === "hearts") return "♥"
    return "♠"
  }

  /*! SPELL: DECLARES {
    property: "name", of: "Card", group: "Names",
    groupDescription: "What a person, test or console calls it", datatype: "text",
    defined: "/Card.spell:957-999",
  } */
  get name() {
    return core.joined(core.joined(this.rank, "of", " "), this.suit, " ")
  }

  /*! SPELL: DECLARES {
    syntax: "{operator:is_or_is_not} {definite_article} (expression:ace|aces|2|3|4|5|6|7|8|9|10|jack|jacks|queen|queens|king|kings) of (expression:clubs|club|diamonds|diamond|hearts|heart|spades|spade)",
    output: "is_the_$rank_of_$suit", rule: "quoted_property", of: "Card", group: "Names",
