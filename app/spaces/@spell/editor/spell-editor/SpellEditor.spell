# Spell's editor
// The editor itself, as one app:  its top bar, its panes, the file tabs over the code, and its menus, each a view of it.
// What's in each pane, and what each action does, is still the editor's own (`SpellEditor.tsx`, `MenuBar.tsx`, `FileTabs.tsx`):
// each pane is an editor part, which draws itself, and each action's work is handed over by its name.
// The editor shows every title in the page's language.

spell editor is an app
	"editor bar" is a new editor bar
	"editor layout" is a new editor layout
	"file tab bar" is a new file tab bar
	"project menu" is a new project menu
	"file menu" is a new file menu
	"edit menu" is a new edit menu
	"view menu" is a new view menu
	"run menu" is a new run menu

	group "What the Menus Follow"
	// The editor's state, which the menus grey and tick by:  the editor keeps each in step
	its "can revert" is yes or no
		// The file has something to revert:  edits not saved, or with AutoSave on, a draft
	its "drafted" is yes or no
		// The project has a draft:  Delete Draft puts every file back as published
	its "auto saving" is yes or no
		// AutoSave is on
	its "can publish" is yes or no
		// The project has a draft to publish
	its "unsaved" is yes or no
		// The project has edits not saved:  Save is ticked
	its "running" is yes or no
		// The page is in Run, not Edit
	its "code showing" is yes or no
		// The code shows, in Edit
	its "compiled code showing" is yes or no
		// The compiled code shows beside the code, in Edit
	its "program panel showing" is yes or no
		// The Program panel shows under the code, in Edit
	its "inspector open" is yes or no
		// The Inspector shows
	its "line numbers showing" is yes or no
		// The code shows its line numbers
	its "inspecting" is yes or no
		// A click in the app picks what it clicks
	its "site ready" is yes or no
		// The project is a site, with pages at addresses:  View › Site edits it
	its "console empty" is yes or no
		// The program has printed nothing to clear

	group "What the Menus Show"
	// What changes which rows there are:  the editor keeps each in step
	its "on a server" is yes or no
		// The editor runs on Spell's page server, not the public preview:  drafts, versions and a project's settings are the server's
	its "may create" is yes or no
		// The person may make new files here
	its "may design" is yes or no
		// The person may save drafts of the project's pages
	its "may change project" is yes or no
		// The project may be renamed, deleted and its files duplicated:  in the public preview, a visitor's own only
	its "may reset" is yes or no
		// Reset to Saved forgets the edits:  in the public preview, a built-in project only

	group "Titles That Follow"
	// The editor writes each in the page's language
	its "revert words" is text
		// Revert Changes to the file open
	its "rename words" is text
		// Rename the project…
	its "delete words" is text
		// Delete the project…
	its "duplicate words" is text
		// Duplicate the project

	group "The Project"
	to "rename project" with title "[its rename words]", icon "edit outline"
	to "delete project" with title "[its delete words]", icon "trash alternate outline"
	to "duplicate project" with title "[its duplicate words]", icon "clone outline"
	to "reset to saved" with title "Reset to Saved", icon "undo"
	to "publish" with icon "paper plane outline"
		enabled when its can publish is yes
	to "versions" with icon "history"
	to "delete draft" with icon "eraser"
		enabled when its drafted is yes
	to "project settings" with icon "cog"
	to "export project" with title "Export…", icon "download"
	to "import project" with title "Import…", icon "upload"

	group "The File"
	to "new spell file" with icon "file outline"
		shortcut alt+meta+N
	to "new css file" with title "New CSS File", icon "file code outline"
	to "save" with icon "save outline"
		shortcut meta+S
		selected when its unsaved is yes
	to "auto save" with title "AutoSave", icon "sync alternate"
		selected when its auto saving is yes
	to "duplicate file" with icon "clone outline"
	to "rename file" with icon "edit outline"
	to "delete file" with icon "trash alternate outline"
	to "revert changes" with title "[its revert words]", icon "undo"
		shortcut shift+meta+R
		enabled when its can revert is yes

	group "Editing"
	to "find" with icon "search"
		shortcut meta+F
	to "code settings" with title "Code Editor Settings…", icon "sliders horizontal"

	group "Viewing"
	to "run mode" with title "Run", icon "eye"
		selected when its running is yes
	to "edit mode" with title "Edit", icon "pencil alternate"
		selected when its running is no
	to "site view" with title "Site", icon "sitemap"
		enabled when its site ready is yes
	to "show code" with title "Code", icon "code"
		selected when its code showing is yes
	to "show compiled code" with title "Compiled Code", icon "file code outline"
		selected when its compiled code showing is yes
	to "show program panel" with title "Program Panel", icon "terminal"
		selected when its program panel showing is yes
	to "show inspector" with title "Inspector", icon "info circle"
		selected when its inspector open is yes
	to "show line numbers" with title "Line Numbers", icon "list ol"
		selected when its line numbers showing is yes

	group "Running"
	to "compile and run" with icon "play"
		shortcut meta+Enter
	to "restart" with icon "redo alternate"
	to "inspect app" with icon "crosshairs"
		enabled when its inspecting is no
	to "stop inspecting" with icon "stop circle outline"
		shortcut Escape
		enabled when its inspecting is yes
	to "clear console" with icon "ban"
		enabled when its console empty is no

an "editor part" is a thing
	// What the editor draws in a view's place for it:  a pane, a menu, a row it keeps in step itself.
	// Its drawing is the editor's own, handed over in TypeScript (`EditorSpell.parts()`, `layoutSpell.ts`).

an "editor bar" is a view
	// The editor's top bar, joined to the top of the window, with three sections:
	// Spell's menu, the project's menu and the app's menus, then Run and Edit in the middle, then the tools and you.
	// What's in each is still the editor's own, `EditorToolbar` in `SpellEditor.tsx`:  each is an editor part here, which draws itself.
	its "spell menu" is an editor part
		// Spell's menu:  its hat and name, opening the group's projects and Home
	its "project menu" is an editor part
		// The project's menu:  its name, opening the project menu
	its "app menus" is an editor part
		// File, Edit, View, Run and Help, each opening its menu
	its "mode buttons" is an editor part
		// Run and Edit, then Inspect app and the code's icon in Edit
	its "tools" is an editor part
		// Add and the Inspector's menu in Edit, then Restart and the theme
	its "you" is an editor part
		// The person's own menu

	to draw it
		<menu appearance="header" class="AppMenu tight EditorBar">
			<menu position="left" class="third side">
				{draw its spell menu}
				{draw its project menu}
				{draw its app menus}
				<item class="spring no-border"/>
			</menu>
			<menu position="left" class="third">
				<item class="spring no-border"/>
				{draw its mode buttons}
				<item class="spring no-border"/>
			</menu>
			<menu position="right" class="third side BarTools">
				<item class="spring no-border"/>
				<menu appearance="capsule">
					{draw its tools}
				</menu>
				{draw its you}
			</menu>
		</menu>

an "editor layout" is a view
	// The editor's panes:  the code on the left, the Program panel under it, then the running app, and the Inspector at the far right while it's open (Owen, 2026-11-06).
	// What's in each is still the editor's own, `SpellEditor` in `SpellEditor.tsx`:  each is an editor part here, which draws itself.
	// The app takes every change of size (`grows`, its place across):  dragging the code's bar sizes the code, the app gives or takes the room, and the Inspector keeps its width.
	// The code's column stays where it is when it isn't showing, hidden:  so nothing moves or redraws as the others come and go, and the running app keeps running.
	its "code" is an editor part
		// The file tabs and the code
	its "program panel" is an editor part
		// The program's output and compiled code, under the code
	its "app" is an editor part
		// The running program
	its "inspector" is an editor part
		// The Inspector, while it's open
	its "columns" is text
		// The sizes across, as they were last dragged
	its "code rows" is text
		// The sizes of the code and the Program panel
	its "grows" is text
		// The app's place across, which takes every change of size:  2 after the code, first without it
	its "mode" is one of edit or run
		it "is (mode)"

	to draw it
		<split-panel class="EditorColumns" columns={its columns} grows={its grows} resizable>
			<split-panel class="EditorCode" rows={its code rows} resizable hidden={it is run}>
				{draw its code}
				{draw its program panel}
			</split-panel>
			{draw its app}
			{draw its inspector}
		</split-panel>

a "file" is a thing
	// One of the project's files, as its tab shows it
	its "name" is text
	its "icon" is text
	its "path" is text
	its "status" is one of saved or changed or drafted
		it "is (status)"
	its "place" is one of chosen or other
		it "is (place)"
	to show it

a "file list" is a viewable list of files
	// Every file of the project, a tab each:  a click shows it;  a right click shows it, and its menu
	to draw each item
		<item icon={the icon of the file} selected={the file is chosen} onClick={show the file}>
			<context-menu>
				<action "duplicate file"/>
				<action "rename file"/>
				<action "delete file"/>
			</>
			{the name of the file}
			<if the file is changed><span class="NotSaved"/></if>
			<if the file is drafted><span class="Drafted"><icon name="fa7-free:pen-to-square"/></span></if>
		</item>

a "file tab bar" is a view
	// Every file of the project as a tab over the code, in a pane's one bar, as every header in the editor.
	// Each shows a small icon for its kind of file, which the dropdown's rows show too when the bar's too narrow.
	// With more files than fit the bar's limit, only the ones opened lately are tabs;  the ▾ beside them lists every file.
	// A click shows that file;  dragged along the row, it moves there, the project's file order.  A file with changes not saved shows a dot;  one you have a draft of, not published yet, a pen on a square, as 'Editing a Draft' shows (Owen, 2026-11-14).
	// The bar's ⋯ is at its right, which compiled code to show beside the code.
	// The editor's own side of it, which files there are and what showing one does, is `FileTabs.tsx`.
	"files" is a new file list
	its "more" is an editor part
		// The code pane's ⋯, the editor's own
	its "remember as" is text
		// What this project's open tabs are kept under, the editor's own
	<css>
		/* the dot on a tab whose file isn't saved:  the theme's warning hue */
		.NotSaved {
			display: inline-block;
			margin-inline-start: 6px;
			width: 7px;
			height: 7px;
			border-radius: 50%;
			background: var(--ui-warning, var(--ui-orange, #f2994a));
		}
		/* a tab whose file is your draft, saved but not published:  a pen on a square, small, in the theme's primary hue */
		.Drafted {
			display: inline-flex;
			margin-inline-start: 6px;
			font-size: 0.8em;
			color: var(--ui-primary, var(--ui-blue, #2185d0));
		}
		/* a tab being dragged along the row:  dimmed;  a line where it would land, before or after the tab under it */
		ui-item[dragged]::part(item) {
			opacity: 0.5;
		}
		ui-item[drop="before"]::part(item) {
			box-shadow: inset 2px 0 0 var(--ui-primary);
		}
		ui-item[drop="after"]::part(item) {
			box-shadow: inset -2px 0 0 var(--ui-primary);
		}
		.NotSaved[hidden],
		.Drafted[hidden] {
			display: none;
		}
	</css>
	to draw it
		<panel appearance="pane" label="Files">
			<toolbar slot="actions" appearance="segmented link header" tabs shrinkable scroll-first max-visible remember={its remember as} label="Files">
				{draw each file in its files}
				{draw its more}
			</toolbar>
		</panel>

a "project menu" is a view
	// The project's own menu, under its name before File:  what's about the whole project, not the file open (Owen, epic `mockup`)
	its "theme" is an editor part
		// Theme ›, the theme's fly-out:  the editor's own
	to draw it
		<menu direction="vertical" size="small" class="BarMenuItems" icon-column>
			<if spell editor's may change project>
				<action "rename project"/>
				<action "delete project"/>
			</if>
			<action "duplicate project"/>
			<if spell editor's may reset><action "reset to saved"/></if>
			<if spell editor's on a server>
				<divider/>
				<action "publish"/>
				<action "versions"/>
				<action "delete draft"/>
				<divider/>
				<action "project settings"/>
			</if>
			<divider/>
			<action "export project"/>
			<action "import project"/>
			<divider/>
			{draw its theme}
		</menu>

a "bar menu" is a view
	// One of the bar's menus, File, Edit, View or Run:  its title the bar's word for it, which opens it
	its "title" is text

a "file menu" is a bar menu
	// File:  what's about the file open (Owen, epic `mockup`)
	its title is "File"
	to draw it
		<menu direction="vertical" size="small" class="BarMenuItems" icon-column ticks>
			<if spell editor's may create>
				<action "new spell file"/>
				<action "new css file"/>
				<divider/>
			</if>
			<if spell editor's may design><action "save"/></if>
			<action "auto save"/>
			<divider/>
			<if spell editor's may change project><action "duplicate file"/></if>
			<action "revert changes"/>
		</menu>

an "edit menu" is a bar menu
	// Edit:  the code editor's Undo and Redo, what can be done to the selection, then Find
	its title is "Edit"
	its "undo" is an editor part
		// Undo, its title the step it undoes:  the editor's own
	its "redo" is an editor part
		// Redo, likewise
	its "part actions" is an editor part
		// What can be done to the parts selected:  the editor's own
	to draw it
		<menu direction="vertical" size="small" class="BarMenuItems" icon-column>
			{draw its undo}
			{draw its redo}
			<divider/>
			{draw its part actions}
			<divider/>
			<action "find"/>
			<divider/>
			<action "code settings"/>
		</menu>

a "view menu" is a bar menu
	// View:  Run or Edit, then what shows, each ticked while it does
	its title is "View"
	to draw it
		<menu direction="vertical" size="small" class="BarMenuItems" icon-column ticks>
			<action "run mode"/>
			<action "edit mode"/>
			<action "site view"/>
			<divider/>
			<action "show code"/>
			<action "show compiled code"/>
			<action "show program panel"/>
			<divider/>
			<action "show inspector"/>
			<divider/>
			<action "show line numbers"/>
		</menu>

a "run menu" is a bar menu
	// Run:  the program, and what it printed
	its title is "Run"
	to draw it
		<menu direction="vertical" size="small" class="BarMenuItems" icon-column>
			<action "compile and run"/>
			<action "restart"/>
			<divider/>
			<action "inspect app"/>
			<action "stop inspecting"/>
			<divider/>
			<action "clear console"/>
		</menu>
