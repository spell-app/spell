## Kept in a JSON file on the server
// The tasks are a project data folder on Spell's server:  each task a JSON file, in this project's `__data/tasks`.
// Everyone who runs the app shares them, and each person changes only the tasks they made.
// Open one in an editor and change it:  the app shows it at its next check.
<data-folder "task files" address="tasks">
	- check it every 30 seconds
</data-folder>

<view "server task" template="task">
	<spell>
		- it lives in task files
	</spell>
	<action "throw it away">
		remove it from the server tasks
	</action>
</view>

<thing "server keeper" template="task keeper">
	<property "kept tasks">every server task</>
	<action "keep a new task titled (title as text)">
		set task to a new server task with title = title
		add task to the server tasks
		return task
	</action>
</thing>
