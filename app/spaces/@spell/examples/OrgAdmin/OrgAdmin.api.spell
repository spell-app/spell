## Org Admin:  where an org's roles are kept
// An org's roles live in its Admin space:  who's in it, its teams and projects, who manages what, and until when.
// Every change goes through Spell's server, under the org's rules, and is logged:
// a Project Manager can't remove a Team Manager from this page either.
// Your org's Admin page names its own org on the next line:  "@rs" is the Rock Society's.
<data-folder "admin roles" address="@rs/__admin/roles">
	- check it every 30 seconds
	- stages live at "event_stages"
</data-folder>

// The org itself, for the page's title and as a space to design.
<spell-thing "org profile">
	<spell>
		- it lives in admin roles
	</spell>
	<property "name">text</>
	<property "space">text</>
</spell-thing>

<spell-thing "member">
	<spell>
		- it lives in admin roles
	</spell>
	<property "person">text</>
	<property "name">text</>
	<property "role">text</>
	<property "role name">text</>
</spell-thing>

<spell-thing "team">
	<spell>
		- it lives in admin roles
	</spell>
	<property "name">text</>
	<property "space">text</>
</spell-thing>

<spell-thing "project">
	<spell>
		- it lives in admin roles
	</spell>
	<property "name">text</>
	<property "team">text</>
	<property "space">text</>
</spell-thing>

<spell-thing "org role">
	<spell>
		- it lives in admin roles
	</spell>
	<property "name">text</>
	<property "manages">text</>
</spell-thing>

<spell-thing "term">
	<spell>
		- it lives in admin roles
	</spell>
	<property "role">text</>
	<property "holder">text</>
	<property "manages">text</>
	<property "role name">text</>
	<property "holder name">text</>
	<property "manages name">text</>
	<property "starts">text</>
	<property "ends">text</>
</spell-thing>

<spell-thing "approved app">
	<spell>
		- it lives in admin roles
	</spell>
	<property "name">text</>
	<property "version">text</>
</spell-thing>

// A designer changes a space's pages and source, whatever their role there:  a Manager publishes them.
<spell-thing "designer">
	<spell>
		- it lives in admin roles
	</spell>
	<property "person">text</>
	<property "space">text</>
	<property "person name">text</>
</spell-thing>

// An event's stages, in order (its place calls them event stages):  who moves an event into each is "the team" or "its organizers".
<spell-thing "stage">
	<spell>
		- it lives in admin roles
	</spell>
	<property "name">text</>
	<property "moves to">text</>
	<property "moved by">text</>
</spell-thing>

<spell-thing "role change">
	<spell>
		- it lives in admin roles
	</spell>
	<property "at">text</>
	<property "who">text</>
	<property "did">text</>
	<property "what">text</>
	<property "why">text</>
</spell-thing>
