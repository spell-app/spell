# Una tarea
Algo por hacer:  su título, su prioridad, y si está hecha.
Cada tarea es un elemento propio en la página, `<lista-de-tareas-tarea>`.
Un clic la selecciona, mayúsculas y comando (ctrl) seleccionan más, para el editor de propiedades (`seleccionable`);
arrastrarla la mueve, y las seleccionadas van con ella (`arrastrable`).

<encanto-vista "tarea" seleccionable arrastrable>
	<propiedad "título" descripción="Lo que hay que hacer">texto</>
	<propiedad "nota" descripción="Cualquier otra cosa sobre ella">texto</>
	<propiedad "prioridad" uno-de="baja, normal o alta" />
	<propiedad "hecha">sí o no</>
	<propiedad "orden" descripción="Dónde está en su agenda, desde 1:  se guarda con ella, así que el orden en que la gente arrastra las tareas vuelve">número</>
	<frase "está hecha">si su hecha es sí</>
	<frase "está pendiente">si su hecha es no</>
	<acción "tirarla" descripción="Fuera de donde se guarda:  una tarea que no se guarda en ningún lugar no tiene nada que hacer;  cada clase de tarea guardada dice cómo, en el archivo de su guardián">devolver</>

	<dibujar descripción="Un formulario propio, unido a ella:  marcar la casilla, o escribir un título, cambia la tarea;  su prioridad se muestra solo cuando no es normal">
		<formulario value={eso}>
			<pila direccion="horizontal" separacion="sm">
				<icono name="grip vertical" color="grey" aria-label="Arrastrar"/>
				<casilla name="hecha" aria-label="Hecha"/>
				<entrada part="title" name="título" aria-label="Tarea" apariencia="transparent" fluido/>
				<si la prioridad no es normal>
					<etiqueta tamano="diminuto" color={"red" si la prioridad es alta de lo contrario "grey"}>{la prioridad}</etiqueta>
				</>
			</pila>
		</formulario>
	</dibujar>

	<probar "marcar una">
		poner la tarea a una nueva tarea con título = "Escribir las pruebas"
		la tarea está pendiente debería ser sí
		poner la hecha de la tarea a sí
		la tarea está hecha debería ser sí
	</probar>
</encanto-vista>
