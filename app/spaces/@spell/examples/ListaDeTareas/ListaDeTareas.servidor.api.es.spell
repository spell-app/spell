## Guardadas en un archivo JSON en el servidor
// Las tareas son una carpeta de datos del proyecto en el servidor de Spell:  cada tarea un archivo JSON, en `__data/tareas` de este proyecto.
// Todos los que usan la aplicación las comparten, y cada persona cambia solo las tareas que hizo.
// Abre una en un editor y cámbiala:  la aplicación lo muestra en su siguiente revisión.
<carpeta-de-datos "archivos de tareas" dirección="tareas">
	- se revisa cada 30 segundos
</carpeta-de-datos>

<vista "tarea del servidor" plantilla="tarea">
	<encanto>
		- vive en archivos de tareas
	</encanto>
	<acción "tirarla">
		quitar eso de las tareas del servidor
	</acción>
</vista>

<cosa "guardián del servidor" plantilla="guardián de tareas">
	<encanto>
		- sus "tareas guardadas" es cada tarea del servidor
	</encanto>
	<acción "guardar una tarea nueva titulada (título como texto)">
		poner tarea a una nueva tarea del servidor con título = título
		agregar tarea a las tareas del servidor
		devolver tarea
	</acción>
</cosa>
