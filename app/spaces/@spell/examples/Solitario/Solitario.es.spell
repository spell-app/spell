# Solitario Klondike
// Reparte siete columnas, luego arma cuatro fundaciones, del as al rey, un palo cada una:
// la [wikipedia](https://en.wikipedia.org/wiki/Klondike_(solitaire)) tiene sus reglas, y cómo se llama cada pila.
// Las cartas, el mazo y las pilas son los de este proyecto:  `Carta`, `Mazo` y `Pila`.
// Cada pila se declara donde se dibuja, `<columna "C1"/>`, y también la puntuación, `<número "puntuación"/>`.

solitario es una aplicación
	"mazo" es un nuevo mazo

	al crear el solitario
		agregar cada carta del mazo a la reserva
		reiniciar el juego

	para dibujar eso
		<segmento invertido unir-a="arriba" color="">
			<barra-herramientas class="GameBar" aria-label="Juego" apariencia="pildoras" invertido tamano="pequeño" encogible>
				<texto slot="titulo" tamano="grande" extranegrita>Solitario</texto>
				<acción "jugar solo"/>
				<acción "hacer trampa"/>
				<acción "reiniciar el juego"/>
				<divisor/>
				<acción "deshacer" solo-icono/>
				<acción "rehacer" solo-icono/>
				<texto slot="derecha">Puntos: <número "puntuación"/></>
			</barra-herramientas>
		</segmento>
		<contenedor relleno="pequeño" columnas="7" separacion="xs">
			<pila-de-reserva "reserva"/>
			<pila-de-descartes "descartes"/>
			<espaciador/>
			<fundación "tréboles" palo=tréboles/>
			<fundación "diamantes" palo=diamantes/>
			<fundación "corazones" palo=corazones/>
			<fundación "espadas" palo=espadas/>
			<columna "C1"/>
			<columna "C2"/>
			<columna "C3"/>
			<columna "C4"/>
			<columna "C5"/>
			<columna "C6"/>
			<columna "C7"/>
		</contenedor>
		<modal "ganaste">
			<texto tamano="grande">¡Felicidades!</>
			<texto>Tus puntos:  <número "puntuación" /></>
			<acción "reiniciar el juego" title="Juego nuevo" />
		</>
		<menú-contextual>
			<acción "jugar solo"/>
			<acción "hacer trampa"/>
			<acción "reiniciar el juego"/>
			<divisor/>
			<acción "deshacer"/>
			<acción "rehacer"/>
		</>

	grupo "Repartir"
	para "reiniciar el juego" con atajo "R", icono "sync alternate"
		limpiar la puntuación
		repartir las cartas

	para repartir las cartas
		// Junta cada carta en la reserva, barájala, y reparte las columnas
		para carta en el mazo
			poner pila inicial a la pila de la carta
			voltear la carta boca abajo
			si pila inicial no es la reserva
				agregar la carta a la reserva
				pausar 50 mseg
		barajar la reserva
		// la primera carta de cada fila cae boca abajo, y se voltea donde queda
		para fila desde 1 hasta 7
			para lugar desde fila hasta 7
				agregar la carta de arriba de la reserva al elemento lugar de las columnas
				si lugar es igual a fila
					voltear la última carta de (el elemento lugar de las columnas) boca arriba
				pausar 50 mseg
		robar de la reserva

	para robar de la reserva, deshacible como "Voltear carta"
		// Voltea la siguiente carta de la reserva, sobre los descartes:  los descartes de vuelta a la reserva cuando está vacía
		// - un clic en la reserva, un paso para deshacer;  el del reparto ninguno, pues empieza el juego
		si la reserva está vacía
			rehacer la reserva
		obtener la carta de arriba de la reserva
		voltear eso boca arriba
		// lo que tarda su giro (styles.css), así se voltea antes de moverse
		pausar 300 mseg
		agregar eso a los descartes

	para rehacer la reserva
		// Los descartes, volteados, de vuelta a la reserva
		poner cartas a una copia de la lista (los descartes) como una pila
		invertir las cartas
		agregar cada carta de las cartas a la reserva
		voltear cada carta de la reserva boca abajo

	grupo "Juego"

	para jugar una carta
		deshacible como "Jugar carta"
		si la carta está en la reserva
			robar de la reserva
		de lo contrario
			poner pila final a la primera pila en cada pila donde puede tomar la carta
			si no hay una pila final devolver no
			devolver mover la carta a pila final

	después de mover una carta a una pila
		// El movimiento suma puntos;  la columna que dejó voltea su nueva última carta
		agregar (los puntos por la carta en la pila) a la puntuación del solitario
		si la última pila de la carta es una columna y no está vacía
			voltear su última carta boca arriba

	para "jugar solo" con atajo "A", icono "play"
		// Juega cada carta que puede ir a algún lado, hasta que ninguna pueda
		poner hubo cambios a no
		si los descartes no está vacía
			poner candidata a la última carta de los descartes
			si jugar candidata
				poner hubo cambios a sí
				pausar 500 mseg
		// la última carta de cada columna a su fundación
		para pila en las columnas
			si la pila está vacía devolver
			poner candidata a la última carta de la pila
			poner fundación a la primera pila en las fundaciones donde su palo es el palo de candidata
			si la fundación puede tomar candidata
				poner hubo cambios a sí
				jugar candidata
				pausar 100 mseg
		// las cartas boca arriba de cada columna, todas juntas, a otra columna
		para pila en las columnas
			poner cartas visibles a las cartas en la pila donde la carta está boca arriba
			si cartas visibles está vacía devolver
			poner candidata a la primera carta de cartas visibles
			si candidata es un rey y candidata es la primera carta de la pila devolver
			si jugar candidata
				poner hubo cambios a sí
				pausar 500 mseg
		si hubo cambios jugar solo

	para "hacer trampa" con atajo "C", icono "eye"
		// Voltea una carta boca abajo de una columna, al azar, sobre los descartes
		poner pilas restantes a las pilas en las columnas donde no está vacía y su primera carta está boca abajo
		si pilas restantes está vacía devolver
		poner la pila a una pila al azar de pilas restantes
		poner la carta a una carta al azar de (las cartas en la pila donde la carta está boca abajo)
		// volteada mientras se mueve:  se alza boca abajo sobre su columna, luego se voltea mientras pasa a los descartes
		agregar la carta a los descartes
		voltear la carta boca arriba

	para "los puntos por (una carta) en (una pila)"
		// Lo que suma un movimiento:  10 a una fundación, 5 desde los descartes, si no nada
		si pila es una fundación devolver 10
		si la última pila de la carta es los descartes devolver 5
		devolver 0

	cuando su puntuación cambia
		si el número de cartas en las fundaciones es 52
			mostrar "ganaste"

una carta		-- jugar la carta al pulsarla, si es un movimiento válido
	cuando se pulsa
		si está boca arriba o su pila es la reserva del solitario
			jugar la carta


grupo "Las pilas"
// Cada tipo de pila, qué puede tomar o soltar, y cómo están sus cartas.
// Mientras está vacía, muestra su marcador, si tiene uno.

una "pila de reserva" es una pila con disposición "apilada"
	// Las cartas aún sin jugar, boca abajo:  un clic voltea la siguiente, así que no se le puede quitar ninguna
	nunca puede tomar una carta
	nunca puede soltar una carta
	para dibujar su marcador
		<imagen-de-carta dirección=abajo />
	cuando se pulsa
		robar de la reserva

una "pila de descartes" es una pila con disposición "apilada"		-- Adonde van las cartas de la reserva al voltearse
	nunca puede tomar una carta
	sus cartas son arrastrables cuando la carta es su última carta

una "fundación" es una pila con disposición "apilada"		-- Donde se arma un palo, del as al rey, una carta a la vez
	su "palo" es un palo de carta
	nunca puede soltar una carta
	es soltable cuando
		devolver no si la carta no es la última carta de la pila de la carta
		devolver su palo es el palo de la carta y
		  su valor + 1 es el valor de la carta
	para dibujar su marcador			-- un as gris claro de su palo, boca arriba
		<imagen-de-carta rango=as palo={su palo} />

una "columna" es una pila con disposición "vertical"			-- Una columna, armada hacia abajo del rey al as, rojo y negro alternados
	sus cartas son arrastrables cuando la carta está boca arriba
	es soltable cuando
		está vacía y la carta es un rey
		o
		su color no es el color de la carta y
		  su valor es el valor de la carta + 1

para probar los movimientos
	poner la columna a una nueva columna con id "T1"
	poner el rey a una nueva carta cuyo rango es rey, palo es espadas y dirección es arriba
	poner la dama a una nueva carta cuyo rango es dama, palo es corazones y dirección es arriba
	poner la jota a una nueva carta cuyo rango es jota, palo es tréboles y dirección es arriba

	// una columna vacía toma solo un rey, luego uno más bajo del otro color
	la columna puede tomar la dama debería ser no
	la columna puede tomar el rey debería ser sí
	agregar el rey a la columna
	la columna puede tomar la jota debería ser no
	la columna puede tomar la dama debería ser sí
	agregar la dama a la columna
	el nombre corto de la columna debería ser "T1: R♠↑ D♥↑"
	la columna puede soltar la dama debería ser sí
	voltear la dama boca abajo
	la columna puede soltar la dama debería ser no

	// una fundación toma su palo, el as primero, luego uno más alto:  cada una la última carta de su pila
	poner la fundación a una nueva fundación con palo = corazones
	poner el dos a una nueva carta cuyo rango es 2, palo es corazones y dirección es arriba
	poner el as a una nueva carta cuyo rango es as, palo es corazones y dirección es arriba
	poner la columna a una nueva columna con id "T2"
	agregar el dos a la columna
	agregar el as a la columna
	la fundación puede tomar el dos debería ser no
	la fundación puede tomar el as debería ser sí
	mover el as a la fundación
	la fundación puede tomar el dos debería ser sí
	agregar la dama a la columna
	la fundación puede tomar la dama debería ser no
