## The Met Museum:  every artwork in its collection, and a search of all of it
// A server other people run, and what it holds.  What's drawn from it is in MetMuseum.spell.
// `met museum` is what this wrote, from looking at the server:
//   spell place ingest https://collectionapi.metmuseum.org/public/collection --kind "web server" --docs https://metmuseum.github.io
//     --into MetMuseum.api.spell --name "met museum" --no-ai --collections "artworks=/v1/objects,artworks=/v1.1/search?q=sunflowers"
// `spell place update MetMuseum.api.spell` looks again, and changes only this file and MetMuseum.api.json5.
// Its list is only ids, over 500,000 of them:  each artwork is read whole from its own address, only when something reads it.
// Its search finds ids too, looking at all of each artwork, its tags too:  `every artwork matching ...`.
// It asks for 80 requests a second at most, in its docs:  a program keeps to that.
// Its search pages by "limit" and "offset", up to 500 at a time;  its list of every id takes neither, and comes whole.

<web-server "met museum" address="https://collectionapi.metmuseum.org/public/collection">
	- its id is its "objectID"
	- its rows are its "objectIDs"
	- its lists give only each one's "objectID"
	- its next page is asked for with "limit" and "offset"
	- it gives up to 500 at a time
	- check it every 30 seconds
	- it takes up to 80 requests a second
	- it searches everything with "q" at "/v1.1/search"
	- artworks live at "/v1/objects"
</web-server>

<spell-thing "artwork">
	<spell>
		- it lives in met museum
		- its "highlight" is yes or no, stored as "isHighlight"
	</spell>
	<property "accession number">text</>
	<property "accession year" type="number" />
	<spell>
		- its "public domain" is yes or no, stored as "isPublicDomain"
	</spell>
	<property "primary image">text</>	// an address
	<property "primary image small">text</>	// an address
	<property "additional images">a list of text</>
	<property "constituents">a list of constituents</>
	<property "department">text</>
	<property "object name">text</>
	<property "title">text</>
	<property "culture">text</>
	<property "period">text</>
	<property "dynasty">text</>
	<property "reign">text</>
	<property "portfolio">text</>
	<property "artist role">text</>
	<property "artist prefix">text</>
	<property "artist display name">text</>
	<property "artist display bio">text</>
	<property "artist suffix">text</>
	<property "artist alpha sort">text</>
	<property "artist nationality">text</>
	<property "artist begin date" type="number" />
	<property "artist end date" type="number" />
	<property "artist gender">text</>
	<property "artist wikidata url">text</>	// an address
	<property "artist ulan url">text</>	// an address
	<property "object date">text</>
	<property "object begin date" type="number" />
	<property "object end date" type="number" />
	<property "medium">text</>
	<property "dimensions">text</>
	<property "measurements">a list of measurements</>
	<property "credit line">text</>
	<property "geography type">text</>
	<property "city">text</>
	<property "state">text</>
	<property "county">text</>
	<property "country">text</>
	<property "region">text</>
	<property "subregion">text</>
	<property "locale">text</>
	<property "locus">text</>
	<property "excavation">text</>
	<property "river">text</>
	<property "classification">text</>
	<property "rights and reproduction">text</>
	<property "link resource">text</>
	<property "metadata date" type="date" />
	<property "repository">text</>
	<spell>
		- its "object url" is text, stored as "objectURL"  // an address
	</spell>
	<property "tags">a list of tags</>
	<property "object wikidata url">text</>	// an address
	<spell>
		- its "timeline work" is yes or no, stored as "isTimelineWork"
	</spell>
	<property "gallery number" type="number" />
</spell-thing>

<spell-thing "constituent">
	<spell>
		- its "constituent id" is a number, stored as "constituentID"
	</spell>
	<property "role">text</>
	<property "name">text</>
	<property "constituent ulan url">text</>	// an address
	<property "constituent wikidata url">text</>	// an address
	<property "gender">text</>
</spell-thing>

<spell-thing "measurement">
	<property "element name">text</>
	<property "element description">text</>
	<property "element measurements">an element measurement</>
</spell-thing>

<spell-thing "element measurement">
	<property "diameter" type="number" />
	<property "height" type="number" />
	<property "width" type="number" />
	<property "depth" type="number" />
</spell-thing>

<spell-thing "tag">
	<property "term">text</>
	<property "aat url">text</>	// an address
	<property "wikidata url">text</>	// an address
</spell-thing>
