## REST Countries:  every country in the world, its flag, its capital, its money, its languages and its names
// A server other people run, and what it holds.  What's drawn from it is in RestCountries.spell.
// `rest countries` is what this wrote, from looking at the server:
//   spell place ingest https://cdn.jsdelivr.net/gh/mledoze/countries@5.1.0 --into RestCountries.api.spell
//     --name "rest countries" --no-ai --collections "countries=/countries.json"
// `spell place update RestCountries.api.spell` looks again, and changes only this file and RestCountries.api.json5.
// It's the data restcountries.com serves, from the repository that keeps it:  every country in one answer, with no paging.
// Its money, its languages and its names come keyed by a code, `"EUR": { ... }`, `"fra": "French"`:
// each is a list of things, each with its code, `the first translation in its translations where its code is "fra"`.

<web-server "rest countries" address="https://cdn.jsdelivr.net/gh/mledoze/countries@5.1.0">
	- check it every 30 seconds
	- countries live at "/countries.json"
</web-server>

<thing "country">
	<spell>
		- it lives in rest countries
	</spell>
	<property "name" type="name" />
	<property "tld">a list of text</>
	<property "cca2">text</>
	<property "ccn3">text</>
	<property "cca3">text</>
	<property "cioc">text</>
	<property "independent">yes or no</>
	<property "status">text</>
	<property "un member">yes or no</>
	<property "un regional group">text</>
	<property "currencies">a list of currencies</>
	<property "idd" type="idd" />
	<property "capital">a list of text</>
	<property "alt spellings">a list of text</>
	<property "region">text</>
	<property "subregion">text</>
	<property "languages">a list of languages</>
	<property "translations">a list of translations</>
	<property "latlng">a list of numbers</>
	<property "landlocked">yes or no</>
	<property "borders">a list of text</>
	<property "area" type="number" />
	<property "flag">text</>
	<property "demonyms" type="demonym" />
</thing>

<thing "name">
	<property "common">text</>
	<property "official">text</>
	<property "native">a list of natives</>
</thing>

<thing "native">
	<property "code">text</>
	<property "official">text</>
	<property "common">text</>
</thing>

<thing "currency">
	<property "code">text</>
	<property "name">text</>
	<property "symbol">text</>
</thing>

<thing "idd">
	<property "root">text</>
	<property "suffixes">a list of text</>
</thing>

<thing "language">
	<property "code">text</>
	<property "name">text</>
</thing>

<thing "translation">
	<property "code">text</>
	<property "official">text</>
	<property "common">text</>
</thing>

<thing "demonym">
	<property "eng" type="eng" />
	<property "fra" type="fra" />
</thing>

<thing "eng">
	<property "f">text</>
	<property "m">text</>
</thing>

<thing "fra">
	<property "f">text</>
	<property "m">text</>
</thing>
