    "\t- its \"repository creation\" is text",
    "\t- its \"repository hooks\" is text",
    "\t- its \"statuses\" is text",
    "\t- its \"workflows\" is text",
    "",
    "a \"sub issues summary\" is a thing:",
    "\t- its \"total\" is a number",
    "\t- its \"completed\" is a number",
    "\t- its \"percent completed\" is a number",
    "",
    "an \"issue dependencies summary\" is a thing:",
    "\t- its \"blocked by\" is a number",
    "\t- its \"total blocked by\" is a number",
    "\t- its \"blocking\" is a number",
    "\t- its \"total blocking\" is a number",
    "",
    "a \"license\" is a thing:",
    "\t- its \"key\" is text",
    "\t- its \"name\" is text",
    "\t- its \"spdx id\" is text",
    "\t- its \"url\" is text  // an address",
    "\t- its \"node id\" is text"
  ]
}
