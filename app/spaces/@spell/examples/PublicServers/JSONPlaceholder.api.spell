## JSONPlaceholder:  posts and their comments, people, and their todos, on a server for practice
// A server other people run, and what it holds.  What's drawn from it is in JSONPlaceholder.spell.
// `jsonplaceholder` is what this wrote, from looking at the server:
//   spell place ingest https://jsonplaceholder.typicode.com --into JSONPlaceholder.api.spell --name jsonplaceholder
//     --no-ai --try-writes --collections "posts=/posts,comments=/comments,users=/users,todos=/todos"
// `spell place update JSONPlaceholder.api.spell` looks again, and changes only this file and JSONPlaceholder.api.json5.
// It takes adding, changing and deleting, and answers as if each was saved, but keeps nothing:
// what you add is gone when it's read again (JSONPlaceholder.api.json5, its "write").

<web-server "jsonplaceholder" address="https://jsonplaceholder.typicode.com">
	- check it every 30 seconds
	- it searches names and titles with "q"
	- posts live at "/posts"
	- comments live at "/comments"
	- jsonplaceholder users live at "/users"
	- todos live at "/todos"
	- a post's comments live at "/posts/{id}/comments"
	- a jsonplaceholder user's posts live at "/users/{id}/posts"
	- a jsonplaceholder user's todos live at "/users/{id}/todos"
</web-server>

<thing "post">
	<spell>
		- it lives in jsonplaceholder
	</spell>
	<property "user id" type="number" />
	<property "title">text</>
	<property "body">text</>
	<property "comments">a list of comments</>
</thing>

<thing "comment">
	<spell>
		- it lives in jsonplaceholder
	</spell>
	<property "post id" type="number" />
	<property "name">text</>
	<property "email">text</>
	<property "body">text</>
</thing>

<thing "jsonplaceholder user">
	<spell>
		- it lives in jsonplaceholder
	</spell>
	<property "name">text</>
	<property "username">text</>
	<property "email">text</>
	<property "address" type="address" />
	<property "phone">text</>
	<property "website">text</>
	<property "company" type="company" />
	<property "posts">a list of posts</>
	<property "todos">a list of todos</>
</thing>

<thing "todo">
	<spell>
		- it lives in jsonplaceholder
	</spell>
	<property "user id" type="number" />
	<property "title">text</>
	<property "completed">yes or no</>
</thing>

<thing "address">
	<property "street">text</>
	<property "suite">text</>
	<property "city">text</>
	<property "zipcode">text</>
	<property "geo" type="geo" />
</thing>

<thing "geo">
	<property "lat" type="number" />
	<property "lng" type="number" />
</thing>

<thing "company">
	<property "name">text</>
	<property "catch phrase">text</>
	<property "bs">text</>
</thing>
