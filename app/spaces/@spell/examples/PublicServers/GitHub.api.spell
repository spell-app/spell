## GitHub:  a repository's issues, the people who wrote it, anyone by their login, and a search of people and repositories
// A server other people run, and what it holds.  What's drawn from it is in GitHub.spell.
// `github` is what this wrote, from looking at the server:
//   spell place ingest https://api.github.com --into GitHub.api.spell --name github --no-ai --key-secret GITHUB_TOKEN
//     --collections "issues=/repos/solidjs/solid/issues,contributors=/repos/solidjs/solid/contributors,users=/users/{name},
//       users=/search/users?q=ryansolid,repositories=/search/repositories?q=solid"
//     --samples ryansolid,solidjs,octocat
// `spell place update GitHub.api.spell` looks again, and changes only this file and GitHub.api.json5.
// Its key is your own, named GITHUB_TOKEN, read from the environment and never written here (`gh auth token` gives one).
// Without it, GitHub answers 60 requests an hour;  with it, 5000.  A page in a browser always goes without.
// Its searches have a limit of their own:  10 a minute without a key, 30 with one.
// People and organizations are both users here:  their "kind" says which.

<web-server "github" address="https://api.github.com">
	- its optional key is the secret "GITHUB_TOKEN"
	- its next page is in its "Link" header
	- it gives up to 100 at a time, asked for with "per_page"
	- check it every 40 minutes
	- it writes names like "repository_url"
	- issues live at "/repos/solidjs/solid/issues"
	- contributors live at "/repos/solidjs/solid/contributors"
	- users are found at "/users/{name}"
	- a user's id is its "login"
	- users are searched with "q" at "/search/users"
	- repositories are searched with "q" at "/search/repositories"
</web-server>

<spell-thing "issue">
	<spell>
		- it lives in github
	</spell>
	<property "url" type="issue" />
	<property "repository url">text</>	// an address
	<property "labels url">text</>	// an address
	<property "comments url">text</>	// an address
	<property "events url">text</>	// an address
	<property "html url">text</>	// an address
	<property "node id">text</>
	<property "number" type="number" />
	<property "title">text</>
	<property "user">an issue user</>
	<property "labels">a list of labels</>
	<property "state">text</>
	<property "locked">yes or no</>
	<property "assignees">a list of assignees</>
	<property "comments" type="number" />
	<property "created at" type="date" />
	<property "updated at" type="date" />
	<property "author association">text</>
	<property "issue field values">a list of text</>
	<property "sub issues summary">a sub issues summary</>
	<property "issue dependencies summary">an issue dependencies summary</>
	<property "body">text</>
	<property "reactions" type="reaction" />
	<property "timeline url">text</>	// an address
	<property "performed via github app">a performed via github app</>
	<property "state reason">text</>
	<property "draft">yes or no</>
	<property "pull request">a pull request</>
	<property "assignee" type="assignee" />
</spell-thing>

