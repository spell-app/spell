## Open Library:  books by what they're called, who wrote them, and their covers
// A server other people run, and what it holds.  What's drawn from it is in OpenLibrary.spell.
// `open library` is what this wrote, from looking at the server:
//   spell place ingest https://openlibrary.org --into OpenLibrary.api.spell --name "open library" --no-ai
//     --collections "books=/search.json?q=dune,authors=/authors/{name}.json,editions=/books/{name}.json"
//     --samples authors=OL79034A,editions=OL32848840M --pictures "cover_i=https://covers.openlibrary.org/b/id/{id}-M.jpg"
// `spell place update OpenLibrary.api.spell` looks again, and changes only this file and OpenLibrary.api.json5.
// It has no list of every book:  a program searches it, `every book where its title includes ...`.
// A book's editions are read from its own list of them, when its page shows them.
// Each book's authors are their ids, each read from the author's own record when something reads it;
// its cover is a picture on another server, covers.openlibrary.org, its address built from the book's cover id.

<web-server "open library" address="https://openlibrary.org">
	- its id is its "key"
	- its rows are its "docs"
	- check it every 30 seconds
	- it writes names like "author_key"
	- it searches titles with "q"
	- books are searched at "/search.json"
	- authors are found at "/authors/{name}.json"
	- editions are found at "/books/{name}.json"
	- a book's "cover i" is a picture at "https://covers.openlibrary.org/b/id/{id}-M.jpg"
	- a book's editions live at "{id}/editions.json"
</web-server>

<thing "book">
	<spell>
		- it lives in open library
		- its "authors" is a list of authors, stored as "author_key"
	</spell>
	<property "author name">a list of text</>
	<spell>
		- its "cover edition" is an edition, stored as "cover_edition_key"
	</spell>
	<property "cover height" type="number" />
	<property "cover i">text</>	// a picture's address
	<property "cover width" type="number" />
	<property "ebook access">text</>
	<property "edition count" type="number" />
	<property "first publish year" type="number" />
	<spell>
		- its "fulltext" is yes or no, stored as "has_fulltext"
	</spell>
	<property "ia">a list of text</>
	<property "ia collection">a list of text</>
	<property "language">a list of text</>
	<property "lending edition s">text</>
	<property "lending identifier s">text</>
	<property "public scan b">yes or no</>
	<property "editions">a list of editions</>
	<property "series key">a list of text</>
	<property "series name">a list of text</>
	<property "series position">a list of text</>
	<property "title">text</>
	<property "subtitle">text</>
</thing>

<thing "author">
	<spell>
		- it lives in open library
	</spell>
	<property "links">a list of links</>
	<spell>
		- its "kind" is a kind, stored as "type"
	</spell>
	<property "key">text</>
	<property "name">text</>
	<property "source records">a list of text</>
	<property "birth date">text</>
	<property "bio">text</>
	<property "title">text</>
	<property "alternate names">a list of text</>
	<property "remote ids">a remote id</>
	<property "photos">a list of numbers</>
	<property "death date">text</>
	<property "personal name">text</>
	<property "latest revision" type="number" />
	<property "revision" type="number" />
	<property "created" type="created" />
	<property "last modified">a last modified</>
</thing>

<thing "edition">
	<spell>
		- it lives in open library
		- its "kind" is a kind, stored as "type"
	</spell>
	<property "title">text</>
	<property "authors">a list of edition authors</>
	<property "publish date">text</>
	<property "source records">a list of text</>
	<property "number of pages" type="number" />
	<property "publishers">a list of text</>
	<property "physical format">text</>
	<property "notes" type="note" />
	<property "full title">text</>
	<property "covers">a list of numbers</>
	<property "works">a list of works</>
	<property "key">text</>
	<property "local id">a list of text</>
	<property "latest revision" type="number" />
	<property "revision" type="number" />
	<property "created" type="created" />
	<property "last modified">a last modified</>
</thing>

<thing "link">
	<property "title">text</>
	<property "url">text</>	// an address
	<spell>
		- its "kind" is a kind, stored as "type"
	</spell>
</thing>

<thing "kind">
	<property "key">text</>
</thing>

<thing "remote id">
	<property "viaf" type="number" />
	<property "wikidata">text</>
	<property "isni" type="number" />
	<property "amazon">text</>
	<property "bookbrainz">text</>
	<property "goodreads" type="number" />
	<property "gnd" type="number" />
	<property "imdb">text</>
	<property "lc naf">text</>
	<property "librarything">text</>
	<property "musicbrainz">text</>
	<property "storygraph">text</>
	<property "inventaire">text</>
	<property "librivox" type="number" />
	<property "project gutenberg" type="number" />
	<property "opac sbn">text</>
</thing>

<thing "created">
	<spell>
		- its "kind" is text, stored as "type"
	</spell>
	<property "value" type="date" />
</thing>

<thing "last modified">
	<spell>
		- its "kind" is text, stored as "type"
	</spell>
	<property "value" type="date" />
</thing>

<thing "edition author">
	<property "key">text</>
</thing>

<thing "note">
	<spell>
		- its "kind" is text, stored as "type"
	</spell>
	<property "value">text</>
</thing>

<thing "work">
	<property "key">text</>
</thing>
