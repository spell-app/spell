{
  "title": "Star Wars",
  "description": "A guide to the galaxy from two servers other people run:  a place's rows linked by address, followed by saying what a field links to;  its API in a file of its own, as `spell place ingest` wrote it;  a long list that draws as you scroll;  pictures from a second place;  waiting, failing, and an opening crawl",
  "readsOtherPeoplesServers": true,
  "imports": [{
    "path": "/StarWars.api.spell",
    "active": true
  }, {
    "path": "/StarWars.spellml",
    "active": true
  }, {
    "path": "/styles.css",
    "active": true
  }, {
    "path": "/StarWarsCrawl.spellml",
    "active": true
  }, {
    "path": "/StarWarsJump.spellml",
    "active": true
  }, {
    "path": "/StarWarsPortrait.spellml",
    "active": true
  }]
}
