## Star Wars:  where it all lives
// A server other people run, and what it holds.  What's drawn and done with it is in StarWars.spell;
// the pictures and what they're of come from Wikipedia, in Wikipedia.api.spell.
// `star wars` is what this wrote, from looking at the server:
//   spell place ingest https://swapi.py4e.com/api --into StarWars.api.spell --name "star wars"
// `spell place update StarWars.api.spell` looks again, and changes only this file and StarWars.api.json5.
// A height, a mass and a diameter say their units, cm, kg and km, as swapi's docs give them:
// so each shows in the reader's own, 5 ft 8 in in the US.
//
// Star Wars belongs to Lucasfilm and Disney.
// It's asked for as it runs, and kept only on the device of whoever's looking, until 5am;
// the page says where it comes from.

<web-server "star wars" address="https://swapi.py4e.com/api">
	- its id is its "url"
	- its rows are its "results"
	- its next page is its "next"
	- it writes names like "hair_color"
	- it searches names and titles with "search"
	- check it once a day at 5am
	- keep a copy on this device
	- characters live at "/people/"
	- planets live at "/planets/"
	- films live at "/films/"
	- species live at "/species/"
	- vehicles live at "/vehicles/"
	- starships live at "/starships/"
</web-server>

<thing "character">
	<spell>
		- it lives in star wars
	</spell>
	<property "name">text</>
	<spell>
		- its "height" is a length in cm or "unknown"
		- its "mass" is a weight in kg or "unknown"
	</spell>
	<property "hair color">text</>
	<property "skin color">text</>
	<property "eye color">text</>
	<property "birth year">text</>
	<property "gender">text</>
	<property "homeworld" type="planet" />
	<property "films">a list of films</>
	<property "species">a list of species</>
	<property "vehicles">a list of vehicles</>
	<property "starships">a list of starships</>
	<property "created" type="date" />
	<property "edited" type="date" />
</thing>

<thing "planet">
	<spell>
		- it lives in star wars
	</spell>
	<property "name">text</>
	<spell>
		- its "rotation period" is a number or "unknown"
		- its "orbital period" is a number or "unknown"
		- its "diameter" is a length in km
	</spell>
	<property "climate">text</>
	<property "gravity">text</>
	<property "terrain">text</>
	<spell>
		- its "surface water" is a number or "unknown"
		- its "population" is a number or "unknown"
	</spell>
	<property "residents">a list of characters</>
	<property "films">a list of films</>
	<property "created" type="date" />
	<property "edited" type="date" />
</thing>

<thing "film">
	<spell>
		- it lives in star wars
	</spell>
	<property "title">text</>
	<property "episode id" type="number" />
	<property "opening crawl">text</>
	<property "director">text</>
	<property "producer">text</>
	<property "release date" type="date" />
	<property "characters">a list of characters</>
	<property "planets">a list of planets</>
	<property "starships">a list of starships</>
	<property "vehicles">a list of vehicles</>
	<property "species">a list of species</>
	<property "created" type="date" />
	<property "edited" type="date" />
</thing>

<thing "species">
	<spell>
		- it lives in star wars
	</spell>
	<property "name">text</>
	<property "classification">text</>
	<property "designation">text</>
	<spell>
		- its "average height" is a number or "n/a" or "unknown"
	</spell>
	<property "skin colors">text</>
	<property "hair colors">text</>
	<property "eye colors">text</>
	<property "average lifespan">text</>
	<property "homeworld" type="planet" />
	<property "language">text</>
	<property "people">a list of characters</>
	<property "films">a list of films</>
	<property "created" type="date" />
	<property "edited" type="date" />
</thing>

<thing "vehicle">
	<spell>
		- it lives in star wars
	</spell>
	<property "name">text</>
	<property "model">text</>
	<property "manufacturer">text</>
	<spell>
		- its "cost in credits" is a number or "unknown"
	</spell>
	<property "length" type="number" />
	<property "max atmosphering speed" type="number" />
	<property "crew" type="number" />
	<property "passengers" type="number" />
	<spell>
		- its "cargo capacity" is a number or "none" or "unknown"
	</spell>
	<property "consumables">text</>
	<property "vehicle class">text</>
	<property "pilots">a list of characters</>
	<property "films">a list of films</>
	<property "created" type="date" />
	<property "edited" type="date" />
</thing>

<thing "starship">
	<spell>
		- it lives in star wars
	</spell>
	<property "name">text</>
	<property "model">text</>
	<property "manufacturer">text</>
	<spell>
		- its "cost in credits" is a number or "unknown"
	</spell>
	<property "length" type="number" />
	<property "max atmosphering speed">text</>
	<property "crew">text</>
	<spell>
		- its "passengers" is a number or "n/a" or "unknown"
		- its "cargo capacity" is a number or "unknown"
	</spell>
	<property "consumables">text</>
	<spell>
		- its "hyperdrive rating" is a number or "unknown"
		- its "mglt" is a number or "unknown"
	</spell>
	<property "starship class">text</>
	<property "pilots">a list of characters</>
	<property "films">a list of films</>
	<property "created" type="date" />
	<property "edited" type="date" />
</thing>
