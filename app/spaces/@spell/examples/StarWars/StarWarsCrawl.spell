# The opening:  yellow, receding, and it stops when you say
A widget of its own:  `ui-modal` is the cinema, and no `ui-*` tilts words away into the distance.

<extend "film">
	<draw "crawl">
		<modal class="crawl" visible overlay fullscreen on-ui-closed={end it} aria-label={"The opening of " + its title}>
			<text class="long-ago" size="big">A long time ago in a galaxy far, far away....</text>
			<segment class="stage" appearance="basic">
				<segment class="words" appearance="basic">
					<header class="episode" font="all-caps">Episode {its episode id}</header>
					<header class="crawl-title" font="all-caps">{its title}</header>
					<text paragraph class="crawl-text">{its opening crawl}</text>
				</segment>
			</segment>
			<button class="stop" onClick={end it}>Stop</button>
		</modal>
	</draw>
</extend>
