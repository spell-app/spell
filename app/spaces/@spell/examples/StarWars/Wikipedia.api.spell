## Wikipedia:  a page each, by its name.  Not every name has one
// A server other people run:  what Star Wars shows of a character, a planet or a ship, and its picture.
// `wikipedia` is what this wrote, from reading a few pages by name, as there's no list of them all:
//   spell place ingest https://en.wikipedia.org/api/rest_v1 --kind "web server" --into Wikipedia.api.spell
//     --name wikipedia --collections "wiki pages=/page/summary/{name}" --samples "Luke Skywalker,Tatooine,Millennium Falcon"
// `spell place update Wikipedia.api.spell` looks again, by the same names, and changes only this file and Wikipedia.api.json5.
// A wiki page's "about" and "summary" are Star Wars' words for Wikipedia's "description" and "extract".
//
// Its words belong to Wikipedia's writers.  They're asked for as it runs, never kept here, and the page says so.

<web-server "wikipedia" address="https://en.wikipedia.org/api/rest_v1">
	- its id is its "title"
	- check it once a day
	- it writes names like "wikibase_item"
	- wiki pages are found at "/page/summary/{name}"
</web-server>

<thing "wiki page">
	<spell>
		- it lives in wikipedia
		- its "kind" is text, stored as "type"
	</spell>
	<property "displaytitle">text</>
	<property "namespace" type="namespace" />
	<property "wikibase item">text</>
	<property "titles" type="title" />
	<property "pageid" type="number" />
	<property "thumbnail" type="thumbnail" />
	<property "originalimage" type="originalimage" />
	<property "lang">text</>
	<property "dir">text</>
	<property "revision" type="number" />
	<property "tid">text</>
	<property "timestamp" type="date" />
	<spell>
		- its "about" is text, stored as "description"
	</spell>
	<property "description source">text</>
	<property "content urls">a content url</>
	<spell>
		- its "summary" is text, stored as "extract"
	</spell>
	<property "extract html">text</>
	<property "title">text</>
</thing>

<thing "namespace">
	<spell>
		- its "number" is a number, stored as "id"
	</spell>
	<property "text">text</>
</thing>

<thing "title">
	<property "canonical">text</>
	<property "normalized">text</>
	<property "display">text</>
</thing>

<thing "thumbnail">
	<property "source">text</>	// an address
	<property "width" type="number" />
	<property "height" type="number" />
</thing>

<thing "originalimage">
	<property "source">text</>	// an address
	<property "width" type="number" />
	<property "height" type="number" />
</thing>

<thing "content url">
	<property "desktop" type="desktop" />
	<property "mobile" type="mobile" />
</thing>

<thing "desktop">
	<property "page">text</>	// an address
	<property "revisions">text</>	// an address
	<property "edit">text</>	// an address
	<property "talk">text</>	// an address
</thing>

<thing "mobile">
	<property "page">text</>	// an address
	<property "revisions">text</>	// an address
	<property "edit">text</>	// an address
	<property "talk">text</>	// an address
</thing>
