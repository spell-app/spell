  "notes": [
    "No authentication is required.",
    "Each collection is read whole at /name, and one row at /name/:id.",
    "Most numeric fields arrive as text and may hold \"n/a\" or \"unknown\", commas (\"1,600\"), trailing spaces (\"36.8 \") or ranges (\"30-165\").",
    "Links between collections are full URLs, matching the url field of the row they point to.",
    "A species homeworld can be null.",
    "Row ids can have gaps: the first vehicles are 4, 6 and 7.",
    "Film opening_crawl text contains line breaks.",
    "Each collection has a JSON schema at /name/schema."
  ],
  "spellCantSay": [
    "What it can filter or sort:  no line says, so `where` and `sorted by` load its rows and work here, up to the usual ceiling.",
    "That it's read only:  no line says, so a program's write compiles, and fails when it runs."
  ],
  "checkEverySeconds": 86400,
  "spell": [
    "star wars is a web server at \"https://swapi.info/api\":",
    "\t- its id is its \"url\"",
    "\t- check it every 86400 seconds",
    "\t- films live at \"/films\"",
    "\t- people live at \"/people\"",
    "\t- planets live at \"/planets\"",
    "\t- species live at \"/species\"",
    "\t- vehicles live at \"/vehicles\"",
