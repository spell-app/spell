  "spell": [
    "star wars is a web server at \"https://swapi.py4e.com/api\":",
    "\t- its id is its \"url\"",
    "\t- its rows are its \"results\"",
    "\t- its next page is its \"next\"",
    "\t- check it every 30 seconds",
    "\t- characters live at \"/people\"",
    "\t- planets live at \"/planets\"",
    "\t- films live at \"/films\"",
    "\t- species live at \"/species\"",
    "\t- vehicles live at \"/vehicles\"",
    "\t- starships live at \"/starships\"",
    "\t- a character's hair color is its \"hair_color\"",
    "\t- a character's skin color is its \"skin_color\"",
    "\t- a character's eye color is its \"eye_color\"",
    "\t- a character's birth year is its \"birth_year\"",
    "\t- a planet's rotation period is its \"rotation_period\"",
    "\t- a planet's orbital period is its \"orbital_period\"",
    "\t- a planet's surface water is its \"surface_water\"",
    "\t- a film's episode id is its \"episode_id\"",
    "\t- a film's opening crawl is its \"opening_crawl\"",
    "\t- a film's release date is its \"release_date\"",
    "\t- a species's average height is its \"average_height\"",
    "\t- a species's skin colors is its \"skin_colors\"",
    "\t- a species's hair colors is its \"hair_colors\"",
    "\t- a species's eye colors is its \"eye_colors\"",
    "\t- a species's average lifespan is its \"average_lifespan\"",
    "\t- a vehicle's \"cost in credits\" is its \"cost_in_credits\"",
    "\t- a vehicle's max atmosphering speed is its \"max_atmosphering_speed\"",
    "\t- a vehicle's cargo capacity is its \"cargo_capacity\"",
    "\t- a vehicle's vehicle class is its \"vehicle_class\"",
    "\t- a starship's \"cost in credits\" is its \"cost_in_credits\"",
    "\t- a starship's max atmosphering speed is its \"max_atmosphering_speed\"",
    "\t- a starship's cargo capacity is its \"cargo_capacity\"",
    "\t- a starship's hyperdrive rating is its \"hyperdrive_rating\"",
    "\t- a starship's mglt is its \"MGLT\"",
    "\t- a starship's starship class is its \"starship_class\"",
    "",
    "a \"character\" is a thing:",
    "\t- it lives in star wars",
    "\t- its \"name\" is text",
    "\t- its \"height\" is a number  // written as text there;  \"unknown\" reads as nothing",
    "\t- its \"mass\" is a number  // written as text there;  \"unknown\" reads as nothing",
    "\t- its \"hair color\" is text",
    "\t- its \"skin color\" is text",
    "\t- its \"eye color\" is text",
    "\t- its \"birth year\" is text",
    "\t- its \"gender\" is text",
    "\t- its \"homeworld\" is a planet",
    "\t- its \"films\" is a list of films",
    "\t- its \"species\" is a list of species",
    "\t- its \"vehicles\" is a list of vehicles",
    "\t- its \"starships\" is a list of starships",
    "\t- its \"created\" is a date",
    "\t- its \"edited\" is a date",
    "",
    "a \"planet\" is a thing:",
    "\t- it lives in star wars",
    "\t- its \"name\" is text",
    "\t- its \"rotation period\" is a number  // written as text there;  \"unknown\" reads as nothing",
    "\t- its \"orbital period\" is a number  // written as text there;  \"unknown\" reads as nothing",
    "\t- its \"diameter\" is a number  // written as text there",
    "\t- its \"climate\" is text",
