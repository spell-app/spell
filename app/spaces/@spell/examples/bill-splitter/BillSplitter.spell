# Bill Splitter
Who owes what after a meal:  each person pays for what they ordered, and their share of the tip.
Change a name, an amount or the tip, and every sum follows.
A diner is this project's own, in `Diner.spell`, and how money is written is in `Money.spell`:
this file holds the bill.

## The bill

<app "bill splitter">
	<property "diners">a new table</>
	<property "percent" type="percent" description="The tip, as a part of what was ordered:  kept as its fraction, so 18% is 0.18">18%</property>
	<property "subtotal" description="What everyone ordered, added up">
		set added up to 0
		for diner in the diners
			set added up to added up + the diner's amount
		return added up
	</property>
	<property "tip">the subtotal * the percent</>
	<property "total">the subtotal + the tip</>

	<action "create it" description="Three diners to start with">
		add (a new diner with name = "Ana", amount = 24) to the diners
		add (a new diner with name = "Ben", amount = 18.5) to the diners
		add (a new diner with name = "Cleo", amount = 31.25) to the diners
	</action>
	<action "add someone" icon="plus" description="An empty row, for the next person">
		add (a new diner with name = "", amount = 0) to the diners
	</action>

	<draw description="The tip, the diners, then the sums">
		<container text>
			<stack>
				<header level="2">Bill Splitter</header>
				<form value={it}>
					<stack direction="horizontal" spacing="sm">
						<text bold>Tip</text>
						<input name="percent" type="percent" min="0" step="1" aria-label="Tip percent"/>
						<buttons size="small" appearance="basic">
							<button onClick={set the percent to 15%}>15%</button>
							<button onClick={set the percent to 18%}>18%</button>
							<button onClick={set the percent to 20%}>20%</button>
						</buttons>
					</stack>
				</form>
				{draw the diners}
				<stack direction="horizontal">
					<button appearance="basic" icon="plus" onClick={add someone}>Add someone</button>
				</stack>
				<segment>
					<statistics widths="3" size="small">
						<statistic value={write the subtotal as money} label="Ordered"/>
						<statistic value={write the tip as money} label="Tip"/>
						<statistic value={write the total as money} label="Total" color="green"/>
					</statistics>
				</segment>
			</stack>
		</container>
	</draw>
</app>
