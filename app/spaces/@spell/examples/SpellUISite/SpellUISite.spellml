<!--
  Spell UI's component pages as one site (epic `mockup` P1).
  Each component's tabs are notebooks of their own project, imported here:  the site says where each one is, and
  what the side navigation calls it.  The notebooks say nothing about their addresses, so a page moves here alone.
  Its first page, a component's Usage tab, is its address;  its other tabs are under it.
-->
<spell-site "spell ui">
	<page "button usage page" address="/button" title="Button">
		<page "button examples page" address="/button/examples" title="Examples"/>
		<page "button api page" address="/button/api" title="API"/>
		<page "button theming page" address="/button/theming" title="Theming"/>
	</>
	<page "action usage page" address="/action" title="Action">
		<page "action examples page" address="/action/examples" title="Examples"/>
		<page "action api page" address="/action/api" title="API"/>
		<page "action theming page" address="/action/theming" title="Theming"/>
	</>
	<page "modal usage page" address="/modal" title="Modal">
		<page "modal examples page" address="/modal/examples" title="Examples"/>
		<page "modal api page" address="/modal/api" title="API"/>
		<page "modal theming page" address="/modal/theming" title="Theming"/>
	</>
	<page "accordion usage page" address="/accordion" title="Accordion">
		<page "accordion examples page" address="/accordion/examples" title="Examples"/>
		<page "accordion api page" address="/accordion/api" title="API"/>
		<page "accordion theming page" address="/accordion/theming" title="Theming"/>
	</>
	<!-- the docs site's own:  its settings, and the syntax of the language a component page shows -->
	<dialog "settings dialog"/>
	<sidebar "syntax sidebar"/>
	<page "not found page"/>
	<page "error page"/>
</>
