{
  "title": "Spell UI Site",
  "description": "Spell UI's component pages as ONE site:  four components' notebooks, each tab a page at its own address (/button, /button/api ...), the side navigation's order the site's;  the notebooks are their own projects, imported, nothing copied",
  "imports": [
    {
      "path": "@spell/notebooks/Button",
      "active": true,
      "import": ["ButtonUsage", "ButtonExample", "ButtonApi", "ButtonTheming"]
    },
    {
      "path": "@spell/notebooks/Action",
      "active": true,
      "import": ["ActionUsage", "ActionExample", "ActionApi", "ActionTheming"]
    },
    {
      "path": "@spell/notebooks/Modal",
      "active": true,
      "import": ["ModalUsage", "ModalExample", "ModalApi", "ModalTheming"]
    },
    {
      "path": "@spell/notebooks/Accordion",
      "active": true,
      "import": ["AccordionUsage", "AccordionExample", "AccordionApi", "AccordionTheming"]
    },
    {
      "path": "/SpellUISite.spellml",
      "active": true
    }
  ]
}
