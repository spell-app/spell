a "card" is a draggable two sided view 			-- A playing card
	-- A card says what its rank, suit and color are:  a deck, a pile or the game only reads them.
	-- It's a two sided view:  each side is a card image (below):  face up its own, face down the back every card shares.
	-- On the page each card is its own element, `<solitaire-card>`:  people may drag it (`draggable`), when its pile lets it go.
	group "Card Rank & Suit"
		-- Ace is low:  ace = 1 ... king = 13
	its "rank" is one of ace, 2 ... 10, jack, queen, king
	its "suit" is one of clubs, diamonds, hearts or spades
	its "color" is one of red, black
		red if it is a diamond or it is a heart
		black otherwise

	group "Aliases"
		-- Spell for identifying cards
	it "is a face card" if its rank is jack, queen or king  -- e.g. "the card is a face card"
	it "is a number card" if it is not a face card
	it "is the (rank) of (suit)"  -- e.g. the card is the two of spades

	group "Names" 								-- identifying a card
	its "name" is its rank && "of" && its suit
	its "value" is the position of its rank
	its "symbol" is
		"♣" if it is a club
		"♦" if it is a diamond
		"♥" if it is a heart
		"♠" otherwise
	its "shorthand" is
		-- Its shorthand:  Q♠↓ is the queen of spades, face down
		letter is 10 if its value is 10 otherwise the first letter of its rank as uppercase
		arrow is "↑" if it is face up otherwise "↓"
		return letter + its symbol + arrow

	group "Drawing"
	to draw its front
		<card-image card={it} />
	to draw its back
		<card-image direction=down />

	to test card setup
		get a new card whose rank is queen, suit is spades and direction is down
		its name should be "queen of spades"
		its color should be black
		its value should be 12
		its shorthand should be "Q♠↓"
		it is a face card should be yes
		it is a spade should be yes
		it is a club should be no
		it is a queen should be yes
		it is a 2 should be no
		it is the queen of spades should be yes
		it is the queen of clubs should be no

		turn it over
		it is face up should be yes
		its shorthand should be "Q♠↑"

		set seven to a new card whose rank is 7 and suit is hearts
		seven is a number card should be yes
		the color of seven should be red

a "card image" is a view			-- A card's picture:  the one place a card's look lives
	-- Give it a card to draw, or a rank and a suit:  `<card-image card={the card} />`, `<card-image rank=ace suit={its suit} />`.
	-- It's face up, unless it's `direction=down`:  then it's the back every card shares.
	-- Today it's one letter of unicode's Playing Cards, at the size of the text around it:  its pile scales it to fit -- styles.css
	-- Real pictures of the cards can take its place:  only its picture and `to draw it` change.
	its "card" is a card			-- the card it draws
	its "rank" is a card rank
	its "suit" is a card suit
	its "direction" is up or down
	it "is face (direction)"
	when creating a card image
		-- given a card:  its rank and suit are the card's;  given a rank and a suit:  its card is a new one of them (its back needs none)
		if its card exists
			set its rank to the rank of its card
			set its suit to the suit of its card
		otherwise if it is not face down
			set its card to a new card whose rank is its rank and suit is its suit
	its "color" is
		blue if it is face down
		the color of its card otherwise
	its "picture" is
		-- draw the unicode character for card images
		-- see https://www.compart.com/en/unicode/block/U+1F0A0
		if it is face down
			return "🂠"
		set column to the value of its card
		if its card is a club
			return item column of ["🃑", "🃒", "🃓", "🃔", "🃕", "🃖", "🃗", "🃘", "🃙", "🃚", "🃛", "🃝", "🃞"]
		if its card is a diamond
			return item column of ["🃁", "🃂", "🃃", "🃄", "🃅", "🃆", "🃇", "🃈", "🃉", "🃊", "🃋", "🃍", "🃎"]
		if its card is a heart
			return item column of ["🂱", "🂲", "🂳", "🂴", "🂵", "🂶", "🂷", "🂸", "🂹", "🂺", "🂻", "🂽", "🂾"]
		return item column of ["🂡", "🂢", "🂣", "🂤", "🂥", "🂦", "🂧", "🂨", "🂩", "🂪", "🂫", "🂭", "🂮"]
	to draw it
		<text color={its color}>{its picture}</text>

	to test card images
		set queen to a new card whose rank is queen, suit is spades and direction is down
		get a new card image whose card is the queen
		its suit should be spades
		its picture should be "🂭"
		its color should be black

		set seven to a new card image whose rank is 7 and suit is hearts
		the name of seven's card should be "7 of hearts"
		the picture of seven should be "🂷"
		the color of seven should be red

		the picture of a new card image whose rank is ace and suit is clubs should be "🃑"
		the picture of a new card image whose rank is king and suit is diamonds should be "🃎"

		get a new card image whose direction is down
		its picture should be "🂠"
		its color should be blue
