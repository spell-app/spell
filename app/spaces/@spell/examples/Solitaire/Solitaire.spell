# Klondike Solitaire
// Deal seven columns, then build four foundations, ace to king, one suit each:
// [wikipedia](https://en.wikipedia.org/wiki/Klondike_(solitaire)) has its rules, and what each pile is called.
// The cards, the deck and the piles are this project's own:  `Card`, `Deck` and `Pile`.
// Each pile is declared where it's drawn, `<column "C1"/>`, and so is the score, `<number "score"/>`.

solitaire is an app
	"deck" is a new deck

	when creating solitaire
		add each card in the deck to the stock
		restart the game

	to draw it
		<segment inverted attach="top">
			<toolbar class="GameBar" aria-label="Game">
				<text slot="title" size="large" heavy>Solitaire</text>
				<buttons slot="center" padding="compact">
					<action "auto play"/>
					<action "cheat"/>
					<action "restart the game"/>
				</buttons>
				<buttons slot="center" padding="compact">
					<action "undo" icon-only/>
					<action "redo" icon-only/>
				</buttons>
				<text slot="right">Score: <number "score"/></>
			</toolbar>
		</segment>
		<container padding="small" columns="7" spacing="xs">
			<stock-pile "stock"/>
			<discard-pile "discards"/>
			<spacer/>
			<foundation "clubs" suit=clubs/>
			<foundation "diamonds" suit=diamonds/>
			<foundation "hearts" suit=hearts/>
			<foundation "spades" suit=spades/>
			<column "C1"/>
			<column "C2"/>
			<column "C3"/>
			<column "C4"/>
			<column "C5"/>
			<column "C6"/>
			<column "C7"/>
		</container>
		<context-menu>
			<action "auto play"/>
			<action "cheat"/>
			<action "restart the game"/>
			<divider/>
			<action "undo"/>
			<action "redo"/>
		</>

	group "Dealing"
	to "restart the game" with title "Restart", shortcut "R"
		clear the score
		deal the cards
	
	to deal the cards
		// Gather every card into the stock, shuffle it, and deal the columns
		for card in the deck
			set start pile to card's pile
			turn the card face down
			if start pile is not the stock
				add the card to the stock
				pause for 50 msec
		shuffle the stock
		// each row's first card lands face down, then turns up where it lies
		for row from 1 to 7
			for column from row to 7
				add the last card of the stock to item column of the columns
				if column is the same as row
					turn the last card of (item column of the columns) face up
				pause for 50 msec
		play from the stock

	to play from the stock
		// Turn the stock's next card over, onto the discards:  the discards back into the stock when it's empty
		if the stock is empty
			reset the stock
		get the last card of the stock
		turn it face up
		// as long as its flip takes (styles.css), so it turns over before it moves
		pause for 300 msec
		add it to the discards
	
	to turn a stock card
		// a click on the stock:  one step to undo, where the deal's own turn isn't
		undoable as "Turn Card"
		play from the stock

	to reset the stock
		// The discards, turned over, back into the stock
		set cards to a copy of list (the discards) as a pile
		reverse the cards
		add each card in the cards to the stock
		turn each card in the stock face down

	group "Game Play"
	
	to play a card
		undoable as "Play Card"
		if the card is in the stock
			turn a stock card
		otherwise
			set end pile to the first pile in every pile where it can take the card
			if there is not an end pile return no
			return put the card on end pile

	to put a card on a pile, undoable as "Move Card"
		// the card, and every card on it, onto the pile, if the piles' rules let it go and take it;  it says whether it moved
		// - the pile it left turns its new last card up;  the move counts, and scores
		set start pile to card's pile
		if start pile cannot give up the card return no
		if pile cannot take the card return no
		set points to count the points for the card on pile
		for card in (cards in start pile starting with the card)
			move it to pile
		if the start pile is a column and the start pile is not empty
			pause for 200 msec
			turn the last card of the start pile face up
		set solitaire's score to solitaire's score + points
		return yes

	to "auto play" with shortcut "A"
		// Play every card that can go somewhere, until none can
		set anything changed to no
		if the discards is not empty
			set test card to the last card of the discards
			if play test card
				set anything changed to yes
				pause for 500 msec
		// each column's last card onto its foundation
		for pile in the columns
			if the pile is empty return
			set test card to the last card of the pile
			set foundation to the first pile in the foundations where its suit is the suit of test card
			if the foundation can take test card
				set anything changed to yes
				play test card
				pause for 100 msec
		// each column's face-up cards, all together, onto another column
		for pile in the columns
			set face up cards to the cards in the pile where the card is face up
			if face up cards is empty return
			set test card to the first card of face up cards
			if test card is a king and test card is the first card of the pile return
			if play test card
				set anything changed to yes
				pause for 500 msec
		if anything changed auto play
	
	to "cheat" with shortcut "C"
		// Turn up a face-down card from a column, at random, onto the discards
		set remaining piles to piles in the columns where it is not empty and its first card is face down
		if remaining piles is empty return
		set the pile to a random pile in remaining piles
		set the card to a random card in (the cards in the pile where the card is face down)
		// over every card around it, then turned face up as it moves onto the discards
		set the lifted of the card to yes
		turn the card face up
		add the card to the discards
		pause for 300 msec
		set the lifted of the card to no

	to count the points for a card on a pile
		// what the move scores:  10 on a foundation, 5 from the discards, else nothing
		if pile is a foundation return 10
		if the card is in the discards return 5
		return 0
	
	when the score changes
		set home to the number of cards in the clubs + the number of cards in the diamonds
		set home to home + the number of cards in the hearts + the number of cards in the spades
		if home is 52
			alert "You won!" with "New game"
			restart the game

a card		-- play the card on click if it is a legal move
	on click
		if it is face up or its pile is solitaire's stock
			play the card

a pile  -- drop the card on the pile if it is a legal move
	on card dropped
		put the card on the pile

group "The piles"
// Each kind of pile, what it may take or give up, and how it lies.
// While one's empty, it shows its placeholder, if it has one.

a "stock pile" is a pile with layout "stacked"
	// The cards not played yet, face down:  a click turns the next one over, so none can be taken from it
	it can never take a card
	it can never let go of a card
	to draw its placeholder
		<text>🂠</text>
	on click
		turn a stock card

a "discard pile" is a pile with layout "stacked"		-- Where the stock's cards go as they're turned over
	it can never take a card
	its cards are draggable when the card is its last card

a "foundation" is a pile with layout "stacked"		-- Where a suit is built up, ace to king, one card at a time
	its "suit" is a card suit
	it can never let go of a card
	it is droppable when
		return no if the card is not the last card of the pile of the card
		return its suit is the suit of the card and
		  its value + 1 is the value of the card
	to draw its placeholder			-- a light grey ace of its suit, face up
		<text>{the picture of a new card whose rank is ace and suit is its suit}</text>

a "column" is a pile with layout "vertical"			-- A column, built down from king to ace, red and black in turn
	its cards are draggable when the card is face up
	it is droppable when
		it is empty and the card is a king
		or
		its color is not the color of the card and
		  its value is the value of the card + 1

to test the moves
	set the column to a new column with id "T1"
	set the king to a new card whose rank is king, suit is spades and direction is up
	set the queen to a new card whose rank is queen, suit is hearts and direction is up
	set the jack to a new card whose rank is jack, suit is clubs and direction is up

	// an empty column takes only a king, then one lower in the other color
	the column can take the queen should be no
	the column can take the king should be yes
	add the king to the column
	the column can take the jack should be no
	the column can take the queen should be yes
	add the queen to the column
	the short name of the column should be "T1: K♠↑ Q♥↑"
	the column can give up the queen should be yes
	turn the queen face down
	the column can give up the queen should be no

	// a foundation takes its suit, ace first, then one higher:  each the last card of its pile
	set the foundation to a new foundation with suit = hearts
	set the two to a new card whose rank is 2, suit is hearts and direction is up
	set the ace to a new card whose rank is ace, suit is hearts and direction is up
	set the column to a new column with id "T2"
	add the two to the column
	add the ace to the column
	the foundation can take the two should be no
	the foundation can take the ace should be yes
	move the ace to the foundation
	the foundation can take the two should be yes
	add the queen to the column
	the foundation can take the queen should be no

