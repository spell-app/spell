solitaire is an app
	-- A fully playable game in 300 lines of code!
	-- See https://en.wikipedia.org/wiki/Klondike_(solitaire) for the rules
	when creating solitaire
		add each card in the deck to the stock
		deal the cards

	to draw solitaire
		-- Use magical HTML tags to draw the game.
		-- Parts in purple are "views" which can be used in the program.
		<deck "deck" hidden />
		<segment inverted attach-to="top">
			<toolbar size="small" appearance="pills" inverted shrinkable>
				<text size="big" slot="title" heavy>Spell Solitaire</>
				<action "auto play"/>
				<action "cheat"/>
				<action "deal the cards" title="Restart" />
				<spacer/>
				<action "undo" icon-only />
				<action "redo" icon-only />
				<text slot="right"><b>Score</b>: <number "score" /></>
			</>
		</>
		<container columns="7" padding="small" spacing="xs">
			<stock-pile "stock"/>
			<discard-pile "discard pile"/>
			<spacer/>
			<foundation "clubs" suit=clubs/>
			<foundation "diamonds" suit=diamonds/>
			<foundation "hearts" suit=hearts/>
			<foundation "spades" suit=spades/>
			<column "C2"/>
			<column "C3"/>
			<column "C1"/>
			<column "C4"/>
			<column "C5"/>
			<column "C6"/>
			<column "C7"/>
		</container>
		<modal "you won">
			<text size="big">Congratulations!</>
			<text>Your score:  <number "score" /></>
			<action "deal the cards" title="New game" />
		</>
		<context-menu>
			<action "auto play"/>
			<action "cheat"/>
			<action "deal the cards"/>
			<divider/>
			<action "undo"  />
			<action "redo"  />
		</context-menu>

	group "Dealing & the Stock Pile"
	to "deal the cards" with shortcut "R", icon "sync alternate"
		clear the score
		for each card in the deck
			turn the card face down without waiting
		for each card in the cards which are not in the stock
			add the card to the stock without waiting
			pause for 10 msec
		shuffle the stock
		-- each row's first card lands face down, then turns up where it lies
		for row from 1 to 7
			for column from row to 7
				add the top card of the stock to item column of the columns
				pause for 20 msec
				if column is the same as row
					turn the last card of (item column of the columns) face up
		turn over the next card

	to "turn over the next card", undoable as "Turn Card"
		if the stock is empty
			reset the stock pile
		set the next card to the top card of the stock
		turn the next card face up
		-- as long as its flip takes (styles.css), so it turns over before it moves
		pause for 300 msec
		add the next card to the discard pile

	to "reset the stock pile"
		set cards to a copy of list the discard pile as a pile
		reverse the cards
		add each card in the cards to the stock
		turn each card in the stock face down

	group "Game Play"

	to "play a card"
		if the card is in the stock
			turn over the next card
		otherwise
			set end pile to the first pile in every pile where it can take the card
			if there is not an end pile return no
			return move the card to end pile

	after moving a card to a pile
		-- The move scores;  the column it left turns its new last card face up
		add the points for the card on the pile to solitaire's score
		if the card's last pile is a column and it is not empty
			turn its last card face up

	to "auto play" with shortcut "A", icon "play"
		-- Play one card that can go somewhere, then the next, until none can.
		set candidates to cards in the discard pile where the card is on top
			and the last card of each column
			and the first card of each column where the card is face up

		--  Remove kings directly on the board so they don't switch back and forth
		remove cards in candidates where it is a king and it is on bottom

		for each card in candidates
			set pile to the first pile in the piles which can take the card
				and the pile is not the last pile of the card
			
			if the pile exists
				play the card
				-- wait a bit so it doesn't play too fast
				pause for 500 msec
				return auto play
	
	to "cheat" with shortcut "C", icon "eye"
		-- Turn up a face-down card from a column, at random and play on the discard pile.
		set the card to a random card in the columns where it is face down
		if the card exists
			add the card to the discard pile
			turn the card face up

	to get "the points for a card on a pile"
		return 10 if the pile is a foundation
		return 5 if the card's last pile is the discard pile
		return 0

	when the score changes
		if the number of cards in the foundations is 52
			show "you won"

a card
	-- play the card when clicked if it is a legal move
	when clicked
		if it is face up or its pile is solitaire's stock
			play the card

group "Different kinds of piles"
-- Each kind of pile, what it may take or give up, and how it lies.
-- An empty pile shows its placeholder, if it has one.

a "stock pile" is a pile with layout "stacked"
	-- The cards not played yet, face down.
	it can never take a card
	it can never let go of a card
	to draw its placeholder
		<card-image direction=down />
	on click
		turn over the next card

a "discard pile" is a pile with layout "stacked"	-- Where the stock's cards go as they're turned over
	it can never take a card
	its cards are draggable when the card is its last card

a "foundation" is a pile with layout "stacked"
	-- Where a suit is built up, ace to king, one card at a time
	its "suit" is a card suit
	it can never let go of a card
	it is droppable when
		the pile's suit is the card's suit
			and the pile's value is the card's value - 1
			and the card is on top
	to draw its placeholder
		-- a light grey ace of its suit, face up
		<card-image rank=ace suit={its suit} />

a "column" is a pile with layout "vertical"
	-- A column, built down from king to ace, red and black in turn
	its cards are draggable when the card is face up
	it is droppable when
		it is empty and the card is a king
		or
		its color is not the color of the card
			and its value is the value of the card + 1

to test the moves
	set the column to a new column with id "Test1"
	set the king to a new card whose rank is king, suit is spades and direction is up
	set the queen to a new card whose rank is queen, suit is hearts and direction is up
	set the jack to a new card whose rank is jack, suit is clubs and direction is up

	-- an empty column takes only a king, then one lower in the other color
	the column can take the queen should be no
	the column can take the king should be yes
	add the king to the column
	the column can take the jack should be no
	the column can take the queen should be yes
	add the queen to the column
	the shorthand of the column should be "Test1: K♠↑ Q♥↑"
	the column can give up the queen should be yes
	turn the queen face down
	the column can give up the queen should be no

	-- a foundation takes its suit, ace first, then one higher
	set the foundation to a new foundation with suit = hearts
	set the two to a new card whose rank is 2, suit is hearts and direction is up
	set the ace to a new card whose rank is ace, suit is hearts and direction is up
	add the two to the column
	add the ace to the column
	the foundation can take the two should be no
	the foundation can take the ace should be yes
	move the ace to the foundation
	the foundation can take the two should be yes
	the foundation can take the queen should be no
