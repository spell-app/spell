# A Pokémon:  its card, its own page, and its family
// Each adds to its type in PokeSpell.api.spell, with `<extend>`:  so looking at PokéAPI again never touches a line of this.

a pokemon:
	// Its big picture, the official artwork
	its "picture" is:
		return the front default of the official artwork of the other of its sprites
	// What it says:  its cry, a sound file
	its "sound" is:
		return the latest of its cries
	// Its number as the games write it, four figures:  #0001
	its "number tag" is:
		if its number < 10
			return "#000[its number]"
		if its number < 100
			return "#00[its number]"
		if its number < 1000
			return "#0[its number]"
		return "#[its number]"
	// Its family, from the first:  its species' evolution chain
	its "evolutions" is:
		return the chain of the evolution chain of its species
	// Is it one of your favourites?
	its "loved" is:
		set address to its id
		return there is a favourite where its address is address

	// Its own page:  the page before it is kept, for Back
	to open it:
		if the pokedex's showing is it
			return
		if the pokedex's showing
			stop the pokedex's showing's sound  // the last one's cry ends with its page
			add the pokedex's showing to the pokedex's trail
		set the pokedex's search to ""
		set the pokedex's showing to it
		load its sound  // so Hear it plays it at once
		scroll to the top

	// Its cry, from the start:  played by the click itself, so every browser lets it
	to hear it:
		play its sound

	// Its heart:  keep it as a favourite, or let it go
	to love it:
		set address to its id
		if there is a favourite where its address is address
			remove saved favourites with the same address
		otherwise
			add (a new favourite with name = its name, address = address) to the favourites

	// Its card:  a click anywhere on it opens its page
	to draw it:
		<card appearance="link raised" onClick={open it}>
			<image appearance="circular" background="yellow" src={its picture} alt="" aspect-ratio="1" />
			<content>
				<header size="large" font="title-caps">{its name}</header>
				<meta>Number {its number}</meta>
			</content>
		</card>

	to draw its page:
		<stack direction="horizontal" wrap align="center">
			<image appearance="circular" background="yellow" size="large" src={its picture} alt={its name} aspect-ratio="1" />
			<stack fluid align="start">
				<header size="poster" color="red" font="title-caps heavy">{its name}</header>
				<text size="huge">Number {its number}</text>
				<stack direction="horizontal" wrap>
					{draw its kinds}
				</stack>
				<text size="large"><dimension value={its height * 10} dimension="length" unit="cm" /> tall, and <dimension value={its weight / 10} dimension="weight" unit="kg" /> heavy</text>
				<stack direction="horizontal" align="center">
					{draw its heart}
					<button color="blue" appearance="circular" size="massive" icon="volume up" onClick={hear it} title="Hear it" aria-label="Hear it" />
				</stack>
			</stack>
		</stack>
		<header size="large">How strong is it?</header>
		draw its strengths
		<header class="section" size="large">Evolutions</header>
		draw its family

	// Its evolutions in a row, from the first:  each one's own part, as each reads PokéAPI
	to draw its family:
		draw its evolutions

	// Its place in its family:  a round picture, its name, number and kinds;  a click opens its page
	to draw its evolution:
		<card appearance="link" width="10em" onClick={open it}>
			<image appearance="circular" background="yellow" aspect-ratio="1" size="small" align="center" src={its picture} alt="" />
			<content align="center">
				<header>{its name}</header>
				<meta>{its number tag}</meta>
				{draw its pills}
			</content>
		</card>

	// Its kinds, small:  a group of labels sizes them all
	to draw its pills:
		for its types
		show them in: <labels size="small"></labels>

	// Full and red when it's a favourite;  press it to change
	to draw its heart:
		if its loved
			<button color="red" appearance="circular" size="massive" icon="heart" onClick={love it} title="One of my favourites" aria-label="One of my favourites" />
		otherwise
			<button appearance="circular" size="massive" icon="heart outline" onClick={love it} title="Keep it as a favourite" aria-label="Keep it as a favourite" />

	// Its kinds, big:  a group of labels sizes them all
	to draw its kinds:
		for its types
		show them in: <labels size="huge"></labels>

	// A bar for each of its six numbers:  255 is as strong as any Pokémon gets
	to draw its strengths:
		for stat in its stats
			<progress max-width="36em" value={stat's base stat} total="255" color="green" size="large" label={stat's word + ":  {value}"} />

# One of a Pokémon's six numbers

a stat:
	// What it means, in plain words, by the name PokéAPI gives it
	its "word" is:
		set name to the name of its stat
		if name is "hp"
			return "Health"
		if name is "attack"
			return "Attack"
		if name is "defense"
			return "Defence"
		if name is "special-attack"
			return "Special attack"
		if name is "special-defense"
			return "Special defence"
		return "Speed"

# A kind of Pokémon:  fire, water, grass ...

a type:
	// Two kinds no Pokémon is:  only in the games' code
	it "is real":
		return its name is not "unknown" and its name is not "shadow" and its name is not "stellar"

	// Each kind's colour, as the games paint it
	its "colour" is:
		if its name is "fire"
			return "red"
		if its name is "water" or its name is "ice"
			return "blue"
		if its name is "grass" or its name is "bug"
			return "green"
		if its name is "electric"
			return "yellow"
		if its name is "psychic" or its name is "fairy"
			return "pink"
		if its name is "poison" or its name is "ghost"
			return "purple"
		if its name is "dragon"
			return "violet"
		if its name is "ground" or its name is "rock" or its name is "fighting"
			return "brown"
		if its name is "flying"
			return "teal"
		if its name is "dark"
			return "black"
		if its name is "steel"
			return "grey"
		return "orange"

	// See every Pokémon of this kind
	to pick it:
		set the pokedex's picked kind to it
		set the pokedex's showing to nothing

	// A big button:  press it to see every Pokémon of this kind
	to draw it:
		<button class="kind" color={its colour} size="large" font="title-caps" onClick={pick it}>{its name}</button>

// One of a Pokémon's kinds:  a label of its colour
a pokemon type:
	to draw it:
		<label class="kind" color={its kind's colour} size="huge" font="title-caps">{its kind's name}</label>

// One Pokémon of a kind
a type pokemon:
	to draw it:
		draw its pokemon

# A family:  how a Pokémon evolves
// PokéAPI keeps a family as a chain:  its first species, and the chains each one becomes, each with the chains it becomes.
// So a chain draws its species, then an arrow and the chains it becomes, side by side:
// Bulbasaur > Ivysaur > Venusaur is one row, and Eevee's eight evolutions sit together after its arrow.

a chain:
	to draw it:
		<stack direction="horizontal" align="center" spacing="sm" stackable="34em">
			{draw its species}
			<if its evolves to is not empty>
				<icon name="chevron right" size="large" rotated="when stacked" />
				<stack direction="horizontal" wrap align="center" justify="center" spacing="sm">
					{draw its branches}
				</stack>
			</if>
		</stack>

	// What it becomes:  one, or several side by side, wrapping when they don't fit
	to draw its branches:
		for its evolves to

a pokemon species:
	// The Pokémon it is, as the games show it first
	its "pokemon" is:
		return the pokemon of the first item of its varieties
	to draw it:
		draw the evolution of its pokemon

# A favourite:  kept on this device, it draws the Pokémon it's of

a favourite:
	its "pokemon" is the pokemon whose id is its address
	to draw it:
		draw its pokemon
