<thing "pokemon ability">
	<spell>
		- its "hidden" is yes or no, stored as "is_hidden"
	</spell>
	<property "slot" type="number" />
	<property "ability" type="ability" />
</thing>

<thing "past ability">
	<property "generation" type="generation" />
	<property "abilities">a list of past ability abilities</>
</thing>

<thing "past ability ability">
	<spell>
		- its "hidden" is yes or no, stored as "is_hidden"
	</spell>
	<property "slot" type="number" />
</thing>

<thing "game index">
	<property "game index" type="number" />
	<property "version">a poke api name</>
</thing>

<thing "pokemon move">
	<property "move" type="move" />
	<property "version group details">a list of version group details</>
</thing>

<thing "version group detail">
	<property "level learned at" type="number" />
	<property "version group">a poke api name</>
	<property "move learn method">a poke api name</>
	<property "order" type="number" />
</thing>

<thing "sprite">
	<property "other" type="other" />
	<property "back shiny">text</>	// an address
	<property "front shiny">text</>	// an address
	<property "back default">text</>	// an address
	<property "front default">text</>	// an address
</thing>

