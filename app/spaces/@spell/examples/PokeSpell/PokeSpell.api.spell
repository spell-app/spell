## PokéAPI:  every pokemon, and all about it
// A server other people run, and what it holds.  No game yet:  its lists give only names, each one's page the rest.
// `poke api` is what this wrote, from looking at the server:
//   spell place ingest https://pokeapi.co/api/v2 --into PokeSpell.api.spell --name "poke api" --no-ai
//     --collections pokemon,pokemon-species,type,ability,move,evolution-chain,generation
// `spell place update PokeSpell.api.spell` looks again, and changes only this file and PokeSpell.api.json5.
// A height is in tenths of a metre, a weight in tenths of a kilogram, as PokéAPI keeps them.
//
// Pokémon belongs to Nintendo, Game Freak and Creatures.

<web-server "poke api" address="https://pokeapi.co/api/v2">
	- its id is its "url"
	- its rows are its "results"
	- its next page is its "next"
	- it gives up to 2000 at a time
	- its lists give only each one's "name"
	- check it once a day
	- keep a copy on this device
	- it writes names like "base_experience"
	- pokemon live at "/pokemon"
	- pokemon species live at "/pokemon-species"
	- types live at "/type"
	- abilities live at "/ability"
	- moves live at "/move"
	- evolution chains live at "/evolution-chain"
	- generations live at "/generation"
</web-server>

<thing "pokemon">
	<spell>
		- it lives in poke api
		- its "number" is a number, stored as "id"
	</spell>
	<property "name">text</>
	<property "base experience" type="number" />
	<property "height" type="number" />
	<spell>
		- its "default" is yes or no, stored as "is_default"
	</spell>
	<property "order" type="number" />
	<property "weight" type="number" />
	<property "abilities">a list of pokemon abilities</>
	<property "past abilities">a list of past abilities</>
	<property "forms">a list of poke api names</>
	<property "game indices">a list of game indices</>
	<property "held items">a list of text</>
	<property "location area encounters">text</>	// an address
	<property "moves">a list of pokemon moves</>
	<property "species">a pokemon species</>
	<property "sprites" type="sprite" />
	<property "cries" type="cry" />
	<property "stats">a list of stats</>
	<property "past stats">a list of past stats</>
	<property "types">a list of pokemon types</>
	<property "past types">a list of text</>
</thing>

<thing "pokemon species">
	<spell>
		- it lives in poke api
		- its "number" is a number, stored as "id"
	</spell>
	<property "name">text</>
	<property "order" type="number" />
	<property "gender rate" type="number" />
	<property "capture rate" type="number" />
	<property "base happiness" type="number" />
	<spell>
		- its "baby" is yes or no, stored as "is_baby"
		- its "legendary" is yes or no, stored as "is_legendary"
		- its "mythical" is yes or no, stored as "is_mythical"
	</spell>
	<property "hatch counter" type="number" />
	<spell>
		- its "gender differences" is yes or no, stored as "has_gender_differences"
	</spell>
	<property "forms switchable">yes or no</>
	<property "growth rate">a poke api name</>
	<property "pokedex numbers">a list of pokedex numbers</>
	<property "egg groups">a list of poke api names</>
	<property "color">a poke api name</>
	<property "shape">a poke api name</>
	<property "evolves from species">a pokemon species</>
	<property "evolution chain">an evolution chain</>
	<property "habitat">a poke api name</>
	<property "generation" type="generation" />
	<property "names">a list of names</>
	<property "pal park encounters">a list of pal park encounters</>
	<property "form descriptions">a list of text</>
	<property "flavor text entries">a list of flavor text entries</>
	<property "genera">a list of genera</>
	<property "varieties">a list of varieties</>
</thing>

<thing "type">
	<spell>
		- it lives in poke api
		- its "number" is a number, stored as "id"
	</spell>
	<property "name">text</>
	<property "damage relations">a damage relation</>
	<property "past damage relations">a list of text</>
	<property "game indices">a list of game indices</>
	<property "generation" type="generation" />
	<property "move damage class">a poke api name</>
	<property "names">a list of names</>
	<property "pokemon">a list of type pokemon</>
	<property "moves">a list of moves</>
</thing>

<thing "ability">
	<spell>
		- it lives in poke api
		- its "number" is a number, stored as "id"
	</spell>
	<property "name">text</>
	<spell>
		- its "main series" is yes or no, stored as "is_main_series"
	</spell>
	<property "generation" type="generation" />
	<property "names">a list of names</>
	<property "effect entries">a list of effect entries</>
	<property "effect changes">a list of effect changes</>
	<property "flavor text entries">a list of flavor text entries</>
	<property "pokemon">a list of ability pokemon</>
</thing>

