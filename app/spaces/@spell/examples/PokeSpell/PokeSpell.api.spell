	<property "name">text</>
	<property "accuracy" type="number" />
	<property "pp" type="number" />
	<property "priority" type="number" />
	<property "power" type="number" />
	<property "contest combos">a contest combo</>
	<property "contest type">a poke api name</>
	<property "contest effect">a poke api name</>
	<property "damage class">a poke api name</>
	<property "effect entries">a list of effect entries</>
	<property "effect changes">a list of text</>
	<property "generation" type="generation" />
	<property "meta" type="meta" />
	<property "names">a list of names</>
	<property "past values">a list of past values</>
	<property "stat changes">a list of text</>
	<property "super contest effect">a poke api name</>
	<property "target">a poke api name</>
	<spell>
		- its "kind" is a type, stored as "type"
	</spell>
	<property "machines">a list of text</>
	<property "flavor text entries">a list of flavor text entries</>
	<property "learned by pokemon">a list of pokemon</>
</thing>

