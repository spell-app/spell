<thing "generation">
	<spell>
		- it lives in poke api
		- its "number" is a number, stored as "id"
	</spell>
	<property "name">text</>
	<property "abilities">a list of text</>
	<property "main region">a poke api name</>
	<property "moves">a list of moves</>
	<property "names">a list of names</>
	<property "pokemon species">a list of pokemon species</>
	<property "types">a list of types</>
