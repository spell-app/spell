<thing "damage relation">
	<property "no damage to">a list of types</>
	<property "half damage to">a list of types</>
	<property "double damage to">a list of types</>
	<property "no damage from">a list of types</>
	<property "half damage from">a list of types</>
	<property "double damage from">a list of types</>
</thing>

<thing "type pokemon">
	<property "slot" type="number" />
	<property "pokemon" type="pokemon" />
</thing>

<thing "effect entry">
	<property "effect">text</>
	<property "short effect">text</>
	<property "language">a poke api name</>
</thing>

<thing "effect change">
	<property "version group">a poke api name</>
	<property "effect entries">a list of effect entries</>
</thing>

<thing "ability pokemon">
	<spell>
		- its "hidden" is yes or no, stored as "is_hidden"
	</spell>
	<property "slot" type="number" />
	<property "pokemon" type="pokemon" />
