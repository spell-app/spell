<thing "contest combo">
	<property "normal" type="normal" />
	<property "super" type="super" />
</thing>

<thing "normal">
	<property "use before">a list of moves</>
	<property "use after">a list of moves</>
</thing>

<thing "super" />

<thing "meta">
	<property "ailment">a poke api name</>
	<property "category">a poke api name</>
	<property "drain" type="number" />
	<property "healing" type="number" />
	<property "crit rate" type="number" />
	<property "ailment chance" type="number" />
	<property "flinch chance" type="number" />
	<property "stat chance" type="number" />
</thing>

<thing "past value">
	<property "effect entries">a list of text</>
	<spell>
		- its "kind" is a type, stored as "type"
	</spell>
	<property "version group">a poke api name</>
</thing>

<thing "chain">
	<spell>
		- its "baby" is yes or no, stored as "is_baby"
	</spell>
	<property "species">a pokemon species</>
	<property "evolution details">a list of text</>
	<property "evolves to">a list of chains</>
</thing>

<thing "poke api name">
	<property "name">text</>
	<spell>
		- its "address" is text, stored as "url"  // never read:  its collection wasn't asked for
	</spell>
</thing>
