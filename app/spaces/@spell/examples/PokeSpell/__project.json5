    "active": true
  }, {
    "path": "/Pokemon.spellml",
    "active": true
  }, {
    "path": "/WhosThat.spellml",
    "active": true
  }, {
    "path": "/PokeSpell.spellml",
    "active": true
  }, {
    "path": "/styles.css",
    "active": true
  }],

  "development": {
    "apis": ["PokeSpell.api.json5"]
  }
}
