{
  "title": "PokéSpell",
  "description": "A Pokédex for kids, playful and bright:  every Pokémon from PokéAPI, its API in a file of its own as `spell place ingest` wrote it;  favourites kept on this device beside them, in a second place;  browse by kind, search, Surprise me!, a page with its artwork, its cry and how strong it is, and Who's that Pokémon?",

  "imports": [{
    "path": "/PokeSpell.api.spell",
    "active": true
  }, {
