<spell-page "diagram examples" notebook>
	<header level="1">
		Diagram
		<header>Boxes in columns and the links between them:  a NERD, an ERD, any boxes-and-lines picture, drawn by the NERD skill's rules.</>
	</>
	<section>
		<toolbar class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#content">Content</>
		</>
	</>

	<section label="Types">
		<section label="One main concept" sticky="stack" collapsible dividing>
			<example "One main concept" description="A spec in the NERD skill's own JSON:  a group with two `lanes` (the main box, then what it points at), a `legend` group in the next column.  Drag a box:  its lines follow, and `remember` keeps where you put it.  A field linking to its own box loops on the left.">
				<diagram remember="docs-recipe-box">
					<json>
						{
						  "columns": [
						    {
						      "groups": [
						        {
						          "label": "Recipe Box",
						          "color": "#047857",
						          "lanes": [
						            [
						              {
						                "name": "Recipe",
						                "note": "One dish, written down",
						                "gap_before": 50,
						                "fields": [
						                  "cuisine",
						                  "tags[]",
						                  "method",
						                  "photos[]",
						                  "notes[]",
						                  "adapted_from",
						                  "replaces",
						                  "related_recipes[]"
						                ]
						              }
						            ],
						            [
						              {
						                "name": "Cuisine",
						                "note": "e.g. Thai, Basque"
						              },
						              {
						                "name": "Tag",
						                "note": "Quick, vegetarian, spicy"
						              },
						              {
						                "name": "Method",
						                "note": "Varies by cuisine",
						                "fields": [
						                  "technique",
						                  "timer"
						                ]
						              },
						              {
						                "name": "Photo",
						                "note": "Kept by a photo host",
						                "fields": [
						                  "host / photo_id"
						                ]
						              },
						              {
						                "name": "Note",
						                "note": "A cook's remark"
						              }
						            ]
						          ]
						        }
						      ]
						    },
						    {
						      "groups": [
						        {
						          "legend": true
						        },
						        {
						          "label": "Elsewhere",
						          "color": "#6b7280",
						          "gap_before": 60,
						          "nodes": [
						            {
						              "name": "Technique",
						              "note": "Kitchen guide",
						              "color": "#7c3aed"
						            },
						            {
						              "name": "Timer",
						              "note": "Kitchen guide",
						              "color": "#7c3aed"
						            },
						            {
						              "name": "Photo hosts",
						              "note": "Outside services"
						            }
						          ]
						        }
						      ]
						    }
						  ],
						  "edges": [
						    {
						      "from": "Recipe.cuisine",
						      "to": "Cuisine"
						    },
						    {
						      "from": "Recipe.tags[]",
						      "to": "Tag"
						    },
						    {
						      "from": "Recipe.method",
						      "to": "Method",
						      "kind": "contains"
						    },
						    {
						      "from": "Recipe.photos[]",
						      "to": "Photo",
						      "kind": "contains"
						    },
						    {
						      "from": "Recipe.notes[]",
						      "to": "Note",
						      "kind": "contains"
						    },
						    {
						      "from": "Recipe.adapted_from",
						      "to": "Recipe"
						    },
						    {
						      "from": "Recipe.replaces",
						      "to": "Recipe"
						    },
						    {
						      "from": "Recipe.related_recipes[]",
						      "to": "Recipe"
						    },
						    {
						      "from": "Method.technique",
						      "to": "Technique"
						    },
						    {
						      "from": "Method.timer",
						      "to": "Timer"
						    },
						    {
						      "from": "Photo.host / photo_id",
						      "to": "Photo hosts"
						    }
						  ]
						}
					</json>
				</diagram>
			</example>
		</>

		<section label="Several concepts" sticky="stack" collapsible dividing>
			<example "Several concepts" description="Three columns of groups:  what's reused on the left, definitions in the middle, what runs on the right.  Links in one column bracket on the right (going down) or the left (going up);  two or more from one column to the same box merge into one bus.  A right click on it saves it as SVG or JSON.">
				<diagram>
					<json>
						{
						  "columns": [
						    {
						      "groups": [
						        {
						          "legend": true
						        },
						        {
						          "label": "Library",
						          "color": "#0f766e",
						          "nodes": [
						            {
						              "name": "Ingredient",
						              "note": "What a dish can use",
						              "bullets": [
						                "Flour",
						                "Saffron"
						              ]
						            },
						            {
						              "name": "Tool",
						              "note": "Reusable equipment",
						              "bullets": [
						                "Oven",
						                "Mandoline",
						                "Blowtorch"
						              ]
						            }
						          ]
						        }
						      ]
						    },
						    {
						      "groups": [
						        {
						          "label": "Menu",
						          "color": "#1d4ed8",
						          "nodes": [
						            {
						              "name": "Course",
						              "note": "Ingredient + amounts",
						              "fields": [
						                "ingredient"
						              ]
						            },
						            {
						              "name": "Menu",
						              "note": "A season's plan",
						              "fields": [
						                "courses[]",
						                "steps[]"
						              ]
						            },
						            {
						              "name": "Step",
						              "note": "Tool + timing",
						              "fields": [
						                "tool",
						                "course",
						                "next_steps[]"
						              ]
						            },
						            {
						              "name": "NextStep",
						              "note": "Where cooking goes next",
						              "fields": [
						                "to_step"
						              ]
						            }
						          ]
						        },
						        {
						          "label": "Pantry",
						          "color": "#047857",
						          "nodes": [
						            {
						              "name": "Shelf",
						              "note": "Jar, crate, fridge"
						            }
						          ]
						        }
						      ]
						    },
						    {
						      "groups": [
						        {
						          "label": "Cooking",
						          "color": "#7c3aed",
						          "nodes": [
						            {
						              "name": "Service",
						              "note": "One evening's covers",
						              "fields": [
						                "menu",
						                "cooks[]",
						                "shelves[]"
						              ]
						            },
						            {
						              "name": "Cook",
						              "note": "One person's station",
						              "fields": [
						                "menu",
						                "head_cook",
						                "shelves[]",
						                "tasks[]",
						                {
						                  "name": "current_tasks[]",
						                  "derived": true
						                }
						              ]
						            },
						            {
						              "name": "Task",
						              "note": "One step, done once",
						              "fields": [
						                "step",
						                "shelves[]",
						                "timers[]"
						              ]
						            },
						            {
						              "name": "Timer",
						              "note": "Set by a task",
						              "fields": [
						                "shelves[]"
						              ]
						            }
						          ]
						        }
						      ]
						    }
						  ],
						  "edges": [
						    {
						      "from": "Course.ingredient",
						      "to": "Ingredient"
						    },
						    {
						      "from": "Menu.courses[]",
						      "to": "Course",
						      "kind": "contains"
						    },
						    {
						      "from": "Menu.steps[]",
						      "to": "Step",
						      "kind": "contains"
						    },
						    {
						      "from": "Step.tool",
						      "to": "Tool"
						    },
						    {
						      "from": "Step.course",
						      "to": "Course",
						      "kind": "contains"
						    },
						    {
						      "from": "Step.next_steps[]",
						      "to": "NextStep",
						      "kind": "contains"
						    },
						    {
						      "from": "NextStep.to_step",
						      "to": "Step"
						    },
						    {
						      "from": "Service.menu",
						      "to": "Menu"
						    },
						    {
						      "from": "Service.cooks[]",
						      "to": "Cook"
						    },
						    {
						      "from": "Service.shelves[]",
						      "to": "Shelf"
						    },
						    {
						      "from": "Cook.menu",
						      "to": "Menu"
						    },
						    {
						      "from": "Cook.head_cook",
						      "to": "Cook"
						    },
						    {
						      "from": "Cook.shelves[]",
						      "to": "Shelf"
						    },
						    {
						      "from": "Cook.tasks[]",
						      "to": "Task",
						      "kind": "contains"
						    },
						    {
						      "from": "Cook.current_tasks[]",
						      "to": "Task"
						    },
						    {
						      "from": "Task.step",
						      "to": "Step"
						    },
						    {
						      "from": "Task.shelves[]",
						      "to": "Shelf"
						    },
						    {
						      "from": "Task.timers[]",
						      "to": "Timer",
						      "kind": "contains"
						    },
						    {
						      "from": "Timer.shelves[]",
						      "to": "Shelf"
						    }
						  ]
						}
					</json>
				</diagram>
			</example>
		</>
	</>

	<section label="Content">
		<section label="A flat spec" sticky="stack" collapsible dividing>
			<example "A flat spec" description="No `columns`:  a flat list of `nodes` and `edges` is put in columns for you, what nothing links to first.  `columns` says how many at most.">
				<diagram columns="2">
					<json>
						{
						  "nodes": [
						    {
						      "name": "Order",
						      "note": "One customer's basket",
						      "fields": [
						        "customer",
						        "lines[]"
						      ]
						    },
						    {
						      "name": "Customer",
						      "note": "Someone who buys"
						    },
						    {
						      "name": "Line",
						      "note": "A product and how many",
						      "fields": [
						        "product"
						      ]
						    },
						    {
						      "name": "Product",
						      "note": "Something we sell"
						    }
						  ],
						  "edges": [
						    {
						      "from": "Order.customer",
						      "to": "Customer"
						    },
						    {
						      "from": "Order.lines[]",
						      "to": "Line",
						      "kind": "contains"
						    },
						    {
						      "from": "Line.product",
						      "to": "Product"
						    }
						  ]
						}
					</json>
				</diagram>
			</example>
		</>

		<section label="A box that flips" sticky="stack" collapsible dividing>
			<example "A box that flips" description="A `<ui-diagram-node name>` fills its box with what it holds, here a `<ui-shape>`:  the box takes its size, and its lines follow when it turns over.  `resizable` lets people drag its corner.">
				<button commandfor="docs-diagram-order" command="--next">Turn Order over</button>
				<diagram>
					<json>
						{
						  "columns": [
						    {
						      "groups": [
						        {
						          "label": "Shop",
						          "color": "#1d4ed8",
						          "nodes": [
						            {
						              "name": "Order",
						              "note": "Turned over by the button",
						              "fields": [
						                "lines[]"
						              ]
						            }
						          ]
						        }
						      ]
						    },
						    {
						      "groups": [
						        {
						          "label": "Catalogue",
						          "color": "#047857",
						          "nodes": [
						            {
						              "name": "Line",
						              "note": "A product and how many"
						            }
						          ]
						        }
						      ]
						    }
						  ],
						  "edges": [
						    {
						      "from": "Order.lines[]",
						      "to": "Line",
						      "kind": "contains"
						    }
						  ]
						}
					</json>
					<diagram-node name="Order" resizable>
						<shape id="docs-diagram-order">
							<side>
								<segment>Order<space/>lines\[]</segment>
							</side>
							<side>
								<segment>Order<space/>id · placed_at · total<space/>customer_id · lines\[]</segment>
							</side>
						</shape>
					</diagram-node>
				</diagram>
			</example>
		</>
	</>
</spell-page>
