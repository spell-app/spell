<spell-page "tree-diagram api" notebook>
	<header level="1">
		Tree diagram
		<header>A tree diagram draws a tree:  a box for each node, a line to each of its children.</>
	</>
	<section>
		<toolbar class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#attributes">Attributes</>
			<item link="#properties">Properties</>
			<item link="#parts">Parts</>
			<item link="#states">States</>
			<item link="#texts">Texts</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`docs/__data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-tree-diagram" only="attributes"></>
		</>
	</>

	<section label="Properties">
		<html>
			<ui-docs-api family="ui-tree-diagram" only="properties"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-tree-diagram" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-tree-diagram" only="states"></>
		</>
	</>

	<section label="Texts">
		<html>
			<ui-docs-api family="ui-tree-diagram" only="texts"></>
		</>
	</>
</spell-page>
