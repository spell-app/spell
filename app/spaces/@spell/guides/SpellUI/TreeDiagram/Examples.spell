<spell-page "tree-diagram examples" notebook>
	<header level="1">
		Tree diagram
		<header>A tree diagram draws a tree:  a box for each node, a line to each of its children.</>
	</>
	<section>
		<toolbar class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#content">Content</>
			<item link="#states">States</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  ours only, no Fomantic page (2026-10-05, epic `output-targets` P4).  Every example gives its tree
		as nested `<ui-tree-node>`s, so the code shown IS the data;  the `tree` property is on
		the Usage tab.
	-->
	<section label="Types">
		<section label="Tree diagram" sticky="stack" collapsible dividing>
			<example "Tree diagram" description="A tree diagram draws a tree, its nodes nested tags:  here spell's parse tree for the first line of FizzBuzz, `if number / 15 is an integer`.">
				<tree-diagram>
					<tree-node "If" hover-text="if number / 15 is an integer">
						<tree-node "IsA · integer" detail="boolean" edge-label="condition">
							<tree-node "Divide" detail="number" edge-label="value">
								<tree-node "Variable number" detail="number"/>
								<tree-node "Number 15" detail="number"/>
							</tree-node>
						</tree-node>
						<tree-node "Print" edge-label="body">
							<tree-node "Variable number" detail="number"/>
							<tree-node label="Text \"fizzbuzz\"" detail="text"/>
						</tree-node>
						<tree-node "If …" edge-label="otherwise"/>
					</tree-node>
				</tree-diagram>
			</example>
		</>

		<section label="Labels only" sticky="stack" collapsible dividing>
			<example "Labels only" description="Only `label` is needed:  each node is a box, joined to its children by lines.">
				<tree-diagram>
					<tree-node "Add">
						<tree-node "Number 1"/>
						<tree-node "Number 2"/>
					</tree-node>
				</tree-diagram>
			</example>
		</>

		<section label="From JSON" sticky="stack" collapsible dividing>
			<example "From JSON" description="The same tree as data:  a `<json>` child holds it, as its text or from a `source` file.">
				<tree-diagram>
					<json>{ "label": "Add", "children": [{ "label": "Number 1" }, { "label": "Number 2" }] }</json>
				</tree-diagram>
			</example>
		</>
	</>

	<section label="Content">
		<section label="Detail" sticky="stack" collapsible dividing>
			<example "Detail" description="A node's `detail` is a second, smaller, muted line under its label, e.g. a datatype.  Every box in a row is as tall as the tallest.">
				<tree-diagram>
					<tree-node "Divide" detail="number">
						<tree-node "Variable number" detail="number"/>
						<tree-node "Number 15"/>
					</tree-node>
				</tree-diagram>
			</example>
		</>

		<section label="Edge labels" sticky="stack" collapsible dividing>
			<example "Edge labels" description="A node's `edge-label` is written on the line from its parent, at its middle:  which part of the parent it fills.">
				<tree-diagram>
					<tree-node "Repeat">
						<tree-node "Range 1 to 100" edge-label="over"/>
						<tree-node "Variable number" edge-label="each"/>
						<tree-node "Block" edge-label="body"/>
					</tree-node>
				</tree-diagram>
			</example>
		</>

		<section label="Hover text" sticky="stack" collapsible dividing>
			<example "Hover text" description="A node's `hover-text` shows when the pointer rests on its box, e.g. the source it came from.">
				<tree-diagram>
					<tree-node "Print" hover-text="print number, \"fizz\"">
						<tree-node "Variable number" hover-text="number"/>
						<tree-node label="Text \"fizz\"" hover-text="\"fizz\""/>
					</tree-node>
				</tree-diagram>
			</example>
		</>

		<section label="Any content" sticky="stack" collapsible dividing>
			<example "Any content" description="Anything else inside a node shows in its box, measured so the box fits it.  It's a real element, so it keeps working.">
				<tree-diagram>
					<tree-node "Team">
						<tree-node><button size="small" color="primary">Join</button></tree-node>
						<tree-node "Rating"><rating value="3" max-rating="5"/></tree-node>
					</tree-node>
				</tree-diagram>
			</example>
		</>
	</>

	<section label="States">
		<section label="Foldable" sticky="stack" collapsible dividing>
			<example "Foldable" description="`foldable`:  a button on each node with children folds them away, and opens them again.  `folded` starts one folded.">
				<tree-diagram foldable>
					<tree-node "If">
						<tree-node "Divide" edge-label="condition">
							<tree-node "Variable number"/>
							<tree-node "Number 15"/>
						</tree-node>
						<tree-node "Print" edge-label="body" folded>
							<tree-node "Variable number"/>
							<tree-node "Text"/>
						</tree-node>
					</tree-node>
				</tree-diagram>
			</example>
		</>

		<section label="Clickable" sticky="stack" collapsible dividing>
			<example "Clickable" description="`clickable`:  nodes show they can be clicked, and take the keyboard.  A click sends `ui-node-clicked` with or without it.">
				<tree-diagram clickable>
					<tree-node "Home">
						<tree-node "About"/>
						<tree-node "Pricing"/>
					</tree-node>
				</tree-diagram>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Wide trees" sticky="stack" collapsible dividing>
			<example "Wide trees" description="A tree shrinks to fit its column, down to three quarters of its size;  a wider one scrolls sideways (on a phone, this one does).">
				<tree-diagram>
					<tree-node "List" detail="list of number">
						<tree-node "Number 1"/>
						<tree-node "Number 2"/>
						<tree-node "Number 3"/>
						<tree-node "Number 5"/>
						<tree-node "Number 8"/>
						<tree-node "Number 13"/>
						<tree-node "Number 21"/>
					</tree-node>
				</tree-diagram>
			</example>
		</>

		<section label="Left to right" sticky="stack" collapsible dividing>
			<example "Left to right" description="`direction` set to `left-right`:  children after their parent, not under it.  Long labels read better this way.">
				<tree-diagram direction="left-right">
					<tree-node "Repeat">
						<tree-node "Range 1 to 100" edge-label="over"/>
						<tree-node "Variable number" edge-label="each"/>
						<tree-node "Block" edge-label="body">
							<tree-node "Print"/>
							<tree-node "Add"/>
						</tree-node>
					</tree-node>
				</tree-diagram>
			</example>
		</>

		<section label="Color" sticky="stack" collapsible dividing>
			<example "Color" description="`color` paints a box in a hue of the theme's.  `kind` names what sort of node it is, for your own style:  `::part(kind-call)`.">
				<tree-diagram>
					<tree-node "Start" color="blue">
						<tree-node "Passed" color="green"/>
						<tree-node "Warned" color="yellow"/>
						<tree-node "Failed" color="red"/>
					</tree-node>
				</tree-diagram>
			</example>
		</>

		<section label="A monospace font" sticky="stack" collapsible dividing>
			<example "A monospace font" description="Any font works, as each label is measured in its own.  This one sets `--ui-tree-diagram-font-family`.">
				<tree-diagram style="--ui-tree-diagram-font-family: var(--ui-font-family-mono)">
					<tree-node "Divide" detail="number">
						<tree-node "Variable number" detail="number"/>
						<tree-node "Number 15"/>
					</tree-node>
				</tree-diagram>
			</example>
		</>
	</>
</spell-page>
