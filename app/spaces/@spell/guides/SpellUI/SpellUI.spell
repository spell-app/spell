<!--
  Spell UI's component pages as one site (epic `notebook` P10).
  Each component has a folder of notebooks, and each notebook is one page here:  this file says where each one is,
  and what the side navigation calls it.  A component's Usage page is its address, and its other pages are under it.
-->
<site "spell ui">
	<!-- the docs that aren't one component's:  each page one file at the top of the project, beside the components' folders -->
	<page "home page" address="/" title="Spell UI" picture="snapshots/home.jpg"/>
	<page "getting started page" address="/getting-started" title="Getting started" picture="snapshots/getting-started.jpg"/>
	<page "grammar page" address="/grammar" title="Grammar" picture="snapshots/grammar.jpg"/>
