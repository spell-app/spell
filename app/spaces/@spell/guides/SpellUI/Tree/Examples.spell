"tree examples" is a notebook page
	<header level="1">
		Tree
		<header>A tree shows rows nested in rows, which open and close, and can be selected one or many at a time.</>
	</>

	<section label="Types">
		<section label="Rows in rows" sticky="stack" collapsible dividing>
			<example "Rows in rows" description="Each row's rows are its children.  The triangle opens and closes a row, with `open`, `ui-opening` and `ui-closing`.">
				<tree label="Files" style="width: 18em">
					<tree-item label="src" icon="folder" open>
						<tree-item label="Card.spell" icon="file code" selected/>
						<tree-item label="Deck.spell" icon="file code"/>
						<tree-item label="styles" icon="folder">
							<tree-item label="card.css" icon="file code"/>
						</tree-item>
					</tree-item>
					<tree-item label="README.md" which="notes" icon="file alternate outline"/>
				</tree>
			</example>
		</>

		<section label="Many selected" sticky="stack" collapsible dividing>
			<example "Many selected" description="With `choose=\"many\"`, Shift takes a range of the rows on screen, and Command or Control adds a row or takes it away.">
				<tree choose="many" label="Files" style="width: 18em">
					<tree-item label="src" icon="folder" open>
						<tree-item label="Card.spell" icon="file code" selected/>
						<tree-item label="Deck.spell" icon="file code"/>
						<tree-item label="styles" icon="folder">
							<tree-item label="card.css" icon="file code"/>
						</tree-item>
					</tree-item>
					<tree-item label="README.md" which="notes" icon="file alternate outline"/>
				</tree>
			</example>
		</>

		<section label="Columns" sticky="stack" collapsible dividing>
			<example "Columns" description="With `appearance=\"columns\"`, each level is a column, as a Mac's Finder shows folders:  picking a row shows the rows inside it in the next column.  `column-titles` names the columns, by level;  the last title names every deeper one.  Drag the line after a column to resize it, as in the Finder:  hold Option (Alt) to resize every column together, or double-click the line to fit the column to its longest row (with Option, every column).  With an `id`, the tree remembers the widths.">
				<tree id="docs-tree-columns" appearance="columns" column-titles="Clients, Projects, Files" label="Work" style="height: 15em">
					<tree-item label="Acme Bakery" icon="building outline" open>
						<tree-item label="Spring menu" icon="folder" open>
							<tree-item label="menu.pdf" icon="file pdf outline" selected/>
							<tree-item label="photos" icon="folder">
								<tree-item label="croissant.jpg" icon="file image outline"/>
								<tree-item label="loaf.jpg" icon="file image outline"/>
							</tree-item>
							<tree-item label="prices.csv" icon="file alternate outline"/>
						</tree-item>
						<tree-item label="Website" icon="folder">
							<tree-item label="home.html" icon="file code outline"/>
						</tree-item>
					</tree-item>
					<tree-item label="Harbor Books" icon="building outline">
						<tree-item label="Catalogue" icon="folder">
							<tree-item label="autumn.pdf" icon="file pdf outline"/>
						</tree-item>
					</tree-item>
					<tree-item label="Pine Studio" icon="building outline">
						<tree-item label="Logo" icon="folder">
							<tree-item label="logo.svg" icon="file image outline"/>
						</tree-item>
					</tree-item>
				</tree>
			</example>
		</>

		<section label="Columns from data" sticky="stack" collapsible dividing>
			<example "Columns from data" description="A big tree is given as data, in `items`:  only the open path's columns are drawn.">
				<tree id="docs-tree-columns-data" appearance="columns" tools column-titles="Clients, Folders, Files" show="icon which count chevron" label="Work" style="height: 20em">
					<input slot="tools" id="docs-tree-columns-filter" icon="search" size="small" placeholder="Filter the whole tree" style="width: calc(100% - 2.5em)"/>
				</tree>
				<list slot="description" bulleted>
					<item>Each item's <text code>children</text> is a list, or a function run the first time it opens.  It may return a promise:  the column shows a spinner until it comes (Archive takes a second).</item>
					<item><text code>show</text> picks each row's parts, here with how many rows it holds.</item>
					<item><text code>tools</text> adds Open 2 levels, Open 3 levels and Close all;  the <text code>tools</text> slot puts the filter field at the end of their line.</item>
					<item><text code>filter</text> filters the last column on screen, and after its rows lists the matches elsewhere in the tree, at any depth:  type <text code>zip</text>, and click one to open the path to it.</item>
				</list>
			</example>
		</>

		<section label="Deep paths" sticky="stack" collapsible dividing>
			<example "Deep paths" description="When the open path is deeper than the tree is wide, the first columns narrow to strips.">
				<tree id="docs-tree-columns-deep" appearance="columns" sticky-path column-titles="Parts" show="icon which count chevron" label="Parts" style="height: 15em"/>
				<list slot="description" bulleted>
					<item>Each strip shows only its pick's name, as few strips as it takes.</item>
					<item>The last two columns never narrow, nor the selected row's:  <text code>narrow-before</text> says how many at the end stay wide.</item>
					<item>Point at a strip to see its column whole.</item>
					<item>With <text code>sticky-path</text>, the line above the columns names each pick:  click one to pick it again, keeping the columns after it.</item>
				</list>
			</example>
		</>

		<section label="Column sizes" sticky="stack" collapsible dividing>
			<example "Column sizes" description="`size` gives each column its width, by level, separated by commas;  the last one sizes every deeper column.  Each is px (`160` or `160px`), `em`, a percent of the tree's width, `auto` to fit the column to the rows it shows, or `*` for `--ui-tree-column-width`.  In the first tree the first column is 8em, the second 30%, and every one after fits its rows;  in the second, the first is 160px, and every one after takes the token's width.  A column you resize keeps your width instead.">
				<tree id="docs-tree-columns-sized" appearance="columns" size="8em, 30%, auto" column-titles="Shelf, Book, Chapters" show="icon which chevron" label="Library" style="height: 12em"/>
				<tree id="docs-tree-columns-sized-px" appearance="columns" size="160, *" column-titles="Shelf, Book, Chapters" show="icon which chevron" label="Library, in px" style="height: 12em; margin-top: 0.5em"/>
			</example>
		</>

		<section label="Detail pane" sticky="stack" collapsible dividing>
			<example "Detail pane" description="Pick a chapter, and the pane on the right shows more about it.">
				<tree id="docs-tree-columns-detail" appearance="columns" sticky-detail column-titles="Shelf, Book, Chapters" show="icon which chevron" label="Library, with a detail pane" style="height: 15em">
					<json slot="detail" depth="2"/>
				</tree>
				<list slot="description" bulleted>
					<item>You choose what the pane shows by putting it in the tree's <text code>detail</text> slot, the spot kept for it.  Here it holds a <text code>&lt;ui-json&gt;</text>, which lists everything stored about the chapter.</item>
					<item>Drag the line at the pane's right edge to make it wider or narrower.  Double-click the line to fit it to what it shows.</item>
					<item>Add <text code>sticky-detail</text> to the tree, and the pane stays in view while you scroll the columns sideways, as on a phone.</item>
					<item>Give the tree an <text code>id</text> (a name of your choosing), and it remembers, in your browser, which row you picked and how wide the pane is.  Refresh the page, and it opens where you left it.</item>
					<item>For developers:  picking a row passes that row to the pane as its <text code>item</text>.  The tree also announces the pick with a <text code>ui-changed</text> event, which your own code can listen for.</item>
				</list>
			</example>
		</>
	</>

	<section label="Content">
		<section label="Which one" sticky="stack" collapsible dividing>
			<example "Which one" description="`which` says which one it is, quieter, and shortens first when there's no room.  A button in the `actions` slot keeps its own click.">
				<tree label="Things" style="width: 18em">
					<tree-item label="Card" which="ace of spades" icon="cube">
						<button slot="actions" size="mini">Show</button>
					</tree-item>
					<tree-item label="Pile" which="discards" icon="cube"/>
				</tree>
			</example>
		</>

		<section label="Groups" sticky="stack" collapsible dividing>
			<example "Groups" description="A `group` row only holds rows:  a click opens or closes it, and it's never selected.">
				<tree label="Kinds" style="width: 18em">
					<tree-item group label="Cards" which="2" open>
						<tree-item label="ace of spades"/>
						<tree-item label="king of hearts"/>
					</tree-item>
				</tree>
			</example>
		</>
	</>

	<section label="States">
		<section label="Filtered" sticky="stack" collapsible dividing>
			<example "Filtered" description="`filter` shows only the rows whose words hold it, with the rows they're inside kept open.  It changes no row's `open`.">
				<tree filter="card" label="Files" style="width: 18em">
					<tree-item label="src" icon="folder" open>
						<tree-item label="Card.spell" icon="file code" selected/>
						<tree-item label="Deck.spell" icon="file code"/>
						<tree-item label="styles" icon="folder">
							<tree-item label="card.css" icon="file code"/>
						</tree-item>
					</tree-item>
					<tree-item label="README.md" which="notes" icon="file alternate outline"/>
				</tree>
			</example>
		</>

		<section label="Open levels" sticky="stack" collapsible dividing>
			<example "Open levels" description="With `tools`, a line of buttons above the rows:  Open 2 levels, Open 3 levels and Close all.  A script calls the same methods, `openTo(levels)` and `closeAll()`.">
				<tree tools label="Netlist" style="width: 21em">
					<tree-item label="top" which="chip" icon="microchip">
						<tree-item label="core" which="block" icon="cube">
							<tree-item label="alu" which="cell" icon="cube">
								<tree-item label="a" which="in" icon="plug"/>
								<tree-item label="sum" which="out" icon="plug"/>
							</tree-item>
							<tree-item label="regs" which="cell" icon="cube"/>
						</tree-item>
						<tree-item label="io" which="block" icon="cube">
							<tree-item label="pads" which="cell" icon="cube"/>
						</tree-item>
					</tree-item>
				</tree>
			</example>
		</>

		<section label="Sticky path" sticky="stack" collapsible dividing>
			<example "Sticky path" description="With `sticky-path`, scroll down:  one line pinned at the top names the open rows the first row in view is inside.  A click on one scrolls back to it, selecting nothing.">
				<stack style="height: 12em; overflow-y: auto; width: 18em">
					<tree sticky-path label="Views">
						<tree-item label="Solitaire" icon="cube" open>
							<tree-item label="Container" icon="cube" open>
								<tree-item label="Grid" icon="cube" open>
									<tree-item label="StockPile" which="stock" icon="cube" open>
										<tree-item label="Card" which="3 of spades" icon="cube"/>
										<tree-item label="Card" which="queen of clubs" icon="cube"/>
										<tree-item label="Card" which="king of diamonds" icon="cube"/>
										<tree-item label="Card" which="king of spades" icon="cube"/>
										<tree-item label="Card" which="king of clubs" icon="cube"/>
										<tree-item label="Card" which="10 of clubs" icon="cube"/>
										<tree-item label="Card" which="5 of diamonds" icon="cube"/>
										<tree-item label="Card" which="8 of diamonds" icon="cube"/>
										<tree-item label="Card" which="ace of hearts" icon="cube"/>
										<tree-item label="Card" which="2 of hearts" icon="cube"/>
										<tree-item label="Card" which="7 of spades" icon="cube"/>
										<tree-item label="Card" which="jack of hearts" icon="cube"/>
									</tree-item>
									<tree-item label="DiscardPile" which="discards" icon="cube"/>
								</tree-item>
							</tree-item>
						</tree-item>
					</tree>
				</stack>
			</example>
		</>
	</>

	<section label="Sizing">
		<section label="Height" sticky="stack" collapsible dividing>
			<example "Height" description="`height` gives the tree a height, and its rows scroll inside it;  `resizable=\"height\"` lets people drag it taller or shorter.  `width` sets its width, as on every widget.">
				<tree label="Racks" width="18em" height="8em" resizable="height">
					<tree-item label="Hall A" icon="folder" open>
						<tree-item label="Rack 1" icon="server"/>
						<tree-item label="Rack 2" icon="server"/>
						<tree-item label="Rack 3" icon="server"/>
					</tree-item>
					<tree-item label="Hall B" icon="folder" open>
						<tree-item label="Rack 4" icon="server"/>
						<tree-item label="Rack 5" icon="server"/>
						<tree-item label="Rack 6" icon="server"/>
					</tree-item>
				</tree>
			</example>
		</>
	</>
