<spell-page "site-nav api" notebook>
	<header level="1">
		Site nav
		<header>A site nav lists a site's pages as a tree, the page shown marked;  a click goes to a page.</>
	</>
	<section>
		<toolbar class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#attributes">Attributes</>
			<item link="#properties">Properties</>
			<item link="#events">Events</>
			<item link="#parts">Parts</>
			<item link="#states">States</>
			<item link="#texts">Texts</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`site/_data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-site-nav" only="attributes"></>
		</>
	</>

	<section label="Properties">
		<html>
			<ui-docs-api family="ui-site-nav" only="properties"></>
		</>
	</>

	<section label="Events">
		<html>
			<ui-docs-api family="ui-site-nav" only="events"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-site-nav" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-site-nav" only="states"></>
		</>
	</>

	<section label="Texts">
		<html>
			<ui-docs-api family="ui-site-nav" only="texts"></>
		</>
	</>
</spell-page>
