<spell-page "component index" notebook>
	<header level="1">
		Components
		<header>Every Spell UI component family, by topic.</>
	</>

	<!-- A snapshot of the docs site's component index (`yarn site:index`):  a new component adds its card here by hand. -->
	<markdown>
		Every `ui-*` element, filed under each topic it belongs to, so a tag can show up more than once.
		The sidebar lists the same tags, A-Z or by topic, with a search box. Each card opens the
		component's page: its examples, how to use it, its API and its theming tokens.
	</>

	<section label="Basic">
		<cards>
			<card link="/breadcrumb" heading="Breadcrumbs" meta="<ui-breadcrumbs>" description="A breadcrumb is used to show hierarchy between content."/>
			<card link="/button" heading="Button" meta="<ui-button>" description="A button indicates a possible action."/>
			<card link="/checkbox" heading="Checkbox" meta="<ui-checkbox>" description="A checkbox lets people choose a value from a small set of options, often on or off."/>
			<card link="/container" heading="Container" meta="<ui-container>" description="A container limits content to a maximum width."/>
			<card link="/divider" heading="Divider" meta="<ui-divider>" description="A divider visually segments content into groups."/>
			<card link="/dropdown" heading="Dropdown" meta="<ui-dropdown>" description="A dropdown lets people choose a value from a series of options."/>
			<card link="/form" heading="Form" meta="<ui-form>" description="A form displays a set of related input fields in a structured way."/>
			<card link="/grid" heading="Grid" meta="<ui-grid>" description="A grid is used to harmonize negative space in a layout."/>
			<card link="/content-parts" heading="Header" meta="<ui-header>" description="A header provides a short summary of content."/>
			<card link="/icon" heading="Icon" meta="<ui-icon>" description="An icon is a glyph used to represent something else."/>
			<card link="/image" heading="Image" meta="<ui-image>" description="An image is a graphic representation of something."/>
			<card link="/input" heading="Input" meta="<ui-input>" description="An input is a field used to elicit a response from a person."/>
			<card link="/label" heading="Label" meta="<ui-label>" description="A label displays content classification."/>
			<card link="/text" heading="Link" meta="<ui-link>" description="A link takes the reader somewhere else from inside a sentence."/>
			<card link="/list" heading="List" meta="<ui-list>" description="A list groups related content."/>
			<card link="/menu" heading="Menu" meta="<ui-menu>" description="A menu displays grouped navigation actions."/>
			<card link="/root" heading="Root" meta="<ui-root>" description="A root loads the components inside it on demand, sets their theme and size, and shows them once they're ready."/>
			<card link="/segment" heading="Segment" meta="<ui-segment>" description="A segment is used to create a grouping of related content."/>
			<card link="/space" heading="Space" meta="<ui-space>" description="A space is a gap between things.  Bare, it is a line break;  inline, a gap inside the line;  fluid, it takes the room left in its row or column.  It has no look of its own."/>
			<card link="/stack" heading="Stack" meta="<ui-stack>" description="A stack lays its children out in a column, or a row that wraps, evenly spaced.  It has no look of its own."/>
			<card link="/table" heading="Table" meta="<ui-table>" description="A table displays a collection of data grouped into rows."/>
			<card link="/text" heading="Text" meta="<ui-text>" description="A text is used to style some inline text with a simple color, or to hold a paragraph."/>
		</>
	</>

	<section label="Layout">
		<cards>
			<card link="/advertisement" heading="Ad" meta="<ui-ad>" description="An ad displays third-party promotional content."/>
			<card link="/button" heading="Buttons" meta="<ui-buttons>" description="Buttons can exist together as a group."/>
			<card link="/card" heading="Cards" meta="<ui-cards>" description="A group of cards, laid out in a wrapping row."/>
			<card link="/grid" heading="Column" meta="<ui-column>" description="A column is a vertical cell of a grid, N of 16 wide."/>
			<card link="/container" heading="Container" meta="<ui-container>" description="A container limits content to a maximum width."/>
			<card link="/divider" heading="Divider" meta="<ui-divider>" description="A divider visually segments content into groups."/>
			<card link="/form" heading="Fields" meta="<ui-fields>" description="A set of fields can appear grouped together, side by side or stacked."/>
			<card link="/grid" heading="Grid" meta="<ui-grid>" description="A grid is used to harmonize negative space in a layout."/>
			<card link="/image" heading="Images" meta="<ui-images>" description="A group of images can be formatted together."/>
			<card link="/include" heading="Include" meta="<ui-include>" description="An include shows part of another page from this site in this one, loaded at once, when idle or when scrolled into view."/>
			<card link="/page" heading="Page" meta="<ui-page>" description="A page frames a whole window:  a header, navigation, the main content, a side column and a footer, each a landmark screen readers jump between.  It's a root too:  it loads the components inside it."/>
			<card link="/panel" heading="Panel" meta="<ui-panel>" description="A panel is an inspector:  a tinted box of fields under a header band, with sub-head bands that open and close.  It takes every <ui-section> attribute."/>
			<card link="/property-editor" heading="Property group" meta="<ui-property-group>" description="A property group is a band of properties that opens and closes, in a property editor.  It takes <ui-section>'s attributes." extra="In progress"/>
			<card link="/sidebar" heading="Pushable" meta="<ui-pushable>" description="The context a sidebar appears in:  it clips them and moves its pusher."/>
			<card link="/sidebar" heading="Pusher" meta="<ui-pusher>" description="The content a sidebar pushes (and dims) when it appears."/>
			<card link="/rail" heading="Rail" meta="<ui-rail>" description="A rail is used to show accompanying content outside the boundaries of the main view of a site."/>
			<card link="/root" heading="Root" meta="<ui-root>" description="A root loads the components inside it on demand, sets their theme and size, and shows them once they're ready."/>
			<card link="/grid" heading="Row" meta="<ui-row>" description="A row is a horizontal grouping of columns;  in a table, of cells."/>
			<card link="/section" heading="Section" meta="<ui-section>" description="A section is a titled block of content that can close and keep its title in view." extra="In progress"/>
			<card link="/section" heading="Sections" meta="<ui-sections>" description="A group of sections:  with collapsing, every section in it can close, and closed ones stack with no space between." extra="In progress"/>
			<card link="/segment" heading="Segment" meta="<ui-segment>" description="A segment is used to create a grouping of related content."/>
			<card link="/segment" heading="Segments" meta="<ui-segments>" description="A group of segments can be formatted to appear together."/>
			<card link="/sidebar" heading="Sidebar" meta="<ui-sidebar>" description="A sidebar hides additional content beside a page."/>
			<card link="/space" heading="Space" meta="<ui-space>" description="A space is a gap between things.  Bare, it is a line break;  inline, a gap inside the line;  fluid, it takes the room left in its row or column.  It has no look of its own."/>
			<card link="/split-panel" heading="Split panel" meta="<ui-split-panel>" description="A split panel lays its children out side by side or one above the other, with bars to resize them."/>
			<card link="/stack" heading="Stack" meta="<ui-stack>" description="A stack lays its children out in a column, or a row that wraps, evenly spaced.  It has no look of its own."/>
			<card link="/statistic" heading="Statistics" meta="<ui-statistics>" description="A group of statistics."/>
			<card link="/sticky" heading="Sticky" meta="<ui-sticky>" description="Sticky content stays fixed to the viewport while its container is on screen."/>
		</>
	</>

	<section label="Containers">
		<cards>
			<card link="/accordion" heading="Accordion" meta="<ui-accordion>" description="An accordion lets people show and hide sections of content."/>
			<card link="/card" heading="Card" meta="<ui-card>" description="A card displays site content in a manner similar to a playing card."/>
			<card link="/container" heading="Container" meta="<ui-container>" description="A container limits content to a maximum width."/>
			<card link="/content" heading="Content" meta="<ui-content>" description="The main content block of a card, item, event, comment, modal, message, list item, step ..."/>
			<card link="/flyout" heading="Flyout" meta="<ui-flyout>" description="A flyout is a modal that slides in from a side of the page."/>
			<card link="/include" heading="Include" meta="<ui-include>" description="An include shows part of another page from this site in this one, loaded at once, when idle or when scrolled into view."/>
			<card link="/page" heading="Page" meta="<ui-page>" description="A page frames a whole window:  a header, navigation, the main content, a side column and a footer, each a landmark screen readers jump between.  It's a root too:  it loads the components inside it."/>
			<card link="/panel" heading="Panel" meta="<ui-panel>" description="A panel is an inspector:  a tinted box of fields under a header band, with sub-head bands that open and close.  It takes every <ui-section> attribute."/>
			<card link="/rail" heading="Rail" meta="<ui-rail>" description="A rail is used to show accompanying content outside the boundaries of the main view of a site."/>
			<card link="/root" heading="Root" meta="<ui-root>" description="A root loads the components inside it on demand, sets their theme and size, and shows them once they're ready."/>
			<card link="/section" heading="Section" meta="<ui-section>" description="A section is a titled block of content that can close and keep its title in view." extra="In progress"/>
			<card link="/section" heading="Sections" meta="<ui-sections>" description="A group of sections:  with collapsing, every section in it can close, and closed ones stack with no space between." extra="In progress"/>
			<card link="/segment" heading="Segment" meta="<ui-segment>" description="A segment is used to create a grouping of related content."/>
			<card link="/segment" heading="Segments" meta="<ui-segments>" description="A group of segments can be formatted to appear together."/>
			<card link="/split-panel" heading="Split panel" meta="<ui-split-panel>" description="A split panel lays its children out side by side or one above the other, with bars to resize them."/>
			<card link="/tab" heading="Tab" meta="<ui-tab>" description="A tab pane:  the content shown while its tab is selected."/>
			<card link="/tab" heading="Tabs" meta="<ui-tabs>" description="A tab is a hidden section of content activated by a menu."/>
			<card link="/title" heading="Title" meta="<ui-title>" description="A title:  a step's, an accordion panel's, a search result's."/>
		</>
	</>

	<section label="Navigation">
		<cards>
			<card link="/accordion" heading="Accordion" meta="<ui-accordion>" description="An accordion lets people show and hide sections of content."/>
			<card link="/breadcrumb" heading="Breadcrumb" meta="<ui-breadcrumb>" description="A section of a breadcrumb:  a link to a level of the hierarchy, or the current page."/>
			<card link="/breadcrumb" heading="Breadcrumbs" meta="<ui-breadcrumbs>" description="A breadcrumb is used to show hierarchy between content."/>
			<card link="/text" heading="Link" meta="<ui-link>" description="A link takes the reader somewhere else from inside a sentence."/>
			<card link="/menu" heading="Menu" meta="<ui-menu>" description="A menu displays grouped navigation actions."/>
			<card link="/page" heading="Page" meta="<ui-page>" description="A page frames a whole window:  a header, navigation, the main content, a side column and a footer, each a landmark screen readers jump between.  It's a root too:  it loads the components inside it."/>
			<card link="/sidebar" heading="Pushable" meta="<ui-pushable>" description="The context a sidebar appears in:  it clips them and moves its pusher."/>
			<card link="/sidebar" heading="Pusher" meta="<ui-pusher>" description="The content a sidebar pushes (and dims) when it appears."/>
			<card link="/search" heading="Search" meta="<ui-search>" description="A search module lets people query for results from a selection of data."/>
			<card link="/sidebar" heading="Sidebar" meta="<ui-sidebar>" description="A sidebar hides additional content beside a page."/>
			<card link="/site-tabs" heading="Site tabs" meta="<ui-site-tabs>" description="Site tabs show the page's family as a row of tabs:  the parent page first, the page shown selected, each a link."/>
			<card link="/step" heading="Step" meta="<ui-step>" description="One step of a set of steps."/>
			<card link="/step" heading="Steps" meta="<ui-steps>" description="A set of steps shows the progress of an activity in a series of steps."/>
			<card link="/sticky" heading="Sticky" meta="<ui-sticky>" description="Sticky content stays fixed to the viewport while its container is on screen."/>
			<card link="/tab" heading="Tab" meta="<ui-tab>" description="A tab pane:  the content shown while its tab is selected."/>
			<card link="/tab" heading="Tabs" meta="<ui-tabs>" description="A tab is a hidden section of content activated by a menu."/>
			<card link="/table-of-contents" heading="Toc" meta="<ui-toc>" description="A table of contents lists the page's sections and examples as links, opens the one in view and follows the scroll.  Each section folds and opens by its chevron, and one button in its header opens or folds them all;  the viewer's folds are kept."/>
			<card link="/toolbar" heading="Toolbar" meta="<ui-toolbar>" description="A toolbar is a horizontal menu whose items scroll sideways when they don't fit, with a button at each end while there's more to see that way;  shrinkable, it fits their titles to its width instead.  It takes every <ui-menu> attribute."/>
			<card link="/tree" heading="Tree" meta="<ui-tree>" description="A tree shows rows nested in rows, which open and close, and can be selected one or many at a time."/>
			<card link="/tree" heading="Tree item" meta="<ui-tree-item>" description="One row of a tree:  an icon and a label, with the rows inside it, which it opens and closes."/>
		</>
	</>

	<section label="Menus">
		<cards>
			<card link="/action" heading="Action" meta="<ui-action>" description="A menu item or toolbar button drawn from an action:  its title, icon and shortcut keys."/>
			<card link="/dropdown" heading="Dropdown" meta="<ui-dropdown>" description="A dropdown lets people choose a value from a series of options."/>
			<card link="/menu" heading="Menu" meta="<ui-menu>" description="A menu displays grouped navigation actions."/>
			<card link="/sidebar" heading="Sidebar" meta="<ui-sidebar>" description="A sidebar hides additional content beside a page."/>
			<card link="/site-tabs" heading="Site tabs" meta="<ui-site-tabs>" description="Site tabs show the page's family as a row of tabs:  the parent page first, the page shown selected, each a link."/>
			<card link="/tab" heading="Tabs" meta="<ui-tabs>" description="A tab is a hidden section of content activated by a menu."/>
			<card link="/theme-menu" heading="Theme menu" meta="<ui-theme-menu>" description="A theme menu switches the page between light and dark, and picks its theme from Spell's own, and remembers both for the next page."/>
			<card link="/toolbar" heading="Toolbar" meta="<ui-toolbar>" description="A toolbar is a horizontal menu whose items scroll sideways when they don't fit, with a button at each end while there's more to see that way;  shrinkable, it fits their titles to its width instead.  It takes every <ui-menu> attribute."/>
		</>
	</>

	<section label="Forms">
		<cards>
			<card link="/button" heading="Button" meta="<ui-button>" description="A button indicates a possible action."/>
			<card link="/calendar" heading="Calendar" meta="<ui-calendar>" description="A calendar lets a person pick a date, a time, or both."/>
			<card link="/checkbox" heading="Checkbox" meta="<ui-checkbox>" description="A checkbox lets people choose a value from a small set of options, often on or off."/>
			<card link="/dropdown" heading="Dropdown" meta="<ui-dropdown>" description="A dropdown lets people choose a value from a series of options."/>
			<card link="/form" heading="Field" meta="<ui-field>" description="A field is a form element containing a label and an input, with a hint, a tip and its errors."/>
			<card link="/form" heading="Fields" meta="<ui-fields>" description="A set of fields can appear grouped together, side by side or stacked."/>
			<card link="/form" heading="Form" meta="<ui-form>" description="A form displays a set of related input fields in a structured way."/>
			<card link="/icon-picker" heading="Icon picker" meta="<ui-icon-picker>" description="An icon picker lets people choose an icon by searching for it and clicking its glyph."/>
			<card link="/input" heading="Input" meta="<ui-input>" description="An input is a field used to elicit a response from a person."/>
			<card link="/property-editor" heading="Property" meta="<ui-property>" description="A property is one field of a property editor:  its label, tip, choices and rules come from the editor's schema." extra="In progress"/>
			<card link="/property-editor" heading="Property editor" meta="<ui-property-editor>" description="A property editor draws a form from a schema:  one field per property, in folding groups, for one thing or many." extra="In progress"/>
			<card link="/property-editor" heading="Property group" meta="<ui-property-group>" description="A property group is a band of properties that opens and closes, in a property editor.  It takes <ui-section>'s attributes." extra="In progress"/>
			<card link="/radio" heading="Radio" meta="<ui-radio>" description="A radio button chooses exactly one value of a group."/>
			<card link="/rating" heading="Rating" meta="<ui-rating>" description="A rating indicates people's interest in content."/>
			<card link="/form" heading="Repeat" meta="<ui-repeat>" description="A repeat shows its fields once per item of a list, each row bound to its own item."/>
			<card link="/search" heading="Search" meta="<ui-search>" description="A search module lets people query for results from a selection of data."/>
			<card link="/select" heading="Select" meta="<ui-select>" description="A select lets people choose one or more values from a native list of options."/>
			<card link="/sides" heading="Sides" meta="<ui-sides>" description="Sides edit four lengths at once, top, left, right and bottom, as a margin or a padding:  a number box per side."/>
			<card link="/slider" heading="Slider" meta="<ui-slider>" description="A slider lets people select values within a range."/>
			<card link="/textarea" heading="Textarea" meta="<ui-textarea>" description="A textarea is a multi-line field used to elicit a longer response."/>
			<card link="/theme-editor" heading="Theme editor" meta="<ui-theme-editor>" description="A theme editor makes a theme from an existing one:  pick its colours, fonts and shapes, or set any token by hand, watch real pages follow in light and dark, then copy the theme file or keep it in the browser." extra="In progress"/>
			<card link="/theme-editor" heading="Theme token" meta="<ui-theme-token>" description="A theme token is one token of a theme being made:  where its value comes from, its value as colour chips in light and dark, and, under its name, a drawer to change it." extra="In progress"/>
		</>
	</>

	<section label="Inputs">
		<cards>
			<card link="/calendar" heading="Calendar" meta="<ui-calendar>" description="A calendar lets a person pick a date, a time, or both."/>
