"json examples" is a notebook page
	<header level="1">
		JSON data
		<header>JSON data holds data in a page, as its text or from a file, and shows it as an outline that opens and closes.</>
	</>

	<!-- EXAMPLES:  the outline first, then data a tree diagram reads. -->
	<section label="Types">
		<section label="An outline" sticky="stack" collapsible dividing>
			<example "An outline" description="The data is the element's text, drawn as an outline whose objects and arrays open and close.  Double-click a value to edit it.">
				<json depth="2" editable>
					{ "lamp": { "name": "desk", "watts": 60, "on": false, "bought": "2026-11-18" }, "tags": ["home", "office"] }
				</json>
			</example>
		</>

		<section label="Its own text" sticky="stack" collapsible dividing>
			<example "Its own text" description="The data is the element's text, its braces kept as written.  Inside a tree diagram it's the diagram's data, and doesn't show itself.">
				<tree-diagram>
					<json>
						{
						  "label": "Add",
						  "children": [{ "label": "Number 1" }, { "label": "Number 2" }]
						}
					</json>
				</tree-diagram>
			</example>
		</>

		<section label="From a file" sticky="stack" collapsible dividing>
			<example "From a file" description="`source` loads the data from a file on this site, and the tree diagram draws it once it arrives.">
				<tree-diagram>
					<json source="/components/ui/examples/tree-data.json"/>
				</tree-diagram>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Hidden" sticky="stack" collapsible dividing>
			<example "Hidden" description="`hidden` holds the data without showing it, for script or another element to read.">
				<json hidden>{ "kept": "out of sight" }</json>
				<text color="grey" italic>Nothing shows:  the data is kept for script.</text>
			</example>
		</>
	</>
