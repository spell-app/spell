					<term label="Score" value="42"/>
					<term label="Moves" value="17"/>
					<term label="Time" value="3:05"/>
				</terms>
			</example>
		</>

		<section label="Toolbar" sticky="stack" collapsible dividing>
			<example "Toolbar" description="A toolbar is a horizontal menu whose items scroll sideways when they don't fit, with a button at each end while there's more to see that way. \[Toolbar page](/toolbar)">
				<toolbar appearance="secondary" aria-label="Sections demo" style="max-width: 360px">
					<item link="#types" selected>Types</item>
