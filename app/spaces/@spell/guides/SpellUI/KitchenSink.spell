				</toolbar>
			</example>
			<example "Toolbar" description="Segmented">
				<toolbar appearance="segmented" aria-label="Segmented demo" style="max-width: 320px">
					<item selected>Examples</item>
					<item>Usage</item>
					<item>API</item>
					<item>Theming</item>
					<item>Accessibility</item>
					<item>History</item>
				</toolbar>
			</example>
			<example "Toolbar" description="Everything fits">
				<toolbar appearance="secondary" aria-label="Short demo">
					<item link="#one" selected>One</item>
					<item link="#two">Two</item>
					<item link="#three">Three</item>
				</toolbar>
			</example>
		</>
	</>

