						<text code>epic-reply</>
					</>
				</>
				<cell>A reply card, yours or Claude's, dated at the right of its band.</>
			</>
			<row>
				<cell>
					<link target="src-packages-epics-docs-epic-status-html" link="/epic-status">
						<text code>epic-status</>
					</>
