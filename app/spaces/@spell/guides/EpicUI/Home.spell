			</>
			<row>
				<cell>
					<link target="src-packages-epics-docs-epic-note-html" link="/epic-note">
						<text code>epic-note</>
					</>
				</>
				<cell>A small orange UPDATE (or green DONE) note that stays in the prose.</>
			</>
		</>
		<text paragraph><text code>epic-field</> (above) is one too, with a <text code>label</>: "Where:", "Step:".</>
	</>

	<section label="5. The log and commits">
		<icon slot="icon" name="clock rotate left"/>
		<table celled padding="compact" appearance="striped" unstackable>
