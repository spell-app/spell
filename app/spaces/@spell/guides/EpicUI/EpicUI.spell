// Epic UI's pages as one site (epic `editor` P44):  each page one notebook, each at its own address.
// This file says where each page is, and which group of the side navigation lists it.
epic ui is a site
	it has a home page at "/", named "Epic UI"

	group "Page and sections"
	it has an epic actions element page at "/epic-actions", named "<epic-actions>"
	it has an epic away line page at "/epic-away-line", named "<epic-away-line>"
	it has an epic cards element page at "/epic-cards", named "<epic-cards>"
	it has an epic clarify page at "/epic-clarify", named "<epic-clarify>"
	it has an epic field page at "/epic-field", named "<epic-field>"
	it has an epic focus element page at "/epic-focus", named "<epic-focus>"
	it has an epic hidden note page at "/epic-hidden-note", named "<epic-hidden-note>"
	it has an epic kickoff page at "/epic-kickoff", named "<epic-kickoff>"
	it has an epic mark page at "/epic-mark", named "<epic-mark>"
	it has an epic overview page at "/epic-overview", named "<epic-overview>"
	it has an epic page page at "/epic-page", named "<epic-page>"
	it has an epic phase page at "/epic-phase", named "<epic-phase>"
	it has an epic prompt page at "/epic-prompt", named "<epic-prompt>"
	it has an epic section page at "/epic-section", named "<epic-section>"
	it has an epic state filter page at "/epic-state-filter", named "<epic-state-filter>"
	it has an epic summary page at "/epic-summary", named "<epic-summary>"
	it has an epic update page at "/epic-update", named "<epic-update>"
	it has an epic updated page at "/epic-updated", named "<epic-updated>"

	group "Items and cards"
	it has an epic answer page at "/epic-answer", named "<epic-answer>"
	it has an epic choices element page at "/epic-choices", named "<epic-choices>"
	it has an epic item page at "/epic-item", named "<epic-item>"
	it has an epic more page at "/epic-more", named "<epic-more>"
	it has an epic option page at "/epic-option", named "<epic-option>"
	it has an epic original page at "/epic-original", named "<epic-original>"
	it has an epic picture page at "/epic-picture", named "<epic-picture>"
	it has an epic question page at "/epic-question", named "<epic-question>"
	it has an epic reply page at "/epic-reply", named "<epic-reply>"
	it has an epic status element page at "/epic-status", named "<epic-status>"
	it has an epic version page at "/epic-version", named "<epic-version>"

	group "Prose"
	it has an epic aside page at "/epic-aside", named "<epic-aside>"
	it has an epic change page at "/epic-change", named "<epic-change>"
	it has an epic code page at "/epic-code", named "<epic-code>"
	it has an epic link page at "/epic-link", named "<epic-link>"
	it has an epic net effect page at "/epic-net-effect", named "<epic-net-effect>"
	it has an epic note page at "/epic-note", named "<epic-note>"

	group "Log and commits"
	it has an epic commit page at "/epic-commit", named "<epic-commit>"
	it has an epic event page at "/epic-event", named "<epic-event>"

	group "Pages you answer on"
	it has an epic ask page at "/epic-ask", named "<epic-ask>"
	it has an epic choice row page at "/epic-choice-row", named "<epic-choice-row>"
	it has an epic choice rows element page at "/epic-choice-rows", named "<epic-choice-rows>"
	it has an epic choices bar page at "/epic-choices-bar", named "<epic-choices-bar>"
	it has an epic run page at "/epic-run", named "<epic-run>"
	it has an epic run row page at "/epic-run-row", named "<epic-run-row>"
	it has an epic send page at "/epic-send", named "<epic-send>"
	it has an epic send buttons element page at "/epic-send-buttons", named "<epic-send-buttons>"
	it has an epic text box page at "/epic-text-box", named "<epic-text-box>"

	group "The Epics page"
	it has an epic card page at "/epic-card", named "<epic-card>"
	it has an epic list page at "/epic-list", named "<epic-list>"
	it has an epic pills element page at "/epic-pills", named "<epic-pills>"
	it has an epic sort page at "/epic-sort", named "<epic-sort>"

	group "Comments"
	it has an epic comment pane page at "/epic-comment-pane", named "<epic-comment-pane>"
	it has an epic page note head page at "/epic-page-note-head", named "<epic-page-note-head>"
	it has an epic thread page at "/epic-thread", named "<epic-thread>"
	it has an epic threads element page at "/epic-threads", named "<epic-threads>"
	it has a not found page
