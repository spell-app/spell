<spell-notebook "advertisement examples">
	<header level="1">
		Advertisement
		<header>An ad displays third-party promotional content.</>
	</>
	<advertisement-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's page, section by section, in its order (Types, Content, States, Variations,
		Groups ...).  Rules, the class-grammar mappings, gaps:  packages/docs/content/epics/spell-ui-pages/PAGES.md.
		- A section:  `<ui-header level="2" dividing id="types">Types</ui-header>`, then its examples.
		- An example:  `<ui-example heading="..." description="...">` around the live markup;  the markup
		  IS the code shown.  A richer description:  `<p slot="description">` (+ `<ui-message slot="description">`).
		- A gap:  an HTML comment `GAP I<n>:  ...` BEFORE the example (a comment inside it shows in its code).
	-->
	<section label="Types">
		<section label="Ad" sticky="stack" collapsible dividing>
			<example "Ad" description="A standard ad.">
				<ad unit="banner">
					<text data-ad-slot="XXXXXXXXXXXXXXXX" data-ad-client="ca-pub-XXXXXXXXXXXXXXXX" class="adsbygoogle" underline/>
				</ad>
				<message slot="description" size="small">The following example shows basic <link target="_blank" link="https://support.google.com/adsense/answer/181947">AdSense</link> usage: the network's <text code>&lt;ins&gt;</text> goes inside, and its loader script fills it. Your code will vary depending on your ad network.</message>
			</example>
		</>

		<section label="Common Units" sticky="stack" collapsible dividing>
			<example "Common Units" description="An advertisement can appear in common ad unit sizes: `unit` takes the unit's words.">
				<ad unit="medium rectangle" test="Medium Rectangle"/>
				<ad unit="banner" test="Banner"/>
				<ad unit="leaderboard" test="Leaderboard"/>
				<ad unit="large rectangle" test="Large Rectangle"/>
				<ad unit="half page" test="Half Page"/>
				<message slot="description" state="info" size="small">These additional examples use the <link link="#examples-variations-test"><text code>test</text></link> variation to appear on the page. <text code>&lt;ui-ad&gt;</text> is best used as a wrapper for third party ad network content like AdSense or DoubleClick.</message>
			</example>
		</>

		<!-- GAP I30:  no `mobile` modifier for other units (Fomantic's `mobile banner`);  only the `mobile leaderboard` / `large mobile banner` units. -->
		<section label="Mobile" sticky="stack" collapsible dividing>
			<example "Mobile" description="An ad can use common mobile ad sizes.">
				<ad unit="mobile leaderboard" test="Mobile Leaderboard"/>
				<ad unit="large mobile banner" test="Large Mobile Banner"/>
				<message slot="description" state="info" size="small">Mobile ads will automatically only appear on mobile browser viewports, so this example is empty on a desktop.</message>
			</example>
		</>

		<section label="Rectangle" sticky="stack" collapsible dividing>
			<example "Rectangle" description="An ad can use a common rectangle ad unit size.">
				<ad unit="vertical rectangle" test="Vertical Rectangle"/>
				<ad unit="small rectangle" test="Small Rectangle"/>
			</example>
		</>

		<section label="Button" sticky="stack" collapsible dividing>
			<example "Button" description="An ad can use button ad unit size.">
				<ad unit="button" test="Button"/>
				<ad unit="square button" test="Square Button"/>
				<ad unit="small button" test="Small Button"/>
			</example>
		</>

		<section label="Square" sticky="stack" collapsible dividing>
			<example "Square" description="An ad can use a square ad unit size.">
				<ad unit="square" test="Square"/>
				<ad unit="small square" test="Small Square"/>
			</example>
		</>

		<section label="Skyscraper" sticky="stack" collapsible dividing>
			<example "Skyscraper" description="An ad can use skyscraper ad unit size.">
				<ad unit="skyscraper" test="Skyscraper"/>
				<ad unit="wide skyscraper" test="Wide Skyscraper"/>
			</example>
		</>

		<section label="Banner" sticky="stack" collapsible dividing>
			<example "Banner" description="An ad can use banner ad unit size.">
				<ad unit="banner" test="Banner"/>
				<ad unit="vertical banner" test="Vertical Banner"/>
				<ad unit="top banner" test="Top Banner"/>
				<ad unit="half banner" test="Half Banner"/>
			</example>
		</>

		<!-- GAP I32:  units wider than the column (leaderboards, top banner, panorama) overflow it on desktop. -->
		<section label="Leaderboards" sticky="stack" collapsible dividing>
			<example "Leaderboards" description="An ad can use leaderboard ad unit size.">
				<ad unit="leaderboard" test="Leaderboard"/>
				<ad unit="large leaderboard" test="Large Leaderboard"/>
				<ad unit="billboard" test="Billboard"/>
			</example>
		</>

		<section label="Panorama" sticky="stack" collapsible dividing>
			<example "Panorama" description="An ad can use panorama ad unit size.">
				<ad unit="panorama" test="Panorama"/>
			</example>
		</>

		<section label="Netboard" sticky="stack" collapsible dividing>
			<example "Netboard" description="An ad can use netboard ad unit size.">
				<ad unit="netboard" test="Netboard"/>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Centered" sticky="stack" collapsible dividing>
			<example "Centered" description="An advertisement can appear centered.">
				<ad unit="banner" align="center" test/>
			</example>
		</>

		<section label="Test" sticky="stack" collapsible dividing id="variations-test">
			<example "Test" description="An advertisement can be formatted to help verify placement.">
				<ad unit="medium rectangle" test="Ad Unit 1"/>
				<ad unit="medium rectangle" test="Ad Unit 2"/>
				<ad unit="small rectangle" test/>
				<message slot="description" state="info" size="small">Set the text of a test placement with <text code>test="..."</text>, Fomantic's <text code>data-text</text>. A bare <text code>test</text> says "Ad", translated with the page's language.</message>
			</example>
		</>

		<section label="Content" sticky="stack" collapsible dividing>
			<example "Content" description="The ad itself goes inside:  usually an `<iframe>` from the ad network, or an image link with its own `alt`.">
				<ad unit="small rectangle">
					<image link="#sponsor" src="/components/ui/images/wireframe/image.png" alt="Our sponsor"/>
				</ad>
			</example>
		</>
	</>
</spell-notebook>
