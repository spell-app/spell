<spell-notebook "stack api">
	<header level="1">
		Stack
		<header>A stack lays its children out in a column, or a row that wraps, evenly spaced.</>
	</>
	<stack-tab-bar showing="api"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#attributes">Attributes</>
			<item link="#slots">Slots</>
			<item link="#states">States</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`site/_data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-stack" only="attributes"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api family="ui-stack" only="slots"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-stack" only="states"></>
		</>
	</>
</spell-notebook>
