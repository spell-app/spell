<spell-notebook "extra examples">
	<header level="1">
		Extra
		<header>Extra content is set apart from the main content, such as a card's footer.</>
	</>
	<extra-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#owners">Owners</>
		</>
	</>

	<!--
		EXAMPLES:  `<ui-extra>` in each owner that gives it a look (from the owners' own pages and
		`src/components/ui-parts/examples/elements/`), then its attributes.  The Content parts page
		(`ui-header.html`) shows every part together.
	-->
	<section label="Owners">
		<section label="Card" sticky="stack" collapsible dividing>
			<example description="A card's extra content:  its footer band.">
				<card>
					<content>
						<header>Elliot</header>
						<description>Elliot is a sound engineer living in Nashville.</description>
					</content>
					<extra><icon name="user"/> 16 Friends</extra>
				</card>
			</example>
		</>

		<section label="Item" sticky="stack" collapsible dividing>
			<example description="An item's extra content:  a line under its description.">
				<items>
					<item image="../images/wireframe/image.png">
						<content>
							<header link="#">Cute Dog</header>
							<description>Many people also have their own barometers for what makes a cute dog.</description>
							<extra><icon name="check" color="green"/> 121 Votes</extra>
						</content>
					</item>
				</items>
			</example>
		</>

		<section label="Feed" sticky="stack" collapsible dividing>
			<example description="A feed event's extra images;  with `text`, extra text.">
				<feed>
					<event>
						<content>
							<summary><author link="#helen">Helen Troy</author> added 2 new photos</summary>
							<extra>
								<images size="tiny">
									<image src="/components/ui/images/wireframe/image.png" alt=""/>
									<image src="/components/ui/images/wireframe/image.png" alt=""/>
								</images>
							</extra>
						</content>
					</event>
					<event>
						<content>
							<summary><author link="#laura">Laura Faucet</author> created a post</summary>
							<extra text>Have you seen what's going on in Israel? Can you believe it.</extra>
						</content>
					</event>
				</feed>
			</example>
		</>
	</>
</spell-notebook>
