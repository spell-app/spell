<spell-notebook "nag examples">
	<header level="1">
		Nag
		<header>A nag is a persistent message that stays until dismissed, and can remember the dismissal.</>
	</>
	<nag-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#groups">Groups</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's nag page, section by section, in its order (Types, Groups, Variations).  Nags here sit in the
		flow of the page;  the fixed ones start `hidden` and open from a button, so they never cover the docs.  Most are
		`closable="false"`, so a stray click doesn't take the example away.
	-->
	<section label="Types">
		<message size="small" state="info">A nag shows as soon as it is on the page, unless its dismissal is remembered (see the Usage tab) or it starts <text code>hidden</>; Fomantic's starts hidden until script calls it.</>

		<section label="Nag" sticky="stack" collapsible dividing>
			<example "Nag" description="A simple nag appears in the DOM where it is declared.  Closing it hides it for this visit.">
				<nag>Look, I am a nag!</nag>
			</example>
		</>

		<section label="Title" sticky="stack" collapsible dividing>
			<example "Title" description="A nag can have a title:  a `<span class=\"title\">` inside is set off in the title colour.">
				<nag closable="false"><text class="title">Welcome to the nag module</text> Look, I am a nag!</nag>
			</example>
		</>

		<section label="Fixed Nag" sticky="stack" collapsible dividing>
			<example "Fixed Nag" description="A fixed nag appears at the top of the screen:  this one starts `hidden`, and a button shows it (`command=\"--show\"`). `persist` ignores the stored dismissal, for the demo.">
				<button commandfor="nag-fixed" command="--show" icon="eye">Show fixed nag</button>
				<nag id="nag-fixed" fixed hidden persistent>Look, I am a fixed nag!</nag>
			</example>
			<example "Fixed Nag" description="A fixed nag can appear at the bottom of the screen:  `fixed bottom`.">
				<button commandfor="nag-bottom-fixed" command="--show" icon="eye">Show bottom fixed nag</button>
				<nag id="nag-bottom-fixed" fixed bottom hidden persistent>Look, I am a bottom fixed nag!</nag>
			</example>
		</>

		<section label="Overlay Nag" sticky="stack" collapsible dividing>
			<example "Overlay Nag" description="An overlay nag is absolute positioned and appears at the top of the parent element, over its content.">
				<segment>
					<nag overlay closable="false"><text class="title">Welcome to the nag module</text> Look, I am a top overlay nag!</nag>
					<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
				</segment>
			</example>
			<example "Overlay Nag" description="An overlay nag can appear at the bottom of the parent element:  `overlay bottom`.">
				<segment>
					<nag overlay bottom closable="false"><text class="title">Welcome to the nag module</text> Look, I am a bottom overlay nag!</nag>
					<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
				</segment>
			</example>
		</>
	</>

	<section label="Groups">
		<section label="Nags" sticky="stack" collapsible dividing>
			<example "Nags" description="A group of nags can be formatted to appear together.">
				<message slot="description" size="small" class="site-not-ported">Not ported: the <text code>.ui.nags</text> group (several nags joined in one bar) -- here they simply stack, each with its own close icon.</message>
				<nag>
					<text class="title">First nag</text>
				</nag>
				<nag>
					<text class="title">Second nag</text>
				</nag>
				<nag>
					<text class="title">Third nag</text>
				</nag>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Colored" sticky="stack" collapsible dividing>
			<example "Colored" description="A nag can be formatted to be different colors.">
				<nag color="red" closable="false">
					<text class="title">Red</text>
				</nag>
				<nag color="orange" closable="false">
					<text class="title">Orange</text>
				</nag>
				<nag color="yellow" closable="false">
					<text class="title">Yellow</text>
				</nag>
				<nag color="olive" closable="false">
					<text class="title">Olive</text>
				</nag>
				<nag color="green" closable="false">
					<text class="title">Green</text>
				</nag>
				<nag color="teal" closable="false">
					<text class="title">Teal</text>
				</nag>
				<nag color="blue" closable="false">
					<text class="title">Blue</text>
				</nag>
				<nag color="violet" closable="false">
					<text class="title">Violet</text>
				</nag>
				<nag color="purple" closable="false">
					<text class="title">Purple</text>
				</nag>
				<nag color="pink" closable="false">
					<text class="title">Pink</text>
				</nag>
				<nag color="brown" closable="false">
					<text class="title">Brown</text>
				</nag>
				<nag color="black" closable="false">
					<text class="title">Black</text>
				</nag>
			</example>
		</>

		<section label="Inverted" sticky="stack" collapsible dividing>
			<example "Inverted" description="A nag can be formatted to appear inverted:  a nag is dark by default, `inverted` makes it light;  a coloured one takes its tint.">
				<nag inverted closable="false"><text class="title">Inverted</text> This nag has inverted colors</nag>
				<nag inverted color="red" closable="false"><text class="title">Inverted red</text> A tinted nag</nag>
			</example>
		</>

		<section label="Size" sticky="stack" collapsible dividing>
			<example "Size" description="A nag can have different sizes.">
				<nag size="mini" closable="false">
					<text class="title">Mini nag</text>
				</nag>
				<nag size="tiny" closable="false">
					<text class="title">Tiny nag</text>
				</nag>
				<nag size="small" closable="false">
					<text class="title">Small nag</text>
				</nag>
				<nag size="large" closable="false">
					<text class="title">Large nag</text>
				</nag>
				<nag size="big" closable="false">
					<text class="title">Big nag</text>
				</nag>
				<nag size="huge" closable="false">
					<text class="title">Huge nag</text>
				</nag>
				<nag size="massive" closable="false">
					<text class="title">Massive nag</text>
				</nag>
			</example>
		</>
	</>
</spell-notebook>
