<spell-notebook "flag api">
	<header level="1">
		Flag
		<header>A flag is used to represent a political state.</>
	</>
	<flag-tab-bar showing="api"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#attributes">Attributes</>
			<item link="#parts">Parts</>
			<item link="#states">States</>
			<item link="#texts">Texts</>
		</>
	</>

	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-flag" only="attributes"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-flag" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-flag" only="states"></>
		</>
	</>

	<section label="Texts">
		<html>
			<ui-docs-api family="ui-flag" only="texts"></>
		</>
	</>
</spell-notebook>
