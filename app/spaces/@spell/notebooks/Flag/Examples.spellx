	<section label="Variations">
		<section label="Size" sticky="stack" collapsible dividing>
			<example "Size" description="A flag can vary in size.">
				<message slot="description" size="small">Sizes are ratios of the surrounding text, <text code>small</text> (1.5em) ... <text code>massive</text> (12em). <text code>medium</text> is the default, the size of the text -- NOT Fomantic's fixed 3em.</message>
				<segment appearance="basic"><flag country="de" size="small"/> Small <space/> <flag country="fr" size="medium"/> Medium <space/> <flag country="li" size="large"/> Large <space/> <flag country="jp" size="big"/> Big <space/> <flag country="gb" size="huge"/> Huge <space/> <flag country="un" size="massive"/> Massive</segment>
			</example>
		</>

		<section label="Autosizing" sticky="stack" collapsible dividing>
			<example "Autosizing" description="If no specific size is given, every flag is sized by the current element's font size.">
				<segment appearance="basic">
					<header size="small">Within a header <flag country="us"/></header>
					<button size="large">Within a button <flag country="eu"/></button>
					<divider spacer/>
					<label size="massive">Within a label <flag country="pirate"/></label>
					<divider spacer/>
					<text size="small" color="orange">Within a text <flag country="rainbow"/></text>
				</segment>
			</example>
		</>
	</>
</spell-notebook>
