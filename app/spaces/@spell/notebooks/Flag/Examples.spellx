<spell-notebook "flag examples">
	<header level="1">
		Flag
		<header>A flag is used to represent a political state.</>
	</>
	<flag-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#definition">Definition</>
			<item link="#types">Types</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's flag page, in its order (Definition, Types:  the flag list, Size, Autosizing), plus our own
		extras (Names, Other flags).  The glyph is the reader's platform flag EMOJI, so the look depends on the OS:
		Windows' Chrome / Edge show two letters unless the page loads a flag font (Theming tab, "A flag font").  The flag list is generated from
		`FLAG_ALIASES` (`UIFlag.types.ts`) / `UIT.SpecialFlags` with English region names.
	-->
	<section label="Definition">
		<section label="Flag" sticky="stack" collapsible dividing>
			<example "Flag" description="A flag can use the two digit country code, the full name, or a common alias.">
				<flag country="ae"/>
				<flag country="france"/>
				<flag country="myanmar"/>
			</example>
		</>

		<section label="Names" sticky="stack" collapsible dividing>
			<example "Names" description="Case, underscores and extra spaces don't matter:  `America`, `United_Kingdom`, `uk` all work.">
				<flag country="fr"/>
				<flag country="US"/>
				<flag country="united states"/>
				<flag country="America"/>
				<flag country="United_Kingdom"/>
				<flag country="uk"/>
				<flag country="south africa"/>
			</example>
		</>

		<section label="Other flags" sticky="stack" collapsible dividing>
			<example "Other flags" description="Flags that aren't a country:  `rainbow` (`pride`, `lgbt`), `transgender`, `pirate`, and the `england`, `scotland` and `wales` subdivision flags.">
				<flag country="pride"/>
				<flag country="transgender"/>
				<flag country="pirate"/>
				<flag country="england"/>
				<flag country="scotland"/>
				<flag country="wales"/>
			</example>
		</>
	</>

	<section label="Types">
		<message state="info" size="small">Flags are the Unicode flag emoji, as in Fomantic 2.9's default theme: no images, by design. Windows' Chrome and Edge have no flag emoji and show the two letters instead; a page that wants flags there loads a flag font (Theming tab, "A flag font").</>
		<message size="small" class="site-not-ported">Not ported: Fomantic's <text code>famfamfam</> sprite theme -- flags are emoji only.</>
		<message size="small" class="site-not-ported">Not ported: Fomantic's <text code>@flags</> variable to trim the generated CSS -- there is no per-flag CSS to trim.</>

		<section label="Flag list" sticky="stack" collapsible dividing>
			<table selectable sortable client-sort padding="compact" celled appearance="striped" definition>
				<row header>
					<cell data-sortable="false">Flag</>
					<cell>Name</>
					<cell>ISO 3166-2 Code</>
					<cell>Additional Aliases</>
				</>
