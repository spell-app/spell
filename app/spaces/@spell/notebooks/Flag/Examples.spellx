	<section label="Variations">
		<section label="Size" sticky="stack" collapsible dividing>
			<example description="A flag can vary in size.">
				<message slot="description" size="small"><html>Sizes are ratios of the surrounding text, <code>small</code> (1.5em) ... <code>massive</code> (12em). <code>medium</code> is the default, the size of the text -- NOT Fomantic's fixed 3em.</html></message>
				<html>
					<ui-segment appearance="basic"><ui-flag country="de" size="small"></ui-flag> Small <br /> <ui-flag country="fr" size="medium"></ui-flag> Medium <br /> <ui-flag country="li" size="large"></ui-flag> Large <br /> <ui-flag country="jp" size="big"></ui-flag> Big <br /> <ui-flag country="gb" size="huge"></ui-flag> Huge <br /> <ui-flag country="un" size="massive"></ui-flag> Massive</ui-segment>
				</html>
			</example>
		</>

		<section label="Autosizing" sticky="stack" collapsible dividing>
			<example description="If no specific size is given, every flag is sized by the current element's font size.">
				<segment appearance="basic">
					<header size="small">Within a header <flag country="us"/></header>
					<button size="large">Within a button <flag country="eu"/></button>
					<divider spacer/>
					<label size="massive">Within a label <flag country="pirate"/></label>
					<divider spacer/>
					<text size="small" color="orange">Within a text <flag country="rainbow"/></text>
				</segment>
			</example>
		</>
	</>
</spell-notebook>
