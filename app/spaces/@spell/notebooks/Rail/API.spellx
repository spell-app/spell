<spell-notebook "rail api">
	<header level="1">
		Rail
		<header>A rail is used to show accompanying content outside the boundaries of the main view of a
              site.</>
	</>
	<rail-tab-bar showing="api"/>
	<section>
		<html>
			<ui-menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
				<ui-item link="#attributes">Attributes</>
				<ui-item link="#slots">Slots</>
				<ui-item link="#parts">Parts</>
				<ui-item link="#states">States</>
			</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`docs/__data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-rail" only="attributes"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api family="ui-rail" only="slots"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-rail" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-rail" only="states"></>
		</>
	</>
</spell-notebook>
