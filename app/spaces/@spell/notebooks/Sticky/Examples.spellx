								</ui-sticky>
							</ui-column>
						</ui-grid>
					</ui-segment>
				</html>
			</example>
		</>

		<section label="Sticking to Own Context" sticky collapsible dividing>
			<example description="Sticky content can also stick within the element it's in. It keeps its room while stuck, so the content after it doesn't jump: no `ui fixed sticky + p` margin fix is needed.">
				<segment>
					<sticky offset="64">
						<menu fluid items="3" appearance="tabular" aria-label="Tabs">
							<item active link="#tab-1">Tab 1</item>
							<item link="#tab-2">Tab 2</item>
							<item link="#tab-3">Tab 3</item>
						</menu>
					</sticky>
					<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
					<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
					<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
					<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
					<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
					<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
					<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
					<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
					<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
				</segment>
			</example>
		</>
	</>
</spell-notebook>
