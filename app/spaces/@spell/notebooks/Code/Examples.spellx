<spell-notebook "code examples">
	<header level="1">
		Code
		<header>Code shows a block of source code coloured by its language, from the element's own text or a file on
              this site.</>
	</>
	<code-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  ours only, no Fomantic page.  The old Astro page's examples (Types, Variations), restyled, plus a markup
		example.  Files shown:  `site/examples/` (`../examples/sample.json`).
	-->
	<section label="Types">
		<section label="Code" sticky="stack" collapsible dividing>
			<example description="Code colours its own text as `language`:  any highlight.js name or alias (`ts`, `html`, `css`, `json`, `bash` ...).">
				<code language="ts">const greeting: string = "hello"</code>
			</example>
		</>

		<section label="Markup" sticky="stack" collapsible dividing>
			<example description="Code with `<` or `&` goes in a `<script type=\"text/plain\">` child:  its text is taken exactly, then dedented.">
				<html>
					<ui-code language="html">
						<script type="text/plain">
							<ui-button color="primary">Save</ui-button>
							<ui-button>Cancel & close</ui-button>
						</script>
					</ui-code>
				</html>
			</example>
		</>

		<section label="From a file" sticky="stack" collapsible dividing>
			<example description="`source` shows a file of this site, fetched when `load` says.  Without `language`, the language is guessed among the common ones;  `detectedLanguage` says which.">
				<code source="/components/ui/examples/sample.json"/>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Line numbers" sticky="stack" collapsible dividing>
			<example description="`line-numbers` numbers the lines, from `start`.">
				<code language="json" source="/components/ui/examples/sample.json" line-numbers start="10"/>
			</example>
		</>

		<section label="Wrapping" sticky="stack" collapsible dividing>
			<example description="`wrap` wraps long lines;  by default they scroll.">
				<html>
					<ui-code language="bash" wrap>
						<script type="text/plain">echo "a long line that wraps once the box is too narrow to hold it, instead of scrolling sideways"</script>
					</ui-code>
				</html>
			</example>
			<example description="With `line-numbers`, a wrapped line hangs past its number.">
				<html>
					<ui-code language="bash" line-numbers wrap>
						<script type="text/plain">
							echo "line one"
							echo "a long line that wraps once the box is too narrow to hold it, hanging past the line number"
						</script>
					</ui-code>
				</html>
			</example>
		</>

		<section label="Copy button" sticky="stack" collapsible dividing>
			<example description="`copy` adds a button that copies the code.">
				<code language="bash" copy>yarn add spell-ui</code>
			</example>
		</>
	</>
</spell-notebook>
