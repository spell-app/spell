<spell-notebook "example api">
	<header level="1">
		Example
		<header>An example shows its own markup live, under a heading and description, with the same markup as code a button shows and hides.</>
	</>
	<example-tab-bar showing="api"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#attributes">Attributes</>
			<item link="#events">Events</>
			<item link="#slots">Slots</>
			<item link="#parts">Parts</>
			<item link="#states">States</>
			<item link="#texts">Texts</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`site/_data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-example" only="attributes"></>
		</>
	</>

	<section label="Events">
		<html>
			<ui-docs-api family="ui-example" only="events"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api family="ui-example" only="slots"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-example" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-example" only="states"></>
		</>
	</>

	<section label="Texts">
		<html>
			<ui-docs-api family="ui-example" only="texts"></>
		</>
	</>
</spell-notebook>
