<spell-page "json examples" notebook>
	<header level="1">
		JSON data
		<header>JSON data holds data in a page, as its text or from a file:  it draws nothing, and other elements read it.</>
	</>
	<json-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
		</>
	</>

	<!-- EXAMPLES:  it draws nothing, so each example shows it read by a tree diagram. -->
	<section label="Types">
		<section label="Its own text" sticky="stack" collapsible dividing>
			<example "Its own text" description="The data is the element's text, its braces kept as written.  It draws nothing itself:  here a tree diagram reads the `<json>` inside it.">
				<tree-diagram>
					<json>
						{
						  "label": "Add",
						  "children": [{ "label": "Number 1" }, { "label": "Number 2" }]
						}
					</json>
				</tree-diagram>
			</example>
		</>

		<section label="From a file" sticky="stack" collapsible dividing>
			<example "From a file" description="`source` loads the data from a file on this site, and the tree diagram draws it once it arrives.">
				<tree-diagram>
					<json source="/components/ui/examples/tree-data.json"/>
				</tree-diagram>
			</example>
		</>
	</>
</spell-page>
