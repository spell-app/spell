<spell-notebook "icon api">
	<header level="1">
		Icon
		<header>An icon is a glyph used to represent something else.</>
	</>
	<icon-tab-bar showing="api"/>
	<section>
		<html>
			<ui-menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
				<ui-item link="#tags">Tags</>
				<ui-item link="#attributes">Attributes</>
				<ui-item link="#slots">Slots</>
				<ui-item link="#parts">Parts</>
				<ui-item link="#states">States</>
			</>
		</>
	</>

	<section label="Tags">
		<html>
			<ui-docs-api family="ui-icon" only="tags"></>
		</>
	</>

	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-icon" only="attributes"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api family="ui-icon" only="slots"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-icon" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-icon" only="states"></>
		</>
	</>
</spell-notebook>
