<spell-notebook "breadcrumb api">
	<header level="1">
		Breadcrumb
		<header>A breadcrumb is used to show hierarchy between content.</>
	</>
	<breadcrumb-tab-bar showing="api"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#tags">Tags</>
			<item link="#attributes">Attributes</>
			<item link="#slots">Slots</>
			<item link="#parts">Parts</>
			<item link="#states">States</>
			<item link="#texts">Texts</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`docs/__data/components.json5`);  nothing to write. -->
	<section label="Tags">
		<html>
			<ui-docs-api family="ui-breadcrumbs" only="tags"></>
		</>
	</>

	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-breadcrumbs" only="attributes"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api family="ui-breadcrumbs" only="slots"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-breadcrumbs" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-breadcrumbs" only="states"></>
		</>
	</>

	<section label="Texts">
		<html>
			<ui-docs-api family="ui-breadcrumbs" only="texts"></>
		</>
	</>
</spell-notebook>
