<spell-notebook "zoom api">
	<header level="1">
		Zoom
		<header>A zoom shows something small in the page, and full size over it on a click.</>
	</>
	<zoom-tab-bar showing="api"/>
	<section>
		<html>
			<ui-menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
				<ui-item link="#attributes">Attributes</>
				<ui-item link="#slots">Slots</>
				<ui-item link="#parts">Parts</>
				<ui-item link="#states">States</>
				<ui-item link="#texts">Texts</>
			</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`site/_data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-zoom" only="attributes"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api family="ui-zoom" only="slots"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-zoom" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-zoom" only="states"></>
		</>
	</>

	<section label="Texts">
		<html>
			<ui-docs-api family="ui-zoom" only="texts"></>
		</>
	</>
</spell-notebook>
