<spell-notebook "message examples">
	<header level="1">
		Message
		<header>A message displays information that explains nearby content.</>
	</>
	<message-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#content">Content</>
			<item link="#states">States</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's message page, section by section, in its order (Types, States, Variations), plus our own
		extras (Content, Centered, Inverted).  A slotted `<ui-header>` styles itself for the message it sits in;  the
		`heading` attribute is the shorthand.
	-->
	<section label="Types">
		<section label="Message" sticky="stack" collapsible dividing>
			<example description="A basic message.">
				<html>
					<ui-message>
						<ui-header>Changes in Service</ui-header>
						<p>We just updated our privacy policy here to better service our customers. We recommend reviewing the changes.</p>
					</ui-message>
				</html>
			</example>
		</>

		<section label="List Message" sticky="stack" collapsible dividing>
			<example description="A message with a list.  `heading` is the shorthand for a header.">
				<html>
					<ui-message heading="New Site Features">
						<ul>
							<li>You can now have cover images on blog pages</li>
							<li>Drafts will now auto-save while writing</li>
						</ul>
					</ui-message>
				</html>
			</example>
		</>

		<section label="Icon Message" sticky="stack" collapsible dividing>
			<example description="A message can contain an icon:  the `icon` attribute takes a name, the `icon` slot any markup.">
				<html>
					<ui-message icon="inbox" heading="Have you heard about our mailing list?">
						<p>Get the best news in your e-mail every day.</p>
					</ui-message>
				</html>
			</example>
			<example>
				<html>
					<ui-message heading="Just one second">
						<ui-icon slot="icon" name="circle notch" loading></ui-icon>
						<p>We're fetching that content for you.</p>
					</ui-message>
				</html>
			</example>
		</>

		<section label="Dismissable Block" sticky="stack" collapsible dividing>
			<example description="A message that the user can choose to hide: `dismissible` adds a close button.">
				<message slot="description" state="info" size="small"><html>Unlike Fomantic's, the close button works by itself: it fires the cancelable <code>ui-closing</code>, then the message sets <code>hidden</code> on itself (see the Usage tab). Reload the page to bring it back.</html></message>
				<html>
					<ui-message dismissible heading="Welcome back!">
						<p>This is a special notification which you can dismiss if you're bored with it.</p>
					</ui-message>
				</html>
			</example>
		</>
	</>

	<section label="Content">
		<section label="Header" sticky="stack" collapsible dividing>
			<example description="A message can contain a header:  a slotted `<ui-header>`.">
				<html>
					<ui-message>
						<ui-header>Email Confirmed</ui-header>
						<p>You're all signed up for the newsletter</p>
					</ui-message>
				</html>
			</example>
		</>

		<section label="List" sticky="stack" collapsible dividing>
			<example description="A message can contain a list of items:  a plain `<ul>`.">
				<html>
					<ui-message>
						<ul>
							<li>No header, just a list</li>
							<li>It is a list of items</li>
						</ul>
					</ui-message>
				</html>
			</example>
		</>
	</>

	<section label="States">
		<section label="Hidden" sticky="stack" collapsible dividing>
			<example description="A message can be hidden:  the standard `hidden` attribute.  The message below is in the example, unseen.">
				<html>
					<ui-message hidden>
						<p>You can't see me</p>
					</ui-message>
				</html>
			</example>
		</>

		<section label="Visible" sticky="stack" collapsible dividing>
			<example description="A message can be set to visible to force itself to be shown.">
				<message size="small" slot="description" class="site-not-ported"><html>Not ported: the <code>visible</code> class -- a message without <code>hidden</code> is always shown.</html></message>
				<html>
					<ui-message>
						<p>You can always see me</p>
					</ui-message>
				</html>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Center Aligned" sticky="stack" collapsible dividing>
			<example description="A message can be displayed center aligned:  `text-align=\"center\"`.">
				<html>
					<ui-message align="center" heading="New Version is available!">
						<p>When are you going to update?</p>
					</ui-message>
				</html>
			</example>
		</>

		<section label="Right Aligned" sticky="stack" collapsible dividing>
			<example description="A message can be displayed right aligned:  `text-align=\"right\"`.">
				<html>
					<ui-message align="right" heading="New Version is available!">
						<p>When are you going to update?</p>
					</ui-message>
				</html>
			</example>
		</>

		<section label="Centered" sticky="stack" collapsible dividing>
			<example description="`centered` centres the text and an icon together with the content;  `align` aligns the text alone.">
				<html>
					<ui-message centered icon="envelope" heading="Centered icon">
						<p>Icon and content centred together.</p>
					</ui-message>
				</html>
			</example>
		</>

		<section label="Floating" sticky="stack" collapsible dividing>
			<example description="A message can float above content that it is related to.">
				<html>
					<ui-message floating>
						<p>Way to go!</p>
					</ui-message>
				</html>
			</example>
		</>

		<section label="Compact" sticky="stack" collapsible dividing>
			<example description="A message can only take up the width of its content.">
				<html>
					<ui-message padding="compact">
						<p>Get all the best inventions in your e-mail every day. Sign up now!</p>
					</ui-message>
				</html>
			</example>
		</>

		<section label="Attached" sticky="stack" collapsible dividing>
			<example description="A message can be formatted to attach itself to other content:  `attach=\"both\"` or `attach=\"top\"` joins the content below, `attach=\"bottom\"` the content above.">
				<html>
					<ui-message attach="both" heading="Welcome to our site!">
						<p>Fill out the form below to sign-up for a new account</p>
					</ui-message>
					<ui-segment attach="both">
						<ui-form>
							<form>
								<ui-fields widths="2">
									<ui-field>
										<label for="message-attached-first">First Name</label>
										<ui-input id="message-attached-first" placeholder="First Name"></ui-input>
									</ui-field>
									<ui-field>
										<label for="message-attached-last">Last Name</label>
										<ui-input id="message-attached-last" placeholder="Last Name"></ui-input>
									</ui-field>
								</ui-fields>
								<ui-field>
									<label for="message-attached-user">Username</label>
									<ui-input id="message-attached-user" placeholder="Username"></ui-input>
								</ui-field>
								<ui-field>
									<label for="message-attached-password">Password</label>
									<ui-input id="message-attached-password" type="password"></ui-input>
								</ui-field>
								<ui-field inline>
									<ui-checkbox name="terms">I agree to the terms and conditions</ui-checkbox>
								</ui-field>
								<ui-button color="blue" type="submit">Submit</ui-button>
							</form>
						</ui-form>
					</ui-segment>
				</html>
				<message attach="bottom" state="warning" icon="help"><html>Already signed up? <a href="#login">Login here</a> instead.</html></message>
			</example>
		</>

		<section label="Warning" sticky="stack" collapsible dividing>
			<example description="A message may be formatted to display warning messages:  `state=\"warning\"`.">
				<message state="warning" dismissible heading="You must register before you can do that!">Visit our registration page, then try again</message>
			</example>
		</>

		<section label="Info" sticky="stack" collapsible dividing>
			<example description="A message may be formatted to display information.">
				<html>
					<ui-message state="info" dismissible heading="Was this what you wanted?">
						<ul>
							<li>It's good to see you again.</li>
							<li>Did you know it's been a while?</li>
						</ul>
					</ui-message>
				</html>
			</example>
		</>

		<section label="Positive / Success" sticky collapsible dividing>
			<example description="A message may be formatted to display a positive message.">
				<message slot="description" state="info" size="small" icon="attention">Positive / success and negative / error messages use the same colours by default, but each has its own colour token that a theme can tell apart.</message>
				<html>
					<ui-message state="positive" dismissible heading="You are eligible for a reward">
						<p>Go to your <b>special offers</b> page to see now.</p>
					</ui-message>
				</html>
			</example>
			<example>
				<html>
					<ui-message state="success" dismissible heading="Your user registration was successful.">
						<p>You may now log-in with the username you have chosen</p>
					</ui-message>
				</html>
			</example>
		</>

		<section label="Negative / Error" sticky="stack" collapsible dividing>
			<example description="A message may be formatted to display a negative message.">
				<html>
					<ui-message state="negative" dismissible heading="We're sorry we can't apply that discount">
						<p>That offer has expired</p>
					</ui-message>
				</html>
			</example>
			<example>
				<html>
					<ui-message state="error" dismissible heading="There were some errors with your submission">
						<ul>
							<li>You must include both a upper and lower case letters in your password.</li>
							<li>You need to select your home country.</li>
						</ul>
					</ui-message>
				</html>
			</example>
		</>

		<section label="Colored" sticky="stack" collapsible dividing>
			<example description="A message can be formatted to be different colors.">
				<message color="red">Red</message>
				<message color="orange">Orange</message>
				<message color="yellow">Yellow</message>
				<message color="olive">Olive</message>
				<message color="green">Green</message>
				<message color="teal">Teal</message>
				<message color="blue">Blue</message>
				<message color="violet">Violet</message>
				<message color="purple">Purple</message>
				<message color="pink">Pink</message>
				<message color="brown">Brown</message>
				<message color="black">Black</message>
			</example>
		</>

		<section label="Size" sticky="stack" collapsible dividing>
			<example description="A message can have different sizes.">
				<message size="mini">This is a mini message.</message>
				<message size="tiny">This is a tiny message.</message>
				<message size="small">This is a small message.</message>
				<message size="large">This is large</message>
				<message size="big">This is big</message>
				<message size="huge">This is huge</message>
				<message size="massive">This is massive</message>
			</example>
		</>

		<section label="Inverted" sticky="stack" collapsible dividing>
			<example description="A message can use the dark scheme;  a coloured one keeps its hue in the text.">
				<html>
					<ui-message inverted heading="Inverted">
						<p>The dark scheme.</p>
					</ui-message>
					<ui-message color="red" inverted heading="Inverted red">
						<p>Keeps its hue in the text.</p>
					</ui-message>
					<ui-message state="positive" inverted icon="envelope" heading="Inverted positive">
						<p>With an icon.</p>
					</ui-message>
				</html>
			</example>
		</>
	</>
</spell-notebook>
