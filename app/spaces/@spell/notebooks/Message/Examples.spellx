<spell-notebook "message examples">
	<header level="1">
		Message
		<header>A message displays information that explains nearby content.</>
	</>
	<message-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#content">Content</>
			<item link="#states">States</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's message page, section by section, in its order (Types, States, Variations), plus our own
		extras (Content, Centered, Inverted).  A slotted `<ui-header>` styles itself for the message it sits in;  the
		`heading` attribute is the shorthand.
	-->
	<section label="Types">
		<section label="Message" sticky="stack" collapsible dividing>
			<example "Message" description="A basic message.">
				<message>
					<header>Changes in Service</header>
					<text paragraph>We just updated our privacy policy here to better service our customers. We recommend reviewing the changes.</text>
				</message>
			</example>
		</>

		<section label="List Message" sticky="stack" collapsible dividing>
			<example "List Message" description="A message with a list.  `heading` is the shorthand for a header.">
				<message heading="New Site Features">
					<list bulleted>
						<item>You can now have cover images on blog pages</item>
						<item>Drafts will now auto-save while writing</item>
					</list>
				</message>
			</example>
		</>

		<section label="Icon Message" sticky="stack" collapsible dividing>
			<example "Icon Message" description="A message can contain an icon:  the `icon` attribute takes a name, the `icon` slot any markup.">
				<message icon="inbox" heading="Have you heard about our mailing list?">
					<text paragraph>Get the best news in your e-mail every day.</text>
				</message>
			</example>
			<example "Icon Message">
				<message heading="Just one second">
					<icon slot="icon" name="circle notch" loading/>
					<text paragraph>We're fetching that content for you.</text>
				</message>
			</example>
		</>

		<section label="Dismissable Block" sticky="stack" collapsible dividing>
			<example "Dismissable Block" description="A message that the user can choose to hide: `dismissible` adds a close button.">
				<message slot="description" state="info" size="small">Unlike Fomantic's, the close button works by itself: it fires the cancelable <text code>ui-closing</text>, then the message sets <text code>hidden</text> on itself (see the Usage tab). Reload the page to bring it back.</message>
				<message dismissible heading="Welcome back!">
					<text paragraph>This is a special notification which you can dismiss if you're bored with it.</text>
				</message>
			</example>
		</>
	</>

	<section label="Content">
		<section label="Header" sticky="stack" collapsible dividing>
			<example "Header" description="A message can contain a header:  a slotted `<ui-header>`.">
				<message>
					<header>Email Confirmed</header>
					<text paragraph>You're all signed up for the newsletter</text>
				</message>
			</example>
		</>

		<section label="List" sticky="stack" collapsible dividing>
			<example "List" description="A message can contain a list of items:  a plain `<ul>`.">
				<message>
					<list bulleted>
						<item>No header, just a list</item>
						<item>It is a list of items</item>
					</list>
				</message>
			</example>
		</>
	</>

	<section label="States">
		<section label="Hidden" sticky="stack" collapsible dividing>
			<example "Hidden" description="A message can be hidden:  the standard `hidden` attribute.  The message below is in the example, unseen.">
				<message hidden>
					<text paragraph>You can't see me</text>
				</message>
			</example>
		</>

		<section label="Visible" sticky="stack" collapsible dividing>
			<example "Visible" description="A message can be set to visible to force itself to be shown.">
				<message size="small" slot="description" class="site-not-ported">Not ported: the <text code>visible</text> class -- a message without <text code>hidden</text> is always shown.</message>
				<message>
					<text paragraph>You can always see me</text>
				</message>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Center Aligned" sticky="stack" collapsible dividing>
			<example "Center Aligned" description="A message can be displayed center aligned:  `text-align=\"center\"`.">
				<message align="center" heading="New Version is available!">
					<text paragraph>When are you going to update?</text>
				</message>
			</example>
		</>

		<section label="Right Aligned" sticky="stack" collapsible dividing>
			<example "Right Aligned" description="A message can be displayed right aligned:  `text-align=\"right\"`.">
				<message align="right" heading="New Version is available!">
					<text paragraph>When are you going to update?</text>
				</message>
			</example>
		</>

		<section label="Centered" sticky="stack" collapsible dividing>
			<example "Centered" description="`centered` centres the text and an icon together with the content;  `align` aligns the text alone.">
				<message centered icon="envelope" heading="Centered icon">
					<text paragraph>Icon and content centred together.</text>
				</message>
			</example>
		</>

		<section label="Floating" sticky="stack" collapsible dividing>
			<example "Floating" description="A message can float above content that it is related to.">
				<message floating>
					<text paragraph>Way to go!</text>
				</message>
			</example>
		</>

		<section label="Compact" sticky="stack" collapsible dividing>
			<example "Compact" description="A message can only take up the width of its content.">
				<message padding="compact">
					<text paragraph>Get all the best inventions in your e-mail every day. Sign up now!</text>
				</message>
			</example>
		</>

		<section label="Attached" sticky="stack" collapsible dividing>
			<example "Attached" description="A message can be formatted to attach itself to other content:  `attach=\"both\"` or `attach=\"top\"` joins the content below, `attach=\"bottom\"` the content above.">
				<message attach="both" heading="Welcome to our site!">
					<text paragraph>Fill out the form below to sign-up for a new account</text>
				</message>
				<segment attach="both">
					<form>
						<fields widths="2">
							<field label="First Name">
								<input id="message-attached-first" placeholder="First Name"/>
							</field>
							<field label="Last Name">
								<input id="message-attached-last" placeholder="Last Name"/>
							</field>
						</fields>
						<field label="Username">
							<input id="message-attached-user" placeholder="Username"/>
						</field>
						<field label="Password">
							<input id="message-attached-password" type="password"/>
						</field>
						<field inline>
							<checkbox name="terms">I agree to the terms and conditions</checkbox>
						</field>
						<button color="blue" type="submit">Submit</button>
					</form>
				</segment>
				<message attach="bottom" state="warning" icon="help">Already signed up? <link link="#login">Login here</link> instead.</message>
			</example>
		</>

		<section label="Warning" sticky="stack" collapsible dividing>
			<example "Warning" description="A message may be formatted to display warning messages:  `state=\"warning\"`.">
				<message state="warning" dismissible heading="You must register before you can do that!">Visit our registration page, then try again</message>
			</example>
		</>

		<section label="Info" sticky="stack" collapsible dividing>
			<example "Info" description="A message may be formatted to display information.">
				<message state="info" dismissible heading="Was this what you wanted?">
					<list bulleted>
						<item>It's good to see you again.</item>
						<item>Did you know it's been a while?</item>
					</list>
				</message>
			</example>
		</>

		<section label="Positive / Success" sticky collapsible dividing>
			<example "Positive / Success" description="A message may be formatted to display a positive message.">
				<message slot="description" state="info" size="small" icon="attention">Positive / success and negative / error messages use the same colours by default, but each has its own colour token that a theme can tell apart.</message>
				<message state="positive" dismissible heading="You are eligible for a reward">
					<text paragraph>Go to your <text bold>special offers</text> page to see now.</text>
				</message>
			</example>
			<example "Positive / Success">
				<message state="success" dismissible heading="Your user registration was successful.">
					<text paragraph>You may now log-in with the username you have chosen</text>
				</message>
			</example>
		</>

		<section label="Negative / Error" sticky="stack" collapsible dividing>
			<example "Negative / Error" description="A message may be formatted to display a negative message.">
				<message state="negative" dismissible heading="We're sorry we can't apply that discount">
					<text paragraph>That offer has expired</text>
				</message>
			</example>
			<example "Negative / Error">
				<message state="error" dismissible heading="There were some errors with your submission">
					<list bulleted>
						<item>You must include both a upper and lower case letters in your password.</item>
						<item>You need to select your home country.</item>
					</list>
				</message>
			</example>
		</>

		<section label="Colored" sticky="stack" collapsible dividing>
			<example "Colored" description="A message can be formatted to be different colors.">
				<message color="red">Red</message>
				<message color="orange">Orange</message>
				<message color="yellow">Yellow</message>
				<message color="olive">Olive</message>
				<message color="green">Green</message>
				<message color="teal">Teal</message>
				<message color="blue">Blue</message>
				<message color="violet">Violet</message>
				<message color="purple">Purple</message>
				<message color="pink">Pink</message>
				<message color="brown">Brown</message>
				<message color="black">Black</message>
			</example>
		</>

		<section label="Size" sticky="stack" collapsible dividing>
			<example "Size" description="A message can have different sizes.">
				<message size="mini">This is a mini message.</message>
				<message size="tiny">This is a tiny message.</message>
				<message size="small">This is a small message.</message>
				<message size="large">This is large</message>
				<message size="big">This is big</message>
				<message size="huge">This is huge</message>
				<message size="massive">This is massive</message>
			</example>
		</>

		<section label="Inverted" sticky="stack" collapsible dividing>
			<example "Inverted" description="A message can use the dark scheme;  a coloured one keeps its hue in the text.">
				<message inverted heading="Inverted">
					<text paragraph>The dark scheme.</text>
				</message>
				<message color="red" inverted heading="Inverted red">
					<text paragraph>Keeps its hue in the text.</text>
				</message>
				<message state="positive" inverted icon="envelope" heading="Inverted positive">
					<text paragraph>With an icon.</text>
				</message>
			</example>
		</>
	</>
</spell-notebook>
