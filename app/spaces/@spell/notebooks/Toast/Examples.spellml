<spell-notebook "toast examples">
	<header level="1">
		Toast
		<header>A toast allows users to receive a short, non-blocking notification.</>
	</>
	<toast-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#variations">Variations</>
			<item link="#actions">Actions</>
			<item link="#examples">Examples</>
			<item link="#create-from-dom">Create from DOM</>
			<item link="#interaction">Interaction</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's page, section by section, in its order (Types, Content, States, Variations,
		Groups ...).  Rules, the class-grammar mappings, gaps:  packages/docs/content/epics/spell-ui-pages/PAGES.md.
		- A section:  `<ui-header level="2" dividing id="types">Types</ui-header>`, then its examples.
		- An example:  `<ui-example heading="..." description="...">` around the live markup;  the markup
		  IS the code shown.  A richer description:  `<p slot="description">` (+ `<ui-message slot="description">`).
		- A gap:  an HTML comment `GAP I<n>:  ...` BEFORE the example (a comment inside it shows in its code).
	-->
	<message size="small" state="info">
		<markdown>
			Two ways to show a toast: `UI.toast({...})` stacks one in a corner of the screen and closes it after
			its display time (Fomantic's `$.toast()`, same settings), and a `<ui-toast>` written in the page
			shows where it is. Each example's **Show** button runs the `UI.toast()` call in its code; the
			header-less examples after it are the same toast as an element.
		</>
	</>

	<section label="Types">
		<section label="Minimal" sticky="stack" collapsible dividing>
			<example "Minimal" description="A minimal toast will just display a message.">
				<button onClick={notify "I am a toast, nice to meet you!"}>Show</button>
			</example>
			<example "Minimal" description="A `<ui-toast>` in the page shows where it is, and stays until clicked.">
				<toast message="I am a toast, nice to meet you!"/>
			</example>
		</>

		<section label="Titled" sticky="stack" collapsible dividing>
			<example "Titled" description="You can add a title to your toast.">
				<button onClick={notify "Hey look, I have a title!" titled "Better?"}>Show</button>
			</example>
			<example "Titled">
				<toast heading="Better?" message="Hey look, I have a title!"/>
			</example>
		</>

		<section label="Progress Bar" sticky="stack" collapsible dividing>
			<example "Progress Bar" description="You can attach a progress bar to your toast.">
				<button onClick={notify "See, how long I will last" titled "LOOK" with a progress bar}>Show</button>
			</example>
		</>

		<!-- GAP I117:  no colour of the progress bar's own (Fomantic's `classProgress`). -->
		<message size="small" class="site-not-ported">Not yet: the progress bar's own colour (Fomantic's <text code>classProgress: 'red'</>) -- it takes the toast's colour; restyle it with <text code>ui-toast::part(bar)</>.</>
	</>

	<section label="Variations">
		<section label="Toast Type" sticky="stack" collapsible dividing>
			<example "Toast Type" description="A toast can be used to display different types of information:  `type` (`class` in `UI.toast()`).">
				<button color="positive" onClick={notify success "You're using the good framework!"}>Success</button>
				<button color="negative" onClick={notify error "An error occurred!"}>Error</button>
				<button color="yellow" onClick={notify warning "Behind you!"}>Warning</button>
			</example>
			<example "Toast Type" description="A bare `icon` shows the type's own icon;  an `error` toast is announced at once (`role=alert`).">
				<toast type="info" icon message="An info toast, with its icon."/>
				<toast type="success" icon message="You're using the good framework!"/>
				<toast type="warning" icon message="Behind you!"/>
				<toast type="error" icon message="An error occurred!"/>
			</example>
		</>

		<section label="Position" sticky="stack" collapsible dividing>
			<example "Position" description="A toast can appear at different positions on the screen.">
				<button onClick={notify "Look, I'm here!" at the top left}>Top left</button>
				<button onClick={notify "Look, I'm here!" at the top center}>Top center</button>
				<button onClick={notify "Look, I'm here!" at the top right}>Top right</button>
				<button onClick={notify "Look, I'm here!" in the center}>Centered</button>
				<button onClick={notify "Look, I'm here!" at the bottom left}>Bottom left</button>
				<button onClick={notify "Look, I'm here!" at the bottom center}>Bottom center</button>
				<button onClick={notify "Look, I'm here!" at the bottom right}>Bottom right</button>
			</example>
		</>
		<message size="small" class="site-not-ported">Not ported: Attached Position (the top attached and bottom attached positions, full-width toasts like a phone's notifications) and Center Aligned content (the center aligned class). Both are left out of the toast sheets on purpose.</>

		<section label="Direction" sticky="stack" collapsible dividing>
			<example "Direction" description="Toasts can stack horizontally:  `horizontal: true`.">
				<button onClick={notify "Next one will open to the right" at the top left side by side}>Show</button>
			</example>
		</>

		<section label="Duration" sticky="stack" collapsible dividing>
			<example "Duration" description="You can choose how long a toast should be displayed, in milliseconds:  `displayTime`, or `display-time` on the element. `0` keeps it until it's clicked, and `auto` calculates the time from the number of words (120 a minute, at least a second).">
				<button onClick={notify "You will see me for 5 seconds." for 5 seconds}>5 seconds</button>
				<button onClick={notify "I'll stay here until you click on me!" until clicked}>Until clicked</button>
				<button onClick={notify "The display time of this toast is calculated by its amount of containing words." with a progress bar at the top}>Auto</button>
			</example>
		</>
		<message size="small" class="site-not-ported">Not ported: Use Message Style (<text code>className: &#123; toast: 'ui message' &#125;</>) -- a toast is a <text code>&lt;ui-toast&gt;</>; slot a message's content into one instead.</>

		<section label="Increasing Progress Bar" sticky collapsible dividing>
			<example "Increasing Progress Bar" description="The progress bar can be raised instead of lowered:  `progressUp` (`progress-up`).">
				<button onClick={notify "See, how long I will last" titled "LOOK" with a progress bar filling up at the top}>Show</button>
			</example>
		</>

		<section label="Color Variants" sticky="stack" collapsible dividing>
			<example "Color Variants" description="You can use all of the usual color names.">
				<button color="red" size="mini" onClick={notify "I am a colorful toast" in red with a progress bar}>Red</button>
				<button color="orange" size="mini" onClick={notify "I am a colorful toast" in orange with a progress bar}>Orange</button>
				<button color="yellow" size="mini" onClick={notify "I am a colorful toast" in yellow with a progress bar}>Yellow</button>
				<button color="olive" size="mini" onClick={notify "I am a colorful toast" in olive with a progress bar}>Olive</button>
				<button color="green" size="mini" onClick={notify "I am a colorful toast" in green with a progress bar}>Green</button>
				<button color="teal" size="mini" onClick={notify "I am a colorful toast" in teal with a progress bar}>Teal</button>
				<button color="blue" size="mini" onClick={notify "I am a colorful toast" in blue with a progress bar}>Blue</button>
				<button color="violet" size="mini" onClick={notify "I am a colorful toast" in violet with a progress bar}>Violet</button>
				<button color="purple" size="mini" onClick={notify "I am a colorful toast" in purple with a progress bar}>Purple</button>
				<button color="pink" size="mini" onClick={notify "I am a colorful toast" in pink with a progress bar}>Pink</button>
				<button color="brown" size="mini" onClick={notify "I am a colorful toast" in brown with a progress bar}>Brown</button>
				<button color="grey" size="mini" onClick={notify "I am a colorful toast" in grey with a progress bar}>Grey</button>
				<button color="black" size="mini" onClick={notify "I am a colorful toast" in black with a progress bar}>Black</button>
			</example>
			<example "Color Variants">
				<toast color="red" message="I am a colorful toast"/>
				<toast color="teal" message="I am a colorful toast"/>
				<toast color="purple" message="I am a colorful toast"/>
			</example>
		</>

		<section label="Inverted Colors" sticky="stack" collapsible dividing>
			<example "Inverted Colors" description="Same as above, just add `inverted`:  a plain toast turns dark, a coloured one takes the hue's inverted variant.">
				<button color="red" size="mini" onClick={notify "I am an inverted colorful toast" in inverted red with a progress bar}>Red</button>
				<button color="orange" size="mini" onClick={notify "I am an inverted colorful toast" in inverted orange with a progress bar}>Orange</button>
				<button color="yellow" size="mini" onClick={notify "I am an inverted colorful toast" in inverted yellow with a progress bar}>Yellow</button>
				<button color="olive" size="mini" onClick={notify "I am an inverted colorful toast" in inverted olive with a progress bar}>Olive</button>
				<button color="green" size="mini" onClick={notify "I am an inverted colorful toast" in inverted green with a progress bar}>Green</button>
				<button color="teal" size="mini" onClick={notify "I am an inverted colorful toast" in inverted teal with a progress bar}>Teal</button>
				<button color="blue" size="mini" onClick={notify "I am an inverted colorful toast" in inverted blue with a progress bar}>Blue</button>
				<button color="violet" size="mini" onClick={notify "I am an inverted colorful toast" in inverted violet with a progress bar}>Violet</button>
				<button color="purple" size="mini" onClick={notify "I am an inverted colorful toast" in inverted purple with a progress bar}>Purple</button>
				<button color="pink" size="mini" onClick={notify "I am an inverted colorful toast" in inverted pink with a progress bar}>Pink</button>
				<button color="brown" size="mini" onClick={notify "I am an inverted colorful toast" in inverted brown with a progress bar}>Brown</button>
				<button color="grey" size="mini" onClick={notify "I am an inverted colorful toast" in inverted grey with a progress bar}>Grey</button>
				<button color="black" size="mini" onClick={notify "I am an inverted colorful toast" in inverted black with a progress bar}>Black</button>
			</example>
			<example "Inverted Colors">
				<toast inverted message="A dark toast."/>
				<toast inverted color="purple" message="I am an inverted colorful toast"/>
			</example>
		</>

		<section label="Not compact" sticky="stack" collapsible dividing>
			<example "Not compact" description="A toast is 350px wide by default;  `compact=\"false\"` sizes it to its content.">
				<toast compact="false" message="As wide as my text."/>
			</example>
		</>
	</>

	<section label="Actions">
		<section label="General" sticky="stack" collapsible dividing>
			<example "General" description="Define click actions on your toast with a text and/or icon, optional class and click handler.">
				<button onClick={notify "Do you really want to star Fomantic-UI?" in black with "Yes"}>Show</button>
				<message slot="description" size="small">The default click handler closes the toast, so leave it out when the button should only close it;  a handler returning <text code>false</text> keeps the toast open. In the page, put <text code>&lt;ui-button slot="actions"&gt;</text>s in the toast: any activated one closes it unless its click was <text code>preventDefault()</text>ed.</message>
			</example>
			<example "General">
				<toast color="black" message="Do you really want to star Fomantic-UI?">
					<button slot="actions" color="green" icon="check">Yes</button>
					<button slot="actions" color="red" icon="ban" aria-label="No"/>
					<button slot="actions" color="blue">?</button>
				</toast>
			</example>
		</>

		<section label="Basic" sticky="stack" collapsible dividing>
			<example "Basic" description="`basic` actions don't lighten the actions' background;  `left` aligns the buttons to the left (`classActions` in `UI.toast()`, `actions` on the element).">
				<toast color="black" actions="basic left" message="Do you really want to star Fomantic-UI?">
					<button slot="actions" color="yellow">Yes, really</button>
				</toast>
			</example>
		</>

		<!-- GAP I118:  no `centered` actions (Fomantic's `classActions: 'centered'`);  shown right-aligned. -->
		<section label="Centered" sticky="stack" collapsible dividing>
			<example "Centered" description="The action buttons can also be shown centered.">
				<toast color="black" message="Do you really want to star Fomantic-UI?">
					<button slot="actions" color="yellow">Yes, really</button>
				</toast>
			</example>
		</>

		<!-- GAP I121:  the attached group sits inset in a light frame, not flush with the toast. -->
		<section label="Attached" sticky="stack" collapsible dividing>
			<example "Attached" description="`attached` turns the actions into a button group joined below the toast;  `attached top` joins it above.">
				<toast color="black" actions="attached top" message="Do you really want to star Fomantic-UI?">
					<buttons slot="actions" fluid>
						<button color="green">Yes, really</button>
						<button color="red">Maybe later</button>
					</buttons>
				</toast>
				<toast color="black" actions="attached" message="Do you really want to star Fomantic-UI?">
					<buttons slot="actions" fluid>
						<button color="green">Yes, really</button>
						<button color="red">Maybe later</button>
					</buttons>
				</toast>
			</example>
		</>

		<section label="Vertical" sticky="stack" collapsible dividing>
			<example "Vertical" description="`vertical` displays the actions to the right of the toast.">
				<toast color="black" actions="vertical" message="Do you really want to star Fomantic-UI?">
					<button slot="actions" color="green">Yes, really</button>
					<button slot="actions" color="red">Maybe later</button>
				</toast>
			</example>
		</>

		<section label="Vertical attached" sticky collapsible dividing>
			<example "Vertical attached" description="Vertical actions can also be a button group:  `vertical attached`, which also supports `left`.">
				<toast color="black" actions="left vertical attached" message="Do you really want to star Fomantic-UI?">
					<buttons slot="actions" direction="vertical">
						<button color="green">Yes, really</button>
						<button color="red">Maybe later</button>
					</buttons>
				</toast>
			</example>
		</>
	</>

	<section label="Examples">
		<section label="Without icon" sticky="stack" collapsible dividing>
			<example "Without icon" description="A toast shows no icon unless you ask for one (Fomantic's `showIcon: false`):  bare `icon` shows the type's own.">
				<toast type="warning" message="Hey, where is my icon?"/>
			</example>
		</>

		<section label="Individual icon" sticky="stack" collapsible dividing>
			<example "Individual icon" description="Use whatever icon you like:  `icon=\"microphone\"`.">
				<toast type="info" icon="microphone" message="Listen to me"/>
			</example>
		</>
		<message size="small" class="site-not-ported">Not ported: Image toasts (<text code>showImage</>, <text code>classImage</>), left out of the toast sheet on purpose. Slot an <text code>&lt;ui-image avatar&gt;</> into the content instead.</>

		<section label="Close Icon" sticky="stack" collapsible dividing>
			<example "Close Icon" description="You can force the user to click a close icon instead of clicking anywhere on the toast to close it:  `closable` (`closeIcon`).">
				<toast type="info" closable message="Click on the X to close me"/>
			</example>
		</>
		<message size="small" class="site-not-ported">Not ported: the close icon on the left (<text code>closeIcon: 'left'</>) -- left out of the toast sheet on purpose.</>

		<!-- GAP I119:  no transition settings (Fomantic's `transition: { showMethod, hideMethod ... }`);  every toast scales. -->
		<message size="small" class="site-not-ported">Not yet: Transitions (<text code>transition: &#123; showMethod: 'zoom', hideMethod: 'fade' ... &#125;</>) -- every toast scales in and out, timed by <text code>--ui-toast-duration</>.</>
	</>

	<section label="Create from DOM">
		<section label="Toast" sticky="stack" collapsible dividing>
			<example "Toast" description="A toast can be made from markup:  a `<ui-toast>` in the page, with rich content in its slot.">
				<toast heading="DOM toast" icon="info">A Toast can be generated out of existing DOM nodes, with <text bold>any markup</text> inside.</toast>
			</example>
		</>

		<section label="Approve / Deny Callbacks" sticky collapsible dividing>
			<example "Approve / Deny Callbacks" description="Just like a modal, a toast ties approve / deny to any positive / approve, negative / deny or ok / cancel button, with the cancelable `ui-approving` and `ui-denying`. Calling `preventDefault()` on one keeps it open.">
				<toast display-time="0" message="Want to close this DOM toast?" on-ui-approving={notify "Approved"}>
					<button slot="actions" color="positive">Yes</button>
					<button slot="actions" color="negative">No</button>
				</toast>
			</example>
		</>
		<message size="small" class="site-not-ported">Not ported: Template, Message and Card toasts (<text code>$('.ui.message').toast()</>) -- a toast is a <text code>&lt;ui-toast&gt;</>; slot the content you'd have put in a message or card into one.</>
	</>

	<section label="Interaction">
		<section label="Prevent pausing" sticky collapsible dividing>
			<example "Prevent pausing" description="Hovering over a toast pauses its countdown;  `pauseOnHover: false` (`pause-on-hover=\"false\"`) keeps it running.  Focus inside always pauses it.">
				<button onClick={notify "This toast does not pause when you hover on it" with a progress bar at the top without pausing}>Show</button>
			</example>
		</>

		<section label="Prevent closing" sticky collapsible dividing>
			<example "Prevent closing" description="A click on a toast closes it;  `closeOnClick: false` (`close-on-click=\"false\"`) doesn't.">
				<toast close-on-click="false" closable message="Clicking me does nothing;  use the X."/>
			</example>
		</>

		<section label="Access created toast" sticky collapsible dividing>
			<example "Access created toast" description="Each `UI.toast()` call returns a handle, and `UI.toasts.dismiss(id)` closes it early. The handle's `closed` resolves when the toast is gone, and its `element` is the toast itself.">
				<toast-gone-in-a-second/>
			</example>
		</>

		<section label="Close with a command" sticky collapsible dividing>
			<example "Close with a command" description="A button with `command=\"--close\"` dismisses the toast named by `commandfor`, no script.">
				<toast id="toast-invoker" type="success" icon closable message="Saved your changes"/>
				<button commandfor="toast-invoker" command="--close">Dismiss it</button>
			</example>
		</>
	</>
</spell-notebook>

<!-- Interaction › Access created toast:  a toast, waited for until it's gone, then another -->
<spell-view "gone in a second">
	<action "show the toasts" description="A toast that goes after a second;  once it's gone, a toast saying so">
		notify "I'll be gone in a second" for 1 second and wait
		notify "The first toast is gone"
	</action>
	<draw>
		<button onClick={show the toasts}>Show, then close it after a second</button>
	</draw>
</spell-view>
