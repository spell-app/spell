<spell-notebook "sidebar api">
	<header level="1">
		Sidebar
		<header>A sidebar hides additional content beside a page.</>
	</>
	<sidebar-tab-bar showing="api"/>
	<section>
		<html>
			<ui-menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
				<ui-item link="#tags">Tags</>
				<ui-item link="#attributes">Attributes</>
				<ui-item link="#events">Events</>
				<ui-item link="#slots">Slots</>
				<ui-item link="#parts">Parts</>
				<ui-item link="#states">States</>
				<ui-item link="#texts">Texts</>
			</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`docs/__data/components.json5`);  nothing to write. -->
	<section label="Tags">
		<html>
			<ui-docs-api family="ui-sidebar" only="tags"></>
		</>
	</>

	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-sidebar" only="attributes"></>
		</>
	</>

	<section label="Events">
		<html>
			<ui-docs-api family="ui-sidebar" only="events"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api family="ui-sidebar" only="slots"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-sidebar" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-sidebar" only="states"></>
		</>
	</>

	<section label="Texts">
		<html>
			<ui-docs-api family="ui-sidebar" only="texts"></>
		</>
	</>
</spell-notebook>
