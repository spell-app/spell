<spell-notebook "comment examples">
	<header level="1">
		Comment
		<header>A comment displays user feedback to site content.</>
	</>
	<comment-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#content">Content</>
			<item link="#states">States</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's comment page, section by section, in its order (Types, Content, States, Variations), plus
		our own extra (No avatar).  Fomantic's `<a class="reply">` actions are real `<button>`s in `<ui-actions>`;  its
		`.metadata` / `.text` are `<ui-meta>` / `<ui-description>`.  Every reply form posts nowhere (`method="dialog"`).
	-->
	<section label="Types">
		<section label="Comments" sticky="stack" collapsible dividing>
			<example description="A basic list of comments: a `<ui-comments>` inside a comment is its thread of replies, and the `reply` slot takes a reply form.">
				<message slot="description" state="warning" size="small"><html><b>UI Views</b> provide structured layouts, but do not hook up site specific code. You will need to add your own JavaScript behaviors to hide and show the appropriate forms, for example a reply button opening a reply form.</html></message>
				<html>
					<ui-comments>
						<ui-header level="3" dividing>Comments</ui-header>
						<ui-comment>
							<ui-avatar src="/components/ui/images/avatar/small/matt.jpg"></ui-avatar>
							<ui-content>
								<ui-author link="#">Matt</ui-author>
								<ui-meta>
									<span>Today at 5:42PM</span>
								</ui-meta>
								<ui-description>How artistic!</ui-description>
								<ui-actions>
									<button type="button">Reply</button>
								</ui-actions>
							</ui-content>
						</ui-comment>
						<ui-comment>
							<ui-avatar src="/components/ui/images/avatar/small/elliot.jpg"></ui-avatar>
							<ui-content>
								<ui-author link="#">Elliot Fu</ui-author>
								<ui-meta>
									<span>Yesterday at 12:30AM</span>
								</ui-meta>
								<ui-description>
									<p>This has been very useful for my research. Thanks as well!</p>
								</ui-description>
								<ui-actions>
									<button type="button">Reply</button>
								</ui-actions>
							</ui-content>
							<ui-comments>
								<ui-comment>
									<ui-avatar src="/components/ui/images/avatar/small/jenny.jpg"></ui-avatar>
									<ui-content>
										<ui-author link="#">Jenny Hess</ui-author>
										<ui-meta>
											<span>Just now</span>
										</ui-meta>
										<ui-description>Elliot you are always so right :)</ui-description>
										<ui-actions>
											<button type="button">Reply</button>
										</ui-actions>
									</ui-content>
								</ui-comment>
							</ui-comments>
						</ui-comment>
						<ui-comment>
							<ui-avatar src="/components/ui/images/avatar/small/joe.jpg"></ui-avatar>
							<ui-content>
								<ui-author link="#">Joe Henderson</ui-author>
								<ui-meta>
									<span>5 days ago</span>
								</ui-meta>
								<ui-description>Dude, this is awesome. Thanks so much</ui-description>
								<ui-actions>
									<button type="button">Reply</button>
								</ui-actions>
							</ui-content>
						</ui-comment>
						<ui-form slot="reply">
							<form method="dialog">
								<ui-field>
									<ui-textarea aria-label="Reply"></ui-textarea>
								</ui-field>
								<ui-button color="blue" labeled icon="pen to square" type="submit">Add Reply</ui-button>
							</form>
						</ui-form>
					</ui-comments>
				</html>
			</example>
		</>
	</>

	<section label="Content">
		<section label="Avatar" sticky="stack" collapsible dividing>
			<example description="A comment can contain an image or avatar:  `<ui-avatar src>`.">
				<comments>
					<comment>
						<avatar src="/components/ui/images/avatar/small/elliot.jpg"/>
						<content>
							<author link="#">Elliot Fu</author>
						</content>
					</comment>
				</comments>
			</example>
		</>

		<section label="Metadata" sticky="stack" collapsible dividing>
			<example description="A comment can contain metadata about the comment, an arbitrary amount of metadata may be defined:  each child of `<ui-meta>` is one piece.">
				<html>
					<ui-comments>
						<ui-comment>
							<ui-avatar src="/components/ui/images/avatar/small/stevie.jpg"></ui-avatar>
							<ui-content>
								<ui-author link="#">Stevie Feliciano</ui-author>
								<ui-meta>
									<span>2 days ago</span>
									<span><ui-icon name="star"></ui-icon> 5 Faves</span>
								</ui-meta>
								<ui-description>Hey guys, I hope this example comment is helping you read this documentation.</ui-description>
							</ui-content>
						</ui-comment>
					</ui-comments>
				</html>
			</example>
		</>

		<section label="Actions" sticky="stack" collapsible dividing>
			<example description="A comment can contain a list of actions a user may perform related to this comment:  `<button>`s (or links, to go somewhere) in `<ui-actions>`.">
				<html>
					<ui-comments>
						<ui-comment>
							<ui-avatar src="/components/ui/images/avatar/small/joe.jpg"></ui-avatar>
							<ui-content>
								<ui-author link="#">Tom Lukic</ui-author>
								<ui-description>This will be great for business reports. I will definitely download this.</ui-description>
								<ui-actions>
									<button type="button">Reply</button>
									<button type="button">Save</button>
									<button type="button">Hide</button>
									<button type="button"><ui-icon name="expand"></ui-icon> Full-screen</button>
								</ui-actions>
							</ui-content>
						</ui-comment>
					</ui-comments>
				</html>
			</example>
		</>

		<!-- GAP I35:  a comment's `reply` slot sits below the whole comment, not beside the avatar. -->
		<section label="Reply Form" sticky="stack" collapsible dividing>
			<example description="A comment can contain a form to reply to a comment. This may have arbitrary content.">
				<message slot="description" state="info" size="small"><html>A form in a <code>&lt;ui-comment&gt;</code>'s <code>reply</code> slot is a nested reply to that comment. One in the <code>&lt;ui-comments&gt;</code> list's reply slot, after every comment, is a normal reply form.</html></message>
				<html>
					<ui-comments>
						<ui-comment>
							<ui-avatar src="/components/ui/images/avatar/small/steve.jpg"></ui-avatar>
							<ui-content>
								<ui-author link="#">Steve Jobes</ui-author>
								<ui-meta>
									<span>2 days ago</span>
								</ui-meta>
								<ui-description>Revolutionary!</ui-description>
								<ui-actions>
									<button type="button" class="active">Reply</button>
								</ui-actions>
							</ui-content>
							<ui-form slot="reply">
								<form method="dialog">
									<ui-field>
										<ui-textarea aria-label="Reply"></ui-textarea>
									</ui-field>
									<ui-button labeled icon="pen to square" type="submit" color="primary">Add Reply</ui-button>
								</form>
							</ui-form>
						</ui-comment>
					</ui-comments>
				</html>
			</example>
			<example>
				<html>
					<ui-comments>
						<ui-comment>
							<ui-avatar src="/components/ui/images/avatar/small/joe.jpg"></ui-avatar>
							<ui-content>
								<ui-author link="#">Joe Henderson</ui-author>
								<ui-meta>
									<span>1 day ago</span>
								</ui-meta>
								<ui-description>
									<p>The hours, minutes and seconds stand as visible reminders that your effort put them all there.</p>
									<p>Preserve until your next run, when the watch lets you see how Impermanent your efforts are.</p>
								</ui-description>
								<ui-actions>
									<button type="button">Reply</button>
								</ui-actions>
							</ui-content>
						</ui-comment>
						<ui-comment>
							<ui-avatar src="/components/ui/images/avatar/small/christian.jpg"></ui-avatar>
							<ui-content>
								<ui-author link="#">Christian Rocha</ui-author>
								<ui-meta>
									<span>2 days ago</span>
								</ui-meta>
								<ui-description>I re-tweeted this.</ui-description>
								<ui-actions>
									<button type="button">Reply</button>
								</ui-actions>
							</ui-content>
						</ui-comment>
						<ui-form slot="reply">
							<form method="dialog">
								<ui-field>
									<ui-textarea aria-label="Reply"></ui-textarea>
								</ui-field>
								<ui-button labeled icon="pen to square" type="submit" color="primary">Add Comment</ui-button>
							</form>
						</ui-form>
					</ui-comments>
				</html>
			</example>
		</>

		<section label="No avatar" sticky="stack" collapsible dividing>
			<example description="A comment can leave out its avatar;  the content then starts at the edge.">
				<html>
					<ui-comments>
						<ui-comment>
							<ui-content>
								<ui-author link="#">Jenny Hess</ui-author>
								<ui-meta>
									<span>Just now</span>
								</ui-meta>
								<ui-description>Elliot you are always so right :)</ui-description>
								<ui-actions>
									<button type="button">Reply</button>
								</ui-actions>
							</ui-content>
						</ui-comment>
					</ui-comments>
				</html>
			</example>
		</>
	</>

	<section label="States">
		<section label="Collapsed" sticky="stack" collapsible dividing>
			<example description="Comments can be collapsed, or hidden from view:  `collapsed` folds away a thread of replies, one comment or a whole list.  Here Christian's thread is folded.">
				<html>
					<ui-comments>
						<ui-comment>
							<ui-avatar src="/components/ui/images/avatar/small/christian.jpg"></ui-avatar>
							<ui-content>
								<ui-author link="#">Christian Rocha</ui-author>
								<ui-meta>
									<span>2 days ago</span>
								</ui-meta>
								<ui-description>I'm very interested in this motherboard. Do you know if it'd work in a Intel LGA775 CPU socket?</ui-description>
								<ui-actions>
									<button type="button">Reply</button>
								</ui-actions>
							</ui-content>
							<ui-comments collapsed>
								<ui-comment>
									<ui-avatar src="/components/ui/images/avatar/small/elliot.jpg"></ui-avatar>
									<ui-content>
										<ui-author link="#">Elliot Fu</ui-author>
										<ui-meta>
											<span>1 day ago</span>
										</ui-meta>
										<ui-description>No, it wont</ui-description>
										<ui-actions>
											<button type="button">Reply</button>
										</ui-actions>
									</ui-content>
									<ui-comments>
										<ui-comment>
											<ui-avatar src="/components/ui/images/avatar/small/jenny.jpg"></ui-avatar>
											<ui-content>
												<ui-author link="#">Jenny Hess</ui-author>
												<ui-meta>
													<span>20 minutes ago</span>
												</ui-meta>
												<ui-description>Maybe it would.</ui-description>
												<ui-actions>
													<button type="button">Reply</button>
												</ui-actions>
											</ui-content>
										</ui-comment>
									</ui-comments>
								</ui-comment>
							</ui-comments>
						</ui-comment>
					</ui-comments>
				</html>
			</example>
		</>

		<section label="Disabled" sticky="stack" collapsible dividing>
			<example description="A comment can be disabled.">
				<html>
					<ui-comments>
						<ui-comment disabled>
							<ui-avatar src="/components/ui/images/avatar/small/elliot.jpg"></ui-avatar>
							<ui-content>
								<ui-author link="#">Elliot Fu</ui-author>
								<ui-meta>
									<span>1 day ago</span>
								</ui-meta>
								<ui-description>No, it wont</ui-description>
								<ui-actions>
									<button type="button">Reply</button>
								</ui-actions>
							</ui-content>
						</ui-comment>
					</ui-comments>
				</html>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Threaded" sticky="stack" collapsible dividing>
			<example description="A comment list can be threaded to show the relationship between conversations.">
				<html>
					<ui-comments threaded>
						<ui-header level="3" dividing>Comments</ui-header>
						<ui-comment>
							<ui-avatar src="/components/ui/images/avatar/small/matt.jpg"></ui-avatar>
							<ui-content>
								<ui-author link="#">Matt</ui-author>
								<ui-meta>
									<span>Today at 5:42PM</span>
								</ui-meta>
								<ui-description>How artistic!</ui-description>
								<ui-actions>
									<button type="button">Reply</button>
								</ui-actions>
							</ui-content>
						</ui-comment>
						<ui-comment>
							<ui-avatar src="/components/ui/images/avatar/small/elliot.jpg"></ui-avatar>
							<ui-content>
								<ui-author link="#">Elliot Fu</ui-author>
								<ui-meta>
									<span>Yesterday at 12:30AM</span>
								</ui-meta>
								<ui-description>
									<p>This has been very useful for my research. Thanks as well!</p>
								</ui-description>
								<ui-actions>
									<button type="button">Reply</button>
								</ui-actions>
							</ui-content>
							<ui-comments>
								<ui-comment>
									<ui-avatar src="/components/ui/images/avatar/small/jenny.jpg"></ui-avatar>
									<ui-content>
										<ui-author link="#">Jenny Hess</ui-author>
										<ui-meta>
											<span>Just now</span>
										</ui-meta>
										<ui-description>Elliot you are always so right :)</ui-description>
										<ui-actions>
											<button type="button">Reply</button>
										</ui-actions>
									</ui-content>
								</ui-comment>
							</ui-comments>
						</ui-comment>
						<ui-comment>
							<ui-avatar src="/components/ui/images/avatar/small/joe.jpg"></ui-avatar>
							<ui-content>
								<ui-author link="#">Joe Henderson</ui-author>
								<ui-meta>
									<span>5 days ago</span>
								</ui-meta>
								<ui-description>Dude, this is awesome. Thanks so much</ui-description>
								<ui-actions>
									<button type="button">Reply</button>
								</ui-actions>
							</ui-content>
						</ui-comment>
						<ui-form slot="reply">
							<form method="dialog">
								<ui-field>
									<ui-textarea aria-label="Reply"></ui-textarea>
								</ui-field>
								<ui-button color="blue" labeled icon="pen to square" type="submit">Add Reply</ui-button>
							</form>
						</ui-form>
					</ui-comments>
				</html>
			</example>
		</>

		<section label="Minimal" sticky="stack" collapsible dividing>
			<example description="Comments can hide extra information unless a user shows intent to interact with a comment:  the actions show while a comment is hovered or holds keyboard focus.">
				<html>
					<ui-comments appearance="minimal">
						<ui-header level="3" dividing>Comments</ui-header>
						<ui-comment>
							<ui-avatar src="/components/ui/images/avatar/small/matt.jpg"></ui-avatar>
							<ui-content>
								<ui-author link="#">Matt</ui-author>
								<ui-meta>
									<span>Today at 5:42PM</span>
								</ui-meta>
								<ui-description>How artistic!</ui-description>
								<ui-actions>
									<button type="button">Reply</button>
								</ui-actions>
							</ui-content>
						</ui-comment>
						<ui-comment>
							<ui-avatar src="/components/ui/images/avatar/small/elliot.jpg"></ui-avatar>
							<ui-content>
								<ui-author link="#">Elliot Fu</ui-author>
								<ui-meta>
									<span>Yesterday at 12:30AM</span>
								</ui-meta>
								<ui-description>
