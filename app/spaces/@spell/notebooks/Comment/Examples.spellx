					</ui-comments>
				</html>
			</example>
		</>

		<section label="Inverted" sticky="stack" collapsible dividing>
			<example description="Comments' colors can be inverted.">
				<html>
					<ui-segment inverted>
						<ui-comments inverted threaded>
							<ui-header level="3" inverted dividing>Comments</ui-header>
							<ui-comment>
								<ui-avatar src="/components/ui/images/avatar/small/matt.jpg"></ui-avatar>
								<ui-content>
									<ui-author link="#">Matt</ui-author>
									<ui-meta>
										<span>Today at 5:42PM</span>
									</ui-meta>
									<ui-description>How artistic!</ui-description>
									<ui-actions>
										<button type="button">Reply</button>
									</ui-actions>
								</ui-content>
							</ui-comment>
							<ui-comment>
								<ui-avatar src="/components/ui/images/avatar/small/elliot.jpg"></ui-avatar>
								<ui-content>
									<ui-author link="#">Elliot Fu</ui-author>
									<ui-meta>
										<span>Yesterday at 12:30AM</span>
									</ui-meta>
									<ui-description>
										<p>This has been very useful for my research. Thanks as well!</p>
									</ui-description>
									<ui-actions>
										<button type="button">Reply</button>
									</ui-actions>
								</ui-content>
								<ui-comments>
									<ui-comment>
										<ui-avatar src="/components/ui/images/avatar/small/jenny.jpg"></ui-avatar>
										<ui-content>
											<ui-author link="#">Jenny Hess</ui-author>
											<ui-meta>
												<span>Just now</span>
											</ui-meta>
											<ui-description>Elliot you are always so right :)</ui-description>
											<ui-actions>
												<button type="button">Reply</button>
											</ui-actions>
										</ui-content>
									</ui-comment>
								</ui-comments>
							</ui-comment>
							<ui-comment>
								<ui-avatar src="/components/ui/images/avatar/small/joe.jpg"></ui-avatar>
								<ui-content>
									<ui-author link="#">Joe Henderson</ui-author>
									<ui-meta>
										<span>5 days ago</span>
									</ui-meta>
									<ui-description>Dude, this is awesome. Thanks so much</ui-description>
									<ui-actions>
