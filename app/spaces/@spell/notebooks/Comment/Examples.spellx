									</ui-actions>
								</ui-content>
							</ui-comment>
							<ui-form slot="reply">
								<form method="dialog">
									<ui-field>
										<ui-textarea aria-label="Reply"></ui-textarea>
									</ui-field>
									<ui-button color="blue" labeled icon="pen to square" type="submit">Add Reply</ui-button>
								</form>
							</ui-form>
						</ui-comments>
					</ui-segment>
				</html>
			</example>
		</>
	</>
</spell-notebook>
