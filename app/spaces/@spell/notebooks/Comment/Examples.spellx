			<example>
				<html>
					<ui-comments size="large">
						<ui-header level="3" dividing>Comments</ui-header>
						<ui-comment>
							<ui-avatar src="/components/ui/images/avatar/small/matt.jpg"></ui-avatar>
							<ui-content>
								<ui-author link="#">Matt</ui-author>
