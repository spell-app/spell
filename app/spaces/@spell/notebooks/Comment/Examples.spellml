<spell-notebook "comment examples">
	<header level="1">
		Comment
		<header>A comment displays user feedback to site content.</>
	</>
	<comment-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#content">Content</>
			<item link="#states">States</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's comment page, section by section, in its order (Types, Content, States, Variations), plus
		our own extra (No avatar).  Fomantic's `<a class="reply">` actions are real `<button>`s in `<ui-actions>`;  its
		`.metadata` / `.text` are `<ui-meta>` / `<ui-description>`.  Every reply form posts nowhere (`method="dialog"`).
	-->
	<section label="Types">
		<section label="Comments" sticky="stack" collapsible dividing>
			<example "Comments" description="A basic list of comments: a `<ui-comments>` inside a comment is its thread of replies, and the `reply` slot takes a reply form.">
				<comments>
					<header level="3" dividing>Comments</header>
					<comment>
						<avatar src="/components/ui/images/avatar/small/matt.jpg"/>
						<content>
							<author link="#">Matt</author>
							<meta>
								<text>Today at 5:42PM</text>
							</meta>
							<description>How artistic!</description>
							<actions>
								<button type="button">Reply</button>
							</actions>
						</content>
					</comment>
					<comment>
						<avatar src="/components/ui/images/avatar/small/elliot.jpg"/>
						<content>
							<author link="#">Elliot Fu</author>
							<meta>
								<text>Yesterday at 12:30AM</text>
							</meta>
							<description>
								<text paragraph>This has been very useful for my research. Thanks as well!</text>
							</description>
							<actions>
								<button type="button">Reply</button>
							</actions>
						</content>
						<comments>
							<comment>
								<avatar src="/components/ui/images/avatar/small/jenny.jpg"/>
								<content>
									<author link="#">Jenny Hess</author>
									<meta>
										<text>Just now</text>
									</meta>
									<description>Elliot you are always so right :)</description>
									<actions>
										<button type="button">Reply</button>
									</actions>
								</content>
							</comment>
						</comments>
					</comment>
					<comment>
						<avatar src="/components/ui/images/avatar/small/joe.jpg"/>
						<content>
							<author link="#">Joe Henderson</author>
							<meta>
								<text>5 days ago</text>
							</meta>
							<description>Dude, this is awesome. Thanks so much</description>
							<actions>
								<button type="button">Reply</button>
							</actions>
						</content>
					</comment>
					<form slot="reply">
						<field>
							<textarea aria-label="Reply"/>
						</field>
						<button color="blue" labeled icon="pen to square" type="submit">Add Reply</button>
					</form>
				</comments>
				<message slot="description" state="warning" size="small"><text bold>UI Views</text> provide structured layouts, but do not hook up site specific code. You will need to add your own JavaScript behaviors to hide and show the appropriate forms, for example a reply button opening a reply form.</message>
			</example>
		</>
	</>

	<section label="Content">
		<section label="Avatar" sticky="stack" collapsible dividing>
			<example "Avatar" description="A comment can contain an image or avatar:  `<ui-avatar src>`.">
				<comments>
					<comment>
						<avatar src="/components/ui/images/avatar/small/elliot.jpg"/>
						<content>
							<author link="#">Elliot Fu</author>
						</content>
					</comment>
				</comments>
			</example>
		</>

		<section label="Metadata" sticky="stack" collapsible dividing>
			<example "Metadata" description="A comment can contain metadata about the comment, an arbitrary amount of metadata may be defined:  each child of `<ui-meta>` is one piece.">
				<comments>
					<comment>
						<avatar src="/components/ui/images/avatar/small/stevie.jpg"/>
						<content>
							<author link="#">Stevie Feliciano</author>
							<meta>
								<text>2 days ago</text>
								<text><icon name="star"/> 5 Faves</text>
							</meta>
							<description>Hey guys, I hope this example comment is helping you read this documentation.</description>
						</content>
					</comment>
				</comments>
			</example>
		</>

		<section label="Actions" sticky="stack" collapsible dividing>
			<example "Actions" description="A comment can contain a list of actions a user may perform related to this comment:  `<button>`s (or links, to go somewhere) in `<ui-actions>`.">
				<comments>
					<comment>
						<avatar src="/components/ui/images/avatar/small/joe.jpg"/>
						<content>
							<author link="#">Tom Lukic</author>
							<description>This will be great for business reports. I will definitely download this.</description>
							<actions>
								<button type="button">Reply</button>
								<button type="button">Save</button>
								<button type="button">Hide</button>
								<button type="button"><icon name="expand"/> Full-screen</button>
							</actions>
						</content>
					</comment>
				</comments>
			</example>
		</>

		<!-- GAP I35:  a comment's `reply` slot sits below the whole comment, not beside the avatar. -->
		<section label="Reply Form" sticky="stack" collapsible dividing>
			<example "Reply Form" description="A comment can contain a form to reply to a comment. This may have arbitrary content.">
				<comments>
					<comment>
						<avatar src="/components/ui/images/avatar/small/steve.jpg"/>
						<content>
							<author link="#">Steve Jobes</author>
							<meta>
								<text>2 days ago</text>
							</meta>
							<description>Revolutionary!</description>
							<actions>
								<button class="active" type="button">Reply</button>
							</actions>
						</content>
						<form slot="reply">
							<field>
								<textarea aria-label="Reply"/>
							</field>
							<button labeled icon="pen to square" type="submit" color="primary">Add Reply</button>
						</form>
					</comment>
				</comments>
				<message slot="description" state="info" size="small">A form in a <text code>&lt;ui-comment&gt;</text>'s <text code>reply</text> slot is a nested reply to that comment. One in the <text code>&lt;ui-comments&gt;</text> list's reply slot, after every comment, is a normal reply form.</message>
			</example>
			<example "Reply Form">
				<comments>
					<comment>
						<avatar src="/components/ui/images/avatar/small/joe.jpg"/>
						<content>
							<author link="#">Joe Henderson</author>
							<meta>
								<text>1 day ago</text>
							</meta>
							<description>
								<text paragraph>The hours, minutes and seconds stand as visible reminders that your effort put them all there.</text>
								<text paragraph>Preserve until your next run, when the watch lets you see how Impermanent your efforts are.</text>
							</description>
							<actions>
								<button type="button">Reply</button>
							</actions>
						</content>
					</comment>
					<comment>
						<avatar src="/components/ui/images/avatar/small/christian.jpg"/>
						<content>
							<author link="#">Christian Rocha</author>
							<meta>
								<text>2 days ago</text>
							</meta>
							<description>I re-tweeted this.</description>
							<actions>
								<button type="button">Reply</button>
							</actions>
						</content>
					</comment>
					<form slot="reply">
						<field>
							<textarea aria-label="Reply"/>
						</field>
						<button labeled icon="pen to square" type="submit" color="primary">Add Comment</button>
					</form>
				</comments>
			</example>
		</>

		<section label="No avatar" sticky="stack" collapsible dividing>
			<example "No avatar" description="A comment can leave out its avatar;  the content then starts at the edge.">
				<comments>
					<comment>
						<content>
							<author link="#">Jenny Hess</author>
							<meta>
								<text>Just now</text>
							</meta>
							<description>Elliot you are always so right :)</description>
							<actions>
								<button type="button">Reply</button>
							</actions>
						</content>
					</comment>
				</comments>
			</example>
		</>
	</>

	<section label="States">
		<section label="Collapsed" sticky="stack" collapsible dividing>
			<example "Collapsed" description="Comments can be collapsed, or hidden from view:  `collapsed` folds away a thread of replies, one comment or a whole list.  Here Christian's thread is folded.">
				<comments>
					<comment>
						<avatar src="/components/ui/images/avatar/small/christian.jpg"/>
						<content>
							<author link="#">Christian Rocha</author>
							<meta>
								<text>2 days ago</text>
							</meta>
							<description>I'm very interested in this motherboard. Do you know if it'd work in a Intel LGA775 CPU socket?</description>
							<actions>
								<button type="button">Reply</button>
							</actions>
						</content>
						<comments collapsed>
							<comment>
								<avatar src="/components/ui/images/avatar/small/elliot.jpg"/>
								<content>
									<author link="#">Elliot Fu</author>
									<meta>
										<text>1 day ago</text>
									</meta>
									<description>No, it wont</description>
									<actions>
										<button type="button">Reply</button>
									</actions>
								</content>
								<comments>
									<comment>
										<avatar src="/components/ui/images/avatar/small/jenny.jpg"/>
										<content>
											<author link="#">Jenny Hess</author>
											<meta>
												<text>20 minutes ago</text>
											</meta>
											<description>Maybe it would.</description>
											<actions>
												<button type="button">Reply</button>
											</actions>
										</content>
									</comment>
								</comments>
							</comment>
						</comments>
					</comment>
				</comments>
			</example>
		</>

		<section label="Disabled" sticky="stack" collapsible dividing>
			<example "Disabled" description="A comment can be disabled.">
				<comments>
					<comment disabled>
						<avatar src="/components/ui/images/avatar/small/elliot.jpg"/>
						<content>
							<author link="#">Elliot Fu</author>
							<meta>
								<text>1 day ago</text>
							</meta>
							<description>No, it wont</description>
							<actions>
								<button type="button">Reply</button>
							</actions>
						</content>
					</comment>
				</comments>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Threaded" sticky="stack" collapsible dividing>
			<example "Threaded" description="A comment list can be threaded to show the relationship between conversations.">
