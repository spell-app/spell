							<meta>
								<text>Yesterday at 12:30AM</text>
							</meta>
							<description>
								<text paragraph>This has been very useful for my research. Thanks as well!</text>
							</description>
							<actions>
								<button type="button">Reply</button>
							</actions>
						</content>
						<comments>
							<comment>
								<avatar src="/components/ui/images/avatar/small/jenny.jpg"/>
								<content>
									<author link="#">Jenny Hess</author>
									<meta>
										<text>Just now</text>
									</meta>
									<description>Elliot you are always so right :)</description>
									<actions>
										<button type="button">Reply</button>
									</actions>
								</content>
							</comment>
						</comments>
					</comment>
					<comment>
						<avatar src="/components/ui/images/avatar/small/joe.jpg"/>
						<content>
							<author link="#">Joe Henderson</author>
							<meta>
								<text>5 days ago</text>
							</meta>
							<description>Dude, this is awesome. Thanks so much</description>
							<actions>
								<button type="button">Reply</button>
							</actions>
						</content>
					</comment>
					<form slot="reply">
						<field>
							<textarea aria-label="Reply"/>
						</field>
						<button color="blue" labeled icon="pen to square" type="submit">Add Reply</button>
					</form>
				</comments>
			</example>
		</>

		<section label="Minimal" sticky="stack" collapsible dividing>
			<example "Minimal" description="Comments can hide extra information unless a user shows intent to interact with a comment:  the actions show while a comment is hovered or holds keyboard focus.">
