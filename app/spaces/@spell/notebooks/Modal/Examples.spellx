<spell-notebook "modal examples">
	<header level="1">
		Modal
		<header>A modal displays content that temporarily blocks interactions with the main view of a
              site.</>
	</>
	<modal-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#content">Content</>
			<item link="#variations">Variations</>
			<item link="#states">States</>
			<item link="#behaviour">Behaviour</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's modal page, section by section, in its order (Types, Content, Variations, States), then its
		Examples tab (Behaviour).  Every modal opens from a button through an invoker command (`commandfor` +
		`command="--show"`):  no script.  Never `visible` on load:  it would block the page.
		`GAP I<n>` comments mark examples a widget can't render yet (plan-doc issues).
	-->
	<section label="Types">
		<!-- GAP I56:  `<ui-image size="medium">` is the natural size, not 300px, so the image crowds the description. -->
		<section label="Modal" sticky="stack" collapsible dividing>
			<example description="A standard modal:  a header, image content and actions.  The approve / deny buttons close it.">
				<button commandfor="modal-types-standard" command="--show">Show</button>
				<html>
					<ui-modal id="modal-types-standard" closable>
						<ui-header>Profile Picture</ui-header>
						<ui-content image>
							<ui-image size="medium" src="/components/ui/images/avatar/large/chris.jpg" alt=""></ui-image>
							<ui-description>
								<ui-header>We've auto-chosen a profile image for you.</ui-header>
								<p>We've grabbed the following image from the <a href="https://www.gravatar.com" target="_blank">gravatar</a> image associated with your registered e-mail address.</p>
								<p>Is it okay to use this photo?</p>
							</ui-description>
						</ui-content>
						<ui-actions>
							<ui-button class="deny" color="black">Nope</ui-button>
							<ui-button class="approve" labeled="right" icon="checkmark" color="positive">Yep, that's me</ui-button>
						</ui-actions>
					</ui-modal>
				</html>
			</example>
		</>

		<section label="Basic" sticky="stack" collapsible dividing>
			<example description="A modal can reduce its complexity:  no box, light text straight on the dimmer.">
				<button commandfor="modal-types-basic" command="--show">Show basic</button>
				<html>
					<ui-modal id="modal-types-basic" appearance="basic" size="small">
						<ui-header icon><ui-icon name="archive"></ui-icon> Archive Old Messages</ui-header>
						<ui-content>
							<p>Your inbox is getting full, would you like us to enable automatic archiving of old messages?</p>
						</ui-content>
						<ui-actions>
							<ui-button class="cancel" color="red" inverted icon="remove" appearance="basic">No</ui-button>
							<ui-button class="ok" color="green" inverted icon="checkmark">Yes</ui-button>
						</ui-actions>
					</ui-modal>
				</html>
			</example>
		</>
	</>

	<section label="Content">
		<section label="Header" sticky="stack" collapsible dividing>
			<example description="A modal can have a header:  a slotted `<ui-header>`, or the `header` shorthand.">
				<button commandfor="modal-content-header" command="--show">Show</button>
				<modal id="modal-content-header" heading="Header" closable/>
			</example>
		</>

		<section label="Content" sticky="stack" collapsible dividing>
			<example description="A modal can contain content:  a slotted `<ui-content>`, or the `content` shorthand for a block of text.">
				<button commandfor="modal-content-content" command="--show">Show</button>
				<html>
					<ui-modal id="modal-content-content" closable>
						<ui-header>Header</ui-header>
						<ui-content>
							<p>A first paragraph of content.</p>
							<p>A second one.</p>
							<p>And a third.</p>
						</ui-content>
					</ui-modal>
				</html>
			</example>
		</>

		<!-- GAP I56:  `<ui-image size="medium">` is the natural size, not 300px, so the image crowds the description. -->
		<section label="Image Content" sticky="stack" collapsible dividing>
			<example description="A modal can contain image content:  `<ui-content image>` puts an image beside the description.">
				<button commandfor="modal-content-image" command="--show">Show</button>
				<html>
					<ui-modal id="modal-content-image" heading="Select a Photo" closable>
						<ui-content image>
							<ui-image size="medium" src="/components/ui/images/avatar/large/elliot.jpg" alt=""></ui-image>
							<ui-description>
								<ui-header>Default Profile Image</ui-header>
								<p>We've found the following gravatar image associated with your e-mail address.</p>
							</ui-description>
						</ui-content>
						<ui-actions>
							<ui-button class="approve" color="primary">Use it</ui-button>
						</ui-actions>
					</ui-modal>
				</html>
			</example>
		</>

		<section label="Actions" sticky="stack" collapsible dividing>
			<example description="A modal can contain a row of actions: `<ui-actions>`.">
				<html>
					<ui-message slot="description" size="small" state="info">Buttons anywhere inside act by Fomantic's classes: <ul><li>approve:  <code>approve</code> / <code>ok</code> / <code>positive</code>, or <code>&lt;ui-button color="positive"&gt;</code></li> <li>deny:  <code>deny</code> / <code>cancel</code> / <code>negative</code>, or <code>&lt;ui-button color="negative"&gt;</code></li></ul> Each fires the cancelable <code>ui-approving</code> / <code>ui-denying</code>, then closes the modal.</ui-message>
				</html>
				<message slot="description" size="small" state="warning"><html>To keep a modal open after an action, call <code>preventDefault()</code> on its approve or deny event. That's Fomantic's callback returning <code>false</code>.</html></message>
				<button commandfor="modal-content-actions" command="--show">Show</button>
				<html>
					<ui-modal id="modal-content-actions" heading="Header">
						<ui-content>
							<p>Three actions: approve, a neutral one that does nothing, and cancel.</p>
						</ui-content>
						<ui-actions>
							<ui-button class="approve">Approve</ui-button>
							<ui-button>Neutral</ui-button>
							<ui-button class="cancel">Cancel</ui-button>
						</ui-actions>
					</ui-modal>
				</html>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Full Screen" sticky="stack" collapsible dividing>
			<example description="A modal can use the entire size of the screen.">
				<button commandfor="modal-variations-full" command="--show">Show</button>
				<modal id="modal-variations-full" fullscreen heading="Full screen" content="Nearly as wide as the screen." closable/>
			</example>
		</>

		<section label="Overlay Full Screen" sticky collapsible dividing>
			<example description="A modal can overlay the entire screen: `overlay fullscreen`.">
				<message slot="description" size="small" state="info"><html>An overlay fullscreen modal hides the dimmer, so a click on it can't close the modal: give it a close icon (<code>closable</code>) or an action button.</html></message>
				<button commandfor="modal-variations-overlay" command="--show">Show</button>
				<modal id="modal-variations-overlay" overlay fullscreen heading="Overlay full screen" content="Edge to edge." closable/>
			</example>
		</>

		<section label="Size" sticky="stack" collapsible dividing>
			<example description="A modal can vary in size.  Sizes are widths:  ratios of the default width;  the text does not scale.">
				<button commandfor="modal-variations-mini" command="--show">Mini</button>
				<button commandfor="modal-variations-tiny" command="--show">Tiny</button>
				<button commandfor="modal-variations-small" command="--show">Small</button>
				<button commandfor="modal-variations-large" command="--show">Large</button>
				<modal id="modal-variations-mini" size="mini" heading="Mini" content="A mini modal." closable/>
				<modal id="modal-variations-tiny" size="tiny" heading="Tiny" content="A tiny modal." closable/>
				<modal id="modal-variations-small" size="small" heading="Small" content="A small modal." closable/>
				<modal id="modal-variations-large" size="large" heading="Large" content="A large modal." closable/>
			</example>
		</>

		<section label="Inverted" sticky="stack" collapsible dividing>
			<example description="A modal can be shown inverted: the dark scheme.">
				<message slot="description" size="small" class="site-not-ported"><html>Not ported: Fomantic's <code>inverted: true</code> setting (a white dimmer). The dimmer is the dialog's <code>::backdrop</code>:  colour it with <code>--ui-modal-dimmer-background</code> (Theming tab).</html></message>
				<button commandfor="modal-variations-inverted" command="--show">Show</button>
				<html>
					<ui-modal id="modal-variations-inverted" inverted size="mini" heading="Inverted" closable>
						<ui-content>
							<p>The dark scheme, on the default dimmer.</p>
						</ui-content>
						<ui-actions>
							<ui-button class="ok" inverted>OK</ui-button>
						</ui-actions>
					</ui-modal>
				</html>
			</example>
		</>

		<section label="Scrolling Content" sticky collapsible dividing>
			<example description="A modal can have a scrolling content: `<ui-content scrolling>` caps its height and scrolls.">
				<message slot="description" size="small" class="site-not-ported"><html>Not ported: <code>resizable scrolling content</code> (a native resize handle on the content).</html></message>
				<button commandfor="modal-content-scrolling" command="--show">Show terms</button>
				<html>
					<ui-modal id="modal-content-scrolling" heading="Terms" closable>
						<ui-content scrolling>
							<p>A scrolling content block caps its height and scrolls.</p>
							<p>Very long terms go here, paragraph after paragraph.</p>
							<p>And more of them, so that the block has to scroll.</p>
							<p>Clause four: the reader keeps reading.</p>
							<p>Clause five: the reader still keeps reading.</p>
							<p>Clause six: nearly there.</p>
							<p>Clause seven: almost.</p>
							<p>Clause eight: one more.</p>
							<p>Until the very end.</p>
						</ui-content>
						<ui-actions>
							<ui-button class="approve" color="primary">I agree</ui-button>
						</ui-actions>
					</ui-modal>
				</html>
			</example>
		</>

		<!-- GAP I99, I110:  no centred actions (`<ui-actions>` has no text-align), and the header ignores its text-align;  only the content centres. -->
		<section label="Center Aligned" sticky="stack" collapsible dividing>
			<example description="You can center align the header, the content or even actions individually:  `text-align=\"center\"`.">
				<button commandfor="modal-variations-center" command="--show">Show</button>
				<html>
					<ui-modal id="modal-variations-center">
						<ui-header align="center">Header is centered</ui-header>
						<ui-content align="center">
							<p>Content is centered</p>
						</ui-content>
						<ui-actions>
							<ui-button color="negative">Cancel</ui-button>
							<ui-button color="positive">OK</ui-button>
						</ui-actions>
					</ui-modal>
				</html>
			</example>
		</>

		<!-- GAP I99:  no left actions;  they stay on the right. -->
		<section label="Left Actions" sticky="stack" collapsible dividing>
			<example description="You can also place the action buttons to the left.">
				<button commandfor="modal-variations-left" command="--show">Show</button>
				<html>
					<ui-modal id="modal-variations-left" heading="Look at the Actions">
						<ui-content>
							<p>They are aligned to the left</p>
						</ui-content>
						<ui-actions>
							<ui-button color="negative">Cancel</ui-button>
							<ui-button color="positive">OK</ui-button>
						</ui-actions>
					</ui-modal>
				</html>
			</example>
		</>

		<!-- GAP I99:  no basic header or actions;  they keep their tinted backgrounds and rules. -->
		<section label="Basic Header and Actions" sticky collapsible dividing>
			<example description="Header and/or Actions can also appear on the same basic background as the content.">
				<button commandfor="modal-variations-basic-parts" command="--show">Show</button>
				<html>
					<ui-modal id="modal-variations-basic-parts">
						<ui-header>Basic Header</ui-header>
						<ui-content>
							<p>Basic Actions below</p>
						</ui-content>
						<ui-actions>
							<ui-button color="negative">Cancel</ui-button>
							<ui-button color="positive">OK</ui-button>
						</ui-actions>
					</ui-modal>
				</html>
			</example>
		</>
	</>

	<section label="States">
		<section label="Active" sticky="stack" collapsible dividing>
			<example description="An active modal is visible on the page:  `open` (it emits Fomantic's `active` class).  Writing it shows or hides the modal and fires no `ui-opening` / `ui-closing`.">
				<button commandfor="modal-states-active" command="--toggle">Toggle</button>
				<modal id="modal-states-active" size="tiny" heading="Active" content="Shown while `visible` is set." closable/>
			</example>
		</>
	</>

	<section label="Behaviour">
		<section label="Top or Bottom aligned" sticky collapsible dividing>
			<example description="A modal can be pinned near the top or bottom of the viewport instead of centred:  `vertical-align`.  Top aligned is Fomantic's `centered: false`, for content whose height changes.">
				<button commandfor="modal-behaviour-top" command="--show">Top aligned</button>
				<button commandfor="modal-behaviour-bottom" command="--show">Bottom aligned</button>
				<modal id="modal-behaviour-top" vertical-align="top" size="small" heading="Top aligned" content="Pinned near the top." closable/>
				<modal id="modal-behaviour-bottom" vertical-align="bottom" size="small" heading="Bottom aligned" content="Pinned near the bottom." closable/>
			</example>
		</>

		<section label="Scrolling Modal" sticky="stack" collapsible dividing>
			<example description="When a `scrolling` modal is taller than the browser, it scrolls inside itself, without scrolling the page below.">
				<button commandfor="modal-behaviour-long" command="--show">Show long modal</button>
				<modal id="modal-behaviour-long" scrolling closable>
					<header>Profile Picture</header>
					<content image>
						<image size="medium" src="/components/ui/images/wireframe/image.png" alt=""/>
						<description>
							<header>Default Profile Image</header>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						</description>
					</content>
					<actions>
						<button class="approve" labeled="right" icon="chevron right" color="primary">Proceed</button>
					</actions>
				</modal>
			</example>
		</>

		<section label="Multiple Modals" sticky="stack" collapsible dividing>
			<example description="A modal can open a second modal, which opens on top of the first (Fomantic's `allowMultiple: true`);  Escape closes only the topmost.">
				<button commandfor="modal-behaviour-first" command="--show">Show first</button>
				<html>
					<ui-modal id="modal-behaviour-first" heading="Modal Title" closable>
						<ui-content image>
							<ui-icon name="exclamation" size="massive"></ui-icon>
							<ui-description>
								<p>This modal opens a second one.</p>
							</ui-description>
						</ui-content>
						<ui-actions>
							<ui-button commandfor="modal-behaviour-second" command="--show" labeled="right" icon="chevron right" color="primary">Proceed</ui-button>
						</ui-actions>
					</ui-modal>
					<ui-modal id="modal-behaviour-second" size="small" heading="Modal Title" closable>
						<ui-content image>
							<ui-icon name="exclamation" size="huge"></ui-icon>
							<ui-description>
								<p>That's everything!</p>
							</ui-description>
						</ui-content>
						<ui-actions>
							<ui-button class="approve" icon="checkmark">All Done</ui-button>
						</ui-actions>
					</ui-modal>
				</html>
			</example>
		</>

		<section label="Forcing a Choice" sticky collapsible dividing>
			<example description="A modal can refuse to close from the dimmer or Escape, to force a user to make a choice:  `closedby=\"none\"`.">
				<button commandfor="modal-behaviour-none" command="--show">Show</button>
				<html>
					<ui-modal id="modal-behaviour-none" closedby="none" appearance="basic" size="small">
						<ui-header icon><ui-icon name="archive"></ui-icon> Archive Old Messages</ui-header>
						<ui-content>
							<p>Escape and clicks on the dimmer do nothing here: only a button closes it.</p>
						</ui-content>
						<ui-actions>
							<ui-button class="cancel" color="red" inverted icon="remove" appearance="basic">No</ui-button>
							<ui-button class="ok" color="green" inverted icon="checkmark">Yes</ui-button>
						</ui-actions>
					</ui-modal>
				</html>
			</example>
		</>
		<message size="small" class="site-not-ported"><html>Not ported: Fomantic's dimmer variations (<code>blurring</>, <code>inverted</>), and the transition setting. Instead, set <code>--ui-modal-dimmer-filter: blur(5px) grayscale(0.7)</> or <code>--ui-modal-dimmer-background</> on the modal or above it (Theming tab).</></>
	</>
</spell-notebook>
