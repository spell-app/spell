<spell-notebook "modal examples">
	<header level="1">
		Modal
		<header>A modal displays content that temporarily blocks interactions with the main view of a
              site.</>
	</>
	<modal-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#content">Content</>
			<item link="#variations">Variations</>
			<item link="#states">States</>
			<item link="#behaviour">Behaviour</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's modal page, section by section, in its order (Types, Content, Variations, States), then its
		Examples tab (Behaviour).  Every modal opens from a button through an invoker command (`commandfor` +
		`command="--show"`):  no script.  Never `visible` on load:  it would block the page.
		`GAP I<n>` comments mark examples a widget can't render yet (plan-doc issues).
	-->
	<section label="Types">
		<!-- GAP I56:  `<ui-image size="medium">` is the natural size, not 300px, so the image crowds the description. -->
		<section label="Modal" sticky="stack" collapsible dividing>
			<example "Modal" description="A standard modal:  a header, image content and actions.  The approve / deny buttons close it.">
				<button commandfor="modal-types-standard" command="--show">Show</button>
				<modal id="modal-types-standard" closable>
					<header>Profile Picture</header>
					<content image>
						<image size="medium" src="/components/ui/images/avatar/large/chris.jpg" alt=""/>
						<description>
							<header>We've auto-chosen a profile image for you.</header>
							<text paragraph>We've grabbed the following image from the <link target="_blank" link="https://www.gravatar.com">gravatar</link> image associated with your registered e-mail address.</text>
							<text paragraph>Is it okay to use this photo?</text>
						</description>
					</content>
					<actions>
						<button class="deny" color="black">Nope</button>
						<button class="approve" labeled="right" icon="checkmark" color="positive">Yep, that's me</button>
					</actions>
				</modal>
			</example>
		</>

		<section label="Basic" sticky="stack" collapsible dividing>
			<example "Basic" description="A modal can reduce its complexity:  no box, light text straight on the dimmer.">
				<button commandfor="modal-types-basic" command="--show">Show basic</button>
				<modal id="modal-types-basic" appearance="basic" size="small">
					<header icon><icon name="archive"/> Archive Old Messages</header>
					<content>
						<text paragraph>Your inbox is getting full, would you like us to enable automatic archiving of old messages?</text>
					</content>
					<actions>
						<button class="cancel" color="red" inverted icon="remove" appearance="basic">No</button>
						<button class="ok" color="green" inverted icon="checkmark">Yes</button>
					</actions>
				</modal>
			</example>
		</>
	</>

	<section label="Content">
		<section label="Header" sticky="stack" collapsible dividing>
			<example "Header" description="A modal can have a header:  a slotted `<ui-header>`, or the `header` shorthand.">
				<button commandfor="modal-content-header" command="--show">Show</button>
				<modal id="modal-content-header" heading="Header" closable/>
			</example>
		</>

		<section label="Content" sticky="stack" collapsible dividing>
			<example "Content" description="A modal can contain content:  a slotted `<ui-content>`, or the `content` shorthand for a block of text.">
				<button commandfor="modal-content-content" command="--show">Show</button>
				<modal id="modal-content-content" closable>
					<header>Header</header>
					<content>
						<text paragraph>A first paragraph of content.</text>
						<text paragraph>A second one.</text>
						<text paragraph>And a third.</text>
					</content>
				</modal>
			</example>
		</>

		<!-- GAP I56:  `<ui-image size="medium">` is the natural size, not 300px, so the image crowds the description. -->
		<section label="Image Content" sticky="stack" collapsible dividing>
			<example "Image Content" description="A modal can contain image content:  `<ui-content image>` puts an image beside the description.">
				<button commandfor="modal-content-image" command="--show">Show</button>
				<modal id="modal-content-image" heading="Select a Photo" closable>
					<content image>
						<image size="medium" src="/components/ui/images/avatar/large/elliot.jpg" alt=""/>
						<description>
							<header>Default Profile Image</header>
							<text paragraph>We've found the following gravatar image associated with your e-mail address.</text>
						</description>
					</content>
					<actions>
						<button class="approve" color="primary">Use it</button>
					</actions>
				</modal>
			</example>
		</>

		<section label="Actions" sticky="stack" collapsible dividing>
			<example "Actions" description="A modal can contain a row of actions: `<ui-actions>`.">
				<button commandfor="modal-content-actions" command="--show">Show</button>
				<modal id="modal-content-actions" heading="Header">
					<content>
						<text paragraph>Three actions: approve, a neutral one that does nothing, and cancel.</text>
					</content>
					<actions>
						<button class="approve">Approve</button>
						<button>Neutral</button>
						<button class="cancel">Cancel</button>
					</actions>
				</modal>
				<message slot="description" size="small" state="info">Buttons anywhere inside act by Fomantic's classes: <list bulleted><item>approve:  <text code>approve</text> / <text code>ok</text> / <text code>positive</text>, or <text code>&lt;ui-button color="positive"&gt;</text></item> <item>deny:  <text code>deny</text> / <text code>cancel</text> / <text code>negative</text>, or <text code>&lt;ui-button color="negative"&gt;</text></item></list> Each fires the cancelable <text code>ui-approving</text> / <text code>ui-denying</text>, then closes the modal.</message>
				<message slot="description" size="small" state="warning">To keep a modal open after an action, call <text code>preventDefault()</text> on its approve or deny event. That's Fomantic's callback returning <text code>false</text>.</message>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Full Screen" sticky="stack" collapsible dividing>
			<example "Full Screen" description="A modal can use the entire size of the screen.">
				<button commandfor="modal-variations-full" command="--show">Show</button>
				<modal id="modal-variations-full" fullscreen heading="Full screen" content="Nearly as wide as the screen." closable/>
			</example>
		</>

		<section label="Overlay Full Screen" sticky collapsible dividing>
			<example "Overlay Full Screen" description="A modal can overlay the entire screen: `overlay fullscreen`.">
				<button commandfor="modal-variations-overlay" command="--show">Show</button>
				<modal id="modal-variations-overlay" overlay fullscreen heading="Overlay full screen" content="Edge to edge." closable/>
				<message slot="description" size="small" state="info">An overlay fullscreen modal hides the dimmer, so a click on it can't close the modal: give it a close icon (<text code>closable</text>) or an action button.</message>
			</example>
		</>

		<section label="Size" sticky="stack" collapsible dividing>
			<example "Size" description="A modal can vary in size.  Sizes are widths:  ratios of the default width;  the text does not scale.">
				<button commandfor="modal-variations-mini" command="--show">Mini</button>
				<button commandfor="modal-variations-tiny" command="--show">Tiny</button>
				<button commandfor="modal-variations-small" command="--show">Small</button>
				<button commandfor="modal-variations-large" command="--show">Large</button>
				<modal id="modal-variations-mini" size="mini" heading="Mini" content="A mini modal." closable/>
				<modal id="modal-variations-tiny" size="tiny" heading="Tiny" content="A tiny modal." closable/>
				<modal id="modal-variations-small" size="small" heading="Small" content="A small modal." closable/>
				<modal id="modal-variations-large" size="large" heading="Large" content="A large modal." closable/>
			</example>
		</>

		<section label="Inverted" sticky="stack" collapsible dividing>
			<example "Inverted" description="A modal can be shown inverted: the dark scheme.">
				<button commandfor="modal-variations-inverted" command="--show">Show</button>
				<modal id="modal-variations-inverted" inverted size="mini" heading="Inverted" closable>
					<content>
						<text paragraph>The dark scheme, on the default dimmer.</text>
					</content>
					<actions>
						<button class="ok" inverted>OK</button>
					</actions>
				</modal>
				<message slot="description" size="small" class="site-not-ported">Not ported: Fomantic's <text code>inverted: true</text> setting (a white dimmer). The dimmer is the dialog's <text code>::backdrop</text>:  colour it with <text code>--ui-modal-dimmer-background</text> (Theming tab).</message>
			</example>
		</>

		<section label="Scrolling Content" sticky collapsible dividing>
			<example "Scrolling Content" description="A modal can have a scrolling content: `<ui-content scrolling>` caps its height and scrolls.">
				<button commandfor="modal-content-scrolling" command="--show">Show terms</button>
				<modal id="modal-content-scrolling" heading="Terms" closable>
					<content scrolling>
						<text paragraph>A scrolling content block caps its height and scrolls.</text>
						<text paragraph>Very long terms go here, paragraph after paragraph.</text>
						<text paragraph>And more of them, so that the block has to scroll.</text>
						<text paragraph>Clause four: the reader keeps reading.</text>
						<text paragraph>Clause five: the reader still keeps reading.</text>
						<text paragraph>Clause six: nearly there.</text>
						<text paragraph>Clause seven: almost.</text>
						<text paragraph>Clause eight: one more.</text>
						<text paragraph>Until the very end.</text>
					</content>
					<actions>
						<button class="approve" color="primary">I agree</button>
					</actions>
				</modal>
				<message slot="description" size="small" class="site-not-ported">Not ported: <text code>resizable scrolling content</text> (a native resize handle on the content).</message>
			</example>
		</>

		<!-- GAP I99, I110:  no centred actions (`<ui-actions>` has no text-align), and the header ignores its text-align;  only the content centres. -->
		<section label="Center Aligned" sticky="stack" collapsible dividing>
			<example "Center Aligned" description="You can center align the header, the content or even actions individually:  `text-align=\"center\"`.">
				<button commandfor="modal-variations-center" command="--show">Show</button>
				<modal id="modal-variations-center">
					<header align="center">Header is centered</header>
					<content align="center">
						<text paragraph>Content is centered</text>
					</content>
					<actions>
						<button color="negative">Cancel</button>
						<button color="positive">OK</button>
					</actions>
				</modal>
			</example>
		</>

		<!-- GAP I99:  no left actions;  they stay on the right. -->
		<section label="Left Actions" sticky="stack" collapsible dividing>
			<example "Left Actions" description="You can also place the action buttons to the left.">
				<button commandfor="modal-variations-left" command="--show">Show</button>
				<modal id="modal-variations-left" heading="Look at the Actions">
					<content>
						<text paragraph>They are aligned to the left</text>
					</content>
					<actions>
						<button color="negative">Cancel</button>
						<button color="positive">OK</button>
					</actions>
				</modal>
			</example>
		</>

		<!-- GAP I99:  no basic header or actions;  they keep their tinted backgrounds and rules. -->
		<section label="Basic Header and Actions" sticky collapsible dividing>
			<example "Basic Header and Actions" description="Header and/or Actions can also appear on the same basic background as the content.">
				<button commandfor="modal-variations-basic-parts" command="--show">Show</button>
				<modal id="modal-variations-basic-parts">
					<header>Basic Header</header>
					<content>
						<text paragraph>Basic Actions below</text>
					</content>
					<actions>
						<button color="negative">Cancel</button>
						<button color="positive">OK</button>
					</actions>
				</modal>
			</example>
		</>
	</>

	<section label="States">
		<section label="Active" sticky="stack" collapsible dividing>
			<example "Active" description="An active modal is visible on the page:  `open` (it emits Fomantic's `active` class).  Writing it shows or hides the modal and fires no `ui-opening` / `ui-closing`.">
				<button commandfor="modal-states-active" command="--toggle">Toggle</button>
				<modal id="modal-states-active" size="tiny" heading="Active" content="Shown while `visible` is set." closable/>
			</example>
		</>
	</>

	<section label="Behaviour">
		<section label="Top or Bottom aligned" sticky collapsible dividing>
			<example "Top or Bottom aligned" description="A modal can be pinned near the top or bottom of the viewport instead of centred:  `vertical-align`.  Top aligned is Fomantic's `centered: false`, for content whose height changes.">
				<button commandfor="modal-behaviour-top" command="--show">Top aligned</button>
				<button commandfor="modal-behaviour-bottom" command="--show">Bottom aligned</button>
				<modal id="modal-behaviour-top" vertical-align="top" size="small" heading="Top aligned" content="Pinned near the top." closable/>
				<modal id="modal-behaviour-bottom" vertical-align="bottom" size="small" heading="Bottom aligned" content="Pinned near the bottom." closable/>
			</example>
		</>

		<section label="Scrolling Modal" sticky="stack" collapsible dividing>
			<example "Scrolling Modal" description="When a `scrolling` modal is taller than the browser, it scrolls inside itself, without scrolling the page below.">
				<button commandfor="modal-behaviour-long" command="--show">Show long modal</button>
				<modal id="modal-behaviour-long" scrolling closable>
					<header>Profile Picture</header>
					<content image>
						<image size="medium" src="/components/ui/images/wireframe/image.png" alt=""/>
						<description>
							<header>Default Profile Image</header>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						</description>
					</content>
					<actions>
						<button class="approve" labeled="right" icon="chevron right" color="primary">Proceed</button>
					</actions>
				</modal>
			</example>
		</>

		<section label="Multiple Modals" sticky="stack" collapsible dividing>
			<example "Multiple Modals" description="A modal can open a second modal, which opens on top of the first (Fomantic's `allowMultiple: true`);  Escape closes only the topmost.">
				<button commandfor="modal-behaviour-first" command="--show">Show first</button>
				<modal id="modal-behaviour-first" heading="Modal Title" closable>
					<content image>
						<icon name="exclamation" size="massive"/>
						<description>
							<text paragraph>This modal opens a second one.</text>
						</description>
					</content>
					<actions>
						<button commandfor="modal-behaviour-second" command="--show" labeled="right" icon="chevron right" color="primary">Proceed</button>
					</actions>
				</modal>
				<modal id="modal-behaviour-second" size="small" heading="Modal Title" closable>
					<content image>
						<icon name="exclamation" size="huge"/>
						<description>
							<text paragraph>That's everything!</text>
						</description>
					</content>
					<actions>
						<button class="approve" icon="checkmark">All Done</button>
					</actions>
				</modal>
			</example>
		</>

		<section label="Forcing a Choice" sticky collapsible dividing>
			<example "Forcing a Choice" description="A modal can refuse to close from the dimmer or Escape, to force a user to make a choice:  `closedby=\"none\"`.">
				<button commandfor="modal-behaviour-none" command="--show">Show</button>
				<modal id="modal-behaviour-none" closedby="none" appearance="basic" size="small">
					<header icon><icon name="archive"/> Archive Old Messages</header>
					<content>
						<text paragraph>Escape and clicks on the dimmer do nothing here: only a button closes it.</text>
					</content>
					<actions>
						<button class="cancel" color="red" inverted icon="remove" appearance="basic">No</button>
						<button class="ok" color="green" inverted icon="checkmark">Yes</button>
					</actions>
				</modal>
			</example>
		</>
		<message size="small" class="site-not-ported">Not ported: Fomantic's dimmer variations (<text code>blurring</>, <text code>inverted</>), and the transition setting. Instead, set <text code>--ui-modal-dimmer-filter: blur(5px) grayscale(0.7)</> or <text code>--ui-modal-dimmer-background</> on the modal or above it (Theming tab).</>
	</>
</spell-notebook>
