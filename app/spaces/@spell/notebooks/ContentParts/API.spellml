<spell-notebook "content-parts api">
	<header level="1">
		Content parts
		<header>Headers, content, descriptions, metas and the other generic parts that cards, items, modals and
              messages share.</>
	</>
	<content-parts-tab-bar showing="api"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#tags">Tags</>
			<item link="#attributes">Attributes</>
			<item link="#slots">Slots</>
			<item link="#parts">Parts</>
			<item link="#states">States</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`docs/__data/components.json5`);  nothing to write. -->
	<section label="Tags">
		<html>
			<ui-docs-api family="ui-parts" only="tags"></>
		</>
	</>

	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-parts" only="attributes"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api family="ui-parts" only="slots"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-parts" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-parts" only="states"></>
		</>
	</>
</spell-notebook>
