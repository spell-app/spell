<spell-notebook "panel api">
	<header level="1">
		Panel
		<header>A panel is an inspector:  a tinted box of fields under a header band, with sub-head bands that open and close.</>
	</>
	<panel-tab-bar showing="api"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#attributes">Attributes</>
			<item link="#events">Events</>
			<item link="#slots">Slots</>
			<item link="#parts">Parts</>
			<item link="#states">States</>
			<item link="#texts">Texts</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`docs/__data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-panel" only="attributes"></>
		</>
	</>

	<section label="Events">
		<html>
			<ui-docs-api family="ui-panel" only="events"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api family="ui-panel" only="slots"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-panel" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-panel" only="states"></>
		</>
	</>

	<section label="Texts">
		<html>
			<ui-docs-api family="ui-panel" only="texts"></>
		</>
	</>
</spell-notebook>
