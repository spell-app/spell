<spell-notebook "action api">
	<header level="1">
		Action
		<header>An action is a menu item or toolbar button drawn from something a program can do:  its title, icon and shortcut keys, greyed while it can't be done.</>
	</>
	<action-tab-bar showing="api"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#attributes">Attributes</>
			<item link="#properties">Properties</>
			<item link="#slots">Slots</>
			<item link="#parts">Parts</>
			<item link="#states">States</>
			<item link="#texts">Texts</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`site/_data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-action" only="attributes"></>
		</>
	</>

	<section label="Properties">
		<html>
			<ui-docs-api family="ui-action" only="properties"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api family="ui-action" only="slots"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-action" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-action" only="states"></>
		</>
	</>

	<section label="Texts">
		<html>
			<ui-docs-api family="ui-action" only="texts"></>
		</>
	</>
</spell-notebook>
