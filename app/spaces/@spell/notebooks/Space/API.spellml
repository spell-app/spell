<spell-notebook "space api">
	<header level="1">
		Space
		<header>A space is a gap between things:  a line break, a gap in a line, or the room left in a row.</>
	</>
	<space-tab-bar showing="api"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#attributes">Attributes</>
			<item link="#states">States</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`site/_data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-space" only="attributes"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-space" only="states"></>
		</>
	</>
</spell-notebook>
