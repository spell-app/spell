<spell-notebook "container api">
	<header level="1">
		Container
		<header>A container limits content to a maximum width.</>
	</>
	<container-tab-bar showing="api"/>
	<section>
		<html>
			<ui-menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
				<ui-item link="#attributes">Attributes</>
				<ui-item link="#slots">Slots</>
				<ui-item link="#parts">Parts</>
				<ui-item link="#states">States</>
			</>
		</>
	</>

	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-container" only="attributes"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api family="ui-container" only="slots"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-container" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-container" only="states"></>
		</>
	</>
</spell-notebook>
