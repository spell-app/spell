<spell-notebook "embed api">
	<header level="1">
		Embed
		<header>An embed displays content from other websites, like YouTube videos, loaded only when asked
              for.</>
	</>
	<embed-tab-bar showing="api"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#attributes">Attributes</>
			<item link="#properties">Properties</>
			<item link="#events">Events</>
			<item link="#slots">Slots</>
			<item link="#parts">Parts</>
			<item link="#states">States</>
			<item link="#texts">Texts</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`docs/__data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-embed" only="attributes"></>
		</>
	</>

	<section label="Properties">
		<html>
			<ui-docs-api family="ui-embed" only="properties"></>
		</>
	</>

	<section label="Events">
		<html>
			<ui-docs-api family="ui-embed" only="events"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api family="ui-embed" only="slots"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-embed" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-embed" only="states"></>
		</>
	</>

	<section label="Texts">
		<html>
