<spell-notebook "audio api">
	<header level="1">
		Audio
		<header>An audio plays a sound file:  in the browser's own player, or unseen, when the page says.</>
	</>
	<audio-tab-bar showing="api"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#attributes">Attributes</>
			<item link="#events">Events</>
			<item link="#parts">Parts</>
			<item link="#states">States</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`site/_data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api tag="ui-audio" only="attributes"></>
		</>
	</>

	<section label="Events">
		<html>
			<ui-docs-api tag="ui-audio" only="events"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api tag="ui-audio" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api tag="ui-audio" only="states"></>
		</>
	</>
</spell-notebook>
