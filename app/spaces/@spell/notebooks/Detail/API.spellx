<spell-notebook "detail api">
	<header level="1">
		Detail
		<header>A detail is a label's dimmer second value, such as a count.</>
	</>
	<detail-tab-bar showing="api"/>
	<section>
		<html>
			<ui-menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
				<ui-item link="#attributes">Attributes</>
				<ui-item link="#slots">Slots</>
				<ui-item link="#parts">Parts</>
				<ui-item link="#states">States</>
			</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`docs/__data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api tag="ui-detail" only="attributes"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api tag="ui-detail" only="slots"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api tag="ui-detail" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api tag="ui-detail" only="states"></>
		</>
	</>
</spell-notebook>
