<spell-notebook "icon-picker examples">
	<header level="1">
		Icon Picker
		<header>An icon picker lets people choose an icon by searching for it and clicking its glyph.</>
	</>
	<icon-picker-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#states">States</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  ours, no Fomantic page.
		- Every picker is named (`aria-label`), as a real form's would be.
	-->
	<section label="Types">
		<section label="Icon picker" sticky="stack" collapsible dividing>
			<example "Icon picker" description="Click the field:  a search box and a grid of every icon the page knows, in Font Awesome's categories.  Type to filter, by name or by what it shows (`mail` finds `envelope`), then click a glyph, or use the arrows and Enter.">
				<icon-picker value="star" aria-label="Icon"/>
			</example>
		</>

		<section label="None" sticky="stack" collapsible dividing>
			<example "None" description="With no icon chosen, the field says `none`, light and in italics;  `placeholder` says something else.  The grid's first cell, a circle with a slash, clears the choice.">
				<icon-picker aria-label="Icon"/>
				<icon-picker placeholder="Pick an icon" aria-label="Icon"/>
			</example>
		</>

		<section label="In a form" sticky="stack" collapsible dividing>
			<example "In a form" description="A form control:  it submits the icon's name under its `name`, and `required` takes the none cell out of the grid.">
				<form>
					<field label="Button icon">
						<icon-picker name="icon" value="paper plane" required/>
					</field>
				</form>
			</example>
		</>
	</>

	<section label="States">
		<section label="Read-only" sticky="stack" collapsible dividing>
			<example "Read-only" description="Shows its icon, and can be focused, but never opens.">
				<icon-picker readonly value="bell" aria-label="Icon"/>
			</example>
		</>

		<section label="Disabled" sticky="stack" collapsible dividing>
			<example "Disabled" description="Can't be used, and is left out of its form.">
				<icon-picker disabled value="bell" aria-label="Icon"/>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Size" sticky="stack" collapsible dividing>
			<example "Size" description="`size` scales the field and its panel, `mini` ... `massive`.">
				<icon-picker size="small" value="heart" aria-label="Small"/>
				<icon-picker value="heart" aria-label="Medium"/>
				<icon-picker size="large" value="heart" aria-label="Large"/>
			</example>
		</>

		<section label="Fluid" sticky="stack" collapsible dividing>
			<example "Fluid" description="`fluid` takes its container's width;  the panel is at least as wide.">
				<icon-picker fluid value="house" aria-label="Icon"/>
			</example>
		</>

		<section label="Dark" sticky="stack" collapsible dividing>
			<example "Dark" description="In a dark part of a page (`ui-dark`), the field and its panel take the dark colours.">
				<segment inverted class="ui-dark">
					<icon-picker value="moon" aria-label="Icon"/>
				</segment>
			</example>
		</>
	</>
</spell-notebook>
