<spell-notebook "icon-picker api">
	<header level="1">
		Icon Picker
		<header>An icon picker lets people choose an icon by searching for it and clicking its glyph.</>
	</>
	<icon-picker-tab-bar showing="api"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#attributes">Attributes</>
			<item link="#events">Events</>
			<item link="#parts">Parts</>
			<item link="#states">States</>
			<item link="#texts">Texts</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`site/_data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-icon-picker" only="attributes"></>
		</>
	</>

	<section label="Events">
		<html>
			<ui-docs-api family="ui-icon-picker" only="events"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-icon-picker" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-icon-picker" only="states"></>
		</>
	</>

	<section label="Texts">
		<html>
			<ui-docs-api family="ui-icon-picker" only="texts"></>
		</>
	</>
</spell-notebook>
