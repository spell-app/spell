<spell-notebook "reveal examples">
	<header level="1">
		Reveal
		<header>A reveal displays additional content in place of previous content when activated.</>
	</>
	<reveal-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#content">Content</>
			<item link="#states">States</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's reveal page, section by section, in its order (Types, Content, States, Variations), plus our
		extras (Slide, Focusable content, Visible).  Fomantic's second "States" section (Disabled) joins the first.
		- Hover a reveal, or Tab to it.  A reveal with no control of its own is a tab stop:  it gets an `aria-label`.
		- Fomantic's `ui small image` contents => `<ui-image size="small">`;  its `ui small fade reveal image` (the images
		  ARE the contents) => plain `<img width height>` in the slots.
	-->
	<section label="Types">
		<section label="Fade" sticky="stack" collapsible dividing>
			<example "Fade" description="An element can disappear to reveal content below.">
				<reveal fade aria-label="Fade demo">
					<image slot="visible" size="small" src="/components/ui/images/wireframe/square-image.png" alt=""/>
					<image slot="hidden" size="small" src="/components/ui/images/avatar/large/ade.jpg" alt="Ade"/>
				</reveal>
			</example>
			<example "Fade" description="The images can be the contents themselves.">
				<reveal fade aria-label="Fade demo, images as contents">
					<image height="150" width="150" alt="" src="/components/ui/images/wireframe/square-image.png" slot="visible"/>
					<image height="150" width="150" alt="Ade" src="/components/ui/images/avatar/large/ade.jpg" slot="hidden"/>
				</reveal>
			</example>
		</>

		<section label="Move" sticky="stack" collapsible dividing>
			<example "Move" description="An element can move in a direction to reveal content:  bare `move` moves left;  `move` also takes `right`, `up` or `down`.">
				<reveal move aria-label="Move demo">
					<image slot="visible" size="small" src="/components/ui/images/wireframe/square-image.png" alt=""/>
					<image slot="hidden" size="small" src="/components/ui/images/avatar/large/chris.jpg" alt="Chris"/>
				</reveal>
			</example>
			<example "Move">
				<reveal move="right" aria-label="Move right demo">
					<image slot="visible" size="small" src="/components/ui/images/wireframe/square-image.png" alt=""/>
					<image slot="hidden" size="small" src="/components/ui/images/avatar/large/jenny.jpg" alt="Jenny"/>
				</reveal>
			</example>
			<example "Move">
				<reveal move="up" aria-label="Move up demo">
					<image slot="visible" size="small" src="/components/ui/images/wireframe/square-image.png" alt=""/>
					<image slot="hidden" size="small" src="/components/ui/images/avatar/large/justen.jpg" alt="Justen"/>
				</reveal>
			</example>
			<example "Move">
				<reveal move="down" aria-label="Move down demo">
					<image slot="visible" size="small" src="/components/ui/images/wireframe/square-image.png" alt=""/>
					<image slot="hidden" size="small" src="/components/ui/images/avatar/large/nan.jpg" alt="Nan"/>
				</reveal>
			</example>
		</>

		<section label="Rotate" sticky="stack" collapsible dividing>
			<example "Rotate" description="An element can rotate to reveal content below:  bare `rotate` turns right, `rotate=\"left\"` turns left.">
				<reveal rotate aria-label="Rotate demo">
					<image slot="visible" size="small" src="/components/ui/images/wireframe/square-image.png" alt="" appearance="circular"/>
					<image slot="hidden" size="small" src="/components/ui/images/avatar/large/stevie.jpg" alt="Stevie" appearance="circular"/>
				</reveal>
				<message slot="description" size="small" class="site-not-ported">Not ported: Fomantic's <text code>circular reveal image</text> coupling -- the reveal has no image look of its own, so put a <text code>&lt;ui-image appearance="circular"&gt;</text> in each content.</message>
			</example>
			<example "Rotate">
				<reveal rotate="left" aria-label="Rotate left demo">
					<image slot="visible" size="small" src="/components/ui/images/wireframe/square-image.png" alt="" appearance="circular"/>
					<image slot="hidden" size="small" src="/components/ui/images/avatar/large/veronika.jpg" alt="Veronika" appearance="circular"/>
				</reveal>
			</example>
		</>

		<section label="Slide" sticky="stack" collapsible dividing>
			<example "Slide" description="Both contents can slide to swap places:  bare `slide` slides left;  `slide` also takes `right`, `up` or `down`.">
				<reveal slide aria-label="Slide demo">
					<image slot="visible" size="small" src="/components/ui/images/wireframe/square-image.png" alt=""/>
					<image slot="hidden" size="small" src="/components/ui/images/avatar/large/elliot.jpg" alt="Elliot"/>
				</reveal>
				<reveal slide="up" aria-label="Slide up demo">
					<image slot="visible" size="small" src="/components/ui/images/wireframe/square-image.png" alt=""/>
					<image slot="hidden" size="small" src="/components/ui/images/avatar/large/helen.jpg" alt="Helen"/>
				</reveal>
			</example>
		</>
	</>

	<section label="Content">
		<section label="Visible Content" sticky="stack" collapsible dividing>
			<example "Visible Content" description="A reveal may contain content that is visible before interaction: its `visible` slot.">
				<reveal fade aria-label="Visible content demo">
					<image height="150" width="150" alt="Ade" src="/components/ui/images/avatar/large/ade.jpg" slot="visible"/>
					<image height="150" width="150" alt="" src="/components/ui/images/wireframe/square-image.png" slot="hidden"/>
				</reveal>
				<message slot="description" state="info" size="small">Visible and hidden content should be the same aspect ratio.</message>
			</example>
		</>

		<section label="Hidden Content" sticky="stack" collapsible dividing>
			<example "Hidden Content" description="A reveal may contain content that is hidden before user interaction:  its `hidden` slot.">
				<reveal fade aria-label="Hidden content demo">
					<image height="150" width="150" alt="" src="/components/ui/images/wireframe/square-image.png" slot="visible"/>
					<image height="150" width="150" alt="Ade" src="/components/ui/images/avatar/large/ade.jpg" slot="hidden"/>
				</reveal>
			</example>
		</>
	</>

	<section label="States">
		<section label="Active" sticky="stack" collapsible dividing>
			<example "Active" description="An active reveal displays its hidden content.">
				<reveal active move aria-label="Active demo">
					<image slot="visible" size="small" src="/components/ui/images/wireframe/square-image.png" alt=""/>
					<image slot="hidden" size="small" src="/components/ui/images/avatar/large/nan.jpg" alt="Nan"/>
				</reveal>
				<message slot="description" state="info" size="small">Setting <text code>active</text> shows the hidden content programmatically, without hover or focus.</message>
			</example>
		</>

		<section label="Disabled" sticky="stack" collapsible dividing>
			<example "Disabled" description="A disabled reveal will not animate when hovered or focused, and is not a tab stop.">
				<reveal disabled move>
					<image slot="visible" size="small" src="/components/ui/images/wireframe/square-image.png" alt=""/>
					<image slot="hidden" size="small" src="/components/ui/images/avatar/large/chris.jpg" alt="Chris"/>
				</reveal>
			</example>
		</>

		<section label="Focusable content" sticky="stack" collapsible dividing>
			<example "Focusable content" description="When the content holds a link, button or field, that control takes the focus and reveals it;  the reveal adds no tab stop of its own.  Tab to it.">
				<reveal move="up">
					<image slot="visible" size="small" src="/components/ui/images/wireframe/square-image.png" alt=""/>
					<link link="#focusable-content" slot="hidden">
						<image size="small" src="/components/ui/images/avatar/large/laura.jpg" alt="Laura's profile"/>
					</link>
				</reveal>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Instant" sticky="stack" collapsible dividing>
			<example "Instant" description="An element can show its content without delay.">
				<reveal instant move aria-label="Instant demo">
					<image slot="visible" size="small" src="/components/ui/images/wireframe/square-image.png" alt=""/>
					<image slot="hidden" size="small" src="/components/ui/images/avatar/large/chris.jpg" alt="Chris"/>
				</reveal>
			</example>
		</>

		<section label="Unclipped" sticky="stack" collapsible dividing>
			<example "Unclipped" description="A reveal can keep its overflowing content visible instead of clipping it (Fomantic calls it a visible reveal), as the rotating corner here.">
				<reveal clip="none" rotate aria-label="Unclipped demo">
					<image slot="visible" size="small" src="/components/ui/images/wireframe/square-image.png" alt="" appearance="circular"/>
					<image slot="hidden" size="small" src="/components/ui/images/avatar/large/tom.jpg" alt="Tom" appearance="circular"/>
				</reveal>
			</example>
		</>
	</>
</spell-notebook>
