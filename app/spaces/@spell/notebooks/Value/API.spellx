<spell-notebook "value api">
	<header level="1">
		Value
		<header>A value is what a statistic shows:  a number, a word, an icon or an image.</>
	</>
	<value-tab-bar showing="api"/>
	<section>
		<html>
			<ui-menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
				<ui-item link="#attributes">Attributes</>
				<ui-item link="#slots">Slots</>
				<ui-item link="#parts">Parts</>
				<ui-item link="#states">States</>
			</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`docs/__data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api tag="ui-value" only="attributes"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api tag="ui-value" only="slots"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api tag="ui-value" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api tag="ui-value" only="states"></>
		</>
	</>
</spell-notebook>
