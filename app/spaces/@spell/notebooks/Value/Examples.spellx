<spell-notebook "value examples">
	<header level="1">
		Value
		<header>A value is what a statistic shows:  a number, a word, an icon or an image.</>
	</>
	<value-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#owners">Owners</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  `<ui-value>` in each owner that gives it a look (from the owners' own pages and
		`src/components/ui-parts/examples/elements/`), then its attributes.  The Content parts page
		(`ui-header.html`) shows every part together.
	-->
	<section label="Owners">
		<section label="Statistic" sticky="stack" collapsible dividing>
			<example "Statistic" description="A statistic's value, above its label.">
				<statistics>
					<statistic>
						<value>40,509</value>
						<label>Views</label>
					</statistic>
					<statistic direction="horizontal">
						<value>2,204</value>
						<label>Downloads</label>
					</statistic>
				</statistics>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Text Value" sticky="stack" collapsible dividing>
			<example "Text Value" description="`text` makes a word value, smaller and bold.">
				<statistic>
					<value text>
						<stack spacing="none">
							<text>Three</text>
							<text>Thousand</text>
						</stack>
					</value>
					<label>Signups</label>
				</statistic>
			</example>
		</>

		<section label="Icon and Image" sticky="stack" collapsible dividing>
			<example "Icon and Image" description="A value can hold an icon or an image beside the number.">
				<statistics>
					<statistic>
						<value><icon name="plane"/> 5</value>
						<label>Flights</label>
					</statistic>
					<statistic>
						<value><image inline src="/components/ui/images/avatar/small/joe.jpg" alt="" appearance="circular"/> 42</value>
						<label>Team Members</label>
					</statistic>
				</statistics>
			</example>
		</>
	</>
</spell-notebook>
