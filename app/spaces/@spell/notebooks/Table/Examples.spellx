					</row>
					<row>
						<cell>John</cell>
						<cell>Approved</cell>
						<cell>He is a very nice guy and I enjoyed talking to him on the telephone. I hope we get to talk again.</cell>
					</row>
					<row>
						<cell>Jamie</cell>
						<cell>Approved</cell>
						<cell>Jamie was not interested in purchasing our product.</cell>
					</row>
				</table>
			</example>
		</>

