		<section label="Attached" sticky="stack" collapsible dividing>
			<example "Attached" description="A table can be attached to other content on a page:  `attach=\"top\"`, `attach=\"both\"` (the middle) or `attach=\"bottom\"`.">
				<table attach="top">
					<row>
						<cell>John</cell>
						<cell>Approved</cell>
						<cell>None</cell>
					</row>
				</table>
				<table attach="both">
					<row>
						<cell>Jamie</cell>
						<cell>Approved</cell>
						<cell>Requires call</cell>
					</row>
				</table>
				<table attach="bottom">
					<row>
						<cell>Jill</cell>
						<cell>Denied</cell>
						<cell>None</cell>
					</row>
				</table>
			</example>
		</>

		<section label="Table alignment" sticky="stack" collapsible dividing>
			<example "Table alignment" description="A table's cells can all share one text alignment (`align`);  `vertical-align` does the same vertically.">
				<table align="center" celled>
					<row header>
						<cell>Name</cell>
						<cell>Status</cell>
						<cell>Notes</cell>
					</row>
					<row>
						<cell>John</cell>
						<cell>Approved</cell>
						<cell>None</cell>
					</row>
					<row>
						<cell>Jamie</cell>
						<cell>Approved</cell>
						<cell>Requires call</cell>
					</row>
				</table>
			</example>
		</>

