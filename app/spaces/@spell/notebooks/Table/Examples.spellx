		<section label="Sortable" sticky="stack" collapsible dividing id="variations-sortable">
			<example "Sortable" description="A table may allow a user to sort contents by clicking on a table header.">
				<message slot="description" state="info" size="small">No plugin needed:  a header click (or Enter / Space) fires <text code>ui-sorting</text>, and marks the column with sort-column, sort-direction and aria-sort. <text code>client-sort</text> also reorders the rows; click a header to try it.</message>
				<html>
					<ui-table sortable celled client-sort>
						<table>
							<thead>
								<tr>
									<th>Name</th>
									<th>Status</th>
									<th>Notes</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td>John</td>
									<td>No Action</td>
									<td>None</td>
								</tr>
								<tr>
									<td>Jamie</td>
									<td class="positive">Approved</td>
									<td class="warning">Requires call</td>
								</tr>
								<tr>
									<td>Jill</td>
									<td class="negative">Denied</td>
									<td>None</td>
								</tr>
							</tbody>
							<tfoot>
								<tr>
									<th>3 People</th>
									<th>2 Approved</th>
									<th></th>
								</tr>
							</tfoot>
						</table>
					</ui-table>
				</html>
			</example>
		</>

		<section label="Full-Width Header / Footer" sticky collapsible dividing>
			<example "Full-Width Header / Footer" description="A definition table can have a full width header or footer, filling in the gap left by the first column.">
				<html>
					<ui-table padding="compact" celled definition>
						<table>
							<thead class="full-width">
								<tr>
									<th></th>
									<th>Name</th>
									<th>Registration Date</th>
									<th>E-mail address</th>
									<th>Premium Plan</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td class="collapsing">
										<ui-checkbox appearance="slider" padding="none" aria-label="Premium for John Lilki"></ui-checkbox>
									</td>
									<td>John Lilki</td>
									<td>September 14, 2013</td>
									<td>jhlilk22@yahoo.com</td>
									<td>No</td>
								</tr>
								<tr>
									<td class="collapsing">
										<ui-checkbox appearance="slider" padding="none" aria-label="Premium for Jamie Harington"></ui-checkbox>
									</td>
									<td>Jamie Harington</td>
									<td>January 11, 2014</td>
									<td>jamieharingonton@yahoo.com</td>
									<td>Yes</td>
								</tr>
								<tr>
									<td class="collapsing">
										<ui-checkbox appearance="slider" padding="none" aria-label="Premium for Jill Lewis"></ui-checkbox>
									</td>
									<td>Jill Lewis</td>
									<td>May 11, 2014</td>
									<td>jilsewris22@yahoo.com</td>
									<td>Yes</td>
								</tr>
							</tbody>
							<tfoot class="full-width">
								<tr>
									<th></th>
									<th colspan="4">
										<ui-stack direction="horizontal" justify="between">
											<ui-stack direction="horizontal" spacing="xs">
												<ui-button size="small">Approve</ui-button>
												<ui-button size="small" disabled>Approve All</ui-button>
											</ui-stack>
											<ui-button size="small" labeled icon="user" color="primary">Add User</ui-button>
										</ui-stack>
									</th>
								</tr>
							</tfoot>
						</table>
					</ui-table>
				</html>
			</example>
		</>

		<section label="Padded" sticky="stack" collapsible dividing>
			<example "Padded" description="A table may sometimes need to be more padded for legibility.">
				<table padding="md">
					<row header>
						<cell>Name</cell>
						<cell>Status</cell>
						<cell>Notes</cell>
					</row>
					<row>
						<cell>John</cell>
						<cell>Approved</cell>
						<cell>He is a very nice guy and I enjoyed talking to him on the telephone. I hope we get to talk again.</cell>
					</row>
					<row>
						<cell>Jamie</cell>
						<cell>Approved</cell>
						<cell>Jamie was not interested in purchasing our product.</cell>
					</row>
				</table>
			</example>
			<example "Padded">
				<table padding="lg">
					<row header>
						<cell>Name</cell>
