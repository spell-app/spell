									<td>Approved</td>
									<td class="top aligned">Notes<br /> 1<br /> 2<br /></td>
								</tr>
								<tr>
									<td>Jamie</td>
									<td class="bottom aligned">Approved</td>
									<td>Notes<br /> 1<br /> 2<br /></td>
								</tr>
							</tbody>
						</table>
					</ui-table>
				</html>
			</example>
		</>

