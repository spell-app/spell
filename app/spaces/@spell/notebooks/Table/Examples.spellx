		<section label="Attached" sticky collapsible dividing>
			<example description="A table can be attached to other content on a page:  `attach=\"top\"`, `attach=\"both\"` (the middle) or `attach=\"bottom\"`.">
				<html>
					<ui-table attach="top">
						<table>
							<tbody>
								<tr>
									<td>John</td>
									<td>Approved</td>
									<td>None</td>
								</tr>
							</tbody>
						</table>
					</ui-table>
					<ui-table attach="both">
						<table>
							<tbody>
								<tr>
									<td>Jamie</td>
									<td>Approved</td>
									<td>Requires call</td>
								</tr>
							</tbody>
						</table>
					</ui-table>
					<ui-table attach="bottom">
						<table>
							<tbody>
								<tr>
									<td>Jill</td>
									<td>Denied</td>
									<td>None</td>
								</tr>
							</tbody>
						</table>
					</ui-table>
				</html>
			</example>
		</>

		<section label="Table alignment" sticky collapsible dividing>
