<spell-notebook "items examples">
	<header level="1">
		Items
		<header>A group of items presents a set of site content for display, each an image beside its
              text.</>
	</>
	<items-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#content">Content</>
			<item link="#states">States</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's item page, section by section, in its order (Types, Content, States, Variations).
		Fomantic's `.item` is the generic `<ui-item>`;  its `.image` + `<img>` the `image` shorthand (or a `<ui-image size>`);
		`.middle aligned content` is `<ui-content vertical-align="middle">`;  `ui wireframe image`s are plain `<ui-image>`s.
	-->
	<section label="Types">
		<section label="Items" sticky="stack" collapsible dividing>
			<example "Items" description="A group of items.">
				<message slot="description" state="positive" size="small">Item views are designed to be responsive, with images stacking at mobile widths. By default ours stack by the width of the GROUP (<text code>stack-with="container"</text>);  this site sets <text code>stack-with="page"</text>, so here they stack by the window, as in Fomantic.</message>
				<items>
					<item image="../images/wireframe/image.png">
						<content>
							<header link="#">Header</header>
							<meta>
								<text>Description</text>
							</meta>
							<description>
								<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
							</description>
							<extra>Additional Details</extra>
						</content>
					</item>
					<item image="../images/wireframe/image.png">
						<content>
							<header link="#">Header</header>
							<meta>
								<text>Description</text>
							</meta>
							<description>
								<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
							</description>
							<extra>Additional Details</extra>
						</content>
					</item>
				</items>
			</example>
		</>
	</>

	<section label="Content">
		<section label="Image" sticky="stack" collapsible dividing>
			<example "Image" description="An item can contain an image:  `image` is the shorthand, at the item's image width.">
				<items divided>
					<item image="../images/wireframe/image.png"/>
					<item image="../images/wireframe/image.png"/>
					<item image="../images/wireframe/image.png"/>
				</items>
			</example>
		</>

		<section label="Content" sticky="stack" collapsible dividing>
			<example "Content" description="An item can contain content.">
				<items divided>
					<item>
						<image size="tiny" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content vertical-align="middle">Content A</content>
					</item>
					<item>
						<image size="tiny" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content vertical-align="middle">Content B</content>
					</item>
					<item>
						<image size="tiny" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content vertical-align="middle">Content C</content>
					</item>
				</items>
			</example>
		</>

		<section label="Header" sticky="stack" collapsible dividing>
			<example "Header" description="An item can contain a header.">
				<items>
					<item>
						<image size="tiny" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content vertical-align="middle">
							<header link="#">12 Years a Slave</header>
						</content>
					</item>
					<item>
						<image size="tiny" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content vertical-align="middle">
							<header link="#">My Neighbor Totoro</header>
						</content>
					</item>
					<item>
						<image size="tiny" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content vertical-align="middle">
							<header link="#">Watchmen</header>
						</content>
					</item>
				</items>
			</example>
		</>

		<section label="Metadata" sticky="stack" collapsible dividing>
			<example "Metadata" description="An item can contain content metadata.">
				<message slot="description" state="info" size="small">You can include an arbitrary amount of metadata in <text code>&lt;ui-meta&gt;</text>: every child is spaced automatically.</message>
				<items>
					<item>
						<image size="small" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content>
							<header>Arrowhead Valley Camp</header>
							<meta>
								<text>$1200</text>
								<text>1 Month</text>
							</meta>
							<description>
								<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
							</description>
						</content>
					</item>
					<item>
						<image size="small" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content>
							<header>Buck's Homebrew Stayaway</header>
							<meta>
								<text>$1000</text>
								<text>2 Weeks</text>
							</meta>
							<description>
								<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
							</description>
						</content>
					</item>
					<item>
						<image size="small" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content>
							<header>Astrology Camp</header>
							<meta>
								<text>$1600</text>
								<text>6 Weeks</text>
							</meta>
							<description>
								<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
							</description>
						</content>
					</item>
				</items>
			</example>
		</>

		<section label="Link" sticky="stack" collapsible dividing>
			<example "Link" description="An item can contain links as images, headers, or inside content.">
				<message slot="description" state="warning" size="small">To make the entire content of an item a link, see the Link Item variation below.</message>
				<items>
					<item>
						<image size="tiny" link="#" src="/components/ui/images/avatar/large/stevie.jpg" alt=""/>
						<content>
							<header link="#">Stevie Feliciano</header>
							<description>
								<text paragraph>Stevie Feliciano is a <link link="#">library scientist</link> living in New York City. She likes to spend her time reading, running, and writing.</text>
							</description>
						</content>
					</item>
					<item>
						<image size="tiny" link="#" src="/components/ui/images/avatar/large/veronika.jpg" alt=""/>
						<content>
							<header link="#">Veronika Ossi</header>
							<description>
								<text paragraph>Veronika Ossi is a set designer living in New York who <link link="#">enjoys</link> kittens, music, and partying.</text>
							</description>
						</content>
					</item>
					<item>
						<image size="tiny" link="#" src="/components/ui/images/avatar/large/jenny.jpg" alt=""/>
						<content>
							<header link="#">Jenny Hess</header>
							<description>
								<text paragraph>Jenny is a student studying Media Management at <link link="#">the New School</link>.</text>
							</description>
						</content>
					</item>
				</items>
			</example>
		</>

		<section label="Description" sticky="stack" collapsible dividing>
			<example "Description" description="An item can contain a description with a single or multiple paragraphs.">
				<items>
					<item>
						<image size="small" link="#" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content>
							<header link="#">Cute Dog</header>
							<description>
								<text paragraph>Cute dogs come in a variety of shapes and sizes. Some cute dogs are cute for their adorable faces, others for their tiny stature, and even others for their massive size.</text>
								<text paragraph>Many people also have their own barometers for what makes a cute dog.</text>
							</description>
						</content>
					</item>
				</items>
			</example>
		</>

		<section label="Extra Content" sticky="stack" collapsible dividing>
			<example "Extra Content" description="An item can contain extra content meant to be formatted separately from the main content.">
				<items>
					<item>
						<content>
							<header link="#">Cute Dog</header>
							<description>
								<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
								<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
							</description>
							<extra><icon name="check" color="green"/> 121 Votes</extra>
						</content>
					</item>
				</items>
			</example>
		</>

		<section label="Rating" sticky="stack" collapsible dividing>
			<example "Rating" description="An item can contain icons signifying a 'like' or 'favorite' action.">
				<message slot="description" state="info" size="small">Use <text code>&lt;ui-rating&gt;</text> to attach events to like and favorite icons.</message>
				<items>
					<item>
						<image size="tiny" link="#" src="/components/ui/images/avatar/large/jenny.jpg" alt=""/>
						<content vertical-align="middle">
							<header><icon name="like"/> Veronika Ossi</header>
						</content>
					</item>
					<item>
						<image size="tiny" link="#" src="/components/ui/images/avatar/large/justen.jpg" alt=""/>
						<content vertical-align="middle">
							<header><icon name="favorite"/> Justen Kitsune</header>
						</content>
					</item>
				</items>
			</example>
		</>
	</>

	<section label="States">
		<section label="Disabled" sticky="stack" collapsible dividing>
			<example "Disabled" description="An item can be disabled.">
				<items>
					<item disabled>
						<image size="tiny" link="#" src="/components/ui/images/avatar/large/veronika.jpg" alt=""/>
						<content>
							<header link="#">Veronika Ossi</header>
							<description>
								<text paragraph>Veronika Ossi is a set designer living in New York who <link link="#">enjoys</link> kittens, music, and partying.</text>
							</description>
						</content>
					</item>
				</items>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Stacking" sticky="stack" collapsible dividing>
			<example "Stacking" description="A group of items can specify how it stacks responsively:  `unstackable` keeps the image beside the content in a narrow group.">
				<items unstackable>
					<item image="../images/wireframe/image.png">
						<content>
							<header link="#">Header</header>
							<meta>
								<text>Description</text>
							</meta>
							<description>
								<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
							</description>
							<extra>Additional Details</extra>
						</content>
					</item>
					<item image="../images/wireframe/image.png">
						<content>
							<header link="#">Header</header>
							<meta>
								<text>Description</text>
							</meta>
							<description>
								<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
							</description>
							<extra>Additional Details</extra>
						</content>
					</item>
				</items>
			</example>
		</>

		<section label="Divided" sticky="stack" collapsible dividing>
			<example "Divided" description="Items can be divided to better distinguish between grouped content.">
				<items divided>
					<item image="../images/wireframe/image.png">
						<content>
							<header link="#">12 Years a Slave</header>
							<meta>
								<text>Union Square 14</text>
							</meta>
							<description>
								<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
							</description>
							<extra>
								<label>IMAX</label>
								<label icon="globe">Additional Languages</label>
							</extra>
						</content>
					</item>
					<item image="../images/wireframe/image.png">
						<content>
							<header link="#">My Neighbor Totoro</header>
							<meta>
								<text>IFC Cinema</text>
							</meta>
							<description>
								<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
							</description>
							<extra>
								<stack direction="horizontal" justify="between">
									<label>Limited</label>
									<button color="primary">Buy tickets <icon name="chevron right"/></button>
								</stack>
							</extra>
						</content>
					</item>
					<item image="../images/wireframe/image.png">
						<content>
							<header link="#">Watchmen</header>
							<meta>
								<text>IFC</text>
							</meta>
							<description>
								<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
							</description>
							<extra>
								<stack direction="horizontal" justify="end">
									<button color="primary">Buy tickets <icon name="chevron right"/></button>
								</stack>
							</extra>
						</content>
					</item>
				</items>
			</example>
		</>

		<section label="Relaxed" sticky="stack" collapsible dividing>
			<example "Relaxed" description="A group of items can relax its padding to provide more negative space.">
				<items spacing="lg">
					<item>
						<image size="tiny" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content vertical-align="middle">
							<header link="#">12 Years a Slave</header>
						</content>
					</item>
					<item>
						<image size="tiny" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content vertical-align="middle">
							<header link="#">My Neighbor Totoro</header>
						</content>
					</item>
					<item>
						<image size="tiny" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content vertical-align="middle">
							<header link="#">Watchmen</header>
						</content>
					</item>
				</items>
			</example>
			<example "Relaxed" description="Even more with `relaxed=\"very\"`.">
				<items spacing="xl">
					<item>
						<image size="tiny" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content vertical-align="middle">
							<header link="#">12 Years a Slave</header>
						</content>
					</item>
					<item>
						<image size="tiny" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content vertical-align="middle">
							<header link="#">My Neighbor Totoro</header>
						</content>
					</item>
					<item>
						<image size="tiny" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content vertical-align="middle">
							<header link="#">Watchmen</header>
						</content>
					</item>
				</items>
			</example>
		</>

		<section label="Link Item" sticky="stack" collapsible dividing>
			<example "Link Item" description="An item can be formatted so that the entire contents link to another page:  `appearance=\"link\"` on the group is the hover look, `link` on an item the link.">
				<items appearance="link">
					<item link="#">
						<image size="tiny" src="/components/ui/images/avatar/large/stevie.jpg" alt=""/>
						<content>
							<header>Stevie Feliciano</header>
							<description>
								<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
							</description>
						</content>
					</item>
					<item link="#">
						<image size="tiny" src="/components/ui/images/avatar/large/veronika.jpg" alt=""/>
						<content>
							<header>Veronika Ossi</header>
							<description>
								<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
							</description>
						</content>
					</item>
					<item link="#">
						<image size="tiny" src="/components/ui/images/avatar/large/jenny.jpg" alt=""/>
						<content>
							<header>Jenny Hess</header>
							<description>
								<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
							</description>
						</content>
					</item>
				</items>
			</example>
		</>

		<section label="Vertical Alignment" sticky collapsible dividing>
			<example "Vertical Alignment" description="Content can specify its vertical alignment:  `vertical-align` on the `<ui-content>`.">
				<items unstackable>
					<item>
						<image size="small" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content>
							<header>Top Aligned</header>
						</content>
					</item>
					<item>
						<image size="small" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content vertical-align="middle">
							<header>Middle Aligned</header>
						</content>
					</item>
					<item>
						<image size="small" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content vertical-align="bottom">
							<header>Bottom Aligned</header>
						</content>
					</item>
				</items>
			</example>
		</>

		<section label="Content at the Right" sticky="stack" collapsible dividing>
			<example "Content at the Right" description="Content has no `floated` any more:  a `<ui-stack>` puts it at the left or the right.">
				<items>
					<item>
						<image size="small" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content vertical-align="middle">
							<header>Content A</header>
							<description>
								<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
							</description>
							<extra>
								<stack direction="horizontal" justify="end">
									<button>Action</button>
								</stack>
							</extra>
						</content>
					</item>
					<item>
						<image size="small" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content vertical-align="middle">
							<header>Content B</header>
							<description>
								<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
							</description>
							<extra>
								<stack direction="horizontal" justify="end">
									<button>Action</button>
								</stack>
							</extra>
						</content>
					</item>
					<item>
						<image size="small" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content vertical-align="middle">
							<header>Content C</header>
							<description>
								<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
							</description>
							<extra>
								<stack direction="horizontal" justify="end">
									<button>Action</button>
								</stack>
							</extra>
						</content>
					</item>
				</items>
			</example>
		</>

		<section label="Inverted" sticky="stack" collapsible dividing>
			<example "Inverted" description="An item can be inverted to appear on a dark background.">
				<message slot="description" state="info" size="small">Set a dark background yourself, or wrap the items in an <text code>&lt;ui-segment inverted&gt;</text>.</message>
				<segment inverted>
					<items inverted>
						<item>
							<image size="small" src="/components/ui/images/wireframe/image.png" alt=""/>
							<content>
								<header>Arrowhead Valley Camp</header>
								<meta>
									<text>$1200</text>
									<text>1 Month</text>
								</meta>
								<description>
									<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
								</description>
							</content>
						</item>
						<item>
							<image size="small" src="/components/ui/images/wireframe/image.png" alt=""/>
							<content>
								<header>Buck's Homebrew Stayaway</header>
								<meta>
									<text>$1000</text>
									<text>2 Weeks</text>
								</meta>
								<description>
									<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
								</description>
							</content>
						</item>
					</items>
				</segment>
			</example>
		</>

		<section label="Size" sticky="stack" collapsible dividing>
			<example "Size" description="Items can have different text sizes, `mini` ... `massive`.">
				<items size="small">
					<item>
						<image size="small" src="/components/ui/images/wireframe/image.png" alt=""/>
						<content>
							<header>Arrowhead Valley Camp</header>
							<meta>
								<text>$1200</text>
								<text>1 Month</text>
							</meta>
							<description>
								<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
							</description>
						</content>
					</item>
				</items>
			</example>
		</>
	</>
</spell-notebook>
