<spell-notebook "items api">
	<header level="1">
		Items
		<header>A group of items presents a set of site content for display, each an image beside its
              text.</>
	</>
	<items-tab-bar showing="api"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#attributes">Attributes</>
			<item link="#slots">Slots</>
			<item link="#parts">Parts</>
			<item link="#states">States</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`docs/__data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-items" only="attributes"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api family="ui-items" only="slots"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-items" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-items" only="states"></>
		</>
	</>
</spell-notebook>
