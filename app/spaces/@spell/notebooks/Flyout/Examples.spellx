<spell-notebook "flyout examples">
	<header level="1">
		Flyout
		<header>A flyout is a modal that slides in from a side of the page.</>
	</>
	<flyout-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's flyout page, section by section, in its order (Types, Variations), plus our extras
		(Shorthands, Inverted, Blurring).  Every flyout opens from a button through an invoker command (`commandfor` +
		`command="--show"`):  no script.  Never `visible` on load:  it would block the page.
		`GAP I<n>` comments mark examples a widget can't render yet (plan-doc issues).
	-->
	<section label="Types">
		<section label="Flyout" sticky="stack" collapsible dividing>
			<example "Flyout" description="A flyout: a modal panel that slides in from the left, with a header, content and actions. The approve / deny buttons close it.">
				<message slot="description" size="small" state="warning">On a phone, a side flyout is never wider than the viewport (Fomantic shows it <text code>fullscreen</text> there).</message>
				<button commandfor="flyout-types-standard" command="--show">Show</button>
				<flyout id="flyout-types-standard" closable>
					<header>
						<icon name="question"/>
						<content>Archive Old Messages</content>
					</header>
					<content>
						<text paragraph>Your inbox is getting full, would you like us to enable automatic archiving of old messages?</text>
					</content>
					<actions>
						<button class="cancel" color="red" icon="remove">No</button>
						<button class="ok" color="green" icon="checkmark">Yes</button>
					</actions>
				</flyout>
			</example>
		</>

		<section label="Shorthands" sticky="stack" collapsible dividing>
			<example "Shorthands" description="`header` and `content` are shorthands for a header and a block of text;  `closable` adds a close icon.">
				<button commandfor="flyout-types-shorthand" command="--show">Show</button>
				<flyout id="flyout-types-shorthand" heading="Profile" content="A flyout from its attributes alone." closable/>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Width" sticky="stack" collapsible dividing>
			<example "Width" description="A flyout can specify its width:  `very thin`, `thin`, the default, `wide` or `very wide`.">
				<button commandfor="flyout-width-very-thin" command="--show">Very thin</button>
				<button commandfor="flyout-width-thin" command="--show">Thin</button>
				<button commandfor="flyout-width-default" command="--show">Default</button>
				<button commandfor="flyout-width-wide" command="--show">Wide</button>
				<button commandfor="flyout-width-very-wide" command="--show">Very wide</button>
				<flyout id="flyout-width-very-thin" width="very thin" heading="Very thin" closable/>
				<flyout id="flyout-width-thin" width="thin" heading="Thin" content="A thin flyout." closable/>
				<flyout id="flyout-width-default" heading="Default" content="The default width." closable/>
				<flyout id="flyout-width-wide" width="wide" heading="Wide" content="A wide flyout." closable/>
				<flyout id="flyout-width-very-wide" width="very wide" heading="Very wide" content="A very wide flyout." closable/>
			</example>
			<example "Width" description="Width can also be defined like the grid system: columns of sixteen (`width=\"5\"`), a fraction (`1/4`) or a percentage (`25%`).">
				<message slot="description" size="small" state="warning">A flyout's width applies only to <text code>left</text> and <text code>right</text> flyouts.</message>
				<button commandfor="flyout-width-2" command="--show">Two wide</button>
				<button commandfor="flyout-width-5" command="--show">Five wide</button>
				<button commandfor="flyout-width-8" command="--show">Eight wide</button>
				<button commandfor="flyout-width-12" command="--show">Twelve wide</button>
				<flyout id="flyout-width-2" width="2" heading="Two" closable/>
				<flyout id="flyout-width-5" width="5" heading="Five wide" content="Five columns of sixteen." closable/>
				<flyout id="flyout-width-8" width="8" heading="Eight wide" content="Half the viewport." closable/>
				<flyout id="flyout-width-12" width="12" heading="Twelve wide" content="Three quarters of the viewport." closable/>
			</example>
		</>

		<section label="Position" sticky="stack" collapsible dividing>
			<example "Position" description="A flyout can specify its display position:  `position` is left (the default), right, top or bottom.">
				<message slot="description" size="small" state="info">Top and bottom flyouts are full width, and their height is defined by their content.</message>
				<button commandfor="flyout-position-left" command="--show">Left</button>
				<button commandfor="flyout-position-right" command="--show">Right</button>
				<button commandfor="flyout-position-top" command="--show">Top</button>
				<button commandfor="flyout-position-bottom" command="--show">Bottom</button>
				<flyout id="flyout-position-left" position="left" heading="Left" content="From the left edge." closable/>
				<flyout id="flyout-position-right" position="right" heading="Right" content="From the right edge." closable/>
				<flyout id="flyout-position-top" position="top" heading="Top" content="From the top edge." closable/>
				<flyout id="flyout-position-bottom" position="bottom" aria-label="Cookies">
					<content>
						<text paragraph>This page uses no cookies.</text>
					</content>
					<actions>
						<button class="approve" color="primary">Got it</button>
					</actions>
				</flyout>
			</example>
		</>

		<section label="Fullscreen" sticky="stack" collapsible dividing>
			<example "Fullscreen" description="A flyout can take all the entire screen if needed.">
				<button commandfor="flyout-fullscreen" command="--show">Show</button>
				<flyout id="flyout-fullscreen" fullscreen heading="Full screen" content="The whole viewport wide." closable/>
			</example>
		</>

		<section label="Scrolling Content" sticky collapsible dividing>
			<example "Scrolling Content" description="A flyout can have a scrolling content.">
				<message slot="description" size="small" state="info">The flyout is a column: header at the top, actions at the bottom, and the content grows between them. The flyout itself scrolls when it's too tall, so <text code>&lt;ui-content scrolling&gt;</text> caps nothing here.</message>
				<button commandfor="flyout-content-scrolling" command="--show">Show terms</button>
				<flyout id="flyout-content-scrolling" position="right" heading="Terms" closable>
					<content scrolling>
						<text paragraph>A flyout's content grows to fill its height.</text>
						<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						<text paragraph>Until the very end.</text>
					</content>
					<actions>
						<button class="approve" color="primary">I agree</button>
					</actions>
				</flyout>
			</example>
		</>

		<!-- GAP I99, I110:  no centred actions (`<ui-actions>` has no text-align), and the header ignores its text-align;  only the content centres. -->
		<section label="Center Aligned" sticky="stack" collapsible dividing>
			<example "Center Aligned" description="You can center align the header, the content or even actions individually:  `text-align=\"center\"`.">
				<button commandfor="flyout-center" command="--show">Show</button>
				<flyout id="flyout-center">
					<header align="center">Header is centered</header>
					<content align="center">
						<text paragraph>Content is centered</text>
					</content>
					<actions>
						<button color="negative">Cancel</button>
						<button color="positive">OK</button>
					</actions>
				</flyout>
			</example>
		</>

		<!-- GAP I99:  no left actions;  they stay on the right. -->
		<section label="Left Actions" sticky="stack" collapsible dividing>
			<example "Left Actions" description="You can also place the action buttons to the left.">
				<button commandfor="flyout-left-actions" command="--show">Show</button>
				<flyout id="flyout-left-actions">
					<header>Look at the Actions</header>
					<content>
						<text paragraph>They are aligned to the left</text>
					</content>
					<actions>
						<button color="negative">Cancel</button>
						<button color="positive">OK</button>
					</actions>
				</flyout>
			</example>
		</>

		<!-- GAP I99:  no basic header or actions;  they keep their tinted backgrounds and rules. -->
		<section label="Basic Header and Actions" sticky collapsible dividing>
			<example "Basic Header and Actions" description="Header and/or Actions can also appear on the same basic background as the content.">
				<button commandfor="flyout-basic-parts" command="--show">Show</button>
				<flyout id="flyout-basic-parts">
					<header>Basic Header</header>
					<content>
						<text paragraph>Basic Actions below</text>
					</content>
					<actions>
						<button color="negative">Cancel</button>
						<button color="positive">OK</button>
					</actions>
				</flyout>
			</example>
		</>

		<section label="Inverted" sticky="stack" collapsible dividing>
			<example "Inverted" description="A flyout can use the dark scheme:  `inverted` replaces the background, the header colour and the actions background.">
				<button commandfor="flyout-inverted" command="--show">Show</button>
				<flyout id="flyout-inverted" position="top" inverted heading="Notice" closable>
					<content>
						<text paragraph>A top flyout in the dark scheme.</text>
					</content>
				</flyout>
			</example>
		</>

		<section label="Blurring" sticky="stack" collapsible dividing>
			<example "Blurring" description="`blurring` blurs and greys the page behind the flyout's dimmer.">
				<button commandfor="flyout-blurring" command="--show">Show</button>
				<flyout id="flyout-blurring" position="right" blurring heading="Blurring" content="The page behind is blurred." closable/>
			</example>
		</>

		<section label="Modeless" sticky="stack" collapsible dividing>
			<example "Modeless" description="`modeless` leaves the page usable while it shows:  no dimmer, and a click on the page lands where it went, closing the flyout as it does (as Escape and its close icon do).  The docs' own side column opens this way on narrow screens.">
				<button commandfor="flyout-modeless" command="--toggle">Toggle</button>
				<flyout id="flyout-modeless" position="right" width="thin" modeless heading="Modeless" content="Scroll the page:  this stays open.  A click on the page closes it, and still lands." closable/>
			</example>
		</>
	</>
</spell-notebook>
