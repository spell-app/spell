<spell-notebook "terms api">
	<header level="1">
		Terms
		<header>Terms list facts as a label and a value each, lined up.</>
	</>
	<terms-tab-bar showing="api"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#tags">Tags</>
			<item link="#attributes">Attributes</>
			<item link="#slots">Slots</>
			<item link="#parts">Parts</>
			<item link="#states">States</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`site/_data/components.json5`);  nothing to write. -->
	<section label="Tags">
		<html>
			<ui-docs-api family="ui-terms" only="tags"></>
		</>
	</>

	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-terms" only="attributes"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api family="ui-terms" only="slots"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-terms" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-terms" only="states"></>
		</>
	</>
</spell-notebook>
