<spell-notebook "rating api">
	<header level="1">
		Rating
		<header>A rating indicates user interest in content.</>
	</>
	<rating-tab-bar showing="api"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#attributes">Attributes</>
			<item link="#events">Events</>
			<item link="#parts">Parts</>
			<item link="#states">States</>
			<item link="#texts">Texts</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`docs/__data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-rating" only="attributes"></>
		</>
	</>

	<section label="Events">
		<html>
			<ui-docs-api family="ui-rating" only="events"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-rating" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-rating" only="states"></>
		</>
	</>

	<section label="Texts">
		<html>
			<ui-docs-api family="ui-rating" only="texts"></>
		</>
	</>
</spell-notebook>
