		<section label="Dashed" sticky collapsible dividing>
			<example description="Ours, not Fomantic's:  a dashed card is a flat placeholder, its border dashed in `--ui-card-border-color`.">
				<card heading="Current, for comparison" description="Where the next one will go." appearance="dashed"/>
			</example>
		</>

		<section label="Column Count" sticky collapsible dividing>
			<example description="A group of cards can set how many cards should exist in a row:  `columns`.">
				<html>
					<ui-cards columns="4">
						<ui-card>
							<img src="/components/ui/images/wireframe/image.png" alt="" />
							<ui-extra>Rating: <ui-rating color="yellow" value="4" aria-label="Rating"></ui-rating></ui-extra>
						</ui-card>
						<ui-card>
							<img src="/components/ui/images/wireframe/image.png" alt="" />
							<ui-extra>Rating: <ui-rating color="yellow" value="2" aria-label="Rating"></ui-rating></ui-extra>
						</ui-card>
						<ui-card>
							<img src="/components/ui/images/wireframe/image.png" alt="" />
