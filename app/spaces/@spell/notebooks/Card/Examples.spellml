<spell-notebook "card examples">
	<header level="1">
		Card
		<header>A card displays site content in a manner similar to a playing card.</>
	</>
	<card-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#content">Content</>
			<item link="#states">States</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's page, section by section, in its order (Types, Content, States, Variations,
		Groups ...).  Rules, the class-grammar mappings, gaps:  packages/docs/content/epics/spell-ui-pages/PAGES.md.
		- A section:  `<ui-header level="2" dividing id="types">Types</ui-header>`, then its examples.
		- An example:  `<ui-example heading="..." description="...">` around the live markup;  the markup
		  IS the code shown.  A richer description:  `<p slot="description">` (+ `<ui-message slot="description">`).
		- A gap:  an HTML comment `GAP I<n>:  ...` BEFORE the example (a comment inside it shows in its code).
	-->
	<section label="Types">
		<section label="Card" sticky="stack" collapsible dividing>
			<example "Card" description="A single card.">
				<card>
					<image alt="Kristy" src="/components/ui/images/avatar2/large/kristy.png"/>
					<content>
						<header link="#card-kristy">Kristy</header>
						<meta>Joined in 2013</meta>
						<description>Kristy is an art director living in New York.</description>
					</content>
					<extra>
						<link link="#card-kristy-friends"><icon name="user"/> 22 Friends</link>
					</extra>
				</card>
				<message slot="description" state="warning" size="small">To ensure cards are equal height use the plural, <text code>&lt;ui-cards&gt;</text>: a group lays its cards out with flex, so cards in the same row match heights.</message>
			</example>

			<!-- I125:  Fomantic's `right floated` meta and likes:  a `<ui-stack>` puts them at the right. -->
			<example "Card">
				<card>
					<content>
						<stack direction="horizontal" justify="between">
							<text><image avatar src="/components/ui/images/avatar/large/elliot.jpg" alt=""/> Elliot</text>
							<meta>14h</meta>
						</stack>
					</content>
					<image alt="" src="/components/ui/images/wireframe/image.png"/>
					<content>
						<stack direction="horizontal" justify="between">
							<text><icon name="comment"/> 3 comments</text>
							<text><icon name="heart"/> 17 likes</text>
						</stack>
					</content>
					<extra>
						<input size="large" appearance="transparent" icon="heart" icon-position="left" placeholder="Add Comment..." aria-label="Add a comment"/>
					</extra>
				</card>
			</example>
		</>

		<section label="Cards" sticky="stack" collapsible dividing>
			<example "Cards" description="A group of cards: `<ui-cards>`.">
				<cards>
					<card>
						<content>
							<image floated="right" size="mini" src="/components/ui/images/avatar/large/elliot.jpg" alt=""/>
							<header>Elliot Fu</header>
							<meta>Friends of Veronika</meta>
							<description>Elliot requested permission to view your contact details</description>
						</content>
						<extra>
							<buttons width="2">
								<button color="green" appearance="basic">Approve</button>
								<button color="red" appearance="basic">Decline</button>
							</buttons>
						</extra>
					</card>
					<card>
						<content>
							<image floated="right" size="mini" src="/components/ui/images/avatar/large/jenny.jpg" alt=""/>
							<header>Jenny Hess</header>
							<meta>New Member</meta>
							<description>Jenny wants to add you to the group <text bold>best friends</text></description>
						</content>
						<extra>
							<buttons width="2">
								<button color="green" appearance="basic">Approve</button>
								<button color="red" appearance="basic">Decline</button>
							</buttons>
						</extra>
					</card>
				</cards>
				<message slot="description" state="info" size="small">Cards are designed to be flexible to your content: <text code>&lt;ui-content&gt;</text> blocks can include any custom elements related to your content.</message>
			</example>
			<example "Cards" description="A group hands its variations to every card in it:  here `link`.">
				<cards appearance="link">
					<card>
						<image alt="Matt Giampietro" src="/components/ui/images/avatar2/large/matthew.png"/>
						<content>
							<header>Matt Giampietro</header>
							<meta>Friends</meta>
							<description>Matthew is an interior designer living in New York.</description>
						</content>
						<extra>Joined in 2013 · <icon name="user"/> 75 Friends</extra>
					</card>
					<card>
						<image alt="Molly" src="/components/ui/images/avatar2/large/molly.png"/>
						<content>
							<header>Molly</header>
							<meta>Coworker</meta>
							<description>Molly is a personal assistant living in Paris.</description>
						</content>
						<extra>Joined in 2011 · <icon name="user"/> 35 Friends</extra>
					</card>
					<card>
						<image alt="Elyse" src="/components/ui/images/avatar2/large/elyse.png"/>
						<content>
							<header>Elyse</header>
							<meta>Coworker</meta>
							<description>Elyse is a copywriter working in New York.</description>
						</content>
						<extra>Joined in 2014 · <icon name="user"/> 151 Friends</extra>
					</card>
				</cards>
			</example>
		</>
	</>

	<section label="Content">
		<!-- GAP I128:  the sub header draws as the card header (large), not Fomantic's small sub header. -->
		<section label="Content Block" sticky="stack" collapsible dividing>
			<example "Content Block" description="A card can contain blocks of content:  `<ui-content>`.">
				<card>
					<content>
						<header>Project Timeline</header>
					</content>
					<content>
						<header sub>Activity</header>
						<feed size="small">
							<event>
								<content>
									<summary><link link="#card-elliot">Elliot Fu</link> added <link link="#card-jenny">Jenny Hess</link> to the project</summary>
								</content>
							</event>
							<event>
								<content>
									<summary><link link="#card-stevie">Stevie Feliciano</link> was added as an <link link="#card-admin">Administrator</link></summary>
								</content>
							</event>
							<event>
								<content>
									<summary><link link="#card-helen">Helen Troy</link> added two pictures</summary>
								</content>
							</event>
						</feed>
					</content>
					<extra>
						<button>Join Project</button>
					</extra>
				</card>
			</example>
		</>

		<!-- GAP I126:  a <ui-reveal> (or a dimmed image) isn't laid out as the card's image;  the plain image shows. -->
		<section label="Image" sticky="stack" collapsible dividing>
			<example "Image" description="A card can contain an image: a slotted `<img>` spans the card's width.">
				<card>
					<image alt="Jenny Hess" src="/components/ui/images/avatar/large/jenny.jpg"/>
					<content>
						<header link="#card-team">Team Fu &amp; Hess</header>
						<meta>Created in Sep 2014</meta>
					</content>
					<extra>
						<link link="#card-members"><icon name="users"/> 2 Members</link>
					</extra>
				</card>
				<message slot="description" state="info" size="small">Fomantic's cards use a reveal or a dimmer to show more on hover; ours can't yet (see the notes below), so this card shows the plain image.</message>
			</example>
		</>
		<message size="small" class="site-not-ported">Not ported: a dimmer over a card's image (Fomantic's <text code>blurring dimmable image</> special cards) -- left out of the card sheet on purpose (dimmer looks inside cards), and <text code>&lt;ui-image&gt;</> holds no dimmer (I55).</>

		<section label="Header" sticky="stack" collapsible dividing>
			<example "Header" description="A card can contain a header.">
				<cards>
					<card>
						<content>
							<header>Elliot Fu</header>
							<meta>Friend</meta>
							<description>Elliot Fu is a film-maker from New York.</description>
						</content>
					</card>
					<card>
						<content>
							<header>Veronika Ossi</header>
							<meta>Friend</meta>
							<description>Veronika Ossi is a set designer living in New York who enjoys kittens, music, and partying.</description>
						</content>
					</card>
					<card>
						<content>
							<header>Jenny Hess</header>
							<meta>Friend</meta>
							<description>Jenny is a student studying Media Management at the New School</description>
						</content>
					</card>
				</cards>
			</example>
		</>

		<section label="Metadata" sticky="stack" collapsible dividing>
			<example "Metadata" description="A card can contain content metadata.">
				<card>
					<content>
						<header>Cute Dog</header>
						<meta>
							<text>2 days ago</text>
							<link link="#card-animals">Animals</link>
						</meta>
						<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
					</content>
				</card>
				<message slot="description" state="info" size="small">You can include any amount of metadata, in your own markup: the children of a <text code>&lt;ui-meta&gt;</text> are spaced for you.</message>
			</example>
		</>

		<!-- GAP I126:  an image link (`<a class="image" href>`) isn't laid out as the card's image;  the image is plain. -->
		<section label="Link" sticky="stack" collapsible dividing>
			<example "Link" description="A card can contain links as images, headers, or inside content.">
				<card>
					<image alt="Steve Jobes" src="/components/ui/images/avatar/large/steve.jpg"/>
					<content>
						<header link="#card-steve">Steve Jobes</header>
						<meta>
							<link link="#card-steve-seen">Last Seen 2 days ago</link>
						</meta>
					</content>
				</card>
				<message slot="description" state="info" size="small">To make the entire content of a card a link, see the Link Card variation below.</message>
			</example>
		</>

		<section label="Buttons" sticky="stack" collapsible dividing>
			<example "Buttons" description="A card can contain buttons.">
				<cards>
					<card>
						<content>
							<header>Elliot Fu</header>
							<description>Elliot Fu is a film-maker from New York.</description>
						</content>
						<extra>
							<button fluid icon="plus">Add Friend</button>
						</extra>
					</card>
					<card>
						<content>
							<header>Veronika Ossi</header>
							<description>Veronika Ossi is a set designer living in New York who enjoys kittens, music, and partying.</description>
						</content>
						<extra>
							<button fluid icon="plus">Add Friend</button>
						</extra>
					</card>
					<card>
						<content>
							<header>Jenny Hess</header>
							<description>Jenny is a student studying Media Management at the New School</description>
						</content>
						<extra>
							<button fluid icon="plus">Add Friend</button>
						</extra>
					</card>
				</cards>
				<message slot="description" size="small" class="site-not-ported">Not ported: a button attached to the card's bottom edge (<text code>.ui.card &gt; .button</text>). A <text code>&lt;ui-button&gt;</text> element has no box for the card to widen:  put a fluid button in a <text code>&lt;ui-extra&gt;</text>.</message>
			</example>
		</>

		<section label="Approval" sticky="stack" collapsible dividing>
			<example "Approval" description="A card can contain a like or star action.">
				<card>
					<content>
						<header>Cute Dog</header>
						<description>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						</description>
					</content>
					<extra>
						<stack direction="horizontal" justify="between">
							<button size="mini" icon="heart" appearance="basic">Like</button>
							<button size="mini" icon="star" appearance="basic">Favorite</button>
						</stack>
					</extra>
				</card>
				<message slot="description" size="small" class="site-not-ported">Not ported: the <text code>like</text> / <text code>star</text> icons that colour on hover -- left out of the card sheet on purpose; use real buttons, which take focus and say what they do.</message>
			</example>
		</>

		<section label="Description" sticky="stack" collapsible dividing>
			<example "Description" description="A card can contain a description with one or more paragraphs.">
				<card>
					<content>
						<header>Cute Dog</header>
						<meta>2 days ago</meta>
						<description>
							<text paragraph>Cute dogs come in a variety of shapes and sizes. Some cute dogs are cute for their adorable faces, others for their tiny stature, and even others for their massive size.</text>
							<text paragraph>Many people also have their own barometers for what makes a cute dog.</text>
						</description>
					</content>
				</card>
			</example>
		</>

		<section label="Extra Content" sticky="stack" collapsible dividing>
			<example "Extra Content" description="A card can contain extra content meant to be formatted separately from the main content.">
				<card>
					<content>
						<header>Cute Dog</header>
						<meta>2 days ago</meta>
						<description>
							<text paragraph>Cute dogs come in a variety of shapes and sizes. Some cute dogs are cute for their adorable faces, others for their tiny stature, and even others for their massive size.</text>
							<text paragraph>Many people also have their own barometers for what makes a cute dog.</text>
						</description>
					</content>
					<extra><icon name="check"/> 121 Votes</extra>
				</card>
			</example>
		</>

		<section label="Shorthand" sticky="stack" collapsible dividing>
			<example "Shorthand" description="The `image`, `header`, `meta`, `description` and `extra` attributes render the same parts without any markup;  `alt` describes the image.">
				<card image="../images/avatar2/large/kristy.png" alt="Kristy" heading="Kristy" meta="Joined in 2013" description="Kristy is an art director living in New York." extra="22 Friends"/>
			</example>
		</>
	</>

	<section label="States">
		<section label="Disabled" sticky="stack" collapsible dividing>
			<example "Disabled" description="A card may show its content is disabled.">
				<card disabled>
					<content>
						<header link="#card-kristy">Kristy</header>
						<meta>Joined in 2013</meta>
						<description>Kristy is an art director living in New York.</description>
					</content>
					<extra>
						<link link="#card-kristy-friends"><icon name="user"/> 22 Friends</link>
					</extra>
				</card>
			</example>
		</>

		<section label="Loading" sticky="stack" collapsible dividing>
			<example "Loading" description="A card may show its content is being loaded.">
				<card loading>
					<content>
						<header link="#card-kristy">Kristy</header>
						<meta>Joined in 2013</meta>
						<description>Kristy is an art director living in New York.</description>
					</content>
					<extra>
						<link link="#card-kristy-friends"><icon name="user"/> 22 Friends</link>
					</extra>
				</card>
			</example>

			<!-- GAP I127:  the loader takes no card colour, and there is no `double` or `usual`;  the brown card shows the plain loader. -->
			<example "Loading">
				<card color="brown" loading>
					<content>
						<header link="#card-kristy">Kristy</header>
						<meta>Joined in 2013</meta>
						<description>Kristy is an art director living in New York.</description>
					</content>
					<extra>
						<link link="#card-kristy-friends"><icon name="user"/> 22 Friends</link>
					</extra>
				</card>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Fluid Card" sticky="stack" collapsible dividing>
			<example "Fluid Card" description="A fluid card takes up the width of its container.">
				<grid columns="3">
					<column>
						<card fluid>
							<image alt="Daniel Louise" src="/components/ui/images/avatar/large/daniel.jpg"/>
							<content>
								<header link="#card-daniel">Daniel Louise</header>
							</content>
						</card>
					</column>
					<column>
						<card fluid>
							<image alt="Helen Troy" src="/components/ui/images/avatar/large/helen.jpg"/>
							<content>
								<header link="#card-helen">Helen Troy</header>
							</content>
						</card>
					</column>
					<column>
						<card fluid>
							<image alt="Elliot Fu" src="/components/ui/images/avatar/large/elliot.jpg"/>
							<content>
								<header link="#card-elliot">Elliot Fu</header>
							</content>
						</card>
					</column>
				</grid>
			</example>
		</>

		<section label="Centered Card" sticky="stack" collapsible dividing>
			<example "Centered Card" description="A card can center itself inside its container.">
				<card align="center">
					<image alt="Elyse" src="/components/ui/images/avatar2/large/elyse.png"/>
					<content>
						<header link="#card-elyse">Elyse</header>
					</content>
				</card>
			</example>
		</>

		<section label="Horizontal Cards" sticky collapsible dividing>
			<example "Horizontal Cards" description="A card can display horizontally.">
				<card direction="horizontal">
					<image alt="Elyse" src="/components/ui/images/avatar2/large/elyse.png"/>
					<content>
						<header>Cute Dog</header>
						<meta>Animals</meta>
						<description>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						</description>
					</content>
				</card>
			</example>

			<!-- GAP I129:  the horizontal cards sit one per row, not two side by side (each is 400px wide). -->
			<example "Horizontal Cards">
				<cards direction="horizontal">
					<card>
						<image alt="Matt Giampietro" src="/components/ui/images/avatar2/large/matthew.png"/>
						<content>
							<header>Matt Giampietro</header>
							<meta>
								<link link="#card-friends">Friends</link>
							</meta>
							<description>Matthew is an interior designer living in New York.</description>
						</content>
					</card>
					<card>
						<image alt="Molly" src="/components/ui/images/avatar2/large/molly.png"/>
						<content>
							<header>Molly</header>
							<meta>Coworker</meta>
							<description>Molly is a personal assistant living in Paris.</description>
						</content>
					</card>
				</cards>
			</example>
		</>

		<section label="Raised Card" sticky="stack" collapsible dividing>
			<example "Raised Card" description="A card may be formatted to raise above the page.">
				<card appearance="raised">
					<content>
						<header>Cute Dog</header>
						<meta>Animals</meta>
						<description>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						</description>
					</content>
					<extra><avatar src="/components/ui/images/avatar/small/matt.jpg" tooltip/> Matt</extra>
				</card>
			</example>
			<example "Raised Card">
				<card appearance="raised link">
					<content>
						<header>Cute Dog</header>
						<meta>Animals</meta>
						<description>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						</description>
					</content>
					<extra><avatar src="/components/ui/images/avatar/small/matt.jpg" tooltip/> Matt</extra>
				</card>
			</example>
		</>

		<section label="Link Card" sticky="stack" collapsible dividing>
			<example "Link Card" description="A card can be formatted so that the entire contents link to another page:  `link`.">
				<card link="#card-dog">
					<content>
						<header>Cute Dog</header>
						<meta>Animals</meta>
						<description>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						</description>
					</content>
					<extra><avatar src="/components/ui/images/avatar/small/matt.jpg" tooltip/> Matt</extra>
				</card>
			</example>
			<example "Link Card" description="`link` alone only adds the hover lift:  it's a look, not a link.">
				<card appearance="link">
					<content>
						<header>Cute Dog</header>
						<meta>Animals</meta>
						<description>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						</description>
					</content>
					<extra><avatar src="/components/ui/images/avatar/small/matt.jpg" tooltip/> Matt</extra>
				</card>
			</example>
		</>

		<!-- GAP I125:  only <ui-header> / <ui-content> float;  the meta's time and the author sit in line. -->
		<section label="Content at the Right" sticky="stack" collapsible dividing>
			<example "Content at the Right" description="Content has no `floated` any more:  a `<ui-stack>` puts the meta's time and the author at the right.">
				<card>
					<content>
						<header>Cute Dog</header>
						<meta>
							<stack direction="horizontal" justify="between">
								<text>Animals</text>
								<text>2 days ago</text>
							</stack>
						</meta>
						<description>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						</description>
					</content>
					<extra>
						<stack direction="horizontal" justify="end">
							<text><image avatar src="/components/ui/images/avatar/small/matt.jpg" alt=""/> Matt</text>
						</stack>
					</extra>
				</card>
			</example>
		</>

		<section label="Text Alignment" sticky="stack" collapsible dividing>
			<example "Text Alignment" description="Any element inside a card can have its text alignment specified:  `align`.">
				<card>
					<content align="center">
						<header>Jenny Hess</header>
						<description>
							<text paragraph>Jenny is a student studying Media Management at the New School</text>
						</description>
					</content>
					<extra><avatar src="/components/ui/images/avatar/small/jenny.jpg" tooltip/> Jenny</extra>
				</card>
			</example>
		</>

		<section label="Inverted" sticky="stack" collapsible dividing>
			<example "Inverted" description="Card's colors can be inverted.">
				<segment inverted>
					<cards inverted>
						<card>
							<image alt="Matt Giampietro" src="/components/ui/images/avatar2/large/matthew.png"/>
							<content>
								<header link="#card-matthew">Matt Giampietro</header>
								<meta>Friends</meta>
								<description>Matthew is an interior designer living in New York.</description>
							</content>
							<extra>Joined in 2013 · <icon name="user"/> 75 Friends</extra>
						</card>
						<card>
							<image alt="Molly" src="/components/ui/images/avatar2/large/molly.png"/>
							<content>
								<header link="#card-molly">Molly</header>
								<meta>Coworker</meta>
								<description>Molly is a personal assistant living in Paris.</description>
							</content>
							<extra>Joined in 2011 · <icon name="user"/> 35 Friends</extra>
						</card>
						<card>
							<image alt="Elyse" src="/components/ui/images/avatar2/large/elyse.png"/>
							<content>
								<header link="#card-elyse">Elyse</header>
								<meta>Coworker</meta>
								<description>Elyse is a copywriter working in New York.</description>
							</content>
							<extra>Joined in 2014 · <icon name="user"/> 151 Friends</extra>
						</card>
					</cards>
				</segment>
			</example>
		</>

		<section label="Colored" sticky="stack" collapsible dividing>
			<example "Colored" description="A card can specify a color:  a line along its bottom edge.">
				<cards columns="4">
					<card color="primary" link="#card-primary">
						<image alt="Primary" src="/components/ui/images/wireframe/white-image.png"/>
					</card>
					<card color="secondary" link="#card-secondary">
						<image alt="Secondary" src="/components/ui/images/wireframe/white-image.png"/>
					</card>
					<card color="red" link="#card-red">
