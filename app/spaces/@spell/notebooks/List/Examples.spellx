	<section label="Content Variations">
		<section label="Vertically Aligned" sticky collapsible dividing>
			<example "Vertically Aligned" description="An element inside a list can be vertically aligned:  `vertical-align` on a `<ui-content>` (or on the whole list).">
				<list direction="horizontal">
					<item image="../images/avatar/small/helen.jpg">
						<content vertical-align="top">Top Aligned</content>
					</item>
					<item image="../images/avatar/small/christian.jpg">
						<content vertical-align="middle">Middle</content>
					</item>
					<item image="../images/avatar/small/daniel.jpg">
						<content vertical-align="bottom">Bottom</content>
					</item>
				</list>
			</example>
		</>

		<section label="Left and Right" sticky="stack" collapsible dividing>
			<example "Left and Right" description="A list has no `floated` any more:  a `<ui-stack>` puts a button at the right of an item, or one list at the left and one at the right.">
				<list divided vertical-align="middle">
					<item>
						<stack direction="horizontal" justify="between">
							<stack direction="horizontal" spacing="sm">
								<image avatar src="/components/ui/images/avatar2/small/lena.png" alt=""/>
								<text>Lena</text>
							</stack>
							<button>Add</button>
