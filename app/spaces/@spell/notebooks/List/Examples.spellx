	<section label="Content Variations">
		<section label="Vertically Aligned" sticky collapsible dividing>
			<example description="An element inside a list can be vertically aligned:  `vertical-align` on a `<ui-content>` (or on the whole list).">
				<list direction="horizontal">
					<item image="../images/avatar/small/helen.jpg">
						<content vertical-align="top">Top Aligned</content>
					</item>
					<item image="../images/avatar/small/christian.jpg">
						<content vertical-align="middle">Middle</content>
					</item>
					<item image="../images/avatar/small/daniel.jpg">
						<content vertical-align="bottom">Bottom</content>
					</item>
				</list>
			</example>
		</>

		<section label="Left and Right" sticky="stack" collapsible dividing>
			<example description="A list has no `floated` any more:  a `<ui-stack>` puts a button at the right of an item, or one list at the left and one at the right.">
				<html>
					<ui-list divided vertical-align="middle">
						<ui-item>
							<ui-stack direction="horizontal" justify="between">
								<ui-stack direction="horizontal" spacing="sm">
									<ui-image avatar src="/components/ui/images/avatar2/small/lena.png" alt=""></ui-image>
									<span>Lena</span>
								</ui-stack>
								<ui-button>Add</ui-button>
							</ui-stack>
						</ui-item>
						<ui-item>
							<ui-stack direction="horizontal" justify="between">
								<ui-stack direction="horizontal" spacing="sm">
									<ui-image avatar src="/components/ui/images/avatar2/small/lindsay.png" alt=""></ui-image>
									<span>Lindsay</span>
								</ui-stack>
								<ui-button>Add</ui-button>
							</ui-stack>
						</ui-item>
						<ui-item>
							<ui-stack direction="horizontal" justify="between">
								<ui-stack direction="horizontal" spacing="sm">
									<ui-image avatar src="/components/ui/images/avatar2/small/mark.png" alt=""></ui-image>
									<span>Mark</span>
								</ui-stack>
								<ui-button>Add</ui-button>
							</ui-stack>
						</ui-item>
						<ui-item>
							<ui-stack direction="horizontal" justify="between">
								<ui-stack direction="horizontal" spacing="sm">
									<ui-image avatar src="/components/ui/images/avatar2/small/molly.png" alt=""></ui-image>
									<span>Molly</span>
								</ui-stack>
								<ui-button>Add</ui-button>
							</ui-stack>
						</ui-item>
					</ui-list>
				</html>
			</example>
			<example>
				<stack direction="horizontal" justify="between" wrap>
					<list direction="horizontal">
						<item link="#list">About Us</item>
						<item link="#list">Jobs</item>
					</list>
					<list direction="horizontal">
