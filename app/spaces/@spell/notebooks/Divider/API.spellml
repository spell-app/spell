<spell-notebook "divider api">
	<header level="1">
		Divider
		<header>A divider visually segments content into groups.</>
	</>
	<divider-tab-bar showing="api"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#attributes">Attributes</>
			<item link="#slots">Slots</>
			<item link="#parts">Parts</>
			<item link="#states">States</>
		</>
	</>

	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-divider" only="attributes"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api family="ui-divider" only="slots"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-divider" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-divider" only="states"></>
		</>
	</>
</spell-notebook>
