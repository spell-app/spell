<spell-notebook "toolbar examples">
	<header level="1">
		Toolbar
		<header>A toolbar is a horizontal menu whose items scroll sideways when they don't fit, with a button at each end while there's more to see that way.</>
	</>
	<toolbar-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#fitting-titles">Fitting titles</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's page, section by section, in its order (Types, Content, States, Variations,
		Groups ...).  Rules, the class-grammar mappings, gaps:  epics/spell-ui-pages/PAGES.md.
		- A section:  `<ui-section id="examples-types" label="Types" sticky="stack" collapsible dividing>` around
		  its examples;  ids spell out the nesting (`<tab>-<section>-<example>`, lowercase kebab of the headers).
		- An example:  its own nested section (`label` = the example's name) around
		  `<ui-example description="...">` and the live markup;  the markup IS the code shown.  A richer
		  description:  `<p slot="description">` (+ `<ui-message slot="description">`).  Fomantic's header-less
		  `.another.example`:  a second `<ui-example>` in the same section.
		- Or write it flat (`<ui-header level="2">`, `<ui-example heading>`) and run `yarn site:sections`:
		  it nests it and writes the ids (and fixes them after a title changes).
		- A gap:  an HTML comment `GAP I<n>:  ...` BEFORE the example's section (a comment inside the example
		  shows in its code).
	-->
	<section label="Types">
		<section label="Toolbar" sticky="stack" collapsible dividing>
			<example "Toolbar" description="A menu whose items don't fit scrolls sideways:  `‹` and `›` show at its ends while there's more that way.">
				<toolbar appearance="secondary" aria-label="Sections" style="max-width: 360px">
					<item link="#types" selected>Types</item>
					<item link="#groups">Groups</item>
					<item link="#content">Content</item>
					<item link="#states">States</item>
					<item link="#variations">Variations</item>
					<item link="#group-variations">Group Variations</item>
				</toolbar>
			</example>
		</>

		<section label="Segmented" sticky="stack" collapsible dividing>
			<example "Segmented" description="The segmented appearance:  a segmented control that scrolls;  its chosen thumb slides as the choice moves.">
				<toolbar appearance="segmented" aria-label="Views" style="max-width: 320px">
					<item selected>Examples</item>
					<item>Usage</item>
					<item>API</item>
					<item>Theming</item>
					<item>Accessibility</item>
					<item>History</item>
				</toolbar>
			</example>
		</>

		<section label="Everything fits" sticky="stack" collapsible dividing>
			<example "Everything fits" description="When every item fits, no buttons show:  it's a plain menu.">
				<toolbar appearance="secondary" aria-label="Short">
					<item link="#one" selected>One</item>
					<item link="#two">Two</item>
					<item link="#three">Three</item>
				</toolbar>
			</example>
		</>

		<section label="Top bar" sticky="stack" collapsible dividing>
			<example "Top bar" description="A bar's slots:  `icon` and `title` at the start, `center` taking the room left, `right` at the end.  A slot with nothing in it takes no room.">
				<toolbar appearance="secondary" aria-label="App">
					<button slot="icon" icon="bars" aria-label="Menu" title="Menu" appearance="basic circular"/>
					<text slot="title" bold>Spell UI</text>
					<item link="#guides" selected>Guides</item>
					<item link="#components">Components</item>
					<item link="#themes">Themes</item>
					<button slot="right" icon="search" aria-label="Search" title="Search" appearance="basic circular"/>
				</toolbar>
			</example>
		</>
	</>

	<section label="Fitting titles">
		<section label="Shrinkable" sticky="stack" collapsible dividing>
			<example "Shrinkable" description="`shrinkable` fits the titles instead of scrolling:  drag the box's right edge narrower.  Whole, then the longest cut with `…`, then icons only, then one `…` button whose menu holds every item;  no `‹` / `›`.  The bell, an item with no words, stays at every width.">
				<stack style="resize: horizontal; overflow: hidden; box-sizing: border-box; width: 600px; max-width: 100%; min-width: 60px; padding: 4px; border: 1px dashed var(--ui-border-color)">
					<toolbar shrinkable appearance="secondary" label="Sections">
						<item link="#types" icon="shapes" selected>Types</item>
						<item link="#content" icon="font">Content</item>
						<item link="#variations" icon="sliders">Variations</item>
						<item link="#group-variations">Group variations</item>
						<item link="#notes" icon="bell" label="Notes"/>
					</toolbar>
				</stack>
			</example>
		</>
	</>
</spell-notebook>
