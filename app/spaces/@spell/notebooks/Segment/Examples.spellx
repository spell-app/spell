		<section label="Size" sticky="stack" collapsible dividing>
			<example description="A segment can vary in size.">
				<segment size="mini">Mini</segment>
				<segment size="tiny">Tiny</segment>
				<segment size="small">Small</segment>
				<segment size="large">Large</segment>
				<segment size="big">Big</segment>
				<segment size="huge">Huge</segment>
				<segment size="massive">Massive</segment>
			</example>
		</>
	</>
