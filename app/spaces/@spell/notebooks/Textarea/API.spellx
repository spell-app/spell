<spell-notebook "textarea api">
	<header level="1">
		Textarea
		<header>A textarea is a multi-line field used to elicit a longer response.</>
	</>
	<textarea-tab-bar showing="api"/>
	<section>
		<html>
			<ui-menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
				<ui-item link="#attributes">Attributes</>
				<ui-item link="#properties">Properties</>
				<ui-item link="#events">Events</>
				<ui-item link="#parts">Parts</>
				<ui-item link="#states">States</>
			</>
		</>
	</>

	<!-- API:  `<ui-textarea>`'s tables (`docs/__data/components.json5`);  the whole family's are on the input page. -->
	<section label="Attributes">
		<html>
			<ui-docs-api tag="ui-textarea" only="attributes"></>
		</>
	</>

	<section label="Properties">
		<html>
			<ui-docs-api tag="ui-textarea" only="properties"></>
		</>
	</>

	<section label="Events">
		<html>
			<ui-docs-api tag="ui-textarea" only="events"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api tag="ui-textarea" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api tag="ui-textarea" only="states"></>
		</>
	</>
</spell-notebook>
