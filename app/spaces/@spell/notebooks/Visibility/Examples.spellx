<spell-notebook "visibility examples">
	<header level="1">
		Visibility
		<header>Visibility provides a set of callbacks for when content appears in the viewport.</>
	</>
	<visibility-tab-bar showing="examples"/>
	<section>
		<html>
			<ui-menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
				<ui-item link="#usage">Usage</>
				<ui-item link="#callbacks">Callbacks</>
				<ui-item link="#examples">Examples</>
			</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's page, section by section, in its order (Types, Content, States, Variations,
		Groups ...).  Rules, the class-grammar mappings, gaps:  packages/docs/content/epics/spell-ui-pages/PAGES.md.
		- A section:  `<ui-header level="2" dividing id="types">Types</ui-header>`, then its examples.
		- An example:  `<ui-example heading="..." description="...">` around the live markup;  the markup
		  IS the code shown.  A richer description:  `<p slot="description">` (+ `<ui-message slot="description">`).
		- A gap:  an HTML comment `GAP I<n>:  ...` BEFORE the example (a comment inside it shows in its code).
	-->
	<section label="Usage">
		<section label="How To Use" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">Visibility reports an element's position on screen: wrap the content in <code>&lt;ui-visibility&gt;</code> and listen for its events, each with the calculations as <code>detail</code>. Scroll the page and watch the table: it updates at every check.</p>
					<ui-message slot="description" state="info" size="small">Checks happen when something crosses (the element entering or leaving, an edge crossing the screen's top or bottom), not on every scrolled pixel: visibility runs on <code>IntersectionObserver</code>, with no scroll listener. The table beside the demo is filled by this page's script from the events.</ui-message>
					<ui-grid columns="2" stackable>
						<ui-column>
							<ui-visibility id="visibility-demo" once="false" continuous>
								<ui-segment>
									<ui-image src="/components/ui/images/wireframe/centered-paragraph.png" alt=""></ui-image>
									<ui-divider></ui-divider>
									<ui-image src="/components/ui/images/wireframe/short-paragraph.png" alt=""></ui-image>
									<ui-divider></ui-divider>
									<ui-image src="/components/ui/images/wireframe/media-paragraph.png" alt=""></ui-image>
									<ui-divider></ui-divider>
									<ui-image src="/components/ui/images/wireframe/paragraph.png" alt=""></ui-image>
									<ui-divider></ui-divider>
									<ui-image src="/components/ui/images/wireframe/centered-paragraph.png" alt=""></ui-image>
									<ui-divider></ui-divider>
									<ui-image src="/components/ui/images/wireframe/short-paragraph.png" alt=""></ui-image>
									<ui-divider></ui-divider>
									<ui-image src="/components/ui/images/wireframe/media-paragraph.png" alt=""></ui-image>
									<ui-divider></ui-divider>
									<ui-image src="/components/ui/images/wireframe/paragraph.png" alt=""></ui-image>
								</ui-segment>
							</ui-visibility>
						</ui-column>
						<ui-column>
							<ui-sticky offset="64">
								<ui-table appearance="basic" celled padding="compact" unstackable>
									<table>
										<thead>
											<tr>
												<th>Calculation</th>
												<th>Value</th>
											</tr>
										</thead>
										<tbody id="visibility-calculations">
											<tr data-key="pixelsPassed">
												<td>pixelsPassed</td>
												<td></td>
											</tr>
											<tr data-key="percentagePassed">
												<td>percentagePassed</td>
												<td></td>
											</tr>
											<tr data-key="onScreen">
												<td>onScreen</td>
												<td></td>
											</tr>
											<tr data-key="offScreen">
												<td>offScreen</td>
												<td></td>
											</tr>
											<tr data-key="passing">
												<td>passing</td>
												<td></td>
											</tr>
											<tr data-key="topVisible">
												<td>topVisible</td>
												<td></td>
											</tr>
											<tr data-key="bottomVisible">
												<td>bottomVisible</td>
												<td></td>
											</tr>
											<tr data-key="topPassed">
												<td>topPassed</td>
												<td></td>
											</tr>
											<tr data-key="bottomPassed">
												<td>bottomPassed</td>
												<td></td>
											</tr>
											<tr data-key="direction">
												<td>direction</td>
												<td></td>
											</tr>
										</tbody>
									</table>
								</ui-table>
							</ui-sticky>
						</ui-column>
					</ui-grid>
				</html>
			</example>
		</>

		<section label="Changing Callback Frequency" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">By default each event fires only <b>the first time</b> its conditions are met: <code>once="false"</code> fires it each time its condition <b>becomes true</b>, and <code>continuous</code> at every check while it holds. Each segment below counts its <code>ui-top-in-view</code> events: scroll them out of view and back.</p>
				</html>
				<visibility class="visibility-counter">
					<segment>Default (once): <label size="small">0</label></segment>
				</visibility>
				<html>
					<ui-visibility class="visibility-counter" once="false">
						<ui-segment><code>once="false"</code>: <ui-label size="small">0</ui-label></ui-segment>
					</ui-visibility>
					<ui-visibility class="visibility-counter" once="false" continuous>
						<ui-segment><code>once="false" continuous</code>: <ui-label size="small">0</ui-label></ui-segment>
					</ui-visibility>
				</html>
			</example>
		</>
	</>

	<section label="Callbacks">
		<section label="Standard Events" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">Events occur at the first check where their conditions turn true, each Fomantic's callback as a <code>ui-*</code> event. The log below shows the demo's events as you scroll past it.</p>
					<ui-table slot="description" celled definition padding="compact">
						<table>
							<thead>
								<tr>
									<th>Event</th>
									<th>Fomantic's callback</th>
									<th>Occurs</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td>
										<code>ui-in-view</code>
									</td>
									<td>
										<code>onOnScreen</code>
									</td>
									<td>Any part of the element is on screen</td>
								</tr>
								<tr>
									<td>
										<code>ui-out-of-view</code>
									</td>
									<td>
										<code>onOffScreen</code>
									</td>
									<td>No part of the element is on screen</td>
								</tr>
								<tr>
									<td>
										<code>ui-top-in-view</code>
									</td>
									<td>
										<code>onTopVisible</code>
									</td>
									<td>The element's top edge has passed the bottom of the screen</td>
								</tr>
								<tr>
									<td>
										<code>ui-top-passed</code>
									</td>
									<td>
										<code>onTopPassed</code>
									</td>
									<td>The element's top edge has passed the top of the screen</td>
								</tr>
								<tr>
									<td>
										<code>ui-bottom-in-view</code>
									</td>
									<td>
										<code>onBottomVisible</code>
									</td>
									<td>The element's bottom edge has passed the bottom of the screen</td>
								</tr>
								<tr>
									<td>
										<code>ui-passing</code>
									</td>
									<td>
										<code>onPassing</code>
									</td>
									<td>The element spans the top of the screen</td>
								</tr>
								<tr>
									<td>
										<code>ui-bottom-passed</code>
									</td>
									<td>
										<code>onBottomPassed</code>
									</td>
									<td>The element's bottom edge has passed the top of the screen</td>
								</tr>
							</tbody>
						</table>
					</ui-table>
				</html>
				<visibility id="visibility-logged" once="false">
					<segment>
						<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						<divider/>
						<image src="/components/ui/images/wireframe/short-paragraph.png" alt=""/>
					</segment>
				</visibility>
				<segment appearance="secondary">
					<list id="visibility-log" divided size="small">
						<item>Scroll the page: events appear here, newest first.</item>
					</list>
				</segment>
			</example>
		</>

		<!-- GAP I112:  no grouped `onPassed` thresholds (pixels / percentages);  shown as a note. -->
		<html>
			<ui-message size="small" class="site-not-ported">Not yet: Grouped Events -- Fomantic's <code>onPassed: &#123; 40: fn, "80%": fn &#125;</>, callbacks after a distance into the element. There is no event or <code>UI.observeVisibility()</> option for them.</>
		</>

		<section label="Reverse Events" sticky collapsible dividing>
			<example description="Reverse events occur under the same conditions, but as the user scrolls back up the page: `UI.observeVisibility(element, options)` takes Fomantic's `...Reverse` callbacks (the element has no events for them). The log shows this demo's reverse callbacks.">
				<segment id="visibility-reversed">
					<image src="/components/ui/images/wireframe/media-paragraph.png" alt=""/>
				</segment>
				<segment appearance="secondary">
					<list id="visibility-reverse-log" divided size="small">
						<item>Scroll past, then back up: reverse callbacks appear here.</item>
					</list>
				</segment>
			</example>
		</>
	</>

	<section label="Examples">
		<!-- C19:  items stack inside the docs column (under 768px), so these are unstackable (a 125px image). -->
		<section label="Lazy Loading Images" sticky collapsible dividing>
			<example description="`type=\"image\"` lazy-loads every `<img data-src>` inside:  once its top is on screen, its data-src becomes its src;  keep a placeholder in src so the content doesn't jump when an image loads, or leave it out and have the image appear. Images fade in by default: `animation`, every element's, names another (or none), and `duration` its length.">
				<html>
					<ui-visibility type="image" animation="fade" duration="1000">
						<ui-items divided unstackable>
							<ui-item>
								<img src="/components/ui/images/wireframe/square-image.png" data-src="images/avatar/large/elliot.jpg" alt="Elliot Fu" />
