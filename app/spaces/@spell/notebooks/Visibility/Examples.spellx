		</>
		<message size="small" class="site-not-ported">Not ported: Gradual Changes, per-pixel <text code>onPassing</> updates (checks happen at crossings only). For a style that follows the scroll, use CSS scroll-driven animations (<text code>animation-timeline: view()</>), which need no script at all.</>
		<message size="small" class="site-not-ported">Not ported: Fixing Content To Viewport (<text code>type: 'fixed'</>) -- that's <link link="/components/ui/ui-sticky.html"><text code>&lt;ui-sticky&gt;</></>, on CSS <text code>position: sticky</> with no placeholder element.</>

		<section label="Infinite Scroll" sticky="stack" collapsible dividing>
			<example "Infinite Scroll" description="As an alternative to pagination, listen for `ui-bottom-in-view` with `once=\"false\"` and load more content when the bottom of a container is reached. Here its list adds three items each time, up to twelve.">
				<visibility-endless-list/>
			</example>
		</>
	</>
</spell-notebook>

<!-- Examples › Infinite Scroll's list:  three more items each time its bottom comes into view, up to twelve -->
<spell-view "endless list">
	<property "shown" description="How many of its twelve items show">a number</>
	<property "loading">yes or no</>
	<action "create it">set its shown to 3</>
	<action "load more" description="Three more items, after a moment's loading, until all twelve show">
		if its shown >= 12 return
		set its loading to yes
		pause for 0.5 seconds
		set its shown to its shown + 3
		set its loading to no
	</action>
	<draw>
		<visibility once="false" on-ui-bottom-in-view={load more}>
			<segment>
				<header level="3" align="center">Infinite Scroll Example</header>
				<list divided spacing="lg">
					<item>Item 1</item>
					<item>Item 2</item>
					<item>Item 3</item>
					<item visible={its shown >= 4}>Item 4</item>
					<item visible={its shown >= 5}>Item 5</item>
					<item visible={its shown >= 6}>Item 6</item>
					<item visible={its shown >= 7}>Item 7</item>
					<item visible={its shown >= 8}>Item 8</item>
					<item visible={its shown >= 9}>Item 9</item>
					<item visible={its shown >= 10}>Item 10</item>
					<item visible={its shown >= 11}>Item 11</item>
					<item visible={its shown >= 12}>Item 12</item>
				</list>
				<loader inline align="center" size="small" visible={its loading}/>
			</segment>
		</visibility>
	</draw>
</spell-view>
