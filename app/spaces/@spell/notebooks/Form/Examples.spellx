							</ui-field>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Width" sticky collapsible dividing>
			<example description="A field can specify its width in grid columns:  `width` takes columns of 16.">
				<html>
					<ui-form>
						<form method="dialog">
							<ui-fields>
								<ui-field width="6">
									<label for="form-first-name-74">First name</label>
