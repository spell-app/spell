<spell-notebook "form examples">
	<header level="1">
		Form
		<header>A form displays a set of related user input fields in a structured way.</>
	</>
	<form-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#content">Content</>
			<item link="#form-states">Form States</>
			<item link="#field-states">Field States</>
			<item link="#form-variations">Form Variations</>
			<item link="#field-variations">Field Variations</>
			<item link="#group-variations">Group Variations</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's form page, section by section, in its order (Types, Content, Form States, Field States, Form
		Variations, Field Variations, Group Variations).  `<ui-form>` wraps a NATIVE `<form>` (`method="dialog"` here, so a
		valid submit doesn't leave the page);  each `<label for>` names its control.  Fomantic's 250-country lists are
		shortened to twenty.  `GAP I<n>` comments mark examples a widget can't render yet (plan-doc issues).
		The site's root says `stack-with="page"`:  rows stack below 768px of the SCREEN, as Fomantic's.
	-->
	<section label="Types">
		<section label="Form" sticky="stack" collapsible dividing>
			<example "Form" description="A form: `<ui-form>` around a native `<form>`.">
				<form>
					<field label="First Name">
						<input id="form-first-name-1" name="first-name" placeholder="First Name"/>
					</field>
					<field label="Last Name">
						<input id="form-last-name-2" name="last-name" placeholder="Last Name"/>
					</field>
					<field>
						<checkbox name="terms">I agree to the Terms and Conditions</checkbox>
					</field>
					<button type="submit">Submit</button>
				</form>
				<message slot="description" state="warning" size="small">Looking for validation? It is built in: see Validation on the Usage tab.</message>
			</example>
			<example "Form">
				<form>
					<header level="4" dividing>Shipping Information</header>
					<field label="Name">
						<fields widths="2">
							<field>
								<input id="form-ship-first-3" name="shipping\[first-name]" placeholder="First Name"/>
							</field>
							<field>
								<input name="shipping\[last-name]" placeholder="Last Name" aria-label="Last Name"/>
							</field>
						</fields>
					</field>
					<field label="Billing Address">
						<fields>
							<field width="12">
								<input id="form-ship-address-5" name="shipping\[address]" placeholder="Street Address"/>
							</field>
							<field width="4">
								<input name="shipping\[address-2]" placeholder="Apt #" aria-label="Apartment"/>
							</field>
						</fields>
					</field>
					<fields widths="2">
						<field label="State">
							<dropdown id="form-ship-state-7" fluid selection placeholder="State" name="shipping\[state]">
								<item value="AL">Alabama</item>
								<item value="AK">Alaska</item>
								<item value="AZ">Arizona</item>
								<item value="AR">Arkansas</item>
								<item value="CA">California</item>
								<item value="CO">Colorado</item>
								<item value="CT">Connecticut</item>
								<item value="DE">Delaware</item>
								<item value="FL">Florida</item>
								<item value="GA">Georgia</item>
							</dropdown>
						</field>
						<field label="Country">
							<dropdown id="form-ship-country-8" fluid search selection placeholder="Select Country" name="country">
								<item value="af" flag="af">Afghanistan</item>
								<item value="ax" flag="ax">Åland Islands</item>
								<item value="al" flag="al">Albania</item>
								<item value="dz" flag="dz">Algeria</item>
								<item value="as" flag="as">American Samoa</item>
								<item value="ad" flag="ad">Andorra</item>
								<item value="ao" flag="ao">Angola</item>
								<item value="ai" flag="ai">Anguilla</item>
								<item value="ar" flag="ar">Argentina</item>
								<item value="am" flag="am">Armenia</item>
								<item value="au" flag="au">Australia</item>
								<item value="at" flag="at">Austria</item>
								<item value="be" flag="be">Belgium</item>
								<item value="br" flag="br">Brazil</item>
								<item value="ca" flag="ca">Canada</item>
								<item value="fr" flag="fr">France</item>
								<item value="de" flag="de">Germany</item>
								<item value="jp" flag="jp">Japan</item>
								<item value="gb" flag="gb">United Kingdom</item>
								<item value="us" flag="us">United States</item>
							</dropdown>
						</field>
					</fields>
					<header level="4" dividing>Billing Information</header>
					<field label="Card Type">
						<dropdown id="form-card-type-9" selection placeholder="Type" name="card\[type]">
							<item value="visa" icon="cc visa">Visa</item>
							<item value="amex" icon="cc amex">American Express</item>
							<item value="discover" icon="cc discover">Discover</item>
						</dropdown>
					</field>
					<fields>
						<field label="Card Number" width="7">
							<input id="form-card-number-10" name="card\[number]" maxlength="16" placeholder="Card #"/>
						</field>
						<field label="CVC" width="3">
							<input id="form-card-cvc-11" name="card\[cvc]" maxlength="3" placeholder="CVC"/>
						</field>
						<field label="Expiration" width="6">
							<fields>
								<field width="8">
									<dropdown id="form-card-month-12" fluid search selection placeholder="Month" name="card\[expire-month]">
										<item value="1">January</item>
										<item value="2">February</item>
										<item value="3">March</item>
										<item value="4">April</item>
										<item value="5">May</item>
										<item value="6">June</item>
										<item value="7">July</item>
										<item value="8">August</item>
										<item value="9">September</item>
										<item value="10">October</item>
										<item value="11">November</item>
										<item value="12">December</item>
									</dropdown>
								</field>
								<field>
									<input name="card\[expire-year]" maxlength="4" placeholder="Year" aria-label="Expiration year"/>
								</field>
							</fields>
						</field>
					</fields>
					<header level="4" dividing>Receipt</header>
					<field label="Send Receipt To:">
						<dropdown id="form-receipt-14" fluid multiple search selection placeholder="Saved Contacts" name="receipt">
							<item value="jenny" image="../images/avatar/small/jenny.jpg">Jenny Hess</item>
							<item value="elliot" image="../images/avatar/small/elliot.jpg">Elliot Fu</item>
							<item value="stevie" image="../images/avatar/small/stevie.jpg">Stevie Feliciano</item>
							<item value="christian" image="../images/avatar/small/christian.jpg">Christian</item>
							<item value="matt" image="../images/avatar/small/matt.jpg">Matt</item>
							<item value="justen" image="../images/avatar/small/justen.jpg">Justen Kitsune</item>
						</dropdown>
					</field>
					<segment>
						<field>
							<checkbox appearance="toggle" name="gift">Do not include a receipt in the package</checkbox>
						</field>
					</segment>
					<button type="submit">Submit Order</button>
				</form>
			</example>
		</>
	</>

	<section label="Content">
		<section label="Field" sticky="stack" collapsible dividing>
			<example "Field" description="A field is a form element containing a label and an input.">
				<form>
					<field label="User Input">
						<input id="form-user-input-15"/>
					</field>
				</form>
			</example>
		</>

		<section label="Label Row" sticky="stack" collapsible dividing>
			<example "Label Row" description="A field can draw its own label row:  the label, an output at its end and a tip behind an info icon;  a hint goes under the control.">
				<form>
					<field label="Text size" output="16px" description="The size of body text;  headings scale from it." hint="13 to 19 pixels.">
						<slider min="13" max="19" value="16"/>
					</field>
				</form>
			</example>
		</>

		<section label="Actions" sticky="stack" collapsible dividing>
			<example "Actions" description="Small buttons in the label row's actions slot;  a taller one never grows the row.">
				<form>
					<field label="Accent colour" output="#6550CA">
						<button slot="actions" size="mini" appearance="basic">Reset</button>
						<input value="#6550CA"/>
					</field>
				</form>
			</example>
		</>

		<section label="Error" sticky="stack" collapsible dividing>
			<example "Error" description="A field shows its error as a line under the control;  the form's validation shows its own there.">
				<form>
					<field label="Hex" error="That isn't a colour.">
						<input value="#12"/>
					</field>
				</form>
			</example>
		</>

		<section label="Fields" sticky="stack" collapsible dividing>
			<example "Fields" description="A set of fields can appear grouped together: `<ui-fields>`.">
				<form>
					<fields>
						<field label="First name">
							<input id="form-first-name-16" placeholder="First Name"/>
						</field>
						<field label="Middle name">
							<input id="form-middle-name-17" placeholder="Middle Name"/>
						</field>
						<field label="Last name">
							<input id="form-last-name-18" placeholder="Last Name"/>
						</field>
					</fields>
				</form>
				<message slot="description" state="positive" size="small">Field groups automatically receive responsive styling, swapping to one field per row below 768px of the FORM's width, or of the screen with <text code>stack-with="page"</text> (as on this site). Add <text code>unstackable</text> to keep a row.</message>
			</example>
			<example "Fields" description="`widths=\"3\"` shares the row equally between three fields.">
				<form>
					<fields widths="3">
						<field label="First name">
							<input id="form-first-name-19" placeholder="First Name"/>
						</field>
						<field label="Middle name">
							<input id="form-middle-name-20" placeholder="Middle Name"/>
						</field>
						<field label="Last name">
							<input id="form-last-name-21" placeholder="Last Name"/>
						</field>
					</fields>
				</form>
			</example>
			<example "Fields">
				<form>
					<fields inline>
						<field label="Name" width="8">
							<input id="form-inline-name-22" placeholder="First Name"/>
						</field>
						<field width="3">
							<input placeholder="Middle Name" aria-label="Middle Name"/>
						</field>
						<field width="5">
							<input placeholder="Last Name" aria-label="Last Name"/>
						</field>
					</fields>
				</form>
			</example>
		</>

		<section label="Text Area" sticky="stack" collapsible dividing>
			<example "Text Area">
				<form>
					<field label="Text">
						<textarea id="form-text-23"/>
					</field>
					<field label="Short Text">
						<textarea id="form-short-text-24" rows="2"/>
					</field>
				</form>
				<text slot="description" paragraph>A <link target="src-spell-app-dev-ui-components-ui-textarea-html" link="/components/ui/ui-textarea.html">textarea</link> can be used to allow for extended user input: <text code>&lt;ui-textarea&gt;</text>.</text>
				<message slot="description" state="info" size="small">To specify an approximate text area size use the <text code>rows</text> attribute.</message>
			</example>
		</>

		<section label="Checkbox" sticky="stack" collapsible dividing>
			<example "Checkbox">
				<form>
					<field inline>
						<checkbox>Checkbox</checkbox>
					</field>
					<field inline>
						<checkbox appearance="slider">Slider</checkbox>
					</field>
					<field inline>
						<checkbox appearance="toggle">Toggle</checkbox>
					</field>
				</form>
				<text slot="description" paragraph>A form can contain a <link target="src-spell-app-dev-ui-components-ui-checkbox-html" link="/components/ui/ui-checkbox.html">checkbox</link>.</text>
				<message slot="description" state="info" size="small">UI checkboxes are special, styled versions of standard HTML checkboxes. They need no script to start.</message>
			</example>
		</>

		<section label="Radio Checkbox" sticky="stack" collapsible dividing>
			<example "Radio Checkbox">
				<html>
					<ui-form>
						<ui-fields inline role="radiogroup" aria-labelledby="form-fruit-label-25">
							<label id="form-fruit-label-25">Select your favorite fruit:</label>
							<ui-field>
								<ui-radio name="fruit" value="apples" selected>Apples</ui-radio>
							</ui-field>
							<ui-field>
								<ui-radio name="fruit" value="oranges">Oranges</ui-radio>
							</ui-field>
							<ui-field>
								<ui-radio name="fruit" value="pears">Pears</ui-radio>
							</ui-field>
							<ui-field>
								<ui-radio name="fruit" value="grapefruit">Grapefruit</ui-radio>
							</ui-field>
						</ui-fields>
						<ui-fields grouped role="radiogroup" aria-labelledby="form-fruit2-label-26">
							<label id="form-fruit2-label-26">Select your second favorite fruit:</label>
							<ui-field>
								<ui-radio name="fruit2" value="apples" selected>Apples</ui-radio>
							</ui-field>
							<ui-field>
								<ui-radio name="fruit2" value="oranges">Oranges</ui-radio>
							</ui-field>
							<ui-field>
								<ui-radio name="fruit2" value="pears">Pears</ui-radio>
							</ui-field>
							<ui-field>
								<ui-radio name="fruit2" value="grapefruit">Grapefruit</ui-radio>
							</ui-field>
						</ui-fields>
					</ui-form>
				</html>
				<text slot="description" paragraph>A form can include a <link target="src-spell-app-dev-ui-components-ui-radio-html" link="/components/ui/ui-radio.html">radio checkbox</link>: <text code>&lt;ui-radio&gt;</text>.</text>
			</example>
		</>

		<section label="Dropdown" sticky="stack" collapsible dividing>
			<example "Dropdown">
				<form>
					<field label="Gender">
						<dropdown id="form-gender-27" selection placeholder="Gender" name="gender">
							<item value="1">Male</item>
							<item value="0">Female</item>
						</dropdown>
					</field>
				</form>
				<text slot="description" paragraph>A form can contain a <link target="src-spell-app-dev-ui-components-ui-dropdown-html" link="/components/ui/ui-dropdown.html">dropdown</link>.</text>
				<message slot="description" state="info" size="small">A <text code>&lt;ui-dropdown&gt;</text> is form-associated: its name and value submit with the form, no hidden input needed.</message>
			</example>
			<example "Dropdown">
				<form>
					<field label="Country">
						<dropdown id="form-country-28" search selection placeholder="Select Country" name="country">
							<item value="af">Afghanistan</item>
							<item value="ax">Åland Islands</item>
							<item value="al">Albania</item>
							<item value="dz">Algeria</item>
							<item value="as">American Samoa</item>
							<item value="ad">Andorra</item>
							<item value="ao">Angola</item>
							<item value="ai">Anguilla</item>
							<item value="ar">Argentina</item>
							<item value="am">Armenia</item>
							<item value="au">Australia</item>
							<item value="at">Austria</item>
							<item value="be">Belgium</item>
							<item value="br">Brazil</item>
							<item value="ca">Canada</item>
							<item value="fr">France</item>
							<item value="de">Germany</item>
							<item value="jp">Japan</item>
							<item value="gb">United Kingdom</item>
							<item value="us">United States</item>
						</dropdown>
					</field>
				</form>
			</example>
		</>

		<section label="Multiple Select" sticky="stack" collapsible dividing>
			<example "Multiple Select" description="A multiple select is used to include several choices with one form field.">
				<form>
					<field label="Country">
						<dropdown id="form-countries-29" multiple selection placeholder="Select Country" name="countries">
							<item value="af">Afghanistan</item>
							<item value="ax">Åland Islands</item>
							<item value="al">Albania</item>
							<item value="dz">Algeria</item>
							<item value="as">American Samoa</item>
							<item value="ad">Andorra</item>
							<item value="ao">Angola</item>
							<item value="ai">Anguilla</item>
							<item value="ar">Argentina</item>
							<item value="am">Armenia</item>
							<item value="au">Australia</item>
							<item value="at">Austria</item>
							<item value="be">Belgium</item>
							<item value="br">Brazil</item>
							<item value="ca">Canada</item>
							<item value="fr">France</item>
							<item value="de">Germany</item>
							<item value="jp">Japan</item>
							<item value="gb">United Kingdom</item>
							<item value="us">United States</item>
						</dropdown>
					</field>
				</form>
			</example>
		</>

		<section label="HTML Select" sticky="stack" collapsible dividing>
			<example "HTML Select" description="If a script-driven dropdown is not a viable option, `<ui-select>` styles the browser's own select element.">
				<form>
					<field>
						<select placeholder="Gender" name="gender" aria-label="Gender">
							<item value="1">Male</item>
							<item value="0">Female</item>
						</select>
					</field>
				</form>
			</example>
		</>

		<section label="Calendar" sticky="stack" collapsible dividing>
			<example "Calendar">
				<form>
					<field label="Date">
						<calendar id="form-date-30" type="date" placeholder="Pick up a date" name="date"/>
					</field>
				</form>
				<text slot="description" paragraph>A form can contain a <link target="src-spell-app-dev-ui-components-ui-calendar-html" link="/components/ui/ui-calendar.html">calendar</link>.</text>
			</example>
		</>

		<section label="Message" sticky="stack" collapsible dividing>
			<example "Message">
				<form>
					<message heading="We had some issues">
						<list bulleted>
							<item>Please enter your first name</item>
							<item>Please enter your last name</item>
						</list>
					</message>
				</form>
				<text slot="description" paragraph>A form can contain a <link target="src-spell-app-dev-ui-components-ui-message-html" link="/components/ui/ui-message.html">message</link>.</text>
				<message slot="description" state="info" size="small">A message inside a form is hidden until the form is in its state: info, error, success or warning. A message with no <text code>state</text> always shows.</message>
			</example>
		</>
	</>

	<section label="Form States">
		<!-- GAP I124:  Fomantic's second form, `ui blue double loading form`, has no colour or loader style. -->
		<section label="Loading" sticky="stack" collapsible dividing>
			<example "Loading" description="If a form is in loading state, it will automatically show a loading indicator.">
				<form loading>
					<field label="E-mail">
						<input id="form-e-mail-31" type="email" placeholder="joe@schmoe.com"/>
					</field>
					<button type="submit">Submit</button>
				</form>
			</example>
		</>

		<section label="Success" sticky="stack" collapsible dividing>
			<example "Success" description="If a form is in an success state, it will automatically show any success message blocks.">
				<form state="success">
					<field label="E-mail">
						<input id="form-e-mail-32" type="email" placeholder="joe@schmoe.com"/>
					</field>
					<message state="success" heading="Form Completed">
						<text paragraph>You're all signed up for the newsletter.</text>
					</message>
					<button type="submit">Submit</button>
				</form>
			</example>
		</>

		<section label="Error" sticky="stack" collapsible dividing>
			<example "Error" description="If a form is in an error state, it will automatically show any error message blocks.">
				<form state="error">
					<field label="E-mail">
						<input id="form-e-mail-33" type="email" placeholder="joe@schmoe.com"/>
					</field>
					<message state="error" heading="Action Forbidden">
						<text paragraph>You can only sign up for an account once with a given e-mail address.</text>
					</message>
					<button type="submit">Submit</button>
				</form>
			</example>
		</>

		<section label="Warning" sticky="stack" collapsible dividing>
			<example "Warning" description="If a form is in warning state, it will automatically show any warning message block.">
				<form state="warning">
					<field label="E-mail">
						<input id="form-e-mail-34" type="email" placeholder="joe@schmoe.com"/>
					</field>
					<message state="warning" heading="Could you check something!">
						<list bulleted>
							<item>That e-mail has been subscribed, but you have not yet clicked the verification link in your e-mail.</item>
						</list>
					</message>
					<button type="submit">Submit</button>
				</form>
			</example>
		</>

		<section label="Info" sticky="stack" collapsible dividing>
			<example "Info" description="If a form is in informational state, it will automatically show any info message block.">
				<form state="info">
					<field label="New Password">
						<input id="form-new-password-35" type="password" placeholder="joe@schmoe.com"/>
					</field>
					<message state="info" heading="Requirements">
						<list bulleted>
							<item>Password must contain at least 8 characters</item>
						</list>
					</message>
					<button type="submit">Submit</button>
				</form>
			</example>
		</>
	</>

	<section label="Field States">
		<!-- GAP I130:  the field's state tints its label and input, not the dropdown or the checkbox. -->
		<section label="Field Error" sticky="stack" collapsible dividing>
			<example "Field Error" description="Individual fields may display an error state.">
				<form>
					<fields widths="2">
						<field label="First Name" state="error">
							<input id="form-first-36" placeholder="First Name"/>
						</field>
						<field label="Last Name">
							<input id="form-last-name-37" placeholder="Last Name"/>
						</field>
					</fields>
					<field label="Gender" state="error">
						<dropdown id="form-gender-38" selection placeholder="Select" name="gender-error">
							<item value="male">Male</item>
							<item value="female">Female</item>
						</dropdown>
					</field>
					<field inline state="error">
						<checkbox name="terms">I agree to the Terms and Conditions</checkbox>
					</field>
				</form>
			</example>
		</>

		<!-- GAP I130:  the field's state tints its label and input, not the dropdown or the checkbox. -->
		<section label="Field Warning" sticky="stack" collapsible dividing>
			<example "Field Warning" description="Individual fields may display a warning state.">
				<form>
					<fields widths="2">
						<field label="First Name" state="warning">
							<input id="form-first-39" placeholder="First Name"/>
						</field>
						<field label="Last Name">
							<input id="form-last-name-40" placeholder="Last Name"/>
						</field>
					</fields>
					<field label="Gender" state="warning">
						<dropdown id="form-gender-41" selection placeholder="Select" name="gender-warning">
							<item value="male">Male</item>
							<item value="female">Female</item>
						</dropdown>
					</field>
					<field inline state="warning">
						<checkbox name="terms">I agree to the Terms and Conditions</checkbox>
					</field>
				</form>
			</example>
		</>

		<!-- GAP I130:  the field's state tints its label and input, not the dropdown or the checkbox. -->
		<section label="Field Success" sticky="stack" collapsible dividing>
			<example "Field Success" description="Individual fields may display a success state.">
				<form>
					<fields widths="2">
						<field label="Username" state="success">
							<input id="form-first-42" placeholder="First Name"/>
						</field>
						<field label="Last Name">
							<input id="form-last-name-43" placeholder="Last Name"/>
						</field>
					</fields>
					<field label="Gender" state="success">
						<dropdown id="form-gender-44" selection placeholder="Select" name="gender-success">
							<item value="male">Male</item>
							<item value="female">Female</item>
						</dropdown>
					</field>
					<field inline state="success">
						<checkbox name="terms">I agree to the Terms and Conditions</checkbox>
					</field>
				</form>
			</example>
		</>

		<!-- GAP I130:  the field's state tints its label and input, not the dropdown or the checkbox. -->
		<section label="Field Info" sticky="stack" collapsible dividing>
			<example "Field Info" description="Individual fields may display an informational state.">
				<form>
					<fields widths="2">
						<field label="First Name" state="info">
							<input id="form-first-45" placeholder="First Name"/>
						</field>
						<field label="Last Name">
							<input id="form-last-name-46" placeholder="Last Name"/>
						</field>
					</fields>
					<field label="Gender" state="info">
						<dropdown id="form-gender-47" selection placeholder="Select" name="gender-info">
							<item value="male">Male</item>
							<item value="female">Female</item>
						</dropdown>
					</field>
					<field inline state="info">
						<checkbox name="terms">I agree to the Terms and Conditions</checkbox>
					</field>
				</form>
			</example>
		</>

		<section label="Disabled Field" sticky="stack" collapsible dividing>
			<example "Disabled Field" description="Individual fields may be disabled.">
				<form>
					<fields widths="2">
						<field label="First Name" disabled>
							<input id="form-disabled-first-48" placeholder="Read Only" disabled/>
						</field>
						<field label="Last Name" disabled>
							<input id="form-disabled-last-49" placeholder="Disabled" disabled/>
						</field>
					</fields>
				</form>
			</example>
		</>

		<section label="Read-Only Field" sticky collapsible dividing>
			<example "Read-Only Field" description="Individual fields may be read only.">
				<form>
					<fields widths="2">
						<field label="First Name">
							<input id="form-first-name-50" placeholder="Read Only" readonly/>
						</field>
						<field label="Last Name">
							<input id="form-last-name-51" placeholder="Read Only" readonly/>
						</field>
					</fields>
				</form>
			</example>
		</>
	</>

	<section label="Form Variations">
		<section label="Size" sticky="stack" collapsible dividing>
			<example "Size" description="A form can vary in size.">
				<form size="mini">
					<fields widths="2">
						<field label="First Name">
							<input id="form-first-name-52" placeholder="First Name"/>
						</field>
						<field label="Last Name">
							<input id="form-last-name-53" placeholder="Last Name"/>
						</field>
					</fields>
					<button type="submit">Submit</button>
				</form>
			</example>
			<example "Size">
				<form size="tiny">
					<fields widths="2">
						<field label="First Name">
							<input id="form-first-name-54" placeholder="First Name"/>
						</field>
						<field label="Last Name">
							<input id="form-last-name-55" placeholder="Last Name"/>
						</field>
					</fields>
					<button type="submit">Submit</button>
				</form>
			</example>
			<example "Size">
				<form size="small">
					<fields widths="2">
						<field label="First Name">
							<input id="form-first-name-56" placeholder="First Name"/>
						</field>
						<field label="Last Name">
							<input id="form-last-name-57" placeholder="Last Name"/>
						</field>
					</fields>
					<button type="submit">Submit</button>
				</form>
			</example>
			<example "Size">
				<form size="large">
					<fields widths="2">
						<field label="First Name">
							<input id="form-first-name-58" placeholder="First Name"/>
						</field>
						<field label="Last Name">
							<input id="form-last-name-59" placeholder="Last Name"/>
						</field>
					</fields>
					<button type="submit">Submit</button>
				</form>
			</example>
			<example "Size">
				<form size="big">
					<fields widths="2">
						<field label="First Name">
							<input id="form-first-name-60" placeholder="First Name"/>
						</field>
						<field label="Last Name">
							<input id="form-last-name-61" placeholder="Last Name"/>
						</field>
					</fields>
					<button type="submit">Submit</button>
				</form>
			</example>
			<example "Size">
				<form size="huge">
					<fields widths="2">
						<field label="First Name">
							<input id="form-first-name-62" placeholder="First Name"/>
						</field>
						<field label="Last Name">
							<input id="form-last-name-63" placeholder="Last Name"/>
						</field>
					</fields>
					<button type="submit">Submit</button>
				</form>
			</example>
			<example "Size">
				<form size="massive">
					<fields widths="2">
						<field label="First Name">
							<input id="form-first-name-64" placeholder="First Name"/>
						</field>
						<field label="Last Name">
							<input id="form-last-name-65" placeholder="Last Name"/>
						</field>
					</fields>
					<button type="submit">Submit</button>
				</form>
			</example>
		</>

		<section label="Equal Width Form" sticky collapsible dividing>
			<example "Equal Width Form" description="Forms can automatically divide fields to be equal width.">
				<form equal-width>
					<fields>
						<field label="Username">
							<input id="form-username-66" placeholder="Username"/>
						</field>
						<field label="Password">
							<input id="form-password-67" type="password"/>
						</field>
					</fields>
					<fields>
						<field label="First name">
							<input id="form-first-name-68" placeholder="First Name"/>
						</field>
						<field label="Middle name">
							<input id="form-middle-name-69" placeholder="Middle Name"/>
						</field>
						<field label="Last name">
							<input id="form-last-name-70" placeholder="Last Name"/>
						</field>
					</fields>
				</form>
			</example>
		</>

		<section label="Inverted" sticky="stack" collapsible dividing>
			<example "Inverted" description="A form on a dark background may have to invert its color scheme.">
				<segment inverted>
					<form inverted>
						<fields widths="2">
							<field label="First Name">
								<input id="form-first-name-71" placeholder="First Name"/>
							</field>
							<field label="Last Name">
								<input id="form-last-name-72" placeholder="Last Name"/>
							</field>
						</fields>
						<field inline>
							<checkbox name="terms">I agree to the terms and conditions</checkbox>
						</field>
						<button type="submit">Submit</button>
					</form>
				</segment>
			</example>
		</>
	</>

	<section label="Field Variations">
		<section label="Inline Field" sticky="stack" collapsible dividing>
			<example "Inline Field" description="A field can have its label next to instead of above it.">
				<form>
					<field label="Last name" inline>
						<input id="form-last-name-73" placeholder="Full Name"/>
					</field>
				</form>
			</example>
		</>

		<section label="Width" sticky="stack" collapsible dividing>
			<example "Width" description="A field can specify its width in grid columns:  `width` takes columns of 16.">
				<form>
					<fields>
						<field label="First name" width="6">
							<input id="form-first-name-74" placeholder="First Name"/>
						</field>
						<field label="Middle" width="4">
							<input id="form-middle-75" placeholder="Middle Name"/>
						</field>
						<field label="Last name" width="6">
							<input id="form-last-name-76" placeholder="Last Name"/>
						</field>
					</fields>
					<fields>
						<field width="2">
							<input placeholder="2 Wide" aria-label="2 wide"/>
						</field>
						<field width="12">
							<input placeholder="12 Wide" aria-label="12 wide"/>
						</field>
						<field width="2">
							<input placeholder="2 Wide" aria-label="2 wide"/>
						</field>
					</fields>
					<fields>
						<field width="8">
							<input placeholder="8 Wide" aria-label="8 wide"/>
						</field>
						<field width="6">
							<input placeholder="6 Wide" aria-label="6 wide"/>
						</field>
						<field width="2">
							<input placeholder="2 Wide" aria-label="2 wide"/>
						</field>
					</fields>
				</form>
			</example>
		</>

		<section label="Required" sticky="stack" collapsible dividing>
			<example "Required" description="A field can show that input is mandatory.">
				<form>
					<field label="Last name" required>
						<input id="form-last-name-77" placeholder="Full Name" required/>
					</field>
					<field required inline>
						<checkbox name="terms">I agree to the terms and conditions</checkbox>
					</field>
				</form>
				<message slot="description" state="info" size="small"><text code>required</text> on a <text code>&lt;ui-field&gt;</text> only draws the asterisk. To enforce it, put <text code>required</text> on the control too, or a <text code>notEmpty</text> rule.</message>
			</example>
		</>

		<section label="Transparent Textarea" sticky collapsible dividing>
			<example "Transparent Textarea" description="A textarea can appear transparent.">
				<form>
					<field label="Description">
						<textarea id="form-description-78" appearance="transparent" placeholder="Transparent textarea" rows="3"/>
					</field>
				</form>
			</example>
		</>
	</>

	<section label="Group Variations">
		<section label="Evenly Divided" sticky collapsible dividing>
			<example "Evenly Divided" description="Fields can have their widths divided evenly:  `widths=\"3\"`.">
				<form>
					<fields widths="3">
						<field label="First name">
							<input id="form-first-name-79" placeholder="First Name"/>
						</field>
						<field label="Middle name">
							<input id="form-middle-name-80" placeholder="Middle Name"/>
						</field>
						<field label="Last name">
							<input id="form-last-name-81" placeholder="Last Name"/>
						</field>
					</fields>
				</form>
			</example>
		</>

		<section label="Grouped Fields" sticky collapsible dividing>
			<example "Grouped Fields" description="Fields can show related choices:  `grouped`.">
				<form>
					<fields grouped role="radiogroup" aria-label="Fruit">
						<field>
							<radio name="fruit3" value="apples">Apples</radio>
						</field>
						<field>
							<radio name="fruit3" value="oranges">Oranges</radio>
						</field>
						<field>
							<radio name="fruit3" value="pears">Pears</radio>
						</field>
						<field>
							<radio name="fruit3" value="grapefruit">Grapefruit</radio>
						</field>
					</fields>
				</form>
			</example>
		</>

		<section label="Equal Width Fields" sticky collapsible dividing>
			<example "Equal Width Fields" description="Fields can automatically divide fields to be equal width:  `widths=\"equal\"`.">
				<form>
					<fields>
						<field label="Username">
							<input id="form-username-83" placeholder="Username"/>
						</field>
						<field label="Password">
							<input id="form-password-84" type="password"/>
						</field>
					</fields>
					<fields widths="equal">
						<field label="First name">
							<input id="form-first-name-85" placeholder="First Name"/>
						</field>
						<field label="Middle name">
							<input id="form-middle-name-86" placeholder="Middle Name"/>
						</field>
						<field label="Last name">
							<input id="form-last-name-87" placeholder="Last Name"/>
						</field>
					</fields>
				</form>
			</example>
			<example "Equal Width Fields" description="`equal` is the same, spelled like the other groups' (`<ui-buttons equal>`, `<ui-tabs equal>` ...):  `widths=\"equal\"` is its older, count-based spelling.">
				<form>
					<fields equal>
						<field label="City">
							<input id="form-city-equal" placeholder="City"/>
						</field>
						<field label="State">
							<input id="form-state-equal" placeholder="State"/>
						</field>
						<field label="Zip">
							<input id="form-zip-equal" placeholder="Zip"/>
						</field>
					</fields>
				</form>
			</example>
		</>

		<section label="Inline Fields" sticky collapsible dividing>
			<example "Inline Fields" description="Multiple fields may be inline in a row.">
				<html>
					<ui-form>
						<ui-fields inline>
							<label for="form-phone-88">Phone Number</label>
							<ui-field>
								<ui-input id="form-phone-88" placeholder="(xxx)"></ui-input>
							</ui-field>
							<ui-field>
								<ui-input placeholder="xxx" aria-label="Exchange"></ui-input>
							</ui-field>
							<ui-field>
								<ui-input placeholder="xxxx" aria-label="Number"></ui-input>
							</ui-field>
						</ui-fields>
					</ui-form>
				</html>
			</example>
			<example "Inline Fields">
				<html>
					<ui-form>
						<ui-fields inline role="radiogroup" aria-labelledby="form-fruit4-label-89">
							<label id="form-fruit4-label-89">What's your favorite fruit?</label>
							<ui-field>
								<ui-radio name="fruit4" value="apples">Apples</ui-radio>
							</ui-field>
							<ui-field>
								<ui-radio name="fruit4" value="oranges">Oranges</ui-radio>
							</ui-field>
							<ui-field>
								<ui-radio name="fruit4" value="pears">Pears</ui-radio>
							</ui-field>
							<ui-field>
								<ui-radio name="fruit4" value="grapefruit">Grapefruit</ui-radio>
							</ui-field>
						</ui-fields>
					</ui-form>
				</html>
			</example>
		</>
	</>
</spell-notebook>
