									<label for="form-middle-75">Middle</label>
									<ui-input id="form-middle-75" placeholder="Middle Name"></ui-input>
								</ui-field>
								<ui-field width="6">
									<label for="form-last-name-76">Last name</label>
									<ui-input id="form-last-name-76" placeholder="Last Name"></ui-input>
								</ui-field>
							</ui-fields>
							<ui-fields>
								<ui-field width="2">
									<ui-input placeholder="2 Wide" aria-label="2 wide"></ui-input>
								</ui-field>
								<ui-field width="12">
									<ui-input placeholder="12 Wide" aria-label="12 wide"></ui-input>
								</ui-field>
								<ui-field width="2">
									<ui-input placeholder="2 Wide" aria-label="2 wide"></ui-input>
								</ui-field>
							</ui-fields>
							<ui-fields>
								<ui-field width="8">
									<ui-input placeholder="8 Wide" aria-label="8 wide"></ui-input>
								</ui-field>
								<ui-field width="6">
									<ui-input placeholder="6 Wide" aria-label="6 wide"></ui-input>
								</ui-field>
								<ui-field width="2">
									<ui-input placeholder="2 Wide" aria-label="2 wide"></ui-input>
								</ui-field>
							</ui-fields>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Required" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">A field can show that input is mandatory.</p>
					<ui-message slot="description" state="info" size="small"><code>required</code> on a <code>&lt;ui-field&gt;</code> only draws the asterisk. To enforce it, put <code>required</code> on the control too, or a <code>notEmpty</code> rule.</ui-message>
					<ui-form>
						<form method="dialog">
							<ui-field required>
								<label for="form-last-name-77">Last name</label>
								<ui-input id="form-last-name-77" placeholder="Full Name" required></ui-input>
							</ui-field>
							<ui-field required inline>
								<ui-checkbox name="terms">I agree to the terms and conditions</ui-checkbox>
							</ui-field>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Transparent Textarea" sticky collapsible dividing>
			<example description="A textarea can appear transparent.">
