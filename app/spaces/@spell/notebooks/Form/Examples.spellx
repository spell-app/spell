		<section label="Grouped Fields" sticky collapsible dividing>
			<example description="Fields can show related choices:  `grouped`.">
				<html>
					<ui-form>
						<form method="dialog">
							<ui-fields grouped role="radiogroup" aria-label="Fruit">
								<ui-field>
									<ui-radio name="fruit3" value="apples">Apples</ui-radio>
								</ui-field>
								<ui-field>
									<ui-radio name="fruit3" value="oranges">Oranges</ui-radio>
								</ui-field>
								<ui-field>
									<ui-radio name="fruit3" value="pears">Pears</ui-radio>
								</ui-field>
								<ui-field>
									<ui-radio name="fruit3" value="grapefruit">Grapefruit</ui-radio>
								</ui-field>
							</ui-fields>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Equal Width Fields" sticky collapsible dividing>
			<example description="Fields can automatically divide fields to be equal width:  `widths=\"equal\"`.">
				<html>
					<ui-form>
						<form method="dialog">
							<ui-fields>
								<ui-field>
									<label for="form-username-83">Username</label>
									<ui-input id="form-username-83" placeholder="Username"></ui-input>
								</ui-field>
								<ui-field>
									<label for="form-password-84">Password</label>
									<ui-input id="form-password-84" type="password"></ui-input>
								</ui-field>
							</ui-fields>
							<ui-fields widths="equal">
								<ui-field>
									<label for="form-first-name-85">First name</label>
									<ui-input id="form-first-name-85" placeholder="First Name"></ui-input>
								</ui-field>
								<ui-field>
									<label for="form-middle-name-86">Middle name</label>
									<ui-input id="form-middle-name-86" placeholder="Middle Name"></ui-input>
								</ui-field>
								<ui-field>
									<label for="form-last-name-87">Last name</label>
									<ui-input id="form-last-name-87" placeholder="Last Name"></ui-input>
								</ui-field>
							</ui-fields>
						</form>
					</ui-form>
				</html>
			</example>
			<example description="`equal` is the same, spelled like the other groups' (`<ui-buttons equal>`, `<ui-tabs equal>` ...):  `widths=\"equal\"` is its older, count-based spelling.">
				<html>
					<ui-form>
						<form method="dialog">
							<ui-fields equal>
								<ui-field>
									<label for="form-city-equal">City</label>
									<ui-input id="form-city-equal" placeholder="City"></ui-input>
								</ui-field>
								<ui-field>
									<label for="form-state-equal">State</label>
									<ui-input id="form-state-equal" placeholder="State"></ui-input>
								</ui-field>
								<ui-field>
									<label for="form-zip-equal">Zip</label>
									<ui-input id="form-zip-equal" placeholder="Zip"></ui-input>
								</ui-field>
							</ui-fields>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Inline Fields" sticky collapsible dividing>
			<example description="Multiple fields may be inline in a row.">
				<html>
					<ui-form>
						<form method="dialog">
							<ui-fields inline>
								<label for="form-phone-88">Phone Number</label>
								<ui-field>
									<ui-input id="form-phone-88" placeholder="(xxx)"></ui-input>
								</ui-field>
								<ui-field>
									<ui-input placeholder="xxx" aria-label="Exchange"></ui-input>
								</ui-field>
								<ui-field>
									<ui-input placeholder="xxxx" aria-label="Number"></ui-input>
								</ui-field>
							</ui-fields>
						</form>
					</ui-form>
				</html>
			</example>
			<example>
				<html>
					<ui-form>
						<form method="dialog">
							<ui-fields inline role="radiogroup" aria-labelledby="form-fruit4-label-89">
								<label id="form-fruit4-label-89">What's your favorite fruit?</label>
								<ui-field>
									<ui-radio name="fruit4" value="apples">Apples</ui-radio>
								</ui-field>
								<ui-field>
									<ui-radio name="fruit4" value="oranges">Oranges</ui-radio>
								</ui-field>
								<ui-field>
									<ui-radio name="fruit4" value="pears">Pears</ui-radio>
								</ui-field>
								<ui-field>
									<ui-radio name="fruit4" value="grapefruit">Grapefruit</ui-radio>
								</ui-field>
							</ui-fields>
						</form>
					</ui-form>
				</html>
			</example>
		</>
	</>
</spell-notebook>
