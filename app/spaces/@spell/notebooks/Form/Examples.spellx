					<ui-form>
						<form method="dialog">
							<ui-field>
								<label for="form-description-78">Description</label>
								<ui-textarea id="form-description-78" appearance="transparent" placeholder="Transparent textarea" rows="3"></ui-textarea>
							</ui-field>
						</form>
					</ui-form>
				</html>
			</example>
		</>
	</>

	<section label="Group Variations">
		<section label="Evenly Divided" sticky collapsible dividing>
			<example description="Fields can have their widths divided evenly:  `widths=\"3\"`.">
