<spell-notebook "form examples">
	<header level="1">
		Form
		<header>A form displays a set of related user input fields in a structured way.</>
	</>
	<form-tab-bar showing="examples"/>
	<section>
		<html>
			<ui-menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
				<ui-item link="#types">Types</>
				<ui-item link="#content">Content</>
				<ui-item link="#form-states">Form States</>
				<ui-item link="#field-states">Field States</>
				<ui-item link="#form-variations">Form Variations</>
				<ui-item link="#field-variations">Field Variations</>
				<ui-item link="#group-variations">Group Variations</>
			</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's form page, section by section, in its order (Types, Content, Form States, Field States, Form
		Variations, Field Variations, Group Variations).  `<ui-form>` wraps a NATIVE `<form>` (`method="dialog"` here, so a
		valid submit doesn't leave the page);  each `<label for>` names its control.  Fomantic's 250-country lists are
		shortened to twenty.  `GAP I<n>` comments mark examples a widget can't render yet (plan-doc issues).
		The site's root says `stack-with="page"`:  rows stack below 768px of the SCREEN, as Fomantic's.
	-->
	<section label="Types">
		<section label="Form" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">A form: <code>&lt;ui-form&gt;</code> around a native <code>&lt;form&gt;</code>.</p>
				</html>
				<message slot="description" state="warning" size="small">Looking for validation? It is built in: see Validation on the Usage tab.</message>
				<html>
					<ui-form>
						<form method="dialog">
							<ui-field>
								<label for="form-first-name-1">First Name</label>
								<ui-input id="form-first-name-1" name="first-name" placeholder="First Name"></ui-input>
							</ui-field>
							<ui-field>
								<label for="form-last-name-2">Last Name</label>
								<ui-input id="form-last-name-2" name="last-name" placeholder="Last Name"></ui-input>
							</ui-field>
							<ui-field>
								<ui-checkbox name="terms">I agree to the Terms and Conditions</ui-checkbox>
							</ui-field>
							<ui-button type="submit">Submit</ui-button>
						</form>
					</ui-form>
				</html>
			</example>
			<example>
				<html>
					<ui-form>
						<form method="dialog">
							<ui-header level="4" dividing>Shipping Information</ui-header>
							<ui-field>
								<label for="form-ship-first-3">Name</label>
								<ui-fields widths="2">
									<ui-field>
										<ui-input id="form-ship-first-3" name="shipping\[first-name]" placeholder="First Name"></ui-input>
									</ui-field>
									<ui-field>
										<ui-input name="shipping\[last-name]" placeholder="Last Name" aria-label="Last Name"></ui-input>
									</ui-field>
								</ui-fields>
							</ui-field>
							<ui-field>
								<label for="form-ship-address-5">Billing Address</label>
								<ui-fields>
									<ui-field width="12">
										<ui-input id="form-ship-address-5" name="shipping\[address]" placeholder="Street Address"></ui-input>
									</ui-field>
									<ui-field width="4">
										<ui-input name="shipping\[address-2]" placeholder="Apt #" aria-label="Apartment"></ui-input>
									</ui-field>
								</ui-fields>
							</ui-field>
							<ui-fields widths="2">
								<ui-field>
									<label for="form-ship-state-7">State</label>
									<ui-dropdown id="form-ship-state-7" fluid selection placeholder="State" name="shipping\[state]">
										<ui-item value="AL">Alabama</ui-item>
										<ui-item value="AK">Alaska</ui-item>
										<ui-item value="AZ">Arizona</ui-item>
										<ui-item value="AR">Arkansas</ui-item>
										<ui-item value="CA">California</ui-item>
										<ui-item value="CO">Colorado</ui-item>
										<ui-item value="CT">Connecticut</ui-item>
										<ui-item value="DE">Delaware</ui-item>
										<ui-item value="FL">Florida</ui-item>
										<ui-item value="GA">Georgia</ui-item>
									</ui-dropdown>
								</ui-field>
								<ui-field>
									<label for="form-ship-country-8">Country</label>
									<ui-dropdown id="form-ship-country-8" fluid search selection placeholder="Select Country" name="country">
										<ui-item value="af" flag="af">Afghanistan</ui-item>
										<ui-item value="ax" flag="ax">Åland Islands</ui-item>
										<ui-item value="al" flag="al">Albania</ui-item>
										<ui-item value="dz" flag="dz">Algeria</ui-item>
										<ui-item value="as" flag="as">American Samoa</ui-item>
										<ui-item value="ad" flag="ad">Andorra</ui-item>
										<ui-item value="ao" flag="ao">Angola</ui-item>
										<ui-item value="ai" flag="ai">Anguilla</ui-item>
										<ui-item value="ar" flag="ar">Argentina</ui-item>
										<ui-item value="am" flag="am">Armenia</ui-item>
										<ui-item value="au" flag="au">Australia</ui-item>
										<ui-item value="at" flag="at">Austria</ui-item>
										<ui-item value="be" flag="be">Belgium</ui-item>
										<ui-item value="br" flag="br">Brazil</ui-item>
										<ui-item value="ca" flag="ca">Canada</ui-item>
										<ui-item value="fr" flag="fr">France</ui-item>
										<ui-item value="de" flag="de">Germany</ui-item>
										<ui-item value="jp" flag="jp">Japan</ui-item>
										<ui-item value="gb" flag="gb">United Kingdom</ui-item>
										<ui-item value="us" flag="us">United States</ui-item>
									</ui-dropdown>
								</ui-field>
							</ui-fields>
							<ui-header level="4" dividing>Billing Information</ui-header>
							<ui-field>
								<label for="form-card-type-9">Card Type</label>
								<ui-dropdown id="form-card-type-9" selection placeholder="Type" name="card\[type]">
									<ui-item value="visa" icon="cc visa">Visa</ui-item>
									<ui-item value="amex" icon="cc amex">American Express</ui-item>
									<ui-item value="discover" icon="cc discover">Discover</ui-item>
								</ui-dropdown>
							</ui-field>
							<ui-fields>
								<ui-field width="7">
									<label for="form-card-number-10">Card Number</label>
									<ui-input id="form-card-number-10" name="card\[number]" maxlength="16" placeholder="Card #"></ui-input>
								</ui-field>
								<ui-field width="3">
									<label for="form-card-cvc-11">CVC</label>
									<ui-input id="form-card-cvc-11" name="card\[cvc]" maxlength="3" placeholder="CVC"></ui-input>
								</ui-field>
								<ui-field width="6">
									<label for="form-card-month-12">Expiration</label>
									<ui-fields>
										<ui-field width="8">
											<ui-dropdown id="form-card-month-12" fluid search selection placeholder="Month" name="card\[expire-month]">
												<ui-item value="1">January</ui-item>
												<ui-item value="2">February</ui-item>
												<ui-item value="3">March</ui-item>
												<ui-item value="4">April</ui-item>
												<ui-item value="5">May</ui-item>
												<ui-item value="6">June</ui-item>
												<ui-item value="7">July</ui-item>
												<ui-item value="8">August</ui-item>
												<ui-item value="9">September</ui-item>
												<ui-item value="10">October</ui-item>
												<ui-item value="11">November</ui-item>
												<ui-item value="12">December</ui-item>
											</ui-dropdown>
										</ui-field>
										<ui-field>
											<ui-input name="card\[expire-year]" maxlength="4" placeholder="Year" aria-label="Expiration year"></ui-input>
										</ui-field>
									</ui-fields>
								</ui-field>
							</ui-fields>
							<ui-header level="4" dividing>Receipt</ui-header>
							<ui-field>
								<label for="form-receipt-14">Send Receipt To:</label>
								<ui-dropdown id="form-receipt-14" fluid multiple search selection placeholder="Saved Contacts" name="receipt">
									<ui-item value="jenny" image="../images/avatar/small/jenny.jpg">Jenny Hess</ui-item>
									<ui-item value="elliot" image="../images/avatar/small/elliot.jpg">Elliot Fu</ui-item>
									<ui-item value="stevie" image="../images/avatar/small/stevie.jpg">Stevie Feliciano</ui-item>
									<ui-item value="christian" image="../images/avatar/small/christian.jpg">Christian</ui-item>
									<ui-item value="matt" image="../images/avatar/small/matt.jpg">Matt</ui-item>
									<ui-item value="justen" image="../images/avatar/small/justen.jpg">Justen Kitsune</ui-item>
								</ui-dropdown>
							</ui-field>
							<ui-segment>
								<ui-field>
									<ui-checkbox appearance="toggle" name="gift">Do not include a receipt in the package</ui-checkbox>
								</ui-field>
							</ui-segment>
							<ui-button type="submit">Submit Order</ui-button>
						</form>
					</ui-form>
				</html>
			</example>
		</>
	</>

	<section label="Content">
		<section label="Field" sticky collapsible dividing>
			<example description="A field is a form element containing a label and an input.">
				<html>
					<ui-form>
						<form method="dialog">
							<ui-field>
								<label for="form-user-input-15">User Input</label>
								<ui-input id="form-user-input-15"></ui-input>
							</ui-field>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Label Row" sticky collapsible dividing>
			<example description="A field can draw its own label row:  the label, an output at its end and a tip behind an info icon;  a hint goes under the control.">
				<html>
					<ui-form>
						<form method="dialog">
							<ui-field label="Text size" output="16px" description="The size of body text;  headings scale from it." hint="13 to 19 pixels.">
								<ui-slider min="13" max="19" value="16"></ui-slider>
							</ui-field>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Actions" sticky collapsible dividing>
			<example description="Small buttons in the label row's actions slot;  a taller one never grows the row.">
				<html>
					<ui-form>
						<form method="dialog">
							<ui-field label="Accent colour" output="#6550CA">
								<ui-button slot="actions" size="mini" appearance="basic">Reset</ui-button>
								<ui-input value="#6550CA"></ui-input>
							</ui-field>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Error" sticky collapsible dividing>
			<example description="A field shows its error as a line under the control;  the form's validation shows its own there.">
				<html>
					<ui-form>
						<form method="dialog">
							<ui-field label="Hex" error="That isn't a colour.">
								<ui-input value="#12"></ui-input>
							</ui-field>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Fields" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">A set of fields can appear grouped together: <code>&lt;ui-fields&gt;</code>.</p>
					<ui-message slot="description" state="positive" size="small">Field groups automatically receive responsive styling, swapping to one field per row below 768px of the FORM's width, or of the screen with <code>stack-with="page"</code> (as on this site). Add <code>unstackable</code> to keep a row.</ui-message>
					<ui-form>
						<form method="dialog">
							<ui-fields>
								<ui-field>
									<label for="form-first-name-16">First name</label>
									<ui-input id="form-first-name-16" placeholder="First Name"></ui-input>
								</ui-field>
								<ui-field>
									<label for="form-middle-name-17">Middle name</label>
									<ui-input id="form-middle-name-17" placeholder="Middle Name"></ui-input>
								</ui-field>
								<ui-field>
									<label for="form-last-name-18">Last name</label>
									<ui-input id="form-last-name-18" placeholder="Last Name"></ui-input>
								</ui-field>
							</ui-fields>
						</form>
					</ui-form>
				</html>
			</example>
			<example description="`widths=\"3\"` shares the row equally between three fields.">
				<html>
					<ui-form>
						<form method="dialog">
							<ui-fields widths="3">
								<ui-field>
									<label for="form-first-name-19">First name</label>
									<ui-input id="form-first-name-19" placeholder="First Name"></ui-input>
								</ui-field>
								<ui-field>
									<label for="form-middle-name-20">Middle name</label>
									<ui-input id="form-middle-name-20" placeholder="Middle Name"></ui-input>
								</ui-field>
								<ui-field>
									<label for="form-last-name-21">Last name</label>
									<ui-input id="form-last-name-21" placeholder="Last Name"></ui-input>
								</ui-field>
							</ui-fields>
						</form>
					</ui-form>
				</html>
			</example>
			<example>
				<html>
					<ui-form>
						<form method="dialog">
							<ui-fields inline>
								<ui-field width="8">
									<label for="form-inline-name-22">Name</label>
									<ui-input id="form-inline-name-22" placeholder="First Name"></ui-input>
								</ui-field>
								<ui-field width="3">
									<ui-input placeholder="Middle Name" aria-label="Middle Name"></ui-input>
								</ui-field>
								<ui-field width="5">
									<ui-input placeholder="Last Name" aria-label="Last Name"></ui-input>
								</ui-field>
							</ui-fields>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Text Area" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">A <a href="/components/ui/ui-textarea.html" target="src-spell-app-dev-ui-components-ui-textarea-html">textarea</a> can be used to allow for extended user input: <code>&lt;ui-textarea&gt;</code>.</p>
					<ui-message slot="description" state="info" size="small">To specify an approximate text area size use the <code>rows</code> attribute.</ui-message>
					<ui-form>
						<form method="dialog">
							<ui-field>
								<label for="form-text-23">Text</label>
								<ui-textarea id="form-text-23"></ui-textarea>
							</ui-field>
							<ui-field>
								<label for="form-short-text-24">Short Text</label>
								<ui-textarea id="form-short-text-24" rows="2"></ui-textarea>
							</ui-field>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Checkbox" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">A form can contain a <a href="/components/ui/ui-checkbox.html" target="src-spell-app-dev-ui-components-ui-checkbox-html">checkbox</a>.</p>
				</html>
				<message slot="description" state="info" size="small">UI checkboxes are special, styled versions of standard HTML checkboxes. They need no script to start.</message>
				<html>
					<ui-form>
						<form method="dialog">
							<ui-field inline>
								<ui-checkbox>Checkbox</ui-checkbox>
							</ui-field>
							<ui-field inline>
								<ui-checkbox appearance="slider">Slider</ui-checkbox>
							</ui-field>
							<ui-field inline>
								<ui-checkbox appearance="toggle">Toggle</ui-checkbox>
							</ui-field>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Radio Checkbox" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">A form can include a <a href="/components/ui/ui-radio.html" target="src-spell-app-dev-ui-components-ui-radio-html">radio checkbox</a>: <code>&lt;ui-radio&gt;</code>.</p>
					<ui-form>
						<form method="dialog">
							<ui-fields inline role="radiogroup" aria-labelledby="form-fruit-label-25">
								<label id="form-fruit-label-25">Select your favorite fruit:</label>
								<ui-field>
									<ui-radio name="fruit" value="apples" selected>Apples</ui-radio>
								</ui-field>
								<ui-field>
									<ui-radio name="fruit" value="oranges">Oranges</ui-radio>
								</ui-field>
								<ui-field>
									<ui-radio name="fruit" value="pears">Pears</ui-radio>
								</ui-field>
								<ui-field>
									<ui-radio name="fruit" value="grapefruit">Grapefruit</ui-radio>
								</ui-field>
							</ui-fields>
							<ui-fields grouped role="radiogroup" aria-labelledby="form-fruit2-label-26">
								<label id="form-fruit2-label-26">Select your second favorite fruit:</label>
								<ui-field>
									<ui-radio name="fruit2" value="apples" selected>Apples</ui-radio>
								</ui-field>
								<ui-field>
									<ui-radio name="fruit2" value="oranges">Oranges</ui-radio>
								</ui-field>
								<ui-field>
									<ui-radio name="fruit2" value="pears">Pears</ui-radio>
								</ui-field>
								<ui-field>
									<ui-radio name="fruit2" value="grapefruit">Grapefruit</ui-radio>
								</ui-field>
							</ui-fields>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Dropdown" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">A form can contain a <a href="/components/ui/ui-dropdown.html" target="src-spell-app-dev-ui-components-ui-dropdown-html">dropdown</a>.</p>
					<ui-message slot="description" state="info" size="small">A <code>&lt;ui-dropdown&gt;</code> is form-associated: its name and value submit with the form, no hidden input needed.</ui-message>
					<ui-form>
						<form method="dialog">
							<ui-field>
								<label for="form-gender-27">Gender</label>
								<ui-dropdown id="form-gender-27" selection placeholder="Gender" name="gender">
									<ui-item value="1">Male</ui-item>
									<ui-item value="0">Female</ui-item>
								</ui-dropdown>
							</ui-field>
						</form>
					</ui-form>
				</html>
			</example>
			<example>
				<html>
					<ui-form>
						<form method="dialog">
							<ui-field>
								<label for="form-country-28">Country</label>
								<ui-dropdown id="form-country-28" search selection placeholder="Select Country" name="country">
									<ui-item value="af">Afghanistan</ui-item>
									<ui-item value="ax">Åland Islands</ui-item>
									<ui-item value="al">Albania</ui-item>
									<ui-item value="dz">Algeria</ui-item>
									<ui-item value="as">American Samoa</ui-item>
									<ui-item value="ad">Andorra</ui-item>
									<ui-item value="ao">Angola</ui-item>
									<ui-item value="ai">Anguilla</ui-item>
									<ui-item value="ar">Argentina</ui-item>
									<ui-item value="am">Armenia</ui-item>
									<ui-item value="au">Australia</ui-item>
									<ui-item value="at">Austria</ui-item>
									<ui-item value="be">Belgium</ui-item>
									<ui-item value="br">Brazil</ui-item>
									<ui-item value="ca">Canada</ui-item>
									<ui-item value="fr">France</ui-item>
									<ui-item value="de">Germany</ui-item>
									<ui-item value="jp">Japan</ui-item>
									<ui-item value="gb">United Kingdom</ui-item>
									<ui-item value="us">United States</ui-item>
								</ui-dropdown>
							</ui-field>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Multiple Select" sticky collapsible dividing>
			<example description="A multiple select is used to include several choices with one form field.">
				<html>
					<ui-form>
						<form method="dialog">
							<ui-field>
								<label for="form-countries-29">Country</label>
								<ui-dropdown id="form-countries-29" multiple selection placeholder="Select Country" name="countries">
									<ui-item value="af">Afghanistan</ui-item>
									<ui-item value="ax">Åland Islands</ui-item>
									<ui-item value="al">Albania</ui-item>
									<ui-item value="dz">Algeria</ui-item>
									<ui-item value="as">American Samoa</ui-item>
									<ui-item value="ad">Andorra</ui-item>
									<ui-item value="ao">Angola</ui-item>
									<ui-item value="ai">Anguilla</ui-item>
									<ui-item value="ar">Argentina</ui-item>
									<ui-item value="am">Armenia</ui-item>
									<ui-item value="au">Australia</ui-item>
									<ui-item value="at">Austria</ui-item>
									<ui-item value="be">Belgium</ui-item>
									<ui-item value="br">Brazil</ui-item>
									<ui-item value="ca">Canada</ui-item>
									<ui-item value="fr">France</ui-item>
									<ui-item value="de">Germany</ui-item>
									<ui-item value="jp">Japan</ui-item>
									<ui-item value="gb">United Kingdom</ui-item>
									<ui-item value="us">United States</ui-item>
								</ui-dropdown>
							</ui-field>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="HTML Select" sticky collapsible dividing>
			<example description="If a script-driven dropdown is not a viable option, `<ui-select>` styles the browser's own select element.">
				<html>
					<ui-form>
						<form method="dialog">
							<ui-field>
								<ui-select placeholder="Gender" name="gender" aria-label="Gender">
									<ui-item value="1">Male</ui-item>
									<ui-item value="0">Female</ui-item>
								</ui-select>
							</ui-field>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Calendar" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">A form can contain a <a href="/components/ui/ui-calendar.html" target="src-spell-app-dev-ui-components-ui-calendar-html">calendar</a>.</p>
					<ui-form>
						<form method="dialog">
							<ui-field>
								<label for="form-date-30">Date</label>
								<ui-calendar id="form-date-30" type="date" placeholder="Pick up a date" name="date"></ui-calendar>
							</ui-field>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Message" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">A form can contain a <a href="/components/ui/ui-message.html" target="src-spell-app-dev-ui-components-ui-message-html">message</a>.</p>
					<ui-message slot="description" state="info" size="small">A message inside a form is hidden until the form is in its state: info, error, success or warning. A message with no <code>state</code> always shows.</ui-message>
					<ui-form>
						<form method="dialog">
							<ui-message heading="We had some issues">
								<ul>
									<li>Please enter your first name</li>
									<li>Please enter your last name</li>
								</ul>
							</ui-message>
						</form>
					</ui-form>
				</html>
			</example>
		</>
	</>

	<section label="Form States">
		<!-- GAP I124:  Fomantic's second form, `ui blue double loading form`, has no colour or loader style. -->
		<section label="Loading" sticky collapsible dividing>
			<example description="If a form is in loading state, it will automatically show a loading indicator.">
				<html>
					<ui-form loading>
						<form method="dialog">
							<ui-field>
								<label for="form-e-mail-31">E-mail</label>
								<ui-input id="form-e-mail-31" type="email" placeholder="joe@schmoe.com"></ui-input>
							</ui-field>
							<ui-button type="submit">Submit</ui-button>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Success" sticky collapsible dividing>
			<example description="If a form is in an success state, it will automatically show any success message blocks.">
				<html>
					<ui-form state="success">
						<form method="dialog">
							<ui-field>
								<label for="form-e-mail-32">E-mail</label>
								<ui-input id="form-e-mail-32" type="email" placeholder="joe@schmoe.com"></ui-input>
							</ui-field>
							<ui-message state="success" heading="Form Completed">
								<p>You're all signed up for the newsletter.</p>
							</ui-message>
							<ui-button type="submit">Submit</ui-button>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Error" sticky collapsible dividing>
			<example description="If a form is in an error state, it will automatically show any error message blocks.">
				<html>
					<ui-form state="error">
						<form method="dialog">
							<ui-field>
								<label for="form-e-mail-33">E-mail</label>
								<ui-input id="form-e-mail-33" type="email" placeholder="joe@schmoe.com"></ui-input>
							</ui-field>
							<ui-message state="error" heading="Action Forbidden">
								<p>You can only sign up for an account once with a given e-mail address.</p>
							</ui-message>
							<ui-button type="submit">Submit</ui-button>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Warning" sticky collapsible dividing>
			<example description="If a form is in warning state, it will automatically show any warning message block.">
				<html>
					<ui-form state="warning">
						<form method="dialog">
							<ui-field>
								<label for="form-e-mail-34">E-mail</label>
								<ui-input id="form-e-mail-34" type="email" placeholder="joe@schmoe.com"></ui-input>
							</ui-field>
							<ui-message state="warning" heading="Could you check something!">
								<ul>
									<li>That e-mail has been subscribed, but you have not yet clicked the verification link in your e-mail.</li>
								</ul>
							</ui-message>
							<ui-button type="submit">Submit</ui-button>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Info" sticky collapsible dividing>
			<example description="If a form is in informational state, it will automatically show any info message block.">
				<html>
					<ui-form state="info">
						<form method="dialog">
							<ui-field>
								<label for="form-new-password-35">New Password</label>
								<ui-input id="form-new-password-35" type="password" placeholder="joe@schmoe.com"></ui-input>
							</ui-field>
							<ui-message state="info" heading="Requirements">
								<ul>
									<li>Password must contain at least 8 characters</li>
								</ul>
							</ui-message>
							<ui-button type="submit">Submit</ui-button>
						</form>
					</ui-form>
				</html>
			</example>
		</>
	</>

	<section label="Field States">
		<!-- GAP I130:  the field's state tints its label and input, not the dropdown or the checkbox. -->
		<section label="Field Error" sticky collapsible dividing>
			<example description="Individual fields may display an error state.">
				<html>
					<ui-form>
						<form method="dialog">
							<ui-fields widths="2">
								<ui-field state="error">
									<label for="form-first-36">First Name</label>
