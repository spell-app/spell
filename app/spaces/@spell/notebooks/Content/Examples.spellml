<spell-notebook "content examples">
	<header level="1">
		Content
		<header>Content is the main block of a card, item, feed event, comment, modal, message, list item or step.</>
	</>
	<content-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#owners">Owners</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  `<ui-content>` in each owner that gives it a look (from the owners' own pages and
		`src/components/ui-parts/examples/elements/`), then its attributes.  The Content parts page
		(`ui-header.html`) shows every part together.
	-->
	<section label="Owners">
		<section label="Card" sticky="stack" collapsible dividing>
			<example "Card" description="A card's content blocks, divided from each other.">
				<card>
					<content>
						<header>Elliot Fu</header>
						<meta>Friend</meta>
						<description>Elliot is a film-maker from New York.</description>
					</content>
					<content>
						<description>A second content block, divided from the first.</description>
					</content>
				</card>
			</example>
		</>

		<section label="Item" sticky="stack" collapsible dividing>
			<example "Item" description="An item's content is the column beside its image.">
				<items>
					<item image="../images/wireframe/image.png">
						<content>
							<header link="#item">Arrowhead Valley Camp</header>
							<meta>
								<text>Summer camp</text>
							</meta>
							<description>A week of hiking, canoeing and campfires.</description>
						</content>
					</item>
				</items>
			</example>
		</>

		<section label="Message" sticky="stack" collapsible dividing>
			<example "Message" description="A message's content is the text beside its icon.">
				<message icon="inbox">
					<content>
						<header>Have you heard about our mailing list?</header>
						<text paragraph>Get the best news in your e-mail every day.</text>
					</content>
				</message>
			</example>
		</>

		<section label="List" sticky="stack" collapsible dividing>
			<example "List" description="A list item's content sits beside its icon.">
				<list spacing="lg">
					<item icon="github">
						<content>
							<header link="#list">fomantic/Fomantic-UI</header>
							<description>Updated 10 mins ago</description>
						</content>
					</item>
				</list>
			</example>
		</>

		<section label="Step" sticky="stack" collapsible dividing>
			<example "Step" description="A step's content sits beside its icon.">
				<steps>
					<step icon="truck">
						<content>
							<title>Shipping</title>
							<description>Choose your shipping options</description>
						</content>
					</step>
				</steps>
			</example>
		</>

		<section label="Accordion" sticky="stack" collapsible dividing>
			<example "Accordion" description="An accordion's panels:  each `<ui-content>` shows while the title before it is open.">
				<accordion appearance="styled" open="0">
					<title>What is a dog?</title>
					<content>
						<text paragraph>A dog is a type of domesticated animal.</text>
					</content>
					<title>What kinds of dogs are there?</title>
					<content>
						<text paragraph>There are many breeds of dogs.</text>
					</content>
				</accordion>
			</example>
		</>

		<section label="Modal" sticky="stack" collapsible dividing>
			<example "Modal" description="A modal's body:  `image` puts an image beside the description.">
				<button commandfor="content-modal" command="--show">Show</button>
				<modal id="content-modal" closable>
					<header>Profile Picture</header>
					<content image>
						<image size="medium" src="/components/ui/images/avatar/large/chris.jpg" alt=""/>
						<description>
							<header>We've auto-chosen a profile image for you.</header>
							<text paragraph>Is it okay to use this photo?</text>
						</description>
					</content>
					<actions>
						<button class="approve" color="primary">Use it</button>
					</actions>
				</modal>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Text Alignment" sticky="stack" collapsible dividing>
			<example "Text Alignment" description="In a card, `align` aligns one content block:  Fomantic's `center aligned content`.">
				<card>
					<content align="center">
						<header>Centered</header>
						<description>A center aligned content block.</description>
					</content>
					<content align="right">
						<description>A right aligned one.</description>
					</content>
				</card>
			</example>
		</>

		<section label="Vertical Alignment" sticky collapsible dividing>
			<example "Vertical Alignment" description="In an item, `vertical-align` lines the content up against the image beside it.">
				<items>
					<item image="../images/wireframe/image.png">
						<content vertical-align="middle">
							<header>Middle aligned</header>
						</content>
					</item>
					<item image="../images/wireframe/image.png">
						<content vertical-align="bottom">
							<header>Bottom aligned</header>
						</content>
					</item>
				</items>
			</example>
		</>
	</>
</spell-notebook>
