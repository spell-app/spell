<spell-notebook "keys examples">
	<header level="1">
		Keys
		<header>Keys show a keyboard shortcut as key caps, the way the reader's own keyboard writes it.</>
	</>
	<keys-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's page, section by section, in its order (Types, Content, States, Variations,
		Groups ...).  Rules, the class-grammar mappings, gaps:  epics/spell-ui-pages/PAGES.md.
		- A section:  `<ui-section id="examples-types" label="Types" sticky="stack" collapsible dividing>` around
		  its examples;  ids spell out the nesting (`<tab>-<section>-<example>`, lowercase kebab of the headers).
		- An example:  its own nested section (`label` = the example's name) around
		  `<ui-example description="...">` and the live markup;  the markup IS the code shown.  A richer
		  description:  `<p slot="description">` (+ `<ui-message slot="description">`).  Fomantic's header-less
		  `.another.example`:  a second `<ui-example>` in the same section.
		- Or write it flat (`<ui-header level="2">`, `<ui-example heading>`) and run `yarn site:sections`:
		  it nests it and writes the ids (and fixes them after a title changes).
		- A gap:  an HTML comment `GAP I<n>:  ...` BEFORE the example's section (a comment inside the example
		  shows in its code).
	-->
	<section label="Types">
		<section label="Keys" sticky="stack" collapsible dividing>
			<example "Keys" description="`shortcut`, the keys joined by `+`.  `mod` is ⌘ on a Mac and Ctrl elsewhere:  this page shows the keys of the keyboard you're reading it on.">
				<text paragraph>Save with <keys shortcut="mod+S"/>, undo with <keys shortcut="mod+Z"/>.</text>
			</example>
		</>

		<section label="On a Mac, and elsewhere" sticky="stack" collapsible dividing>
			<example "On a Mac, and elsewhere" description="`platform=\"apple\"` or `\"other\"` draws one keyboard's keys whatever the reader has.">
				<text paragraph><keys shortcut="shift+mod+P" platform="apple"/> on a Mac, <keys shortcut="shift+mod+P" platform="other"/> elsewhere.</text>
			</example>
		</>

		<section label="Two shortcuts" sticky="stack" collapsible dividing>
			<example "Two shortcuts" description="Two shortcuts, a space apart, draw both.">
				<text paragraph>Redo with <keys shortcut="shift+mod+Z mod+Y"/>.</text>
			</example>
		</>

		<section label="Named keys" sticky="stack" collapsible dividing>
			<example "Named keys" description="Arrows, Enter, Escape, Tab, Backspace, Delete and Space have caps of their own.">
				<text paragraph><keys shortcut="up"/> <keys shortcut="down"/> to move, <keys shortcut="enter"/> to open, <keys shortcut="escape"/> to close.</text>
			</example>
		</>
	</>
</spell-notebook>
