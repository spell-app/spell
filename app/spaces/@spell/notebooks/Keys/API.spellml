<spell-notebook "keys api">
	<header level="1">
		Keys
		<header>Keys show a keyboard shortcut as key caps, the way the reader's own keyboard writes it.</>
	</>
	<keys-tab-bar showing="api"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#attributes">Attributes</>
			<item link="#parts">Parts</>
			<item link="#states">States</>
			<item link="#texts">Texts</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`site/_data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-keys" only="attributes"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-keys" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-keys" only="states"></>
		</>
	</>

	<section label="Texts">
		<html>
			<ui-docs-api family="ui-keys" only="texts"></>
		</>
	</>
</spell-notebook>
