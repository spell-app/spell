<spell-notebook "dropdown examples">
	<header level="1">
		Dropdown
		<header>A dropdown allows a user to select a value from a series of options.</>
	</>
	<dropdown-tab-bar showing="examples"/>
	<section>
		<html>
			<ui-menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
				<ui-item link="#types">Types</>
				<ui-item link="#content">Content</>
				<ui-item link="#states">States</>
				<ui-item link="#variations">Variations</>
				<ui-item link="#selection-dropdowns">Selection Dropdowns</>
				<ui-item link="#remote-content">Remote Content</>
				<ui-item link="#menus">Menus</>
				<ui-item link="#adjusting-actions">Adjusting Actions</>
				<ui-item link="#coupling">Coupling</>
			</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's dropdown page, section by section, in its order (Types, Content, States, Variations, then
		its Examples tab:  Selection Dropdowns, Remote Content, Menus, Adjusting Actions, Coupling), plus our extras
		(Form states, Colored, Invoker commands).
		- Options are slotted `<ui-item>`s;  Fomantic's long country / state lists are shortened.
		- Fomantic's `<select class="ui dropdown">` forms are `<ui-dropdown selection>` (with `multiple` for a multi-select).
	-->
	<section label="Types">
		<!-- GAP I53:  no nested sub-menu (`Publish To Web`);  left out. -->
		<section label="Dropdown" sticky collapsible dividing>
			<example description="A dropdown, its items `<ui-item>`s. An item's `description` sits at the end of its row, and its `icon` before the text.">
				<dropdown label="File">
					<item>New</item>
					<item description="ctrl + o">Open...</item>
					<item description="ctrl + s">Save as...</item>
					<item description="ctrl + r">Rename</item>
					<item>Make a copy</item>
					<item icon="folder">Move to folder</item>
					<item icon="trash">Move to trash</item>
					<item kind="divider"/>
					<item>Download As...</item>
					<item>E-mail Collaborators</item>
				</dropdown>
			</example>
		</>

		<section label="Selection" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">A dropdown can be used to select between choices in a form:  <code>selection</code>, with a name and a placeholder.</p>
					<ui-message slot="description" size="small" class="site-not-ported">Not ported: initializing on a native <code>&lt;select&gt;</code> (write the items instead:  the native fallback IS a select), and <code>scrollhint</code> (a touch-only scroll animation).</ui-message>
				</html>
				<dropdown selection name="pet" placeholder="Pet">
					<item value="0">Cat</item>
					<item value="1">Dog</item>
					<item value="2">Bird</item>
					<item value="3">Rabbit</item>
					<item value="4">Squirrel</item>
					<item value="5">Horse</item>
					<item value="6">Turtle</item>
					<item value="7">Parrot</item>
				</dropdown>
			</example>
			<example description="Items can lead with an image:  `image`.">
				<dropdown fluid selection name="user" placeholder="Select Friend">
					<item value="jenny" image="../images/avatar/small/jenny.jpg">Jenny Hess</item>
					<item value="elliot" image="../images/avatar/small/elliot.jpg">Elliot Fu</item>
					<item value="stevie" image="../images/avatar/small/stevie.jpg">Stevie Feliciano</item>
					<item value="christian" image="../images/avatar/small/christian.jpg">Christian</item>
					<item value="matt" image="../images/avatar/small/matt.jpg">Matt</item>
					<item value="justen" image="../images/avatar/small/justen.jpg">Justen Kitsune</item>
				</dropdown>
			</example>
		</>

		<section label="Search Selection" sticky collapsible dividing>
			<example description="A selection dropdown can allow a user to search through a large list of choices:  `search`.">
				<dropdown fluid search selection name="country" placeholder="Select Country">
					<item value="af" flag="af">Afghanistan</item>
					<item value="ax" flag="ax">Aland Islands</item>
					<item value="al" flag="al">Albania</item>
					<item value="dz" flag="dz">Algeria</item>
					<item value="as" flag="as">American Samoa</item>
					<item value="ad" flag="ad">Andorra</item>
					<item value="ao" flag="ao">Angola</item>
					<item value="ai" flag="ai">Anguilla</item>
					<item value="ag" flag="ag">Antigua</item>
					<item value="ar" flag="ar">Argentina</item>
					<item value="am" flag="am">Armenia</item>
					<item value="aw" flag="aw">Aruba</item>
					<item value="au" flag="au">Australia</item>
					<item value="at" flag="at">Austria</item>
					<item value="az" flag="az">Azerbaijan</item>
					<item value="bs" flag="bs">Bahamas</item>
					<item value="bh" flag="bh">Bahrain</item>
					<item value="bd" flag="bd">Bangladesh</item>
					<item value="bb" flag="bb">Barbados</item>
					<item value="by" flag="by">Belarus</item>
				</dropdown>
			</example>
			<example>
				<dropdown search selection placeholder="State">
					<item value="AL">Alabama</item>
					<item value="AK">Alaska</item>
					<item value="AZ">Arizona</item>
					<item value="AR">Arkansas</item>
