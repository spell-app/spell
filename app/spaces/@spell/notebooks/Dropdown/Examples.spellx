		<section label="Clearable Selection" sticky collapsible dividing>
			<example description="A clearable selection dropdown can allow a user to cancel a previous selection:  `clearable`.">
				<dropdown clearable selection name="language" value="English" placeholder="Select Language">
					<item>Arabic</item>
					<item>Chinese</item>
					<item>Danish</item>
					<item>Dutch</item>
					<item>English</item>
					<item>French</item>
					<item>German</item>
