					<item value="python">Python</item>
					<item value="rails">Rails</item>
					<item value="react">React</item>
					<item value="repair">Kitchen Repair</item>
					<item value="ruby">Ruby</item>
					<item value="ui">UI Design</item>
					<item value="ux">User Experience</item>
				</dropdown>
			</example>
		</>

		<section label="Multiple Search Selection" sticky collapsible dividing>
			<example description="A selection dropdown can allow multiple search selections.">
				<dropdown fluid multiple search selection placeholder="State">
					<item value="AL">Alabama</item>
