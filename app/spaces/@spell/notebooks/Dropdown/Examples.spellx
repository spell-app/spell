			<!-- GAP I106:  no keep-search-term (the query clears on each choice). -->
			<example description="Fomantic can keep the search term after a choice (`keepSearchTerm`) so the menu stays filtered; ours clears it.">
				<dropdown fluid multiple search selection placeholder="State">
					<item value="AL">Alabama</item>
					<item value="AK">Alaska</item>
