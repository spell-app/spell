		<section label="Tagging and User Additions" sticky collapsible dividing>
			<example description="`allow-additions` gives users the ability to add their own options. This can work with either single or multiple search selection dropdowns; `addition-text` words the add item.">
				<header level="5">Single</header>
				<dropdown allow-additions fluid search selection name="skills" placeholder="Skills">
					<item value="angular">Angular</item>
					<item value="css">CSS</item>
					<item value="design">Graphic Design</item>
					<item value="ember">Ember</item>
					<item value="html">HTML</item>
					<item value="ia">Information Architecture</item>
					<item value="javascript">Javascript</item>
					<item value="mech">Mechanical Engineering</item>
					<item value="meteor">Meteor</item>
					<item value="node">NodeJS</item>
					<item value="plumbing">Plumbing</item>
					<item value="python">Python</item>
					<item value="rails">Rails</item>
					<item value="react">React</item>
					<item value="repair">Kitchen Repair</item>
					<item value="ruby">Ruby</item>
					<item value="ui">UI Design</item>
					<item value="ux">User Experience</item>
				</dropdown>
				<header level="5">Multiple</header>
				<dropdown allow-additions fluid multiple search selection name="tags" placeholder="Skills">
					<item value="angular">Angular</item>
					<item value="css">CSS</item>
					<item value="design">Graphic Design</item>
					<item value="ember">Ember</item>
					<item value="html">HTML</item>
					<item value="ia">Information Architecture</item>
					<item value="javascript">Javascript</item>
					<item value="mech">Mechanical Engineering</item>
					<item value="meteor">Meteor</item>
					<item value="node">NodeJS</item>
					<item value="plumbing">Plumbing</item>
					<item value="python">Python</item>
					<item value="rails">Rails</item>
					<item value="react">React</item>
					<item value="repair">Kitchen Repair</item>
					<item value="ruby">Ruby</item>
					<item value="ui">UI Design</item>
					<item value="ux">User Experience</item>
				</dropdown>
			</example>
		</>
		<html>
			<ui-message size="small" class="site-not-ported">Not ported: Stuck User Additions (<code>hideAdditions: false</> + <code>stuck</>) -- our add item is the first row of the filtered menu, so it is always in view.</>
			<ui-message size="small" class="site-not-ported">Text Labels (<code>useLabels: false</>: a "3 selected" count instead of labels) can't be set yet (plan issue I106).</>
		</>

		<section label="Clearing Dropdown" sticky collapsible dividing>
			<example description="You can reset a dropdown to its placeholder: set its `value` to `\"\"` (see Usage, \"Values\"). Here a `clearable` dropdown's own clear button does it.">
				<dropdown clearable multiple selection name="gender" value="0,1" placeholder="Default">
					<item value="1">Male</item>
					<item value="0">Female</item>
				</dropdown>
				<dropdown clearable selection name="gender" placeholder="Select a value">
					<item value="1">Male</item>
					<item value="0">Female</item>
				</dropdown>
			</example>
		</>

		<section label="Restoring Defaults" sticky collapsible dividing>
			<example description="A form reset restores a dropdown to its `value` attribute (Fomantic's `restore defaults`). Change them, then reset.">
				<html>
					<ui-form>
						<form>
							<ui-field>
								<ui-dropdown multiple selection name="defaults" value="default,default2" placeholder="Default">
									<ui-item value="default">Default</ui-item>
									<ui-item value="default2">Another Default</ui-item>
									<ui-item value="1">Male</ui-item>
									<ui-item value="0">Female</ui-item>
								</ui-dropdown>
							</ui-field>
							<ui-field>
								<ui-dropdown selection name="default" value="default" placeholder="Select a value">
									<ui-item value="default">Default Value</ui-item>
									<ui-item value="1">Male</ui-item>
									<ui-item value="0">Female</ui-item>
								</ui-dropdown>
							</ui-field>
							<ui-button type="reset" color="primary">Restore All Dropdowns</ui-button>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Upward" sticky collapsible dividing>
			<example description="A dropdown menu will automatically change which direction it opens if it can't fit on screen. To open in a specific direction, use `upward`.">
				<segment attach="top">
					<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
				</segment>
				<menu attach="bottom">
					<item>
						<dropdown direction="up" aria-label="Settings">
							<icon slot="trigger" name="cog"/>
							<item>New</item>
							<item>Open...</item>
							<item>Save...</item>
							<item>Edit Permissions</item>
							<item kind="divider"/>
							<item kind="header">Export</item>
							<item>Share...</item>
							<item>Save As...</item>
						</dropdown>
					</item>
				</menu>
			</example>
		</>
	</>

	<section label="Remote Content">
		<html>
			<ui-message size="small" class="site-not-ported">Not ported: Fomantic's API settings (<code>apiSettings</>, <code>filterRemoteData</>, response mapping). Fetch the data yourself on <code>ui-search</>, and set the <code>options</> property (Usage tab, "Rich data").</>
		</>
	</>

	<section label="Menus">
		<html>
			<ui-message size="small" class="site-not-ported">Not ported: Changing Transitions (<code>transition</>) -- the menu fades through CSS; restyle it with <code>::part(menu)</>.</>
			<ui-message size="small" class="site-not-ported">Multiple Levels and Category Selection (sub-menus inside the menu, <code>allowCategorySelection</>) can't be built: the menu is one listbox deep (plan issue I53).</>
		</>

		<section label="Preserving User Selections" sticky collapsible dividing>
			<example description="A dropdown shows the item whose value is its `value` on page load. `text` shows a text before the items (or `options`) arrive.">
				<dropdown selection value="trash" placeholder="Folder">
					<item value="inbox">Inbox</item>
					<item value="drafts">Drafts</item>
					<item value="trash">Trash</item>
				</dropdown>
			</example>
		</>

		<section label="Dropdown Dividers / Headers" sticky collapsible dividing>
			<example description="A dropdown menu can contain dividers and headers to separate related content. While searching, they hide and only the matching items show (Fomantic's `hideDividers`).">
				<dropdown labeled button search pointing="top left" icon="filter" placeholder="Filter Posts">
					<item kind="header" icon="tags">Filter by tag</item>
					<item value="important"><label color="red" empty appearance="circular"/>Important</item>
					<item value="announcement"><label color="blue" empty appearance="circular"/>Announcement</item>
					<item value="discussion"><label color="black" empty appearance="circular"/>Discussion</item>
					<item kind="divider"/>
					<item kind="header" icon="calendar">Filter by date</item>
					<item value="week">This Week</item>
					<item value="month">This Month</item>
					<item value="year">This Year</item>
				</dropdown>
			</example>
		</>
	</>

	<section label="Adjusting Actions">
		<html>
			<ui-message size="small" class="site-not-ported">Combo Dropdowns and Link Dropdowns (<code>action: "combo" | "nothing" | "hide"</>: an item that changes a button, or a menu of links) can't be built yet: every dropdown is a select with a value (plan issue I53).</>
		</>
	</>

	<section label="Coupling">
		<!-- GAP I11:  no basic look, so the button group's dropdowns are filled. -->
		<section label="Button Group" sticky collapsible dividing>
			<example description="A button group can be formatted to show additional content as a dropdown.">
				<buttons>
					<dropdown button pointing="top left" label="Visit">
						<item>Home</item>
						<item>Blog</item>
					</dropdown>
					<dropdown button pointing="top left" label="Edit">
						<item>Edit Post</item>
						<item>Remove Post</item>
					</dropdown>
					<dropdown button pointing="top right" label="Share">
						<item>Facebook</item>
						<item>Twitter</item>
					</dropdown>
				</buttons>
			</example>
		</>

		<!-- GAP I53:  no dropdown that IS a menu item;  a dropdown sits inside an item. -->
		<section label="Menu" sticky collapsible dividing>
			<example description="A menu can contain a dropdown, inside an item. Fomantic's dropdown that IS the item (`ui dropdown item`) isn't there yet.">
				<menu>
					<item link="#home">Home</item>
					<item>
						<dropdown label="Categories">
							<item>Electronics</item>
							<item>Automotive</item>
							<item>Home</item>
						</dropdown>
					</item>
				</menu>
			</example>
		</>

		<section label="Form" sticky collapsible dividing>
			<example description="A dropdown can be formatted to allow selection inside a form:  it is a form control.">
				<html>
					<ui-form>
						<form>
							<ui-field>
								<label for="dropdown-form-gender">Gender</label>
								<ui-dropdown id="dropdown-form-gender" selection name="gender" placeholder="Gender">
									<ui-item value="male">Male</ui-item>
									<ui-item value="female">Female</ui-item>
								</ui-dropdown>
							</ui-field>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Invoker commands" sticky collapsible dividing>
			<example description="Buttons drive a dropdown with no script:  `commandfor` + `command=\"--show\"`, `--close` or `--toggle`.">
				<button commandfor="dropdown-invoker" command="--show">Open the menu</button>
				<button commandfor="dropdown-invoker" command="--close">Close it</button>
				<dropdown id="dropdown-invoker" selection placeholder="Pick one">
					<item value="a">Alpha</item>
					<item value="b">Beta</item>
				</dropdown>
			</example>
		</>
	</>
</spell-notebook>
