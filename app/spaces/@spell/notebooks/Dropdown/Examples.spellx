			<example description="Very long:  3x of default height (`length=\"very-long\"`).  `short` and `very-short` go the other way.">
				<dropdown length="very-long" multiple search selection placeholder="State">
					<item value="AL">Alabama</item>
					<item value="AK">Alaska</item>
					<item value="AZ">Arizona</item>
