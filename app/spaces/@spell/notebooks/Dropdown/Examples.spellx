		<!-- GAP I11:  no basic button look. -->
		<section label="Search Dropdown" sticky collapsible dividing>
			<example description="A dropdown can be searchable, on a labeled icon button too.">
				<dropdown floating labeled button search icon="world" placeholder="Select Language">
					<item>Arabic</item>
					<item>Chinese</item>
					<item>Danish</item>
					<item>Dutch</item>
					<item>English</item>
					<item>French</item>
					<item>German</item>
					<item>Greek</item>
					<item>Hungarian</item>
					<item>Italian</item>
					<item>Japanese</item>
					<item>Korean</item>
					<item>Lithuanian</item>
					<item>Persian</item>
					<item>Polish</item>
					<item>Portuguese</item>
					<item>Russian</item>
					<item>Spanish</item>
					<item>Swedish</item>
					<item>Turkish</item>
					<item>Vietnamese</item>
				</dropdown>
			</example>
		</>

		<!-- GAP I106:  an input in the menu doesn't filter it (Fomantic's search in-menu);  the header slot just shows it. -->
		<section label="Search In-Menu" sticky collapsible dividing>
			<example description="A dropdown can include content at the top of its menu: the `header` slot. Fomantic's in-menu search input also filters the items; ours is only shown, so use `search` to filter.">
				<dropdown floating labeled button scrolling icon="filter" label="Filter Posts">
					<input slot="header" icon="search" placeholder="Search tags..." aria-label="Search tags"/>
					<item kind="divider"/>
					<item kind="header" icon="tags">Tag Label</item>
					<item value="important"><label color="red" empty appearance="circular"/>Important</item>
					<item value="announcement"><label color="blue" empty appearance="circular"/>Announcement</item>
					<item value="cannotfix"><label color="black" empty appearance="circular"/>Cannot Fix</item>
					<item value="news"><label color="purple" empty appearance="circular"/>News</item>
					<item value="enhancement"><label color="orange" empty appearance="circular"/>Enhancement</item>
					<item value="declined"><label empty appearance="circular"/>Change Declined</item>
					<item value="off-topic"><label color="yellow" empty appearance="circular"/>Off Topic</item>
					<item value="interesting"><label color="pink" empty appearance="circular"/>Interesting</item>
					<item value="discussion"><label color="green" empty appearance="circular"/>Discussion</item>
				</dropdown>
			</example>
			<example>
				<dropdown multiple scrolling name="filters" placeholder="Filter Posts">
					<item value="important"><label color="red" empty appearance="circular"/>Important</item>
					<item value="announcement"><label color="blue" empty appearance="circular"/>Announcement</item>
					<item value="cannotfix"><label color="black" empty appearance="circular"/>Cannot Fix</item>
					<item value="news"><label color="purple" empty appearance="circular"/>News</item>
					<item value="enhancement"><label color="orange" empty appearance="circular"/>Enhancement</item>
					<item value="declined"><label empty appearance="circular"/>Change Declined</item>
					<item value="off-topic"><label color="yellow" empty appearance="circular"/>Off Topic</item>
					<item value="interesting"><label color="pink" empty appearance="circular"/>Interesting</item>
					<item value="discussion"><label color="green" empty appearance="circular"/>Discussion</item>
				</dropdown>
			</example>
		</>

		<section label="Inline" sticky collapsible dividing>
			<example description="A dropdown can be formatted to appear inline in other content.">
				<html>
					<p>Show me posts by <ui-dropdown inline value="jenny"><ui-item value="jenny" image="../images/avatar/small/jenny.jpg">Jenny Hess</ui-item> <ui-item value="elliot" image="../images/avatar/small/elliot.jpg">Elliot Fu</ui-item> <ui-item value="stevie" image="../images/avatar/small/stevie.jpg">Stevie Feliciano</ui-item> <ui-item value="christian" image="../images/avatar/small/christian.jpg">Christian</ui-item> <ui-item value="matt" image="../images/avatar/small/matt.jpg">Matt</ui-item> <ui-item value="justen" image="../images/avatar/small/justen.jpg">Justen Kitsune</ui-item></ui-dropdown></p>
				</html>
			</example>
			<example>
				<header level="4"><icon name="trophy"/> Trending repos <dropdown inline value="today"><item kind="header">Adjust time span</item> <item value="today" label="today">Today</item> <item value="this week" label="this week">This Week</item> <item value="this month" label="this month">This Month</item></dropdown></header>
			</example>
		</>

		<!-- GAP I53:  no dropdown menu item, no nested sub-menus;  the menu examples keep a dropdown inside an item. -->
		<section label="Pointing" sticky collapsible dividing>
			<example description="A dropdown can be formatted so that its menu is pointing: `pointing`, with a value for where the menu's arrow sits.">
				<dropdown pointing label="Shopping">
					<item kind="header">Categories</item>
					<item>Clothing</item>
					<item>Home Goods</item>
					<item>Bedroom</item>
					<item kind="divider"/>
					<item kind="header">Order</item>
					<item>Status</item>
					<item>Cancellations</item>
				</dropdown>
			</example>
			<example>
				<dropdown pointing="left" label="Messages">
					<item>Inbox</item>
					<item>Starred</item>
					<item>Sent Mail</item>
					<item>Drafts (143)</item>
					<item kind="divider"/>
					<item>Spam (1009)</item>
					<item>Trash</item>
				</dropdown>
			</example>
			<example>
				<dropdown button pointing="top left" aria-label="Settings">
					<icon slot="trigger" name="wrench"/>
					<item kind="header">Display Density</item>
					<item>Comfortable</item>
					<item>Cozy</item>
					<item>Compact</item>
					<item kind="divider"/>
					<item>Settings</item>
					<item>Upload Settings</item>
					<item>Manage Apps</item>
					<item>Keyboard Shortcuts</item>
					<item>Help</item>
				</dropdown>
			</example>
			<example>
				<dropdown button pointing="bottom left" aria-label="File">
					<icon slot="trigger" name="wrench"/>
					<item>New</item>
					<item>Open...</item>
					<item>Save...</item>
					<item>Edit Permissions</item>
					<item kind="divider"/>
					<item kind="header">Export</item>
					<item>Share...</item>
					<item>Save As...</item>
				</dropdown>
				<dropdown button pointing="bottom right" aria-label="File">
					<icon slot="trigger" name="wrench"/>
					<item>New</item>
					<item>Open...</item>
					<item>Save As...</item>
				</dropdown>
			</example>
			<example>
				<dropdown labeled button pointing="top left" icon="filter" label="Filter Posts">
					<item kind="header" icon="tags">Filter by tag</item>
					<item value="important"><label color="red" empty appearance="circular"/>Important</item>
					<item value="announcement"><label color="blue" empty appearance="circular"/>Announcement</item>
					<item value="discussion"><label color="black" empty appearance="circular"/>Discussion</item>
					<item kind="divider"/>
					<item kind="header">Filter by date</item>
					<item><icon name="circle" color="olive"/>This Week</item>
					<item><icon name="circle" color="violet"/>This Month</item>
					<item><icon name="circle" color="orange"/>This Year</item>
				</dropdown>
			</example>
			<example>
				<dropdown button pointing="right" aria-label="Settings">
					<icon slot="trigger" name="cog"/>
					<item kind="header">Filter by tag</item>
					<item value="important"><label color="red" empty appearance="circular"/>Important</item>
					<item value="announcement"><label color="blue" empty appearance="circular"/>Announcement</item>
					<item value="discussion"><label color="black" empty appearance="circular"/>Discussion</item>
				</dropdown>
				<dropdown button pointing="left" aria-label="Settings">
					<icon slot="trigger" name="cog"/>
					<item kind="header">Tag Label</item>
					<item value="important"><label color="red" empty appearance="circular"/>Important</item>
					<item value="announcement"><label color="blue" empty appearance="circular"/>Announcement</item>
					<item value="discussion"><label color="black" empty appearance="circular"/>Discussion</item>
				</dropdown>
			</example>
		</>

		<section label="Floating" sticky collapsible dividing>
			<example description="A dropdown menu can appear to be floating below an element.">
				<buttons color="teal">
					<button>Save</button>
					<dropdown floating button color="teal" aria-label="More actions">
						<item icon="edit">Edit Post</item>
						<item icon="delete">Remove Post</item>
						<item icon="eye slash">Hide Post</item>
					</dropdown>
				</buttons>
			</example>
		</>

		<section label="Simple" sticky collapsible dividing>
			<example description="A simple dropdown can open without JavaScript:  on hover and focus, with no popover.">
				<dropdown appearance="simple" label="Dropdown">
					<item>Choice 1</item>
					<item>Choice 2</item>
					<item>Choice 3</item>
				</dropdown>
			</example>
		</>
	</>

	<section label="Content">
		<!-- GAP I107:  a header item's `icon` draws nothing;  slotted labels are tiny dots touching the text. -->
		<section label="Header" sticky collapsible dividing>
			<example description="A dropdown menu can contain a header:  `type=\"header\"`.">
				<dropdown floating labeled button icon="filter" label="Filter">
					<item kind="header" icon="tags">Filter by tag</item>
					<item>Important</item>
					<item>Announcement</item>
					<item>Discussion</item>
				</dropdown>
			</example>
		</>

		<section label="Divider" sticky collapsible dividing>
			<example description="A dropdown menu can contain dividers to separate related content:  `type=\"divider\"`.">
				<dropdown floating labeled button icon="filter" label="Filter">
					<item kind="header" icon="tags">Filter by tag</item>
					<item kind="divider"/>
					<item>Important</item>
					<item>Announcement</item>
					<item>Discussion</item>
				</dropdown>
			</example>
		</>

		<section label="Icon" sticky collapsible dividing>
			<example description="A dropdown menu can contain an icon:  `icon`.">
				<dropdown floating labeled button icon="filter" label="Filter">
					<item kind="header" icon="tags">Filter by tag</item>
					<item kind="divider"/>
					<item icon="exclamation">Important</item>
					<item icon="comment">Announcement</item>
					<item icon="comments">Discussion</item>
				</dropdown>
			</example>
		</>

		<section label="Description" sticky collapsible dividing>
			<example description="A dropdown menu can contain a description:  `description`.">
				<dropdown floating labeled button icon="filter" label="Filter Tags">
					<item kind="header">Filter by tag</item>
					<item kind="divider"/>
					<item description="2 new">Important</item>
					<item description="10 new">Hopper</item>
					<item description="5 new">Discussion</item>
				</dropdown>
			</example>
		</>

		<!-- GAP I107:  no vertical item (the description under the text). -->
		<html>
			<ui-message size="small" class="site-not-ported">Fomantic's <code>vertical item</> (the description underneath the entry) has no attribute yet (plan issue I107).</>
		</>

		<section label="Label" sticky collapsible dividing>
			<example description="A dropdown menu can contain a label:  any markup inside an item is projected into its row.">
				<dropdown floating labeled button icon="filter" label="Filter">
					<item kind="header">Search Issues</item>
					<item kind="header" icon="tags">Filter by tag</item>
					<item value="important"><label color="red" empty appearance="circular"/>Important</item>
					<item value="announcement"><label color="blue" empty appearance="circular"/>Announcement</item>
					<item value="discussion"><label color="black" empty appearance="circular"/>Discussion</item>
				</dropdown>
			</example>
		</>

		<!-- GAP I107:  the header slot is unpadded, and an item-less menu adds "No results found." under the message. -->
		<section label="Message" sticky collapsible dividing>
			<example description="A dropdown menu can contain a message:  the `header` slot holds any markup.">
				<dropdown floating labeled button icon="filter" label="Login">
					<message slot="header" state="error" heading="Error">You must log-in to see all categories</message>
				</dropdown>
			</example>
			<example description="A search that matches nothing shows the translated `noResults` text, or `no-results-text`.">
				<dropdown search selection no-results-text="No country by that name." placeholder="Select Country">
					<item value="af" flag="af">Afghanistan</item>
					<item value="ax" flag="ax">Aland Islands</item>
					<item value="al" flag="al">Albania</item>
					<item value="dz" flag="dz">Algeria</item>
					<item value="as" flag="as">American Samoa</item>
					<item value="ad" flag="ad">Andorra</item>
					<item value="ao" flag="ao">Angola</item>
					<item value="ai" flag="ai">Anguilla</item>
					<item value="ag" flag="ag">Antigua</item>
					<item value="ar" flag="ar">Argentina</item>
					<item value="am" flag="am">Armenia</item>
					<item value="aw" flag="aw">Aruba</item>
					<item value="au" flag="au">Australia</item>
					<item value="at" flag="at">Austria</item>
					<item value="az" flag="az">Azerbaijan</item>
					<item value="bs" flag="bs">Bahamas</item>
					<item value="bh" flag="bh">Bahrain</item>
					<item value="bd" flag="bd">Bangladesh</item>
					<item value="bb" flag="bb">Barbados</item>
					<item value="by" flag="by">Belarus</item>
				</dropdown>
			</example>
		</>

		<!-- GAP I107:  no floated content in an item (`right floated icon`). -->
		<section label="Content at the End" sticky collapsible dividing>
			<example description="A dropdown item can have content at the end of its row: its `description`. An icon can't go at the end yet.">
				<dropdown fluid selection placeholder="Select Type">
					<item description="!">Important</item>
					<item icon="comment">Announcement</item>
					<item icon="comments">Discussion</item>
				</dropdown>
			</example>
		</>

		<section label="Input" sticky collapsible dividing>
			<example description="A dropdown menu can contain an input, in the `header` slot. It doesn't filter the items: use `search` for that.">
				<dropdown floating labeled button icon="filter" label="Filter">
					<input slot="header" icon="search" icon-position="left" placeholder="Search..." aria-label="Search"/>
					<item kind="header" icon="tags">Filter by tag</item>
					<item kind="divider"/>
					<item value="important"><label color="red" empty appearance="circular"/>Important</item>
					<item value="announcement"><label color="blue" empty appearance="circular"/>Announcement</item>
					<item value="discussion"><label color="black" empty appearance="circular"/>Discussion</item>
				</dropdown>
			</example>
		</>

		<section label="Image" sticky collapsible dividing>
			<example description="A dropdown menu can contain an image:  `image`.">
				<dropdown floating labeled button icon="user plus" label="Add User">
					<item kind="header">People You Might Know</item>
					<item image="../images/avatar/small/jenny.jpg">Jenny Hess</item>
					<item image="../images/avatar/small/elliot.jpg">Elliot Fu</item>
					<item image="../images/avatar/small/stevie.jpg">Stevie Feliciano</item>
					<item kind="header">Your Friends' Friends</item>
					<item image="../images/avatar/small/christian.jpg">Christian</item>
					<item image="../images/avatar/small/matt.jpg">Matt</item>
					<item image="../images/avatar/small/justen.jpg">Justen Kitsune</item>
				</dropdown>
			</example>
			<example description="Or a flag:  `flag`.">
				<dropdown selection value="fr" placeholder="Country">
					<item value="fr" flag="fr">France</item>
					<item value="de" flag="de">Germany</item>
					<item value="jp" flag="jp">Japan</item>
				</dropdown>
			</example>
		</>

		<!-- GAP I53:  no actionable items (an item that runs a callback instead of being chosen). -->
		<html>
			<ui-message size="small" class="site-not-ported">Actionable (an item that runs a callback instead of being chosen) can't be built yet: every item is an option (plan issue I53). Listen for <code>ui-changed</> and set the value back.</>
		</>
	</>

	<section label="States">
		<section label="Loading" sticky collapsible dividing>
			<example description="A dropdown can show that it is currently loading data.">
				<dropdown loading label="Dropdown">
					<item>Choice 1</item>
					<item>Choice 2</item>
					<item>Choice 3</item>
				</dropdown>
			</example>

			<!-- GAP I108:  no slow / double / elastic loader;  the colour tints the box, not the loader. -->
			<example>
				<dropdown loading color="red" fluid multiple search selection value="kp" placeholder="Search...">
					<item>Choice 1</item>
					<item>Choice 2</item>
					<item>Choice 3</item>
				</dropdown>
			</example>
			<example>
				<dropdown loading color="teal" selection label="Dropdown">
					<item>Choice 1</item>
					<item>Choice 2</item>
					<item>Choice 3</item>
				</dropdown>
			</example>
		</>

		<section label="Error" sticky collapsible dividing>
			<example description="An errored dropdown can alert a user to a problem:  `state=\"error\"`.">
				<dropdown floating state="error" label="Dropdown">
					<item>Choice 1</item>
					<item>Choice 2</item>
					<item>Choice 3</item>
				</dropdown>
			</example>
			<example>
				<dropdown selection state="error" label="Dropdown">
					<item>Choice 1</item>
					<item>Choice 2</item>
					<item>Choice 3</item>
				</dropdown>
			</example>
		</>

		<section label="Form states" sticky collapsible dividing>
			<example description="`state` also takes `info`, `success` and `warning`:  it tints the box, the text and the menu.">
				<dropdown state="info" selection label="Info">
					<item>One</item>
				</dropdown>
				<dropdown state="success" selection label="Success">
					<item>One</item>
				</dropdown>
				<dropdown state="warning" multiple selection placeholder="Warning" value="warning">
					<item value="warning">Warning</item>
					<item>One</item>
				</dropdown>
			</example>
		</>

		<section label="Active" sticky collapsible dividing>
			<example description="An active dropdown has its menu open: `open`. Setting it fires no event.">
				<dropdown open label="Dropdown">
					<item>Choice 1</item>
					<item>Choice 2</item>
				</dropdown>
			</example>
		</>

		<section label="Disabled" sticky collapsible dividing>
			<example description="A disabled dropdown menu or item does not allow user interaction.  A disabled dropdown isn't submitted.">
				<dropdown disabled label="Dropdown">
					<item>Choice 1</item>
					<item>Choice 2</item>
					<item>Choice 3</item>
				</dropdown>
			</example>
			<example>
				<dropdown label="Disabled Item">
					<item>Choice 1</item>
					<item disabled>Disabled</item>
					<item>Choice 3</item>
				</dropdown>
			</example>
		</>

		<section label="Read-Only" sticky collapsible dividing>
			<example description="A dropdown can be read-only and does not allow user interaction, but still submits with a form.">
				<dropdown readonly label="Dropdown">
					<item>Choice 1</item>
					<item>Choice 2</item>
					<item>Choice 3</item>
				</dropdown>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Size" sticky collapsible dividing>
			<example description="A dropdown can have different sizes.">
				<dropdown size="mini" selection name="gender" placeholder="Mini">
					<item value="1">Male</item>
					<item value="0">Female</item>
				</dropdown>
				<dropdown size="tiny" selection name="gender" placeholder="Tiny">
					<item value="1">Male</item>
					<item value="0">Female</item>
				</dropdown>
				<dropdown size="small" selection name="gender" placeholder="Small">
					<item value="1">Male</item>
					<item value="0">Female</item>
				</dropdown>
				<dropdown size="medium" selection name="gender" placeholder="Medium">
					<item value="1">Male</item>
					<item value="0">Female</item>
				</dropdown>
				<dropdown size="large" selection name="gender" placeholder="Large">
					<item value="1">Male</item>
					<item value="0">Female</item>
				</dropdown>
			</example>
			<example>
				<dropdown size="big" selection name="gender" placeholder="Big">
					<item value="1">Male</item>
					<item value="0">Female</item>
				</dropdown>
				<dropdown size="huge" selection name="gender" placeholder="Huge">
					<item value="1">Male</item>
					<item value="0">Female</item>
				</dropdown>
				<dropdown size="massive" selection name="gender" placeholder="Massive">
					<item value="1">Male</item>
					<item value="0">Female</item>
				</dropdown>
			</example>
		</>

		<section label="Scrolling" sticky collapsible dividing>
			<example description="A dropdown can have its menu scroll: `scrolling`; add `resizable` for a native resize handle at the bottom of the menu.">
				<dropdown scrolling name="choice" placeholder="Select choice">
					<item>Choice 1</item>
					<item>Choice 2</item>
					<item>Choice 3</item>
					<item>Choice 4</item>
					<item>Choice 5</item>
					<item>Choice 6</item>
					<item>Choice 7</item>
					<item>Choice 8</item>
					<item>Choice 9</item>
					<item>Choice 10</item>
					<item>Choice 11</item>
					<item>Choice 12</item>
					<item>Choice 13</item>
					<item>Choice 14</item>
					<item>Choice 15</item>
				</dropdown>
				<dropdown scrolling resizable name="choice" placeholder="Resizable">
					<item>Choice 1</item>
					<item>Choice 2</item>
					<item>Choice 3</item>
					<item>Choice 4</item>
					<item>Choice 5</item>
					<item>Choice 6</item>
					<item>Choice 7</item>
					<item>Choice 8</item>
					<item>Choice 9</item>
					<item>Choice 10</item>
				</dropdown>
			</example>
			<example>
				<dropdown scrolling label="Filter Posts">
					<item kind="header" icon="tags">Tag Label</item>
					<item value="important"><label color="red" empty appearance="circular"/>Important</item>
					<item value="announcement"><label color="blue" empty appearance="circular"/>Announcement</item>
					<item value="cannotfix"><label color="black" empty appearance="circular"/>Cannot Fix</item>
					<item value="news"><label color="purple" empty appearance="circular"/>News</item>
					<item value="enhancement"><label color="orange" empty appearance="circular"/>Enhancement</item>
					<item value="declined"><label empty appearance="circular"/>Change Declined</item>
					<item value="off-topic"><label color="yellow" empty appearance="circular"/>Off Topic</item>
					<item value="interesting"><label color="pink" empty appearance="circular"/>Interesting</item>
					<item value="discussion"><label color="green" empty appearance="circular"/>Discussion</item>
				</dropdown>
			</example>
		</>

		<section label="Inverted" sticky collapsible dividing>
			<example description="A dropdown can be inverted.">
				<segment inverted>
					<dropdown inverted selection name="choices" placeholder="Select choice">
						<item>Choice 1</item>
						<item>Choice 2</item>
						<item>Choice 3</item>
					</dropdown>
				</segment>
			</example>
		</>

		<!-- GAP I107:  no inverted menu on a plain dropdown. -->
		<html>
			<ui-message size="small" class="site-not-ported">Fomantic can invert only the menu of a non-inverted dropdown (<code>inverted menu</>); ours inverts the whole dropdown (plan issue I107).</>
		</>

		<section label="Compact" sticky collapsible dividing>
			<example description="A compact dropdown has no minimum width:  `padding=\"compact\"`.">
				<dropdown padding="compact" selection label="Compact">
					<item>A</item>
					<item>B</item>
					<item>C</item>
				</dropdown>
				<dropdown padding="compact" selection label="Compact">
					<item>A very long item that takes up a lot of space</item>
					<item>B</item>
				</dropdown>
			</example>
		</>

		<section label="Fluid" sticky collapsible dividing>
			<example description="A dropdown can take the full width of its parent:  `fluid`.">
				<menu direction="vertical">
					<item link="#link-1">Link 1</item>
					<item link="#link-2">Link 2</item>
					<item kind="header">All Sections</item>
					<item>
						<dropdown fluid selection label="More">
							<item>Choice 1</item>
							<item>Choice 2</item>
							<item>Choice 3</item>
						</dropdown>
					</item>
				</menu>
			</example>
		</>

		<section label="Height" sticky collapsible dividing>
			<example description="A selection dropdown can be `long` (2x of default height) so that more items can be glanced.">
