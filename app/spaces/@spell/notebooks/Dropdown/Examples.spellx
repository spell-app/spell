					<item>Vietnamese</item>
				</dropdown>
			</example>
			<example>
				<dropdown clearable multiple selection name="languages" value="Dutch,English,French" placeholder="Select Languages">
					<item>Arabic</item>
					<item>Chinese</item>
					<item>Danish</item>
