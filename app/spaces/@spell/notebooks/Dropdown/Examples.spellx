					<item value="WI">Wisconsin</item>
					<item value="WY">Wyoming</item>
				</dropdown>
			</example>
		</>

		<!-- GAP I106:  no unfilterable items. -->
		<section label="Unfilterable items in Search Selection" sticky collapsible dividing>
			<example description="Fomantic can keep some items listed whatever the search (`unfilterable` items). Ours filters every item; the example shows the list without the extra rule.">
				<dropdown search selection name="states" placeholder="States">
					<item value="AL">Alabama (unfilterable)</item>
					<item value="AK">Alaska</item>
					<item value="AZ">Arizona (unfilterable)</item>
					<item value="AR">Arkansas (unfilterable)</item>
					<item value="CA">California</item>
					<item value="OH">Ohio</item>
					<item value="OK">Oklahoma</item>
				</dropdown>
			</example>
		</>

		<!-- GAP I106:  no ignore-diacritics setting on the element (MenuOptions has one). -->
		<section label="Search ignoring Diacritics" sticky collapsible dividing>
			<example description="Fomantic can ignore diacritics while searching (`ignoreDiacritics`). Ours matches them as typed:  type `cafe`, and only `cafetería` matches, not café.">
				<dropdown search selection name="diacritics" placeholder="Search diacritics by only typing usual vowels">
					<item>André</item>
					<item>Bokmål</item>
					<item>café</item>
					<item>cafetería</item>
					<item>château</item>
					<item>décolleté</item>
					<item>Élysée</item>
					<item>Fräulein</item>
					<item>garçon</item>
					<item>háček</item>
					<item>Québec</item>
					<item>Škoda</item>
					<item>über</item>
					<item>voilà</item>
					<item>Zoë</item>
				</dropdown>
			</example>
		</>

		<section label="Highlight search matches" sticky collapsible dividing>
			<example description="The matching strings inside the search results are highlighted: always on, no setting.">
				<dropdown fluid multiple search selection placeholder="State">
					<item value="AL">Alabama</item>
					<item value="AK">Alaska</item>
					<item value="AZ">Arizona</item>
