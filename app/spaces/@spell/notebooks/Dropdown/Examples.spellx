			<example description="Items can hold content a native `<option>` can't, such as flags.">
				<dropdown fluid multiple search selection name="country" placeholder="Select Country">
					<item value="af" flag="af">Afghanistan</item>
					<item value="ax" flag="ax">Aland Islands</item>
