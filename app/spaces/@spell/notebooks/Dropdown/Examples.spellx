					<item>Left</item>
					<item>Still Left</item>
				</dropdown>
				<dropdown floating labeled button icon="caret down" label="Menu">
					<item>Right</item>
					<item>Still Right</item>
				</dropdown>
				<dropdown direction="up" selection label="Upward">
					<item>One</item>
					<item>Two</item>
				</dropdown>
			</example>
		</>

