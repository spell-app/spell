					<item value="NY">New York</item>
					<item value="NC">North Carolina</item>
					<item value="ND">North Dakota</item>
					<item value="OH">Ohio</item>
					<item value="OK">Oklahoma</item>
					<item value="OR">Oregon</item>
					<item value="PA">Pennsylvania</item>
					<item value="RI">Rhode Island</item>
					<item value="SC">South Carolina</item>
					<item value="SD">South Dakota</item>
					<item value="TN">Tennessee</item>
					<item value="TX">Texas</item>
					<item value="UT">Utah</item>
					<item value="VT">Vermont</item>
