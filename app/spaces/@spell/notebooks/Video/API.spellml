<spell-notebook "video api">
	<header level="1">
		Video
		<header>A video plays a video file in the browser's own player.</>
	</>
	<video-tab-bar showing="api"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#tags">Tags</>
			<item link="#attributes">Attributes</>
			<item link="#events">Events</>
			<item link="#parts">Parts</>
			<item link="#states">States</>
			<item link="#texts">Texts</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`site/_data/components.json5`);  nothing to write. -->
	<section label="Tags">
		<html>
			<ui-docs-api family="ui-video" only="tags"></>
		</>
	</>

	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-video" only="attributes"></>
		</>
	</>

	<section label="Events">
		<html>
			<ui-docs-api family="ui-video" only="events"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-video" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-video" only="states"></>
		</>
	</>

	<section label="Texts">
		<html>
			<ui-docs-api family="ui-video" only="texts"></>
		</>
	</>
</spell-notebook>
