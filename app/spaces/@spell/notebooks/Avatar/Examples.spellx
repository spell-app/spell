<spell-notebook "avatar examples">
	<header level="1">
		Avatar
		<header>An avatar is a small picture of a person, beside a comment, an item or a card.</>
	</>
	<avatar-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#owners">Owners</>
			<item link="#content">Content</>
		</>
	</>

	<!--
		EXAMPLES:  `<ui-avatar>` in each owner that gives it a look (from the owners' own pages and
		`src/components/ui-parts/examples/elements/`), then its attributes.  The Content parts page
		(`ui-header.html`) shows every part together.
	-->
	<section label="Owners">
		<section label="Comment" sticky="stack" collapsible dividing>
			<example "Comment" description="A comment's avatar sits beside its content.">
				<comments>
					<comment>
						<avatar src="/components/ui/images/avatar/small/elliot.jpg"/>
						<content>
							<author link="#elliot">Elliot Fu</author>
							<meta>
								<text>Yesterday at 12:30AM</text>
							</meta>
							<description>This has been very useful for my research. Thanks as well!</description>
						</content>
					</comment>
				</comments>
			</example>
		</>

		<section label="Card" sticky="stack" collapsible dividing>
			<example "Card" description="In a card, an avatar is a small round image before a name.">
				<card>
					<content><avatar src="/components/ui/images/avatar/small/jenny.jpg"/> Jenny Hess</content>
				</card>
			</example>
		</>

		<section label="Item" sticky="stack" collapsible dividing>
			<example "Item" description="In an item, a round image before a name.">
				<items>
					<item>
						<content><avatar src="/components/ui/images/avatar/small/stevie.jpg"/> Stevie Feliciano</content>
					</item>
				</items>
			</example>
		</>
	</>

	<section label="Content">
		<section label="Image" sticky="stack" collapsible dividing>
			<example "Image" description="`src` renders the image;  or slot your own `<img>`.">
				<comments>
					<comment>
						<avatar>
							<image alt="Joe Henderson" src="/components/ui/images/avatar/small/joe.jpg"/>
						</avatar>
						<content>
							<description>A slotted image, with its own <text code>alt</text>.</description>
						</content>
					</comment>
				</comments>
			</example>
		</>
	</>
</spell-notebook>
