<spell-notebook "avatar api">
	<header level="1">
		Avatar
		<header>An avatar is a small picture of a person, beside a comment, an item or a card.</>
	</>
	<avatar-tab-bar showing="api"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#attributes">Attributes</>
			<item link="#slots">Slots</>
			<item link="#parts">Parts</>
			<item link="#states">States</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`docs/__data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api tag="ui-avatar" only="attributes"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api tag="ui-avatar" only="slots"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api tag="ui-avatar" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api tag="ui-avatar" only="states"></>
		</>
	</>
</spell-notebook>
