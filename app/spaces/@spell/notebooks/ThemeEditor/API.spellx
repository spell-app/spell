<spell-notebook "theme-editor api">
	<header level="1">
		Theme Editor
		<header>A theme editor makes a theme from an existing one:  its colours, fonts and shapes, live on real elements, then copied as a stylesheet or kept in the browser.</>
	</>
	<theme-editor-tab-bar showing="api"/>
	<section>
		<html>
			<ui-menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
				<ui-item link="#attributes">Attributes</>
				<ui-item link="#properties">Properties</>
				<ui-item link="#events">Events</>
				<ui-item link="#parts">Parts</>
				<ui-item link="#states">States</>
				<ui-item link="#texts">Texts</>
			</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`site/_data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-theme-editor" only="attributes"></>
		</>
	</>

	<section label="Properties">
		<html>
			<ui-docs-api family="ui-theme-editor" only="properties"></>
		</>
	</>

	<section label="Events">
		<html>
			<ui-docs-api family="ui-theme-editor" only="events"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-theme-editor" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-theme-editor" only="states"></>
		</>
	</>

	<section label="Texts">
		<html>
			<ui-docs-api family="ui-theme-editor" only="texts"></>
		</>
	</>
</spell-notebook>
