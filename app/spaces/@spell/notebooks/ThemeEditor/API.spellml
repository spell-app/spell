<spell-notebook "theme-editor api">
	<header level="1">
		Theme Editor
		<header>A theme editor makes a theme from an existing one:  its colours, fonts and shapes, or any token, live on real pages, then copied as a theme file or kept in the browser.</>
	</>
	<theme-editor-tab-bar showing="api"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#tags">Tags</>
			<item link="#attributes">Attributes</>
			<item link="#properties">Properties</>
			<item link="#events">Events</>
			<item link="#parts">Parts</>
			<item link="#states">States</>
			<item link="#texts">Texts</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`site/_data/components.json5`);  nothing to write. -->
	<section label="Tags">
		<html>
			<ui-docs-api family="ui-theme-editor" only="tags"></>
		</>
	</>

	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-theme-editor" only="attributes"></>
		</>
	</>

	<section label="Properties">
		<html>
			<ui-docs-api family="ui-theme-editor" only="properties"></>
		</>
	</>

	<section label="Events">
		<html>
			<ui-docs-api family="ui-theme-editor" only="events"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-theme-editor" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-theme-editor" only="states"></>
		</>
	</>

	<section label="Texts">
		<html>
			<ui-docs-api family="ui-theme-editor" only="texts"></>
		</>
	</>
</spell-notebook>
