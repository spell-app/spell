<spell-notebook "theme-editor examples">
	<header level="1">
		Theme Editor
		<header>A theme editor makes a theme from an existing one:  its colours, fonts and shapes, or any token, live on real pages, then copied as a theme file or kept in the browser.</>
	</>
	<theme-editor-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
		</>
	</>

	<!--
		EXAMPLES:  ours, no Fomantic page.
		- ONE editor on the page:  it applies the theme it edits to the whole page while it's here.
	-->
	<section label="Types">
		<section label="Theme editor" sticky="stack" collapsible dividing>
			<example "Theme editor" description="It starts from the page's theme (Fruity where there's none), or the theme you kept with Use this theme.  Pick a colour, a font or a corner, or set any token:  this whole page follows, and the sample app shows it in light and dark.  Copy changes copies the theme file.">
				<theme-editor/>
			</example>
		</>
	</>
</spell-notebook>
