<spell-notebook "tab examples">
	<header level="1">
		Tab
		<header>A tab is a hidden section of content activated by a menu.</>
	</>
	<tab-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#states">States</>
			<item link="#variations">Variations</>
			<item link="#basic-examples">Basic Examples</>
			<item link="#remote-examples">Remote Examples</>
			<item link="#history-examples">History Examples</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's page, section by section, in its order (Types, Content, States, Variations,
		Groups ...).  Rules, the class-grammar mappings, gaps:  packages/docs/content/epics/spell-ui-pages/PAGES.md.
		- A section:  `<ui-header level="2" dividing id="types">Types</ui-header>`, then its examples.
		- An example:  `<ui-example heading="..." description="...">` around the live markup;  the markup
		  IS the code shown.  A richer description:  `<p slot="description">` (+ `<ui-message slot="description">`).
		- A gap:  an HTML comment `GAP I<n>:  ...` BEFORE the example (a comment inside it shows in its code).
	-->
	<section label="Types">
		<section label="Tab" sticky="stack" collapsible dividing>
			<example "Tab" description="A basic tab.">
				<message slot="description" state="info" size="small">Two tags:  each <text code>&lt;ui-tab&gt;</text> is a pane of content, and <text code>&lt;ui-tabs&gt;</text> draws the row of tabs from its panes' labels. A pane is hidden until it's the selected one;  see the Usage tab.</message>
				<tabs appearance="tabular" attach="top" aria-label="Tab demo">
					<tab label="Tab">
						<text paragraph>The pane:  whatever you put inside the <text code>&lt;ui-tab&gt;</text> shows here.</text>
					</tab>
				</tabs>
			</example>
		</>

		<section label="Pointing" sticky="stack" collapsible dividing>
			<example "Pointing" description="A `pointing secondary` tab menu underlines the selected tab.">
				<tabs appearance="pointing secondary" aria-label="Pointing demo">
					<tab label="First">First pane</tab>
					<tab label="Second">Second pane</tab>
					<tab label="Third">Third pane</tab>
				</tabs>
			</example>
		</>

		<section label="Basic menu" sticky="stack" collapsible dividing>
			<example "Basic menu" description="With no look words, the tabs are a plain menu above separate panes.">
				<tabs aria-label="Basic demo">
					<tab label="First">First pane</tab>
					<tab label="Second">Second pane</tab>
				</tabs>
			</example>
		</>

		<section label="Text" sticky="stack" collapsible dividing>
			<example "Text" description="Tabs can be plain text;  `basic` drops the panes' segment box.">
				<tabs appearance="text basic" aria-label="Text demo">
					<tab label="First">First pane</tab>
					<tab label="Second">Second pane</tab>
				</tabs>
			</example>
		</>

		<section label="Segmented" sticky="stack" collapsible dividing>
			<example "Segmented" description="The tabs can be a segmented control:  one rounded bar, the selected tab filled with colour.">
				<list slot="description" bulleted>
					<item><text code>appearance="segmented"</text> turns it on.</item>
					<item>The fill is the primary colour, or the tabs' <text code>color</text>.</item>
					<item><text code>appearance</text> takes every look the menu has;  the words in the examples above (<text code>pointing</text>, <text code>text</text> ...) are short forms of it.</item>
				</list>
				<tabs appearance="segmented" aria-label="Segmented demo">
					<tab label="Examples">Examples pane</tab>
					<tab label="Usage">Usage pane</tab>
					<tab label="API">API pane</tab>
				</tabs>
			</example>
		</>

		<section label="Flat markup" sticky="stack" collapsible dividing>
			<example "Flat markup" description="A pane can be written outside its tabs:  `parent` names the tabs' id, and the pane joins them, in page order, as if it were nested there.">
				<tabs id="demo-pet-types" appearance="tabular" attach="top" aria-label="Flat markup demo"/>
				<tab parent="demo-pet-types" label="Cats">Cats pane, written after the tabs.</tab>
				<tab parent="demo-pet-types" label="Dogs">Dogs pane, written after the tabs.</tab>
			</example>
		</>
	</>

	<section label="States">
		<section label="Active" sticky="stack" collapsible dividing>
			<example "Active" description="The active tab is the selected one:  its pane shows, and the others stay hidden.  Mark it `selected` (alias `active`).">
				<tabs appearance="tabular" attach="top" aria-label="Active demo">
					<tab label="First">
						<text paragraph>First pane:  hidden, since its tab isn't selected.</text>
					</tab>
					<tab label="Second" selected>
						<text paragraph>Second pane:  showing, because its tab is selected.</text>
					</tab>
					<tab label="Third">
						<text paragraph>Third pane:  hidden, until you pick its tab.</text>
					</tab>
				</tabs>
			</example>
		</>

		<section label="Loading" sticky="stack" collapsible dividing>
			<example "Loading" description="A tab can display a loading indicator.">
				<tabs appearance="tabular" attach="top" aria-label="Loading demo">
					<tab label="Tab" loading>
						<text paragraph>The pane:  hidden under the spinner while it loads.</text>
					</tab>
				</tabs>
			</example>
		</>

		<section label="Disabled" sticky="stack" collapsible dividing>
			<example "Disabled" description="A `disabled` pane's tab can't be chosen, and the arrow keys skip it.">
				<tabs appearance="tabular" attach="top" aria-label="Disabled demo">
					<tab label="First">First pane</tab>
					<tab label="Second" selected>Second pane</tab>
					<tab label="Third" disabled>Third pane</tab>
				</tabs>
			</example>
		</>
	</>

	<section label="Variations">
		<!--
			GAP I51:  no centered tab item (Fomantic's `center item`);  the Two tab sits in line.  `alignment="center"`
			                  centres the whole tab list, not one tab between its neighbours.
		-->
		<section label="Centered Item" sticky="stack" collapsible dividing>
			<example "Centered Item" description="A tab can have center aligned items.">
				<tabs appearance="tabular" attach="top" aria-label="Centered demo">
					<tab label="One">
						<text paragraph>First pane:  the One tab's content.</text>
					</tab>
					<tab label="Two">
						<text paragraph>Second pane:  the Two tab's content.</text>
					</tab>
					<tab label="Three">
						<text paragraph>Third pane:  the Three tab's content.</text>
					</tab>
				</tabs>
			</example>
		</>

		<section label="Inverted" sticky="stack" collapsible dividing>
			<example "Inverted" description="A tab can be shown inverted;  the panes follow.">
				<segment inverted>
					<tabs inverted appearance="tabular" attach="top" aria-label="Inverted demo">
						<tab label="Active Tab">
							<text paragraph>content one</text>
						</tab>
						<tab label="Tab 2">
							<text paragraph>content two</text>
						</tab>
						<tab label="Tab 3">
							<text paragraph>content three</text>
						</tab>
					</tabs>
				</segment>
			</example>
		</>

		<section label="Bottom attached menu" sticky collapsible dividing>
			<example "Bottom attached menu" description="You can display the tabbed menu at the bottom of the tab segments:  `attached=\"bottom\"`.">
				<segment inverted>
					<tabs inverted appearance="tabular" attach="bottom" aria-label="Bottom attached demo">
						<tab label="Active Tab">
							<text paragraph>content one</text>
						</tab>
						<tab label="Tab 2">
							<text paragraph>content two</text>
						</tab>
						<tab label="Tab 3" selected>
							<text paragraph>content three</text>
						</tab>
					</tabs>
				</segment>
			</example>
		</>

		<section label="Vertical" sticky="stack" collapsible dividing>
			<example "Vertical" description="Tabs can stack in a column beside the panes;  Arrow Up / Down move between them.">
				<tabs direction="vertical" appearance="tabular" aria-label="Vertical demo">
					<tab label="Bio">Biography</tab>
					<tab label="Pics">Pictures</tab>
					<tab label="Companies">Companies</tab>
				</tabs>
			</example>
		</>

		<section label="Fluid" sticky="stack" collapsible dividing>
			<example "Fluid" description="The tab menu can take the full width.">
				<tabs fluid appearance="pointing secondary" aria-label="Fluid demo">
					<tab label="First">First pane</tab>
					<tab label="Second">Second pane</tab>
				</tabs>
			</example>
		</>

		<section label="Alignment" sticky="stack" collapsible dividing>
			<example "Alignment" description="`alignment` places the tabs in their row.  A segmented tab list moves as a whole.">
				<list slot="description" bulleted>
					<item><text code>left</text>, <text code>center</text> or <text code>right</text>:  packed at that end</item>
					<item><text code>fluid</text>:  the tabs fill the row</item>
				</list>
				<tabs appearance="segmented" align="center" aria-label="Centered demo, segmented">
					<tab label="Day">Today's numbers</tab>
					<tab label="Week">This week's numbers</tab>
					<tab label="Month">This month's numbers</tab>
				</tabs>
			</example>
		</>

		<section label="Equal" sticky="stack" collapsible dividing>
			<example "Equal" description="`equal` makes every tab the same width, worked out from the tabs themselves:  no count of tabs to keep up to date.">
				<list slot="description" bulleted>
					<item>On its own:  each tab as wide as the widest one.</item>
					<item>With <text code>alignment="fluid"</text>:  each tab an equal share of the row.</item>
					<item>This site's own tabs (Examples, Usage ...) use both, as a segmented control: <text code>appearance="segmented" alignment="fluid" equal</text>.</item>
				</list>
				<tabs appearance="segmented" equal aria-label="Equal demo">
					<tab label="Bio">Biography</tab>
					<tab label="Photos and videos">Pictures</tab>
					<tab label="Friends">Friends</tab>
				</tabs>
				<tabs appearance="pointing secondary" align="fluid" equal aria-label="Equal fluid demo">
					<tab label="Bio">Biography</tab>
					<tab label="Photos and videos">Pictures</tab>
					<tab label="Friends">Friends</tab>
				</tabs>
			</example>
		</>

		<section label="Compact" sticky="stack" collapsible dividing>
			<example "Compact" description="The tab menu can be only as wide as its tabs.">
				<tabs padding="compact" aria-label="Compact demo">
					<tab label="Day">Today's numbers</tab>
					<tab label="Week">This week's numbers</tab>
					<tab label="Month">This month's numbers</tab>
				</tabs>
			</example>
		</>

		<section label="Colored and sized" sticky collapsible dividing>
			<example "Colored and sized" description="Tabs take a `color` (the selected tab's hue) and a `size`.">
				<tabs size="small" color="red" appearance="pointing secondary" aria-label="Colored demo">
					<tab label="First">First pane</tab>
					<tab label="Second">Second pane</tab>
				</tabs>
			</example>
		</>

		<section label="Icons" sticky="stack" collapsible dividing>
			<example "Icons" description="A pane's `icon` shows on its tab, before the label.">
				<tabs appearance="pointing secondary" aria-label="Icon demo">
					<tab label="Mail" icon="envelope">Inbox</tab>
					<tab label="Settings" icon="gear">Preferences</tab>
				</tabs>
			</example>
		</>
	</>

	<section label="Basic Examples">
		<section label="Basic Tabs" sticky="stack" collapsible dividing>
			<example "Basic Tabs" description="Each `<ui-tab>` inside a `<ui-tabs>` is a pane, and its label becomes a tab. No script, and no `data-tab` paths to pair up.">
				<message slot="description" state="info" size="small">To have a tab visible on page load, give its pane <text code>selected</text> (or set the tabs' <text code>value</text>); otherwise the first enabled pane shows.</message>
				<tabs appearance="tabular" attach="top" aria-label="Basic tabs demo">
					<tab label="First">First</tab>
					<tab label="Second">Second</tab>
					<tab label="Third">Third</tab>
				</tabs>
			</example>
		</>

		<section label="Multiple Tab Groups" sticky collapsible dividing>
			<example "Multiple Tab Groups" description="Every `<ui-tabs>` is its own independent tab group, even nested inside another one's pane.">
				<message slot="description" size="small" class="site-not-ported">Not ported:  settings to limit a tab group to one part of the page (<text code>context</text>, <text code>childrenOnly</text>) -- a tab set only ever owns its own <text code>&lt;ui-tab&gt;</text> children, so groups never mix.</message>
				<tabs appearance="secondary" aria-label="Group one">
					<tab label="First">
						<tabs appearance="tabular" attach="top" aria-label="First, inner">
							<tab label="1A">1A</tab>
							<tab label="1B">1B</tab>
							<tab label="1C">1C</tab>
						</tabs>
					</tab>
					<tab label="Second" selected>
						<tabs appearance="tabular" attach="top" aria-label="Second, inner">
							<tab label="2A">2A</tab>
							<tab label="2B">2B</tab>
							<tab label="2C" selected>2C</tab>
						</tabs>
					</tab>
					<tab label="Third">
						<tabs appearance="tabular" attach="top" aria-label="Third, inner">
							<tab label="3A">3A</tab>
							<tab label="3B">3B</tab>
							<tab label="3C">3C</tab>
						</tabs>
					</tab>
				</tabs>
				<divider/>
				<tabs appearance="secondary" aria-label="Group two">
					<tab label="Fourth">4</tab>
					<tab label="Fifth" selected>5</tab>
					<tab label="Sixth">6</tab>
				</tabs>
			</example>
		</>

		<section label="Default Paths" sticky="stack" collapsible dividing>
			<example "Default Paths" description="Opening a pane shows its nested tab set's default pane too:  the first `selected` one, else the first enabled one, for as many levels as you nest.">
				<tabs appearance="pointing secondary" aria-label="Default paths demo">
					<tab label="First">
						<tabs appearance="tabular" attach="top" aria-label="First, inner">
							<tab label="1A">1A</tab>
							<tab label="1B">1B</tab>
							<tab label="1C">1C</tab>
						</tabs>
					</tab>
					<tab label="Second">
						<tabs appearance="tabular" attach="top" aria-label="Second, inner">
							<tab label="2A">2A</tab>
							<tab label="2B">2B</tab>
							<tab label="2C">2C</tab>
						</tabs>
					</tab>
					<tab label="Third">
						<tabs appearance="tabular" attach="top" aria-label="Third, inner">
							<tab label="3A">3A</tab>
							<tab label="3B">3B</tab>
							<tab label="3C">3C</tab>
						</tabs>
					</tab>
				</tabs>
			</example>
		</>
	</>

	<section label="Remote Examples">
		<section label="Retrieving Remote Content" sticky collapsible dividing>
			<example "Retrieving Remote Content" description="A `lazy` pane stamps its `<template>` into itself the first time it's shown, so hidden panes cost nothing up front. To fetch content instead, listen for `ui-opened` and fill the pane when `event.detail.first` is true (see Usage).">
				<message slot="description" size="small" class="site-not-ported">Not ported:  settings that fetch a pane's content from a URL and cache it (<text code>auto</text>, <text code>apiSettings</text>, <text code>cache</text>) -- a fetch is a few lines in a <text code>ui-opened</text> listener, and the pane's <text code>loading</text> shows the spinner meanwhile.</message>
				<html>
					<ui-tabs appearance="pointing secondary" aria-label="Lazy demo">
						<ui-tab label="First">
							<ui-header level="3">Tab One</ui-header>
							<ui-text paragraph>In the page from the start:  this pane isn't <ui-text code>lazy</ui-text>.</ui-text>
						</ui-tab>
						<ui-tab label="Second" lazy>
							<template>
								<ui-header level="3">Tab Two</ui-header>
								<p>Stamped the first time this pane was shown.</p>
							</template>
						</ui-tab>
						<ui-tab label="Third" lazy>
							<template>
								<ui-header level="3">Tab Three</ui-header>
								<p>Stamped the first time this pane was shown.</p>
							</template>
						</ui-tab>
					</ui-tabs>
				</html>
			</example>
		</>
		<message size="small" class="site-not-ported">Not ported:  running the scripts in a pane's fetched HTML (<text code>evaluateScripts</>) -- panes load no remote HTML, so there are no scripts to run.</>
	</>

	<section label="History Examples">
		<header level="4" id="using-hash-history">Using Hash History</>
		<markdown>
			`history` mirrors the selected pane in the URL hash (`#photos`): picking a tab pushes a history
			entry, Back and Forward switch panes, a link to `#photos` selects that pane, and a page opened on
			`#photos` starts there. Shown as code only: a live one would fight this page's own tabs for the
			hash, which use `history` too (switch between Examples and Usage above, then press Back).
		</>
		<markdown>
			```html
			<ui-tabs appearance="pointing secondary" history aria-label="Profile">
			  <ui-tab label="Bio" value="bio">...</ui-tab>
			  <ui-tab label="Photos" value="photos" icon="image">...</ui-tab>
			</ui-tabs>
			```
		</>
		<message size="small" class="site-not-ported">Not ported:  a real URL path per tab, instead of the hash (<text code>historyType: 'state'</>, <text code>path</>) -- it needs a server route for every tab, so <text code>history</> uses the hash only.</>
	</>
</spell-notebook>
