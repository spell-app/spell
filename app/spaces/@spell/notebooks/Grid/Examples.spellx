	<section label="Responsive Variations">
		<section label="Doubling" sticky="stack" collapsible dividing>
			<example "Doubling" description="A grid can double its column width on tablet and mobile sizes">
				<message slot="description" state="info" size="small">A grid will round its columns to the closest reasonable value when doubling, for example a <text code>columns="5"</text> grid will use <text code>2 mobile, 3 tablet, 5 desktop</text>. To force 1 column on mobile you can add <link link="#examples-responsive-grids-stackable"><text code>stackable</text></link></message>
				<grid columns="5" doubling>
					<column>
						<image src="/components/ui/images/wireframe/image.png" alt=""/>
