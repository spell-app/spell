<spell-notebook "grid examples">
	<header level="1">
		Grid
		<header>A grid is used to harmonize negative space in a layout.</>
	</>
	<grid-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#introduction">Introduction</>
			<item link="#columns">Columns</>
			<item link="#rows">Rows</>
			<item link="#varying-grids">Varying Grids</>
			<item link="#responsive-grids">Responsive Grids</>
			<item link="#types">Types</>
			<item link="#content">Content</>
			<item link="#variations">Variations</>
			<item link="#responsive-variations">Responsive Variations</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's grid page, both of its tabs in order:  Overview (Introduction ... Responsive Grids) and
		Definition (Types ... Responsive Variations).  GAP I123:  Fomantic's docs outline empty columns (and pad coloured
		ones) with their own CSS;  here an empty column holds a `<ui-segment>` so its width shows.
	-->
	<section label="Introduction">
		<section label="Grids" sticky="stack" collapsible dividing>
			<example description="Using a grid makes content appear to flow more naturally on your page.">
				<html>
					<p slot="description">A grid is a structure with a <a href="https://99designs.com/designer-blog/2013/03/21/history-of-the-grid-part-1/" target="_blank">long history</a> used to align negative space in designs.</p>
				</html>
				<grid>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
				</grid>
			</example>
		</>

		<section label="Columns" sticky="stack" collapsible dividing>
			<example description="Grids divide horizontal space into indivisible units called \"columns\". All columns in a grid must specify their width as proportion of the total available row width.  The example below shows four `width=\"4\"` columns will fit in the first row, `16 / 4 = 4`, and three various sized columns in the second row. `2 + 8 + 6 = 16`">
				<html>
					<p slot="description">All grid systems choose an arbitrary column count to allow per row. Spell UI, like Fomantic, uses <b>16 columns</b>.</p>
					<p slot="description">Gutters and other spacing can be changed with the grid's <a href="/components/ui/theming.html">theming tokens</a> (the Theming tab).</p>
				</html>
				<grid>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="2">
						<segment/>
					</column>
					<column width="8">
						<segment/>
					</column>
					<column width="6">
						<segment/>
					</column>
				</grid>
			</example>
		</>

		<section label="Rows" sticky="stack" collapsible dividing>
			<example description="Rows are groups of columns which are aligned horizontally.  After each group of columns vertical spacing is added to separate each group of columns, creating vertical rhythm.">
				<html>
					<p slot="description">Rows can either be <em>explicit</em>, marked with an additional <code>row</code> element, or <em>implicit</em>, automatically occurring when no more space is left in a previous row.</p>
				</html>
				<grid columns="4">
					<row>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
					</row>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
				</grid>
			</example>
		</>

		<section label="Gutters" sticky="stack" collapsible dividing>
			<example>
				<html>
					<p slot="description">Grid columns are separated by areas of white space referred to as "gutters". Gutters improve legibility by providing, <a href="https://en.wikipedia.org/wiki/Negative_space" target="_blank">negative space</a> between page elements.</p>
					<p slot="description">Gutters remain a constant size regardless of the width of the grid, or how many columns are in a row. To increase the size of gutters in a particular grid, you can use a <a href="#examples-variations-relaxed"><code>relaxed</code></a> variation.</p>
				</html>
				<grid>
					<row columns="3">
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
					</row>
					<row columns="8">
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
					</row>
				</grid>
				<grid spacing="lg">
					<row columns="3">
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
					</row>
					<row columns="8">
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
					</row>
				</grid>
			</example>
		</>

		<section label="Negative Margins" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">Since all grid columns include gutters, grids use <a href="https://csswizardry.com/2011/08/building-better-grid-systems/">negative margins</a> to make sure that the first and last columns sit flush with content outside the grid.</p>
					<p slot="description">In the following example, you can see even though the top row has padding, the <a href="/components/ui/ui-button.html"><code>attached</code> button</a> still sits flush with the edge of the grid.</p>
					<p slot="description">In some cases, like when a column or row is <a href="#examples-varying-grids-colored"><code>colored</code></a>, you may want to avoid using negative margins. You can do this by using a <a href="#examples-variations-padded"><code>padded</code></a> variation.</p>
				</html>
				<button attach="top">Button before grid</button>
				<grid>
					<column width="16">
						<segment/>
					</column>
					<column width="10">
						<segment/>
					</column>
					<column width="6">
						<segment/>
					</column>
				</grid>
				<grid>
					<column width="16">
						<segment/>
					</column>
				</grid>
				<button attach="bottom">Button after grid</button>
			</example>
		</>
		<message size="small" class="site-not-ported"><html>Not ported: Fomantic's deprecated page grids (<code>ui page grid</>) -- put the grid in a <code>&lt;ui-container grid&gt;</> instead (Containers, below).</></>
	</>

	<section label="Columns">
		<section label="Automatic Flow" sticky="stack" collapsible dividing>
			<example description="Most grids do not need to specify rows. Content will automatically flow to the next row when all the grid columns are taken in the current row.">
				<grid>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
				</grid>
			</example>
		</>

		<section label="Column Content" sticky="stack" collapsible dividing>
			<example description="Since columns use padding to create gutters, content stylings should not be applied directly to columns, but to elements inside of columns.">
				<grid columns="3">
					<column>
						<segment>
							<image src="/components/ui/images/wireframe/image.png" alt=""/>
						</segment>
					</column>
					<column>
						<segment>
							<image src="/components/ui/images/wireframe/image.png" alt=""/>
						</segment>
					</column>
					<column>
						<segment>
							<image src="/components/ui/images/wireframe/image.png" alt=""/>
						</segment>
					</column>
				</grid>
			</example>
		</>

		<section label="Column Widths" sticky="stack" collapsible dividing>
			<example>
				<html>
					<p slot="description">Column widths can be specified using <a href="#examples-variations-column-width"><code>width</code></a>. If a column cannot fit in a row it will automatically flow to the next row</p>
				</html>
				<grid>
					<column width="8">
						<segment/>
					</column>
					<column width="8">
						<segment/>
					</column>
					<column width="10">
						<segment/>
					</column>
					<column width="6">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="12">
						<segment/>
					</column>
					<column width="2">
						<segment/>
					</column>
					<column width="14">
						<segment/>
					</column>
					<column width="16">
						<segment/>
					</column>
				</grid>
			</example>
		</>

		<section label="Left / Right Attached Column" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">A column can be attached to the left or right without any padding. This is especially useful when working with a <a href="/components/ui/ui-menu.html"><code>vertical tabular</code> menu</a></p>
				</html>
				<grid columns="2">
					<column attach="left">
						<segment/>
					</column>
					<column attach="right">
						<segment/>
					</column>
				</grid>
			</example>
		</>
	</>

	<section label="Rows">
		<section label="Grouping" sticky="stack" collapsible dividing>
			<example description="Row wrappers allow you to apply variations to a group of columns.">
				<grid columns="4">
					<row columns="2">
						<column>
							<segment/>
						</column>
					</row>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
				</grid>
			</example>
		</>

		<section label="Clearing Content" sticky="stack" collapsible dividing>
			<example>
				<html>
					<p slot="description">Row wrappers will automatically clear previous columns:  the next row starts on a line of its own, even when this one isn't full.  Here empty columns push the second one to the right (<a href="#examples-variations-left-and-right">Left and Right</a>).</p>
				</html>
				<grid>
					<row columns="4">
						<column>
							<segment/>
						</column>
						<column/>
						<column/>
						<column>
							<segment/>
						</column>
					</row>
					<row>
						<column width="3">
							<segment/>
						</column>
						<column width="8">
							<segment/>
						</column>
						<column width="5">
							<segment/>
						</column>
					</row>
				</grid>
			</example>
		</>

		<section label="Special Grids" sticky="stack" collapsible dividing>
			<example>
				<html>
					<p slot="description">Additionally, some types of grids, like <a href="#examples-types-divided"><code>divided</code></a> or <a href="#examples-types-celled"><code>celled</code></a> require row wrappers to apply formatting correctly.</p>
				</html>
				<grid celled="internally">
					<row>
						<column width="3">
							<image src="/components/ui/images/wireframe/image.png" alt=""/>
						</column>
						<column width="10">
							<image src="/components/ui/images/wireframe/centered-paragraph.png" alt=""/>
						</column>
						<column width="3">
							<image src="/components/ui/images/wireframe/image.png" alt=""/>
						</column>
					</row>
					<row>
						<column width="3">
							<image src="/components/ui/images/wireframe/image.png" alt=""/>
						</column>
						<column width="10">
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						</column>
						<column width="3">
							<image src="/components/ui/images/wireframe/image.png" alt=""/>
						</column>
					</row>
				</grid>
			</example>
		</>
	</>

	<section label="Varying Grids">
		<section label="Nesting Grids" sticky="stack" collapsible dividing>
			<example description="Grids can be placed inside of other grids, letting you sub-divide columns.">
				<grid columns="2">
					<column>
						<grid columns="3">
							<column>
								<segment/>
							</column>
							<column>
								<segment/>
							</column>
							<column>
								<segment/>
							</column>
						</grid>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<grid>
							<column width="10">
								<segment/>
							</column>
							<column width="6">
								<segment/>
							</column>
						</grid>
					</column>
				</grid>
			</example>
		</>

		<section label="Colored" sticky="stack" collapsible dividing id="varying-grids-colored">
			<example description="To include a color that is not available in the default palette, set `--ui-color` on the row or column in your CSS.">
				<html>
					<p slot="description">Grids can use named <a href="#colored-2"><code>color</code></a> to add background colors, but only with <a href="#examples-variations-padded"><code>padded</code></a> that do not include negative margins.</p>
				</html>
				<grid equal-width align="center" padding="md">
					<row>
						<column color="olive">Olive</column>
						<column color="black">Black</column>
					</row>
					<row>
						<column color="black">Black</column>
						<column color="olive">Olive</column>
					</row>
				</grid>
			</example>
		</>

		<section label="Automatic Column Count" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">The <a href="#examples-variations-equal-width"><code>equal-width</code></a> variation will automatically divide column width evenly. This is useful with dynamic content where you do not know the column count in advance.</p>
				</html>
				<grid equal-width>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<row equal-width>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
					</row>
				</grid>
			</example>
		</>

		<section label="Centering Content" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">If a row does not take up all sixteen grid columns, you can use a <a href="#examples-variations-centered"><code>centered</code></a> variation to center the column contents inside the grid.</p>
				</html>
				<grid columns="2" centered>
					<column>
						<segment/>
					</column>
					<row columns="4" centered>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
					</row>
				</grid>
			</example>
		</>

		<section label="Significant Word Order" sticky collapsible dividing>
			<example description="Grids include many variations for adjusting things like vertical or horizontal alignment, text alignment, or default gutter sizes.">
				<html>
					<p slot="description">Some multi-word variations, like <a href="#examples-variations-vertical-alignment"><code>vertical-align="middle"</code></a> or <a href="#examples-variations-text-alignment"><code>align="right"</code></a> are word-order dependent and require you to use adjacent class names.</p>
				</html>
				<grid>
					<column width="6" align="right">
						<segment>Right aligned column</segment>
					</column>
					<column width="4"/>
					<column width="6" align="left">
						<segment>Left aligned column</segment>
					</column>
					<row columns="2" align="center">
						<column>
							<segment>Center aligned row</segment>
						</column>
						<column>
							<segment>Center aligned row</segment>
						</column>
					</row>
					<column width="16" align="right">
						<segment>Right Aligned Column</segment>
					</column>
				</grid>
			</example>
		</>
	</>

	<section label="Responsive Grids">
		<section label="Containers" sticky="stack" collapsible dividing>
			<example>
				<html>
					<p slot="description">A <a href="/components/ui/ui-container.html">container</a> can be used alongside a grid to provide a responsive, fixed width container for wrapping the contents of a page.</p>
				</html>
				<container grid>
					<grid>
						<column width="4">
							<segment/>
						</column>
						<column width="4">
							<segment/>
						</column>
						<column width="4">
							<segment/>
						</column>
						<column width="4">
							<segment/>
						</column>
						<column width="4">
							<segment/>
						</column>
						<column width="4">
							<segment/>
						</column>
						<column width="4">
							<segment/>
						</column>
						<column width="4">
							<segment/>
						</column>
					</grid>
				</container>
			</example>
		</>

		<section label="Stackable" sticky="stack" collapsible dividing id="responsive-grids-stackable">
			<example>
				<html>
					<p slot="description">A <a href="#examples-responsive-grids-stackable"><code>stackable</code></a> will automatically stack rows to a single columns on mobile devices</p>
				</html>
				<grid columns="4" stackable>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
				</grid>
			</example>
		</>

		<section label="Reverse Order" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">Grids include special <a href="#examples-responsive-variations-reversed"><code>reversed</code></a> variations that allow you to reverse the order of columns or rows by device</p>
				</html>
				<grid equal-width reversed="mobile">
					<column>First</column>
					<column>Second</column>
					<column>Third</column>
				</grid>
			</example>
		</>

		<section label="Doubling" sticky="stack" collapsible dividing id="responsive-grids-doubling">
			<example>
				<html>
					<p slot="description">A <a href="#examples-responsive-grids-doubling"><code>doubling</code></a> grid will double column widths for each device jump.</p>
				</html>
				<grid>
					<row columns="8" doubling>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
					</row>
					<row columns="6" doubling>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
					</row>
					<row columns="4" doubling>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
					</row>
				</grid>
			</example>
		</>

		<section label="Manual Tweaks" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">Although design patterns like <a href="#examples-responsive-grids-doubling"><code>doubling</code></a> or <a href="#examples-responsive-grids-stackable"><code>stackable</code></a> are useful at simplifying responsive styling, you can also manually tweak device presentation by specifying <a href="#examples-responsive-variations-responsive-width"><code>width-tablet</code> ...</a> or <a href="#examples-responsive-variations-device-visibility"><code>only</code></a> columns or rows.</p>
				</html>
				<grid centered>
					<row only="computer">
						<column>
							<segment/>
						</column>
					</row>
					<column width-tablet="6" width-computer="8">
						<segment/>
					</column>
					<column width-tablet="6" width-computer="8">
						<segment/>
					</column>
					<column width-tablet="6" width-computer="8">
						<segment/>
					</column>
					<column width-tablet="6" width-computer="8">
						<segment/>
					</column>
					<column width-tablet="6" width-computer="8">
						<segment/>
					</column>
				</grid>
			</example>
		</>
	</>

	<section label="Types">
		<section label="Grid" sticky="stack" collapsible dividing>
			<example description="A basic grid.">
				<grid>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
				</grid>
			</example>
		</>

		<section label="Divided" sticky="stack" collapsible dividing id="types-divided">
			<example description="A grid can have dividers between its columns.">
				<grid columns="3" divided>
					<row>
						<column>
