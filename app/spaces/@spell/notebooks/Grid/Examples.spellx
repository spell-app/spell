<spell-notebook "grid examples">
	<header level="1">
		Grid
		<header>A grid is used to harmonize negative space in a layout.</>
	</>
	<grid-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#introduction">Introduction</>
			<item link="#columns">Columns</>
			<item link="#rows">Rows</>
			<item link="#varying-grids">Varying Grids</>
			<item link="#responsive-grids">Responsive Grids</>
			<item link="#types">Types</>
			<item link="#content">Content</>
			<item link="#variations">Variations</>
			<item link="#responsive-variations">Responsive Variations</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's grid page, both of its tabs in order:  Overview (Introduction ... Responsive Grids) and
		Definition (Types ... Responsive Variations).  GAP I123:  Fomantic's docs outline empty columns (and pad coloured
		ones) with their own CSS;  here an empty column holds a `<ui-segment>` so its width shows.
	-->
	<section label="Introduction">
		<section label="Grids" sticky="stack" collapsible dividing>
			<example "Grids" description="Using a grid makes content appear to flow more naturally on your page.">
				<text slot="description" paragraph>A grid is a structure with a <link target="_blank" link="https://99designs.com/designer-blog/2013/03/21/history-of-the-grid-part-1/">long history</link> used to align negative space in designs.</text>
				<grid>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
				</grid>
			</example>
		</>

		<section label="Columns" sticky="stack" collapsible dividing>
			<example "Columns" description="Grids divide horizontal space into indivisible units called \"columns\". All columns in a grid must specify their width as proportion of the total available row width.  The example below shows four `width=\"4\"` columns will fit in the first row, `16 / 4 = 4`, and three various sized columns in the second row. `2 + 8 + 6 = 16`  Gutters and other spacing can be changed with the grid's \[theming tokens](/components/ui/theming.html) (the Theming tab).">
				<text slot="description" paragraph>All grid systems choose an arbitrary column count to allow per row. Spell UI, like Fomantic, uses <text bold>16 columns</text>.</text>
				<grid>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="2">
						<segment/>
					</column>
					<column width="8">
						<segment/>
					</column>
					<column width="6">
						<segment/>
					</column>
				</grid>
			</example>
		</>

		<section label="Rows" sticky="stack" collapsible dividing>
			<example "Rows" description="Rows are groups of columns which are aligned horizontally.  After each group of columns vertical spacing is added to separate each group of columns, creating vertical rhythm.">
				<text slot="description" paragraph>Rows can either be <text italic>explicit</text>, marked with an additional <text code>row</text> element, or <text italic>implicit</text>, automatically occurring when no more space is left in a previous row.</text>
				<grid columns="4">
					<row>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
					</row>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
				</grid>
			</example>
		</>

		<section label="Gutters" sticky="stack" collapsible dividing>
			<example "Gutters">
				<text slot="description" paragraph>Grid columns are separated by areas of white space referred to as "gutters". Gutters improve legibility by providing, <link target="_blank" link="https://en.wikipedia.org/wiki/Negative_space">negative space</link> between page elements.</text>
				<text slot="description" paragraph>Gutters remain a constant size regardless of the width of the grid, or how many columns are in a row. To increase the size of gutters in a particular grid, you can use a <link link="#examples-variations-relaxed"><text code>relaxed</text></link> variation.</text>
				<grid>
					<row columns="3">
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
					</row>
					<row columns="8">
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
					</row>
				</grid>
				<grid spacing="lg">
					<row columns="3">
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
					</row>
					<row columns="8">
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
					</row>
				</grid>
			</example>
		</>

		<section label="Negative Margins" sticky collapsible dividing>
			<example "Negative Margins" description="Since all grid columns include gutters, grids use \[negative margins](https://csswizardry.com/2011/08/building-better-grid-systems/) to make sure that the first and last columns sit flush with content outside the grid.">
				<text slot="description" paragraph>In the following example, you can see even though the top row has padding, the <link link="/components/ui/ui-button.html"><text code>attached</text> button</link> still sits flush with the edge of the grid.</text>
				<text slot="description" paragraph>In some cases, like when a column or row is <link link="#examples-varying-grids-colored"><text code>colored</text></link>, you may want to avoid using negative margins. You can do this by using a <link link="#examples-variations-padded"><text code>padded</text></link> variation.</text>
				<button attach="top">Button before grid</button>
				<grid>
					<column width="16">
						<segment/>
					</column>
					<column width="10">
						<segment/>
					</column>
					<column width="6">
						<segment/>
					</column>
				</grid>
				<grid>
					<column width="16">
						<segment/>
					</column>
				</grid>
				<button attach="bottom">Button after grid</button>
			</example>
		</>
		<message size="small" class="site-not-ported">Not ported: Fomantic's deprecated page grids (<text code>ui page grid</>) -- put the grid in a <text code>&lt;ui-container grid&gt;</> instead (Containers, below).</>
	</>

	<section label="Columns">
		<section label="Automatic Flow" sticky="stack" collapsible dividing>
			<example "Automatic Flow" description="Most grids do not need to specify rows. Content will automatically flow to the next row when all the grid columns are taken in the current row.">
				<grid>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
				</grid>
			</example>
		</>

		<section label="Column Content" sticky="stack" collapsible dividing>
			<example "Column Content" description="Since columns use padding to create gutters, content stylings should not be applied directly to columns, but to elements inside of columns.">
				<grid columns="3">
					<column>
						<segment>
							<image src="/components/ui/images/wireframe/image.png" alt=""/>
						</segment>
					</column>
					<column>
						<segment>
							<image src="/components/ui/images/wireframe/image.png" alt=""/>
						</segment>
					</column>
					<column>
						<segment>
							<image src="/components/ui/images/wireframe/image.png" alt=""/>
						</segment>
					</column>
				</grid>
			</example>
		</>

		<section label="Column Widths" sticky="stack" collapsible dividing>
			<example "Column Widths">
				<text slot="description" paragraph>Column widths can be specified using <link link="#examples-variations-column-width"><text code>width</text></link>. If a column cannot fit in a row it will automatically flow to the next row</text>
				<grid>
					<column width="8">
						<segment/>
					</column>
					<column width="8">
						<segment/>
					</column>
					<column width="10">
						<segment/>
					</column>
					<column width="6">
						<segment/>
					</column>
					<column width="4">
						<segment/>
					</column>
					<column width="12">
						<segment/>
					</column>
					<column width="2">
						<segment/>
					</column>
					<column width="14">
						<segment/>
					</column>
					<column width="16">
						<segment/>
					</column>
				</grid>
			</example>
		</>

		<section label="Left / Right Attached Column" sticky collapsible dividing>
			<example "Left / Right Attached Column">
				<text slot="description" paragraph>A column can be attached to the left or right without any padding. This is especially useful when working with a <link link="/components/ui/ui-menu.html"><text code>vertical tabular</text> menu</link></text>
				<grid columns="2">
					<column attach="left">
						<segment/>
					</column>
					<column attach="right">
						<segment/>
					</column>
				</grid>
			</example>
		</>
	</>

	<section label="Rows">
		<section label="Grouping" sticky="stack" collapsible dividing>
			<example "Grouping" description="Row wrappers allow you to apply variations to a group of columns.">
				<grid columns="4">
					<row columns="2">
						<column>
							<segment/>
						</column>
					</row>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
				</grid>
			</example>
		</>

		<section label="Clearing Content" sticky="stack" collapsible dividing>
			<example "Clearing Content" description="Row wrappers will automatically clear previous columns:  the next row starts on a line of its own, even when this one isn't full.  Here empty columns push the second one to the right (\[Left and Right](#variations-left-and-right)).">
				<grid>
					<row columns="4">
						<column>
							<segment/>
						</column>
						<column/>
						<column/>
						<column>
							<segment/>
						</column>
					</row>
					<row>
						<column width="3">
							<segment/>
						</column>
						<column width="8">
							<segment/>
						</column>
						<column width="5">
							<segment/>
						</column>
					</row>
				</grid>
			</example>
		</>

		<section label="Special Grids" sticky="stack" collapsible dividing>
			<example "Special Grids">
				<text slot="description" paragraph>Additionally, some types of grids, like <link link="#examples-types-divided"><text code>divided</text></link> or <link link="#examples-types-celled"><text code>celled</text></link> require row wrappers to apply formatting correctly.</text>
				<grid celled="internally">
					<row>
						<column width="3">
							<image src="/components/ui/images/wireframe/image.png" alt=""/>
						</column>
						<column width="10">
							<image src="/components/ui/images/wireframe/centered-paragraph.png" alt=""/>
						</column>
						<column width="3">
							<image src="/components/ui/images/wireframe/image.png" alt=""/>
						</column>
					</row>
					<row>
						<column width="3">
							<image src="/components/ui/images/wireframe/image.png" alt=""/>
						</column>
						<column width="10">
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						</column>
						<column width="3">
							<image src="/components/ui/images/wireframe/image.png" alt=""/>
						</column>
					</row>
				</grid>
			</example>
		</>
	</>

	<section label="Varying Grids">
		<section label="Nesting Grids" sticky="stack" collapsible dividing>
			<example "Nesting Grids" description="Grids can be placed inside of other grids, letting you sub-divide columns.">
				<grid columns="2">
					<column>
						<grid columns="3">
							<column>
								<segment/>
							</column>
							<column>
								<segment/>
							</column>
							<column>
								<segment/>
							</column>
						</grid>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<grid>
							<column width="10">
								<segment/>
							</column>
							<column width="6">
								<segment/>
							</column>
						</grid>
					</column>
				</grid>
			</example>
		</>

		<section label="Colored" sticky="stack" collapsible dividing id="varying-grids-colored">
			<example "Colored" description="To include a color that is not available in the default palette, set `--ui-color` on the row or column in your CSS.">
				<text slot="description" paragraph>Grids can use named <link link="#colored-2"><text code>color</text></link> to add background colors, but only with <link link="#examples-variations-padded"><text code>padded</text></link> that do not include negative margins.</text>
				<grid equal-width align="center" padding="md">
					<row>
						<column color="olive">Olive</column>
						<column color="black">Black</column>
					</row>
					<row>
						<column color="black">Black</column>
						<column color="olive">Olive</column>
					</row>
				</grid>
			</example>
		</>

		<section label="Automatic Column Count" sticky collapsible dividing>
			<example "Automatic Column Count">
				<text slot="description" paragraph>The <link link="#examples-variations-equal-width"><text code>equal-width</text></link> variation will automatically divide column width evenly. This is useful with dynamic content where you do not know the column count in advance.</text>
				<grid equal-width>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<row equal-width>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
					</row>
				</grid>
			</example>
		</>

		<section label="Centering Content" sticky collapsible dividing>
			<example "Centering Content">
				<text slot="description" paragraph>If a row does not take up all sixteen grid columns, you can use a <link link="#examples-variations-centered"><text code>centered</text></link> variation to center the column contents inside the grid.</text>
				<grid columns="2" centered>
					<column>
						<segment/>
					</column>
					<row columns="4" centered>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
					</row>
				</grid>
			</example>
		</>

		<section label="Significant Word Order" sticky collapsible dividing>
			<example "Significant Word Order" description="Grids include many variations for adjusting things like vertical or horizontal alignment, text alignment, or default gutter sizes.">
				<text slot="description" paragraph>Some multi-word variations, like <link link="#examples-variations-vertical-alignment"><text code>vertical-align="middle"</text></link> or <link link="#examples-variations-text-alignment"><text code>align="right"</text></link> are word-order dependent and require you to use adjacent class names.</text>
				<grid>
					<column width="6" align="right">
						<segment>Right aligned column</segment>
					</column>
					<column width="4"/>
					<column width="6" align="left">
						<segment>Left aligned column</segment>
					</column>
					<row columns="2" align="center">
						<column>
							<segment>Center aligned row</segment>
						</column>
						<column>
							<segment>Center aligned row</segment>
						</column>
					</row>
					<column width="16" align="right">
						<segment>Right Aligned Column</segment>
					</column>
				</grid>
			</example>
		</>
	</>

	<section label="Responsive Grids">
		<section label="Containers" sticky="stack" collapsible dividing>
			<example "Containers" description="A \[container](/components/ui/ui-container.html) can be used alongside a grid to provide a responsive, fixed width container for wrapping the contents of a page.">
				<container grid>
					<grid>
						<column width="4">
							<segment/>
						</column>
						<column width="4">
							<segment/>
						</column>
						<column width="4">
							<segment/>
						</column>
						<column width="4">
							<segment/>
						</column>
						<column width="4">
							<segment/>
						</column>
						<column width="4">
							<segment/>
						</column>
						<column width="4">
							<segment/>
						</column>
						<column width="4">
							<segment/>
						</column>
					</grid>
				</container>
			</example>
		</>

		<section label="Stackable" sticky="stack" collapsible dividing id="responsive-grids-stackable">
			<example "Stackable">
				<text slot="description" paragraph>A <link link="#examples-responsive-grids-stackable"><text code>stackable</text></link> will automatically stack rows to a single columns on mobile devices</text>
				<grid columns="4" stackable>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
				</grid>
			</example>
		</>

		<section label="Reverse Order" sticky collapsible dividing>
			<example "Reverse Order">
				<text slot="description" paragraph>Grids include special <link link="#examples-responsive-variations-reversed"><text code>reversed</text></link> variations that allow you to reverse the order of columns or rows by device</text>
				<grid equal-width reversed="mobile">
					<column>First</column>
					<column>Second</column>
					<column>Third</column>
				</grid>
			</example>
		</>

		<section label="Doubling" sticky="stack" collapsible dividing id="responsive-grids-doubling">
			<example "Doubling">
				<text slot="description" paragraph>A <link link="#examples-responsive-grids-doubling"><text code>doubling</text></link> grid will double column widths for each device jump.</text>
				<grid>
					<row columns="8" doubling>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
					</row>
					<row columns="6" doubling>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
					</row>
					<row columns="4" doubling>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
						<column>
							<segment/>
						</column>
					</row>
				</grid>
			</example>
		</>

		<section label="Manual Tweaks" sticky collapsible dividing>
			<example "Manual Tweaks">
				<text slot="description" paragraph>Although design patterns like <link link="#examples-responsive-grids-doubling"><text code>doubling</text></link> or <link link="#examples-responsive-grids-stackable"><text code>stackable</text></link> are useful at simplifying responsive styling, you can also manually tweak device presentation by specifying <link link="#examples-responsive-variations-responsive-width"><text code>width-tablet</text> ...</link> or <link link="#examples-responsive-variations-device-visibility"><text code>only</text></link> columns or rows.</text>
				<grid centered>
					<row only="computer">
						<column>
							<segment/>
						</column>
					</row>
					<column width-tablet="6" width-computer="8">
						<segment/>
					</column>
					<column width-tablet="6" width-computer="8">
						<segment/>
					</column>
					<column width-tablet="6" width-computer="8">
						<segment/>
					</column>
					<column width-tablet="6" width-computer="8">
						<segment/>
					</column>
					<column width-tablet="6" width-computer="8">
						<segment/>
					</column>
				</grid>
			</example>
		</>
	</>

	<section label="Types">
		<section label="Grid" sticky="stack" collapsible dividing>
			<example "Grid" description="A basic grid.">
				<grid>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
					<column>
						<segment/>
					</column>
				</grid>
			</example>
		</>

		<section label="Divided" sticky="stack" collapsible dividing id="types-divided">
			<example "Divided" description="A grid can have dividers between its columns.">
				<grid columns="3" divided>
					<row>
						<column>
							<image src="/components/ui/images/wireframe/media-paragraph.png" alt=""/>
						</column>
						<column>
							<image src="/components/ui/images/wireframe/media-paragraph.png" alt=""/>
						</column>
						<column>
							<image src="/components/ui/images/wireframe/media-paragraph.png" alt=""/>
						</column>
					</row>
					<row>
						<column>
							<image src="/components/ui/images/wireframe/media-paragraph.png" alt=""/>
						</column>
