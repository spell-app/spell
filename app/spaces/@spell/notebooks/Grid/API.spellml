<spell-notebook "grid api">
	<header level="1">
		Grid
		<header>A grid is used to harmonize negative space in a layout.</>
	</>
	<grid-tab-bar showing="api"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#tags">Tags</>
			<item link="#attributes">Attributes</>
			<item link="#slots">Slots</>
			<item link="#parts">Parts</>
			<item link="#states">States</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`docs/__data/components.json5`);  nothing to write. -->
	<section label="Tags">
		<html>
			<ui-docs-api family="ui-grid" only="tags"></>
		</>
	</>

	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-grid" only="attributes"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api family="ui-grid" only="slots"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-grid" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-grid" only="states"></>
		</>
	</>
</spell-notebook>
