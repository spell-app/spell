<spell-notebook "quote api">
	<header level="1">
		Quote
		<header>A quote holds someone else's words:  a block of its own, or a few words inside a sentence.</>
	</>
	<quote-tab-bar showing="api"/>
	<section>
		<html>
			<ui-menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
				<ui-item link="#attributes">Attributes</>
				<ui-item link="#slots">Slots</>
				<ui-item link="#parts">Parts</>
				<ui-item link="#states">States</>
			</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`site/_data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-quote" only="attributes"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api family="ui-quote" only="slots"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-quote" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-quote" only="states"></>
		</>
	</>
</spell-notebook>
