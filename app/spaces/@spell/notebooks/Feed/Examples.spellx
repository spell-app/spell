<spell-notebook "feed examples">
	<header level="1">
		Feed
		<header>A feed presents user activity chronologically.</>
	</>
	<feed-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#content">Content</>
			<item link="#states">States</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's feed page, section by section, in its order (Types, Content, States, Variations).
		Fomantic's `.label` + `<img>` / `<i class="icon">` / `data-text` are `<ui-event image|icon|label>` (or the `label`
		slot);  `.user` is `<ui-author>`;  `.extra.text` is `<ui-extra text>`;  `.extra.images` is a `<ui-images
		size="tiny">` in a `<ui-extra>`.
	-->
	<section label="Types">
		<section label="Feed" sticky="stack" collapsible dividing>
			<example description="A feed:  a list of `<ui-event>`s.">
				<html>
					<ui-feed>
						<ui-event image="../images/avatar/small/elliot.jpg">
							<ui-content>
								<ui-summary><ui-author link="#">Elliot Fu</ui-author> added you as a friend <ui-date>1 Hour Ago</ui-date></ui-summary>
								<ui-meta>
									<a href="#"><ui-icon name="like"></ui-icon> 4 Likes</a>
								</ui-meta>
							</ui-content>
						</ui-event>
						<ui-event image="../images/avatar/small/helen.jpg">
							<ui-content>
								<ui-summary><a href="#">Helen Troy</a> added <a href="#">2 new illustrations</a> <ui-date>4 days ago</ui-date></ui-summary>
								<ui-extra>
									<ui-images size="tiny">
										<ui-image src="/components/ui/images/wireframe/image.png" link="#" alt=""></ui-image>
										<ui-image src="/components/ui/images/wireframe/image.png" link="#" alt=""></ui-image>
									</ui-images>
								</ui-extra>
								<ui-meta>
									<a href="#"><ui-icon name="like"></ui-icon> 1 Like</a>
								</ui-meta>
							</ui-content>
						</ui-event>
						<ui-event image="../images/avatar/small/jenny.jpg">
							<ui-content>
								<ui-summary><ui-author link="#">Jenny Hess</ui-author> added you as a friend <ui-date>2 Days Ago</ui-date></ui-summary>
								<ui-meta>
									<a href="#"><ui-icon name="like"></ui-icon> 8 Likes</a>
								</ui-meta>
							</ui-content>
						</ui-event>
						<ui-event image="../images/avatar/small/joe.jpg">
							<ui-content>
								<ui-summary><a href="#">Joe Henderson</a> posted on his page <ui-date>3 days ago</ui-date></ui-summary>
								<ui-extra text>Ours is a life of constant reruns. We're always circling back to where we'd we started, then starting all over again. Even if we don't run extra laps that day, we surely will come back for more of the same another day soon.</ui-extra>
								<ui-meta>
									<a href="#"><ui-icon name="like"></ui-icon> 5 Likes</a>
								</ui-meta>
							</ui-content>
						</ui-event>
						<ui-event image="../images/avatar/small/justen.jpg">
							<ui-content>
								<ui-summary><a href="#">Justen Kitsune</a> added <a href="#">2 new photos</a> of you <ui-date>4 days ago</ui-date></ui-summary>
								<ui-extra>
									<ui-images size="tiny">
										<ui-image src="/components/ui/images/wireframe/image.png" link="#" alt=""></ui-image>
										<ui-image src="/components/ui/images/wireframe/image.png" link="#" alt=""></ui-image>
									</ui-images>
								</ui-extra>
								<ui-meta>
									<a href="#"><ui-icon name="like"></ui-icon> 41 Likes</a>
								</ui-meta>
							</ui-content>
						</ui-event>
					</ui-feed>
				</html>
			</example>
		</>
	</>

	<section label="Content">
		<section label="Label" sticky="stack" collapsible dividing>
			<example description="An event label can contain an image, icon, text or label.  `image` is the shorthand for a picture;  the `label` slot takes anything.">
				<html>
					<ui-feed>
						<ui-event image="../images/avatar/small/elliot.jpg">
							<ui-content>You added Elliot Fu to the group <a href="#">Coworkers</a></ui-content>
						</ui-event>
					</ui-feed>
				</html>
			</example>
			<example description="`icon` takes an icon name.">
				<html>
					<ui-feed>
						<ui-event icon="pencil">
							<ui-content>
								<ui-summary>You posted on your friend <a href="#">Stevie Feliciano's</a> wall. <ui-date>Today</ui-date></ui-summary>
							</ui-content>
						</ui-event>
					</ui-feed>
				</html>
			</example>
			<example description="A `<ui-text>` in the `label` slot.">
				<message slot="description" size="small" class="site-not-ported"><html>Not ported: Fomantic's <code>multiline</code> label text (a nudge for a text label that wraps) -- the label box stays one line; keep label texts short.</html></message>
				<feed>
					<event>
						<text slot="label" color="purple">NEW</text>
						<content>Check the latest sales offers</content>
					</event>
					<event>
						<text slot="label" color="purple">THIS FALL</text>
						<content>Only in selected theaters!</content>
					</event>
				</feed>
			</example>
			<example description="A `<ui-label>` in the `label` slot.">
				<feed>
					<event>
						<label slot="label" size="small" color="green">OK</label>
						<content>Deployment was successful</content>
					</event>
				</feed>
			</example>
			<example description="`label` (Fomantic's `data-text`) makes a round label holding the given text.">
				<message slot="description" state="info" size="small"><html>Add a <code>color</code> too, and <code>basic</code> for a variant without background color.</html></message>
				<feed>
					<event label="Run">
						<content>Run, Forrest, run!</content>
					</event>
					<event color="red" label="Stop">
						<content>Don't move!</content>
					</event>
					<event color="yellow" appearance="basic" label="Zzz">
						<content>Nap time</content>
					</event>
				</feed>
			</example>
		</>

		<section label="Date" sticky="stack" collapsible dividing>
			<example description="An event or an event summary can contain a date:  on its own a `<ui-date>` sits above the summary.">
				<html>
					<ui-feed>
						<ui-event image="../images/avatar/small/jenny.jpg">
							<ui-content>
								<ui-date>3 days ago</ui-date>
								<ui-summary>You added <a href="#">Jenny Hess</a> to your <a href="#">coworker</a> group.</ui-summary>
							</ui-content>
						</ui-event>
					</ui-feed>
				</html>
			</example>
			<example description="Inside the summary it sits inline after the text.">
				<html>
					<ui-feed>
						<ui-event image="../images/avatar/small/jenny.jpg">
							<ui-content>
								<ui-summary>You added <a href="#">Jenny Hess</a> to your <a href="#">coworker</a> group. <ui-date>3 days ago</ui-date></ui-summary>
							</ui-content>
						</ui-event>
					</ui-feed>
				</html>
			</example>
		</>

		<!-- GAP I42:  `<ui-date>` has no `floated`, so Fomantic's right floated date sits above the summary. -->
		<section label="Additional information" sticky collapsible dividing>
			<example description="An event can contain additional information like a set of images or text.">
				<message slot="description" state="info" size="small"><html>Fomantic's <code>right floated</code> date (to the right of the content block) has no attribute yet: the date sits above the summary.</html></message>
				<html>
					<ui-feed>
						<ui-event image="../images/avatar/small/helen.jpg">
							<ui-content>
								<ui-date>3 days ago</ui-date>
								<ui-summary><a href="#">Helen Troy</a> added 2 photos</ui-summary>
								<ui-extra>
									<ui-images size="tiny">
										<ui-image src="/components/ui/images/wireframe/image.png" link="#" alt=""></ui-image>
										<ui-image src="/components/ui/images/wireframe/image.png" link="#" alt=""></ui-image>
									</ui-images>
								</ui-extra>
							</ui-content>
						</ui-event>
						<ui-event image="../images/avatar/small/laura.jpg">
							<ui-content>
								<ui-date>3 days ago</ui-date>
								<ui-summary><a href="#">Laura Faucet</a> created a post</ui-summary>
								<ui-extra text>Have you seen what's going on in Israel? Can you believe it.</ui-extra>
							</ui-content>
						</ui-event>
					</ui-feed>
				</html>
			</example>
		</>
	</>

	<section label="States">
		<section label="Disabled" sticky="stack" collapsible dividing>
			<example description="A feed or a single event can be disabled.">
				<html>
					<ui-feed>
						<ui-event disabled image="../images/avatar/small/elliot.jpg">
							<ui-content>
								<ui-summary>
									<ui-author link="#">I am a disabled feed event</ui-author>
								</ui-summary>
								<ui-meta>
									<a href="#"><ui-icon name="like"></ui-icon> 4 Likes</a>
								</ui-meta>
							</ui-content>
						</ui-event>
						<ui-event image="../images/avatar/small/elliot.jpg">
							<ui-content>
								<ui-summary>
									<ui-author link="#">I am a normal feed event</ui-author>
								</ui-summary>
								<ui-meta>
									<a href="#"><ui-icon name="like"></ui-icon> 4 Likes</a>
								</ui-meta>
							</ui-content>
						</ui-event>
					</ui-feed>
				</html>
			</example>
			<example>
				<html>
					<ui-feed disabled>
						<ui-event image="../images/avatar/small/elliot.jpg">
							<ui-content>
								<ui-summary>
									<ui-author link="#">I am a feed event of a whole disabled feed</ui-author>
								</ui-summary>
								<ui-meta>
									<a href="#"><ui-icon name="like"></ui-icon> 4 Likes</a>
								</ui-meta>
							</ui-content>
						</ui-event>
						<ui-event image="../images/avatar/small/elliot.jpg">
							<ui-content>
								<ui-summary>
									<ui-author link="#">Me too</ui-author>
								</ui-summary>
								<ui-meta>
									<a href="#"><ui-icon name="like"></ui-icon> 4 Likes</a>
								</ui-meta>
							</ui-content>
						</ui-event>
					</ui-feed>
				</html>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Connected" sticky="stack" collapsible dividing>
			<example description="Feed events can be connected to visualize a linear timeline.">
				<message slot="description" state="info" size="small"><html>Add a <code>color</code>, <code>&lt;ui-feed connected color="blue"&gt;</code>, to colour the connection line.</html></message>
				<html>
					<ui-feed connected>
						<ui-event image="../images/avatar/small/elliot.jpg">
							<ui-content>
								<ui-summary><ui-author link="#">Elliot Fu</ui-author> added you as a friend <ui-date>1 Hour Ago</ui-date></ui-summary>
								<ui-meta>
									<a href="#"><ui-icon name="like"></ui-icon> 4 Likes</a>
								</ui-meta>
							</ui-content>
						</ui-event>
						<ui-event icon="pencil">
							<ui-content>
								<ui-summary>You submitted a new post to the page <ui-date>3 days ago</ui-date></ui-summary>
								<ui-extra text>I'm having a BBQ this weekend. Come by around 4pm if you can.</ui-extra>
								<ui-meta>
									<a href="#"><ui-icon name="like"></ui-icon> 11 Likes</a>
								</ui-meta>
							</ui-content>
						</ui-event>
						<ui-event image="../images/avatar/small/helen.jpg">
							<ui-content>
								<ui-date>4 days ago</ui-date>
								<ui-summary><a href="#">Helen Troy</a> added <a href="#">2 new illustrations</a></ui-summary>
								<ui-extra>
									<ui-images size="tiny">
										<ui-image src="/components/ui/images/wireframe/image.png" link="#" alt=""></ui-image>
										<ui-image src="/components/ui/images/wireframe/image.png" link="#" alt=""></ui-image>
									</ui-images>
								</ui-extra>
								<ui-meta>
									<a href="#"><ui-icon name="like"></ui-icon> 1 Like</a>
								</ui-meta>
							</ui-content>
						</ui-event>
					</ui-feed>
				</html>
			</example>
		</>

		<section label="Ordered" sticky="stack" collapsible dividing>
			<example description="Ordered feeds number their events' labels by themselves. You can again colour the whole feed or each event, and a basic variant is available too.">
				<message slot="description" state="warning" size="small"><html>With <code>connected</code> the connection line takes the feed's color. An event's own <code>color</code> colours both its circle and the line to the next event (Fomantic can colour the label alone).</html></message>
				<feed color="orange" ordered connected>
					<event color="blue">
						<content>
							<summary>Different label color than whole feed color</summary>
						</content>
					</event>
					<event color="black">
						<content>
							<summary>Automatic label content, line color taken from event color</summary>
						</content>
					</event>
					<event label="3rd">
						<content>
							<summary>Content via the label attribute</summary>
						</content>
					</event>
					<event appearance="basic">
						<content>
							<summary>Basic Label</summary>
						</content>
					</event>
				</feed>
			</example>
		</>

		<section label="Divided" sticky="stack" collapsible dividing>
			<example description="Feed events can be divided to better distinguish between grouped content.">
				<html>
					<ui-feed divided>
						<ui-event>
							<ui-content>
								<ui-summary><a href="#">Elliot Fu</a> added <a href="#">Jenny Hess</a> as a friend</ui-summary>
							</ui-content>
						</ui-event>
						<ui-event>
							<ui-content>
								<ui-summary><a href="#">Stevie Feliciano</a> added <a href="#">Elliot Fu</a> as a friend</ui-summary>
							</ui-content>
						</ui-event>
						<ui-event>
							<ui-content>
								<ui-summary><a href="#">Helen Troy</a> added <a href="#">Christian Rocha</a> as a friend</ui-summary>
							</ui-content>
						</ui-event>
						<ui-event>
							<ui-content>
								<ui-summary><a href="#">Christian Rocha</a> signed up for the site.</ui-summary>
							</ui-content>
						</ui-event>
					</ui-feed>
				</html>
			</example>
		</>

		<section label="Size" sticky="stack" collapsible dividing>
			<example description="A feed can have different sizes.">
				<html>
					<ui-feed size="small">
						<ui-header level="4">Followers Activity</ui-header>
						<ui-event>
							<ui-content>
								<ui-summary><a href="#">Elliot Fu</a> added <a href="#">Jenny Hess</a> as a friend</ui-summary>
							</ui-content>
						</ui-event>
						<ui-event>
							<ui-content>
								<ui-summary><a href="#">Stevie Feliciano</a> added <a href="#">Elliot Fu</a> as a friend</ui-summary>
							</ui-content>
						</ui-event>
						<ui-event>
							<ui-content>
								<ui-summary><a href="#">Helen Troy</a> added <a href="#">Christian Rocha</a> as a friend</ui-summary>
							</ui-content>
						</ui-event>
						<ui-event>
							<ui-content>
								<ui-summary><a href="#">Christian Rocha</a> signed up for the site.</ui-summary>
							</ui-content>
						</ui-event>
					</ui-feed>
				</html>
			</example>
			<example>
				<html>
					<ui-feed size="large">
						<ui-event image="../images/avatar/small/elliot.jpg">
							<ui-content>
								<ui-summary><ui-author link="#">Elliot Fu</ui-author> added you as a friend <ui-date>1 Hour Ago</ui-date></ui-summary>
								<ui-meta>
									<a href="#"><ui-icon name="like"></ui-icon> 4 Likes</a>
								</ui-meta>
							</ui-content>
						</ui-event>
						<ui-event icon="pencil">
							<ui-content>
								<ui-summary>You submitted a new post to the page <ui-date>3 days ago</ui-date></ui-summary>
								<ui-extra text>I'm having a BBQ this weekend. Come by around 4pm if you can.</ui-extra>
								<ui-meta>
									<a href="#"><ui-icon name="like"></ui-icon> 11 Likes</a>
								</ui-meta>
							</ui-content>
						</ui-event>
						<ui-event image="../images/avatar/small/helen.jpg">
							<ui-content>
								<ui-date>4 days ago</ui-date>
								<ui-summary><a href="#">Helen Troy</a> added <a href="#">2 new illustrations</a></ui-summary>
								<ui-extra>
									<ui-images size="tiny">
										<ui-image src="/components/ui/images/wireframe/image.png" link="#" alt=""></ui-image>
										<ui-image src="/components/ui/images/wireframe/image.png" link="#" alt=""></ui-image>
									</ui-images>
								</ui-extra>
								<ui-meta>
									<a href="#"><ui-icon name="like"></ui-icon> 1 Like</a>
								</ui-meta>
							</ui-content>
						</ui-event>
					</ui-feed>
				</html>
			</example>
		</>

		<section label="Inverted" sticky="stack" collapsible dividing>
			<example description="A feed's color can be inverted.">
				<html>
					<ui-segment inverted>
						<ui-feed inverted>
							<ui-event image="../images/avatar/small/elliot.jpg">
								<ui-content>
									<ui-date>Just now</ui-date>
									<ui-summary><ui-author link="#">Elliot Fu</ui-author> posted on his page</ui-summary>
									<ui-extra text>Hey there !</ui-extra>
								</ui-content>
							</ui-event>
							<ui-event image="../images/avatar/small/elliot.jpg">
								<ui-content>
									<ui-summary><ui-author link="#">Elliot Fu</ui-author> added you as a friend <ui-date>1 Hour Ago</ui-date></ui-summary>
								</ui-content>
							</ui-event>
							<ui-event image="../images/avatar/small/helen.jpg">
								<ui-content>
									<ui-summary><a href="#">Helen Troy</a> added <a href="#">2 new illustrations</a> <ui-date>4 days ago</ui-date></ui-summary>
									<ui-extra>
										<ui-images size="tiny">
											<ui-image src="/components/ui/images/wireframe/image.png" link="#" alt=""></ui-image>
											<ui-image src="/components/ui/images/wireframe/image.png" link="#" alt=""></ui-image>
										</ui-images>
									</ui-extra>
									<ui-meta>
										<a href="#"><ui-icon name="like"></ui-icon> 1 Like</a>
									</ui-meta>
								</ui-content>
							</ui-event>
							<ui-event image="../images/avatar/small/jenny.jpg">
								<ui-content>
									<ui-summary><ui-author link="#">Jenny Hess</ui-author> added you as a friend <ui-date>2 Days Ago</ui-date></ui-summary>
									<ui-meta>
										<a href="#"><ui-icon name="like"></ui-icon> 8 Likes</a>
									</ui-meta>
								</ui-content>
							</ui-event>
							<ui-event image="../images/avatar/small/joe.jpg">
								<ui-content>
									<ui-summary><a href="#">Joe Henderson</a> posted on his page <ui-date>3 days ago</ui-date></ui-summary>
									<ui-extra text>Ours is a life of constant reruns. We're always circling back to where we'd we started, then starting all over again. Even if we don't run extra laps that day, we surely will come back for more of the same another day soon.</ui-extra>
									<ui-meta>
										<a href="#"><ui-icon name="like"></ui-icon> 5 Likes</a>
									</ui-meta>
								</ui-content>
							</ui-event>
							<ui-event image="../images/avatar/small/justen.jpg">
								<ui-content>
									<ui-summary><a href="#">Justen Kitsune</a> added <a href="#">2 new photos</a> of you <ui-date>4 days ago</ui-date></ui-summary>
									<ui-extra>
										<ui-images size="tiny">
											<ui-image src="/components/ui/images/wireframe/image.png" link="#" alt=""></ui-image>
											<ui-image src="/components/ui/images/wireframe/image.png" link="#" alt=""></ui-image>
										</ui-images>
									</ui-extra>
									<ui-meta>
										<a href="#"><ui-icon name="like"></ui-icon> 41 Likes</a>
									</ui-meta>
								</ui-content>
							</ui-event>
						</ui-feed>
					</ui-segment>
				</html>
			</example>
		</>
	</>
</spell-notebook>
