<spell-notebook "feed examples">
	<header level="1">
		Feed
		<header>A feed presents user activity chronologically.</>
	</>
	<feed-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#content">Content</>
			<item link="#states">States</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's feed page, section by section, in its order (Types, Content, States, Variations).
		Fomantic's `.label` + `<img>` / `<i class="icon">` / `data-text` are `<ui-event image|icon|label>` (or the `label`
		slot);  `.user` is `<ui-author>`;  `.extra.text` is `<ui-extra text>`;  `.extra.images` is a `<ui-images
		size="tiny">` in a `<ui-extra>`.
	-->
	<section label="Types">
		<section label="Feed" sticky="stack" collapsible dividing>
			<example "Feed" description="A feed:  a list of `<ui-event>`s.">
				<feed>
					<event image="../images/avatar/small/elliot.jpg">
						<content>
							<summary><author link="#">Elliot Fu</author> added you as a friend <date>1 Hour Ago</date></summary>
							<meta>
								<link link="#"><icon name="like"/> 4 Likes</link>
							</meta>
						</content>
					</event>
					<event image="../images/avatar/small/helen.jpg">
						<content>
							<summary><link link="#">Helen Troy</link> added <link link="#">2 new illustrations</link> <date>4 days ago</date></summary>
							<extra>
								<images size="tiny">
									<image src="/components/ui/images/wireframe/image.png" link="#" alt=""/>
									<image src="/components/ui/images/wireframe/image.png" link="#" alt=""/>
								</images>
							</extra>
							<meta>
								<link link="#"><icon name="like"/> 1 Like</link>
							</meta>
						</content>
					</event>
					<event image="../images/avatar/small/jenny.jpg">
						<content>
							<summary><author link="#">Jenny Hess</author> added you as a friend <date>2 Days Ago</date></summary>
							<meta>
								<link link="#"><icon name="like"/> 8 Likes</link>
							</meta>
						</content>
					</event>
					<event image="../images/avatar/small/joe.jpg">
						<content>
							<summary><link link="#">Joe Henderson</link> posted on his page <date>3 days ago</date></summary>
							<extra text>Ours is a life of constant reruns. We're always circling back to where we'd we started, then starting all over again. Even if we don't run extra laps that day, we surely will come back for more of the same another day soon.</extra>
							<meta>
								<link link="#"><icon name="like"/> 5 Likes</link>
							</meta>
						</content>
					</event>
					<event image="../images/avatar/small/justen.jpg">
						<content>
							<summary><link link="#">Justen Kitsune</link> added <link link="#">2 new photos</link> of you <date>4 days ago</date></summary>
							<extra>
								<images size="tiny">
									<image src="/components/ui/images/wireframe/image.png" link="#" alt=""/>
									<image src="/components/ui/images/wireframe/image.png" link="#" alt=""/>
								</images>
							</extra>
							<meta>
								<link link="#"><icon name="like"/> 41 Likes</link>
							</meta>
						</content>
					</event>
				</feed>
			</example>
		</>
	</>

	<section label="Content">
		<section label="Label" sticky="stack" collapsible dividing>
			<example "Label" description="An event label can contain an image, icon, text or label.  `image` is the shorthand for a picture;  the `label` slot takes anything.">
				<feed>
					<event image="../images/avatar/small/elliot.jpg">
						<content>You added Elliot Fu to the group <link link="#">Coworkers</link></content>
					</event>
				</feed>
			</example>
			<example "Label" description="`icon` takes an icon name.">
				<feed>
					<event icon="pencil">
						<content>
							<summary>You posted on your friend <link link="#">Stevie Feliciano's</link> wall. <date>Today</date></summary>
						</content>
					</event>
				</feed>
			</example>
			<example "Label" description="A `<ui-text>` in the `label` slot.">
				<message slot="description" size="small" class="site-not-ported">Not ported: Fomantic's <text code>multiline</text> label text (a nudge for a text label that wraps) -- the label box stays one line; keep label texts short.</message>
				<feed>
					<event>
						<text slot="label" color="purple">NEW</text>
						<content>Check the latest sales offers</content>
					</event>
					<event>
						<text slot="label" color="purple">THIS FALL</text>
						<content>Only in selected theaters!</content>
					</event>
				</feed>
			</example>
			<example "Label" description="A `<ui-label>` in the `label` slot.">
				<feed>
					<event>
						<label slot="label" size="small" color="green">OK</label>
						<content>Deployment was successful</content>
					</event>
				</feed>
			</example>
			<example "Label" description="`label` (Fomantic's `data-text`) makes a round label holding the given text.">
				<message slot="description" state="info" size="small">Add a <text code>color</text> too, and <text code>basic</text> for a variant without background color.</message>
				<feed>
					<event label="Run">
						<content>Run, Forrest, run!</content>
					</event>
					<event color="red" label="Stop">
						<content>Don't move!</content>
					</event>
					<event color="yellow" appearance="basic" label="Zzz">
						<content>Nap time</content>
					</event>
				</feed>
			</example>
		</>

		<section label="Date" sticky="stack" collapsible dividing>
			<example "Date" description="An event or an event summary can contain a date:  on its own a `<ui-date>` sits above the summary.">
				<feed>
					<event image="../images/avatar/small/jenny.jpg">
						<content>
							<date>3 days ago</date>
							<summary>You added <link link="#">Jenny Hess</link> to your <link link="#">coworker</link> group.</summary>
						</content>
					</event>
				</feed>
			</example>
			<example "Date" description="Inside the summary it sits inline after the text.">
				<feed>
					<event image="../images/avatar/small/jenny.jpg">
						<content>
							<summary>You added <link link="#">Jenny Hess</link> to your <link link="#">coworker</link> group. <date>3 days ago</date></summary>
						</content>
					</event>
				</feed>
			</example>
		</>

		<!-- GAP I42:  `<ui-date>` has no `floated`, so Fomantic's right floated date sits above the summary. -->
		<section label="Additional information" sticky collapsible dividing>
			<example "Additional information" description="An event can contain additional information like a set of images or text.">
				<message slot="description" state="info" size="small">Fomantic's <text code>right floated</text> date (to the right of the content block) has no attribute yet: the date sits above the summary.</message>
				<feed>
					<event image="../images/avatar/small/helen.jpg">
						<content>
							<date>3 days ago</date>
							<summary><link link="#">Helen Troy</link> added 2 photos</summary>
							<extra>
								<images size="tiny">
									<image src="/components/ui/images/wireframe/image.png" link="#" alt=""/>
									<image src="/components/ui/images/wireframe/image.png" link="#" alt=""/>
								</images>
							</extra>
						</content>
					</event>
					<event image="../images/avatar/small/laura.jpg">
						<content>
							<date>3 days ago</date>
							<summary><link link="#">Laura Faucet</link> created a post</summary>
							<extra text>Have you seen what's going on in Israel? Can you believe it.</extra>
						</content>
					</event>
				</feed>
			</example>
		</>
	</>

	<section label="States">
		<section label="Disabled" sticky="stack" collapsible dividing>
			<example "Disabled" description="A feed or a single event can be disabled.">
				<feed>
					<event disabled image="../images/avatar/small/elliot.jpg">
						<content>
							<summary>
								<author link="#">I am a disabled feed event</author>
							</summary>
							<meta>
								<link link="#"><icon name="like"/> 4 Likes</link>
							</meta>
						</content>
					</event>
					<event image="../images/avatar/small/elliot.jpg">
						<content>
							<summary>
								<author link="#">I am a normal feed event</author>
							</summary>
							<meta>
								<link link="#"><icon name="like"/> 4 Likes</link>
							</meta>
						</content>
					</event>
				</feed>
			</example>
			<example "Disabled">
				<feed disabled>
					<event image="../images/avatar/small/elliot.jpg">
						<content>
							<summary>
								<author link="#">I am a feed event of a whole disabled feed</author>
							</summary>
							<meta>
								<link link="#"><icon name="like"/> 4 Likes</link>
							</meta>
						</content>
					</event>
					<event image="../images/avatar/small/elliot.jpg">
						<content>
							<summary>
								<author link="#">Me too</author>
							</summary>
							<meta>
								<link link="#"><icon name="like"/> 4 Likes</link>
							</meta>
						</content>
					</event>
				</feed>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Connected" sticky="stack" collapsible dividing>
			<example "Connected" description="Feed events can be connected to visualize a linear timeline.">
				<message slot="description" state="info" size="small">Add a <text code>color</text>, <text code>&lt;ui-feed connected color="blue"&gt;</text>, to colour the connection line.</message>
				<feed connected>
					<event image="../images/avatar/small/elliot.jpg">
						<content>
							<summary><author link="#">Elliot Fu</author> added you as a friend <date>1 Hour Ago</date></summary>
							<meta>
								<link link="#"><icon name="like"/> 4 Likes</link>
							</meta>
						</content>
					</event>
					<event icon="pencil">
						<content>
							<summary>You submitted a new post to the page <date>3 days ago</date></summary>
							<extra text>I'm having a BBQ this weekend. Come by around 4pm if you can.</extra>
							<meta>
								<link link="#"><icon name="like"/> 11 Likes</link>
							</meta>
						</content>
					</event>
					<event image="../images/avatar/small/helen.jpg">
						<content>
							<date>4 days ago</date>
							<summary><link link="#">Helen Troy</link> added <link link="#">2 new illustrations</link></summary>
							<extra>
								<images size="tiny">
									<image src="/components/ui/images/wireframe/image.png" link="#" alt=""/>
									<image src="/components/ui/images/wireframe/image.png" link="#" alt=""/>
								</images>
							</extra>
							<meta>
								<link link="#"><icon name="like"/> 1 Like</link>
							</meta>
						</content>
					</event>
				</feed>
			</example>
		</>

		<section label="Ordered" sticky="stack" collapsible dividing>
			<example "Ordered" description="Ordered feeds number their events' labels by themselves. You can again colour the whole feed or each event, and a basic variant is available too.">
				<message slot="description" state="warning" size="small">With <text code>connected</text> the connection line takes the feed's color. An event's own <text code>color</text> colours both its circle and the line to the next event (Fomantic can colour the label alone).</message>
				<feed color="orange" ordered connected>
					<event color="blue">
						<content>
							<summary>Different label color than whole feed color</summary>
						</content>
					</event>
					<event color="black">
						<content>
							<summary>Automatic label content, line color taken from event color</summary>
						</content>
					</event>
					<event label="3rd">
						<content>
							<summary>Content via the label attribute</summary>
						</content>
					</event>
					<event appearance="basic">
						<content>
							<summary>Basic Label</summary>
						</content>
					</event>
				</feed>
			</example>
		</>

		<section label="Divided" sticky="stack" collapsible dividing>
			<example "Divided" description="Feed events can be divided to better distinguish between grouped content.">
				<feed divided>
					<event>
						<content>
							<summary><link link="#">Elliot Fu</link> added <link link="#">Jenny Hess</link> as a friend</summary>
						</content>
					</event>
					<event>
						<content>
							<summary><link link="#">Stevie Feliciano</link> added <link link="#">Elliot Fu</link> as a friend</summary>
						</content>
					</event>
					<event>
						<content>
							<summary><link link="#">Helen Troy</link> added <link link="#">Christian Rocha</link> as a friend</summary>
						</content>
					</event>
					<event>
						<content>
							<summary><link link="#">Christian Rocha</link> signed up for the site.</summary>
						</content>
					</event>
				</feed>
			</example>
		</>

		<section label="Size" sticky="stack" collapsible dividing>
			<example "Size" description="A feed can have different sizes.">
				<feed size="small">
					<header level="4">Followers Activity</header>
					<event>
						<content>
							<summary><link link="#">Elliot Fu</link> added <link link="#">Jenny Hess</link> as a friend</summary>
						</content>
					</event>
					<event>
						<content>
							<summary><link link="#">Stevie Feliciano</link> added <link link="#">Elliot Fu</link> as a friend</summary>
						</content>
					</event>
					<event>
						<content>
							<summary><link link="#">Helen Troy</link> added <link link="#">Christian Rocha</link> as a friend</summary>
						</content>
					</event>
					<event>
						<content>
							<summary><link link="#">Christian Rocha</link> signed up for the site.</summary>
						</content>
					</event>
				</feed>
			</example>
			<example "Size">
				<feed size="large">
					<event image="../images/avatar/small/elliot.jpg">
						<content>
							<summary><author link="#">Elliot Fu</author> added you as a friend <date>1 Hour Ago</date></summary>
							<meta>
								<link link="#"><icon name="like"/> 4 Likes</link>
							</meta>
						</content>
					</event>
					<event icon="pencil">
						<content>
							<summary>You submitted a new post to the page <date>3 days ago</date></summary>
							<extra text>I'm having a BBQ this weekend. Come by around 4pm if you can.</extra>
							<meta>
								<link link="#"><icon name="like"/> 11 Likes</link>
							</meta>
						</content>
					</event>
					<event image="../images/avatar/small/helen.jpg">
						<content>
							<date>4 days ago</date>
							<summary><link link="#">Helen Troy</link> added <link link="#">2 new illustrations</link></summary>
							<extra>
								<images size="tiny">
									<image src="/components/ui/images/wireframe/image.png" link="#" alt=""/>
									<image src="/components/ui/images/wireframe/image.png" link="#" alt=""/>
								</images>
							</extra>
							<meta>
								<link link="#"><icon name="like"/> 1 Like</link>
							</meta>
						</content>
					</event>
				</feed>
			</example>
		</>

		<section label="Inverted" sticky="stack" collapsible dividing>
			<example "Inverted" description="A feed's color can be inverted.">
				<segment inverted>
					<feed inverted>
						<event image="../images/avatar/small/elliot.jpg">
							<content>
								<date>Just now</date>
								<summary><author link="#">Elliot Fu</author> posted on his page</summary>
								<extra text>Hey there !</extra>
							</content>
						</event>
						<event image="../images/avatar/small/elliot.jpg">
							<content>
								<summary><author link="#">Elliot Fu</author> added you as a friend <date>1 Hour Ago</date></summary>
							</content>
						</event>
						<event image="../images/avatar/small/helen.jpg">
							<content>
								<summary><link link="#">Helen Troy</link> added <link link="#">2 new illustrations</link> <date>4 days ago</date></summary>
								<extra>
									<images size="tiny">
										<image src="/components/ui/images/wireframe/image.png" link="#" alt=""/>
										<image src="/components/ui/images/wireframe/image.png" link="#" alt=""/>
									</images>
								</extra>
								<meta>
									<link link="#"><icon name="like"/> 1 Like</link>
								</meta>
							</content>
						</event>
						<event image="../images/avatar/small/jenny.jpg">
							<content>
								<summary><author link="#">Jenny Hess</author> added you as a friend <date>2 Days Ago</date></summary>
								<meta>
									<link link="#"><icon name="like"/> 8 Likes</link>
								</meta>
							</content>
						</event>
						<event image="../images/avatar/small/joe.jpg">
							<content>
								<summary><link link="#">Joe Henderson</link> posted on his page <date>3 days ago</date></summary>
								<extra text>Ours is a life of constant reruns. We're always circling back to where we'd we started, then starting all over again. Even if we don't run extra laps that day, we surely will come back for more of the same another day soon.</extra>
								<meta>
									<link link="#"><icon name="like"/> 5 Likes</link>
								</meta>
							</content>
						</event>
						<event image="../images/avatar/small/justen.jpg">
							<content>
								<summary><link link="#">Justen Kitsune</link> added <link link="#">2 new photos</link> of you <date>4 days ago</date></summary>
								<extra>
									<images size="tiny">
										<image src="/components/ui/images/wireframe/image.png" link="#" alt=""/>
										<image src="/components/ui/images/wireframe/image.png" link="#" alt=""/>
									</images>
								</extra>
								<meta>
									<link link="#"><icon name="like"/> 41 Likes</link>
								</meta>
							</content>
						</event>
					</feed>
				</segment>
			</example>
		</>
	</>
</spell-notebook>
