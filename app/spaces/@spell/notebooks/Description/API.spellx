<spell-notebook "description api">
	<header level="1">
		Description
		<header>A description is the text of a card, item, modal, list item, step or comment.</>
	</>
	<description-tab-bar showing="api"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#attributes">Attributes</>
			<item link="#slots">Slots</>
			<item link="#parts">Parts</>
			<item link="#states">States</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`docs/__data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api tag="ui-description" only="attributes"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api tag="ui-description" only="slots"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api tag="ui-description" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api tag="ui-description" only="states"></>
		</>
	</>
</spell-notebook>
