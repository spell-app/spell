<spell-notebook "statistic examples">
	<header level="1">
		Statistic
		<header>A statistic emphasizes the current value of an attribute.</>
	</>
	<statistic-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#content">Content</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's statistic page, section by section, in its order (Types, Content, Variations).
		Fomantic's `.value` / `.label` are the `value` / `label` shorthands, or slotted `<ui-value>` / `<ui-label>` parts
		(slotted parts keep their order:  a label first is Fomantic's top label);  `four statistics` is `widths="4"`.
	-->
	<section label="Types">
		<section label="Statistic" sticky="stack" collapsible dividing>
			<example "Statistic" description="A statistic can display a value with a label above or below it:  `value` and `label` are the shorthands.">
				<statistic value="5,550" label="Downloads"/>
			</example>
			<example "Statistic" description="Slotted `<ui-label>` and `<ui-value>` parts keep their order, so a label written first sits on top.">
				<statistic>
					<label>Views</label>
					<value>40,509</value>
				</statistic>
			</example>
		</>

		<section label="Statistic Group" sticky="stack" collapsible dividing>
			<example "Statistic Group" description="A group of statistics.">
				<statistics>
					<statistic value="22" label="Faves"/>
					<statistic value="31,200" label="Views"/>
					<statistic value="22" label="Members"/>
				</statistics>
			</example>
		</>
	</>

	<section label="Content">
		<section label="Value" sticky="stack" collapsible dividing>
			<example "Value" description="A statistic can contain a numeric, icon, image, or text value:  `<ui-value text>` is a word value.">
				<statistics>
					<statistic value="22" label="Saves"/>
					<statistic label="Signups">
						<value text>
							<stack spacing="none">
								<text>Three</text>
								<text>Thousand</text>
							</stack>
						</value>
					</statistic>
					<statistic label="Flights">
						<value><icon name="plane"/> 5</value>
					</statistic>
					<statistic label="Team Members">
						<value><image inline src="/components/ui/images/avatar/small/joe.jpg" alt="" appearance="circular"/> 42</value>
					</statistic>
				</statistics>
			</example>
		</>

		<section label="Label" sticky="stack" collapsible dividing>
			<example "Label" description="A statistic can contain a label to help provide context for the presented value.">
				<statistic value="2,204" label="Views"/>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Horizontal Statistic" sticky collapsible dividing>
			<example "Horizontal Statistic" description="A statistic can present its measurement horizontally.">
				<statistic direction="horizontal" value="2,204" label="Views"/>
			</example>
			<example "Horizontal Statistic">
				<statistics direction="horizontal">
					<statistic value="2,204" label="Views"/>
					<statistic value="3,322" label="Downloads"/>
					<statistic value="22" label="Tasks"/>
				</statistics>
			</example>
		</>

		<section label="Colored" sticky="stack" collapsible dividing>
			<example "Colored" description="A statistic can be formatted to be different colors.">
				<statistics>
					<statistic color="red" value="27" label="Red"/>
					<statistic color="orange" value="8" label="Orange"/>
					<statistic color="yellow" value="28" label="Yellow"/>
					<statistic color="olive" value="7" label="Olive"/>
					<statistic color="green" value="14" label="Green"/>
					<statistic color="teal" value="82" label="Teal"/>
					<statistic color="blue" value="1" label="Blue"/>
					<statistic color="violet" value="22" label="Violet"/>
					<statistic color="purple" value="23" label="Purple"/>
					<statistic color="pink" value="15" label="Pink"/>
					<statistic color="brown" value="36" label="Brown"/>
					<statistic color="grey" value="49" label="Grey"/>
				</statistics>
			</example>
		</>

		<section label="Inverted" sticky="stack" collapsible dividing>
			<example "Inverted" description="A statistic can be formatted to fit on a dark background.">
				<segment inverted>
					<statistic inverted value="54" label="Inverted"/>
					<statistic color="red" inverted value="27" label="Red"/>
					<statistic color="orange" inverted value="8" label="Orange"/>
					<statistic color="yellow" inverted value="28" label="Yellow"/>
					<statistic color="olive" inverted value="7" label="Olive"/>
					<statistic color="green" inverted value="14" label="Green"/>
					<statistic color="teal" inverted value="82" label="Teal"/>
					<statistic color="blue" inverted value="1" label="Blue"/>
					<statistic color="violet" inverted value="22" label="Violet"/>
					<statistic color="purple" inverted value="23" label="Purple"/>
					<statistic color="pink" inverted value="15" label="Pink"/>
					<statistic color="brown" inverted value="36" label="Brown"/>
					<statistic color="grey" inverted value="49" label="Grey"/>
				</segment>
			</example>
		</>

		<section label="Stackable" sticky="stack" collapsible dividing>
			<example "Stackable" description="A statistic group can automatically stack rows to a single column on mobile devices.">
				<message slot="description" state="info" size="small"><text code>stackable</text> answers to the GROUP's width (below 768px), not the window's. This page's example column is narrower than that, so the group shows stacked here even on a wide screen.</message>
				<statistics stackable>
					<statistic color="red" value="27" label="Red"/>
					<statistic color="orange" value="8" label="Orange"/>
					<statistic color="yellow" value="28" label="Yellow"/>
					<statistic color="olive" value="7" label="Olive"/>
					<statistic color="green" value="14" label="Green"/>
					<statistic color="teal" value="82" label="Teal"/>
					<statistic color="blue" value="1" label="Blue"/>
					<statistic color="violet" value="22" label="Violet"/>
					<statistic color="purple" value="23" label="Purple"/>
					<statistic color="pink" value="15" label="Pink"/>
					<statistic color="brown" value="36" label="Brown"/>
					<statistic color="grey" value="49" label="Grey"/>
				</statistics>
			</example>
		</>

		<section label="Evenly Divided" sticky="stack" collapsible dividing>
			<example "Evenly Divided" description="A statistic group can have its items divided evenly:  `widths=\"4\"` is Fomantic's `four statistics`.">
				<statistics widths="4">
					<statistic value="22" label="Saves"/>
					<statistic label="Signups">
						<value text>
							<stack spacing="none">
								<text>Three</text>
								<text>Thousand</text>
							</stack>
						</value>
					</statistic>
					<statistic label="Flights">
						<value><icon name="plane"/> 5</value>
					</statistic>
					<statistic label="Team Members">
						<value><image inline src="/components/ui/images/avatar/small/joe.jpg" alt="" appearance="circular"/> 42</value>
					</statistic>
				</statistics>
			</example>
		</>

		<section label="Equal" sticky="stack" collapsible dividing>
			<example "Equal" description="`equal` divides the row evenly without a count:  one row, an equal share of it per statistic.  `widths=\"4\"` above is the older, count-based spelling (which wraps after four).">
				<statistics equal>
					<statistic value="22" label="Saves"/>
					<statistic value="31,200" label="Views"/>
					<statistic value="5" label="Teams"/>
				</statistics>
			</example>
		</>

		<section label="Fluid" sticky="stack" collapsible dividing>
			<example "Fluid" description="A fluid statistic occupies the whole container width. It's a simpler alternative to a `widths=\"1\"` group.">
				<statistic fluid value="2,204" label="Views"/>
			</example>
		</>

		<section label="Left and Right" sticky="stack" collapsible dividing>
			<example "Left and Right" description="A statistic has no `floated` any more: a `<ui-stack>` puts it at the left or the right of other content. The text stays in a column beside it; it doesn't wrap round it.">
				<segment>
					<stack direction="horizontal" align="start">
						<stack>
							<text paragraph>Te eum doming eirmod, nominati pertinacia argumentum ad his. Ex eam alia facete scriptorem, est autem aliquip detraxit at. Usu ocurreret referrentur at, cu epicurei appellantur vix. Cum ea laoreet recteque electram, eos choro alterum definiebas in. Vim dolorum definiebas an. Mei ex natum rebum iisque.</text>
							<text paragraph>Audiam quaerendum eu sea, pro omittam definiebas ex. Te est latine definitiones. Quot wisi nulla ex duo. Vis sint solet expetenda ne, his te phaedrum referrentur consectetuer. Id vix fabulas oporteat, ei quo vide phaedrum, vim vivendum maiestatis in.</text>
						</stack>
						<statistic value="2,204" label="Views"/>
					</stack>
					<stack direction="horizontal" align="start">
						<statistic value="2,204" label="Views"/>
						<stack>
							<text paragraph>Eu quo homero blandit intellegebat. Incorrupte consequuntur mei id. Mei ut facer dolores adolescens, no illum aperiri quo, usu odio brute at. Qui te porro electram, ea dico facete utroque quo. Populo quodsi te eam, wisi everti eos ex, eum elitr altera utamur at. Quodsi convenire mnesarchum eu per, quas minimum postulant per id.</text>
							<text paragraph>Audiam quaerendum eu sea, pro omittam definiebas ex. Te est latine definitiones. Quot wisi nulla ex duo. Vis sint solet expetenda ne, his te phaedrum referrentur consectetuer. Id vix fabulas oporteat, ei quo vide phaedrum, vim vivendum maiestatis in.</text>
						</stack>
					</stack>
				</segment>
			</example>
		</>

		<section label="Size" sticky="stack" collapsible dividing>
			<example "Size" description="A statistic can vary in size.">
				<statistic size="mini" value="2,204" label="Views"/>
				<statistic size="tiny" value="2,204" label="Views"/>
				<statistic size="small" value="2,204" label="Views"/>
				<statistic value="2,204" label="Views"/>
				<statistic size="large" value="2,204" label="Views"/>
				<statistic size="huge" value="2,204" label="Views"/>
			</example>

			<!-- GAP I90:  a statistic after a (hidden) divider still takes the sibling margin (Fomantic's is adjacent-only). -->
			<example "Size">
				<statistic size="mini" direction="horizontal" value="2,204" label="Views"/>
				<divider spacer/>
				<statistic size="tiny" direction="horizontal" value="2,204" label="Views"/>
				<divider spacer/>
				<statistic size="small" direction="horizontal" value="2,204" label="Views"/>
				<divider spacer/>
				<statistic direction="horizontal" value="2,204" label="Views"/>
				<divider spacer/>
				<statistic size="large" direction="horizontal" value="2,204" label="Views"/>
				<divider spacer/>
				<statistic size="huge" direction="horizontal" value="2,204" label="Views"/>
			</example>
		</>
	</>
</spell-notebook>
