<spell-notebook "section examples">
	<header level="1">
		Section
		<header>A section is a titled block of content that can close and keep its title in view.</>
	</>
	<section-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#groups">Groups</>
			<item link="#content">Content</>
			<item link="#states">States</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  ours only, no Fomantic page.  The old Astro page's examples, restyled;  they mirror the family's
		`examples/elements/` files (types, groups, content, states, variations).
		- Each example's outer section says `level="4"`:  it sits under the example's `h3`, so a default `h2` would break
		  the page's outline.  Nested sections show the default (parent + 1).
		- The sticky example scrolls inside a `<ui-root height>` box (a named, focusable region), framed by a segment.
	-->
	<section label="Types">
		<section label="Section" sticky="stack" collapsible dividing>
			<example "Section" description="A section is a title over its content.  The title is a real heading:  `level` picks `h1` ... `h6`.">
				<section label="Getting started" level="4">
					<text paragraph>Install the package, import the families you use, and write the tags in your markup.</text>
				</section>
			</example>
		</>

		<section label="Collapsible" sticky="stack" collapsible dividing>
			<example "Collapsible" description="A `collapsible` section closes and opens when its title is activated.  `open=\"false\"` starts it closed.">
				<section label="Release notes" level="4" collapsible>
					<text paragraph>Open by default: activate the title to close it.</text>
				</section>
				<section label="Older releases" level="4" collapsible open="false">
					<text paragraph>Closed at the start: only the title shows until it is activated.</text>
				</section>
			</example>
		</>

		<section label="Sticky" sticky="stack" collapsible dividing>
			<example "Sticky" description="A `sticky` section keeps its title in view while its content scrolls past.  Nested sticky titles stack below their parent's.  Scroll the box.">
				<segment>
					<root height="16em" aria-label="Sticky section example" display="immediately">
						<section label="Chapter 1" level="4" sticky block>
							<text paragraph>The chapter's title sticks to the top of the box while any of the chapter is on screen.</text>
							<section label="Part A" sticky dividing>
								<text paragraph>This title sticks just below the chapter's.</text>
								<text paragraph>Keep scrolling: both titles stay until their sections end.</text>
								<text paragraph>When Part A ends, Part B's title takes its place.</text>
							</section>
							<section label="Part B" sticky dividing>
								<text paragraph>A second nested section, stuck below the same chapter title.</text>
								<text paragraph>Its title leaves with it at the end of the chapter.</text>
							</section>
						</section>
						<section label="Chapter 2" level="4" sticky block>
							<text paragraph>The next chapter's title pushes the first one out.</text>
							<text paragraph>The end of the box.</text>
						</section>
					</root>
				</segment>
			</example>
		</>

		<section label="Stacking" sticky="stack" collapsible dividing>
			<example "Stacking" description="`sticky=\"stack\"` draws the titles as one stack of rounded bars, as this page's own sections:  each level a step further in, a first nested title tucked under its own, closed sections one after another one group, round only at its top and bottom, and a nested title stuck under its parent's a heavy round (scroll this page).  Open Part A or Part B:  the group splits there.">
				<segment appearance="basic" style="--ui-section-stack-reach: 12px; --ui-section-stack-step: 8px">
					<section label="Chapter 1" level="4" sticky="stack" collapsible>
						<section label="Part A" sticky="stack" collapsible open="false">
							<text paragraph>Part A's title is tucked right under the chapter's:  it's the first thing in it.</text>
						</section>
						<section label="Part B" sticky="stack" collapsible open="false">
							<text paragraph>Closed, Part A and Part B are one group, round only at its ends.</text>
						</section>
						<section label="Part C" sticky="stack" collapsible>
							<text paragraph>An open section after closed ones starts right under them.</text>
						</section>
					</section>
				</segment>
			</example>
		</>
	</>

	<section label="Groups">
		<section label="Collapsing" sticky="stack" collapsible dividing>
			<example "Collapsing" description="`<ui-sections collapsing>`:  every section in it can close, sub-sections included, with no `collapsible` on each;  closed ones stack with no space between.  An open one sits flush under the title above and keeps its space below.  `collapsible=\"false\"` opts a section out.">
				<sections collapsing>
					<section label="Overview" level="4" dividing open="false">
						<text paragraph>What the project is.</text>
					</section>
					<section label="Install" level="4" dividing open="false">
						<text paragraph>How to get it.</text>
					</section>
					<section label="Configure" level="4" dividing>
						<text paragraph>Open:  its sub-sections close too.</text>
						<section label="Options" open="false">
							<text paragraph>Every option.</text>
						</section>
						<section label="Defaults" open="false">
							<text paragraph>What you get as is.</text>
						</section>
					</section>
					<section label="Deploy" level="4" dividing open="false">
						<text paragraph>Ship it.</text>
					</section>
					<section label="Changelog" level="4" dividing collapsible="false">
						<text paragraph>Opted out:  never closes.</text>
					</section>
				</sections>
			</example>
			<example "Collapsing" description="Styled sections in a collapsing group read as a styled accordion.">
				<sections collapsing>
					<section label="What is a dog?" level="4" appearance="styled" open="false">
						<text paragraph>A domesticated carnivore.</text>
					</section>
					<section label="What kinds of dogs are there?" level="4" appearance="styled" open="false">
						<text paragraph>Many breeds.</text>
					</section>
					<section label="How do you acquire a dog?" level="4" appearance="styled" open="false">
						<text paragraph>Adopt one.</text>
					</section>
				</sections>
			</example>
		</>

		<section label="Plain" sticky="stack" collapsible dividing>
			<example "Plain" description="Without `collapsing`, `<ui-sections>` is just a block spaced as one section:  it changes nothing in its sections.">
				<sections>
					<section label="First" level="4" dividing>
						<text paragraph>As usual.</text>
					</section>
					<section label="Second" level="4" dividing>
						<text paragraph>The usual space between them.</text>
					</section>
				</sections>
			</example>
		</>

		<section label="Flat markup" sticky="stack" collapsible dividing>
			<example "Flat markup" description="A section can be written outside the one it belongs in:  `parent` names that section's id (or a `<ui-sections>` group's), and it nests there, in page order.">
				<section id="demo-setup" label="Setup" level="4" dividing>
					<text paragraph>The outer section's own content.</text>
				</section>
				<section parent="demo-setup" label="Install" collapsible>
					<text paragraph>Nested under Setup.</text>
				</section>
				<section parent="demo-setup" label="Configure" collapsible open="false">
					<text paragraph>Nested too, and closed.</text>
				</section>
			</example>
		</>
	</>

	<section label="Content">
		<section label="Subhead" sticky="stack" collapsible dividing>
			<example "Subhead" description="A `hint` sits under the title, in smaller text.  It scrolls away with the content:  it never sticks.">
				<section label="Billing" hint="Invoices, payment methods and receipts" level="4">
					<text paragraph>Your next invoice is due on the first of the month.</text>
				</section>
			</example>
		</>

		<section label="Icon" sticky="stack" collapsible dividing>
			<example "Icon" description="An `icon` goes before the title;  a `slot=\"icon\"` child replaces it with any markup.">
				<section label="Reading list" icon="book" level="4">
					<text paragraph>Three books, two articles.</text>
				</section>
				<section label="Inbox" level="4">
					<icon slot="icon" name="envelope" color="blue"/>
					<text paragraph>No new mail.</text>
				</section>
			</example>
		</>

		<section label="Badge" sticky="stack" collapsible dividing>
			<example "Badge" description="A `badge` is a small pill after the title, such as a count;  `slot=\"badge\"` takes a richer one, e.g. a `<ui-label>`.">
				<section label="Tasks" badge="3/7" level="4">
					<text paragraph>Three of seven done.</text>
				</section>
				<section label="Alerts" level="4">
					<label slot="badge" color="red" size="mini">2 new</label>
					<text paragraph>Two alerts need your attention.</text>
				</section>
			</example>
		</>

		<section label="Actions" sticky="stack" collapsible dividing>
			<example "Actions" description="The `actions` slot holds controls at the right of the title bar.  They are not part of the open / close button:  activating one never closes the section.">
				<section label="Members" level="4" collapsible dividing>
					<button slot="actions" size="mini" icon="user plus" appearance="basic">Invite</button>
					<text paragraph>Four people can edit this project.</text>
				</section>
			</example>
		</>

		<section label="End chevron" sticky="stack" collapsible dividing>
			<example "End chevron" description="`fold-icon=\"end\"` moves the open / close chevron to the far end of the title bar, after the badge and actions, as an inspector draws it.  A click on it closes the section too;  the title is still the button.">
				<section label="Variants" level="4" collapsible fold-icon="end" dividing>
					<button slot="actions" size="mini" icon="copy" appearance="basic">Copy</button>
					<text paragraph>Seventeen shades of one colour.</text>
				</section>
			</example>
		</>

		<section label="Chevron turn" sticky="stack" collapsible dividing>
			<example "Chevron turn" description="The chevron points down while open, and turns toward the title while closed.  Two tokens set the turns, as the code below shows:  `180deg` and `0deg` point it up while open and down while closed, as the Spell theme does.  Right to left, each turn is negated.">
				<stack style="--ui-section-fold-icon-rotate: 180deg; --ui-section-fold-icon-folded-rotate: 0deg">
					<section label="Open" level="4" collapsible fold-icon="end" dividing>
						<text paragraph>The chevron points up.</text>
					</section>
					<section label="Closed" level="4" collapsible open="false" fold-icon="end" dividing>
						<text paragraph>The chevron points down.</text>
					</section>
				</stack>
			</example>
		</>

		<section label="Info tip" sticky="stack" collapsible dividing>
			<example "Info tip" description="`description` is a tip about the section, shown under the title bar while the pointer is on the title or its open / close button has keyboard focus;  it describes the title for screen readers.  `slot=\"description\"` takes a rich one:  bold words, line breaks.">
				<section label="Theme" level="4" description="The look of an app:  its colours, fonts and shapes." collapsible dividing>
					<text paragraph>Give it a name, then adjust the sections below.</text>
				</section>
				<section label="Color" level="4" dividing>
					<text slot="description">
						<stack spacing="none">
							<text>Pick a <text bold>colour set</text> for each job in the app.</text>
							<text>Spell chooses the right <text bold>shade</text> for light and dark mode.</text>
						</stack>
					</text>
					<text paragraph>Primary, secondary and the rest.</text>
				</section>
			</example>
		</>

		<section label="Rich header" sticky="stack" collapsible dividing>
			<example "Rich header" description="`slot=\"label\"` is the rich version of `label`:  code, links, emphasis.">
				<section level="4">
					<text slot="label">The <text code>open</text> attribute</text>
					<text paragraph>Set it to close the section from code.</text>
				</section>
			</example>
		</>

		<section label="Nested" sticky="stack" collapsible dividing>
			<example "Nested" description="Sections nest.  A nested section's heading is one level below its parent's, so the page outline follows the markup.">
				<section label="Settings" level="4">
					<section label="Profile">
						<text paragraph>An <text code>h5</text>: one below its parent.</text>
					</section>
					<section label="Notifications">
						<text paragraph>Another <text code>h5</text>.</text>
					</section>
				</section>
			</example>
		</>
	</>

	<section label="States">
		<section label="Collapsed" sticky="stack" collapsible dividing>
			<example "Collapsed" description="A collapsed section shows only its title.  Its content stays in the page, hidden until found (see Opening and closing, on the Usage tab).">
				<section label="Advanced options" level="4" collapsible open="false" dividing>
					<text paragraph>Hidden until the section opens.</text>
				</section>
			</example>
		</>

		<section label="Loading" sticky="stack" collapsible dividing>
			<example "Loading" description="A `loading` section dims its content under a spinner and is `aria-busy`.">
				<section label="Recent activity" level="4" appearance="bordered" loading>
					<text paragraph>Fetching the latest events.</text>
				</section>
			</example>
		</>

		<section label="Disabled" sticky="stack" collapsible dividing>
			<example "Disabled" description="A `disabled` section is dimmed and inert, and can't be closed.">
				<section label="Archived" level="4" collapsible disabled>
					<text paragraph>Nothing here can be used.</text>
				</section>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Dividing" sticky="stack" collapsible dividing>
			<example "Dividing" description="A section can have a rule under its title, like a dividing header.">
				<section label="Overview" level="4" dividing>
					<text paragraph>The rule separates the title from the content.</text>
				</section>
			</example>
		</>

		<section label="Block" sticky="stack" collapsible dividing>
			<example "Block" description="A section can put its title bar in a tinted box, like a block header.">
				<section label="Overview" level="4" block>
					<text paragraph>The tinted bar stands out when sections run together.</text>
				</section>
			</example>
		</>

		<section label="Bordered" sticky="stack" collapsible dividing>
			<example "Bordered" description="A section can sit in a box, like a segment (`appearance` `bordered`);  `raised` lifts it with a shadow.">
				<section label="Bordered" level="4" appearance="bordered">
					<text paragraph>A box around title and content.</text>
				</section>
				<section label="Raised" level="4" appearance="bordered raised">
					<text paragraph>The same box, lifted.</text>
				</section>
			</example>
		</>

		<section label="Styled" sticky="stack" collapsible dividing>
			<example "Styled" description="A section can look like a styled accordion panel:  a tinted title bar over padded content.">
				<section label="Styled" level="4" appearance="styled" collapsible>
					<text paragraph>Pairs well with <text code>collapsible</text>.</text>
				</section>
			</example>
		</>

		<section label="Drawer" sticky="stack" collapsible dividing>
			<example "Drawer" description="`appearance=\"drawer\"`:  the title a raised bar, the content a tinted panel attached under it, which rolls open and closed, as an example's code rolls out under its demo.">
				<section label="Settings" appearance="drawer" collapsible>
					<text paragraph>The drawer's content, on its own tint, attached under the title.</text>
					<text paragraph>Click the title:  it rolls closed, and the title's bottom corners round again.</text>
				</section>
			</example>
		</>

		<section label="Attached" sticky="stack" collapsible dividing>
			<example "Attached" description="Boxed sections can join edge to edge:  `attach=\"top\"` above, `attach=\"both\"` between, `attach=\"bottom\"` below.">
				<section label="Step 1" level="4" appearance="bordered" attach="top">
					<text paragraph>Choose a plan.</text>
				</section>
				<section label="Step 2" level="4" appearance="bordered" attach="both">
					<text paragraph>Add your details.</text>
				</section>
				<section label="Step 3" level="4" appearance="bordered" attach="bottom">
					<text paragraph>Confirm.</text>
				</section>
			</example>
		</>

		<section label="Colored" sticky="stack" collapsible dividing>
			<example "Colored" description="A section can be colored:  the title, and the rule or box edge with it.">
				<section label="Red" level="4" color="red" dividing>
					<text paragraph>Red.</text>
				</section>
				<section label="Teal" level="4" color="teal" dividing>
					<text paragraph>Teal.</text>
				</section>
				<section label="Blue" level="4" color="blue" block>
					<text paragraph>Blue.</text>
				</section>
				<section label="Purple" level="4" color="purple" appearance="bordered">
					<text paragraph>Purple.</text>
				</section>
			</example>
		</>

		<section label="Size" sticky="stack" collapsible dividing>
			<example "Size" description="`size` scales the CONTENT only;  the title keeps its level's size.">
				<section label="Small content" level="4" size="small">
					<text paragraph>This content is small.</text>
				</section>
				<section label="Large content" level="4" size="large">
					<text paragraph>This content is large.</text>
				</section>
			</example>
		</>

		<section label="Compact and padded" sticky collapsible dividing>
			<example "Compact and padded" description="`padding=\"compact\"` tightens the space around the title;  `padding=\"md\"` (or `lg`) gives the content more room.">
				<section label="Compact" level="4" appearance="bordered" padding="compact">
					<text paragraph>Less space around the title.</text>
				</section>
				<section label="Padded" level="4" appearance="bordered" padding="md">
					<text paragraph>More padding in the content.</text>
				</section>
				<section label="Very padded" level="4" appearance="bordered" padding="lg">
					<text paragraph>Even more.</text>
				</section>
			</example>
		</>

		<section label="Scrolling" sticky="stack" collapsible dividing>
			<example "Scrolling" description="A section can cap its content's height and scroll it:  `scrolling` (`short` ... `very long`, caps that grow with the viewport), or any CSS length as `height`.">
				<section label="Log" level="4" appearance="bordered" scrolling="very short">
					<text paragraph>09:00 Build started</text>
					<text paragraph>09:01 Dependencies installed</text>
					<text paragraph>09:03 Tests passed</text>
					<text paragraph>09:04 Bundle written</text>
					<text paragraph>09:05 Deployed</text>
					<text paragraph>09:06 Smoke tests passed</text>
					<text paragraph>09:10 Traffic switched</text>
					<text paragraph>09:15 Old version drained</text>
					<text paragraph>09:20 Old version stopped</text>
					<text paragraph>09:30 Done</text>
				</section>
				<section label="Six em high" level="4" appearance="bordered" height="6em">
					<text paragraph>Any CSS length caps the content.</text>
					<text paragraph>Line two.</text>
					<text paragraph>Line three.</text>
					<text paragraph>Line four.</text>
					<text paragraph>Line five.</text>
				</section>
			</example>
		</>

		<section label="Aligned" sticky="stack" collapsible dividing>
			<example "Aligned" description="`align` aligns the title `left`, `center` or `right`.">
				<section label="Centered title" level="4" align="center" dividing>
					<text paragraph>The content keeps its own alignment.</text>
				</section>
				<section label="Right title" level="4" align="right" dividing>
					<text paragraph>The content keeps its own alignment.</text>
				</section>
			</example>
		</>

		<section label="Basic" sticky="stack" collapsible dividing>
			<example "Basic" description="The `basic` look (`appearance`) drops every box, rule and tint, whatever else is set.">
				<section label="Basic" level="4" appearance="bordered basic" dividing>
					<text paragraph><text code>bordered</text> and <text code>dividing</text> are set, but <text code>basic</text> wins.</text>
				</section>
			</example>
		</>

		<section label="Inverted" sticky="stack" collapsible dividing>
			<example "Inverted" description="A section can use the dark scheme, for dark backgrounds.">
				<section label="Inverted" level="4" appearance="bordered" inverted>
					<text paragraph>The dark scheme.</text>
				</section>
				<section label="Inverted styled" level="4" appearance="styled" inverted collapsible>
					<text paragraph>Styled, on dark.</text>
				</section>
			</example>
		</>
	</>
</spell-notebook>
