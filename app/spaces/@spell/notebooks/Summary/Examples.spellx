<spell-notebook "summary examples">
	<header level="1">
		Summary
		<header>A summary is a feed event's main line:  who did what, and when.</>
	</>
	<summary-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#owners">Owners</>
		</>
	</>

	<!--
		EXAMPLES:  `<ui-summary>` in each owner that gives it a look (from the owners' own pages and
		`src/components/ui-parts/examples/elements/`), then its attributes.  The Content parts page
		(`ui-header.html`) shows every part together.
	-->
	<section label="Owners">
		<section label="Feed" sticky="stack" collapsible dividing>
			<example "Feed" description="A feed event's summary:  who did what, with an inline date.">
				<feed>
					<event image="../images/avatar/small/elliot.jpg">
						<content>
							<summary><author link="#elliot">Elliot Fu</author> added you as a friend <date datetime="PT1H">1 Hour Ago</date></summary>
						</content>
					</event>
					<event icon="pencil">
						<content>
							<date datetime="P3D">3 days ago</date>
							<summary>You submitted a new post to the page</summary>
						</content>
					</event>
				</feed>
			</example>
		</>
	</>
</spell-notebook>
