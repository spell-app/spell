<spell-notebook "meta examples">
	<header level="1">
		Meta
		<header>A meta holds metadata about the content, such as a date or a category.</>
	</>
	<meta-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#owners">Owners</>
		</>
	</>

	<!--
		EXAMPLES:  `<ui-meta>` in each owner that gives it a look (from the owners' own pages and
		`src/components/ui-parts/examples/elements/`), then its attributes.  The Content parts page
		(`ui-header.html`) shows every part together.
	-->
	<section label="Owners">
		<section label="Card" sticky="stack" collapsible dividing>
			<example "Card" description="A card's meta:  small and muted, under its header.">
				<card>
					<content>
						<header>Kristy</header>
						<meta>
							<text>Joined in 2013</text>
						</meta>
						<description>Kristy is an art director living in New York.</description>
					</content>
				</card>
			</example>
		</>

		<section label="Item" sticky="stack" collapsible dividing>
			<example "Item" description="An item's meta:  each piece spaced apart.">
				<items>
					<item image="../images/wireframe/image.png">
						<content>
							<header>Cute Dog</header>
							<meta>
								<text>Description</text>
								<text>Stevie</text>
							</meta>
						</content>
					</item>
				</items>
			</example>
		</>

		<section label="Feed" sticky="stack" collapsible dividing>
			<example "Feed" description="A feed event's meta:  a small line under its summary.">
				<feed>
					<event>
						<content>
							<summary><author link="#elliot">Elliot Fu</author> added you as a friend</summary>
							<meta>
								<link link="#like"><icon name="heart"/> 4 Likes</link>
							</meta>
						</content>
					</event>
				</feed>
			</example>
		</>

		<section label="Comment" sticky="stack" collapsible dividing>
			<example "Comment" description="A comment's metadata:  inline after the author.">
				<comments>
					<comment>
						<avatar src="/components/ui/images/avatar/small/matt.jpg"/>
						<content>
							<author link="#matt">Matt</author>
							<meta>
								<text>Today at 5:42PM</text>
							</meta>
							<description>How artistic!</description>
						</content>
					</comment>
				</comments>
			</example>
		</>
	</>
</spell-notebook>
