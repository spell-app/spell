<spell-notebook "table-of-contents examples">
	<header level="1">
		Table of contents
		<header>A table of contents lists the page's sections and examples as links, opens the one in view and follows the scroll;  each section folds, and one button opens or folds them all.</>
	</>
	<table-of-contents-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#content">Content</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's page, section by section, in its order (Types, Content, States, Variations,
		Groups ...).  Rules, the class-grammar mappings, gaps:  epics/spell-ui-pages/PAGES.md.
		- A section:  `<ui-section id="examples-types" label="Types" sticky="stack" collapsible dividing>` around
		  its examples;  ids spell out the nesting (`<tab>-<section>-<example>`, lowercase kebab of the headers).
		- An example:  its own nested section (`label` = the example's name) around
		  `<ui-example description="...">` and the live markup;  the markup IS the code shown.  A richer
		  description:  `<p slot="description">` (+ `<ui-message slot="description">`).  Fomantic's header-less
		  `.another.example`:  a second `<ui-example>` in the same section.
		- Or write it flat (`<ui-header level="2">`, `<ui-example heading>`) and run `yarn site:sections`:
		  it nests it and writes the ids (and fixes them after a title changes).
		- A gap:  an HTML comment `GAP I<n>:  ...` BEFORE the example's section (a comment inside the example
		  shows in its code).
	-->
	<section label="Types">
		<section label="Table of contents" sticky="stack" collapsible dividing>
			<example "Table of contents" description="A table of contents lists the sections it follows (`for`, else the page's `main`) as links:  level 2 headings and top-level `<ui-section>`s, with their examples and level 3 headings under them.  The section in view is lit, and opens.">
				<stack direction="horizontal" align="start" spacing="lg">
					<toc for="toc-demo-release" heading="Release notes" style="width: 14em"/>
					<section style="flex: 1" id="toc-demo-release">
						<header level="2">Components</header>
						<header level="3">Zoom</header>
						<text paragraph>Anything shown small, then full size.</text>
						<header level="3">Stack</header>
						<text paragraph>One gap between its children, in a row or a column.</text>
						<header level="2">Fixes</header>
						<header level="3">Menus</header>
						<text paragraph>Titles fit the menu's width.</text>
					</section>
				</stack>
			</example>
		</>

		<section label="Examples" sticky="stack" collapsible dividing>
			<example "Examples" description="A `<ui-example heading>` is an entry of the section it's in:  a components page's contents list every example.">
				<html>
					<ui-stack direction="horizontal" align="start" spacing="lg">
						<ui-toc for="toc-demo-button" heading="Button" style="width: 14em"></ui-toc>
						<ui-section style="flex: 1" id="toc-demo-button">
							<ui-header level="2">Types</ui-header>
							<ui-example heading="Button" description="A standard button.">
								<ui-button>Follow</ui-button>
							</ui-example>
							<ui-example heading="Emphasis" description="A button can show different levels of emphasis.">
								<ui-button color="primary">Save</ui-button>
							</ui-example>
							<ui-header level="2">States</ui-header>
							<ui-example heading="Disabled" description="A button can't be used.">
								<ui-button disabled>Followed</ui-button>
							</ui-example>
						</ui-section>
					</ui-stack>
				</html>
			</example>
		</>
	</>

	<section label="Content">
		<section label="Heading" sticky="stack" collapsible dividing>
			<example "Heading" description="`heading`:  a title above the links, e.g. the page's name.  Without it, the toggle sits alone in the header row.">
				<stack direction="horizontal" align="start" spacing="lg">
					<toc for="toc-demo-heading" style="width: 14em"/>
					<section style="flex: 1" id="toc-demo-heading">
						<section id="toc-demo-setup" label="Setup">
							<section id="toc-demo-install" label="Install">
								<text paragraph>One line.</text>
							</section>
							<section id="toc-demo-import" label="Import">
								<text paragraph>One more.</text>
							</section>
						</section>
						<section id="toc-demo-use" label="Use">
							<text paragraph>And off you go.</text>
						</section>
					</section>
				</stack>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Expanded" sticky="stack" collapsible dividing>
			<example "Expanded" description="`expanded`:  every section's entries show, not only the one in view's.  The viewer's own folds, and the header's toggle, still win.">
				<stack direction="horizontal" align="start" spacing="lg">
					<toc for="toc-demo-expanded" heading="Guide" expanded style="width: 14em"/>
					<section style="flex: 1" id="toc-demo-expanded">
						<header level="2">Start</header>
						<header level="3">Install</header>
						<header level="3">First page</header>
						<header level="2">Go further</header>
						<header level="3">Themes</header>
						<header level="3">Spanish</header>
					</section>
				</stack>
			</example>
		</>

		<section label="Size" sticky="stack" collapsible dividing>
			<example "Size" description="`size`:  `mini` ... `massive`;  `small` by default.">
				<stack direction="horizontal" align="start" spacing="lg">
					<toc for="toc-demo-size" heading="Large" size="large" expanded style="width: 14em"/>
					<section style="flex: 1" id="toc-demo-size">
						<header level="2">One</header>
						<header level="3">One and a half</header>
						<header level="2">Two</header>
					</section>
				</stack>
			</example>
		</>
	</>
</spell-notebook>
