<spell-notebook "image examples">
	<header level="1">
		Image
		<header>An image is a graphic representation of something.</>
	</>
	<image-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#states">States</>
			<item link="#variations">Variations</>
			<item link="#groups">Groups</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's image page, in its order (Types, States, Variations, Groups), plus our own extras (Inline,
		group variations).
	-->
	<section label="Types">
		<!-- GAP I56:  `size="medium"` is the natural size, not Fomantic's 300px;  the page uses `size="large"` (450px) where Fomantic says medium. -->
		<!-- GAP I87:  Fomantic's 2nd and 3rd blocks wrap an <img> / an <svg> in `ui image`;  <ui-image> has no slot. -->
		<section label="Image" sticky="stack" collapsible dividing>
			<example "Image" description="An image.">
				<message slot="description" size="small">Unless a size is specified, images will use the original dimensions of the image up to the size of its container.</message>
				<message slot="description" state="info" size="small"><text code>&lt;ui-image&gt;</text> renders a real <text code>&lt;img&gt;</text>, so the image attributes work as on the native element:  src, alt, width, height and loading.</message>
				<image size="small" src="/components/ui/images/wireframe/image.png" alt=""/>
			</example>
		</>

		<section label="Image Link" sticky="stack" collapsible dividing>
			<example "Image Link" description="An image can be formatted to link to other content:  `link`.">
				<image size="large" link="#image-link" src="/components/ui/images/wireframe/image-text.png" alt="Image link"/>
			</example>
		</>

		<section label="Figure" sticky="stack" collapsible dividing>
			<example "Figure" description="`caption` puts a caption under the picture:  the image becomes a figure (`<figure>`, `<figcaption>`), the caption no wider than the picture.  The `caption` slot is its rich version.">
				<image size="medium" src="/components/ui/images/wireframe/image.png" alt="A wireframe picture" caption="A wireframe stands in for a picture while a page is planned."/>
			</example>
		</>

		<section label="Zoom" sticky="stack" collapsible dividing>
			<example "Zoom" description="`zoom`:  a click (or Enter) shows it full size over the page, its alt text under it;  Escape closes it.  The page's one `<a href=\"ui-zoom.html\"><ui-zoom></a>` shows it.">
				<image zoom size="small" src="/components/ui/images/hello-light.png" alt="Hello, in the light theme"/>
			</example>
		</>
	</>

	<section label="States">
		<section label="Hidden" sticky="stack" collapsible dividing>
			<example "Hidden" description="An image can be hidden:  the native `hidden` attribute (the box keeps no space).">
				<image hidden src="/components/ui/images/wireframe/image.png" alt=""/>
			</example>
		</>

		<section label="Disabled" sticky="stack" collapsible dividing>
			<example "Disabled" description="An image can show that it is disabled and cannot be selected.">
				<image disabled size="large" src="/components/ui/images/wireframe/image.png" alt=""/>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Avatar" sticky="stack" collapsible dividing>
			<example "Avatar" description="An image may be formatted to appear inline with text as an avatar.">
				<image avatar src="/components/ui/images/wireframe/square-image.png" alt=""/>
				<text>Username</text>
			</example>
		</>

		<section label="Bordered" sticky="stack" collapsible dividing>
			<example "Bordered" description="An image may include a border to emphasize the edges of white or transparent content.">
				<image size="large" src="/components/ui/images/wireframe/white-image.png" alt="" appearance="bordered"/>
			</example>
		</>

		<section label="Fluid" sticky="stack" collapsible dividing>
			<example "Fluid" description="An image can take up the width of its container.">
				<image fluid src="/components/ui/images/wireframe/image.png" alt=""/>
			</example>
		</>

		<section label="Rounded" sticky="stack" collapsible dividing>
			<example "Rounded" description="An image may appear rounded.">
				<image size="large" src="/components/ui/images/wireframe/square-image.png" alt="" appearance="rounded"/>
			</example>
		</>

		<section label="Circular" sticky="stack" collapsible dividing>
			<example "Circular" description="An image may appear circular.">
				<image size="large" src="/components/ui/images/wireframe/square-image.png" alt="" appearance="circular"/>
			</example>
		</>

		<section label="Vertically Aligned" sticky collapsible dividing>
			<example "Vertically Aligned" description="An image can specify its vertical alignment:  `vertical-align` is `top`, `middle` or `bottom`.">
				<image vertical-align="top" size="tiny" src="/components/ui/images/wireframe/square-image.png" alt=""/>
				<text>Top Aligned</text>
				<divider/>
				<image vertical-align="middle" size="tiny" src="/components/ui/images/wireframe/square-image.png" alt=""/>
				<text>Middle Aligned</text>
				<divider/>
				<image vertical-align="bottom" size="tiny" src="/components/ui/images/wireframe/square-image.png" alt=""/>
				<text>Bottom Aligned</text>
			</example>
		</>

		<section label="Centered" sticky="stack" collapsible dividing>
			<example "Centered" description="An image can appear centered in a content block.">
				<segment>
					<image align="center" size="large" src="/components/ui/images/wireframe/image.png" alt=""/>
					<text paragraph>Te eum doming eirmod, nominati pertinacia argumentum ad his. Ex eam alia facete scriptorem, est autem aliquip detraxit at. Usu ocurreret referrentur at, cu epicurei appellantur vix. Cum ea laoreet recteque electram, eos choro alterum definiebas in. Vim dolorum definiebas an. Mei ex natum rebum iisque.</text>
					<text paragraph>Audiam quaerendum eu sea, pro omittam definiebas ex. Te est latine definitiones. Quot wisi nulla ex duo. Vis sint solet expetenda ne, his te phaedrum referrentur consectetuer. Id vix fabulas oporteat, ei quo vide phaedrum, vim vivendum maiestatis in.</text>
					<image align="center" size="small" src="/components/ui/images/wireframe/text-image.png" alt=""/>
					<text paragraph>Eu quo homero blandit intellegebat. Incorrupte consequuntur mei id. Mei ut facer dolores adolescens, no illum aperiri quo, usu odio brute at. Qui te porro electram, ea dico facete utroque quo. Populo quodsi te eam, wisi everti eos ex, eum elitr altera utamur at. Quodsi convenire mnesarchum eu per, quas minimum postulant per id.</text>
				</segment>
			</example>
		</>

		<section label="Spaced" sticky="stack" collapsible dividing>
			<example "Spaced" description="An image can specify that it needs an additional spacing to separate it from nearby content.">
				<segment>
					<text paragraph>Te eum doming eirmod, nominati pertinacia <image size="mini" spacing="md" src="/components/ui/images/wireframe/image.png" alt=""/> argumentum ad his. Ex eam alia facete scriptorem, est autem aliquip detraxit at. Usu ocurreret referrentur at, cu epicurei appellantur vix. Cum ea laoreet recteque electram, eos choro alterum definiebas in. Vim dolorum definiebas an. Mei ex natum rebum iisque.</text>
				</segment>
			</example>
			<example "Spaced" description="`spaced=\"left\"` or `spaced=\"right\"` adds the room on one side only.">
				<text paragraph><image size="mini" spacing="right" src="/components/ui/images/wireframe/image.png" alt=""/>Audiam quaerendum eu sea, pro omittam definiebas ex. Te est latine definitiones. Quot wisi nulla ex duo. Vis sint solet expetenda ne, his te phaedrum referrentur consectetuer.</text>
				<text paragraph>Eu quo homero blandit intellegebat. Incorrupte consequuntur mei id. Mei ut facer dolores adolescens, no illum aperiri quo, usu odio brute at. Qui te porro electram, ea dico facete utroque quo.<image size="mini" spacing="left" src="/components/ui/images/wireframe/image.png" alt=""/></text>
			</example>
		</>

		<section label="Floated" sticky="stack" collapsible dividing>
			<example "Floated" description="An image can sit to the left or right of other content.">
				<segment>
					<image size="small" floated="left" src="/components/ui/images/wireframe/text-image.png" alt=""/>
					<text paragraph>Te eum doming eirmod, nominati pertinacia argumentum ad his. Ex eam alia facete scriptorem, est autem aliquip detraxit at. Usu ocurreret referrentur at, cu epicurei appellantur vix. Cum ea laoreet recteque electram, eos choro alterum definiebas in. Vim dolorum definiebas an. Mei ex natum rebum iisque.</text>
					<image size="small" floated="right" src="/components/ui/images/wireframe/text-image.png" alt=""/>
					<text paragraph>Audiam quaerendum eu sea, pro omittam definiebas ex. Te est latine definitiones. Quot wisi nulla ex duo. Vis sint solet expetenda ne, his te phaedrum referrentur consectetuer. Id vix fabulas oporteat, ei quo vide phaedrum, vim vivendum maiestatis in.</text>
					<text paragraph>Eu quo homero blandit intellegebat. Incorrupte consequuntur mei id. Mei ut facer dolores adolescens, no illum aperiri quo, usu odio brute at. Qui te porro electram, ea dico facete utroque quo. Populo quodsi te eam, wisi everti eos ex, eum elitr altera utamur at. Quodsi convenire mnesarchum eu per, quas minimum postulant per id.</text>
				</segment>
			</example>
		</>

		<section label="Size" sticky="stack" collapsible dividing>
			<example "Size" description="An image may appear at different sizes.">
				<message slot="description" state="warning" size="small"><text code>medium</text> is the image's natural size here, not Fomantic's 300px (I56): elsewhere on this page the medium images are <text code>size="large"</text> (450px).</message>
				<message slot="description" state="info" size="small">Fomantic's default widths for <text code>mini</text> ... <text code>massive</text> are arbitrary. Set the ones your project uses in the <text code>--ui-image-width-*</text> tokens (Theming tab).</message>
				<table slot="description" definition padding="compact" unstackable>
					<row header>
						<cell>Size</cell>
						<cell>Width</cell>
					</row>
					<row>
						<cell>mini</cell>
						<cell>35px</cell>
					</row>
					<row>
						<cell>tiny</cell>
						<cell>80px</cell>
					</row>
					<row>
						<cell>small</cell>
						<cell>150px</cell>
					</row>
					<row>
						<cell>medium</cell>
						<cell>natural size (Fomantic: 300px)</cell>
					</row>
					<row>
						<cell>large</cell>
						<cell>450px</cell>
					</row>
					<row>
						<cell>big</cell>
						<cell>600px</cell>
					</row>
					<row>
						<cell>huge</cell>
						<cell>800px</cell>
					</row>
					<row>
						<cell>massive</cell>
						<cell>960px</cell>
					</row>
				</table>
				<image size="mini" src="/components/ui/images/wireframe/image.png" alt=""/>
				<divider spacer/>
				<image size="tiny" src="/components/ui/images/wireframe/image.png" alt=""/>
				<divider spacer/>
				<image size="small" src="/components/ui/images/wireframe/image.png" alt=""/>
				<divider spacer/>
				<image size="medium" src="/components/ui/images/wireframe/image.png" alt=""/>
			</example>
		</>
	</>

	<section label="Groups">
		<section label="Size" sticky="stack" collapsible dividing>
			<example "Size" description="A group of images can be formatted to have the same size:  `<ui-images size>`.">
				<images size="tiny">
					<image src="/components/ui/images/wireframe/image.png" alt=""/>
					<image src="/components/ui/images/wireframe/image.png" alt=""/>
					<image src="/components/ui/images/wireframe/image.png" alt=""/>
					<image src="/components/ui/images/wireframe/image.png" alt=""/>
				</images>
			</example>
			<example "Size" description="Plain `<img>`s in a group take the group's look too.">
				<images size="small">
					<image alt="" src="/components/ui/images/wireframe/image.png"/>
					<image alt="" src="/components/ui/images/wireframe/image.png"/>
					<image alt="" src="/components/ui/images/wireframe/image.png"/>
					<image alt="" src="/components/ui/images/wireframe/image.png"/>
				</images>
			</example>
		</>

		<section label="Group variations" sticky="stack" collapsible dividing>
			<example "Group variations" description="A group shares its shape, border and alignment with every image in it:  `avatar`, `circular`, `rounded`, `bordered`, `centered` ...">
				<images avatar>
					<image src="/components/ui/images/wireframe/square-image.png" alt=""/>
					<image src="/components/ui/images/wireframe/square-image.png" alt=""/>
					<image src="/components/ui/images/wireframe/square-image.png" alt=""/>
				</images>
				<divider spacer/>
				<images size="tiny" align="center" appearance="circular">
					<image src="/components/ui/images/wireframe/square-image.png" alt=""/>
					<image src="/components/ui/images/wireframe/square-image.png" alt=""/>
					<image src="/components/ui/images/wireframe/square-image.png" alt=""/>
				</images>
			</example>
		</>
	</>
</spell-notebook>
