<spell-notebook "theme-menu examples">
	<header level="1">
		Theme Menu
		<header>A theme menu picks the page's theme from Spell's own, and its light, dark or system colour scheme, and remembers both for the next page.</>
	</>
	<theme-menu-tab-bar showing="examples"/>
	<section>
		<html>
			<ui-menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
				<ui-item link="#types">Types</>
				<ui-item link="#variations">Variations</>
			</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's page, section by section, in its order (Types, Content, States, Variations,
		Groups ...).  Rules, the class-grammar mappings, gaps:  epics/spell-ui-pages/PAGES.md.
		- A section:  `<ui-section id="examples-types" label="Types" sticky collapsible dividing>` around
		  its examples;  ids spell out the nesting (`<tab>-<section>-<example>`, lowercase kebab of the headers).
		- An example:  its own nested section (`label` = the example's name) around
		  `<ui-example description="...">` and the live markup;  the markup IS the code shown.  A richer
		  description:  `<p slot="description">` (+ `<ui-message slot="description">`).  Fomantic's header-less
		  `.another.example`:  a second `<ui-example>` in the same section.
		- Or write it flat (`<ui-header level="2">`, `<ui-example heading>`) and run `yarn site:sections`:
		  it nests it and writes the ids (and fixes them after a title changes).
		- A gap:  an HTML comment `GAP I<n>:  ...` BEFORE the example's section (a comment inside the example
		  shows in its code).
	-->
	<section label="Types">
		<section label="Palette" sticky collapsible dividing>
			<example description="One round palette button:  its panel picks light, dark or Auto, and one of Spell's themes.  The page remembers both.">
				<theme-menu/>
			</example>
		</>

		<section label="Theme dropdown" sticky collapsible dividing>
			<example description="A theme dropdown, for a masthead:  `show=\"theme\"`;  `compact` makes it an icon button.">
				<theme-menu show="theme"/>
			</example>
		</>

		<section label="Light / dark only" sticky collapsible dividing>
			<example description="A sun or a moon alone:  `show=\"scheme\"`.  A click flips the page between light and dark.">
				<theme-menu show="scheme"/>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Inverted" sticky collapsible dividing>
			<example description="On a dark bar:  `inverted`, here at `size=\"small\"`.">
				<segment inverted>
					<theme-menu inverted size="small"/>
				</segment>
			</example>
		</>
	</>
</spell-notebook>
