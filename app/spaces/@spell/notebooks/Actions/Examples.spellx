<spell-notebook "actions examples">
	<header level="1">
		Actions
		<header>Actions hold what a user can do next:  a comment's reply links, a modal's or toast's buttons.</>
	</>
	<actions-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#owners">Owners</>
			<item link="#standalone">Standalone</>
		</>
	</>

	<!--
		EXAMPLES:  `<ui-actions>` in each owner that gives it a look (from the owners' own pages and
		`src/components/ui-parts/examples/elements/`), then its attributes.  The Content parts page
		(`ui-header.html`) shows every part together.
	-->
	<section label="Owners">
		<section label="Comment" sticky="stack" collapsible dividing>
			<example "Comment" description="A comment's actions:  a row of small links under its text.">
				<comments>
					<comment>
						<avatar src="/components/ui/images/avatar/small/joe.jpg"/>
						<content>
							<author link="#joe">Joe Henderson</author>
							<description>Dude, this is awesome. Thanks so much</description>
							<actions>
								<link link="#reply">Reply</link>
								<link link="#save">Save</link>
								<link link="#hide">Hide</link>
							</actions>
						</content>
					</comment>
				</comments>
			</example>
		</>

		<section label="Modal" sticky="stack" collapsible dividing>
			<example "Modal" description="A modal's actions:  its footer, buttons on the right;  `approve` and `deny` close it.">
				<button commandfor="actions-modal" command="--show">Show</button>
				<modal id="actions-modal" size="small" closable>
					<header>Delete Your Account</header>
					<content>
						<text paragraph>Are you sure you want to delete your account?</text>
					</content>
					<actions>
						<button class="deny" color="negative">No</button>
						<button class="approve" color="positive">Yes</button>
					</actions>
				</modal>
			</example>
		</>
	</>

	<section label="Standalone">
		<section label="No owner" sticky="stack" collapsible dividing>
			<example "No owner" description="Outside an owner, `<ui-actions>` is an unstyled block.">
				<actions>
					<button size="small">OK</button>
				</actions>
			</example>
		</>
	</>
</spell-notebook>
