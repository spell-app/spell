<spell-notebook "author examples">
	<header level="1">
		Author
		<header>An author names who wrote a comment or did a feed event.</>
	</>
	<author-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#owners">Owners</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  `<ui-author>` in each owner that gives it a look (from the owners' own pages and
		`src/components/ui-parts/examples/elements/`), then its attributes.  The Content parts page
		(`ui-header.html`) shows every part together.
	-->
	<section label="Owners">
		<section label="Comment" sticky="stack" collapsible dividing>
			<example "Comment" description="A comment's author, before its metadata.">
				<comments>
					<comment>
						<avatar src="/components/ui/images/avatar/small/matt.jpg"/>
						<content>
							<author link="#matt">Matt</author>
							<meta>
								<text>Today at 5:42PM</text>
							</meta>
							<description>How artistic!</description>
						</content>
					</comment>
				</comments>
			</example>
		</>

		<section label="Feed" sticky="stack" collapsible dividing>
			<example "Feed" description="A feed event's user, inline in its summary.">
				<feed>
					<event>
						<content>
							<summary><author link="#elliot">Elliot Fu</author> added you as a friend</summary>
						</content>
					</event>
				</feed>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Link" sticky="stack" collapsible dividing>
			<example "Link" description="With `link`, an author is a real link;  without, plain text.">
				<comments>
					<comment>
						<content>
							<author link="#stevie">Stevie Feliciano</author>
							<description>A linked author.</description>
						</content>
					</comment>
					<comment>
						<content>
							<author>Anonymous</author>
							<description>A plain author.</description>
						</content>
					</comment>
				</comments>
			</example>
		</>
	</>
</spell-notebook>
