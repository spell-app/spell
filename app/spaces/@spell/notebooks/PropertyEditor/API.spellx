<spell-notebook "property-editor api">
	<header level="1">
		Property Editor
		<header>A property editor draws a form from a schema:  one field per property, in groups that open and close, for one thing or many.</>
	</>
	<property-editor-tab-bar showing="api"/>
	<section>
		<html>
			<ui-menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
