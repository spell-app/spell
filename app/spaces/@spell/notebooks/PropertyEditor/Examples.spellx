<spell-notebook "property-editor examples">
	<header level="1">
		Property Editor
		<header>A property editor draws a form from a schema:  one field per property, in groups that open and close, for one thing or many.</>
	</>
	<property-editor-tab-bar showing="examples"/>
	<section>
		<html>
			<ui-menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
				<ui-item link="#types">Types</>
				<ui-item link="#pages">Pages</>
				<ui-item link="#binding">Binding</>
			</>
		</>
	</>

	<!--
		EXAMPLES:  ours, no Fomantic page (epic `property-editor` P4).
		- Each editor's `schema` and `value` are JSON attributes:  no script.
	-->
	<section label="Types">
		<section label="From a schema" sticky collapsible dividing>
			<example description="An empty editor draws one property per attribute of its `schema`, each with the control its type calls for, bound to `value`.  Type, tick, and watch the Bound object box.">
				<html>
					<ui-property-editor debug style="max-width: 360px" schema="{\"name\": \"Theme\", \"attributes\": \[
                      {\"name\": \"title\", \"kind\": \"string\", \"type\": \"text\", \"description\": \"\", \"tip\": \"Shown in the theme list.\"},
                      {\"name\": \"size\", \"kind\": \"enum\", \"type\": \"choice\", \"values\": \[\"sm\", \"md\", \"lg\"], \"description\": \"\"},
                      {\"name\": \"dark\", \"kind\": \"boolean\", \"type\": \"boolean\", \"description\": \"\"}
                    ]}" value="{\"title\": \"Sunrise\", \"size\": \"md\", \"dark\": false}"></ui-property-editor>
				</html>
			</example>
		</>

		<section label="Laid out" sticky collapsible dividing>
			<example description="Lay it out with `<ui-property-group>`s and `<ui-property>`s.  Groups open and close, `as` picks a control, and `hint` goes under it;  a dotted `name` reaches into a nested thing.  The title is `label`, which draws a section around it.">
				<html>
					<ui-property-editor label="Theme" style="max-width: 360px" schema="{\"name\": \"Theme\", \"attributes\": \[
                      {\"name\": \"title\", \"kind\": \"string\", \"type\": \"text\", \"description\": \"\"},
                      {\"name\": \"corners\", \"kind\": \"enum\", \"type\": \"choice\", \"values\": \[\"sharp\", \"soft\", \"round\"], \"description\": \"\"},
                      {\"name\": \"font\", \"kind\": \"json\", \"type\": \"thing\", \"description\": \"\", \"attributesOf\": \[
                        {\"name\": \"family\", \"kind\": \"string\", \"type\": \"text\", \"description\": \"\", \"label\": \"Font family\"}
                      ]}
                    ]}" value="{\"title\": \"Sunrise\", \"corners\": \"soft\", \"font\": {\"family\": \"Inter\"}}">
						<ui-property name="title" hint="Used for the file name."></ui-property>
						<ui-property-group label="Shape" collapsible>
							<ui-property name="corners" as="buttons"></ui-property>
						</ui-property-group>
						<ui-property-group label="Type" collapsible>
							<ui-property name="font.family"></ui-property>
						</ui-property-group>
					</ui-property-editor>
				</html>
			</example>
		</>

		<section label="Rules" sticky collapsible dividing>
			<example description="A schema's `rules` are checked as you leave each field (`validate=\"on leave\"`), each with its own message when it has one.  A spell type's rules arrive in this shape:  `- its version must match \"^\\d+\\.\\d+\\.\\d+$\", with suggestion \"Write it like 1.2.3\"`.  Clear the name, or type a letter into the version.">
				<html>
					<ui-property-editor label="Release" validate="on leave" style="max-width: 360px" schema="{\"name\": \"Release\", \"attributes\": \[
                      {\"name\": \"name\", \"kind\": \"string\", \"type\": \"text\", \"description\": \"\", \"rules\": \[{\"type\": \"empty\"}]},
                      {\"name\": \"version\", \"kind\": \"string\", \"type\": \"text\", \"description\": \"\", \"rules\": \[
                        {\"type\": \"regExp\", \"value\": \"/^\\\\d+\\\\.\\\\d+\\\\.\\\\d+$/\", \"prompt\": \"Write it like 1.2.3\"}
                      ]},
                      {\"name\": \"stars\", \"kind\": \"number\", \"type\": \"number\", \"description\": \"\", \"rules\": \[{\"type\": \"range\", \"value\": \"1..5\"}]}
                    ]}" value="{\"name\": \"Sunrise\", \"version\": \"1.0.0\", \"stars\": 4}"></ui-property-editor>
				</html>
			</example>
		</>
	</>

	<section label="Pages">
		<section label="From a page" sticky collapsible dividing>
			<example description="`source` loads the layout from a saved page, `Theme.editor.html`:  plain markup, its groups and properties, which the page holds instead of the editor.  `select` would take only part of it.">
				<html>
					<ui-property-editor source="/components/ui/examples/Theme.editor.html" style="max-width: 360px" schema="{\"name\": \"Theme\", \"attributes\": \[
                      {\"name\": \"title\", \"kind\": \"string\", \"type\": \"text\", \"description\": \"\"},
                      {\"name\": \"size\", \"kind\": \"enum\", \"type\": \"choice\", \"values\": \[\"sm\", \"md\", \"lg\"], \"description\": \"\"},
                      {\"name\": \"dark\", \"kind\": \"boolean\", \"type\": \"boolean\", \"description\": \"\"}
                    ]}" value="{\"title\": \"Sunrise\", \"size\": \"md\", \"dark\": true}"></ui-property-editor>
				</html>
			</example>
		</>
	</>

	<section label="Binding">
		<section label="Save and Cancel" sticky collapsible dividing>
			<example description="`apply=\"on save\"` holds every edit until Save;  Cancel drops them.  A property holding an edit has `:state(changed)`.">
				<html>
					<ui-property-editor label="Project" apply="on save" debug style="max-width: 360px" schema="{\"name\": \"Project\", \"attributes\": \[
                      {\"name\": \"title\", \"kind\": \"string\", \"type\": \"text\", \"description\": \"\"},
                      {\"name\": \"version\", \"kind\": \"number\", \"type\": \"number\", \"min\": 1, \"description\": \"\"}
                    ]}" value="{\"title\": \"Solitaire\", \"version\": 1}"></ui-property-editor>
				</html>
			</example>
		</>

		<section label="Many things" sticky collapsible dividing>
			<example description="A list as `value` edits every thing in it:  a property shows the value they agree on, else blank and Mixed.  A write sets all of them.">
				<html>
					<ui-property-editor debug style="max-width: 360px" schema="{\"name\": \"Theme\", \"attributes\": \[
                      {\"name\": \"size\", \"kind\": \"string\", \"type\": \"text\", \"description\": \"\"},
                      {\"name\": \"font\", \"kind\": \"string\", \"type\": \"text\", \"description\": \"\"}
                    ]}" value="\[{\"size\": \"md\", \"font\": \"Inter\"}, {\"size\": \"md\", \"font\": \"Lora\"}]"></ui-property-editor>
				</html>
			</example>
		</>
	</>
</spell-notebook>
