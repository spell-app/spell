<spell-notebook "item api">
	<header level="1">
		Item
		<header>One item for dropdowns, lists and menus, rendered by whatever holds it.</>
	</>
	<item-tab-bar showing="api"/>
	<section>
		<html>
			<ui-menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
				<ui-item link="#attributes">Attributes</>
				<ui-item link="#slots">Slots</>
				<ui-item link="#parts">Parts</>
				<ui-item link="#states">States</>
			</>
		</>
	</>

	<!-- API:  generated from the vocabularies (`docs/__data/components.json5`);  nothing to write. -->
	<section label="Attributes">
		<html>
			<ui-docs-api family="ui-item" only="attributes"></>
		</>
	</>

	<section label="Slots">
		<html>
			<ui-docs-api family="ui-item" only="slots"></>
		</>
	</>

	<section label="Parts">
		<html>
			<ui-docs-api family="ui-item" only="parts"></>
		</>
	</>

	<section label="States">
		<html>
			<ui-docs-api family="ui-item" only="states"></>
		</>
	</>
</spell-notebook>
