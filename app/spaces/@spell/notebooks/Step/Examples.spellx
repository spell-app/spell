<spell-notebook "step examples">
	<header level="1">
		Step
		<header>A step shows the completion status of an activity in a series of activities.</>
	</>
	<step-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#groups">Groups</>
			<item link="#content">Content</>
			<item link="#states">States</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's step page, section by section, in its order (Types, Groups, Content, States, Variations).
		- Fomantic's `.title` / `.description` => the `header` / `description` shorthands, or `<ui-title>` /
		  `<ui-description>` in a `<ui-content>` where the content needs an alignment or an icon in the title.
		- Fomantic's `active` step => `selected` (`active` is accepted too).
		- The site's root says `stack-with="page"`:  steps stack below 768px of the SCREEN, as Fomantic's.
		- Generated by the page agent's `gen_step.py` (scratchpad);  edit the HTML directly from now on.
	-->
	<section label="Types">
		<section label="Step" sticky="stack" collapsible dividing>
			<example description="A single step.">
				<steps>
					<step>Shipping</step>
				</steps>
			</example>
		</>

		<section label="Circular Step" sticky="stack" collapsible dividing>
			<example description="A single circular step.">
				<steps appearance="circular">
					<step>
						<content align="center">
							<title>Shipping</title>
						</content>
					</step>
				</steps>
			</example>
		</>
	</>

	<section label="Groups">
		<section label="Steps" sticky="stack" collapsible dividing>
			<example description="A set of steps: `<ui-steps>`.">
				<message slot="description" state="positive" size="small" icon="mobile" heading="Responsive Element"><html>Steps will automatically stack on mobile. To make steps automatically stack for tablet use <code>stackable="tablet"</code>.</html></message>
				<steps>
					<step icon="truck" heading="Shipping" description="Choose your shipping options"/>
					<step selected icon="payment" heading="Billing" description="Enter billing information"/>
					<step disabled icon="info" heading="Confirm Order"/>
				</steps>
			</example>
		</>

		<section label="Flat markup" sticky="stack" collapsible dividing>
			<example description="A step can be written outside its steps:  `parent` names the steps' id, and the step joins them, in page order, as if it were nested there.">
				<steps id="demo-order-steps" ordered/>
				<step parent="demo-order-steps" completed heading="Shipping"/>
				<step parent="demo-order-steps" selected heading="Billing"/>
				<step parent="demo-order-steps" heading="Confirm"/>
			</example>
		</>

		<section label="Circular Steps" sticky="stack" collapsible dividing>
			<example description="Circular steps show a series of steps with a connection line between them.">
				<steps appearance="circular" stackable>
					<step>
						<content>
							<title><icon name="truck"/> Shipping</title>
							<description>Choose your shipping options</description>
						</content>
					</step>
					<step selected>
						<content>
							<title><icon name="payment"/> Billing</title>
							<description>Enter billing information</description>
						</content>
					</step>
					<step disabled>
						<content align="center">
							<title><icon name="info"/> Confirm Order</title>
						</content>
					</step>
				</steps>
			</example>
		</>

		<section label="Ordered" sticky="stack" collapsible dividing>
			<example description="A step can show an ordered sequence of steps.">
				<steps ordered>
					<step completed heading="Shipping" description="Choose your shipping options"/>
					<step completed heading="Billing" description="Enter billing information"/>
					<step selected heading="Confirm" description="Verify order details"/>
					<step heading="Transfer" description="Package on its way"/>
					<step heading="Delivered" description="Package received"/>
				</steps>
			</example>
			<example>
				<steps appearance="circular" ordered stackable>
					<step completed heading="Shipping" description="Choose your shipping options"/>
					<step completed heading="Billing" description="Enter billing information"/>
					<step selected heading="Confirm" description="Verify order details"/>
					<step heading="Transfer" description="Package on its way"/>
					<step heading="Delivered" description="Package received"/>
				</steps>
			</example>
		</>

		<section label="Vertical" sticky="stack" collapsible dividing>
			<example description="A step can be displayed stacked vertically.">
				<steps direction="vertical">
					<step completed icon="truck" heading="Shipping" description="Choose your shipping options"/>
					<step completed icon="credit card" heading="Billing" description="Enter billing information"/>
					<step selected icon="info" heading="Confirm Order" description="Verify order details"/>
				</steps>
			</example>
			<example description="Right vertical steps will show the active arrow to the left:  `vertical=\"right\"`.">
				<steps direction="vertical-right">
					<step completed icon="truck" heading="Shipping" description="Choose your shipping options"/>
					<step completed icon="credit card" heading="Billing" description="Enter billing information"/>
					<step selected icon="info" heading="Confirm Order" description="Verify order details"/>
				</steps>
			</example>
		</>

		<section label="Vertical Circular" sticky="stack" collapsible dividing>
			<example description="Vertical circular steps show a series of steps with the connection line between them vertically next to the title and description of each step, similar to a connected feed.">
				<steps appearance="circular" direction="vertical">
					<step completed heading="Shipping" description="Choose your shipping options"/>
					<step completed heading="Billing" description="Enter billing information"/>
					<step selected heading="Confirm Order" description="Verify order details"/>
				</steps>
			</example>
		</>
	</>

	<section label="Content">
		<section label="Description" sticky="stack" collapsible dividing>
			<example description="A step can contain a description.">
				<steps>
					<step heading="Shipping" description="Choose your shipping options"/>
				</steps>
			</example>
			<example description="The parts work too:  a `<ui-content>` with a `<ui-title>` and a `<ui-description>`.">
				<steps appearance="circular">
					<step>
						<content>
							<title>Shipping</title>
							<description>Choose your shipping options</description>
						</content>
					</step>
				</steps>
			</example>
		</>

		<!-- GAP I88:  `text-align` / `vertical-align` on a circular step's content change nothing yet. -->
		<section label="Center Aligned" sticky="stack" collapsible dividing>
			<example description="Horizontal circular steps can show their title center aligned next to the connection line.  The last step will not show the connection line anymore.">
				<steps appearance="circular">
					<step>
						<content align="center">
							<title>Shipping</title>
						</content>
					</step>
					<step>
						<content align="center">
							<title>Billing</title>
						</content>
					</step>
				</steps>
			</example>
		</>

		<section label="Bottom Aligned" sticky="stack" collapsible dividing>
			<example description="Horizontal circular steps can also show their title and/or description under the connection line.">
				<steps appearance="circular">
					<step>
						<content vertical-align="bottom">
							<title>Shipping</title>
							<description>Choose your shipping options</description>
						</content>
					</step>
					<step>
						<content vertical-align="bottom">
							<title>Billing</title>
							<description>Enter billing information</description>
						</content>
					</step>
				</steps>
			</example>
		</>

		<section label="Icon" sticky="stack" collapsible dividing>
			<example description="A step can contain an icon.">
				<steps>
					<step icon="truck" heading="Shipping" description="Choose your shipping options"/>
				</steps>
			</example>
			<example description="Icons in circular steps are part of the title or description.">
				<steps appearance="circular">
					<step>
						<content>
							<title><icon name="truck"/> Shipping</title>
							<description>Choose your shipping options</description>
						</content>
					</step>
				</steps>
			</example>
		</>

		<section label="Link" sticky="stack" collapsible dividing>
			<example description="A step can link with `link` (a real link), or with `appearance=\"link\"` (a button the page handles).">
				<steps>
					<step link="#link" selected icon="truck" heading="Shipping" description="Choose your shipping options"/>
					<step link="#link" heading="Billing" description="Enter billing information"/>
				</steps>
			</example>
			<example>
				<steps>
					<step appearance="link" icon="truck" heading="Shipping" description="Choose your shipping options"/>
					<step appearance="link" heading="Billing" description="Enter billing information"/>
				</steps>
			</example>
			<example>
				<steps appearance="circular">
					<step link="#link" selected heading="Shipping" description="Choose your shipping options"/>
					<step link="#link" heading="Billing" description="Enter billing information"/>
				</steps>
			</example>
			<example>
				<steps appearance="circular">
					<step appearance="link" heading="Shipping" description="Choose your shipping options"/>
					<step appearance="link" heading="Billing" description="Enter billing information"/>
				</steps>
			</example>
		</>
	</>

	<section label="States">
		<section label="Active" sticky="stack" collapsible dividing>
			<example description="A step can be highlighted as active:  `selected` (or Fomantic's `active`), the current step.">
				<steps>
					<step selected icon="payment" heading="Billing" description="Enter billing information"/>
				</steps>
			</example>
			<example>
				<steps appearance="circular">
					<step selected heading="Billing" description="Enter billing information"/>
				</steps>
			</example>
		</>

		<section label="Completed" sticky="stack" collapsible dividing>
			<example description="A step can show that a user has completed it.">
				<steps>
					<step completed icon="payment" heading="Billing" description="Enter billing information"/>
				</steps>
			</example>
			<example>
				<steps appearance="circular">
					<step completed heading="Billing" description="Enter billing information"/>
				</steps>
			</example>
		</>

		<section label="Disabled" sticky="stack" collapsible dividing>
			<example description="A step can show that it cannot be selected.">
				<steps>
					<step disabled>Billing</step>
				</steps>
			</example>
			<example>
				<steps appearance="circular">
					<step disabled>
						<content align="center">
							<title>Billing</title>
						</content>
					</step>
				</steps>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Stackable" sticky="stack" collapsible dividing>
			<example description="A step can stack vertically only on smaller screens:  steps stack below 768px of the group's width by default, `stackable=\"tablet\"` below 992px.">
				<steps stackable="tablet">
					<step icon="plane" heading="Shipping" description="Choose your shipping options"/>
					<step selected icon="dollar" heading="Billing" description="Enter billing information"/>
					<step disabled icon="info circle" heading="Confirm Order" description="Verify order details"/>
				</steps>
			</example>

			<!-- Fomantic's JS snippet that turns circular steps vertical on phones isn't needed:  see the description. -->
			<example description="Circular steps never stack by width;  set `direction=\"vertical\"` on them yourself for phones.">
				<steps appearance="circular">
					<step heading="Shipping" description="Choose your shipping options"/>
					<step selected heading="Billing" description="Enter billing information"/>
					<step disabled heading="Confirm Order" description="Verify order details"/>
				</steps>
			</example>
		</>

		<section label="Fluid" sticky="stack" collapsible dividing>
			<example description="A fluid step takes up the width of its container.">
				<html>
					<ui-grid columns="2">
						<ui-column>
							<ui-steps fluid direction="vertical">
								<ui-step completed icon="truck" heading="Shipping" description="Choose your shipping options"></ui-step>
								<ui-step selected icon="dollar" heading="Billing" description="Enter billing information"></ui-step>
							</ui-steps>
						</ui-column>
						<ui-column>
							<p>The steps take up the entire column width</p>
						</ui-column>
					</ui-grid>
				</html>
			</example>
		</>

		<section label="Unstackable" sticky="stack" collapsible dividing>
			<example description="A step can prevent itself from stacking on mobile.">
				<steps unstackable>
					<step icon="plane" heading="Shipping" description="Choose your shipping options"/>
					<step selected icon="dollar" heading="Billing" description="Enter billing information"/>
					<step disabled icon="info circle" heading="Confirm Order" description="Verify order details"/>
				</steps>
			</example>
		</>

		<section label="Attached" sticky="stack" collapsible dividing>
			<example description="Steps can be attached to other elements.">
				<steps widths="3" attach="top">
					<step icon="truck" heading="Shipping" description="Choose your shipping options"/>
					<step selected icon="payment" heading="Billing" description="Enter billing information"/>
					<step disabled icon="info" heading="Confirm Order" description="Verify order details"/>
				</steps>
				<segment attach="both">
					<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
				</segment>
				<steps widths="3" attach="bottom">
					<step icon="truck" heading="Shipping" description="Choose your shipping options"/>
					<step selected icon="payment" heading="Billing" description="Enter billing information"/>
					<step disabled icon="info" heading="Confirm Order" description="Verify order details"/>
				</steps>
			</example>
		</>

		<section label="Evenly Divided" sticky="stack" collapsible dividing>
			<example description="Steps can be divided evenly inside their parent:  `widths` is the number of steps.">
				<steps widths="3">
					<step icon="truck" heading="Shipping" description="Choose your shipping options"/>
					<step selected icon="payment" heading="Billing" description="Enter billing information"/>
					<step disabled icon="info" heading="Confirm Order" description="Verify order details"/>
				</steps>
			</example>
			<example>
				<steps widths="2">
					<step selected icon="payment" heading="Billing" description="Enter billing information"/>
					<step disabled icon="info" heading="Confirm Order" description="Verify order details"/>
				</steps>
			</example>
		</>

		<section label="Equal" sticky="stack" collapsible dividing>
			<example description="`equal` makes every step the same width, counted from the steps themselves:  each as wide as the widest;  with `fluid`, an equal share of the row each.  `widths` above is the older, count-based spelling of `equal fluid`.">
				<steps equal>
					<step icon="truck" heading="Shipping"/>
					<step selected icon="payment" heading="Billing" description="Enter billing information"/>
					<step disabled icon="info" heading="Confirm"/>
				</steps>
			</example>
			<example description="Horizontal circular steps are always evenly divided.">
				<steps appearance="circular">
					<step completed>
						<content align="center">
							<title>Shipping</title>
						</content>
					</step>
					<step selected>
						<content align="center">
							<title>Billing</title>
						</content>
					</step>
					<step disabled>
						<content align="center">
							<title>Confirm Order</title>
						</content>
					</step>
				</steps>
			</example>
		</>

		<section label="Size" sticky="stack" collapsible dividing>
			<example description="Steps can have different sizes.">
				<steps size="mini">
					<step icon="truck" heading="Shipping" description="Choose your shipping options"/>
					<step selected icon="payment" heading="Billing" description="Enter billing information"/>
					<step disabled icon="info" heading="Confirm Order" description="Verify order details"/>
				</steps>
			</example>
			<example>
				<steps size="mini" appearance="circular">
					<step>
						<content>
							<title>Shipping</title>
							<description>Choose your shipping options</description>
						</content>
					</step>
					<step selected>
						<content>
							<title>Billing</title>
							<description>Enter billing information</description>
						</content>
					</step>
					<step disabled>
						<content>
							<title>Confirm Order</title>
							<description>Verify order details</description>
						</content>
					</step>
				</steps>
			</example>
			<example>
				<steps size="tiny">
					<step icon="truck" heading="Shipping" description="Choose your shipping options"/>
					<step selected icon="payment" heading="Billing" description="Enter billing information"/>
					<step disabled icon="info" heading="Confirm Order" description="Verify order details"/>
				</steps>
			</example>
			<example>
				<steps size="tiny" appearance="circular">
					<step>
						<content>
							<title>Shipping</title>
							<description>Choose your shipping options</description>
						</content>
					</step>
					<step selected>
						<content>
							<title>Billing</title>
							<description>Enter billing information</description>
						</content>
					</step>
					<step disabled>
						<content>
							<title>Confirm Order</title>
							<description>Verify order details</description>
						</content>
					</step>
				</steps>
			</example>
			<example>
				<steps size="small">
					<step icon="truck" heading="Shipping" description="Choose your shipping options"/>
					<step selected icon="payment" heading="Billing" description="Enter billing information"/>
					<step disabled icon="info" heading="Confirm Order" description="Verify order details"/>
				</steps>
			</example>
			<example>
				<steps size="small" appearance="circular">
					<step>
						<content>
							<title>Shipping</title>
							<description>Choose your shipping options</description>
						</content>
					</step>
					<step selected>
						<content>
							<title>Billing</title>
							<description>Enter billing information</description>
						</content>
					</step>
					<step disabled>
						<content>
							<title>Confirm Order</title>
							<description>Verify order details</description>
						</content>
					</step>
				</steps>
			</example>
			<example>
				<steps size="large">
					<step icon="truck" heading="Shipping"/>
					<step selected icon="payment" heading="Billing"/>
				</steps>
			</example>
			<example>
				<steps size="large" appearance="circular">
					<step>
						<content align="center">
							<title>Shipping</title>
						</content>
					</step>
					<step selected>
						<content align="center">
							<title>Billing</title>
						</content>
					</step>
				</steps>
			</example>
			<example>
				<steps size="big">
					<step icon="truck" heading="Shipping"/>
					<step selected icon="payment" heading="Billing"/>
				</steps>
			</example>
			<example>
				<steps size="big" appearance="circular">
					<step>
						<content align="center">
							<title>Shipping</title>
						</content>
					</step>
					<step selected>
						<content align="center">
							<title>Billing</title>
						</content>
					</step>
				</steps>
			</example>
			<example>
				<steps size="huge">
					<step icon="truck" heading="Shipping"/>
					<step selected icon="payment" heading="Billing"/>
				</steps>
			</example>
			<example>
				<steps size="huge" appearance="circular">
					<step>
						<content align="center">
							<title>Shipping</title>
						</content>
					</step>
					<step selected>
						<content align="center">
							<title>Billing</title>
						</content>
					</step>
				</steps>
			</example>
			<example>
				<steps size="massive">
					<step icon="truck" heading="Shipping"/>
					<step selected icon="payment" heading="Billing"/>
				</steps>
			</example>
			<example>
				<steps size="massive" appearance="circular" stackable>
					<step>
						<content align="center">
							<title>Shipping</title>
						</content>
					</step>
					<step selected>
						<content align="center">
							<title>Billing</title>
						</content>
					</step>
				</steps>
			</example>
		</>

		<section label="Inverted" sticky="stack" collapsible dividing>
			<example description="A step's color can be inverted.">
				<segment inverted>
					<steps inverted>
						<step icon="truck" heading="Shipping" description="Choose your shipping options"/>
						<step selected icon="payment" heading="Billing" description="Enter billing information"/>
						<step disabled icon="info" heading="Confirm Order"/>
					</steps>
				</segment>
			</example>
			<example>
				<segment inverted>
					<steps inverted appearance="circular" stackable>
						<step heading="Shipping" description="Choose your shipping options"/>
						<step selected heading="Billing" description="Enter billing information"/>
						<step disabled heading="Confirm Order"/>
					</steps>
				</segment>
			</example>
			<example>
				<segment inverted>
					<steps inverted ordered>
						<step completed heading="Shipping" description="Choose your shipping options"/>
						<step completed heading="Billing" description="Enter billing information"/>
						<step selected heading="Confirm" description="Verify order details"/>
						<step heading="Transfer" description="Package on its way"/>
						<step heading="Delivered" description="Package received"/>
					</steps>
				</segment>
			</example>
			<example>
				<segment inverted>
					<steps inverted ordered appearance="circular" stackable>
						<step completed heading="Shipping" description="Choose your shipping options"/>
						<step completed heading="Billing" description="Enter billing information"/>
						<step selected heading="Confirm" description="Verify order details"/>
						<step heading="Transfer" description="Package on its way"/>
						<step heading="Delivered" description="Package received"/>
					</steps>
				</segment>
			</example>
			<example>
				<segment inverted>
					<steps inverted direction="vertical">
						<step completed icon="truck" heading="Shipping" description="Choose your shipping options"/>
						<step completed icon="credit card" heading="Billing" description="Enter billing information"/>
						<step selected icon="info" heading="Confirm Order" description="Verify order details"/>
					</steps>
				</segment>
			</example>
			<example>
				<segment inverted>
					<steps inverted direction="vertical" appearance="circular">
						<step completed heading="Shipping" description="Choose your shipping options"/>
						<step completed heading="Billing" description="Enter billing information"/>
						<step selected heading="Confirm Order" description="Verify order details"/>
					</steps>
				</segment>
			</example>
		</>

		<section label="Color" sticky="stack" collapsible dividing>
			<example description="Circular steps can be shown in different colors for active and completed steps of the whole step group.">
				<steps color="primary" size="small" appearance="circular" ordered stackable>
					<step completed>
						<content align="center">
							<title>Completed</title>
						</content>
					</step>
					<step completed selected heading="Completed..." description="...and active"/>
					<step completed selected disabled heading="Completed..." description="...and active ... and disabled"/>
					<step selected>
						<content align="center">
							<title>Active</title>
						</content>
					</step>
					<step heading="Default"/>
				</steps>
			</example>
			<example>
				<steps color="secondary" size="small" appearance="circular" ordered stackable>
					<step completed>
						<content align="center">
							<title>Completed</title>
						</content>
					</step>
					<step completed selected heading="Completed..." description="...and active"/>
					<step completed selected disabled heading="Completed..." description="...and active ... and disabled"/>
					<step selected>
						<content align="center">
							<title>Active</title>
						</content>
					</step>
					<step heading="Default"/>
				</steps>
			</example>
			<example>
				<steps color="red" size="small" appearance="circular" ordered stackable>
					<step completed>
						<content align="center">
							<title>Completed</title>
						</content>
					</step>
					<step completed selected heading="Completed..." description="...and active"/>
					<step completed selected disabled heading="Completed..." description="...and active ... and disabled"/>
					<step selected>
						<content align="center">
							<title>Active</title>
						</content>
					</step>
					<step heading="Default"/>
				</steps>
			</example>
			<example>
				<steps color="orange" size="small" appearance="circular" ordered stackable>
					<step completed>
						<content align="center">
							<title>Completed</title>
						</content>
					</step>
					<step completed selected heading="Completed..." description="...and active"/>
					<step completed selected disabled heading="Completed..." description="...and active ... and disabled"/>
					<step selected>
						<content align="center">
							<title>Active</title>
						</content>
					</step>
					<step heading="Default"/>
				</steps>
