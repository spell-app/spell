<spell-notebook "checkbox examples">
	<header level="1">
		Checkbox
		<header>A checkbox allows a user to select a value from a small set of options, often binary.</>
	</>
	<checkbox-tab-bar showing="examples"/>
	<section>
		<html>
			<ui-menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
				<ui-item link="#types">Types</>
				<ui-item link="#states">States</>
				<ui-item link="#variations">Variations</>
				<ui-item link="#examples">Examples</>
			</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's checkbox page, section by section, in its order (Types, States, Variations, then its
		Examples tab), plus our own extra (Colored).  `<ui-checkbox>` and `<ui-radio>` are one family, but the radio
		examples are on `ui-radio.html` (epic ui-docs-rework P7):  here only a pointer to it.
	-->
	<section label="Types">
		<section label="Checkbox" sticky collapsible dividing>
			<example description="A standard checkbox.">
				<checkbox name="example">Make my profile visible</checkbox>
			</example>
		</>

		<section label="Radio" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">A checkbox can be formatted as a radio element: <code>&lt;ui-radio&gt;</code>, an exclusive option. Groups, sliders, toggles and the rest are on the <a href="/components/ui/ui-radio.html">Radio</a> page.</p>
				</html>
				<radio name="radio" selected>Radio choice</radio>
			</example>
		</>

		<section label="Slider" sticky collapsible dividing>
			<example description="A checkbox can be formatted to emphasize the current selection state:  `appearance=\"slider\"`.">
				<checkbox appearance="slider" name="newsletter">Accept terms and conditions</checkbox>
			</example>
		</>

		<section label="Toggle" sticky collapsible dividing>
			<example description="A checkbox can be formatted to show an on or off choice:  `appearance=\"toggle\"`.">
				<checkbox appearance="toggle" name="public">Subscribe to weekly newsletter</checkbox>
			</example>
		</>

		<!-- GAP:  Fomantic styles an invisible checkbox's LABEL as any component (button, message, segment);  ours is a bordered label tinted when chosen. -->
		<section label="Invisible" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">An invisible checkbox has no box: the label itself is the control, bordered while unchosen and tinted when chosen. Its content can be any markup.</p>
					<ui-message slot="description" size="small" class="site-not-ported">Not ported: styling the label as another component (Fomantic's <code>label class="ui purple button"</code>, or an orange message or teal segment label), and <code>compact invisible</code>. The label is in the shadow root, so it can't take another component's classes.</ui-message>
					<ui-form>
						<form>
							<ui-fields grouped>
								<ui-checkbox invisible name="invisible-one"><b>Option One</b><br />I am a checkbox styled as a bordered label</ui-checkbox>
								<ui-checkbox invisible name="invisible-two"><b>Option Two</b><br />I am tinted when chosen</ui-checkbox>
								<ui-checkbox invisible name="invisible-three" selected><b>Option Three</b><br />I am chosen</ui-checkbox>
							</ui-fields>
						</form>
					</ui-form>
				</html>
			</example>
			<example description="Icons, emojis, flags or images can be the whole label.">
				<html>
					<ui-form>
						<form>
							<ui-fields inline>
								<ui-checkbox invisible selected aria-label="Germany">
									<ui-flag country="de" size="large"></ui-flag>
								</ui-checkbox>
								<ui-checkbox invisible selected aria-label="Toilet paper">
									<ui-icon name="toilet paper" size="huge"></ui-icon>
								</ui-checkbox>
								<ui-checkbox invisible aria-label="Wink">
									<ui-emoji name="winking_face" size="small"></ui-emoji>
								</ui-checkbox>
								<ui-checkbox invisible aria-label="Ade">
									<ui-image size="small" src="/components/ui/images/avatar/large/ade.jpg" alt=""></ui-image>
								</ui-checkbox>
							</ui-fields>
						</form>
					</ui-form>
				</html>
			</example>
		</>
	</>

	<section label="States">
		<section label="Read-only" sticky collapsible dividing>
			<example description="A checkbox can be read-only and unable to change states.  It is still submitted.">
				<checkbox readonly>Read Only</checkbox>
			</example>
		</>

		<section label="Checked" sticky collapsible dividing>
			<example description="A checkbox can be checked. `selected` is the canonical name; `checked` is accepted as an alias, as on a native checkbox.">
				<checkbox checked>Active</checkbox>
			</example>
		</>

		<section label="Indeterminate" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">A checkbox can be indeterminate: neither on nor off. A click clears it, as natively.</p>
					<ui-message slot="description" state="info" size="small">Unlike Fomantic's, which needs JavaScript, <code>indeterminate</code> is an attribute.</ui-message>
				</html>
				<segment appearance="basic">
					<checkbox indeterminate>Indeterminate</checkbox>
				</segment>
				<segment appearance="basic">
					<checkbox appearance="toggle" indeterminate>Indeterminate</checkbox>
				</segment>
			</example>
		</>

		<section label="Disabled" sticky collapsible dividing>
			<example description="A checkbox can show it is currently unable to be interacted with. It is left out of the form.">
				<segment appearance="basic">
					<checkbox disabled>Disabled</checkbox>
				</segment>
				<segment appearance="basic">
					<checkbox appearance="toggle" disabled>Disabled</checkbox>
				</segment>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Fitted" sticky collapsible dividing>
			<example description="A fitted checkbox does not leave padding for a label. Give it an `aria-label`.">
				<stack direction="horizontal" wrap>
					<segment padding="compact">
						<checkbox padding="none" aria-label="Fitted"/>
					</segment>
					<segment padding="compact">
						<checkbox padding="none" appearance="slider" aria-label="Fitted slider"/>
					</segment>
					<segment padding="compact">
						<checkbox padding="none" appearance="toggle" aria-label="Fitted toggle"/>
					</segment>
				</stack>
			</example>
		</>

		<section label="Inverted" sticky collapsible dividing>
			<example description="A checkbox can be formatted to appear on dark backgrounds.">
				<segment padding="compact" inverted>
					<checkbox inverted>Inverted</checkbox>
				</segment>
				<segment padding="compact" inverted>
					<checkbox inverted appearance="slider">Inverted</checkbox>
				</segment>
				<segment padding="compact" inverted>
					<checkbox inverted appearance="toggle">Inverted</checkbox>
				</segment>
			</example>
		</>

		<section label="Right aligned" sticky collapsible dividing>
			<example description="A checkbox can be aligned to the right of the label:  `right-aligned`.">
				<html>
					<ui-form>
						<form>
							<ui-fields grouped>
								<ui-field>
									<ui-checkbox align="right" selected>Checkbox</ui-checkbox>
								</ui-field>
								<ui-field>
									<ui-checkbox align="right" appearance="slider" selected>Slider</ui-checkbox>
								</ui-field>
								<ui-field>
									<ui-checkbox align="right" appearance="toggle" selected>Toggle</ui-checkbox>
								</ui-field>
							</ui-fields>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Colored" sticky collapsible dividing>
			<example description="A checkbox can have different colors:  `color` tints the chosen box, bullet, lane or line.">
				<checkbox color="red" selected>Red</checkbox>
				<checkbox color="green" appearance="toggle" selected>Green</checkbox>
				<checkbox color="blue" appearance="slider" selected>Blue</checkbox>
			</example>
		</>

		<section label="Size" sticky collapsible dividing>
			<example description="A checkbox can have different sizes.">
				<checkbox size="mini">Checkbox</checkbox>
				<checkbox size="mini" appearance="toggle">Toggle</checkbox>
				<checkbox size="mini" appearance="slider">Slider</checkbox>
			</example>
			<example>
				<checkbox size="tiny">Checkbox</checkbox>
				<checkbox size="tiny" appearance="toggle">Toggle</checkbox>
				<checkbox size="tiny" appearance="slider">Slider</checkbox>
			</example>
			<example>
				<checkbox size="small">Checkbox</checkbox>
				<checkbox size="small" appearance="toggle">Toggle</checkbox>
				<checkbox size="small" appearance="slider">Slider</checkbox>
			</example>
			<example>
				<checkbox size="large">Checkbox</checkbox>
				<checkbox size="large" appearance="toggle">Toggle</checkbox>
				<checkbox size="large" appearance="slider">Slider</checkbox>
			</example>
			<example>
				<checkbox size="big">Checkbox</checkbox>
				<checkbox size="big" appearance="toggle">Toggle</checkbox>
				<checkbox size="big" appearance="slider">Slider</checkbox>
			</example>
			<example>
				<checkbox size="huge">Checkbox</checkbox>
				<checkbox size="huge" appearance="toggle">Toggle</checkbox>
				<checkbox size="huge" appearance="slider">Slider</checkbox>
			</example>
			<example>
				<checkbox size="massive">Checkbox</checkbox>
				<checkbox size="massive" appearance="toggle">Toggle</checkbox>
				<checkbox size="massive" appearance="slider">Slider</checkbox>
			</example>
		</>
	</>

	<section label="Examples">
		<section label="Grouped Checkboxes" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">The <code>indeterminate</code> state can be used to represent a value that is neither checked or unchecked. This can be useful with groups where a "master" checkbox should display the selections of several other checkboxes.</p>
					<ui-message slot="description" state="info" size="small">The wiring (children set the master, the master sets the children) is a few lines on <code>ui-changed</code>: see "Grouped checkboxes" on the Usage tab. Here the states are set in markup.</ui-message>
				</html>
				<list celled spacing="lg">
					<item>
						<checkbox name="fruits" indeterminate>Fruits</checkbox>
						<list>
							<item>
								<checkbox name="apple" selected>Apple</checkbox>
							</item>
							<item>
								<checkbox name="orange">Orange</checkbox>
							</item>
							<item>
								<checkbox name="pear">Pear</checkbox>
							</item>
						</list>
					</item>
					<item>
						<checkbox name="vegetables" selected>Vegetables</checkbox>
						<list>
							<item>
								<checkbox name="lettuce" selected>Lettuce</checkbox>
							</item>
							<item>
								<checkbox name="carrot" selected>Carrot</checkbox>
							</item>
							<item>
								<checkbox name="spinach" selected>Spinach</checkbox>
							</item>
						</list>
					</item>
				</list>
			</example>
		</>

		<section label="One-Way Choices" sticky collapsible dividing>
			<example>
				<html>
					<p slot="description">A disabled checkbox can't be used at all; a read-only one shows its state but can't change it.</p>
					<ui-message slot="description" size="small" class="site-not-ported">Not ported: Fomantic's <code>uncheckable: false</code> setting (check once, never uncheck) -- veto the change in a <code>ui-changed</code> listener instead (Usage tab, "Vetoing a change").</ui-message>
					<ui-form>
						<form>
							<ui-field>
								<ui-checkbox disabled>Disabled</ui-checkbox>
							</ui-field>
							<ui-field>
								<ui-checkbox readonly>Read-only</ui-checkbox>
							</ui-field>
						</form>
					</ui-form>
				</html>
			</example>
		</>

		<section label="Two Values" sticky collapsible dividing>
			<example description="Ours, not Fomantic's:  `off-value` is what a box submits while unchosen. So the form always hears one of two values, `panel=open` or `panel=closed`.">
				<html>
					<ui-form>
						<form>
							<ui-field>
								<ui-checkbox appearance="toggle" name="panel" value="open" off-value="closed">Panel open</ui-checkbox>
							</ui-field>
							<ui-field>
								<ui-checkbox name="reply" value="yes" off-value="no" selected>Reply by email</ui-checkbox>
							</ui-field>
						</form>
					</ui-form>
				</html>
			</example>
		</>
		<html>
			<ui-message size="small" class="site-not-ported">Not ported: Using Callbacks, Checking Conditions and Attaching Events to other Elements, which are jQuery behaviours (check, set checked, beforeChecked, attach events). Instead, set the <code>selected</> property and listen for <code>ui-changed</>. Wire other controls with a click listener (Usage tab).</>
		</>
	</>
</spell-notebook>
