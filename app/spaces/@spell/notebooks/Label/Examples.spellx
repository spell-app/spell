<spell-notebook "label examples">
	<header level="1">
		Label
		<header>A label displays content classification.</>
	</>
	<label-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#content">Content</>
			<item link="#states">States</>
			<item link="#variations">Variations</>
			<item link="#groups">Groups</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's label page, section by section, in its order (Types, Content, States, Variations, Groups),
		plus our Active state and Prompt content.  `<ui-labels>` (the group) lives on this page too.
	-->
	<section label="Types">
		<section label="Label" sticky="stack" collapsible dividing>
			<example "Label" description="A label.">
				<label icon="mail">23</label>
			</example>

			<!-- GAP I111:  the page's `kbd` style draws a second box around each label. -->
			<example "Label" description="Highlight keyboard shortcuts:  a label inside a `<kbd>`.">
				<html>
					<kbd>
						<ui-label>CTRL</ui-label>
					</kbd>
				</html>
				+
				<html>
					<kbd>
						<ui-label>Alt</ui-label>
					</kbd>
				</html>
				+
				<html>
					<kbd>
						<ui-label>Del</ui-label>
					</kbd>
					<kbd>
						<ui-label inverted icon="windows" aria-label="Windows"></ui-label>
					</kbd>
				</html>
				+
				<html>
					<kbd>
						<ui-label inverted>L</ui-label>
					</kbd>
					<kbd>
						<ui-label appearance="basic">W</ui-label>
					</kbd>
					<kbd>
						<ui-label appearance="basic">A</ui-label>
					</kbd>
					<kbd>
						<ui-label appearance="basic">S</ui-label>
					</kbd>
					<kbd>
						<ui-label appearance="basic">D</ui-label>
					</kbd>
				</html>
			</example>
		</>

		<section label="Image" sticky="stack" collapsible dividing>
			<example "Image" description="A label can be formatted to emphasize an image:  `image` is the photo's URL.">
				<label link="#label" image="../images/avatar/small/joe.jpg">Joe</label>
				<label link="#label" image="../images/avatar/small/elliot.jpg">Elliot</label>
				<label link="#label" image="../images/avatar/small/stevie.jpg">Stevie</label>
			</example>
			<example "Image" description="With a `detail`.">
				<label link="#label" color="blue" image="../images/avatar/small/veronika.jpg" detail="Friend">Veronika</label>
				<label link="#label" color="teal" image="../images/avatar/small/jenny.jpg" detail="Student">Veronika</label>
				<label link="#label" color="yellow" image="../images/avatar/small/christian.jpg" detail="Co-worker">Helen</label>
			</example>
			<example "Image" description="`removable` adds a delete button, which fires `ui-removing`.">
				<label image="../images/avatar/small/ade.jpg" removable>Adrienne</label>
				<label image="../images/avatar/small/zoe.jpg" removable>Zoe</label>
				<label image="../images/avatar/small/nan.jpg" removable>Nan</label>
			</example>
		</>

		<section label="Pointing" sticky="stack" collapsible dividing>
			<example "Pointing" description="A label can point to content next to it:  `pointing` (above), `below`, `left` or `right`.">
				<form>
					<field>
						<input placeholder="First name"/>
						<label pointing>Please enter a value</label>
					</field>
					<divider/>
					<field>
						<label pointing="below">Please enter a value</label>
						<input placeholder="Last name"/>
					</field>
					<divider/>
					<field inline>
						<input placeholder="Username"/>
						<label pointing="left">That name is taken!</label>
					</field>
					<divider/>
					<field inline>
						<label pointing="right">Your password must be 6 characters or more</label>
						<input type="password" aria-label="Password"/>
					</field>
				</form>
			</example>
			<example "Pointing">
				<form>
					<field>
						<input placeholder="First name"/>
						<label pointing color="red" appearance="basic">Please enter a value</label>
					</field>
					<divider/>
					<field>
						<label pointing="below" color="red" appearance="basic">Please enter a value</label>
						<input placeholder="Last name"/>
					</field>
					<divider/>
					<field inline>
						<input placeholder="Username"/>
						<label pointing="left" color="red" appearance="basic">That name is taken!</label>
					</field>
					<divider/>
					<field inline>
						<label pointing="right" color="red" appearance="basic">Your password must be 6 characters or more</label>
						<input type="password" aria-label="Password"/>
					</field>
				</form>
			</example>
		</>

		<section label="Corner" sticky="stack" collapsible dividing>
			<example "Corner" description="A label can position itself in the corner of an element.">
				<message slot="description" state="warning" size="small">A corner label sits in the corner of its owner, the nearest positioned box around it: a <text code>&lt;ui-segment&gt;</text> is one, and clips the label to its rounded corner.</message>
				<grid columns="2">
					<column>
						<segment>
							<label link="#label" corner="left" icon="heart" aria-label="Like"/>
							<image fluid src="/components/ui/images/wireframe/image.png" alt=""/>
						</segment>
					</column>
					<column>
						<segment>
							<label link="#label" color="red" corner="right" icon="save" aria-label="Save"/>
							<image fluid src="/components/ui/images/wireframe/image.png" alt=""/>
						</segment>
					</column>
				</grid>
			</example>
		</>

		<section label="Tag" sticky="stack" collapsible dividing>
			<example "Tag" description="A label can appear as a tag.">
				<label link="#label" tag>New</label>
				<label link="#label" color="red" tag>Upcoming</label>
				<label link="#label" color="teal" tag>Featured</label>
			</example>
		</>

		<section label="Ribbon" sticky="stack" collapsible dividing>
			<example "Ribbon" description="A label can appear as a ribbon attaching itself to an element:  `ribbon`, or `ribbon=\"right\"`.">
				<grid columns="2">
					<column>
						<segment appearance="raised"><label link="#label" color="red" ribbon>Overview</label> <text>Account Details</text> <image src="/components/ui/images/wireframe/paragraph.png" alt=""/> <label link="#label" color="blue" ribbon>Community</label> User Reviews <image src="/components/ui/images/wireframe/paragraph.png" alt=""/></segment>
					</column>
					<column>
						<segment>
							<label link="#label" color="orange" ribbon="right">Specs</label>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
							<label link="#label" color="teal" ribbon="right">Reviews</label>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						</segment>
					</column>
				</grid>
			</example>
			<example "Ribbon">
				<grid columns="2">
					<column>
						<segment>
							<label color="black" ribbon icon="hotel">Hotel</label>
							<image fluid src="/components/ui/images/wireframe/image.png" alt=""/>
						</segment>
					</column>
					<column>
						<segment>
							<label color="blue" ribbon="right" icon="utensils">Food</label>
							<image fluid src="/components/ui/images/wireframe/image.png" alt=""/>
						</segment>
					</column>
				</grid>
			</example>
			<example "Ribbon">
				<grid columns="2">
					<column>
						<segment>
							<label color="black" ribbon icon="hotel" aria-label="Hotel"/>
							<image fluid src="/components/ui/images/wireframe/image.png" alt=""/>
						</segment>
					</column>
					<column>
						<segment>
							<label color="blue" ribbon="right" icon="utensils" aria-label="Food"/>
							<image fluid src="/components/ui/images/wireframe/image.png" alt=""/>
						</segment>
					</column>
				</grid>
			</example>
		</>

		<!-- GAP I75:  no `bottom` / `center` ribbon, so Fomantic's Bottom and Center Ribbon example (2.9.3) is left out. -->
		<!-- GAP I77:  attached labels overlay the paragraph:  the segment doesn't pad the content after them. -->
		<section label="Attached" sticky="stack" collapsible dividing>
			<example "Attached" description="A label can attach to a content segment.">
				<message slot="description" state="warning" size="small">Attached labels try to pad the other content in the owner to make room, but may not get it right in every case; then correct the padding of the other content yourself.</message>
				<grid columns="3">
					<column>
						<segment>
							<label attach="top">HTML</label>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						</segment>
					</column>
					<column>
						<segment>
							<label attach="bottom">CSS</label>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						</segment>
					</column>
					<column>
						<segment>
							<label attach="top right">Code</label>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						</segment>
					</column>
					<column>
						<segment>
							<label attach="top left">View</label>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						</segment>
					</column>
					<column>
						<segment>
							<label attach="bottom left">User View</label>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						</segment>
					</column>
					<column>
						<segment>
							<label attach="bottom right">Admin View</label>
							<image src="/components/ui/images/wireframe/paragraph.png" alt=""/>
						</segment>
					</column>
				</grid>
			</example>
		</>

		<section label="Horizontal" sticky="stack" collapsible dividing>
			<example "Horizontal" description="A horizontal label is formatted to label content along-side it horizontally.">
				<list divided selection>
					<item link="#label"><label color="red" direction="horizontal">Fruit</label>Kumquats</item>
					<item link="#label"><label color="purple" direction="horizontal">Candy</label>Ice Cream</item>
					<item link="#label"><label color="red" direction="horizontal">Fruit</label>Orange</item>
					<item link="#label"><label direction="horizontal">Dog</label>Poodle</item>
				</list>
			</example>
		</>

		<section label="Floating" sticky="stack" collapsible dividing>
			<example "Floating" description="A label can float above or below another element.">
				<message slot="description" state="warning" size="small">A floating label sits on the corner of its owner, the nearest positioned box around it: a menu item is one.</message>
				<menu padding="compact">
					<item link="#label" icon="mail">Messages<label color="red" floating>22</label></item>
					<item link="#label" icon="users">Friends<label color="blue" floating>22</label></item>
				</menu>
				<divider spacer/>
				<menu padding="compact">
					<item link="#label" icon="mail">Messages<label color="red" floating>22 Mails</label></item>
					<item link="#label" icon="users">Friends<label color="blue" floating>22 Friends</label></item>
				</menu>
				<divider spacer/>
				<menu padding="compact">
					<item link="#label" icon="mail">Messages<label color="red" floating="bottom">22</label></item>
					<item link="#label" icon="users">Friends<label color="blue" floating="bottom">22</label></item>
				</menu>
				<divider spacer/>
				<menu padding="compact">
					<item link="#label" icon="mail">Messages<label color="red" floating="bottom">22 Mails</label></item>
					<item link="#label" icon="users">Friends<label color="blue" floating="bottom">22 Friends</label></item>
				</menu>
			</example>
		</>

		<section label="Floating left" sticky="stack" collapsible dividing>
			<example "Floating left" description="Floating labels can be positioned to the left also.">
				<menu padding="compact">
					<item link="#label" icon="mail">Messages<label color="red" floating="left">22</label></item>
					<item link="#label" icon="users">Friends<label color="blue" floating="left">22</label></item>
				</menu>
				<divider spacer/>
				<menu padding="compact">
					<item link="#label" icon="mail">Messages<label color="red" floating="left">22 Mails</label></item>
					<item link="#label" icon="users">Friends<label color="blue" floating="left">22 Friends</label></item>
				</menu>
			</example>
		</>

		<!-- GAP I76:  no `left aligned` / `right aligned` floating label;  shown with plain `floating`. -->
		<section label="Floating aligned" sticky="stack" collapsible dividing>
			<example "Floating aligned" description="Floating labels containing large text can be aligned to the left or right.">
				<menu padding="compact">
					<item link="#label" icon="mail">Messages from Fomantic-UI-Users<label color="red" floating>22 Mails unread</label></item>
					<item link="#label" icon="users">Friends of the Fomantic-UI Community<label color="blue" floating>22 Friends online</label></item>
				</menu>
			</example>
		</>

		<section label="Inverted" sticky="stack" collapsible dividing>
			<example "Inverted" description="All variants of label can be inverted.">
				<segment inverted>
					<label color="primary" inverted>Primary</label>
					<label color="secondary" inverted>Secondary</label>
					<label color="red" inverted>Red</label>
					<label color="orange" inverted>Orange</label>
					<label color="yellow" inverted>Yellow</label>
					<label color="olive" inverted>Olive</label>
					<label color="green" inverted>Green</label>
					<label color="teal" inverted>Teal</label>
					<label color="blue" inverted>Blue</label>
					<label color="violet" inverted>Violet</label>
					<label color="purple" inverted>Purple</label>
					<label color="pink" inverted>Pink</label>
					<label color="brown" inverted>Brown</label>
					<label color="grey" inverted>Grey</label>
					<label color="black" inverted>Black</label>
					<divider spacer/>
					<label color="primary" inverted appearance="basic">Primary</label>
					<label color="secondary" inverted appearance="basic">Secondary</label>
					<label color="red" inverted appearance="basic">Red</label>
					<label color="orange" inverted appearance="basic">Orange</label>
					<label color="yellow" inverted appearance="basic">Yellow</label>
					<label color="olive" inverted appearance="basic">Olive</label>
					<label color="green" inverted appearance="basic">Green</label>
					<label color="teal" inverted appearance="basic">Teal</label>
					<label color="blue" inverted appearance="basic">Blue</label>
					<label color="violet" inverted appearance="basic">Violet</label>
					<label color="purple" inverted appearance="basic">Purple</label>
					<label color="pink" inverted appearance="basic">Pink</label>
					<label color="brown" inverted appearance="basic">Brown</label>
					<label color="grey" inverted appearance="basic">Grey</label>
					<label color="black" inverted appearance="basic">Black</label>
					<divider spacer/>
					<label inverted tag>Tag</label>
					<label color="primary" inverted tag>Primary</label>
					<label color="secondary" inverted tag>Secondary</label>
					<label color="red" inverted tag>Red</label>
					<label color="orange" inverted tag>Orange</label>
					<label color="yellow" inverted tag>Yellow</label>
					<label color="olive" inverted tag>Olive</label>
					<label color="green" inverted tag>Green</label>
					<label color="teal" inverted tag>Teal</label>
					<label color="blue" inverted tag>Blue</label>
					<label color="violet" inverted tag>Violet</label>
					<label color="purple" inverted tag>Purple</label>
					<label color="pink" inverted tag>Pink</label>
					<label color="brown" inverted tag>Brown</label>
					<label color="grey" inverted tag>Grey</label>
					<label color="black" inverted tag>Black</label>
				</segment>
			</example>
		</>
	</>

	<section label="Content">
		<section label="Detail" sticky="stack" collapsible dividing>
			<example "Detail" description="A label can contain a detail:  the `detail` shorthand, or a `<ui-detail>` child.">
				<label detail="214">Dogs</label>
			</example>
		</>

		<section label="Icon" sticky="stack" collapsible dividing>
			<example "Icon" description="A label can include an icon.">
				<label icon="mail">Mail</label>
				<label icon="checkmark">Test Passed</label>
				<label icon="dog">Dog</label>
				<label icon="cat">Cat</label>
			</example>

			<!-- GAP I74:  no icon after the text (Fomantic's `right icon` label, also its right-icon ribbons). -->
			<example "Icon" description="Labels can contain individual icons without text.  Give each an `aria-label`.">
				<label icon="mail" aria-label="Mail"/>
				<label icon="dog" aria-label="Dog"/>
				<label icon="cat" aria-label="Cat"/>
			</example>
			<example "Icon" description="A close icon before the text is just an `icon`;  after the text it's `removable`, a real delete button.">
				<label icon="close">Close</label>
				<label icon="delete">Delete</label>
				<label removable>Close</label>
				<label removable>Delete</label>
			</example>
		</>

		<section label="Image" sticky="stack" collapsible dividing>
			<example "Image" description="A label can include an image.">
				<label link="#label"><image avatar spacing="right" src="/components/ui/images/avatar/small/elliot.jpg" alt=""/>Elliot</label>
				<label link="#label"><image avatar src="/components/ui/images/avatar/small/stevie.jpg" alt=""/>Stevie</label>
			</example>
		</>

		<section label="Link" sticky="stack" collapsible dividing>
			<example "Link" description="A label can be a link (`link`) or contain an item that links.">
				<label link="#label" icon="mail">23</label>
			</example>

			<!-- GAP I78:  the linked detail draws the browser's link blue, not the label's colour. -->
			<example "Link">
				<label icon="mail">23<detail link="#label">View Mail</detail></label>
			</example>
		</>

		<section label="Prompt" sticky="stack" collapsible dividing>
			<example "Prompt" description="A prompt label points at an invalid field.  Give it `role=\"alert\"` and tie it to the field with `aria-describedby`.">
				<field>
					<input type="email" placeholder="E-mail" aria-describedby="label-prompt-email"/>
					<label id="label-prompt-email" role="alert" pointing prompt appearance="basic">Please enter a valid e-mail</label>
				</field>
			</example>
		</>
	</>

	<section label="States">
		<section label="Active" sticky="stack" collapsible dividing>
			<example "Active" description="A label can show it is the current selection.">
				<label link="#label" selected>Active</label>
				<label link="#label">Inactive</label>
			</example>
		</>

		<section label="Disabled" sticky="stack" collapsible dividing>
			<example "Disabled" description="A label can show it is currently unable to be interacted with.">
				<label link="#label" disabled>Disabled Label</label>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Fluid" sticky="stack" collapsible dividing>
			<example "Fluid" description="A label can take the width of its container.">
				<label fluid>Fits container</label>
			</example>
		</>

		<section label="Centered" sticky="stack" collapsible dividing>
			<example "Centered" description="Text can be shown centered.">
				<label fluid align="center">Fits container</label>
			</example>
		</>

		<section label="Circular" sticky="stack" collapsible dividing>
			<example "Circular" description="A label can be circular.">
				<label color="red" link="#label" appearance="circular">2</label>
				<label color="orange" link="#label" appearance="circular">2</label>
				<label color="yellow" link="#label" appearance="circular">2</label>
				<label color="olive" link="#label" appearance="circular">2</label>
				<label color="green" link="#label" appearance="circular">2</label>
				<label color="teal" link="#label" appearance="circular">2</label>
				<label color="blue" link="#label" appearance="circular">2</label>
				<label color="violet" link="#label" appearance="circular">2</label>
				<label color="purple" link="#label" appearance="circular">2</label>
				<label color="pink" link="#label" appearance="circular">2</label>
				<label color="brown" link="#label" appearance="circular">2</label>
				<label color="grey" link="#label" appearance="circular">2</label>
				<label color="black" link="#label" appearance="circular">2</label>
			</example>
			<example "Circular" description="With `empty`, an empty dot.">
				<label color="red" link="#label" empty appearance="circular"/>
				<label color="orange" link="#label" empty appearance="circular"/>
				<label color="yellow" link="#label" empty appearance="circular"/>
				<label color="olive" link="#label" empty appearance="circular"/>
				<label color="green" link="#label" empty appearance="circular"/>
				<label color="teal" link="#label" empty appearance="circular"/>
				<label color="blue" link="#label" empty appearance="circular"/>
				<label color="violet" link="#label" empty appearance="circular"/>
				<label color="purple" link="#label" empty appearance="circular"/>
				<label color="pink" link="#label" empty appearance="circular"/>
				<label color="brown" link="#label" empty appearance="circular"/>
				<label color="grey" link="#label" empty appearance="circular"/>
				<label color="black" link="#label" empty appearance="circular"/>
			</example>
		</>

		<section label="Basic" sticky="stack" collapsible dividing>
			<example "Basic" description="A label can reduce its complexity.">
				<label link="#label" appearance="basic">Basic</label>
				<label link="#label" pointing appearance="basic">Pointing</label>
				<label link="#label" image="../images/avatar/small/elliot.jpg" appearance="basic">Elliot</label>
				<label link="#label" color="red" pointing appearance="basic">Red Pointing</label>
				<label link="#label" color="blue" appearance="basic">Blue</label>
			</example>
		</>

		<section label="Tinted" sticky="stack" collapsible dividing>
			<example "Tinted" description="Ours, not Fomantic's:  a tinted label is soft, the colour's tint as the fill and its text colour as the text (a pill or badge).">
				<label color="primary" appearance="tinted">Live</label>
				<label color="green" appearance="tinted">Done</label>
				<label color="orange" appearance="tinted circular">3</label>
				<label appearance="tinted">Plain</label>
			</example>
		</>

		<section label="Colored" sticky="stack" collapsible dividing>
			<example "Colored" description="A label can have different colors.">
				<label color="primary" link="#label">Primary</label>
				<label color="secondary" link="#label">Secondary</label>
				<label color="red" link="#label">Red</label>
				<label color="orange" link="#label">Orange</label>
				<label color="yellow" link="#label">Yellow</label>
				<label color="olive" link="#label">Olive</label>
				<label color="green" link="#label">Green</label>
				<label color="teal" link="#label">Teal</label>
				<label color="blue" link="#label">Blue</label>
				<label color="violet" link="#label">Violet</label>
				<label color="purple" link="#label">Purple</label>
				<label color="pink" link="#label">Pink</label>
				<label color="brown" link="#label">Brown</label>
				<label color="grey" link="#label">Grey</label>
				<label color="black" link="#label">Black</label>
			</example>
		</>

		<section label="Basic Tag Labels" sticky collapsible dividing>
			<example "Basic Tag Labels" description="Tag labels can be basic too.">
				<label link="#label" tag appearance="basic">Standard Tag</label>
				<label color="primary" link="#label" tag appearance="basic">Primary</label>
				<label color="secondary" link="#label" tag appearance="basic">Secondary</label>
				<label color="red" link="#label" tag appearance="basic">Red</label>
				<label color="orange" link="#label" tag appearance="basic">Orange</label>
				<label color="yellow" link="#label" tag appearance="basic">Yellow</label>
				<label color="olive" link="#label" tag appearance="basic">Olive</label>
				<label color="green" link="#label" tag appearance="basic">Green</label>
				<label color="teal" link="#label" tag appearance="basic">Teal</label>
				<label color="blue" link="#label" tag appearance="basic">Blue</label>
				<label color="violet" link="#label" tag appearance="basic">Violet</label>
				<label color="purple" link="#label" tag appearance="basic">Purple</label>
				<label color="pink" link="#label" tag appearance="basic">Pink</label>
				<label color="brown" link="#label" tag appearance="basic">Brown</label>
				<label color="grey" link="#label" tag appearance="basic">Grey</label>
				<label color="black" link="#label" tag appearance="basic">Black</label>
			</example>
		</>

		<section label="Size" sticky="stack" collapsible dividing>
			<example "Size" description="A label can be small or large.">
				<label size="mini">Mini</label>
				<label size="tiny">Tiny</label>
				<label size="small">Small</label>
				<label size="medium">Medium</label>
				<label size="large">Large</label>
				<label size="big">Big</label>
				<label size="huge">Huge</label>
				<label size="massive">Massive</label>
			</example>
		</>
	</>

	<section label="Groups">
		<section label="Labels" sticky="stack" collapsible dividing>
			<example "Labels" description="Label groups also have a vertical margin to make sure labels don't appear attached together when wrapped:  `<ui-labels>`.">
				<labels>
					<label>One</label>
					<label>Two</label>
					<label>Three</label>
					<label>Four</label>
					<label>Five</label>
					<label>Six</label>
					<label>Seven</label>
					<label>Eight</label>
					<label>Nine</label>
					<label>Ten</label>
					<label>Eleven</label>
					<label>Twelve</label>
					<label>Thirteen</label>
					<label>Fourteen</label>
					<label>Fifteen</label>
					<label>Sixteen</label>
					<label>Seventeen</label>
					<label>Eighteen</label>
					<label>Nineteen</label>
					<label>Twenty</label>
					<label>Twentyone</label>
					<label>Twentytwo</label>
					<label>Twentythree</label>
					<label>Twentyfour</label>
					<label>Twentyfive</label>
					<label>Twentysix</label>
					<label>Twentyseven</label>
					<label>Twentyeight</label>
					<label>Twentynine</label>
					<label>Thirty</label>
				</labels>
			</example>
		</>

		<section label="Group Size" sticky="stack" collapsible dividing>
			<example "Group Size" description="Labels can share sizes together.">
				<labels size="huge">
					<label>Fun</label>
					<label>Happy</label>
					<label>Smart</label>
					<label>Witty</label>
				</labels>
			</example>
		</>

		<section label="Colored Group" sticky="stack" collapsible dividing>
			<example "Colored Group" description="Labels can share colors together.">
				<labels color="blue">
					<label link="#label" removable>Fun</label>
					<label link="#label" detail="22">Happy</label>
					<label link="#label">Smart</label>
					<label link="#label">Insane</label>
					<label link="#label">Exciting</label>
				</labels>
			</example>
		</>

		<section label="Basic Group" sticky="stack" collapsible dividing>
			<example "Basic Group" description="Labels can share their style together.">
				<labels appearance="basic">
					<label link="#label" removable>Fun</label>
					<label link="#label" detail="22">Happy</label>
					<label link="#label">Smart</label>
					<label link="#label">Insane</label>
					<label link="#label">Exciting</label>
				</labels>
			</example>
		</>

		<section label="Tag Group" sticky="stack" collapsible dividing>
			<example "Tag Group" description="Labels can share tag formatting.">
				<labels tag>
					<label link="#label">$10.00</label>
					<label link="#label">$19.99</label>
					<label link="#label">$24.99</label>
					<label link="#label">$30.99</label>
					<label link="#label">$10.25</label>
				</labels>
			</example>
		</>

		<section label="Circular Group" sticky="stack" collapsible dividing>
			<example "Circular Group" description="Labels can share shapes.">
				<labels appearance="circular">
					<label link="#label">11</label>
					<label link="#label">22</label>
					<label link="#label">33</label>
					<label link="#label">44</label>
					<label link="#label">141</label>
				</labels>
			</example>
		</>
	</>
</spell-notebook>
