<spell-notebook "accordion examples">
	<header level="1">
		Accordion
		<header>An accordion allows users to toggle the display of sections of content.</>
	</>
	<accordion-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#types">Types</>
			<item link="#states">States</>
			<item link="#variations">Variations</>
			<item link="#examples">Examples</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's accordion page, section by section, in its order (Types, Variations, Examples), plus our
		own extras (States:  open, not exclusive, not collapsible;  any content element).
		- Panels are pairs:  a `<ui-title>` and the element after it;  `open` lists the open panels by index.
	-->
	<section label="Types">
		<section label="Accordion" sticky="stack" collapsible dividing>
			<example "Accordion" description="A standard accordion:  each `<ui-title>` starts a panel, and the element after it is that panel's content. `open` lists the panels open at the start.">
				<accordion open="0">
					<title>What is a dog?</title>
					<content>
						<text paragraph>A dog is a type of domesticated animal. Known for its loyalty and faithfulness, it can be found as a welcome guest in many households across the world.</text>
					</content>
					<title>What kinds of dogs are there?</title>
					<content>
						<text paragraph>There are many breeds of dogs. Each breed varies in size and temperament. Owners often select a breed of dog that they find to be compatible with their own lifestyle and desires from a companion.</text>
					</content>
					<title>How do you acquire a dog?</title>
					<content>
						<text paragraph>Three common ways for a prospective owner to acquire a dog is from pet shops, private owners, or shelters.</text>
						<text paragraph>A pet shop may be the most convenient way to buy a dog. Buying a dog from a private owner allows you to assess the pedigree and upbringing of your dog before choosing to take it home. Lastly, finding your dog from a shelter, helps give a good home to a dog who may not find one so readily.</text>
					</content>
				</accordion>
			</example>
		</>

		<section label="Styled" sticky="stack" collapsible dividing>
			<example "Styled" description="A styled accordion adds basic formatting.">
				<accordion appearance="styled" open="0">
					<title>What is a dog?</title>
					<content>
						<text paragraph>A dog is a type of domesticated animal. Known for its loyalty and faithfulness, it can be found as a welcome guest in many households across the world.</text>
					</content>
					<title>What kinds of dogs are there?</title>
					<content>
						<text paragraph>There are many breeds of dogs. Each breed varies in size and temperament. Owners often select a breed of dog that they find to be compatible with their own lifestyle and desires from a companion.</text>
					</content>
					<title>How do you acquire a dog?</title>
					<content>
						<text paragraph>Three common ways for a prospective owner to acquire a dog is from pet shops, private owners, or shelters.</text>
						<text paragraph>A pet shop may be the most convenient way to buy a dog. Buying a dog from a private owner allows you to assess the pedigree and upbringing of your dog before choosing to take it home. Lastly, finding your dog from a shelter, helps give a good home to a dog who may not find one so readily.</text>
					</content>
				</accordion>
			</example>
		</>

		<section label="Basic Styled" sticky="stack" collapsible dividing>
			<example "Basic Styled" description="A basic styled accordion limits the formatting to the header only.">
				<accordion appearance="basic styled" open="0">
					<title>What is a dog?</title>
					<content>
						<text paragraph>A dog is a type of domesticated animal. Known for its loyalty and faithfulness, it can be found as a welcome guest in many households across the world.</text>
					</content>
					<title>What kinds of dogs are there?</title>
					<content>
						<text paragraph>There are many breeds of dogs. Each breed varies in size and temperament. Owners often select a breed of dog that they find to be compatible with their own lifestyle and desires from a companion.</text>
					</content>
					<title>How do you acquire a dog?</title>
					<content>
						<text paragraph>Three common ways for a prospective owner to acquire a dog is from pet shops, private owners, or shelters.</text>
						<text paragraph>A pet shop may be the most convenient way to buy a dog. Buying a dog from a private owner allows you to assess the pedigree and upbringing of your dog before choosing to take it home. Lastly, finding your dog from a shelter, helps give a good home to a dog who may not find one so readily.</text>
					</content>
				</accordion>
			</example>
		</>

		<section label="Tree" sticky="stack" collapsible dividing>
			<example "Tree" description="A tree accordion using \[nested accordions](#examples-nested-accordions): each panel's content is indented under its title, like a file tree.">
				<accordion tree open="0">
					<title>Level 1</title>
					<content>
						<accordion open="0">
							<title>Level 1A</title>
							<content>
								<accordion>
									<title>Level 1A-A</title>
									<content>Level 1A-A Contents</content>
									<title>Level 1A-B</title>
									<content>Level 1A-B Contents</content>
								</accordion>
							</content>
							<title>Level 1B</title>
							<content>Level 1B Contents</content>
							<title>Level 1C</title>
							<content>Level 1C Contents</content>
						</accordion>
					</content>
					<title>Level 2</title>
					<content>
						<accordion open="0">
							<title>Level 2A</title>
							<content>
								<accordion>
									<title>Level 2A-A</title>
									<content>Level 2A-A Contents</content>
									<title>Level 2A-B</title>
									<content>Level 2A-B Contents</content>
								</accordion>
							</content>
							<title>Level 2B</title>
							<content>Level 2B Contents</content>
							<title>Level 2C</title>
							<content>Level 2C Contents</content>
						</accordion>
					</content>
				</accordion>
			</example>
		</>
	</>

	<section label="States">
		<section label="Open" sticky="stack" collapsible dividing>
			<example "Open" description="An open panel shows its content;  its title is the active one.  `open` counts from 0.">
				<accordion appearance="styled" open="1">
					<title>Closed panel</title>
					<content>
						<text paragraph>Hidden until opened.</text>
					</content>
					<title>Open panel</title>
					<content>
						<text paragraph>Shown: its title is the active one.</text>
					</content>
				</accordion>
			</example>
		</>

		<section label="Not exclusive" sticky="stack" collapsible dividing>
			<example "Not exclusive" description="By default opening one panel closes the others.  `exclusive=\"no\"` lets any number stay open, so `open` can list several:  `open=\"0 1\"`.">
				<accordion appearance="styled" exclusive="no" open="0 1">
					<title>First</title>
					<content>
						<text paragraph>Both panels can be open.</text>
					</content>
					<title>Second</title>
					<content>
						<text paragraph>Still open.</text>
					</content>
				</accordion>
			</example>
		</>

		<section label="Not collapsible" sticky="stack" collapsible dividing>
			<example "Not collapsible" description="`collapsible=\"no\"` keeps one panel open:  activating the open title does nothing.">
				<accordion appearance="styled" collapsible="no" open="0">
					<title>Always one open</title>
					<content>
						<text paragraph>Open another panel to close this one.</text>
					</content>
					<title>Another panel</title>
					<content>
						<text paragraph>Now this one stays open.</text>
					</content>
				</accordion>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Fluid" sticky="stack" collapsible dividing>
			<example "Fluid" description="An accordion can take up the width of its container.">
				<accordion appearance="styled" fluid open="0">
					<title>What is a dog?</title>
					<content>
						<text paragraph>A dog is a type of domesticated animal. Known for its loyalty and faithfulness, it can be found as a welcome guest in many households across the world.</text>
					</content>
					<title>What kinds of dogs are there?</title>
					<content>
						<text paragraph>There are many breeds of dogs. Each breed varies in size and temperament. Owners often select a breed of dog that they find to be compatible with their own lifestyle and desires from a companion.</text>
					</content>
					<title>How do you acquire a dog?</title>
					<content>
						<text paragraph>Three common ways for a prospective owner to acquire a dog is from pet shops, private owners, or shelters.</text>
						<text paragraph>A pet shop may be the most convenient way to buy a dog. Buying a dog from a private owner allows you to assess the pedigree and upbringing of your dog before choosing to take it home. Lastly, finding your dog from a shelter, helps give a good home to a dog who may not find one so readily.</text>
					</content>
				</accordion>
			</example>
		</>

		<section label="Inverted" sticky="stack" collapsible dividing>
			<example "Inverted" description="An accordion can be formatted to appear on dark backgrounds.">
				<segment inverted>
					<accordion inverted open="0">
						<title>What is a dog?</title>
						<content>
							<text paragraph>A dog is a type of domesticated animal. Known for its loyalty and faithfulness, it can be found as a welcome guest in many households across the world.</text>
						</content>
						<title>What kinds of dogs are there?</title>
						<content>
							<text paragraph>There are many breeds of dogs. Each breed varies in size and temperament. Owners often select a breed of dog that they find to be compatible with their own lifestyle and desires from a companion.</text>
						</content>
						<title>How do you acquire a dog?</title>
						<content>
							<text paragraph>Three common ways for a prospective owner to acquire a dog is from pet shops, private owners, or shelters.</text>
							<text paragraph>A pet shop may be the most convenient way to buy a dog. Buying a dog from a private owner allows you to assess the pedigree and upbringing of your dog before choosing to take it home. Lastly, finding your dog from a shelter, helps give a good home to a dog who may not find one so readily.</text>
						</content>
					</accordion>
				</segment>
			</example>
			<example "Inverted" description="A styled accordion can be inverted too.">
				<accordion inverted appearance="styled" open="0">
					<title>What is a dog?</title>
					<content>
						<text paragraph>A dog is a type of domesticated animal. Known for its loyalty and faithfulness, it can be found as a welcome guest in many households across the world.</text>
					</content>
					<title>What kinds of dogs are there?</title>
					<content>
						<text paragraph>There are many breeds of dogs. Each breed varies in size and temperament. Owners often select a breed of dog that they find to be compatible with their own lifestyle and desires from a companion.</text>
					</content>
					<title>How do you acquire a dog?</title>
					<content>
						<text paragraph>Three common ways for a prospective owner to acquire a dog is from pet shops, private owners, or shelters.</text>
						<text paragraph>A pet shop may be the most convenient way to buy a dog. Buying a dog from a private owner allows you to assess the pedigree and upbringing of your dog before choosing to take it home. Lastly, finding your dog from a shelter, helps give a good home to a dog who may not find one so readily.</text>
					</content>
				</accordion>
			</example>
		</>

		<section label="Compact" sticky="stack" collapsible dividing>
			<example "Compact" description="An accordion can reduce its padding to appear compact.">
				<segment>
					<accordion padding="compact" open="0">
						<title>What is a dog?</title>
						<content>
							<text paragraph>A dog is a type of domesticated animal. Known for its loyalty and faithfulness, it can be found as a welcome guest in many households across the world.</text>
						</content>
						<title>What kinds of dogs are there?</title>
						<content>
							<text paragraph>There are many breeds of dogs. Each breed varies in size and temperament. Owners often select a breed of dog that they find to be compatible with their own lifestyle and desires from a companion.</text>
						</content>
						<title>How do you acquire a dog?</title>
						<content>
							<text paragraph>Three common ways for a prospective owner to acquire a dog is from pet shops, private owners, or shelters.</text>
							<text paragraph>A pet shop may be the most convenient way to buy a dog. Buying a dog from a private owner allows you to assess the pedigree and upbringing of your dog before choosing to take it home. Lastly, finding your dog from a shelter, helps give a good home to a dog who may not find one so readily.</text>
						</content>
					</accordion>
				</segment>
			</example>
			<example "Compact" description="The following accordion appears very compact:  `padding=\"xs\"`.">
				<segment>
					<accordion padding="xs" open="0">
						<title>What is a dog?</title>
						<content>
							<text paragraph>A dog is a type of domesticated animal. Known for its loyalty and faithfulness, it can be found as a welcome guest in many households across the world.</text>
						</content>
						<title>What kinds of dogs are there?</title>
						<content>
							<text paragraph>There are many breeds of dogs. Each breed varies in size and temperament. Owners often select a breed of dog that they find to be compatible with their own lifestyle and desires from a companion.</text>
						</content>
						<title>How do you acquire a dog?</title>
						<content>
							<text paragraph>Three common ways for a prospective owner to acquire a dog is from pet shops, private owners, or shelters.</text>
							<text paragraph>A pet shop may be the most convenient way to buy a dog. Buying a dog from a private owner allows you to assess the pedigree and upbringing of your dog before choosing to take it home. Lastly, finding your dog from a shelter, helps give a good home to a dog who may not find one so readily.</text>
						</content>
					</accordion>
				</segment>
			</example>
		</>
	</>

	<section label="Examples">
		<section label="Nested Accordions" sticky collapsible dividing id="examples-nested-accordions">
			<example "Nested Accordions" description="An accordion can have multiple levels of nested content: a nested `<ui-accordion>` inside a panel's content. It takes its parent's look; its own `open` is its own.">
				<accordion appearance="styled" open="0">
					<title>Level 1</title>
					<content>Welcome to level 1 <accordion open="0"><title>Level 1A</title> <content><text paragraph>Level 1A Contents</text> <accordion><title>Level 1A-A</title> <content>Level 1A-A Contents</content> <title>Level 1A-B</title> <content>Level 1A-B Contents</content></accordion></content> <title>Level 1B</title> <content>Level 1B Contents</content> <title>Level 1C</title> <content>Level 1C Contents</content></accordion></content>
					<title>Level 2</title>
					<content>
						<text paragraph>Welcome to level 2</text>
						<accordion open="0">
							<title>Level 2A</title>
							<content>
								<text paragraph>Level 2A Contents</text>
								<accordion>
									<title>Level 2A-A</title>
									<content>Level 2A-A Contents</content>
									<title>Level 2A-B</title>
									<content>Level 2A-B Contents</content>
								</accordion>
							</content>
							<title>Level 2B</title>
							<content>Level 2B Contents</content>
							<title>Level 2C</title>
							<content>Level 2C Contents</content>
						</accordion>
					</content>
				</accordion>
			</example>
		</>
		<message size="small" class="site-not-ported">Not ported: Changing Trigger (<text code>selector.trigger</> / <text code>selector.ignore</>). The whole title is the native <text code>&lt;summary&gt;</> button, and a click on a link or button inside a title is already left alone.</>

		<section label="Form Fields" sticky="stack" collapsible dividing>
			<example "Form Fields" description="An accordion can be used anywhere where content can be shown or hidden.  For example, to show optional form fields.">
				<segment>
					<form>
						<fields widths="2">
							<field label="First Name">
								<input id="accordion-form-first" placeholder="First Name"/>
							</field>
							<field label="Last Name">
								<input id="accordion-form-last" placeholder="Last Name"/>
							</field>
						</fields>
						<accordion>
							<title>Optional Details</title>
							<field label="Maiden Name">
								<input id="accordion-form-maiden" placeholder="Maiden Name"/>
							</field>
						</accordion>
						<button type="submit" color="secondary">Sign Up</button>
					</form>
				</segment>
			</example>
		</>

		<section label="Any content element" sticky collapsible dividing>
			<example "Any content element" description="The content of a panel is simply the element after its title: a `<ui-content>` is usual, but any element works.">
				<accordion appearance="styled" open="0">
					<title>A list</title>
					<list bulleted>
						<item>Apples</item>
						<item>Pears</item>
					</list>
					<title>A form field</title>
					<input placeholder="Name" aria-label="Name"/>
				</accordion>
			</example>
		</>

		<!-- GAP I15:  no accordion menu (`ui vertical accordion menu`, a menu item holding a title + drawer);  left out. -->
		<message size="small" class="site-not-ported">Accordion Menu (content drawers inside a vertical menu) can't be built yet: a <text code>&lt;ui-item&gt;</> can't hold a collapsible group (plan issue I15). Use an accordion beside the menu, or <text code>&lt;ui-menu&gt;</>'s sub-menus.</>
		<message size="small" class="site-not-ported">Not ported: Right Icon (<text code>right dropdown icon</>) -- the arrow always sits before the title text, turned by the reading direction.</>
	</>
</spell-notebook>
