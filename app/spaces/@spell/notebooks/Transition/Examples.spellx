<spell-notebook "transition examples">
	<header level="1">
		Transition
		<header>A transition is an animation used to show or hide content, or to draw attention to it.</>
	</>
	<transition-tab-bar showing="examples"/>
	<section>
		<menu class="ui-docs-section-tabs" appearance="segmented" aria-label="Sections">
			<item link="#transitions">Transitions</>
			<item link="#static-animations">Static Animations</>
			<item link="#visibility">Visibility</>
			<item link="#specifying-a-direction">Specifying a direction</>
			<item link="#automatic-direction">Automatic Direction</>
			<item link="#grouped-transitions">Grouped Transitions</>
			<item link="#looping">Looping</>
			<item link="#variations">Variations</>
		</>
	</>

	<!--
		EXAMPLES:  Fomantic's page, section by section, in its order (Types, Content, States, Variations,
		Groups ...).  Rules, the class-grammar mappings, gaps:  packages/docs/content/epics/spell-ui-pages/PAGES.md.
		- A section:  `<ui-header level="2" dividing id="types">Types</ui-header>`, then its examples.
		- An example:  `<ui-example heading="..." description="...">` around the live markup;  the markup
		  IS the code shown.  A richer description:  `<p slot="description">` (+ `<ui-message slot="description">`).
		- A gap:  an HTML comment `GAP I<n>:  ...` BEFORE the example (a comment inside it shows in its code).
	-->
	<section label="Transitions">
		<message size="small" state="info">Each button toggles its leaf with an invoker command, <text code>commandfor</> + <text code>command="--toggle"</>: no script. A leaf that has gone comes back on the next click.</>

		<section label="Scale" sticky="stack" collapsible dividing>
			<example "Scale" description="An element can scale into or out of view.">
				<button size="small" commandfor="tr-scale" command="--toggle">scale</button>
				<segment appearance="basic">
					<transition id="tr-scale" animation="scale" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/1.png" alt="Autumn leaf"/>
					</transition>
				</segment>
			</example>
		</>

		<section label="Zoom" sticky="stack" collapsible dividing>
			<example "Zoom" description="An element can zoom into view from far away.">
				<button size="small" commandfor="tr-zoom" command="--toggle">zoom</button>
				<segment appearance="basic">
					<transition id="tr-zoom" animation="zoom" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/1.png" alt="Autumn leaf"/>
					</transition>
				</segment>
			</example>
		</>

		<section label="Fade" sticky="stack" collapsible dividing>
			<example "Fade" description="An element can fade into or out of view descending and ascending.">
				<button size="small" commandfor="tr-fade" command="--toggle">fade</button>
				<button size="small" commandfor="tr-fade-up" command="--toggle">fade up</button>
				<button size="small" commandfor="tr-fade-down" command="--toggle">fade down</button>
				<button size="small" commandfor="tr-fade-left" command="--toggle">fade left</button>
				<button size="small" commandfor="tr-fade-right" command="--toggle">fade right</button>
				<segment appearance="basic">
					<transition id="tr-fade" animation="fade" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/1.png" alt="Autumn leaf"/>
					</transition>
					<transition id="tr-fade-up" animation="fade up" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/3.png" alt="Autumn leaf"/>
					</transition>
					<transition id="tr-fade-down" animation="fade down" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/4.png" alt="Autumn leaf"/>
					</transition>
					<transition id="tr-fade-left" animation="fade left" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/5.png" alt="Autumn leaf"/>
					</transition>
					<transition id="tr-fade-right" animation="fade right" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/7.png" alt="Autumn leaf"/>
					</transition>
				</segment>
			</example>
		</>

		<section label="Flip" sticky="stack" collapsible dividing>
			<example "Flip" description="An element can flip into or out of view vertically or horizontally.">
				<button size="small" commandfor="tr-horizontal-flip" command="--toggle">horizontal flip</button>
				<button size="small" commandfor="tr-vertical-flip" command="--toggle">vertical flip</button>
				<segment appearance="basic">
					<transition id="tr-horizontal-flip" animation="horizontal flip" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/1.png" alt="Autumn leaf"/>
					</transition>
					<transition id="tr-vertical-flip" animation="vertical flip" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/3.png" alt="Autumn leaf"/>
					</transition>
				</segment>
			</example>
		</>

		<section label="Drop" sticky="stack" collapsible dividing>
			<example "Drop" description="An element can drop into view from above.">
				<button size="small" commandfor="tr-drop" command="--toggle">drop</button>
				<segment appearance="basic">
					<transition id="tr-drop" animation="drop" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/1.png" alt="Autumn leaf"/>
					</transition>
				</segment>
			</example>
		</>

		<section label="Fly" sticky="stack" collapsible dividing>
			<example "Fly" description="An element can fly in from off canvas.">
				<button size="small" commandfor="tr-fly-left" command="--toggle">fly left</button>
				<button size="small" commandfor="tr-fly-right" command="--toggle">fly right</button>
				<button size="small" commandfor="tr-fly-up" command="--toggle">fly up</button>
				<button size="small" commandfor="tr-fly-down" command="--toggle">fly down</button>
				<segment appearance="basic">
					<transition id="tr-fly-left" animation="fly left" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/1.png" alt="Autumn leaf"/>
					</transition>
					<transition id="tr-fly-right" animation="fly right" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/3.png" alt="Autumn leaf"/>
					</transition>
					<transition id="tr-fly-up" animation="fly up" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/4.png" alt="Autumn leaf"/>
					</transition>
					<transition id="tr-fly-down" animation="fly down" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/5.png" alt="Autumn leaf"/>
					</transition>
				</segment>
			</example>
		</>

		<section label="Swing" sticky="stack" collapsible dividing>
			<example "Swing" description="An element can swing into view.">
				<button size="small" commandfor="tr-swing-left" command="--toggle">swing left</button>
				<button size="small" commandfor="tr-swing-right" command="--toggle">swing right</button>
				<button size="small" commandfor="tr-swing-up" command="--toggle">swing up</button>
				<button size="small" commandfor="tr-swing-down" command="--toggle">swing down</button>
				<segment appearance="basic">
					<transition id="tr-swing-left" animation="swing left" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/1.png" alt="Autumn leaf"/>
					</transition>
					<transition id="tr-swing-right" animation="swing right" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/3.png" alt="Autumn leaf"/>
					</transition>
					<transition id="tr-swing-up" animation="swing up" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/4.png" alt="Autumn leaf"/>
					</transition>
					<transition id="tr-swing-down" animation="swing down" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/5.png" alt="Autumn leaf"/>
					</transition>
				</segment>
			</example>
		</>

		<section label="Browse" sticky="stack" collapsible dividing>
			<example "Browse" description="An element can appear and disappear as part of a series.">
				<button size="small" commandfor="tr-browse" command="--toggle">browse</button>
				<button size="small" commandfor="tr-browse-right" command="--toggle">browse right</button>
				<segment appearance="basic">
					<transition id="tr-browse" animation="browse" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/1.png" alt="Autumn leaf"/>
					</transition>
					<transition id="tr-browse-right" animation="browse right" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/3.png" alt="Autumn leaf"/>
					</transition>
				</segment>
			</example>
		</>

		<section label="Slide" sticky="stack" collapsible dividing>
			<example "Slide" description="An element can appear to slide in from above or below.">
				<button size="small" commandfor="tr-slide-down" command="--toggle">slide down</button>
				<button size="small" commandfor="tr-slide-up" command="--toggle">slide up</button>
				<button size="small" commandfor="tr-slide-left" command="--toggle">slide left</button>
				<button size="small" commandfor="tr-slide-right" command="--toggle">slide right</button>
				<segment appearance="basic">
					<transition id="tr-slide-down" animation="slide down" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/1.png" alt="Autumn leaf"/>
					</transition>
					<transition id="tr-slide-up" animation="slide up" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/3.png" alt="Autumn leaf"/>
					</transition>
					<transition id="tr-slide-left" animation="slide left" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/4.png" alt="Autumn leaf"/>
					</transition>
					<transition id="tr-slide-right" animation="slide right" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/5.png" alt="Autumn leaf"/>
					</transition>
				</segment>
			</example>
		</>
	</>

	<section label="Static Animations">
		<message size="small" state="info">Static (attention) animations run in place, and leave the element as it was. <text code>command="--transition"</> runs the element's <text code>animation</>, and looping pulsating needs no command at all.</>

		<section label="Pulsating" sticky="stack" collapsible dividing>
			<example "Pulsating" description="An element can have pulsating edges. This works best on circular or square elements.">
				<message slot="description" size="small">Fomantic's ring adopts the colour of the element inside; ours takes the transition's own <text code>color</text>, so give both the same one.</message>
				<transition color="green" pulsating looping inline visible>
					<label color="green">Label</label>
				</transition>
				<transition color="blue" pulsating looping inline visible>
					<label color="blue" appearance="circular">8</label>
				</transition>
				<transition color="purple" pulsating looping inline visible>
					<button color="purple">Button</button>
				</transition>
				<transition pulsating looping inline visible>
					<button>CSS only transition</button>
				</transition>
			</example>
		</>

		<section label="Jiggle" sticky="stack" collapsible dividing>
			<example "Jiggle" description="An element can jiggle to draw attention to its shape.">
				<button size="small" commandfor="tr-jiggle" command="--transition">jiggle</button>
				<segment appearance="basic">
					<transition id="tr-jiggle" animation="jiggle" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/1.png" alt="Autumn leaf"/>
					</transition>
				</segment>
			</example>
		</>

		<section label="Flash" sticky="stack" collapsible dividing>
			<example "Flash" description="An element can flash to draw attention to itself.">
				<button size="small" commandfor="tr-flash" command="--transition">flash</button>
				<segment appearance="basic">
					<transition id="tr-flash" animation="flash" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/1.png" alt="Autumn leaf"/>
					</transition>
				</segment>
			</example>
		</>

		<section label="Shake" sticky="stack" collapsible dividing>
			<example "Shake" description="An element can shake to draw attention to its position.">
				<button size="small" commandfor="tr-shake" command="--transition">shake</button>
				<segment appearance="basic">
					<transition id="tr-shake" animation="shake" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/1.png" alt="Autumn leaf"/>
					</transition>
				</segment>
			</example>
		</>

		<section label="Pulse" sticky="stack" collapsible dividing>
			<example "Pulse" description="An element can pulse to draw attention to its visibility.">
				<button size="small" commandfor="tr-pulse" command="--transition">pulse</button>
				<segment appearance="basic">
					<transition id="tr-pulse" animation="pulse" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/1.png" alt="Autumn leaf"/>
					</transition>
				</segment>
			</example>
		</>

		<section label="Tada" sticky="stack" collapsible dividing>
			<example "Tada" description="An element can give user positive feedback for an action.">
				<button size="small" commandfor="tr-tada" command="--transition">tada</button>
				<segment appearance="basic">
					<transition id="tr-tada" animation="tada" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/1.png" alt="Autumn leaf"/>
					</transition>
				</segment>
			</example>
		</>

		<section label="Bounce" sticky="stack" collapsible dividing>
			<example "Bounce" description="An element can bounce to politely remind you of itself.">
				<button size="small" commandfor="tr-bounce" command="--transition">bounce</button>
				<segment appearance="basic">
					<transition id="tr-bounce" animation="bounce" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/1.png" alt="Autumn leaf"/>
					</transition>
				</segment>
			</example>
		</>

		<section label="Glow" sticky="stack" collapsible dividing>
			<example "Glow" description="An element can glow to show its position in a page.">
				<button size="small" commandfor="tr-glow" command="--transition">glow</button>
				<segment appearance="basic">
					<transition id="tr-glow" animation="glow" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/1.png" alt="Autumn leaf"/>
					</transition>
				</segment>
			</example>
		</>
	</>

	<section label="Visibility">
		<section label="Final visibility" sticky collapsible dividing>
			<example "Final visibility" description="Once an element's animation queue finishes, its final visibility is set:  an outward transition leaves it hidden, an inward one visible. Without `visible`, the content starts hidden: out of the page and the accessibility tree.">
				<button size="small" commandfor="tr-hidden" command="--show">Show</button>
				<button size="small" commandfor="tr-hidden" command="--close">Hide</button>
				<transition id="tr-hidden" animation="drop">
					<segment>Hidden until shown</segment>
				</transition>
			</example>
		</>
	</>

	<section label="Specifying a direction">
		<section label="In and out" sticky collapsible dividing>
			<example "In and out" description="To force an animation direction, use `--show` (in) or `--close` (out), or `show()` / `hide()` from script. Showing a shown element does nothing.">
				<button size="small" commandfor="tr-direction" command="--show">fade up in</button>
				<button size="small" commandfor="tr-direction" command="--close">fade up out</button>
				<segment appearance="basic">
					<transition id="tr-direction" animation="fade up" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/4.png" alt="Autumn leaf"/>
					</transition>
				</segment>
			</example>
		</>
	</>

	<section label="Automatic Direction">
		<section label="Toggle" sticky="stack" collapsible dividing>
			<example "Toggle" description="If an animation direction is not specified it will automatically be determined based on the element's current visibility: `--toggle` (or `toggle()`) runs it out while visible, and in while hidden.">
				<button size="small" commandfor="tr-automatic" command="--toggle">fade up</button>
				<segment appearance="basic">
					<transition id="tr-automatic" animation="fade up" inline visible>
						<image size="tiny" src="/components/ui/images/leaves/7.png" alt="Autumn leaf"/>
					</transition>
				</segment>
			</example>
		</>
	</>

	<section label="Grouped Transitions">
		<!-- GAP I70:  no grouped transitions (Fomantic's `interval`, `reverse`);  each element animates on its own. -->
		<message size="small" class="site-not-ported">Not yet: Animation Intervals, Animation Order and Forcing Order. One <text code>&lt;ui-transition&gt;</> animates its own box, so a group that appears one after another (interval, reverse) needs a script calling each element's <text code>transition()</> in turn.</>
	</>

	<section label="Looping">
		<section label="Looping" sticky="stack" collapsible dividing>
			<example "Looping" description="Animation loops can be controlled by setting `looping`:  it repeats any animation until it's removed.">
				<transition animation="pulse" looping inline visible>
					<image size="tiny" src="/components/ui/images/leaves/4.png" alt="Autumn leaf"/>
				</transition>
				<transition animation="pulse" looping inline visible>
					<label color="teal">Looping</label>
				</transition>
			</example>
		</>
	</>

	<section label="Variations">
		<section label="Inverted" sticky="stack" collapsible dividing>
			<example "Inverted" description="An inverted ring for dark backgrounds.">
				<segment inverted>
					<transition pulsating looping inverted inline visible>
						<button inverted>Pulsating inverted</button>
					</transition>
				</segment>
			</example>
		</>

		<section label="Display Type" sticky="stack" collapsible dividing>
			<example "Display Type" description="Animations can be used on any display type, not just block level elements:  `inline` keeps a button an inline block while it animates.">
				<button size="small" commandfor="tr-inline" command="--transition">Jiggle the button</button>
				<divider/>
				<transition id="tr-inline" animation="jiggle" inline visible>
					<button icon="user">Sign-up</button>
				</transition>
			</example>
		</>

		<section label="Disabled" sticky="stack" collapsible dividing>
			<example "Disabled" description="A disabled transition pauses its running animation.">
				<transition pulsating looping disabled inline visible>
					<button>Paused</button>
				</transition>
			</example>
		</>
	</>
</spell-notebook>
