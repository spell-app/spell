<!--
  Spell's own app as a site:  a page per screen, each with a thumbnail of how it looks today.
  What opens over a page is a dialog or a sidebar, opened from the buttons above its thumbnail.
  Most addresses name a project, so they aren't in the navigation:  Home links to one of each.
-->

<spell-page "home page" thumbnail="snapshots/home.jpg">
	<spell-stories>
		- [x] open an example, a guide, a notebook or one of my projects from its card
		- [x] start from a blank app, a small starter or Solitaire
		- [x] make a project, an example or a guide from its group's header
		- [x] bring back a project I exported
	</>
	<draw>
		<stack direction="horizontal" wrap spacing="s">
			<button appearance="basic" onClick={show the new project dialog}>New Project</button>
			<link link={"/edit/@spell/examples/Solitaire"}>The code editor</link>
			<link link={"/run/@spell/examples/Solitaire"}>A running app</link>
			<link link={"/edit/@spell/guides/SpellUI/Accordion/Usage.spellml"}>A notebook</link>
			<link link={"/edit/@spell/guides/a-first-spell"}>A guide</link>
			<link link={"/site/@spell/examples/StarWarsSite"}>The site editor</link>
			<link link={"/apps/@spell/examples/TaskList"}>A hosted app</link>
		</stack>
		draw its thumbnail
	</draw>
</>

<spell-page "notebook page" thumbnail="snapshots/notebook.jpg">
	<spell-stories>
		- [x] read a notebook, its words and its code in cells
	</>
	<property "notebook" description="What the address names">text</property>
</>

<spell-page "guide page" thumbnail="snapshots/guide.jpg">
	<spell-stories>
		- [x] read a guide in the editor, its words as the comments of its spell file
	</>
	<property "guide" description="What the address names">text</property>
</>

<spell-page "code editor page" thumbnail="snapshots/edit.jpg">
	<spell-stories>
		- [x] change the code in its file tabs, with the running app beside it
		- [x] see the program's output, its compiled code and what I can use, in the Program panel under the code
		- [x] pick a part of the running app and change it in the Inspector
		- [x] add a part from the palette
		- [x] undo, save, discard my changes and publish a draft
		- [x] move between Run, Edit and, for a site, Site
	</>
	<property "project" description="What the address names">text</property>
	<draw>
		<stack direction="horizontal" wrap spacing="s">
			<button appearance="basic" onClick={show the inspector sidebar}>Inspector</button>
			<button appearance="basic" onClick={show the palette sidebar}>Palette</button>
			<button appearance="basic" onClick={show the project settings dialog}>Project Settings</button>
			<button appearance="basic" onClick={show the code settings dialog}>Code Editor Settings</button>
			<button appearance="basic" onClick={show the project versions dialog}>Versions</button>
			<button appearance="basic" onClick={show the new file dialog}>New File</button>
			<button appearance="basic" onClick={show the duplicate project dialog}>Duplicate Project</button>
			<button appearance="basic" onClick={show the change this dialog}>Change This</button>
			<button appearance="basic" onClick={show the publish clash dialog}>Publish Clash</button>
			<button appearance="basic" onClick={show the person dialog}>You</button>
		</stack>
		draw its thumbnail
	</draw>
</>

<spell-page "running app page" thumbnail="snapshots/run.jpg">
	<spell-stories>
		- [x] use the program by itself, with no code showing
		- [x] restart it
	</>
	<property "project" description="What the address names">text</property>
</>

<spell-page "site editor page" thumbnail="snapshots/site-pages.jpg">
	<spell-stories>
		- [x] see a site's pages as a tree and a board of cards
		- [x] drag a row to move a page, with its pages
		- [x] change a page's name, title, address and state
		- [x] write what a page must let people do, as stories
		- [x] open a page's code from its card
	</>
	<property "project" description="What the address names">text</property>
	<draw>
		<stack direction="horizontal" wrap spacing="s">
			<button appearance="basic" onClick={show the site data sidebar}>Data</button>
		</stack>
		draw its thumbnail
	</draw>
</>

<spell-page "theme editor page" thumbnail="snapshots/theme.jpg">
	<spell-stories>
		- [x] change a theme and see it on real pages
		- [x] save it by name, to pick from every theme menu
	</>
</>

<spell-page "hosted app page" thumbnail="snapshots/hosted-program.jpg">
	<spell-stories>
		- [x] use a program at its own address on Spell's cloud
	</>
	<property "project" description="What the address names">text</property>
	<draw>
		<stack direction="horizontal" wrap spacing="s">
			<button appearance="basic" onClick={show the sign-in dialog}>Sign In</button>
		</stack>
		draw its thumbnail
	</draw>
</>

<spell-page "terms page" thumbnail="snapshots/terms.jpg">
	<spell-stories>
		- [x] read Spell's terms
	</>
</>

<spell-view "inspector sidebar" thumbnail="snapshots/inspector.jpg"/>

<spell-view "palette sidebar" thumbnail="snapshots/palette.jpg"/>

<spell-view "site data sidebar" thumbnail="snapshots/site-data.jpg"/>

<spell-view "project settings dialog" thumbnail="snapshots/project-settings.jpg"/>

<spell-view "code settings dialog" thumbnail="snapshots/code-settings.jpg"/>

<spell-view "project versions dialog" thumbnail="snapshots/versions.jpg"/>

<spell-view "new file dialog" thumbnail="snapshots/new-file.jpg"/>

<spell-view "new project dialog" thumbnail="snapshots/new-project.jpg"/>

<spell-view "duplicate project dialog" thumbnail="snapshots/duplicate-project.jpg"/>

<spell-view "change this dialog" thumbnail="snapshots/change-this.jpg"/>

<spell-view "publish clash dialog" thumbnail="snapshots/publish-clash.jpg"/>

<spell-view "person dialog" thumbnail="snapshots/you.jpg"/>

<spell-view "sign-in dialog" thumbnail="snapshots/sign-in.jpg"/>

<spell-site "spell app">
	<page "home page" address="/" title="Home" state="old" color="red"/>
	<page "notebook page" address="/edit/@spell/guides/SpellUI/:notebook*" title="Notebook" state="old" color="orange"/>
	<page "guide page" address="/edit/@spell/guides/:guide" title="Guide" state="old" color="yellow"/>
	<page "code editor page" address="/edit/:project*" title="Edit" state="old" color="olive">
		<page "running app page" address="/run/:project*" title="Run" state="old"/>
	</>
	<page "site editor page" address="/site/:project*" title="Site Editor" state="old" color="green"/>
	<page "theme editor page" address="/theme" title="Theme Editor" state="old" color="teal"/>
	<page "hosted app page" address="/apps/:project*" title="Hosted App" state="old" color="blue">
		<page "terms page" address="/terms" title="Terms" state="old"/>
	</>
	<sidebar "inspector sidebar"/>
	<sidebar "palette sidebar"/>
	<sidebar "site data sidebar"/>
	<dialog "project settings dialog"/>
	<dialog "code settings dialog"/>
	<dialog "project versions dialog"/>
	<dialog "new file dialog"/>
	<dialog "new project dialog"/>
	<dialog "duplicate project dialog"/>
	<dialog "change this dialog"/>
	<dialog "publish clash dialog"/>
	<dialog "person dialog"/>
	<dialog "sign-in dialog"/>
	<page "not found page"/>
	<page "error page"/>
</>
