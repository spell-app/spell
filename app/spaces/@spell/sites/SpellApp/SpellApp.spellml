<!--
  Spell's own app as a site:  a page per screen, each showing a picture of how it looks today.
  What opens over a page is a dialog or a sidebar, opened from the buttons above its picture.
  Most addresses name a project, so they aren't in the navigation:  Home links to one of each.
-->

<spell-view "picture">
	<property "file" description="The picture's file, in snapshots/, without its .jpg">text</property>
	<draw>
		<image src={"/spaces/@spell/sites/SpellApp/snapshots/" + its file + ".jpg"}/>
	</draw>
</>

<spell-page "home page">
	<spell-stories>
		- [x] open an example, a guide, a notebook or one of my projects from its card
		- [x] start from a blank app, a small starter or Solitaire
		- [x] make a project, an example or a guide from its group's header
		- [x] bring back a project I exported
	</>
	<draw>
		<stack direction="horizontal" wrap spacing="s">
			<button appearance="basic" onClick={show the new project dialog}>New Project</button>
			<link link={"/edit/@spell/examples/Solitaire"}>The code editor</link>
			<link link={"/run/@spell/examples/Solitaire"}>A running app</link>
			<link link={"/edit/@spell/guides/SpellUI/Accordion/Usage.spellml"}>A notebook</link>
			<link link={"/edit/@spell/guides/a-first-spell"}>A guide</link>
			<link link={"/site/@spell/examples/StarWarsSite"}>The site editor</link>
			<link link={"/apps/@spell/examples/TaskList"}>A hosted app</link>
		</stack>
		draw (a new picture with file = "home")
	</draw>
</>

<spell-page "notebook page">
	<spell-stories>
		- [x] read a notebook, its words and its code in cells
	</>
	<property "notebook" description="What the address names">text</property>
	<draw>
		draw (a new picture with file = "notebook")
	</draw>
</>

<spell-page "guide page">
	<spell-stories>
		- [x] read a guide in the editor, its words as the comments of its spell file
	</>
	<property "guide" description="What the address names">text</property>
	<draw>
		draw (a new picture with file = "guide")
	</draw>
</>

<spell-page "code editor page">
	<spell-stories>
		- [x] change the code in its file tabs, with the running app beside it
		- [x] see the program's output, its compiled code and what I can use, in the Program panel under the code
		- [x] pick a part of the running app and change it in the Inspector
		- [x] add a part from the palette
		- [x] undo, save, discard my changes and publish a draft
		- [x] move between Run, Edit and, for a site, Site
	</>
	<property "project" description="What the address names">text</property>
	<draw>
		<stack direction="horizontal" wrap spacing="s">
			<button appearance="basic" onClick={show the inspector sidebar}>Inspector</button>
			<button appearance="basic" onClick={show the palette sidebar}>Palette</button>
			<button appearance="basic" onClick={show the project settings dialog}>Project Settings</button>
			<button appearance="basic" onClick={show the code settings dialog}>Code Editor Settings</button>
			<button appearance="basic" onClick={show the project versions dialog}>Versions</button>
			<button appearance="basic" onClick={show the new file dialog}>New File</button>
			<button appearance="basic" onClick={show the duplicate project dialog}>Duplicate Project</button>
			<button appearance="basic" onClick={show the change this dialog}>Change This</button>
			<button appearance="basic" onClick={show the publish clash dialog}>Publish Clash</button>
			<button appearance="basic" onClick={show the person dialog}>You</button>
		</stack>
		draw (a new picture with file = "edit")
	</draw>
</>

<spell-page "running app page">
	<spell-stories>
		- [x] use the program by itself, with no code showing
		- [x] restart it
	</>
	<property "project" description="What the address names">text</property>
	<draw>
		draw (a new picture with file = "run")
	</draw>
</>

<spell-page "site editor page">
	<spell-stories>
		- [x] see a site's pages as a tree and a board of cards
		- [x] drag a row to move a page, with its pages
		- [x] change a page's name, title, address and state
		- [x] write what a page must let people do, as stories
		- [x] open a page's code from its card
	</>
	<property "project" description="What the address names">text</property>
	<draw>
		<stack direction="horizontal" wrap spacing="s">
			<button appearance="basic" onClick={show the site data sidebar}>Data</button>
		</stack>
		draw (a new picture with file = "site-pages")
	</draw>
</>

<spell-page "theme editor page">
	<spell-stories>
		- [x] change a theme and see it on real pages
		- [x] save it by name, to pick from every theme menu
	</>
	<draw>
		draw (a new picture with file = "theme")
	</draw>
</>

<spell-page "hosted app page">
	<spell-stories>
		- [x] use a program at its own address on Spell's cloud
	</>
	<property "project" description="What the address names">text</property>
	<draw>
		<stack direction="horizontal" wrap spacing="s">
			<button appearance="basic" onClick={show the sign-in dialog}>Sign In</button>
		</stack>
		draw (a new picture with file = "hosted-program")
	</draw>
</>

<spell-page "terms page">
	<spell-stories>
		- [x] read Spell's terms
	</>
	<draw>
		draw (a new picture with file = "terms")
	</draw>
</>

<spell-view "inspector sidebar">
	<draw>
		draw (a new picture with file = "inspector")
	</draw>
</>

<spell-view "palette sidebar">
	<draw>
		draw (a new picture with file = "palette")
	</draw>
</>

<spell-view "site data sidebar">
	<draw>
		draw (a new picture with file = "site-data")
	</draw>
</>

<spell-view "project settings dialog">
	<draw>
		draw (a new picture with file = "project-settings")
	</draw>
</>

<spell-view "code settings dialog">
	<draw>
		draw (a new picture with file = "code-settings")
	</draw>
</>

<spell-view "project versions dialog">
	<draw>
		draw (a new picture with file = "versions")
	</draw>
</>

<spell-view "new file dialog">
	<draw>
		draw (a new picture with file = "new-file")
	</draw>
</>

<spell-view "new project dialog">
	<draw>
		draw (a new picture with file = "new-project")
	</draw>
</>

<spell-view "duplicate project dialog">
	<draw>
		draw (a new picture with file = "duplicate-project")
	</draw>
</>

<spell-view "change this dialog">
	<draw>
		draw (a new picture with file = "change-this")
	</draw>
</>

<spell-view "publish clash dialog">
	<draw>
		draw (a new picture with file = "publish-clash")
	</draw>
</>

<spell-view "person dialog">
	<draw>
		draw (a new picture with file = "you")
	</draw>
</>

<spell-view "sign-in dialog">
	<draw>
		draw (a new picture with file = "sign-in")
	</draw>
</>

<spell-site "spell app">
	<page "home page" address="/" title="Home" state="old" picture="snapshots/home.jpg" color="red"/>
	<page "notebook page" address="/edit/@spell/guides/SpellUI/:notebook*" title="Notebook" state="old" picture="snapshots/notebook.jpg" color="orange"/>
	<page "guide page" address="/edit/@spell/guides/:guide" title="Guide" state="old" picture="snapshots/guide.jpg" color="yellow"/>
	<page "code editor page" address="/edit/:project*" title="Edit" state="old" picture="snapshots/edit.jpg" color="olive">
		<page "running app page" address="/run/:project*" title="Run" state="old" picture="snapshots/run.jpg"/>
	</>
	<page "site editor page" address="/site/:project*" title="Site Editor" state="old" picture="snapshots/site-pages.jpg" color="green"/>
	<page "theme editor page" address="/theme" title="Theme Editor" state="old" picture="snapshots/theme.jpg" color="teal"/>
	<page "hosted app page" address="/apps/:project*" title="Hosted App" state="old" picture="snapshots/hosted-program.jpg" color="blue">
		<page "terms page" address="/terms" title="Terms" state="old" picture="snapshots/terms.jpg"/>
	</>
	<sidebar "inspector sidebar" picture="snapshots/inspector.jpg"/>
	<sidebar "palette sidebar" picture="snapshots/palette.jpg"/>
	<sidebar "site data sidebar" picture="snapshots/site-data.jpg"/>
	<dialog "project settings dialog" picture="snapshots/project-settings.jpg"/>
	<dialog "code settings dialog" picture="snapshots/code-settings.jpg"/>
	<dialog "project versions dialog" picture="snapshots/versions.jpg"/>
	<dialog "new file dialog" picture="snapshots/new-file.jpg"/>
	<dialog "new project dialog" picture="snapshots/new-project.jpg"/>
	<dialog "duplicate project dialog" picture="snapshots/duplicate-project.jpg"/>
	<dialog "change this dialog" picture="snapshots/change-this.jpg"/>
	<dialog "publish clash dialog" picture="snapshots/publish-clash.jpg"/>
	<dialog "person dialog" picture="snapshots/you.jpg"/>
	<dialog "sign-in dialog" picture="snapshots/sign-in.jpg"/>
	<page "not found page"/>
	<page "error page"/>
</>
