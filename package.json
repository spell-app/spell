{
  "name": "spell",
  "private": true,
  "description": "The top repo:  the ONE install over Spell's child repos (spell-util, spell-server, spell-element, spell-lang, spell-ui, spell-brand, spell-epic, spell-app), the list of them, and the commands over them",
  "license": "MIT",
  "repository": "https://github.com/spell-app/spell-hub",
  "workspaces": [
    "spell-*"
  ],
  "type": "module",
  "scripts": {
    "/////// THE CHILD REPOS (tools/repos.ts, repos.json5)": "",
    "clone": "node tools/repos.ts clone",
    "pull": "node tools/repos.ts pull",
    "status": "node tools/repos.ts status",
    "repos": "node tools/repos.ts list",
    "/////// CHECKS OVER EVERY REPO, lowest first": "",
    "ts": "node tools/repos.ts run ts",
    "test": "node tools/repos.ts run test",
    "lint": "node tools/repos.ts run lint",
    "review": "node tools/repos.ts run review"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "json5": "^2.2.3"
  },
  "resolutions": {
    "@solidjs/babel-plugin": "2.0.0-rc.13",
    "@solidjs/compiler": "2.0.0-rc.13",
    "@solidjs/h": "2.0.0-rc.13",
    "@solidjs/signals": "2.0.0-rc.13",
    "@solidjs/web": "2.0.0-rc.13",
    "axe-core": "4.13.0",
    "solid-js": "2.0.0-rc.13",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "yarn@4.18.0"
}
