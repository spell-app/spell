{
  "name": "spell-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Spell's kit:  the layer every repo stands on (util, toolchain, server, element, its tools and test helpers, the spell command), the house style, and the ONE install over the child repos",
  "license": "MIT",
  "repository": "https://github.com/spell-app/spell-kit",
  "bin": {
    "spell": "./bin/spell.mjs",
    "spell-pack": "./bin/spell-pack.mjs",
    "spell-types": "./bin/spell-types.ts"
  },
  "workspaces": [
    "spell-*"
  ],
  "type": "module",
  "sideEffects": [
    "./src/element/HotDefinitions.ts",
    "./src/test-helpers/Fixture.ts",
    "./src/toolchain/**",
    "./src/server/**",
    "./src/element-tools/**",
    "./src/cli/**",
    "./bin/**",
    "./scripts/**",
    "./tools/**"
  ],
  "exports": {
    "./toolchain/lint/imports": {
      "spell-kit-source": "./src/toolchain/lint.imports.ts",
      "types": "./dist-types/src/toolchain/lint.imports.d.ts",
      "default": "./src/toolchain/lint.imports.ts"
    },
    "./toolchain/lint/patterns": {
      "spell-kit-source": "./src/toolchain/lint.patterns.ts",
      "types": "./dist-types/src/toolchain/lint.patterns.d.ts",
      "default": "./src/toolchain/lint.patterns.ts"
    },
    "./toolchain/tsconfig.base.json": "./src/toolchain/tsconfig.base.json",
    "./toolchain/types": "./src/toolchain/types/index.d.ts",
    "./toolchain/*": {
      "spell-kit-source": "./src/toolchain/*.ts",
      "types": "./dist-types/src/toolchain/*.d.ts",
      "default": "./src/toolchain/*.ts"
    },
    "./server/checkout": {
      "spell-kit-source": "./src/server/checkout.ts",
      "types": "./dist-types/src/server/checkout.d.ts",
      "default": "./src/server/checkout.ts"
    },
    "./server/page/settings": {
      "spell-kit-source": "./src/server/page/settings.ts",
      "types": "./dist-types/src/server/page/settings.d.ts",
      "default": "./src/server/page/settings.ts"
    },
    "./server/page/prune": {
      "spell-kit-source": "./src/server/page/prune.ts",
      "types": "./dist-types/src/server/page/prune.d.ts",
      "default": "./src/server/page/prune.ts"
    },
    "./server/DataFile": {
      "spell-kit-source": "./src/server/DataFile.ts",
      "types": "./dist-types/src/server/DataFile.d.ts",
      "default": "./src/server/DataFile.ts"
    },
    "./server/contentFolder": {
      "spell-kit-source": "./src/server/contentFolder.ts",
      "types": "./dist-types/src/server/contentFolder.d.ts",
      "default": "./src/server/contentFolder.ts"
    },
    "./util/node/json5": {
      "spell-kit-source": "./src/util/node/json5.ts",
      "types": "./dist-types/src/util/node/json5.d.ts",
      "default": "./src/util/node/json5.ts"
    },
    "./util": {
      "spell-kit-source": "./src/util/index.ts",
      "types": "./dist-types/src/util/index.d.ts",
      "default": "./src/util/index.ts"
    },
    "./util/reactive": {
      "spell-kit-source": "./src/util/reactive/index.ts",
      "types": "./dist-types/src/util/reactive/index.d.ts",
      "default": "./src/util/reactive/index.ts"
    },
    "./util/spell": {
      "spell-kit-source": "./src/util/spell/index.ts",
      "types": "./dist-types/src/util/spell/index.d.ts",
      "default": "./src/util/spell/index.ts"
    },
    "./server": {
      "spell-kit-source": "./src/server/index.ts",
      "types": "./dist-types/src/server/index.d.ts",
      "default": "./src/server/index.ts"
    },
    "./server/page": {
      "spell-kit-source": "./src/server/page/index.ts",
      "types": "./dist-types/src/server/page/index.d.ts",
      "default": "./src/server/page/index.ts"
    },
    "./server/site": {
      "spell-kit-source": "./src/server/site/index.ts",
      "types": "./dist-types/src/server/site/index.d.ts",
      "default": "./src/server/site/index.ts"
    },
    "./element": {
      "spell-kit-source": "./src/element/index.ts",
      "types": "./dist-types/src/element/index.d.ts",
      "default": "./src/element/index.ts"
    },
    "./cli": {
      "spell-kit-source": "./src/cli/index.ts",
      "types": "./dist-types/src/cli/index.d.ts",
      "default": "./src/cli/index.ts"
    },
    "./*": {
      "spell-kit-source": [
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx",
        "./src/*"
      ],
      "types": [
        "./dist-types/src/*.d.ts",
        "./dist-types/src/*/index.d.ts"
      ],
      "default": "./src/*"
    },
    "./*.ts": {
      "spell-kit-source": "./src/*.ts",
      "types": "./dist-types/src/*.d.ts",
      "default": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "/////// THE KIT'S OWN CHECKS:  one browser program (tsconfig.json), one node program (tsconfig.node.json), the tests' (tests/tsconfig.json);  one Vitest config of projects;  one lint config": "",
    "kit:ts": "node bin/spell-types.ts && tsc -p tests",
    "kit:test": "vp test run",
    "kit:lint": "vp lint --report-unused-disable-directives --max-warnings 0 src bin scripts tools tests vite.config.ts vitest.config.ts",
    "kit:lint:fix": "vp lint --fix src bin scripts tools tests vite.config.ts vitest.config.ts",
    "kit:format": "vp fmt .",
    "kit:format:check": "vp fmt --check .",
    "kit:review": "yarn kit:ts && yarn kit:lint:fix && yarn kit:format && yarn kit:test && echo '== REVIEW PASSED\n===========\n'",
    "/////// THE spell COMMAND (src/cli/, bin/spell.mjs)": "",
    "spell": "node bin/spell.mjs",
    "cli:install": "node scripts/install-cli.mjs",
    "server": "node bin/spell.mjs server",
    "favicon": "tsx --tsconfig tsconfig.node.json scripts/favicon.ts",
    "postinstall": "node tools/repos.ts links",
    "/////// THE CHILD REPOS (tools/repos.ts, repos.json5)": "",
    "clone": "node tools/repos.ts clone",
    "pull": "node tools/repos.ts pull",
    "status": "node tools/repos.ts status",
    "repos": "node tools/repos.ts list",
    "/////// THE READMES (tools/readme-check.ts, tools/mermaid-pretty.ts):  the root pages of every repo": "",
    "readme:check": "node tools/readme-check.ts",
    "mermaid:pretty": "node tools/mermaid-pretty.ts",
    "/////// CHECKS OVER EVERY REPO, lowest first": "",
    "ts": "node tools/repos.ts run ts",
    "test": "node tools/repos.ts run test",
    "lint": "node tools/repos.ts run lint",
    "review": "node tools/repos.ts run review"
  },
  "dependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.51",
    "chalk": "^5.6.0",
    "commander": "^14",
    "esbuild": "^0.28.2",
    "global": "^4.3.2",
    "json5": "^2.2.3",
    "json5-writer": "^0.2.0",
    "lightningcss": "^1.33.0",
    "linkedom": "^0.18.13",
    "lodash": "^4.17.21",
    "node-storage-shim": "^2.0.1",
    "parse5": "^7.3.0",
    "pluralize": "^8.0.0",
    "query-string": "^6.12.1",
    "tsx": "4.20.3",
    "vite-plus": "catalog:"
  },
  "devDependencies": {
    "@solidjs/web": "2.0.0-rc.17",
    "@types/lodash": "^4.17.17",
    "@types/node": "^22.20.4",
    "@types/pluralize": "^0.0.33",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/browser-playwright": "catalog:",
    "axe-core": "^4.13.0",
    "playwright": "1.63.0",
    "solid-js": "2.0.0-rc.17",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@solidjs/web": "2.0.0-rc.17",
    "axe-core": "^4.13.0",
    "solid-js": "2.0.0-rc.17"
  },
  "peerDependenciesMeta": {
    "@solidjs/web": {
      "optional": true
    },
    "axe-core": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "resolutions": {
    "@solidjs/babel-plugin": "2.0.0-rc.17",
    "@solidjs/compiler": "2.0.0-rc.17",
    "@solidjs/h": "2.0.0-rc.17",
    "@solidjs/signals": "2.0.0-rc.17",
    "@solidjs/web": "2.0.0-rc.17",
    "axe-core": "4.13.0",
    "solid-js": "2.0.0-rc.17",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "yarn@4.18.0",
  "spell": {
    "commands": "./src/cli/commands.ts"
  },
  "spellTypes": [
    "tsconfig.json",
    "tsconfig.node.json"
  ]
}
