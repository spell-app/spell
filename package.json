{
  "name": "spell-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Spell's kit:  the layer every repo stands on (util, toolchain, server, assembler, element), the house style, and the ONE install over the child repos",
  "license": "MIT",
  "repository": "https://github.com/spell-app/spell-kit",
  "workspaces": [
    "spell-*"
  ],
  "type": "module",
  "sideEffects": [
    "./element/src/HotDefinitions.ts",
    "./element/test-helpers/Fixture.ts",
    "./toolchain/**",
    "./server/**",
    "./assembler/**",
    "./element/tools/**",
    "./tools/**",
    "./cli/**"
  ],
  "bin": {
    "spell": "./cli/bin/spell.mjs",
    "spell-folders": "./toolchain/bin/spell-folders.ts",
    "spell-pack": "./element/bin/spell-pack.mjs",
    "spell-types": "./toolchain/bin/spell-types.ts"
  },
  "spell": {
    "commands": "./cli/commands.ts"
  },
  "spellTypes": [
    "util",
    "server",
    "assembler",
    "element",
    "element/tools",
    "cli"
  ],
  "spellFolders": [
    {
      "name": "toolchain"
    },
    {
      "name": "util",
      "node": true
    },
    {
      "name": "server",
      "lint": [
        "src",
        "test",
        "scripts"
      ],
      "node": true
    },
    {
      "name": "assembler",
      "node": true
    },
    {
      "name": "element",
      "lint": [
        "src",
        "test-helpers"
      ]
    },
    {
      "name": "element/tools",
      "lint": [
        "."
      ],
      "node": true
    },
    {
      "name": "cli",
      "lint": [
        "src",
        "bin",
        "scripts",
        "commands.ts"
      ],
      "node": true
    },
    {
      "name": "tools",
      "lint": [
        "."
      ]
    }
  ],
  "exports": {
    "./util": {
      "types": "./dist-types/util/src/index.d.ts",
      "default": "./util/src/index.ts"
    },
    "./util/class": {
      "types": "./dist-types/util/src/class.d.ts",
      "default": "./util/src/class.ts"
    },
    "./util/decorators": {
      "types": "./dist-types/util/src/decorators.d.ts",
      "default": "./util/src/decorators.ts"
    },
    "./util/dom": {
      "types": "./dist-types/util/src/dom.d.ts",
      "default": "./util/src/dom.ts"
    },
    "./util/node/json5": {
      "types": "./dist-types/util/src/node/json5.d.ts",
      "default": "./util/src/node/json5.ts"
    },
    "./util/reactive/cells": {
      "types": "./dist-types/util/src/reactive/cells.d.ts",
      "default": "./util/src/reactive/cells.ts"
    },
    "./util/spell/Derivative": {
      "types": "./dist-types/util/src/spell/Derivative.d.ts",
      "default": "./util/src/spell/Derivative.ts"
    },
    "./util/spell/Logger": {
      "types": "./dist-types/util/src/spell/Logger.d.ts",
      "default": "./util/src/spell/Logger.ts"
    },
    "./util/spell/ResponseErrors": {
      "types": "./dist-types/util/src/spell/ResponseErrors.d.ts",
      "default": "./util/src/spell/ResponseErrors.ts"
    },
    "./util/string": {
      "types": "./dist-types/util/src/string.d.ts",
      "default": "./util/src/string.ts"
    },
    "./util/util.types": {
      "types": "./dist-types/util/src/util.types.d.ts",
      "default": "./util/src/util.types.ts"
    },
    "./toolchain/aliases": "./toolchain/src/aliases.ts",
    "./toolchain/declarations": "./toolchain/src/declarations.ts",
    "./toolchain/decorators": "./toolchain/src/decorators.ts",
    "./toolchain/lint": "./toolchain/src/lint.ts",
    "./toolchain/lint/imports": "./toolchain/src/lint.imports.ts",
    "./toolchain/lint/patterns": "./toolchain/src/lint.patterns.ts",
    "./toolchain/packageVersion": "./toolchain/src/packageVersion.ts",
    "./toolchain/tsconfig.base.json": "./toolchain/tsconfig.base.json",
    "./toolchain/types": "./toolchain/types/index.d.ts",
    "./server": {
      "types": "./dist-types/server/src/index.d.ts",
      "default": "./server/src/index.ts"
    },
    "./server/checkout": {
      "types": "./dist-types/server/src/checkout.d.ts",
      "default": "./server/src/checkout.ts"
    },
    "./server/page": {
      "types": "./dist-types/server/src/page/index.d.ts",
      "default": "./server/src/page/index.ts"
    },
    "./server/page/prune": {
      "types": "./dist-types/server/src/page/prune.d.ts",
      "default": "./server/src/page/prune.ts"
    },
    "./server/page/settings": {
      "types": "./dist-types/server/src/page/settings.d.ts",
      "default": "./server/src/page/settings.ts"
    },
    "./server/site": {
      "types": "./dist-types/server/src/site/index.d.ts",
      "default": "./server/src/site/index.ts"
    },
    "./server/site/site.types": {
      "types": "./dist-types/server/src/site/site.types.d.ts",
      "default": "./server/src/site/site.types.ts"
    },
    "./server/test/serve": {
      "types": "./dist-types/server/test/serve.d.ts",
      "default": "./server/test/serve.ts"
    },
    "./server/test/checkouts": {
      "types": "./dist-types/server/test/checkouts.d.ts",
      "default": "./server/test/checkouts.ts"
    },
    "./assembler": {
      "types": "./dist-types/assembler/src/index.d.ts",
      "default": "./assembler/src/index.ts"
    },
    "./assembler/contentFolder": {
      "types": "./dist-types/assembler/src/contentFolder.d.ts",
      "default": "./assembler/src/contentFolder.ts"
    },
    "./assembler/DataFile": {
      "types": "./dist-types/assembler/src/DataFile.d.ts",
      "default": "./assembler/src/DataFile.ts"
    },
    "./element": {
      "types": "./dist-types/element/src/index.d.ts",
      "default": "./element/src/index.ts"
    },
    "./element/elements.types": {
      "types": "./dist-types/element/src/elements.types.d.ts",
      "default": "./element/src/elements.types.ts"
    },
    "./element/HotDefinitions": {
      "types": "./dist-types/element/src/HotDefinitions.d.ts",
      "default": "./element/src/HotDefinitions.ts"
    },
    "./element/SkeletonText": {
      "types": "./dist-types/element/src/SkeletonText.d.ts",
      "default": "./element/src/SkeletonText.ts"
    },
    "./element/timing": {
      "types": "./dist-types/element/src/timing.d.ts",
      "default": "./element/src/timing.ts"
    },
    "./element/vocabulary.types": {
      "types": "./dist-types/element/src/vocabulary.types.d.ts",
      "default": "./element/src/vocabulary.types.ts"
    },
    "./element/tools/*": {
      "types": "./dist-types/element/tools/*.d.ts",
      "default": "./element/tools/*.ts"
    },
    "./test-helpers/*": {
      "types": "./dist-types/element/test-helpers/*.d.ts",
      "default": "./element/test-helpers/*.ts"
    },
    "./cli": {
      "types": "./dist-types/cli/src/index.d.ts",
      "default": "./cli/src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "/////// THE KIT'S OWN CHECKS (spell-folders, its \"spellFolders\"):  util, toolchain, server, assembler, element, cli, tools": "",
    "kit:ts": "node toolchain/bin/spell-folders.ts ts",
    "kit:test": "node toolchain/bin/spell-folders.ts test",
    "kit:lint": "node toolchain/bin/spell-folders.ts lint",
    "kit:lint:fix": "node toolchain/bin/spell-folders.ts lint:fix",
    "kit:format": "node toolchain/bin/spell-folders.ts format",
    "kit:format:check": "node toolchain/bin/spell-folders.ts format:check",
    "kit:review": "yarn kit:ts && yarn kit:lint:fix && yarn kit:format && yarn kit:test && echo '== REVIEW PASSED\n===========\n'",
    "/////// THE spell COMMAND (cli/)": "",
    "spell": "node cli/bin/spell.mjs",
    "cli:install": "node cli/scripts/install-cli.mjs",
    "server": "node cli/bin/spell.mjs server",
    "favicon": "tsx --tsconfig server/tsconfig.json server/scripts/favicon.ts",
    "postinstall": "node tools/repos.ts links",
    "/////// THE CHILD REPOS (tools/repos.ts, repos.json5)": "",
    "clone": "node tools/repos.ts clone",
    "pull": "node tools/repos.ts pull",
    "status": "node tools/repos.ts status",
    "repos": "node tools/repos.ts list",
    "/////// THE READMES (tools/readme-check.ts, tools/mermaid-pretty.ts):  the root pages of every repo": "",
    "readme:check": "node tools/readme-check.ts",
    "mermaid:pretty": "node tools/mermaid-pretty.ts",
    "/////// CHECKS OVER EVERY REPO, lowest first": "",
    "ts": "node tools/repos.ts run ts",
    "test": "node tools/repos.ts run test",
    "lint": "node tools/repos.ts run lint",
    "review": "node tools/repos.ts run review"
  },
  "dependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "chalk": "^5.6.0",
    "commander": "^14",
    "esbuild": "^0.28.2",
    "global": "^4.3.2",
    "json5": "^2.2.3",
    "json5-writer": "^0.2.0",
    "lightningcss": "^1.33.0",
    "linkedom": "^0.18.13",
    "lodash": "^4.17.21",
    "node-storage-shim": "^2.0.1",
    "parse5": "^7.3.0",
    "pluralize": "^8.0.0",
    "query-string": "^6.12.1",
    "tsx": "4.20.3",
    "vite-plus": "catalog:"
  },
  "devDependencies": {
    "@solidjs/web": "2.0.0-rc.13",
    "@types/lodash": "^4.17.17",
    "@types/node": "^22.20.4",
    "@types/pluralize": "^0.0.33",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/browser-playwright": "catalog:",
    "axe-core": "^4.13.0",
    "playwright": "1.63.0",
    "solid-js": "2.0.0-rc.13",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@solidjs/web": "2.0.0-rc.13",
    "axe-core": "^4.13.0",
    "solid-js": "2.0.0-rc.13"
  },
  "peerDependenciesMeta": {
    "@solidjs/web": {
      "optional": true
    },
    "axe-core": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "resolutions": {
    "@solidjs/babel-plugin": "2.0.0-rc.13",
    "@solidjs/compiler": "2.0.0-rc.13",
    "@solidjs/h": "2.0.0-rc.13",
    "@solidjs/signals": "2.0.0-rc.13",
    "@solidjs/web": "2.0.0-rc.13",
    "axe-core": "4.13.0",
    "solid-js": "2.0.0-rc.13",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "yarn@4.18.0"
}
