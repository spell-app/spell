{
  // element's tests:  element's own settings (element/tsconfig.json) over this folder, with no Spell UI:  they draw on
  // its stand-in settings and helpers, in its `test-helpers/`
  "extends": "../../element/tsconfig.json",
  // and element's own folders, so its source and helpers are compiled with the tests
  "include": [".", "../../element/src", "../../element/test-helpers"],
  // the element tools' tests are node code, on the tools' own settings:  `tools/tsconfig.json`
  "exclude": ["tools"]
}
