{
  // The kit's glue scripts (`repos.ts`, `readme-check.ts`, `mermaid-pretty.ts`):  node code that node runs as is,
  // its types stripped;  its own folder of the kit's checks (`"spellFolders"`), its tests in `tests/tools/`.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["."],
  "exclude": ["node_modules"]
}
