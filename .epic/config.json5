// The kit's epic settings (the top repo, `spell`, since epic `repo-split` P9):  where a session working HERE
// (`~/www/spell`, every window's folder 1) keeps its epic things.
// - Read by spell-epic's `EpicConfig` (epic/src/config/EpicConfig.ts), as every repo's `.epic/config.json5` is:
//   epic `epic-engine` P10 (spell-epic as a workspace of this install) and epic `repo-split` P9 (the multi-repo
//   tooling) are what read it here.
// - Folders are relative to the MAIN checkout of this repo:  `~/www/spell`.
// - Written in P7 for P9:  the folders are this layout's;  the keys marked GUESS are P9's to settle.
// - A key left out takes its default (`EpicConfig.DEFAULTS`);  `epic config [key]` prints what's in force.
{
  // No "repos":  ONE repo since epic `repo-split` P20, so an epic's worktree is ONE worktree of `spell` (spell-epic's
  // single-repo mode).  Until then it named `repos.json5`, the child repos, each with a worktree inside the kit's.
  // - spell-brand, a project beside the kit, gets its own worktrees:  epic `epic-engine` P49 (its Q49).

  // The shared content repo:  epics, guides, sagas, pages, brand, and the three logs (the kit's `agents/` links them).
  // - In this repo, git-ignored (epic `repo-split` J5):  `~/www/spell/spell.epics`, a folder of its own in the main
  //   checkout, a link to it in an epic's worktree.
  "contentFolder": "spell.epics",

  // The branch worktrees start from and merge into.
  "baseBranch": "main",

  // Where an epic's worktree goes:  one worktree of `spell`.
  "worktreesFolder": "../spell.worktrees",

  // What makes a new worktree ready to run, from its root:  the ONE install, over the kit and its folders.
  "installCommand": "yarn install",
  // The worktree hook runs it BEFORE the window opens, within "installTimeout" seconds (600 left out).
  "installOnCreate": true,
  // The yarn projects of their OWN in an epic's worktree, outside the one install (epic `epic-engine` I65):
  // the two VS Code extensions.
  // - The hook runs "installCommand" in each, after the one above;  one that fails is a warning.
  "extraInstalls": ["epic/vscode", "app/vscode"],

  // The VS Code windows (`epic window`).
  "windows": {
    // The window a worktree's window is opened from, when the session's own window isn't one:
    // `<windowsFolder>/<default>.code-workspace`, the whole top repo's.
    "default": "spell",
    // The repo root's folder name in every window:  folder 1, so the Claude panel lists every repo's sessions.
    "repoName": "spell",
    // The content repo's folder name in every window.
    "contentName": "spell.epics",
    // A worktree's window holds the worktree, then the content repo:  no main checkout (Owen, 2026-10-22).  Quick
    // Open listed every file twice with it there, the main checkout's beside the worktree's.  The Claude panel still
    // lists every session:  each worktree's saved-session folder links to the main one's ("linkSessionFolders").
    "worktreeOnly": true
  },

  // Whether the worktree hook links each NEW worktree's saved-session folder to the main checkout's,
  // so every window's Claude panel lists every session.
  "linkSessionFolders": true,

  // The content folder's folders every checkout links in at its root (`epic shared link`):
  // none here (epic-engine P10).
  // - WWOD and the logs:  the kit TRACKS `agents/` (epic `repo-split` P9):
  //   `agents/wwod/`, and links for the three logs into the content repo's `agents/`.
  "sharedFolders": [],

  // The kit's old GitHub address, to its new one:  renamed in epic `repo-split` P17 (GitHub redirects the old one).
  // - Epic pages started before then record the old address (`repo`):  `EpicRepo` reads it as this repo's
  //   (epic `epic-engine` I150), so their sessions aren't told they're in the wrong repo.
  "renamedRepos": { "https://github.com/spell-app/spell-kit": "https://github.com/spell-app/spell" },

  // The epic engine:  the spell-epic child repo, already inside the top repo, so no link (`""`, epic-engine P10).
  "engineFolder": "",

  // The VS Code window files, each machine's own:  the content repo's `windows/`, git-ignored there.
  "windowsFolder": "spell.epics/windows",

  // The VOICES pages are written in (epic `readme` P13;  `epic voice`):  a name each, its file from here.
  // - `code`:  docstrings, comments, AGENTS.md files, epic pages:  WWOD's writing rules, §6 and its spoke.
  // - `readme` (READMEs, guides) is spell-epic's own, `voices/readme.md`, plus WWOD §6's Spell additions.
  // - The child repos read the kit's:  they have no voices of their own.
  "voices": { "code": "agents/wwod/writing.md" },

  // Fixes to how a checkout is set up, that every checkout gets at once:  main and each worktree, however far behind
  // main its branch is (spell-epic's `CheckoutPatches`, epic `epic-engine` P17).
  // - The session-start hook applies them in the background;  `epic worktree patch --all` does it everywhere now.
  // - `copy`:  main's file, put in each checkout that doesn't track it yet, git-excluded there;  once the branch merges
  //   main it tracks the file, and the patch does nothing there.  `run`:  a command, run once in each checkout.
  "checkoutPatches": [
    {
      "id": "vscode-ignore",
      "date": "2026-10-22",
      "why": "VS Code's Open File and search find the child repos' files again (the .gitignore leaves them out)",
      "copy": ".ignore"
    }
  ]
}
