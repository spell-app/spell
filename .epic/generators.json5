// This repo's GENERATED files, and the command that rebuilds each from the merged source (epic `epic-eject` T4;
// the kit's own, then its folders', each folder's list until epic `repo-split` P20 merged them in, paths now from the
// repo's root;  the folders' own `.epic/generators.json5` were never read after that, and are gone).
// - Read by `epic worktree merge-main` (`MainMerge.generatorsOf()`), from the checkout being merged:
//   a branch that adds a generated file adds its line here, and its merge already knows it.
// - IN ORDER:  a later one may read an earlier one's output (the spell libraries read the syntax table).
// - Each line's keys:
//   - `outputs`:  globs, from the repo's root
//   - `cwd`:  where `run` runs, from the repo's root
// - Vitest's `.snap` files aren't here:  the merge makes one update per package, after these.
//   The content snapshots are (`toMatchFileSnapshot()`'s own files, which no `.snap` update rewrites).
// - The same paths are `merge=binary` in the `.gitattributes` beside them (each folder keeps its own):  keep the two in
//   step.
// - `yarn.lock` is the kit's too (the one install), but not listed here.
{
  "generators": [
    {
      "name": "spell syntax table",
      "outputs": ["parser/src/spell/spellSyntax.json"],
      "cwd": "parser",
      "run": ["yarn", "spell:gen:syntax"]
    },
    {
      "name": "Spell UI theme sheets",
      "outputs": [
        "ui/src/styles/themes/{spell,glass,fruity,merlot,paper,midnight,crisp,pop,matrix}.css",
        "ui/src/styles/themes/palettes/apple.css",
        "ui/src/styles/themes/theme.schema.json"
      ],
      "cwd": "ui",
      "run": ["yarn", "gen:styles"]
    },
    {
      "name": "Spell UI site data",
      "outputs": [
        "ui/docs/__data/{components,icons,search}.json5",
        "ui/docs/__data/{custom-elements,html-custom-data,css-custom-data}.json"
      ],
      "cwd": "ui",
      "run": ["yarn", "site:data"]
    },
    {
      "name": "spell libraries",
      "outputs": ["app/spaces/@spell/library/**/*.lib.ts"],
      "cwd": "app",
      "run": ["node", "../bin/spell.mjs", "compile", "@spell/library"]
    },
    {
      // the @spell space's content snapshots:  its examples' and Spell guides' compiled output and what each prints
      // (epic `content` P2);  the bless step of `spell content check --bless`, which rewrites them all at once
      "name": "content snapshots",
      "outputs": [
        "app/tests/spell/__examples__/**",
        "app/tests/spell/__guides__/**",
        "app/tests/cli/__snapshots__/contract/**"
      ],
      "cwd": "app",
      "run": ["yarn", "spell:test:fixtures:bless"]
    },
    {
      "name": "App UI data",
      "outputs": ["app/app/docs/__data/{components,search}.json5"],
      "cwd": "app",
      "run": ["yarn", "site:data"]
    }
  ]
}
