{
  // The TypeScript settings every package shares (epic `repo-split` P6):  what each package's `tsconfig.json`
  // said alike, before.  Each repo's alias table (`tsconfig.base.json` at its root, epic `repo-split` P8) extends it
  // by name, and every package's `tsconfig.json` extends that table:  `"extends": "../tsconfig.base.json"`.
  // - NOT the alias table (`paths`):  that's each repo's own, at its root (`$/` inside a repo, WWOD §4).
  // - What differs by package stays in its own:  `target`, `lib`, `types`, `jsx`, `allowJs`.
  // - The global types (`Prettify`, `Class` ...):  `"types": [..., "spell/toolchain/types"]`, where a package
  //   wants them (`types/index.d.ts` here).
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  }
}
