{
  // The kit's `cli/`:  the `spell` command's base, and the settings `tsx` runs EVERY repo's commands under
  // (`bin/spell.mjs` hands this file to `tsx`, which takes one tsconfig for every file it runs):
  // - `jsx: react-jsx`:  spell-app's terminal screens (Ink, React for terminals)
  // - `target: ES2020`:  standard decorators lowered, for spell-lang's source
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "allowJs": true,
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": ["src", "commands.ts"],
  "exclude": ["node_modules"]
}
