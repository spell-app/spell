---
/**
 * Icon browser:  every Font Awesome Free icon `$/icons` ships, searchable, click to copy the name.
 * - Exercises the icon data pipeline for real:  names come from `Icons.names()`, glyphs from `Icons.get()`,
 *   so browsing loads one glyph module per icon shown (`src/icons/glyphs/<style>/<name>.js`) lazily, as
 *   `ui-icon` does.
 * - ONE set for solid + regular:  each icon with a regular version is followed by its `<name> outline` tile,
 *   so you can see which icons HAVE an outline without switching sets.  Brands stay a set of their own.
 * - Every tile's label is exactly what `name` takes:  `bell`, `bell outline`, `github`.
 * - "Names" switches the labels between Font Awesome's and Fomantic's vocabulary (`fomantic-names.json`,
 *   docs-site-only data, like `search.json`).  A Fomantic name that CLASHES with a Font Awesome name (`x`,
 *   `warning`) is marked:  it only means Fomantic's icon under `<html ui-icon-names="fomantic">`.
 * - Search also matches Font Awesome's search terms (`search.json`, docs-site-only data, keyed by solid name;
 *   an outline tile matches its solid icon's terms).
 * - Renders the first 300 matches, then "Show more" in steps of 300:  cheap enough without a virtual list.
 */
import Docs from "../layouts/Docs.astro"
---

<Docs
  title="Icons"
  summary="Every Font Awesome 7 Free icon, by name.  Fomantic's names work too:  they resolve to these."
  wide
>
  <div class="ui-stack ui-gap-m site-icons" data-icons>
    <div class="ui-split ui-gap-s">
      <div class="site-segmented" role="group" aria-label="Icon style" data-styles>
        <button type="button" class="site-segment" aria-pressed="true" data-set="icons">Icons</button>
        <button type="button" class="site-segment" aria-pressed="false" data-set="brands">Brands</button>
      </div>
      <div class="site-segmented" role="group" aria-label="Icon names" data-vocabularies>
        <button type="button" class="site-segment" aria-pressed="true" data-vocabulary="fontawesome">Font Awesome</button>
        <button type="button" class="site-segment" aria-pressed="false" data-vocabulary="fomantic">Fomantic</button>
      </div>
      <label class="ui-flex ui-align-items-center ui-gap-xs site-icons-search">
        <span class="ui-visually-hidden-force">Search icons</span>
        <input type="search" placeholder="Search icons, e.g. arrow, mail, heart" autocomplete="off" data-search />
      </label>
    </div>
    <p class="ui-caption ui-m-0" aria-live="polite" data-count>Loading icons...</p>
    <p class="ui-caption ui-m-0" data-clash-note hidden>
      * clashes with a Font Awesome name:  draws this icon only under <code>&lt;html ui-icon-names="fomantic"&gt;</code>,
      Font Awesome's otherwise.
    </p>
    <ul class="site-icon-grid ui-grid ui-list-plain ui-gap-xs" role="list" data-grid></ul>
    <div class="ui-flex ui-justify-content-center">
      <button type="button" data-more hidden>Show more</button>
    </div>
    <p class="ui-visually-hidden-force" aria-live="assertive" data-announce></p>
  </div>
  <p class="ui-caption">
    Icons:  <a href="https://fontawesome.com">Font Awesome 7 Free</a> (CC BY 4.0).  Name aliases derived from{" "}
    <a href="https://github.com/fomantic/Fomantic-UI">Fomantic-UI</a> (MIT).
  </p>
</Docs>

<script>
  import { Icons, type IconStyle } from "$/icons"

  /** How many icons each page of results adds. */
  const PAGE_SIZE = 300

  /**
   * State and rendering for the icon browser.
   * - `entries` is the current set's full list, `matches` the filtered one, `shown` how many are rendered.
   * - A render "generation" counter drops stale async results when the set or query changes mid-load.
   */
  class IconBrowser {
    private set: IconSet = "icons"
    private vocabulary: IconVocabulary = "fontawesome"
    private query = ""
    private entries: IconEntry[] = []
    private matches: IconEntry[] = []
    private shown = 0
    private generation = 0
    /** Font Awesome search terms per solid icon, loaded on first search */
    private terms?: Record<string, string[]>

    constructor(private readonly root: HTMLElement) {}

    /** Wire the controls and render the default style. */
    async start() {
      for (const button of this.root.querySelectorAll<HTMLButtonElement>("[data-set]")) {
        button.addEventListener("click", () => void this.setSet(button.dataset.set as IconSet))
      }
      for (const button of this.root.querySelectorAll<HTMLButtonElement>("[data-vocabulary]")) {
        button.addEventListener("click", () => {
          this.vocabulary = button.dataset.vocabulary as IconVocabulary
          for (const other of this.root.querySelectorAll<HTMLButtonElement>("[data-vocabulary]")) {
            other.setAttribute("aria-pressed", String(other === button))
          }
          void this.setSet(this.set)
        })
      }
      this.el<HTMLInputElement>("[data-search]").addEventListener("input", (event) => {
        this.query = (event.target as HTMLInputElement).value.trim().toLowerCase()
        void this.filter()
      })
      this.el("[data-more]").addEventListener("click", () => void this.renderMore())
      this.el("[data-grid]").addEventListener("click", (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>("[data-name]")
        if (button) void this.copy(button.dataset.name!)
      })
      await this.setSet("icons")
    }

    /** Switch set:  load its entries, then re-filter. */
    private async setSet(set: IconSet) {
      this.set = set
      for (const button of this.root.querySelectorAll<HTMLButtonElement>("[data-set]")) {
        button.setAttribute("aria-pressed", String(button.dataset.set === set))
      }
      const generation = ++this.generation
      this.el("[data-count]").textContent = "Loading icons..."
      const entries =
        this.vocabulary === "fomantic" ? await IconBrowser.fomanticEntries(set) : await IconBrowser.entries(set)
      if (generation !== this.generation) return
      this.el("[data-clash-note]").hidden = !entries.some((entry) => entry.clash)
      this.entries = entries
      await this.filter()
    }

    /**
     * Every tile in `set`, sorted by icon.
     * - `icons`:  each solid icon, followed by `<name> outline` when it also has a regular version
     *   (regular is a subset of solid:  no icon is regular-only)
     */
    private static async entries(set: IconSet): Promise<IconEntry[]> {
      if (set === "brands") {
        return (await Icons.names("brands")).sort().map((name) => ({ label: name, name, style: "brands" as const }))
      }
      const [solid, regular] = await Promise.all([Icons.names("solid"), Icons.names("regular")])
      const outlined = new Set(regular)
      return solid.sort().flatMap((name) => {
        const entry: IconEntry = { label: name, name, style: "solid" }
        return outlined.has(name) ? [entry, { label: `${name} outline`, name, style: "regular" }] : [entry]
      })
    }

    /**
     * Every Fomantic name in `set`, sorted by name:  `bell`, `bell outline`, ... `github` (brands).
     * - Many Fomantic names draw the same icon (`setting`, `cog`);  each gets its own tile.
     */
    private static async fomanticEntries(set: IconSet): Promise<IconEntry[]> {
      const [names, clashes] = await Promise.all([
        import("$/icons/data/fomantic-names.json"),
        import("$/icons/data/fomantic-clashes.json")
      ])
      const clashing = clashes.default as Record<string, string>
      return Object.entries(names.default as Record<string, string>).flatMap(([label, target]) => {
        const [style, name] = target.split("/") as [IconStyle, string]
        if ((style === "brands") !== (set === "brands")) return []
        return [{ label, name, style, clash: label in clashing }]
      })
    }

    /** Apply the search query and render the first page. */
    private async filter() {
      const query = this.query
      if (query && this.set === "icons" && !this.terms) {
        this.terms = (await import("$/icons/data/search.json")).default as Record<string, string[]>
      }
      const terms = this.set === "icons" ? this.terms : undefined
      this.matches = query
        ? this.entries.filter(
            (entry) =>
              entry.label.includes(query) ||
              terms?.[entry.name]?.some((term) => term.toLowerCase().includes(query)) === true
          )
        : this.entries
      this.el("[data-grid]").replaceChildren()
      this.shown = 0
      await this.renderMore()
    }

    /** Render the next `PAGE_SIZE` matches, loading their chunks first. */
    private async renderMore() {
      const generation = this.generation
      const batch = this.matches.slice(this.shown, this.shown + PAGE_SIZE)
      const data = await Promise.all(batch.map((entry) => Icons.get(entry.name, entry.style)))
      if (generation !== this.generation) return
      const items = batch.map((entry, index) => {
        const item = document.createElement("li")
        const button = document.createElement("button")
        button.type = "button"
        button.className = "site-icon"
        button.dataset.name = entry.label
        button.title = `Copy "${entry.label}"`
        const glyph = data[index]
        if (glyph) button.append(Icons.svg(glyph))
        const label = document.createElement("span")
        label.textContent = entry.clash ? `${entry.label} *` : entry.label
        if (entry.clash) button.title += `;  * clashes with Font Awesome's "${entry.label}"`
        button.append(label)
        item.append(button)
        return item
      })
      this.el("[data-grid]").append(...items)
      this.shown += batch.length
      const more = this.el<HTMLButtonElement>("[data-more]")
      more.hidden = this.shown >= this.matches.length
      more.textContent = `Show more (${this.matches.length - this.shown} left)`
      this.el("[data-count]").textContent =
        `${this.matches.length} of ${this.entries.length} ${this.set === "brands" ? "brand icons" : "icons"}` +
        (this.shown < this.matches.length ? `, showing ${this.shown}` : "")
    }

    /** Copy `name` to the clipboard and announce it. */
    private async copy(name: string) {
      const announce = this.el("[data-announce]")
      try {
        await navigator.clipboard.writeText(name)
        announce.textContent = `Copied ${name}`
      } catch {
        announce.textContent = `Couldn't copy ${name}`
      }
    }

    /** The one element matching `selector` inside the browser;  MUST exist. */
    private el<T extends HTMLElement = HTMLElement>(selector: string): T {
      return this.root.querySelector<T>(selector)!
    }
  }

  /** Which list the browser shows:  solid + outline together, or brands. */
  type IconSet = "icons" | "brands"

  /** Whose names label the tiles. */
  type IconVocabulary = "fontawesome" | "fomantic"

  /** One tile. */
  type IconEntry = {
    /** shown and copied:  exactly what `<ui-icon name>` takes, e.g. `bell outline` */
    label: string
    /** Font Awesome name of the glyph */
    name: string
    style: IconStyle
    /** Fomantic name that means a DIFFERENT icon unless the page opts in to Fomantic names */
    clash?: boolean
  }

  const root = document.querySelector<HTMLElement>("[data-icons]")
  if (root) void new IconBrowser(root).start()
</script>
