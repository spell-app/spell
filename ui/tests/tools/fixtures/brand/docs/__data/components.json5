            "swing down",
            "swing left",
            "swing right",
            "horizontal flip",
            "vertical flip",
            "flash",
            "shake",
            "bounce",
            "tada",
            "pulse",
            "jiggle",
            "glow",
            "none"
          ],
          "shared": true,
          "description": "How it shows and hides (Fomantic's names:  `fade up`, `scale`, `fly down` ...);  default its family's, else `fade`.  `none` turns motion off for it and everything inside it, as the person's reduced-motion setting does;  an element inside can't turn it back on."
        }
      ],
      "slots": [
        {
          "name": "",
          "description": "The app:  its title, cards, controls.  Each child is spaced 12px apart."
        }
      ],
      "events": [],
      "parts": [
        {
          "name": "phone",
          "description": "The frame:  a `<section>`, the region named `label`."
        },
        {
          "name": "status",
          "description": "The status bar (hidden from screen readers)."
        },
        {
          "name": "time",
          "description": "The status bar's clock."
        },
        {
          "name": "icons",
          "description": "The status bar's signal, wifi and battery icons."
        }
      ],
      "states": [
