{
  // Spell UI's tests:  its browser settings (`../tsconfig.json`), over this folder
  "extends": "../tsconfig.json",
  // and Spell UI's own source, as its tsconfig includes it:  the JSX tags and Vitest types it declares reach the tests;
  // the node tools too, which `src/tools/` and the static render's tests reach
  "include": [".", "../src", "../site/_src"],
  // the `spell` commands' tests:  node, with the commands' own settings (`../tsconfig.node.json`);
  // the JSX types and their test:  programs of their own (`../tsconfig.jsx.json`, `jsx/`)
  "exclude": ["cli", "../src/cli", "jsx", "../src/jsx.ts"]
}
