{
  "name": "@spell/ui",
  "version": "0.0.1",
  "description": "Fomantic UI's vocabulary as modern-CSS web components",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/index.ts",
    "./dist/index.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean": "rm -rf ./.cache ./build ./dist ./coverage ./test-results",
    "/////// CORRECTNESS": "",
    "review": "yarn ts && yarn lint:fix && yarn format && yarn test && echo '== REVIEW PASSED\n===========\n'",
    "ts": "echo '>>>>>>>>>>>\n>> RUNNING TSC' && tsc && tsc -p tsconfig.node.json && echo '<< TSC PASSED\n'",
    "lint": "echo '>>>>>>>>>>>\n>> LINTING WITH OXLINT' && oxlint --report-unused-disable-directives --max-warnings 0 && echo '<< OXLINT PASSED\n'",
    "lint:fix": "echo '>>>>>>>>>>>\n>> LINTING WITH OXLINT --fix' && oxlint --fix && echo '<< OXLINT PASSED\n'",
    "format": "echo '>>>>>>>>>>>\n>> FORMATTING WITH OXFMT' && oxfmt . && echo '<< OXFMT PASSED\n'",
    "format:check": "oxfmt --check .",
    "/////// TESTING": "",
    "test": "echo '>>>>>>>>>>>\n>> RUNNING TESTS' && vitest run && echo '<< TESTS PASSED\n'",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:all": "UI_TEST_ALL=1 vitest run",
    "test:visual": "vitest run visual.test --passWithNoTests",
    "/////// DOCS SITE": "",
    "site:dev": "yarn --cwd site dev",
    "site:build": "yarn --cwd site build",
    "site:preview": "yarn --cwd site preview",
    "site:check": "yarn --cwd site check",
    "test:browsers": "playwright install chromium firefox webkit",
    "/////// GENERATED": "",
    "gen:styles": "tsc -p scripts && tsx scripts/gen-styles.ts",
    "gen:icons": "tsc -p scripts && tsx scripts/gen-icons.ts",
    "/////// MANIFEST": "",
    "manifest": "custom-elements-manifest analyze --globs 'src/**/*.ts' --exclude 'src/**/*.test.ts'"
  },
  "dependencies": {
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.20.4",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/browser-playwright": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.17"
  },
  "packageManager": "yarn@4.18.0"
}
