  "scripts": {
    "dev": "vp dev --open /src/tools/demo/index.html",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "clean": "rm -rf ./.cache ./build ./dist ./dist-types ./coverage ./test-results ./vendor ./results ./src/tools/frameworks/solid/dist",
    "/////// CORRECTNESS": "",
    "review": "yarn ts && yarn lint:fix && yarn format && yarn test && echo '== REVIEW PASSED\n===========\n'",
    "ts": "echo '>>>>>>>>>>>\\n>> RUNNING TSC' && spell-types --below && spell-types && tsc -p ./tests && tsc -p ./tests/cli && echo '<< TSC PASSED\\n'",
    "lint": "echo '>>>>>>>>>>>\\n>> LINTING WITH OXLINT' && vp lint --report-unused-disable-directives --max-warnings 0 src scripts site/_src && cd ./tests && vp lint --report-unused-disable-directives --max-warnings 0 . && echo '<< OXLINT PASSED\\n'",
    "lint:fix": "echo '>>>>>>>>>>>\\n>> LINTING WITH OXLINT --fix' && vp lint --fix src scripts site/_src && cd ./tests && vp lint --fix . && echo '<< OXLINT PASSED\\n'",
    "format": "echo '>>>>>>>>>>>\n>> FORMATTING WITH OXFMT' && vp fmt . && cd ./tests && vp fmt . && echo '<< OXFMT PASSED\n'",
    "format:check": "vp fmt --check . && cd ./tests && vp fmt --check .",
    "/////// TESTING": "",
    "test": "echo '>>>>>>>>>>>\n>> RUNNING TESTS' && vp test run --project ssr && vp test run --project browser && echo '<< TESTS PASSED\n'",
    "test:watch": "vp test",
    "test:ui": "vp test --ui",
    "test:all": "vp test run --project ssr && SPELL_UI_TEST_ALL=1 vp test run --project browser",
    "test:visual": "tsx src/tools/visual/cli.ts",
    "test:visual:update": "tsx src/tools/visual/cli.ts --update",
    "test:hmr": "tsx src/tools/hmr.e2e.ts",
    "test:browsers": "playwright install chromium firefox webkit",
    "/////// PACKAGE TOOLING (src/tools/)": "",
    "vendor": "tsx src/tools/cli.ts vendor",
    "measure": "tsx src/tools/cli.ts measure",
    "smoke": "vp build --logLevel warn && tsx src/tools/cli.ts declarations && tsx src/tools/cli.ts smoke",
    "serve": "tsx src/tools/cli.ts serve",
    "report": "tsx src/tools/cli.ts report",
    "icons:pack": "tsx src/tools/cli.ts icons:pack",
    "screenshots": "tsx src/tools/screenshots.ts",
    "/////// DOCS SITE": "",
    "site:dev": "tsx scripts/site-dev.ts",
    "site:data": "tsc -p tsconfig.node.json && tsx scripts/site-data.ts",
    "site:index": "tsx scripts/site-index.ts",
    "site:kitchen": "tsx scripts/site-kitchen.ts",
    "site:bundle": "tsx scripts/site-bundle.ts",
    "site:build": "yarn site:data && yarn site:index && yarn site:kitchen && yarn site:bundle",
    "site:new": "tsc -p tsconfig.node.json && tsx scripts/site-new.ts",
    "site:sections": "tsx scripts/site-sections.ts",
    "site:check": "tsx scripts/site-check.ts",
    "readme:components": "tsx scripts/readme-components.ts",
    "/////// GENERATED": "",
    "gen:styles": "tsc -p tsconfig.node.json && tsx scripts/gen-styles.ts",
    "gen:icons": "tsc -p tsconfig.node.json && tsx scripts/gen-icons.ts",
    "gen:emoji": "tsc -p tsconfig.node.json && tsx scripts/gen-emoji.ts",
    "gen:root": "tsc -p tsconfig.node.json && tsx scripts/gen-root.ts",
    "tokens:alias": "tsx scripts/tokens-alias.ts",
    "/////// DESIGN SYSTEM (claude.ai)": "",
    "design:build": "tsc -p tsconfig.node.json && tsx scripts/design-build.ts",
    "/////// MANIFEST": "",
    "manifest": "custom-elements-manifest analyze --globs 'src/**/*.ts' 'src/**/*.tsx'"
  },
