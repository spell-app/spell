// This repo's GENERATED files, and the command that rebuilds each from the merged source
// (epic `epic-eject` T4;  spell-ui's own since epic `repo-split` P8 cut it from spell-app).
// - Read by `epic worktree merge-main` (`MainMerge.generatorsOf()`), from the checkout being merged:
//   a branch that adds a generated file adds its line here, and its merge already knows it.
// - IN ORDER:  a later one may read an earlier one's output.
// - Each line's keys:
//   - `outputs`:  globs, from the repo's root
//   - `cwd`:  where `run` runs, from the repo's root
// - Snapshots aren't here:  the merge makes one update per package, after these.
// - The same paths are `merge=binary` in `.gitattributes`:  keep the two in step.
// - No `yarn.lock`:  the top repo `spell` holds the one install for every repo.
{
  "generators": [
    {
      "name": "Spell UI theme sheets",
      "outputs": [
        "src/styles/themes/{spell,glass,fruity,merlot,paper,midnight,crisp,pop}.css",
        "src/styles/themes/palettes/apple.css",
        "src/styles/themes/theme.schema.json"
      ],
      "cwd": ".",
      "run": ["yarn", "gen:styles"]
    },
    {
      "name": "Spell UI site data",
      "outputs": [
        "docs/__data/{components,icons,search}.json5",
        "docs/__data/{custom-elements,html-custom-data,css-custom-data}.json"
      ],
      "cwd": ".",
      "run": ["yarn", "site:data"]
    }
  ]
}
