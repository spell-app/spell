{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "paths": {
      "$/*": ["../../src/*"],
      "$test/*": ["../../test/*"],
      "$shared/*": ["../shared/*"]
    }
  },
  "include": ["src", "demo"],
  // the root config excludes `spike/`;  an inherited `exclude` would drop every file here
  "exclude": ["node_modules", "dist"]
}
