{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "paths": {}
  },
  "include": ["*.ts", "frameworks/**/*.ts", "frameworks/**/*.tsx", "tests/**/*.ts"],
  // the root config excludes `spike/`, which would exclude everything here
  "exclude": ["node_modules", "vendor", "frameworks/solid/dist"]
}
