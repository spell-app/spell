{
  "name": "@spell/ui-spike-shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared spike tooling:  bundle measurer, perf harness, LOC counter, report tables, framework host pages, smoke runner",
  "type": "module",
  "scripts": {
    "build": "node --experimental-strip-types --no-warnings build.ts",
    "ts": "tsc --noEmit",
    "lint": "../../node_modules/.bin/oxlint --report-unused-disable-directives --max-warnings 0",
    "format": "../../node_modules/.bin/oxfmt .",
    "format:check": "../../node_modules/.bin/oxfmt --check ."
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.46",
    "@solidjs/web": "2.0.0-rc.11",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "solid-js": "2.0.0-rc.11",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "packageManager": "yarn@4.18.0"
}
