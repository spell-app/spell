{
  // Spell UI's JSX types (`src/jsx.ts`, `spell-ui/jsx`), a TypeScript program of their own:  generated by
  // `yarn site:data`, they type-check and build their declarations (`spell-types`) here, apart from `tsconfig.json`.
  // - Why apart:  they make every `<ui-*>` tag's JSX exact, and Spell UI's own JSX still writes some tags loosely
  //   (the docs elements' `DocsJSXTags`), so in its program the two would clash.
  // - Their test:  `tests/jsx/`, its own program too.
  "extends": "./tsconfig.json",
  "include": ["src/jsx.ts"],
  "exclude": []
}
