// Matrix:  a dark ops console, as a Spell UI theme.
// - One of Spell's own themes, the set `UI.themes.own` lists;  applied ON TOP of `classic.css`,
//   so every classic token it replaces is restated here.
// - Its sheet, `matrix.css`, is GENERATED from this file:  `yarn gen:styles` (`ThemeFile`;  epic `debut` P18).
//   What values can't say is in its rules sheets:  `rules/modern.css`, `rules/states.css` (its secondary's states), `rules/matrix.css` (headings, eyebrows, table headers).
// - Owen, 2026-10-26:  "make a new theme "matrix" based on this", a screenshot of a rack viewer:  a live fabric inventory.
// - What makes it Matrix:
//   - dark, its home:  a near-black page with a cold green-grey cast and a faint glow from the top, panels only just
//     off it (#0d1518 on #0a1013), standing off by their hairline edges and a slight lift, not by being brighter
//   - Owen, on the first version:  "You lost some subtelty in Matrix, e.g. surfgace colors, slight highlight in the
//     page gradient, fonts, ALL CAPS headers (SJC • SW-B17, table headers)";  so every value is measured off his
//     screenshot (debut I76)
//   - ONE mint accent (the eyebrows, the live dots, the counts that are fine), amber for what needs attention,
//     coral for what's wrong
//   - big heavy headings, tightly tracked (the display cut of the system font);  eyebrows and table headers in the
//     monospace, uppercase and spaced out;  body text a muted grey-green
//   - light, "daylight":  the same subtlety:  a cool grey-green page with a white haze at the top, panels a hair
//     lighter on hairlines, the mint deepened so white reads on it
//   - Inter for headings, the system font and its monospace for the rest;
//     6px chips, 8px controls, 14px cards and panels, 18px modals
//     (the box round a thing always rounder than it)
//   - Apple's system colours for the hues (its palette, `apple`)
// - ONE font file ships:  Inter for the headings (`matrix/`, latin only, self-hosted);  body and monospace are the
//   platform's own.
{
  "$schema": "./theme.schema.json",
  "palette": "apple",
  "rules": ["modern", "states", "matrix"],
  "own": {
    // Measured off Owen's screenshot (the SJC rack viewer), pixel by pixel:  the panels only just off the page,
    // standing off by their hairline edges and a slight lift, never by being brighter
    "matrix-page": { "light": "#e9eeec", "dark": "#0a1013" },
    "matrix-panel": { "light": "#f2f6f4", "dark": "#0d1518" },
    // a raised strip on a panel:  a table's rows, the chosen tab
    "matrix-raised": { "light": "#fafcfb", "dark": "#172124" },
    // what sits in a panel:  a table's well, a tab bar's track, code
    "matrix-inset": { "light": "#e6ecea", "dark": "#0b1215" },
    // an input:  a hair under the panel it's on
    "matrix-field": { "light": "#f8fbfa", "dark": "#0d1316" },
    "matrix-border": { "light": "#d3ddd9", "dark": "#1b2528" },
    "matrix-border-strong": { "light": "#bccac5", "dark": "#283437" },
    "matrix-accent": { "light": "#0b7552", "dark": "#a3e1c0" },
    "matrix-on-accent": { "light": "#ffffff", "dark": "#03231a" },
    "matrix-accent-wash": { "light": "#0b75521a", "dark": "#a3e1c01f" },
    "matrix-accent-text": { "light": "#0a6648", "dark": "#a3e1c0" },
    // amber, bright in both schemes, ink on it (as a warning light);  its text a deep amber in light
    "matrix-amber": { "light": "#e8a334", "dark": "#f2c778" },
    "matrix-on-amber": "#2a1a00",
    "matrix-coral": { "light": "#b5392b", "dark": "#e79583" },
    // the page's highlight:  a soft glow from the top, right of centre, under the header (`rules/matrix.css`);
    // 5% mint at its brightest in dark (#0a1013 => #111b1c), a white haze in light
    "matrix-glow": "radial-gradient(27% 300px at 73% 60px, light-dark(#ffffffb3, #a3e1c00d), transparent)"
  },
  "typography": {
    "size": "15px",
    "family": {
      "body": "system-ui, -apple-system, \"Segoe UI\", \"Noto Sans\", Cantarell, Ubuntu, \"Helvetica Neue\", Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Noto Color Emoji\"",
      // Inter (`rules/matrix.css`'s `@font-face`), its display cut at heading sizes;  the system font behind it
      "heading": "\"Inter Matrix\", {typography.family.body}",
      "mono": "ui-monospace, \"SF Mono\", \"JetBrains Mono\", Menlo, Consolas, monospace",
      // `<ui-text serif>`, `sans-serif`, `typewriter` and `subhead` (epic `elemental-spell` P26)
      "serif": "Palatino, \"Palatino Linotype\", \"Book Antiqua\", P052, \"URW Palladio L\", Georgia, serif",
      "sans": "{typography.family.body}",
      "typewriter": "{typography.family.mono}",
      "subhead": "{typography.family.body}"
    }
  },
  "radii": {
    "s": "6px",
    "m": "8px",
    "l": "14px"
  },
  "text": {
    "ink": { "light": "#0c1916", "dark": "#ebf0ed" },
    // the console's paragraphs are its label grey (Owen, 2026-10-27:  "Dim #95a19e, as the screenshot"):
    // 7:1 on the page, 6.2:1 on a raised row;  daylight the same idea, its muted grey
    "body": { "light": "#4c5f5a", "dark": "#95a19e" },
    "strong": { "light": "#07110e", "dark": "#ebf0ed" },
    // the console's grey:  its paragraphs and labels
    "muted": { "light": "#4c5f5a", "dark": "#95a19e" },
    // its quietest text, a table's header row and a count's note:  #697573 there, lifted to pass 4.5:1 on a raised row
    "light": { "light": "#56685f", "dark": "#808c8a" }
  },
  "surfaces": {
    "page": "{own.matrix-page}",
    "panel": "{own.matrix-panel}",
    "inset": "{own.matrix-inset}",
    "strong": "{own.matrix-raised}",
    "bar": "{surfaces.page}",
    "code": "{own.matrix-inset}",
    "highlight": "{own.matrix-accent-wash}"
  },
  "borders": {
    "color": "{own.matrix-border}",
    "strong": "{own.matrix-border-strong}",
    "internal": "{own.matrix-border}"
  },
  "brand": {
    "primary": {
      // Primary:  deep mint in light (white on it), mint in dark (deep ink on it)
      "color": "{own.matrix-accent}",
      "on": "{own.matrix-on-accent}",
      "text": "{own.matrix-accent-text}",
      "background": "{own.matrix-accent-wash}",
      "inverted": "{own.matrix-accent}",
      "inverted-on": "{own.matrix-on-accent}"
    },
    "secondary": {
      "color": "{hues.grey.color}",
      "on": "{hues.grey.on}",
      "inverted": "{hues.grey.inverted}",
      "inverted-on": "{hues.grey.inverted-on}",
      // its states grey's own, which the Apple palette moves away from the text on it (`rules/states.css`)
      "hover": "{hues.grey.hover}",
      "focus": "{hues.grey.focus}",
      "down": "{hues.grey.down}",
      "active": "{hues.grey.active}"
    },
    "link": {
      "color": "{own.matrix-accent-text}",
      "hover": { "light": "#064a34", "dark": "#b8f7dd" }
    },
    "focus": {
      "width": "2px",
      "color": "{own.matrix-accent}"
    }
  },
  "semantic": {
    // the console's three states:  mint is fine, amber needs attention, coral is wrong
    "positive": {
      "base": "{own.matrix-accent}",
      "text": "{own.matrix-accent-text}",
      "border": { "light": "#0b75524d", "dark": "#7ce5bd4d" },
      "background": "{own.matrix-accent-wash}"
    },
    "warning": {
      "base": "{own.matrix-amber}",
      "on": "{own.matrix-on-amber}",
      "inverted-on": "{own.matrix-on-amber}",
      "text": { "light": "#7a4d00", "dark": "#ffd596" },
      "header": { "light": "#5e3b00", "dark": "#ffe4bd" },
      "border": { "light": "#e8a3344d", "dark": "#ffc56d4d" },
      "background": { "light": "#e8a3341a", "dark": "#ffc56d1a" }
    },
    "negative": {
      "base": "{own.matrix-coral}",
      "text": { "light": "#9a2c20", "dark": "#ffb0a6" },
      "header": { "light": "#7a2018", "dark": "#ffd0ca" },
      "border": { "light": "#b5392b4d", "dark": "#ff8d804d" },
      "background": { "light": "#b5392b14", "dark": "#ff8d801a" }
    }
  },
  "shadows": {
    "ink": { "light": "#0c1f1a", "dark": "#000000" },
    "subtle": "0 1px 2px light-dark(#0c1f1a0f, #00000066)",
    // a hairline round a panel, and a slight lift:  a soft shadow just darker than the page (#0a1013 => #090f12)
    "raised": "0 0 0 1px {own.matrix-border}, 0 6px 24px light-dark(#0c1f1a0f, #00000040)",
    "floating": "0 0 0 1px {borders.strong}, 0 10px 30px light-dark(#0c1f1a24, #000000a6)",
    "floating-hover": "0 0 0 1px {borders.strong}, 0 14px 40px light-dark(#0c1f1a2e, #000000b3)",
    "overlay": "{shadows.floating-hover}"
  },
  "components": {
    "button": {
      "radius": "{radii.m}",
      "font-weight": 500
    },
    "input": {
      "radius": "{radii.m}",
      "background": "{own.matrix-field}",
      "border-color": "{own.matrix-border}"
    },
    "dropdown": {
      "radius": "{radii.m}"
    },
    "select": {
      "background": "{components.input.background}",
      "border-color": "{components.input.border-color}"
    },
    "menu": {
      "radius": "{radii.m}",
      "active-background": "{own.matrix-accent-wash}",
      "active-color": "{own.matrix-accent-text}",
      // tab bars:  a sunk track (#0a1114 under a #0e1619 bar), the chosen tab a raised strip in the ink (#1c272a, not
      // the accent), its corners the track's less the 3px inset
      "segmented-background": { "light": "#e3eae7", "dark": "#0a1114" },
      "segmented-radius": "{radii.m}",
      "segmented-padding": "3px",
      "segmented-item-radius": "calc({radii.m} - 3px)",
      "segmented-active-background": { "light": "#ffffff", "dark": "#1c272a" },
      "segmented-active-color": "{text.strong}",
      // no lines between segments:  one surface, its chosen key the only mark (T7)
      "segmented-divider": "transparent"
    },
    "card": {
      "radius": "{radii.l}",
      "shadow": "{shadows.raised}"
    },
    "segment": {
      "radius": "{radii.l}"
    },
    "section": {
      "radius": "{radii.l}"
    },
    "panel": {
      "radius": "{radii.l}",
      "shadow": "{shadows.raised}"
    },
    "message": {
      "radius": "{radii.m}"
    },
    "popup": {
      "radius": "{radii.m}"
    },
    "modal": {
      "radius": "18px"
    },
    "label": {
      "radius": "{radii.s}"
    },
    "header": {
      // headings bold (and tight:  `rules/matrix.css`);  sub-headings muted
      "font-weight": "{typography.weight.bold}",
      "sub-color": "{text.muted}",
      // an eyebrow (a `sub` header) a little smaller than classic's 6/7:  the console's is about 4/5 of its text
      "sub-heading-ratio": 0.8
    },
    "table": {
      // a table's header row:  no fill, the quietest text (in the monospace, uppercase:  `rules/matrix.css`)
      "header-background": "transparent",
      "header-color": "{text.light}"
    },
    "statistic": {
      // a count's label quiet, as the console's are:  muted, its own case and weight (`rules/matrix.css`)
      "label-color": "{text.muted}"
    },
    "bar": {
      "panel-background": "{own.matrix-panel}"
    },
    "docs-nav": {
      // the docs' side column (`<ui-docs-nav>`) in the theme's own colours, not the classic ivory and brown
      "background": "{own.matrix-panel}",
      "header-background": "{own.matrix-inset}",
      "band-background": "{own.matrix-inset}",
      "band-color": "{text.muted}",
      "border-color": "{borders.color}",
      "current-background": "{own.matrix-accent-wash}",
      "current-color": "{own.matrix-accent-text}"
    },
    "toolbar": {
      "button-radius": "{radii.s}"
    }
  }
}
