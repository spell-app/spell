// Glass:  the look of macOS today, as a Spell UI theme.
// - One of Spell's own themes, the set `UI.themes.own` lists;  applied ON TOP of `classic.css`,
//   so every classic token it replaces is restated here.
// - Its sheet, `glass.css`, is GENERATED from this file:  `yarn gen:styles` (`ThemeFile`;  epic `debut` P18).
//   What values can't say is in its rules sheets:  `rules/modern.css`, `rules/glass.css` (the blur, the headings).
// - The base of the glass themes (epic `debut` P17, J88;  Owen:  "glass is the base, fruity the exceptions"):
//   - Glass:  this file, on a SOLID page, one colour in light and one in dark
//   - Fruity (`fruity.theme.json5`):  extends this one, and sets its pastel wallpaper (`glass-wallpaper`) on top
//   - The theme editor knows both as glass themes (`GLASS_THEMES`, the `ui-theme-editor` family's types).
// - The Glass look of the Spell editor:  every value comes from its boards on the "Spell editor facelift" Design canvas.
// - What makes it glass:
//   - the system font (San Francisco on Apple devices), 15px, tight headings
//   - GLASS:  cards, segments, menus, popups, dropdown menus, modals, toasts and sections are translucent,
//     with `backdrop-filter` blurring and saturating whatever is behind them, and a light inner edge
//   - rounded rectangles, not pills:  8px controls, 10px menus and inputs, 14px cards and panels, 18px modals
//   - on a page that's an app (`<ui-root app>`), a Mac's sizes (epic `editor` P5;  Apple's guidelines):
//     13px text and 28px controls;  docs pages keep 15px, and what an app shows keeps it (`rules/glass.css`)
//   - Apple's system colours (its palette, `apple`, which Merlot shares):
//     in light, their higher-contrast shades, so white text reads 4.5:1;
//     in dark, Apple's dark shades with ink text on them
//   - one accent, a violet:  `#6a3fd6` light, lilac `#b79bff` dark
// - The glass needs nothing but CSS:
//   without `backdrop-filter` (none of our browsers lack it) the surfaces are still translucent, and still read.
// - NO font files ship:  every face is the platform's own.
{
  "$schema": "./theme.schema.json",
  "palette": "apple",
  "rules": ["modern", "glass"],
  "own": {
    // The accent:  violet light, lilac dark
    "glass-accent-light": "#6a3fd6",
    "glass-accent-dark": "#b79bff",
    "glass-accent-wash": { "light": "#7a4fe01f", "dark": "#b79bff33" },
    // the selection:  a solid accent under white text, as a Mac's list has it (white reads 6.37:1 and 5.21:1)
    "glass-accent-solid": { "light": "#6a3fd6", "dark": "#7650e3" },
    "glass-on-accent": "#ffffff",
    "glass-accent-text": { "light": "#5a35c4", "dark": "#d3c2ff" },
    // Glass:  the surfaces, their edge and the blur behind them
    "glass-surface": { "light": "#ffffff73", "dark": "#26243073" },
    "glass-surface-strong": { "light": "#ffffff9e", "dark": "#1e1c2694" },
    "glass-surface-faint": { "light": "#ffffff66", "dark": "#ffffff0d" },
    "glass-edge": { "light": "#ffffffbf", "dark": "#ffffff1f" },
    "glass-hairline": { "light": "#3c3c431f", "dark": "#ffffff14" },
    "glass-track": { "light": "#7676801f", "dark": "#7676803d" },
    // the track solid, as a Mac's on a bar:  the grey under tabs and toolbars, and the "or" between two buttons
    "glass-track-solid": { "light": "#e9e9ee", "dark": "#3a3846" },
    "glass-blur": "blur(28px) saturate(1.7)",
    // an app's sizes, and the size of what it shows
    "glass-app-font-size": "13px",
    "glass-app-control-height": "28px",
    "glass-content-font-size": "15px",
    // bars that stick over scrolling content (a page's top bar, sticky titles):  glass too
    "glass-bar": { "light": "#fffffff2", "dark": "#1e1c26f2" },
    // The wallpaper behind the page:  none, a solid page.
    // - A theme on this one sets its own (Fruity's colour washes);  the page's colour stays `--ui-background`.
    "glass-wallpaper": "none"
  },
  "typography": {
    "size": "{own.glass-content-font-size}",
    "family": {
      "body": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", system-ui, \"Segoe UI\", \"Noto Sans\", Cantarell, Ubuntu, \"Helvetica Neue\", Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Noto Color Emoji\"",
      "heading": "-apple-system, BlinkMacSystemFont, \"SF Pro Display\", system-ui, \"Segoe UI\", \"Noto Sans\", \"Helvetica Neue\", Arial, sans-serif",
      "mono": "\"SF Mono\", ui-monospace, Menlo, Consolas, \"Cascadia Mono\", \"DejaVu Sans Mono\", monospace",
      // `<ui-text serif>`, `sans-serif`, `typewriter` and `subhead` (epic `elemental-spell` P26)
      "serif": "\"New York\", ui-serif, Palatino, \"Palatino Linotype\", \"Book Antiqua\", P052, \"URW Palladio L\", Georgia, serif",
      "sans": "{typography.family.body}",
      "typewriter": "\"American Typewriter\", \"Courier Prime\", \"Courier New\", Courier, monospace",
      "subhead": "{typography.family.heading}"
    },
    "line-height": {
      "body": 1.45,
      "heading": 1.2
    }
  },
  "sizes": {
    // Sizes:  our own ladder (classic's is Fomantic's px ladder at 14px)
    "mini": 0.625,
    "tiny": 0.75,
    "small": 0.875,
    "large": 1.125,
    "big": 1.25,
    "huge": 1.5,
    "massive": 2
  },
  "radii": {
    "s": "8px",
    "m": "10px",
    "l": "14px"
  },
  "text": {
    "ink": { "light": "#1d1d1f", "dark": "#f5f5f7" },
    "body": { "light": "#1d1d1f", "dark": "#f5f5f7" },
    "strong": { "light": "#000000", "dark": "#ffffff" },
    "muted": { "light": "#5e5e66", "dark": "#aeaeb6" },
    "light": { "light": "#6e6e76", "dark": "#98989f" }
  },
  "surfaces": {
    // the page:  one solid colour, under a wallpaper where a theme on this one draws one (below)
    "page": { "light": "#f2eefb", "dark": "#15131c" },
    "panel": "{own.glass-surface-strong}",
    "inset": "{own.glass-surface}",
    "strong": { "light": "#ffffffe6", "dark": "#3a3846cc" },
    // a bar over scrolling content, for pages that draw one (the docs site's top bar, its sticky titles)
    "bar": "{own.glass-bar}",
    "code": { "light": "#ffffff80", "dark": "#00000040" },
    "highlight": "{own.glass-accent-wash}"
  },
  "borders": {
    "color": "{own.glass-hairline}",
    "strong": { "light": "#3c3c4338", "dark": "#ffffff2e" },
    "internal": "{own.glass-hairline}",
    "selected": { "light": "#3c3c4338", "dark": "#ffffff2e" },
    "selected-strong": { "light": "#3c3c434d", "dark": "#ffffff42" }
  },
  "brand": {
    "primary": {
      // Primary:  the violet accent
      "color": "{hues.violet.color}",
      "on": "{hues.violet.on}",
      "text": "{own.glass-accent-text}",
      "background": "{own.glass-accent-wash}",
      "inverted": "{hues.violet.inverted}",
      "inverted-on": "{hues.violet.inverted-on}"
    },
    "secondary": {
      // Secondary:  Apple's grey
      "color": "{hues.grey.color}",
      "on": "{hues.grey.on}",
      "inverted": "{hues.grey.inverted}",
      "inverted-on": "{hues.grey.inverted-on}"
    },
    "link": {
      // Page accents
      "color": { "light": "#0066d6", "dark": "#4da3ff" },
      "hover": { "light": "#004fa8", "dark": "#7dbcff" }
    },
    "focus": {
      // focus:  macOS's ring, 3px in the accent, hugging the box
      "width": "3px",
      "offset": "1px",
      "color": { "light": "#7c5ae0", "dark": "{own.glass-accent-dark}" },
      "border": "{own.glass-accent-dark}"
    }
  },
  "shadows": {
    "ink": { "light": "#281e50", "dark": "#000000" },
    "subtle": "0 1px 2px light-dark(#0000000f, #0000004d)",
    // a bright inner rim along the top, where glass catches the light
    "raised": "inset 0 0.5px 0 light-dark(#ffffffb3, #ffffff26), 0 1px 2px light-dark(#281e500f, #00000040), 0 8px 30px light-dark(#281e501f, #00000059)",
    "floating": "inset 0 0.5px 0 light-dark(#ffffffb3, #ffffff26), 0 2px 4px light-dark(#281e500f, #0000004d), 0 16px 40px light-dark(#281e5029, #00000073)",
    "floating-hover": "0 2px 6px light-dark(#281e5014, #00000059), 0 24px 56px light-dark(#281e5038, #0000008c)",
    "overlay": "{shadows.floating-hover}"
  },
  "motion": {
    "ease": {
      // Motion:  quick and smooth
      "out": "cubic-bezier(0.25, 1, 0.5, 1)"
    }
  },
  // An arrow over controls, as a Mac app has;  only real links keep the hand (epic `editor` P1)
  "cursors": { "control": "default" },
  "components": {
    "button": {
      "radius": "{radii.s}",
      // the "or" between two buttons:  an opaque disc, the track's grey, a tone apart from the white key beside it
      // (white, it vanished into Cancel;  as glass, it let the green button show through its text),
      // a little room between the buttons under it
      "or-background": "{own.glass-track-solid}",
      "or-color": "{text.muted}",
      "or-gap": "0.25em",
      // Buttons:  a white key with a hairline shadow;  the primary the accent
      "padding-block": "0.4em",
      "padding-inline": "0.9em",
      "font-weight": 500,
      "background": { "light": "#ffffffd9", "dark": "#ffffff1f" },
      "background-hover": { "light": "#fffffffa", "dark": "#ffffff2e" },
      "background-down": { "light": "#ebebf0f2", "dark": "#ffffff3d" },
      "background-active": { "light": "#ebebf0f2", "dark": "#ffffff38" },
      "color": "{text.body}",
      "color-hover": "{text.body}"
    },
    "label": {
      "radius": "6px",
      "font-weight": 500
    },
    "progress": {
      "radius": "{radii.pill}",
      // Progress:  the accent on a grey track
      "background": "{own.glass-track}",
      "bar-background": "{brand.primary.color}",
      "text-color": "{brand.primary.on}"
    },
    "checkbox": {
      // round checks:  the to-do circle of Reminders
      "radius": "{radii.circle}"
    },
    "input": {
      "radius": "{radii.m}",
      // Inputs:  a pale well with a hairline;  the accent ring on focus
      "background": { "light": "#ffffffb3", "dark": "#ffffff0f" },
      "border-color": "{own.glass-hairline}",
      "border-color-hover": "{borders.strong}",
      "border-color-focus": "{brand.focus.color}"
    },
    "dropdown": {
      "radius": "{radii.m}",
      "background": { "light": "#ffffffb3", "dark": "#ffffff0f" },
      "border-color": "{own.glass-hairline}",
      "border-color-hover": "{borders.strong}"
    },
    "menu": {
      "radius": "{radii.m}",
      // a text menu's chosen item (text tabs):  semibold as well as coloured, never colour alone
      "text-active-weight": 600,
      "background": "{own.glass-surface}",
      // Menus:  the selected item a solid accent, white text at regular weight (epic `editor` Q9);
      // a tab or a text item has no fill:  its words the accent
      "hover-background": { "light": "#0000000d", "dark": "#ffffff12" },
      "active-background": "{own.glass-accent-wash}",
      "active-color": "{own.glass-accent-text}",
      "active-fill": "{own.glass-accent-solid}",
      "active-fill-color": "{own.glass-on-accent}",
      "arrow-color": "{own.glass-accent-solid}",
      // a group of actions on a bar:  one piece of glass
      "capsule-background": "{own.glass-track}",
      "capsule-height": "{own.glass-app-control-height}",
      // Segmented menus (tab bars):  a translucent track, as Tahoe's (epic `editor` P5),
      // the chosen segment a raised white key, no dividers
      "segmented-background": "{own.glass-track}",
      "segmented-border": "none",
      "segmented-padding": "2px",
      "segmented-divider": "transparent",
      "segmented-item-padding": "0.35em 1.5em",
      // fully round pills, the track and every option (Owen, 2026-10-23:  "All should be fully rounded pills")
      "segmented-radius": "{radii.pill}",
      "segmented-item-radius": "{radii.pill}",
      "segmented-active-background": { "light": "#ffffff", "dark": "#ffffff33" },
      "segmented-active-color": "{text.body}",
      "segmented-active-shadow": "0 1px 2px #00000026",
      // the chosen segment under the pointer stays the white key;  an unchosen one a shade darker than the track
      "segmented-active-hover-background": "{components.menu.segmented-active-background}",
      "active-focus-color": "{brand.focus.color}"
    },
    "card": {
      "radius": "{radii.l}",
      "background": "{own.glass-surface-strong}",
      "border-color": "{own.glass-edge}",
      "hover-border-color": "{own.glass-edge}",
      "shadow": "{shadows.raised}",
      "hover-shadow": "{shadows.floating}"
    },
    "segment": {
      "radius": "{radii.l}",
      "background": "{own.glass-surface}",
      "border-color": "{own.glass-edge}",
      "shadow": "{shadows.raised}",
      "raised-shadow": "{shadows.floating}"
    },
    "section": {
      "radius": "{radii.l}",
      "background": "{own.glass-surface}",
      "shadow": "{shadows.raised}",
      "title-background": "{own.glass-surface}",
      "sticky-background": "{own.glass-surface-strong}"
    },
    "panel": {
      "radius": "{radii.l}",
      "shadow": "{shadows.raised}",
      // a window's pane:  frosted, its body clearer than its header
      // (Owen:  "The panel bodies used to be less opaque than the header, I liked that");
      // the header a wash of the accent:  the blur draws a pane's top edge whiter than the rest,
      // so a see-through header stood out near-white (Owen, epic `elemental-spell` C39)
      "pane-background": "{own.glass-surface}",
      "pane-border-color": "{own.glass-edge}",
      "pane-filter": "{own.glass-blur}",
      "pane-header-background": "color-mix(in oklab, {own.glass-accent-wash} 50%, transparent)"
    },
    "message": {
      "radius": "{radii.m}"
    },
    "toast": {
      "radius": "{radii.l}",
      "background": "{own.glass-surface-strong}",
      "shadow": "{shadows.floating}"
    },
    "popup": {
      "radius": "{radii.m}",
      "background": "{own.glass-surface-strong}",
      "border-color": "{own.glass-edge}",
      "shadow": "{shadows.floating}"
    },
    "modal": {
      "radius": "18px",
      "background": "{own.glass-surface-strong}",
      "shadow": "{shadows.floating-hover}",
      "dimmer-filter": "blur(8px) saturate(1.2)"
    },
    "bar": {
      "filter": "{own.glass-blur}",
      "color": "{text.body}",
      // a section title:  in place, white glass at 50%;  stuck, 75% (below), the change eased
      // (Owen, 2026-10-23:  "50% opaque white when non-sticky, animated transition ... when sticky");
      // the panel round a page's tabs, 50% too ("make tab surround 50% opaque")
      "rest-background": { "light": "#ffffff80", "dark": "#1e1c2680" },
      // stuck, 75%, not 90% (Owen, 2026-10-23:  "less opacity when sticky")
      "title-background": { "light": "#ffffffbf", "dark": "#1e1c26bf" },
      "panel-background": { "light": "#ffffff80", "dark": "#1e1c2680" },
      "rest-filter": "{own.glass-blur}",
      // what a page lays under the bars at its top (the docs site's stuck title line, the strip round its tabs):
      // the wallpaper itself, fixed, so they read as the page
      // (Owen, 2026-10-23:  "duplicate the site background color in under the top stuff, so it doesn't have to go to white")
      "wallpaper": "{own.glass-wallpaper}",
      "wallpaper-color": "{surfaces.page}",
      // nothing to blur under an opaque wallpaper:  a blur there drew seams where two such bars meet
      "wallpaper-filter": "none",
      // ... and the white over it on a stuck section title:  the 50% it has in place
      "wallpaper-tint": { "light": "#ffffff80", "dark": "#1e1c2680" },
      // a titled toolbar (the docs' sections row) as a pill bar, the tab bars' look
      "tracked": 1,
      "track": "{own.glass-track-solid}",
      "track-radius": "9px",
      // the track hugs its keys (Owen:  "second tab group doesn't need to be full width")
      "track-width": "fit-content",
      "track-padding": "2px",
      "item-padding": "0 1.1em",
      // every corner of a key the track's, less its padding:  nested, never as round as the track
      "item-radius": "calc({components.bar.track-radius} - {components.bar.track-padding})",
      "hover-background": { "light": "#0000000d", "dark": "#ffffff12" },
      "active-background": { "light": "#ffffff", "dark": "#ffffff33" },
      "active-shadow": "0 1px 2px #00000026",
      // a border round a page's SECOND row of tabs (the docs' section toolbar):  none yet, one line to give it one
      "subtabs-border": "none",
      // a toolbar's key tip (the docs' "Type T to jump to this section"):  a pill of dark glass, in both schemes
      "tip-background": "#1816249e",
      "tip-filter": "blur(14px) saturate(160%)"
    },
    "toolbar": {
      // a toolbar's ‹ / › keys:  a faint white disc, so they read as buttons
      // (Owen:  "20% white opacity so it's clear what it is")
      "button-background": { "light": "#ffffff33", "dark": "#ffffff1f" }
    },
    "dimmer": {
      // the scrim:  a light veil that blurs what it covers
      "background": { "light": "#0000002e", "dark": "#00000073" },
      "blur": "blur(8px) saturate(1.2)"
    },
    "flyout": {
      "dimmer-background": "{components.dimmer.background}"
    },
    "select": {
      // a select the same well as an input:  it drew the plain surface and border beside them
      "background": "{components.input.background}",
      "border-color": "{components.input.border-color}",
      "border-color-hover": "{components.input.border-color-hover}",
      "border-color-focus": "{components.input.border-color-focus}"
    },
    "docs-nav": {
      // The docs' side column (`<ui-docs-nav>`):  glass, quiet bands, the current page the accent's wash
      "background": { "light": "#ffffffc7", "dark": "#1e1c26cc" },
      "header-background": "transparent",
      "band-background": "transparent",
      "band-color": "{text.muted}",
      "border-color": "{own.glass-hairline}",
      "current-background": "{own.glass-accent-solid}",
      "current-color": "{own.glass-on-accent}"
    },
    "example": {
      // Docs examples (`<ui-example>`):  a glass frame;  the open demo a very light white, not pure white
      "frame-background": { "light": "#ffffff59", "dark": "#1e1c2659" },
      "frame-border": "1px solid {own.glass-edge}",
      // no blur, only the saturation:
      // - a frame entering at the window's bottom edge blurred in the dark beyond it,
      //   and blinked dark as it scrolled in (Owen, 2026-10-23:  "These blink dark when scrolled at the bottom of the page")
      // - over the smooth wallpaper, the blur showed nothing anyway
      "frame-filter": "saturate(1.7)",
      "demo-background": { "light": "#ffffff8c", "dark": "#ffffff0d" },
      "toggle-background": { "light": "#fffffff2", "dark": "#ffffff2e" }
    },
    "header": {
      // Headers:  San Francisco Display, tight;  ledes muted, never italic
      "font-weight": "{typography.weight.semibold}",
      "h1": 2.25,
      "h2": 1.375,
      "h3": 1.125,
      "h4": 1.0625,
      "sub-color": "{text.muted}"
    }
  },
  // The code's colours (epic `debut` P22):  Glass's own (Q41, "Both get their own"):  Apple's Xcode colours, its pink keywords, lavender types and coral strings, on the glass.
  // - Every role's light and dark;  `editor` the editor's own (what's left out takes the recipe, `codeRoles`).
  "code": {
    "text": { "light": "#1f1f24", "dark": "#e6e6eb" },
    "heading": { "light": "#9b2393", "dark": "#ff7ab2" },
    "comment": { "light": "#5d6c79", "dark": "#9aa5b1" },
    "keyword": { "light": "#9b2393", "dark": "#ff7ab2" },
    "type": { "light": "#0b4f79", "dark": "#dabaff" },
    "library": { "light": "#6c36a9", "dark": "#acf2e4" },
    "name": { "light": "#1f1f24", "dark": "#e6e6eb" },
    "member": { "light": "#326d74", "dark": "#78c2b3" },
    "parameter": { "light": "#78492a", "dark": "#ffa14f" },
    "action": { "light": "#0f68a0", "dark": "#6bc5e0" },
    "constant": { "light": "#1c00cf", "dark": "#d9c97c" },
    "string": { "light": "#c41a16", "dark": "#ff8170" },
    "tag": { "light": "#6c36a9", "dark": "#c39bf2" },
    "punctuation": { "light": "#5d6c79", "dark": "#a3a9b5" },
    "attr": { "light": "#326d74", "dark": "#78c2b3" },
    "meta": { "light": "#78492a", "dark": "#fd8f3f" },
    "addition": { "light": "#1f7a3a", "dark": "#7ed99a" },
    "deletion": { "light": "#c41a16", "dark": "#ff8170" }
  }
}
