import { resolve } from "node:path"
import { defineConfig, type TestProjectConfiguration } from "vite-plus"
import { playwright } from "vite-plus/test/browser-playwright"

import { baseConfig } from "spell-ui/vite.config.ts"

/**
 * vitest config for `spell-__pack__`, a component pack (`spell pack`):  two projects.
 * - `node` -- the tests of `src/`'s own files (`tests/*.test.ts`):  the pack's own checks, `pack.test.ts` among them
 *   (`spell pack check __pack__`:  `src/components/__pack/` is current)
 * - `browser` -- the elements' (`tests/components/**`):  the `<__prefix__*>` elements, in a REAL browser, as Spell UI's are
 *   - Vitest browser mode + Playwright, chromium
 *   - `baseConfig()`:  Spell UI's plugins (decorators BEFORE Solid), Solid dedupe, Lightning CSS
 *   - the test helpers come from the kit (`spell/test-helpers/...`), Spell UI's own from `spell-ui/test-helpers/...`
 * - `prefix` / `root`:  for a run that lists these beside other repos' projects, as `__pack__:node` /
 *   `__pack__:browser`, `root` set to this repo, since vitest doesn't nest `projects`.
 *   Own run:  no prefix, `root` is this folder.
 */
/**
 * The tests live in the repo's tests/ folder, at the same paths as the code under `src/`:
 * `tests/components/__prefix__card/` tests `src/components/__prefix__card/`.
 */
const TESTS = resolve(import.meta.dirname, "./tests")

export function __packCamel__Projects({
  prefix = "",
  root
}: { prefix?: string; root?: string } = {}): TestProjectConfiguration[] {
  return [
    {
      ...(root && { root }),
      test: {
        name: `${prefix}node`,
        dir: TESTS,
        environment: "node",
        include: ["*.test.ts"]
      }
    },
    {
      ...baseConfig(),
      ...(root && { root }),
      test: {
        name: `${prefix}browser`,
        dir: TESTS,
        include: ["components/**/*.test.{ts,tsx}"],
        // Spell UI's core first, as a page has it:  its settings for the kit's element (`spell-ui/test-helpers/setup`)
        setupFiles: ["spell-ui/test-helpers/setup.ts"],
        testTimeout: 10_000,
        browser: {
          enabled: true,
          provider: playwright(),
          headless: true,
          instances: [{ browser: "chromium" }]
        }
      }
    }
  ]
}

export default defineConfig({
  test: {
    projects: __packCamel__Projects()
  }
})
