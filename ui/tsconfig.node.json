{
  // Spell UI's NODE code, ONE TypeScript program (epic `repo-split` P14, Q47):  its tools (`src/tools`), its `spell`
  // commands (`src/cli`), and what's outside `src/`:  `scripts/` and the Vite configs.
  // - As `tsconfig.json`, but node's types too:  the tools reach Spell UI's browser source (its icons, its static
  //   render, the demo and visual-test pages they serve), so they keep the DOM, Vite's client types and the JSX settings.
  // - The settings `tsx` runs `spell ssr`'s render under (`src/cli/ssrCommand.ts`).
  // - The declarations build (`spell-types`) builds it into `dist-types/` too, beside the browser program's:
  //   other repos read the tools by their declarations (`spell/ui/tools/SiteDataBuilder` ...).
  "extends": "spell/toolchain/tsconfig.base.json",
  "compilerOptions": {
    "customConditions": ["spell-source"],
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": ["node", "vite/client"]
  },
  "include": ["src/tools", "src/cli", "scripts", "vite.config.ts", "vite.site.config.ts", "vitest.config.ts"],
  // the Solid host app's build output (`yarn smoke`)
  "exclude": ["node_modules", "src/tools/frameworks/solid/dist"]
}
