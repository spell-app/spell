{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "none",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "printWidth": 120,
  "sortPackageJson": true,
  "ignorePatterns": [
    "**/*.md",
    "build/**",
    "dist/**",
    ".cache/**",
    ".yarn/**",
    ".claude/**",
    "coverage/**",
    "reference/**",
    "src/icons/data/**",
    "site/dist/**",
    "site/**/*.mdx",
    "site/.astro/**",
    "spike/*/dist/**",
    "spike/*/vendor/**",
    "spike/*/*results.json"
  ]
}
