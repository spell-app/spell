{
  "name": "@spell/ui",
  "version": "0.0.1",
  "description": "Fomantic UI's vocabulary as modern-CSS web components, on Solid 2",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/index.ts",
    "./src/components/*/index.ts",
    "./src/elements/HotDefinitions.ts",
    "./dist/index.js",
    "./dist/button.js",
    "./dist/dropdown.js",
    "./dist/icon.js",
    "./dist/label.js",
    "./dist/parts.js",
    "./dist/divider.js",
    "./dist/segment.js",
    "./dist/container.js",
    "./tools/demo/**"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./forms": {
      "types": "./dist/forms.d.ts",
      "import": "./dist/forms.js"
    },
    "./button": {
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/button.js"
    },
    "./dropdown": {
      "types": "./dist/components/dropdown/index.d.ts",
      "import": "./dist/dropdown.js"
    },
    "./icon": {
      "types": "./dist/components/icon/index.d.ts",
      "import": "./dist/icon.js"
    },
    "./label": {
      "types": "./dist/components/label/index.d.ts",
      "import": "./dist/label.js"
    },
    "./parts": {
      "types": "./dist/components/parts/index.d.ts",
      "import": "./dist/parts.js"
    },
    "./divider": {
      "types": "./dist/components/divider/index.d.ts",
      "import": "./dist/divider.js"
    },
    "./segment": {
      "types": "./dist/components/segment/index.d.ts",
      "import": "./dist/segment.js"
    },
    "./container": {
      "types": "./dist/components/container/index.d.ts",
      "import": "./dist/container.js"
    },
    "./styles": {
      "types": "./dist/styles/index.d.ts",
      "import": "./dist/styles.js"
    },
    "./icons/glyphs/*": "./dist/glyphs/*"
  },
  "scripts": {
    "dev": "vite --open /tools/demo/index.html",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean": "rm -rf ./.cache ./build ./dist ./coverage ./test-results ./vendor ./tools/frameworks/solid/dist",
    "/////// CORRECTNESS": "",
    "review": "yarn ts && yarn lint:fix && yarn format && yarn test && echo '== REVIEW PASSED\n===========\n'",
    "ts": "echo '>>>>>>>>>>>\n>> RUNNING TSC' && tsc && tsc -p tsconfig.node.json && yarn fork tsc && echo '<< TSC PASSED\n'",
    "lint": "echo '>>>>>>>>>>>\n>> LINTING WITH OXLINT' && oxlint --report-unused-disable-directives --max-warnings 0 src test scripts tools packages/solid-element && echo '<< OXLINT PASSED\n'",
    "lint:fix": "echo '>>>>>>>>>>>\n>> LINTING WITH OXLINT --fix' && oxlint --fix src test scripts tools packages/solid-element && echo '<< OXLINT PASSED\n'",
    "format": "echo '>>>>>>>>>>>\n>> FORMATTING WITH OXFMT' && oxfmt . && echo '<< OXFMT PASSED\n'",
    "format:check": "oxfmt --check .",
    "/////// TESTING": "",
    "test": "echo '>>>>>>>>>>>\n>> RUNNING TESTS' && vitest run --project ssr && vitest run --project browser && yarn test:fork && echo '<< TESTS PASSED\n'",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:all": "vitest run --project ssr && UI_TEST_ALL=1 vitest run --project browser",
    "test:visual": "vitest run visual.test --passWithNoTests",
    "test:fork": "yarn fork test",
    "test:hmr": "tsx tools/hmr.e2e.ts",
    "test:browsers": "playwright install chromium firefox webkit",
    "/////// FORK (packages/solid-element, its own yarn project)": "",
    "fork": "yarn --cwd packages/solid-element",
    "fork:install": "yarn --cwd packages/solid-element install",
    "fork:build": "yarn --cwd packages/solid-element build",
    "/////// PACKAGE TOOLING (tools/)": "",
    "vendor": "tsx tools/cli.ts vendor",
    "measure": "tsx tools/cli.ts measure",
    "smoke": "vite build --logLevel warn && tsx tools/cli.ts smoke",
    "serve": "tsx tools/cli.ts serve",
    "report": "tsx tools/cli.ts report",
    "screenshots": "tsx tools/screenshots.ts",
    "/////// DOCS SITE": "",
    "site:dev": "yarn --cwd site dev",
    "site:build": "yarn --cwd site build",
    "site:preview": "yarn --cwd site preview",
    "site:check": "yarn --cwd site check",
    "/////// GENERATED": "",
    "gen:styles": "tsc -p scripts && tsx scripts/gen-styles.ts",
    "gen:icons": "tsc -p scripts && tsx scripts/gen-icons.ts",
    "/////// MANIFEST": "",
    "manifest": "custom-elements-manifest analyze --globs 'src/**/*.ts' 'src/**/*.tsx' --exclude 'src/**/*.test.ts' --exclude 'src/**/*.test.tsx'"
  },
  "dependencies": {
    "@spell/solid-element": "link:./packages/solid-element",
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@solidjs/vite-plugin": "3.0.0-next.46",
    "@solidjs/web": "2.0.0-rc.11",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.20.4",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/browser-playwright": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "playwright": "^1.63.0",
    "solid-js": "2.0.0-rc.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@solidjs/web": "2.0.0-rc.11",
    "solid-js": "2.0.0-rc.11"
  },
  "engines": {
    "node": ">=22.17"
  },
  "packageManager": "yarn@4.18.0"
}
