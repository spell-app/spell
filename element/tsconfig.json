{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": ["vite/client"]
  },
  // its own source (it imports `$/util`'s generic files and Solid, never another folder), and the test helpers
  // (`test-helpers/`, every set's tests' `spell-kit/test-helpers/...`:  in here, too, so Vite resolves their aliases)
  "include": ["src", "test-helpers"],
  "exclude": ["node_modules"]
}
