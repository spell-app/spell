    joker: { name: "comodín", gender: "masculine", from: "seed:Solitario" },
    king: { name: "rey", gender: "masculine", from: "seed:Solitario" },
    layout: { name: "disposición", gender: "feminine", from: "seed:Solitario" },
    letter: { name: "letra", gender: "feminine", from: "seed:Solitario" },
    name: { name: "nombre", gender: "masculine", from: "seed:Solitario" },
    picture: { name: "imagen", gender: "feminine", from: "seed:Solitario" },
