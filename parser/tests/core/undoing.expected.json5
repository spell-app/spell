        "canUndo": true,
        "canRedo": false,
        "undoTitle": "Undo Turn Card",
        "redoTitle": "Redo",
        "stock": ["ace", "two", "three"],
        "waste": [],
        "faceUp": [true, false, false],
        "moves": 0
      }
    },
