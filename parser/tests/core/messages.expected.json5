{
  "about": "The core messages in English, by key:  the JavaScript core's CORE_MESSAGES (core.types.ts) and spell_core's MESSAGES (messages.py) must both be these.  Read by tests/core/messages.test.ts and tests/py/core/tests/test_messages.py.",
  "messages": {
    "expect-passed": "As expected {what} is {expected}",
    "expect-failed": "Unexpected: {what} should be {expected} but is actually {actual}",
    "expect-truthy": "truthy",
    "test-step": "▶️ Executing   {step}",
    "test-threw": "Error in test {test}:",
    "cant-draw": "⚠ {type} can't draw",
    "waiting": "…",
    "confirm-default": "{question} (yes)",
    "drop-event": "{thing}-drop",
    "undo": "Undo",
    "undo-step": "Undo {step}",
    "redo": "Redo",
    "redo-step": "Redo {step}",
    "write-refused": "Couldn't save your change to {thing}",
    "language": "en",
    "write-retry": "Retry",
    "page-previous": "Previous",
    "page-next": "Next",
    "page-number": "Page {page}",
    "read-failed": "Can't read this right now:  {why}",
    "saved-added": "Add",
    "saved-removed": "Remove",
    "write-show-me": "Show me",
    "write-merged": "{thing}'s {field} also changed elsewhere.  Yours was kept;  theirs was:  {theirs}",
    "write-use-theirs": "Use theirs",
    "write-lost": "Someone else changed {thing}'s {field} at the same time, and theirs stands.  Yours was:  {mine}",
    "write-deleted": "Someone else deleted {thing} while you were changing it.",
    "write-use-mine": "Use mine",
    "write-restore": "Restore",
    "write-changed-under-draft": "Someone else changed {thing} while you were editing it.  What you're editing doesn't show that yet.",
    "guest-person": "Guest {number}",
    "sign-in-signed-out": "You aren't signed in to {place}, so you can read it, and what you change waits here until you do.",
    "sign-in-signing": "Signing in to {place}…",
    "sign-in-as": "Signed in to {place} as {name}.",
    "sign-in-ended": "Your sign-in to {place} has ended:  they last two weeks at most.  Sign in again, and what you changed goes through.",
    "sign-in-failed": "That didn't sign you in:  {why}",
    "sign-in-who": "Your handle, e.g. alice.bsky.social",
    "sign-in": "Sign in",
    "sign-out": "Sign out",
    "sign-in-not-yet": "{place} has no sign-in yet:  it takes whoever's here to be this computer's person, who has the same name on every computer."
  }
}
