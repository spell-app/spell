{
  // spell-lang's TypeScript settings for its browser-safe code:  parser, markdown, core, py's writers and spell.
  // - Every import is a package name, spell-lang's own too (`spell-lang/parser/rules/Rule`, epic `repo-split` Q47):
  //   NO `paths`.  `spell-lang-source` reads this repo's names as its source, through `package.json`'s `exports`;
  //   another repo's (`spell-kit/util` ...) as its declarations, its `types`.
  // - The node-only parts are `tsconfig.node.json`'s:  the cli, spell's `node/`, the test helpers, core's
  //   declarations writer.
  // - spell-types builds both into `dist-types/` (`"spellTypes"` in `package.json`).
  "extends": "spell-kit/toolchain/tsconfig.base.json",
  "compilerOptions": {
    "customConditions": ["spell-lang-source"],
    "allowJs": true,
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "spell-kit/toolchain/types"]
  },
  "include": ["src/parser", "src/markdown", "src/core", "src/py", "src/spell"],
  "exclude": [
    // node-only:  tsconfig.node.json's
    "src/parser/test",
    "src/core/coreDeclarations.ts",
    "src/core/writeCoreDeclarations.ts",
    "src/spell/node",
    "src/spell/test",
    // Python:  `spell_core`, a uv project
    "src/py/core"
  ]
}
