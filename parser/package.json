{
  "name": "spell-lang",
  "version": "0.8.0",
  "private": true,
  "description": "The spell language:  the rule-based parser, markdown, the core runtime, Python's writers and spell itself",
  "license": "MIT",
  "repository": "https://github.com/spell-app/spell-lang",
  "type": "module",
  "spell": {
    "commands": "./cli/commands.ts"
  },
  "spellTypes": [
    "parser",
    "markdown",
    "core",
    "py",
    "spell",
    "cli"
  ],
  "spellFolders": [
    {
      "name": "parser",
      "node": true
    },
    {
      "name": "markdown",
      "node": true
    },
    {
      "name": "core",
      "node": true
    },
    {
      "name": "py",
      "lint": [
        "ts"
      ],
      "fmt": [
        "ts"
      ],
      "tests": [
        "ts"
      ],
      "node": true,
      "python": "core"
    },
    {
      "name": "spell",
      "lint": [
        "."
      ]
    },
    {
      "name": "cli",
      "lint": [
        "src",
        "commands.ts"
      ],
      "node": true
    }
  ],
  "exports": {
    "./parser": {
      "types": "./dist-types/parser/src/index.d.ts",
      "default": "./parser/src/index.ts"
    },
    "./parser/rulex": {
      "types": "./dist-types/parser/src/rulex/index.d.ts",
      "default": "./parser/src/rulex/index.ts"
    },
    "./markdown": {
      "types": "./dist-types/markdown/src/index.d.ts",
      "default": "./markdown/src/index.ts"
    },
    "./core": {
      "types": "./dist-types/core/src/index.d.ts",
      "default": "./core/src/index.ts"
    },
    "./core/console": {
      "types": "./dist-types/core/src/console.d.ts",
      "default": "./core/src/console.ts"
    },
    "./core/core.types": {
      "types": "./dist-types/core/src/core.types.d.ts",
      "default": "./core/src/core.types.ts"
    },
    "./core/model": {
      "types": "./dist-types/core/src/model.d.ts",
      "default": "./core/src/model.ts"
    },
    "./core/things": {
      "types": "./dist-types/core/src/things.d.ts",
      "default": "./core/src/things.ts"
    },
    "./py": {
      "types": "./dist-types/py/ts/index.d.ts",
      "default": "./py/ts/index.ts"
    },
    "./spell": {
      "types": "./dist-types/spell/src/index.d.ts",
      "default": "./spell/src/index.ts"
    },
    "./spell/node/buildTsx": {
      "types": "./dist-types/spell/src/node/buildTsx.d.ts",
      "default": "./spell/src/node/buildTsx.ts"
    },
    "./spell/node/packageVersion.node": {
      "types": "./dist-types/spell/src/node/packageVersion.node.d.ts",
      "default": "./spell/src/node/packageVersion.node.ts"
    },
    "./spell/node/projectFile": {
      "types": "./dist-types/spell/src/node/projectFile.d.ts",
      "default": "./spell/src/node/projectFile.ts"
    },
    "./spell/node/pyright": {
      "types": "./dist-types/spell/src/node/pyright.d.ts",
      "default": "./spell/src/node/pyright.ts"
    },
    "./spell/node/typecheck": {
      "types": "./dist-types/spell/src/node/typecheck.d.ts",
      "default": "./spell/src/node/typecheck.ts"
    },
    "./spell/SpellSetup": {
      "types": "./dist-types/spell/src/SpellSetup.d.ts",
      "default": "./spell/src/SpellSetup.ts"
    },
    "./spell/SpellUrls": {
      "types": "./dist-types/spell/src/SpellUrls.d.ts",
      "default": "./spell/src/SpellUrls.ts"
    },
    "./spell/test": {
      "types": "./dist-types/spell/src/test/index.d.ts",
      "default": "./spell/src/test/index.ts"
    },
    "./cli": {
      "types": "./dist-types/cli/src/index.d.ts",
      "default": "./cli/src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "/////// CHECKS (spell-folders:  each folder in turn, \"spellFolders\")": "",
    "ts": "spell-types --below && spell-folders ts",
    "test": "spell-folders test",
    "lint": "spell-folders lint",
    "lint:fix": "spell-folders lint:fix",
    "format": "spell-folders format",
    "format:check": "spell-folders format:check",
    "review": "yarn ts && yarn lint:fix && yarn format && yarn test && echo '== REVIEW PASSED\n===========\n'",
    "/////// markdown": "",
    "markdown:spec:update": "cd markdown && node scripts/gfm-spec.mjs",
    "/////// core": "",
    "core:gen:declarations": "cd core && node --import tsx --import spell-kit/toolchain/aliases src/writeCoreDeclarations.ts && vp fmt core.declarations.json5",
    "/////// spell": "",
    "spell:test:ui": "cd spell && vp test --ui",
    "spell:test:coverage": "cd spell && vp test run --coverage",
    "spell:test:fixtures": "cd spell && vp test run src/test/fixtures.test.ts src/test/typescript.test.ts src/test/python.test.ts",
    "spell:test:fixtures:bless": "cd spell && vp test run src/test/fixtures.test.ts src/test/typescript.test.ts src/test/python.test.ts --update=all",
    "spell:test:rules": "cd spell && vp test run src/rules",
    "spell:test:rules:bless": "cd spell && BLESS_RULE_TESTS=1 vp test run src/rules; vp fmt src/rules",
    "spell:gen:syntax": "cd spell && node --import tsx --import spell-kit/toolchain/aliases src/node/writeSpellSyntax.ts && vp fmt spellSyntax.json"
  },
  "dependencies": {
    "@solidjs/h": "2.0.0-rc.13",
    "@solidjs/web": "2.0.0-rc.13",
    "browser-or-node": "^3.0.0",
    "entities": "^6.0.1",
    "json5": "^2.2.3",
    "lodash": "^4.17.21",
    "semver": "^7.8.5",
    "solid-js": "2.0.0-rc.13",
    "spell-kit": "workspace:*"
  },
  "devDependencies": {
    "@solidjs/compiler": "2.0.0-rc.13",
    "@types/lodash": "^4.17.17",
    "@types/node": "^22.20.4",
    "@types/semver": "^7.8.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13",
    "playwright": "^1.63.0",
    "pyright": "1.1.414",
    "tsx": "4.20.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "browserslist": "> 1%, node > 22",
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "yarn@4.18.0"
}
