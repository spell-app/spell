{
  "name": "spell-lang",
  "version": "0.8.0",
  "private": true,
  "description": "The spell language:  the rule-based parser, markdown, the core runtime, Python's writers and spell itself",
  "license": "MIT",
  "repository": "https://github.com/spell-app/spell-lang",
  "type": "module",
  "exports": {
    "./parser": {
      "spell-lang-source": "./src/parser/index.ts",
      "types": "./dist-types/src/parser/index.d.ts",
      "default": "./src/parser/index.ts"
    },
    "./parser/rulex": {
      "spell-lang-source": "./src/parser/rulex/index.ts",
      "types": "./dist-types/src/parser/rulex/index.d.ts",
      "default": "./src/parser/rulex/index.ts"
    },
    "./parser/test": {
      "spell-lang-source": "./src/parser/test/index.ts",
      "types": "./dist-types/src/parser/test/index.d.ts",
      "default": "./src/parser/test/index.ts"
    },
    "./markdown": {
      "spell-lang-source": "./src/markdown/index.ts",
      "types": "./dist-types/src/markdown/index.d.ts",
      "default": "./src/markdown/index.ts"
    },
    "./core": {
      "spell-lang-source": "./src/core/index.ts",
      "types": "./dist-types/src/core/index.d.ts",
      "default": "./src/core/index.ts"
    },
    "./py": {
      "spell-lang-source": "./src/py/index.ts",
      "types": "./dist-types/src/py/index.d.ts",
      "default": "./src/py/index.ts"
    },
    "./spell": {
      "spell-lang-source": "./src/spell/index.ts",
      "types": "./dist-types/src/spell/index.d.ts",
      "default": "./src/spell/index.ts"
    },
    "./spell/test": {
      "spell-lang-source": "./src/spell/test/index.ts",
      "types": "./dist-types/src/spell/test/index.d.ts",
      "default": "./src/spell/test/index.ts"
    },
    "./cli": {
      "spell-lang-source": "./src/cli/index.ts",
      "types": "./dist-types/src/cli/index.d.ts",
      "default": "./src/cli/index.ts"
    },
    "./*": {
      "spell-lang-source": [
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx",
        "./src/*"
      ],
      "types": [
        "./dist-types/src/*.d.ts",
        "./dist-types/src/*/index.d.ts"
      ],
      "default": "./src/*"
    },
    "./*.ts": {
      "spell-lang-source": "./src/*.ts",
      "types": "./dist-types/src/*.d.ts",
      "default": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "/////// CHECKS": "",
    "ts": "spell-types --below && spell-types && tsc -p tests",
    "test": "vp test run && uv run --directory src/py/core pytest -q",
    "lint": "vp lint --report-unused-disable-directives --max-warnings 0 src tests scripts && uv run --directory src/py/core ruff check . ../../../tests/py/core/tests",
    "lint:fix": "vp lint --fix src tests scripts && uv run --directory src/py/core ruff check --fix . ../../../tests/py/core/tests",
    "format": "vp fmt && uv run --directory src/py/core ruff format . ../../../tests/py/core/tests",
    "format:check": "vp fmt --check && uv run --directory src/py/core ruff format --check . ../../../tests/py/core/tests",
    "review": "yarn ts && yarn lint:fix && yarn format && yarn test && echo '== REVIEW PASSED\n===========\n'",
    "/////// markdown": "",
    "markdown:spec:update": "node scripts/markdown/gfm-spec.mjs",
    "/////// core": "",
    "core:gen:declarations": "tsx src/core/writeCoreDeclarations.ts && vp fmt src/core/core.declarations.json5",
    "/////// spell": "",
    "spell:test:ui": "vp test --ui --project spell",
    "spell:test:coverage": "vp test run --coverage --project spell",
    "spell:test:fixtures": "vp test run --project spell tests/spell/test/fixtures.test.ts tests/spell/test/typescript.test.ts tests/spell/test/python.test.ts",
    "spell:test:fixtures:bless": "vp test run --project spell tests/spell/test/fixtures.test.ts tests/spell/test/typescript.test.ts tests/spell/test/python.test.ts --update=all",
    "spell:test:rules": "vp test run --project spell tests/spell/rules",
    "spell:test:rules:bless": "BLESS_RULE_TESTS=1 vp test run --project spell tests/spell/rules; vp fmt src/spell/rules",
    "spell:gen:syntax": "tsx src/spell/node/writeSpellSyntax.ts && vp fmt src/spell/spellSyntax*.json"
  },
  "dependencies": {
    "@solidjs/h": "2.0.0-rc.13",
    "@solidjs/web": "2.0.0-rc.13",
    "browser-or-node": "^3.0.0",
    "entities": "^6.0.1",
    "json5": "^2.2.3",
    "lodash": "^4.17.21",
    "pluralize": "^8.0.0",
    "semver": "^7.8.5",
    "solid-js": "2.0.0-rc.13",
    "spell-kit": "workspace:*"
  },
  "devDependencies": {
    "@solidjs/compiler": "2.0.0-rc.13",
    "@types/lodash": "^4.17.17",
    "@types/node": "^22.20.4",
    "@types/pluralize": "^0.0.33",
    "@types/semver": "^7.8.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13",
    "playwright": "^1.63.0",
    "pyright": "1.1.414",
    "tsx": "4.20.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "browserslist": "> 1%, node > 22",
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "yarn@4.18.0",
  "spell": {
    "commands": "./src/cli/commands.ts"
  },
  "spellTypes": [
    "tsconfig.json",
    "tsconfig.node.json"
  ]
}
