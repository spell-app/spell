{
  // spell-lang's import-alias table (epic `repo-split` P8:  each repo has its own part of what was spell-app's one table).
  // Every package's `tsconfig.json` here extends it;  it extends the TypeScript settings every repo shares,
  // `spell-kit/toolchain`'s (spell-util's own toolchain package).
  // - `$/name` is a package's barrel, `$/name/...` a file in its `src/`:  for INSIDE this repo only.
  // - A package of ANOTHER repo is imported by its npm name (`spell-kit/util/class`), an entry its `package.json`
  //   `exports` names (WWOD §4, "Package names across repos").
  // - MUST stay the only `paths` in the repo:  a package that sets its own `paths` REPLACES this table, never adds to it.
  // - Paths are fixed, never `${configDir}`:  `tsx` can't resolve it.
  "extends": "spell-kit/toolchain/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      // ## `parser`
      "$/parser": ["./parser/src/index.ts"],
      "$/parser/*": ["./parser/src/*"],

      // ## `markdown`
      "$/markdown": ["./markdown/src/index.ts"],
      "$/markdown/*": ["./markdown/src/*"],

      // ## `core`
      "$/core": ["./core/src/index.ts"],
      "$/core/*": ["./core/src/*"],

      // ## `py`:  Python's writers, in `py/ts/` (its Python is `py/core/`, a uv project beside it)
      "$/py": ["./py/ts/index.ts"],
      "$/py/*": ["./py/ts/*"],

      // ## `spell`
      "$/spell": ["./spell/src/index.ts"],
      "$/spell/*": ["./spell/src/*"]
    }
  }
}
