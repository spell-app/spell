        {
          "key": "leftSent",
          "text": "{count} results sent to Claude",
          "description": "The notice line, the run left (Done testing, Esc, Next epic):  its unsent answers sent."
        },
        {
          "key": "leftSentOne",
          "text": "1 result sent to Claude",
          "description": "As `leftSent`, for one answer."
