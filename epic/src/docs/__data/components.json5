    {
      "tag": "epic-test-run",
      "name": "epic-test-run",
      "folder": "epic-test-run",
      "mainTag": "epic-test-run",
      "main": true,
      "page": true,
      "href": "epic-test-run.html",
      "topics": [
        "page"
      ],
      "aka": [
        "test run",
        "testing",
        "walkthrough",
        "start testing",
        "to test",
        "hand checks"
      ],
      "description": "A test run (epic `epic-engine` P4):  the open tests of the `<epic-page>` around it, ONE big card at a time -- the test's title and id, its Step (with buttons for the pages it says to open), Should, an Example screenshot (click to zoom) and If not -- answered Passed, Failed (with a pasted screenshot), Skip or Not now, a comment with any of them, each a review mark (`{ action: \"test\", result }`) in the page's inbox.  \"4 of 9\" and a thin bar say how far along;  Back and Next, the keys P / F / S / N, the arrows and Esc;  a summary card at the end, with Send results.  Drawn by `<epic-page>` over its blocks in test mode (the To test section's Start testing, or `?test=1` on the page's address);  written in a doc only as an example, inside an `<epic-page>`.  Leaving it (Done testing, Esc, the summary's next epic) sends its unsent answers, and the notice line says so.",
      "noun": "test run",
      "attributes": [
        {
          "name": "all",
          "kind": "boolean",
          "description": "The run is one epic of a run across every epic (`epic test --all`, the address's `?test=1&all=1`):  the summary card leads on to the next epic with open tests, \"Next:  <epic> (n tests)\"."
        }
      ],
      "slots": [],
      "events": [
        {
          "name": "epic-test-done",
          "detail": "{}",
          "description": "Owen left the run:  Esc, or \"Done testing\".  `<epic-page>` shows its blocks again;  the run has sent its unsent answers (I52)."
        }
      ],
      "parts": [
        {
          "name": "base",
          "description": "The run:  its head, the progress bar, then the card."
        },
        {
          "name": "head",
          "description": "Its head:  \"Testing\", \"4 of 9\", and Done testing;  with the bar under it, a full-width band, sticky under the page's header."
        },
        {
          "name": "progress",
          "description": "The thin bar under the head:  where the run is, as \"4 of 9\" says;  how many are answered, its tooltip (`<ui-progress>`)."
        },
        {
          "name": "card",
          "description": "The current test's card, or the summary's."
        },
        {
          "name": "answers",
          "description": "The four answers, ONE button group:  Passed (green), Failed (red), Skip (grey), Not now (yellow)."
        },
        {
          "name": "comment",
          "description": "Under the answers on every card:  the comment box (`<epic-text-box>`), saved as typed, going with whichever answer is picked."
        },
        {
          "name": "failure",
          "description": "Under the comment on every card:  the screenshot's area (paste, drop or choose one), going with whichever answer is picked;  its part name from when only Failed had it."
        },
        {
          "name": "moves",
          "description": "Back and Next:  a full-width band of their own, pinned to the window's bottom."
        },
        {
          "name": "summary",
          "description": "The summary card:  the counts, the tests commented on, Send results, the next epic."
        }
      ],
      "states": [
        {
          "name": "summary",
          "description": "The summary card shows:  past the last test."
        }
      ],
      "texts": [
        {
          "key": "run",
          "text": "Test run",
          "description": "The run's region, spoken."
        },
        {
          "key": "testing",
          "text": "Testing",
          "description": "The head's title."
        },
        {
          "key": "of",
          "text": "{at} of {total}",
          "description": "Where the run is:  \"4 of 9\"."
        },
        {
          "key": "answered",
          "text": "{count} of {total} answered",
          "description": "The progress bar's name and tooltip."
        },
        {
          "key": "done",
          "text": "Done testing",
          "description": "The head's button:  leave the run (Esc)."
