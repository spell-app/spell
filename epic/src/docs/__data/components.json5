    {
      "tag": "epic-page-note-head",
      "name": "epic-page-note-head",
      "folder": "epic-page-note-head",
      "mainTag": "epic-page-note-head",
      "main": true,
      "page": true,
      "href": "epic-page-note-head.html",
      "topics": [
        "comments"
      ],
      "aka": [
        "page note",
        "note head",
        "spell note",
        "old note"
      ],
      "description": "The head line of an old page note (`<spell-note>`, epic `airplane` P3:  written into a guide before comments replaced them, read only since), drawn by the docs runtime first in each note:  \"Owen · 10/10 14:02\", the note's first line while it's folded, its status (new yellow, answered violet, done grey) and how many replies.  The whole line is one button:  a click folds or unfolds the note.",
      "noun": "note head",
      "attributes": [
        {
          "name": "at",
          "kind": "string",
          "description": "When Owen wrote it, as the note says:  `2026-10-09 22:10`."
        },
        {
          "name": "status",
          "kind": "enum",
          "values": [
            "new",
            "answered",
            "done"
          ],
          "default": "new",
          "description": "The note's status, by the colour scheme:  `new` yellow (open), `answered` violet, `done` grey."
        },
        {
          "name": "replies",
          "kind": "number",
          "description": "How many replies Claude wrote under it;  none:  not said."
        },
        {
          "name": "preview",
          "kind": "string",
          "description": "The note's first line:  shown while it's folded."
        },
        {
          "name": "open",
          "kind": "boolean",
          "description": "The note is open:  its preview hides.  A click flips it, and says so (`epic-page-note-fold`)."
        }
      ],
      "slots": [],
      "events": [
        {
          "name": "epic-page-note-fold",
          "detail": "{ open: boolean }",
          "description": "Owen clicked it:  the note should open or fold, as `open` now says."
        }
      ],
      "parts": [
        {
          "name": "base",
          "description": "The line, a `<button>`:  the icon, who and when, the preview, the status."
        },
        {
          "name": "status",
          "description": "Its status chip, and how many replies."
        }
      ],
      "states": [],
      "texts": [
        {
          "key": "who",
          "text": "Owen",
          "description": "Who wrote a page note."
        },
        {
          "key": "reply",
          "text": "1 reply",
          "description": "After the status:  one reply."
        },
        {
          "key": "replies",
          "text": "{count} replies",
          "description": "After the status:  several replies."
        }
      ]
    },
    {
      "tag": "epic-phase",
      "name": "epic-phase",
      "folder": "epic-phase",
      "mainTag": "epic-phase",
      "main": true,
      "page": true,
      "href": "epic-phase.html",
      "topics": [
        "page"
      ],
      "aka": [
        "phase",
        "milestone",
        "step",
        "stage"
      ],
      "description": "One phase of the plan:  its status icon and estimate in its title line;  its fields (Symptom, Changes, Requests, Goal), Owen's kept notes, its plan changes (`<epic-update>` blocks, at the end of its description), then Done, commits, Files, Verify and To review, as children in that order.  While the page is reviewed, it takes review notes as an Overview sub-section does:  Revisit, Make Todo, Do Now.",
      "noun": "phase",
      "attributes": [
        {
          "name": "id",
          "kind": "string",
          "property": "epicId",
          "description": "Stable, made from its name when it's added, and kept through renames and inserts:  `p-epic-migrate` (an older page's `p2`, until `stable-phase-ids`).  Links and comments use it (`#p-epic-migrate`);  the number shown, `P2 · <title>`, is its place among the phases."
        },
        {
          "name": "title",
          "kind": "string",
          "property": "epicTitle",
          "description": "Its short name, 2-4 words, WITHOUT its id (`Saved Replies`, drawn as `P1 · Saved Replies`)."
        },
        {
          "name": "status",
          "kind": "enum",
          "values": [
            "todo",
            "active",
            "done"
          ],
          "description": "`todo`, `active` (one at a time, blue:  under way) or `done` (green)."
        },
        {
          "name": "estimate",
          "kind": "string",
          "description": "Wall-clock time for Claude to do it, agents included, Owen's review not:  `30m`, `2h`, `1h30m`, `1-2h`."
        },
        {
          "name": "source",
          "kind": "string",
          "description": "Its body's part file (`parts/p2.html`), loaded into its children when it opens."
        },
        {
          "name": "part-ids",
          "kind": "string",
          "description": "The ids inside its part file:  a link to one loads the body first, then lands."
        },
        {
          "name": "commits",
          "kind": "boolean",
          "description": "Its body lists commits (the page's git buttons)."
        },
        {
          "name": "changes",
          "kind": "number",
          "description": "How many plan changes (`<epic-update>` blocks) it holds, written by the epic tool on every edit:  its title row says so while it isn't done, folded too (its body, a part, loads only when it opens)."
        },
        {
          "name": "open",
          "kind": "boolean",
          "description": "Unfolded:  PAGE state, never written in a doc (epic pages open folded).  A click on the title, a link to it (or into it) and find-in-page set it;  set it from code to open it."
        }
      ],
      "slots": [
        {
          "name": "",
          "description": "Its fields, Owen's kept notes, its plan changes and commits."
        },
        {
          "name": "title",
          "description": "A title with markup, in place of `title`."
        },
        {
          "name": "actions",
          "description": "Buttons of the page's own in its title row (`<ui-button slot=\"actions\">`):  after the title, before its own buttons;  a click on one never folds it.  The docs runtime puts the block's bullhorn here too."
        },
        {
          "name": "changes",
          "description": "An OLDER doc's plan changes (`<epic-updated slot=\"changes\">`, 2026-10-11, P6):  drawn at the end of its body, unboxed, until the epic tool migrates them to `<epic-update>` blocks (`updates-as-epic-update`)."
        },
        {
          "name": "status",
          "description": "Claude's status cards on Owen's marks (`<epic-status slot=\"status\">`, P13):  at the end of its body, above the note box."
