      "aka": [
        "syntax choices",
        "names table",
        "rename table",
        "choices table"
      ],
      "description": "One section's table on a choice page (epic `epic-workflow` P12):  the column heads File | Purpose | Current | Recommended, then its rows, each an `<epic-choice-row>` whose Recommended box Owen types over.  It counts its section's rows on the section's title (`3 to change · 1 stay · 1 changed`).  With `reorder`, Owen puts the rows in order too (epic `epic-workflow` P15).  With `blank`, every box starts empty and Owen types only what he'd change (epic `epic-engine` P13).  Under 720px it scrolls inside its own box.",
      "noun": "choice rows",
      "attributes": [
        {
          "name": "stacked",
          "kind": "boolean",
          "description": "Current and Recommended in ONE column, Syntax:  today's text over the box (`stacked: true`)."
        },
        {
          "name": "no-file",
          "kind": "boolean",
          "description": "No File column (`fileColumn: false`):  for rows whose place in the code doesn't matter to the reader."
        },
        {
          "name": "blank",
          "kind": "boolean",
          "description": "Boxes Owen types into, not recommendations (`blank: true`;  epic `epic-engine` P13, r12):  one first column, today's text with an EMPTY box under it, then Purpose.  Blank means no change;  a click on today's text copies it into the box.  The count says how many rows and how many he changed."
        },
        {
          "name": "noun",
          "kind": "string",
          "description": "What `blank`'s count calls its rows:  `commands` reads \"42 commands · 3 changed\".  Default `rows`."
        },
        {
          "name": "reorder",
          "kind": "boolean",
          "description": "Owen puts the rows in order (a section's `reorder: true`):  a first column, Order, with each row's place and its move up / move down buttons.  The order goes with the draft and \"Do it\"."
        }
      ],
      "slots": [
        {
          "name": "",
          "description": "Its rows, `<epic-choice-row>`s, in order."
        }
      ],
      "events": [],
      "parts": [
        {
          "name": "base",
          "description": "The box that scrolls sideways when narrow."
        },
        {
          "name": "table",
          "description": "The grid:  the heads, then the rows."
        },
        {
          "name": "head",
          "description": "The column heads' row."
        }
      ],
      "states": [],
      "texts": [
        {
          "key": "file",
          "text": "File",
          "description": "The File column's head."
        },
        {
          "key": "purpose",
          "text": "Purpose",
          "description": "The Purpose column's head."
        },
        {
          "key": "current",
          "text": "Current",
          "description": "The Current column's head."
        },
        {
          "key": "recommended",
          "text": "Recommended",
          "description": "The Recommended column's head."
        },
        {
          "key": "syntax",
