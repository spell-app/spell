          "description": "With `multiple`:  a Select all / Select none button on its line, for the options shown."
        },
        {
          "name": "filter",
          "kind": "boolean",
          "description": "An Open | All toggle on its line:  Open (the default) hides the options marked `done`."
        },
        {
          "name": "more-details",
          "kind": "boolean",
          "description": "A (?) on each option, \"Provide more details\":  pressed, the option is ticked too, and the answer carries its letter under `<key>-more`, so Claude explains it in full before asking again."
        }
      ],
      "slots": [
