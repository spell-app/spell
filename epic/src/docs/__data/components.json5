    {
      "tag": "epic-send",
      "name": "epic-send",
      "folder": "epic-send",
      "mainTag": "epic-send",
      "main": true,
      "page": true,
      "href": "epic-send.html",
      "topics": [
        "answering"
      ],
      "aka": [
        "send",
        "submit",
        "send bar",
        "answer"
      ],
      "description": "A details page's Send, in its sticky header (epic `epic-workflow` P12):  where the answer stands (`Not sent`, `Changes not sent`, `Sent 10/8/26 14:34 · 5 of 17 decided`), then Send and its countdown (`<epic-send-buttons>`, epic `epic-engine` P20).  It sends the whole page, partial answers too, as often as Owen likes:  the page never locks;  with countdown mode on, by itself 2 minutes after he stops.  Beside them, the draft's save (P18):  what's typed and not sent is kept in the browser at once and beside the page as Owen types, and comes back when it reloads;  a save that fails says so in red under them, and tries again every 3s.  After the button, who hears it (epic `epic-engine` r6):  `repo-split is listening` while a session's `epic ask wait` waits for the answer, else `nobody is waiting yet`;  Send works either way, and with nobody waiting says the answer is saved for Claude's next look.  Once a page.",
      "noun": "send",
      "attributes": [],
      "slots": [],
      "events": [],
      "parts": [
        {
          "name": "base",
          "description": "Its box:  the line, then an error when there is one."
        },
        {
          "name": "state",
          "description": "Where the answer stands, in its colour:  grey, blue (not sent), green (sent)."
        },
        {
          "name": "draft",
          "description": "The draft's save (P18), muted:  `draft saved 14:04`, `draft from 14:04 put back`;  when the page server can't take it, on its own line under the rest, red and bold (P15:  the browser still keeps it, and it tries again every 3s)."
        },
        {
          "name": "send",
          "description": "Send and its countdown (`<epic-send-buttons>`), grey with nothing to send, blue with changes not sent, a blue outline once sent;  `data-fill` the form's (`rest`, `pending`, `sent`)."
        },
        {
          "name": "who",
          "description": "Who hears a Send, muted, after the button (r6):  `repo-split is listening` with a green dot (a session's `epic ask wait`), or `nobody is waiting yet`;  the tooltip says more.  None where the page can't ask (no page server)."
        },
        {
          "name": "error",
          "description": "Why it couldn't send, under them."
        },
        {
          "name": "notice",
          "description": "Sent with nobody waiting, under them in orange:  `Saved:  nobody is waiting yet;  Claude reads it when it next looks.`  Gone once a session waits, or at the next send."
        }
      ],
      "states": [
        {
          "name": "pending",
          "description": "Something on the page isn't sent yet."
        },
        {
          "name": "sent",
          "description": "The page as sent."
        }
      ],
      "texts": [
        {
          "key": "sendTip",
          "text": "Send what's on the page:  a partial answer is fine, send again any time",
          "description": "The plane's tooltip and name (`<epic-send-buttons send-tip>`)."
        }
      ]
    },
    {
      "tag": "epic-send-buttons",
      "name": "epic-send-buttons",
      "folder": "epic-send-buttons",
      "mainTag": "epic-send-buttons",
      "main": true,
      "page": true,
      "href": "epic-send-buttons.html",
      "topics": [
        "answering"
      ],
      "aka": [
        "send",
        "send button",
        "countdown",
        "auto send",
        "paper plane",
        "wand"
      ],
      "description": "Send and its countdown, ONE group (epic `epic-engine` P20):  the paper plane sends;  the wand turns COUNTDOWN MODE on and off.  With it on and something not sent, the wand is filled light blue, and a light grey ring round it turns blue, clockwise, over 2 minutes, starting again at every key, click or scroll on the page;  at the end the owner is asked to send, as Review Now did.  With it off and something not sent, the plane is filled blue:  it waits for a press.  The mode is on by default, and remembered in this browser for every page.  Drawn by an epic page's header (`<epic-page>`), a details page's Send (`<epic-send>`) and a docs page's comments Send.",
      "noun": "send-buttons",
      "attributes": [
        {
          "name": "state",
          "kind": "enum",
          "values": [
            "idle",
            "unsent",
            "sent"
          ],
          "description": "Where what the owner sends stands, by the fill rule:  `idle` (nothing to send:  a grey outline), `unsent` (something not sent:  the plane blue, the countdown runs), `sent` (a blue outline).  Default:  `idle`."
        },
        {
          "name": "send-tip",
          "kind": "string",
          "description": "The paper plane's tooltip and name:  what a press sends (`Send 2 marks, 1 comment to Claude`).  Default:  `Send`."
        },
        {
          "name": "count",
          "kind": "number",
          "description": "How many things a press would send, a small badge on the plane;  0 or none:  no badge."
        },
        {
          "name": "busy",
          "kind": "boolean",
          "description": "A send on its way:  the plane spins, and a press does nothing."
        },
        {
          "name": "manual",
          "kind": "boolean",
          "description": "No countdown:  only a press sends, and no wand is drawn.  For a page a COMMAND waits on (`<epic-run>`):  it carries on with exactly what was sent (Owen, 2026-10-23)."
        }
      ],
      "slots": [],
      "events": [
        {
          "name": "epic-send-asked",
          "detail": "{ auto }",
          "description": "A send asked for:  the paper plane pressed (`auto` false), or the countdown ran out (`auto` true).  The owner sends;  a countdown's send asks every revisit now, as Review Now did (decision Q7)."
        }
      ],
      "parts": [
        {
          "name": "base",
          "description": "The group:  one pill, the plane's end and the wand's."
        },
        {
          "name": "send",
          "description": "The paper plane, a `<button>`:  `data-state`, filled blue while it waits for a press."
        },
        {
          "name": "count",
          "description": "The badge on the plane:  how many things a press sends."
        },
        {
          "name": "countdown",
          "description": "The wand, a `<button aria-pressed>`:  countdown mode on (blue) or off (grey)."
        },
        {
          "name": "ring",
          "description": "The countdown's ring round the wand, light grey turning blue as the 2 minutes run;  only while it runs."
        }
      ],
      "states": [
        {
          "name": "countdown",
          "description": "Countdown mode is on."
        },
        {
          "name": "counting",
          "description": "The countdown is running:  something waits, and the ring turns blue."
        },
        {
          "name": "waiting",
          "description": "Countdown mode is off and something isn't sent:  the plane is filled blue."
        }
      ],
      "texts": [
        {
          "key": "group",
          "text": "Send",
          "description": "The group's name, for a screen reader."
        },
        {
          "key": "send",
          "text": "Send",
          "description": "The plane's tooltip and name, when the owner gives none (`send-tip`)."
        },
        {
          "key": "countdownOn",
          "text": "Countdown on:  {when}.  Click to send only when you press the plane",
          "description": "The wand's tooltip, mode on;  `{when}` says when it sends."
        },
        {
          "key": "countdownOff",
          "text": "Countdown off:  press the plane to send.  Click to send by itself 2 minutes after you stop",
          "description": "The wand's tooltip, mode off."
        },
        {
          "key": "whenCounting",
          "text": "sends by itself in {time} unless you keep typing, clicking or scrolling",
          "description": "When a running countdown sends;  `{time}` like `1:42`."
        },
        {
          "key": "whenIdle",
          "text": "what you leave unsent goes by itself 2 minutes after you stop",
          "description": "When it sends, with nothing waiting yet."
        },
        {
          "key": "countdownName",
          "text": "Countdown",
          "description": "The wand's name, for a screen reader (its state is `aria-pressed`)."
        }
      ]
    },
    {
      "tag": "epic-sort",
      "name": "epic-sort",
      "folder": "epic-sort",
      "mainTag": "epic-sort",
      "main": true,
