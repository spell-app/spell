    {
      "tag": "epic-section",
      "name": "epic-section",
      "folder": "epic-section",
      "mainTag": "epic-section",
      "main": true,
      "page": true,
      "href": "epic-section.html",
      "topics": [
        "page"
      ],
      "aka": [
        "section",
        "chapter",
        "panel"
      ],
      "description": "One section of an epic page, by `kind`:  its phases, its items or its log;  or, inside `<epic-overview>`, one of the Overview's sub-sections (`overview-part`), which gets review notes as items do;  or a report a run wrote (`report`:  an overnight `/bedtime` report), after the Overview, unnumbered;  or a saga page's Epics (`epics`:  the cards of the epics serving it, an `<epic-cards>`).",
      "noun": "section",
      "attributes": [
        {
          "name": "id",
          "kind": "string",
          "property": "epicId",
          "description": "Its id, which links use:  FIXED per kind (`phases`, `decisions` for Questions ...);  `o1`, `o2` ... for an Overview sub-section;  a report's own (`overnight`)."
        },
        {
          "name": "kind",
          "kind": "enum",
          "values": [
            "overview-part",
            "epics",
            "phases",
            "questions",
            "judgements",
            "caveats",
            "todos",
            "issues",
            "tests",
            "log",
            "report"
          ],
          "description": "What it holds:  `phases` its `<epic-phase>`s;  `questions` ... `tests` its `<epic-item>`s;  `log` its `<epic-event>`s;  `overview-part` and `report` prose;  `epics` (a saga page's) its `<epic-cards>`."
        },
        {
          "name": "title",
          "kind": "string",
          "property": "epicTitle",
          "description": "An Overview sub-section's title, WITHOUT its number (`Structure`, drawn as `1.1 Structure`), or a report's (`Overnight · 2026-10-04`):  required there (or a `slot=\"title\"` child, for a title with markup).  The page's sections draw their own."
        },
        {
          "name": "source",
          "kind": "string",
          "description": "Its body's part file (`parts/o3.html`, `parts/log.html`), loaded into its children when it opens."
        },
        {
          "name": "part-ids",
          "kind": "string",
          "description": "The ids inside its part file:  a link to one loads the body first, then lands."
        },
        {
          "name": "open",
          "kind": "boolean",
          "description": "Unfolded:  PAGE state, never written in a doc (epic pages open folded).  A click on the title, a link to it (or into it) and find-in-page set it;  set it from code to open it."
        }
      ],
      "slots": [
        {
          "name": "",
          "description": "Its phases, items, log events or prose."
        },
        {
          "name": "title",
          "description": "A title with markup, in place of `title`."
        },
        {
          "name": "actions",
          "description": "Buttons of the page's own in its title row (`<ui-button slot=\"actions\">`):  after the title, before its own buttons;  a click on one never folds it.  The docs runtime puts the block's bullhorn here too."
        },
        {
          "name": "changes",
          "description": "An OLDER doc's Plan changes copies in the Phases section (T14, until 2026-10-11).  NOT drawn:  no slot of the shadow root takes them, since each phase draws its own;  the epic tool removes them on its next write."
        },
        {
          "name": "status",
          "description": "An Overview sub-section's status cards from Claude (`<epic-status slot=\"status\">`, P13):  at the end of its body, above the note box."
        }
      ],
      "events": [
        {
          "name": "ui-open",
          "detail": "{ open: true, element: Element, originalEvent?: Event }",
          "cancelable": true,
          "description": "About to unfold:  its title was clicked.  Cancel to stay folded.  After the fact for a link."
        },
        {
          "name": "ui-close",
          "detail": "{ open: false, element: Element, originalEvent?: Event }",
          "cancelable": true,
          "description": "About to fold:  its title was clicked.  Cancel to stay open."
        },
        {
          "name": "ui-loading",
          "detail": "{ source: string }",
          "description": "The `source` part is on its way:  the first unfold, or a live reload (as `<ui-section source>`'s)."
        },
        {
          "name": "ui-loaded",
          "detail": "{ source: string, content: string }",
          "description": "The `source` part arrived and is in its children (as `<ui-section source>`'s)."
        },
        {
          "name": "ui-error",
          "detail": "{ kind: 'load' | 'cross-origin' | 'file-protocol' | 'render', source: string, error: unknown }",
          "cancelable": true,
          "description": "The `source` part couldn't be loaded;  its note says so unless cancelled."
        },
        {
          "name": "ui-filter",
          "detail": "{ states: string[] | undefined }",
          "description": "Its state filter changed:  its chips, `show all`, or the page's toolbar (`showStates()`).  `states` the ones showing;  none:  every state."
        },
        {
          "name": "epic-test-start",
          "detail": "{}",
          "description": "The To test section's Start testing was pressed (epic `epic-engine` P4):  `<epic-page>` shows its test run."
        }
      ],
      "parts": [
        {
          "name": "base",
          "description": "The element's box."
        },
        {
          "name": "section",
          "description": "The `<ui-section>` drawing the title bar and fold:  its own parts through `::part()` from inside."
        },
        {
          "name": "body",
          "description": "Around its children:  sets `--epic-stack` for them."
        },
        {
          "name": "expand-all",
          "description": "Always, folded or open, the double chevron pointing down before collapse-all:  opens it and everything inside it (sections, phases, items, cards and panels), parts loading as they open."
        },
        {
          "name": "collapse-all",
          "description": "While open, the double chevron before the fold chevron:  folds everything inside it, not itself."
        },
        {
          "name": "note",
          "description": "The `Loads from parts/x.html ...` line, when its part can't load."
        },
        {
          "name": "tools",
          "description": "At the title's end:  the page's own buttons (the `actions` slot), then the Phases section's Files / Verify toggles;  an item section's state filter;  an Overview sub-section's review buttons."
        },
        {
          "name": "filter",
          "description": "An item section's state filter:  one chip per state its items are in, with how many, solid while that state's items show, outlined while hidden."
        },
        {
          "name": "hidden-note",
          "description": "Under a filtered list:  \"3 hidden · show all\", an `<epic-hidden-note>`."
        },
        {
          "name": "empty",
          "description": "An item section with no items:  \"None yet\"."
        },
        {
          "name": "review-buttons",
          "description": "The review buttons (P9, an `<epic-review>`):  the note bubble, a pick's letter, Approve / Revisit / Make Todo, then Do Now (the wand);  a todo's:  the plane (next phase), Revisit, the x (drop).  Only while the page is reviewed (served by the page server, its inbox answering)."
        },
        {
          "name": "note-box",
          "description": "The note box (an `<epic-review>`):  the note, then Revisit Later and the x (skip this);  a todo's:  the plane, Revisit Later, the x (drop it)."
        },
        {
          "name": "said",
          "description": "A note marked and closed (an `<epic-review>`):  `You · revisit soon · sent 10:42`, the note, Edit."
        },
        {
          "name": "new-item",
          "description": "A Todos, Questions, Issues or Tests section's New todo / question / issue / test (an `<epic-new-item>`, epic `airplane` P2), at its end:  the button, or the form in its place.  Only while the page is reviewed."
        },
        {
          "name": "new-button",
          "description": "The same sections' comment-dots button, on the title:  opens the section, then that form.  Only while reviewed."
        },
        {
          "name": "new-list",
          "description": "A Todos or Questions section's new items waiting to be made:  dashed until sent, then outlined."
        },
        {
          "name": "start-testing",
          "description": "The To test section's \"Start testing · 9\" (epic `epic-engine` P4), on its title:  the page's test run, its open tests one at a time (`epic-test-start`).  Only while the page is reviewed and a test is open."
        }
      ],
      "states": [
        {
          "name": "open",
          "description": "Unfolded."
        },
        {
          "name": "loaded",
          "description": "Its `source` part is in."
        },
        {
          "name": "error",
          "description": "Its `source` part couldn't be loaded."
        },
        {
          "name": "tools",
          "description": "Its title has tools:  the Phases toggles, or a state filter (items in it)."
