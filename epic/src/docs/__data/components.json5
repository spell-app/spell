      ],
      "aka": [
        "epic page",
        "plan doc",
        "epic",
        "plan",
        "project plan"
      ],
      "description": "An epic page:  one epic's page -- its crumbs, header and meta lines, the Overview, then its sections in a fixed order.  Runs edge to edge:  it breaks out of the docs' `<main>` padding (`--spell-doc-pad-inline`).  With `kind=\"saga\"`, a saga page:  the saga's crumbs and header, its Overview, Epics, Questions, Todos and Log.",
      "noun": "page",
      "attributes": [
        {
          "name": "epic",
          "kind": "string",
          "description": "The epic's name:  its folder in `epics/`, and its branch's (`epic-components`).  On every epic page;  absent on a saga page (`kind=\"saga\"`), which `saga` names instead."
        },
        {
          "name": "kind",
          "kind": "string",
          "description": "What kind of page:  absent, an epic page;  `saga`, a SAGA page (epic `epic-workflow` P15), `sagas/<id>/<id>.saga.html`:  `saga` names it, its crumbs say `Docs / Sagas`, its review command is `/epic review SAGA:/<id>`, and it has no phases, branch, worktree or step label."
        },
        {
          "name": "title",
          "kind": "string",
          "property": "epicTitle",
          "description": "The epic's title (`Windows and Review`):  the page's `<title>` and the Epics list's;  not drawn on the page, whose h1 is the epic's name."
        },
        {
          "name": "branch",
          "kind": "string",
          "description": "Its git branch;  absent for a future epic."
        },
        {
          "name": "worktree",
          "kind": "string",
          "description": "Its worktree's folder, absolute;  absent for a future epic, or once the worktree is gone."
        },
        {
          "name": "started",
          "kind": "string",
          "description": "The day the epic page was made."
        },
        {
          "name": "updated",
          "kind": "string",
          "description": "The day a command last changed it."
        },
        {
          "name": "future",
          "kind": "boolean",
          "description": "A FUTURE epic (`/epic future`):  an idea written down, not planned yet;  its open questions are on `details/analysis.html`."
        },
        {
          "name": "standing",
          "kind": "boolean",
          "description": "A STANDING epic (epic `epic-workflow`):  open for good, a home that requests from other sessions keep adding phases to;  each phase merges into `main` on its own, and every phase done is NOT done."
        },
        {
          "name": "saga",
          "kind": "string",
