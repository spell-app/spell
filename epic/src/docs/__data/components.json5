    {
      "tag": "epic-link",
      "name": "epic-link",
      "folder": "epic-link",
      "mainTag": "epic-link",
      "main": true,
      "page": true,
      "href": "epic-link.html",
      "topics": [
        "prose"
      ],
      "aka": [
        "link",
        "saga link",
        "item link",
        "cross reference",
        "SAGA:/",
        "address"
      ],
      "description": "A link to a saga page, an epic page, or a phase or item on one, written by what it points at, not by path:  `<epic-link epic=\"seo\" item=\"J3\">`.  None of `saga` / `epic`:  the page it's in.  With no text, it draws the short form (`seo J3`, `T3` on its own page, `P7 · Epic Migrate` for a phase), the target's title its tooltip.  The same as a short address, `SAGA:/<saga>/<epic>#<id>`.",
      "noun": "link",
      "attributes": [
        {
          "name": "saga",
          "kind": "string",
          "description": "The saga's id (`drawable-spell`).  Alone:  its saga page.  With an epic:  the saga that epic names (not needed;  one it doesn't name still links, and the link check flags it)."
        },
        {
          "name": "epic",
          "kind": "string",
          "description": "The epic's id (`python-target`):  its epic page."
        },
        {
          "name": "item",
          "kind": "string",
          "description": "An id on that page, any case (`T1`, `j32`, `o1`):  lands on it, opening an item."
        },
        {
          "name": "phase",
          "kind": "string",
          "description": "A phase instead of an item:  its number (`7`, `P7`) or its name (`epic-migrate`, the slug of its title)."
        }
      ],
      "slots": [
        {
          "name": "",
          "description": "The link's text;  none:  the short form."
        }
      ],
      "events": [],
      "parts": [
        {
          "name": "base",
          "description": "The link, an `<a>`;  plain text while it has nowhere to go."
        }
      ],
      "states": [
        {
          "name": "broken",
          "description": "What it points at isn't there:  no page, or no such id on it."
        }
      ],
      "texts": [
        {
          "key": "broken",
          "text": "Not found:  {target}",
          "description": "A broken link's tooltip."
        }
      ]
    },
    {
      "tag": "epic-list",
      "name": "epic-list",
      "folder": "epic-list",
      "mainTag": "epic-list",
      "main": true,
      "page": true,
      "href": "epic-list.html",
      "topics": [
        "epics-page"
      ],
      "aka": [
        "epics list",
        "epics page",
        "epic groups",
        "saga chips",
        "favorites"
      ],
      "description": "The Epics page's list (epic `epic-engine` P3):  its `<epic-card>`s in five groups -- Favorites, Active, Planning, Urgent, Done -- each under a heading with its count, by title within each or newest first (`<epic-sort>`);  above them a chip per saga, in the sagas' order, then No saga, each with its count:  a click shows only that saga's epics.  It never moves its cards:  it places and hides them from its shadow root.  Written by `epic pages index` (`spell-epic/list/EpicCards` `epicListHtml()`).",
      "noun": "list",
      "attributes": [
        {
          "name": "sagas",
          "kind": "string",
          "description": "The sagas' ids, in Owen's order, space-separated:  the chips' order.  A saga none of its cards names gets no chip;  a card naming a saga not listed is No saga's."
        },
        {
          "name": "no-favorites",
          "kind": "boolean",
          "description": "No Favorites group:  a starred card stays in its own group.  A saga page's Epics (`<epic-cards>`):  Favorites is Owen's own list, on the Epics page."
        }
      ],
      "slots": [
        {
          "name": "",
          "description": "Its cards, `<epic-card>`s, in any order."
        }
      ],
      "events": [],
      "parts": [
        {
          "name": "base",
          "description": "The box around the chips and the groups."
        },
        {
