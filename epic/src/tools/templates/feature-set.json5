// A Feature Set's data:  copy it, fill it in, then
//   epic ask create <slug> --template feature-set --epic <epic> --from <your copy>
// - Order is rank:  the best first.  Titles are plain words;  the other texts may hold HTML.
// - The page names the sections S1, S2 ... and each one's items F1, F2 ...;  link one as <a href="#s1f2">S1F2</a>.
// - A name stays with its item in its section:  for the next round (`epic ask round <page> --from <data>`) an item
//   keeps it by its title.  Give `id: "F2"` (a section:  `id: "S2"`) when you change the title.
//   Moved to another section by a round, it gets a new name there.
{
  title: "Ideas to pick from",
  lede: "Every idea in one list, best first.<br>Pick Yes, No, Modify or Revisit for each, and a priority.",
  askedBy: "session <code>name</code>, while doing what",
  where: {
    epic: "<code>name</code>:  what that work is for, in one line.",
    justNow: "What happened that led to this list.",
    decides: "What changes for you, whatever you pick."
  },
  howToRead: "<b>Priority</b>:  1 first, 3 last.",
  changesTitle: "What changes",
  sections: [
    {
      title: "Now",
      items: [
        {
          title: "The first idea, in a few plain words",
          text: "What it is, in one or two sentences.",
          changes: ["One thing that will be different.", "Another."],
          recommended: "Y",
          priority: { recommended: 1, why: "the others wait for it." },
          facts: [
            { label: "Read", value: "<a href=\"https://example.com/\">where it comes from</a>" },
            { label: "Risk", value: "low", why: "nothing uses it yet" }
          ]
        },
        {
          title: "The second idea",
          text: "What it is.",
          recommended: "R",
          priority: { recommended: 3 },
          facts: [{ label: "Depends", value: "after <a href=\"#s1f1\">S1F1</a>" }]
        }
      ]
    }
  ]
}
