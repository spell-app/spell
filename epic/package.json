    "./*": {
      "spell-epic-source": [
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx",
        "./src/*"
      ],
      "types": [
        "./dist-types/src/*.d.ts",
        "./dist-types/src/*/index.d.ts"
      ],
      "default": "./src/*"
    },
    "./*.ts": {
      "spell-epic-source": "./src/*.ts",
      "types": "./dist-types/src/*.d.ts",
      "default": "./src/*.ts"
    },
    "./vscode/src/docUrls.ts": "./vscode/src/docUrls.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "epic": "node bin/epic",
    "/////// PACK AND DOCS": "",
    "pack:build": "spell-pack build",
    "pack:check": "spell-pack check",
    "site:data": "tsx scripts/site-data.ts",
    "docs:update": "node src/tools/update.js",
    "docs:index": "node src/tools/index.js",
    "docs:new": "node src/tools/new-page.js",
    "docs:open": "tsx src/tools/open.js",
    "plan-doc": "tsx src/tools/plan-doc.js",
    "details": "node src/tools/details.js",
    "docs:link": "tsx src/tools/link.ts",
    "/////// CORRECTNESS": "",
    "review": "yarn ts && yarn lint && yarn test && echo '== REVIEW PASSED\n===========\n'",
    "ts": "echo '>>>>>>>>>>>\n>> RUNNING TSC' && spell-types --below && tsc && tsc -p tests && echo '<< TSC PASSED\n'",
    "lint": "echo '>>>>>>>>>>>\n>> LINTING WITH OXLINT' && vp lint --report-unused-disable-directives --max-warnings 0 src scripts tests vscode/src && echo '<< OXLINT PASSED\n'",
    "lint:fix": "vp lint --fix src scripts tests vscode/src",
    "format": "vp fmt src scripts tests vscode/src vscode/build.mjs vite.config.ts vitest.config.ts",
    "/////// TESTING": "",
    "test": "echo '>>>>>>>>>>>\n>> RUNNING TESTS' && vp test run && yarn test:scripts && echo '<< TESTS PASSED\n'",
    "test:watch": "vp test",
    "test:node": "vp test run --project node",
    "test:scripts": "node --test tests/window.test.mjs && yarn test:vscode",
    "test:vscode": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/vscode/*.test.ts",
    "/////// PLUGIN AND EXTENSION": "",
    "plugin:validate": "claude plugin validate .",
    "vscode:check": "tsc --noEmit -p vscode",
    "vscode:package": "cd vscode && yarn package"
  },
  "dependencies": {
    "chalk": "^5.6.0",
    "commander": "^14",
    "json5": "^2.1.1",
    "linkedom": "^0.18.13",
    "spell": "workspace:*",
    "spell-ui": "workspace:*",
    "tsx": "4.20.3"
  },
  "devDependencies": {
    "@solidjs/h": "2.0.0-rc.17",
    "@solidjs/web": "2.0.0-rc.17",
    "@types/node": "^22.20.4",
    "@vitest/browser-playwright": "catalog:",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "playwright": "1.63.0",
    "solid-js": "2.0.0-rc.17",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "yarn@4.18.0",
  "pageServer": {
    "routes": [
      "src/tools/detailsRoutes.ts",
      "src/tools/choicesRoutes.ts",
      "src/tools/commentsRoutes.ts",
      "src/tool/reviewRoutes.ts",
      "src/tool/epicRoutes.ts",
      "src/tool/linkRoutes.ts",
      "src/list/runningRoutes.ts",
      "src/tools/agentRoutes.ts",
      "src/tools/showRoutes.ts",
      "src/tools/airplaneRoutes.ts"
    ],
    "watch": [
      "src/tools/_assets",
      "src/components/__pack"
    ],
    "componentSets": {
      "epics": {
        "name": "Epic UI",
        "dir": "src/docs",
        "assets": "../spell-ui/site/_assets"
      }
    },
    "engineRoutes": {
      "/_epic/assets/": "src/tools/_assets",
      "/_epic/pack/": "src/components/__pack",
      "/templates/": "templates"
    },
    "localCopies": {
      "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js": "/_epic/assets/highlight.min.js"
    }
  },
  "spellPack": {
    "name": "epics",
    "prefix": "epic-",
    "dir": "src"
  },
  "spellPublish": {
    "exclude": [
      "demo/**"
    ],
    "files": [
      "templates",
      "voices",
      "skills",
      "hooks",
      "monitors",
      ".claude-plugin",
      "src/AGENTS.md",
      "src/tool/PLAN-DOC.md"
    ],
    "bin": {
      "epic": "cli/epicMain"
    }
  }
}
