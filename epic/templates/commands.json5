{
  "families": [
    {
      "id": "docs-pages",
      "title": "Docs pages",
      "icon": "book open",
      "intro": "Sample family:  replace with your own.",
      "rows": [
        {
          "op": "Start a page from a template",
          "cli": { "mark": "could", "note": "`epic pages create`" },
          "skill": { "mark": "no" },
          "yarn": { "mark": "same", "names": ["root docs:new", "docs docs:new"] },
          "runs": "`src/tools/new-page.js`",
          "target": "`epic pages create`;  yarn `docs:new` calls it"
        },
        {
          "op": "Show a page in VS Code",
          "cli": { "mark": "could" },
          "skill": { "mark": "other", "names": ["/spell-docs"] },
          "yarn": { "mark": "other", "names": ["root docs:open"], "note": "with `--vs`" },
          "runs": "`src/tools/open.js`",
          "notes": "A sample note under the operation."
        }
      ]
    }
  ]
}
