{
  "name": "spell-epic",
  "displayName": "Spell Epic",
  "version": "0.8.19",
  "private": true,
  "description": "spell-epic's side bar:  the Review, Epic Docs, Servers and Details tabs, live from spell-epic's one page server per machine;  the window bridge Claude Code sessions reach their window through, and the handoff.",
  "license": "MIT",
  "repository": "https://github.com/spell-app/spell-epic",
  "publisher": "spell-app",
  "main": "./out/extension.js",
  "scripts": {
    "build": "node build.mjs",
    "check": "cd .. && yarn tsc --noEmit -p vscode",
    "package": "node build.mjs && vsce package --no-dependencies --skip-license --out spell-epic.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.0.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "spellEpic.toolbarGap",
        "title": "Gap",
        "icon": "$(blank)",
        "enablement": "false"
      },
      {
        "command": "spellEpic.reviewView.back",
        "title": "Back",
        "category": "Review",
        "icon": "$(arrow-left)",
        "enablement": "spellEpic.reviewView.canGoBack"
      },
      {
        "command": "spellEpic.reviewView.forward",
        "title": "Forward",
        "category": "Review",
        "icon": "$(arrow-right)",
        "enablement": "spellEpic.reviewView.canGoForward"
      },
      {
        "command": "spellEpic.reviewView.reload",
        "title": "Reload",
        "category": "Review",
        "icon": "$(refresh)"
      },
      {
        "command": "spellEpic.reviewView.restartServer",
        "title": "Restart Page Server",
        "category": "Review",
        "icon": "$(server-process)"
      },
      {
        "command": "spellEpic.reviewView.openExternal",
        "title": "Open in Browser",
        "category": "Review",
        "icon": "$(link-external)"
      },
      {
        "command": "spellEpic.reviewView.showWindowEpic",
        "title": "This Epic's Page",
        "category": "Review",
        "icon": "$(checklist)"
      },
      {
        "command": "spellEpic.reviewView.openEpic",
        "title": "Open Epic...",
        "category": "Review",
        "icon": "$(list-unordered)"
      },
      {
        "command": "spellEpic.reviewView.home",
        "title": "Epics Home",
        "category": "Review",
        "icon": "$(home)"
      },
      {
        "command": "spellEpic.detailsView.back",
        "title": "Back",
        "category": "Details",
        "icon": "$(arrow-left)",
        "enablement": "spellEpic.detailsView.canGoBack"
      },
      {
        "command": "spellEpic.detailsView.forward",
        "title": "Forward",
        "category": "Details",
        "icon": "$(arrow-right)",
        "enablement": "spellEpic.detailsView.canGoForward"
      },
      {
        "command": "spellEpic.detailsView.reload",
        "title": "Reload",
        "category": "Details",
        "icon": "$(refresh)"
      },
      {
        "command": "spellEpic.detailsView.list",
        "title": "This Epic's Questions",
        "category": "Details",
        "icon": "$(list-unordered)"
      },
      {
        "command": "spellEpic.detailsView.restartServer",
        "title": "Restart Page Server",
        "category": "Details",
        "icon": "$(server-process)"
      },
      {
        "command": "spellEpic.detailsView.openExternal",
        "title": "Open in Browser",
        "category": "Details",
        "icon": "$(link-external)"
      },
      {
        "command": "spellEpic.serversView.back",
        "title": "Back",
        "category": "Servers",
        "icon": "$(arrow-left)",
        "enablement": "spellEpic.serversView.canGoBack"
      },
      {
        "command": "spellEpic.serversView.forward",
        "title": "Forward",
        "category": "Servers",
        "icon": "$(arrow-right)",
        "enablement": "spellEpic.serversView.canGoForward"
      },
      {
        "command": "spellEpic.serversView.reload",
        "title": "Reload",
        "category": "Servers",
        "icon": "$(refresh)"
      },
      {
        "command": "spellEpic.serversView.restartServer",
        "title": "Restart Page Server",
        "category": "Servers",
        "icon": "$(server-process)"
      },
      {
        "command": "spellEpic.serversView.openExternal",
        "title": "Open in Browser",
        "category": "Servers",
        "icon": "$(link-external)"
      },
      {
        "command": "spellEpic.serversView.home",
        "title": "Servers Home",
        "category": "Servers",
        "icon": "$(home)"
      },
      {
        "command": "spellEpic.docsView.back",
        "title": "Back",
        "category": "Epic Docs",
        "icon": "$(arrow-left)",
        "enablement": "spellEpic.docsView.canGoBack"
      },
      {
        "command": "spellEpic.docsView.forward",
        "title": "Forward",
        "category": "Epic Docs",
        "icon": "$(arrow-right)",
        "enablement": "spellEpic.docsView.canGoForward"
      },
      {
        "command": "spellEpic.docsView.reload",
        "title": "Reload",
        "category": "Epic Docs",
        "icon": "$(refresh)"
      },
      {
        "command": "spellEpic.docsView.restartServer",
        "title": "Restart Page Server",
        "category": "Epic Docs",
        "icon": "$(server-process)"
      },
      {
        "command": "spellEpic.docsView.openExternal",
        "title": "Open in Browser",
        "category": "Epic Docs",
        "icon": "$(link-external)"
      },
      {
        "command": "spellEpic.docsView.home",
        "title": "Epic Docs Home",
        "category": "Epic Docs",
        "icon": "$(home)"
      },
      {
        "command": "spellEpic.docMenu.cut",
        "title": "Cut",
        "category": "Spell Epic"
      },
      {
        "command": "spellEpic.docMenu.copy",
        "title": "Copy",
        "category": "Spell Epic"
      },
      {
        "command": "spellEpic.docMenu.paste",
        "title": "Paste",
        "category": "Spell Epic"
      },
      {
        "command": "spellEpic.docMenu.selectAll",
        "title": "Select All",
        "category": "Spell Epic"
      },
      {
        "command": "spellEpic.docMenu.back",
        "title": "Back",
        "category": "Spell Epic",
        "enablement": "webviewId == spellEpic.reviewView && spellEpic.reviewView.canGoBack || webviewId == spellEpic.detailsView && spellEpic.detailsView.canGoBack || webviewId == spellEpic.serversView && spellEpic.serversView.canGoBack || webviewId == spellEpic.docsView && spellEpic.docsView.canGoBack"
      },
      {
        "command": "spellEpic.docMenu.forward",
        "title": "Forward",
        "category": "Spell Epic",
        "enablement": "webviewId == spellEpic.reviewView && spellEpic.reviewView.canGoForward || webviewId == spellEpic.detailsView && spellEpic.detailsView.canGoForward || webviewId == spellEpic.serversView && spellEpic.serversView.canGoForward || webviewId == spellEpic.docsView && spellEpic.docsView.canGoForward"
      },
      {
        "command": "spellEpic.docMenu.reload",
        "title": "Reload",
        "category": "Spell Epic"
      },
      {
        "command": "spellEpic.docMenu.openExternal",
        "title": "Open in Browser",
        "category": "Spell Epic"
      },
      {
        "command": "spellEpic.docMenu.inspect",
        "title": "Inspect (Developer Tools)",
        "category": "Spell Epic"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "spellEpic.toolbarGap",
          "when": "view == spellEpic.reviewView || view == spellEpic.detailsView || view == spellEpic.docsView || view == spellEpic.serversView",
          "group": "navigation@5"
        },
        {
          "command": "spellEpic.reviewView.back",
          "when": "view == spellEpic.reviewView",
          "group": "navigation@1"
        },
        {
          "command": "spellEpic.reviewView.forward",
          "when": "view == spellEpic.reviewView",
          "group": "navigation@2"
        },
        {
          "command": "spellEpic.reviewView.reload",
          "when": "view == spellEpic.reviewView",
          "group": "navigation@3"
        },
        {
          "command": "spellEpic.reviewView.home",
          "when": "view == spellEpic.reviewView",
          "group": "navigation@6"
        },
        {
          "command": "spellEpic.reviewView.restartServer",
          "when": "view == spellEpic.reviewView",
          "group": "navigation@10"
        },
        {
          "command": "spellEpic.reviewView.openExternal",
          "when": "view == spellEpic.reviewView",
          "group": "navigation@4"
        },
        {
          "command": "spellEpic.reviewView.showWindowEpic",
          "when": "view == spellEpic.reviewView",
          "group": "navigation@7"
        },
        {
          "command": "spellEpic.detailsView.back",
          "when": "view == spellEpic.detailsView",
          "group": "navigation@1"
        },
        {
          "command": "spellEpic.detailsView.forward",
          "when": "view == spellEpic.detailsView",
          "group": "navigation@2"
        },
        {
          "command": "spellEpic.detailsView.reload",
          "when": "view == spellEpic.detailsView",
          "group": "navigation@3"
        },
        {
          "command": "spellEpic.detailsView.list",
          "when": "view == spellEpic.detailsView",
          "group": "navigation@6"
        },
        {
          "command": "spellEpic.detailsView.restartServer",
          "when": "view == spellEpic.detailsView",
          "group": "navigation@10"
        },
        {
          "command": "spellEpic.detailsView.openExternal",
          "when": "view == spellEpic.detailsView",
          "group": "navigation@4"
        },
        {
          "command": "spellEpic.serversView.back",
          "when": "view == spellEpic.serversView",
          "group": "navigation@1"
        },
        {
          "command": "spellEpic.serversView.forward",
          "when": "view == spellEpic.serversView",
          "group": "navigation@2"
        },
        {
          "command": "spellEpic.serversView.reload",
          "when": "view == spellEpic.serversView",
          "group": "navigation@3"
        },
        {
          "command": "spellEpic.serversView.home",
          "when": "view == spellEpic.serversView",
          "group": "navigation@6"
        },
        {
          "command": "spellEpic.serversView.restartServer",
          "when": "view == spellEpic.serversView",
          "group": "navigation@10"
        },
        {
          "command": "spellEpic.serversView.openExternal",
          "when": "view == spellEpic.serversView",
          "group": "navigation@4"
        },
        {
          "command": "spellEpic.docsView.back",
          "when": "view == spellEpic.docsView",
          "group": "navigation@1"
        },
        {
          "command": "spellEpic.docsView.forward",
          "when": "view == spellEpic.docsView",
          "group": "navigation@2"
        },
        {
          "command": "spellEpic.docsView.reload",
          "when": "view == spellEpic.docsView",
          "group": "navigation@3"
        },
        {
          "command": "spellEpic.docsView.home",
          "when": "view == spellEpic.docsView",
          "group": "navigation@6"
        },
        {
          "command": "spellEpic.docsView.restartServer",
          "when": "view == spellEpic.docsView",
          "group": "navigation@10"
        },
        {
          "command": "spellEpic.docsView.openExternal",
          "when": "view == spellEpic.docsView",
          "group": "navigation@4"
        }
      ],
      "webview/context": [
        {
          "command": "spellEpic.docMenu.cut",
          "when": "(webviewId == spellEpic.reviewView || webviewId == spellEpic.detailsView || webviewId == spellEpic.serversView || webviewId == spellEpic.docsView) && spellField && spellSelection",
          "group": "1_edit@1"
        },
        {
          "command": "spellEpic.docMenu.copy",
          "when": "(webviewId == spellEpic.reviewView || webviewId == spellEpic.detailsView || webviewId == spellEpic.serversView || webviewId == spellEpic.docsView) && spellSelection",
          "group": "1_edit@2"
        },
        {
          "command": "spellEpic.docMenu.paste",
          "when": "(webviewId == spellEpic.reviewView || webviewId == spellEpic.detailsView || webviewId == spellEpic.serversView || webviewId == spellEpic.docsView) && spellField",
          "group": "1_edit@3"
        },
        {
          "command": "spellEpic.docMenu.selectAll",
          "when": "(webviewId == spellEpic.reviewView || webviewId == spellEpic.detailsView || webviewId == spellEpic.serversView || webviewId == spellEpic.docsView)",
          "group": "1_edit@4"
        },
        {
          "command": "spellEpic.docMenu.back",
          "when": "(webviewId == spellEpic.reviewView || webviewId == spellEpic.detailsView || webviewId == spellEpic.serversView || webviewId == spellEpic.docsView)",
          "group": "2_page@1"
        },
        {
          "command": "spellEpic.docMenu.forward",
          "when": "(webviewId == spellEpic.reviewView || webviewId == spellEpic.detailsView || webviewId == spellEpic.serversView || webviewId == spellEpic.docsView)",
          "group": "2_page@2"
        },
        {
          "command": "spellEpic.docMenu.reload",
          "when": "(webviewId == spellEpic.reviewView || webviewId == spellEpic.detailsView || webviewId == spellEpic.serversView || webviewId == spellEpic.docsView)",
          "group": "2_page@3"
        },
        {
          "command": "spellEpic.docMenu.openExternal",
          "when": "(webviewId == spellEpic.reviewView || webviewId == spellEpic.detailsView || webviewId == spellEpic.serversView || webviewId == spellEpic.docsView)",
          "group": "3_open@1"
        },
        {
          "command": "spellEpic.docMenu.inspect",
          "when": "(webviewId == spellEpic.reviewView || webviewId == spellEpic.detailsView || webviewId == spellEpic.serversView || webviewId == spellEpic.docsView)",
          "group": "4_inspect@1"
        }
      ],
      "commandPalette": [
        {
          "command": "spellEpic.toolbarGap",
          "when": "false"
        },
        {
          "command": "spellEpic.docMenu.cut",
          "when": "false"
        },
        {
          "command": "spellEpic.docMenu.copy",
          "when": "false"
        },
        {
          "command": "spellEpic.docMenu.paste",
          "when": "false"
        },
        {
          "command": "spellEpic.docMenu.selectAll",
          "when": "false"
        },
        {
          "command": "spellEpic.docMenu.back",
          "when": "false"
        },
        {
          "command": "spellEpic.docMenu.forward",
          "when": "false"
        },
        {
          "command": "spellEpic.docMenu.reload",
          "when": "false"
        },
        {
          "command": "spellEpic.docMenu.openExternal",
          "when": "false"
        },
        {
          "command": "spellEpic.docMenu.inspect",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "spell-epic-review",
          "title": "Review",
          "icon": "media/spell.svg"
        },
        {
          "id": "spell-epic-docs",
          "title": "Epic Docs",
          "icon": "$(library)"
        },
        {
          "id": "spell-epic-servers",
          "title": "Servers",
          "icon": "$(server)"
        },
        {
          "id": "spell-epic-details",
          "title": "Details",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "spell-epic-review": [
        {
          "type": "webview",
          "id": "spellEpic.reviewView",
          "name": "Review"
        }
      ],
      "spell-epic-docs": [
        {
          "type": "webview",
          "id": "spellEpic.docsView",
          "name": "Epic Docs"
        }
      ],
      "spell-epic-servers": [
        {
          "type": "webview",
          "id": "spellEpic.serversView",
          "name": "Servers"
        }
      ],
      "spell-epic-details": [
        {
          "type": "webview",
          "id": "spellEpic.detailsView",
          "name": "Details"
        }
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "packageManager": "yarn@4.18.0"
}
