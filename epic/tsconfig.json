{
  // The TypeScript settings every package shares are the toolchain's (`spell-kit/toolchain`, spell-util's, a workspace
  // of the top `spell` install);  the alias table is this repo's own (`./tsconfig.base.json`).  What's ours below.
  "extends": ["spell-kit/toolchain/tsconfig.base.json", "./tsconfig.base.json"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // the docs tools (`tools/`) are partly plain node scripts:  parsed (`allowJs`), not type-checked (no `checkJs`)
    "allowJs": true,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    // `spell-kit/toolchain/types`:  the ambient helper types (`Prettify` ...), used bare (WWOD §9);  with Vite's client
    // types
    "types": ["vite/client", "node", "spell-kit/toolchain/types"]
  },
  "include": ["src", "scripts", "vite.config.ts", "vitest.config.ts"],
  // - `src/components/__pack/` is generated (`spell-ui-pack build`, `yarn pack:build`):  not ours to check
  // - `src/tools/_assets/`:  the docs pages' browser code (`spell-ui.entry.js` pulls in UI source), bundled, not checked
  // - `src/tools/vendor/`:  minified third-party code (Claude Design's runtime, for `check-design-bundle.js`)
  "exclude": ["src/components/__pack", "node_modules", "src/tools/_assets", "src/tools/vendor"]
}
